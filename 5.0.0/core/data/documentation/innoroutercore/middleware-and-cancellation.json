{"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Interception phase","anchor":"Interception-phase","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"NavigationMiddleware.willExecute(_:state:)"},{"type":"text","text":" runs before the engine applies a command."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It returns "},{"type":"codeVoice","code":"NavigationInterception"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":".proceed(updatedCommand)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".cancel(reason)","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This allows middleware to:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"rewrite commands"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"block execution"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"attach a typed cancellation reason"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Cancellation reasons live in "},{"type":"codeVoice","code":"NavigationCancellationReason"},{"type":"text","text":" and stay visible in the final "},{"type":"codeVoice","code":"NavigationResult"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Post-execution phase","anchor":"Post-execution-phase","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"NavigationMiddleware.didExecute(_:result:state:)"},{"type":"text","text":" folds the execution result after the engine runs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method can:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"inspect the final "},{"code":"RouteStack","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"transform the "},{"code":"NavigationResult","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"attach analytics or logging side effects"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"It cannot mutate router state directly. State mutation authority stays in the executor."}],"type":"paragraph"},{"level":2,"text":"Why middleware is synchronous","anchor":"Why-middleware-is-synchronous","type":"heading"},{"inlineContent":[{"type":"text","text":"Core middleware is intentionally synchronous. Async policy checks belong at the app boundary rather than inside the core execution pipeline."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If an app needs async authorization, use the effect-layer guarded execution helpers instead of making core middleware re-entrant and actor-heavy."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"metadata":{"role":"article","title":"Middleware and cancellation","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article"},"kind":"article","sections":[],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","interfaceLanguage":"swift"},"abstract":[{"text":"Middleware is the cross-cutting policy layer for navigation execution.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/innoroutercore\/middleware-and-cancellation"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"kind":"article","abstract":[{"text":"State, command, result, and execution primitives for InnoRouter.","t