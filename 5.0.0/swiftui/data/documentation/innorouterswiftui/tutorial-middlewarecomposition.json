{"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article","title":"Composing Middleware Across Navigation and Modal"},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Scenario","anchor":"Scenario"},{"type":"paragraph","inlineContent":[{"text":"Every ","type":"text"},{"type":"codeVoice","code":"NavigationCommand"},{"type":"text","text":" and "},{"code":"ModalCommand","type":"codeVoice"},{"type":"text","text":" should be logged"},{"text":" ","type":"text"},{"type":"text","text":"before it executes. A feature-flagged screen must be gated behind"},{"type":"text","text":" "},{"type":"text","text":"an entitlement check. An analytics call must fire after an"},{"type":"text","text":" "},{"text":"execution attempt finishes — but only for middlewares that actually","type":"text"},{"text":" ","type":"text"},{"text":"participated in the ","type":"text"},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" decision."}]},{"inlineContent":[{"text":"This tutorial starts at the externally owned-store tier because middleware is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"installed when the authority is created. A self-contained stack without custom"},{"type":"text","text":" "},{"text":"policy should use ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" instead."}],"type":"paragraph"},{"level":2,"text":"Modeling routes","type":"heading","anchor":"Modeling-routes"},{"syntax":"swift skip doc-fragment","code":["enum AppRoute: Route {","    case home","    case premiumDetail","    case paywall","}"],"type":"codeListing"},{"level":2,"text":"Logging middleware","type":"heading","anchor":"Logging-middleware"},{"inlineContent":[{"type":"text","text":"Reuse the "},{"code":"AnyNavigationMiddleware","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"AnyModalMiddleware","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"closure initializers so a minimal shared logger composes without"},{"type":"text","text":" "},{"type":"text","text":"boilerplate:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@MainActor","func loggingNavigationMiddleware() -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(","        willExecute: { command, _ in","            Log.debug(\"navigation command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, result, _ in","            Log.debug(\"navigation finished: \\(command) -> \\(result)\")","            return result","        }","    )","}","","@MainActor","func loggingModalMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(","        willExecute: { command, _, _ in","            Log.debug(\"modal command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, _, _ in","            Log.debug(\"modal finished: \\(command)\")","        }","    )","}"],"type":"codeListing"},{"level":2,"text":"Entitlement gating","type":"heading","anchor":"Entitlement-gating"},{"inlineContent":[{"type":"text","text":"The gate is itself a middleware; denying a command is just"},{"type":"text","text":" "},{"type":"text","text":"returning "},{"type":"codeVoice","code":".cancel(reason)"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@MainActor","func entitlementGateNavigation(hasPremium: @escaping @MainActor () -> Bool) -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(willExecute: { command, _ in","        guard case .push(.premiumDetail) = command, !hasPremium() else {","            return .proceed(command)","        }","        return .cancel(.middleware(debugName: \"entitlement-gate\", command: command))","    })","}"],"type":"codeListing"},{"inlineContent":[{"text":"The cancellation surfaces through","type":"text"},{"text":" ","type":"text"},{"code":"ModalStoreConfiguration.onEvent","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":".commandIntercepted(_, .cancelled(...))","type":"codeVoice"},{"type":"text","text":" and through"},{"text":" ","type":"text"},{"code":"FlowRejectionReason.middlewareRejected(debugName: \"entitlement-gate\")","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"when used from "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Wiring it all","anchor":"Wiring-it-all","level":2},{"type":"codeListing","code":["let navStore = NavigationStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingNavigationMiddleware(), debugName: \"logging\"),","            .init(middleware: entitlementGateNavigation(hasPremium: { EntitlementStore.shared.hasPremium }), debugName: \"entitlement-gate\"),","        ]","    )",")","","let modalStore = ModalStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingModalMiddleware(), debugName: \"logging\"),","        ]","    )",")"],"syntax":"swift skip doc-fragment"},{"type":"heading","text":"Participant discipline","anchor":"Participant-discipline","level":2},{"type":"paragraph","inlineContent":[{"text":"When a middleware cancels a command, every middleware whose","type":"text"},{"text":" ","type":"text"},{"code":"willExecute","type":"codeVoice"},{"type":"text","text":" hook ran is a participant, including the cancelling"},{"type":"text","text":" "},{"type":"text","text":"middleware itself. Middleware later in the chain did not run and"},{"type":"text","text":" "},{"type":"text","text":"therefore receives no completion callback."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That guarantee is why the logger safely appears "},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"type":"text","text":" the"},{"text":" ","type":"text"},{"text":"entitlement gate — the logger’s ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" fires even if the","type":"text"},{"text":" ","type":"text"},{"text":"gate cancels, so the cancellation is still recorded. Reordering","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"[entitlement-gate, logging]"},{"type":"text","text":" would skip the logger’s"},{"text":" ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"type":"text","text":" on cancellation."}]},{"type":"paragraph","inlineContent":[{"text":"For direct and batch ","type":"text"},{"code":".whenCancelled","type":"codeVoice"},{"text":" execution, ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"attempt-level: it can run for a leg whose "},{"code":"RouteStack","type":"codeVoice"},{"type":"text","text":" change is"},{"text":" ","type":"text"},{"type":"text","text":"later discarded. Use the aggregate result and "},{"type":"codeVoice","code":".changed"},{"type":"text","text":" event to"},{"type":"text","text":" "},{"type":"text","text":"observe durable state. Transactions instead keep "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" "},{"type":"text","text":"commit-only; its returned fold can change reporting after commit but"},{"type":"text","text":" "},{"type":"text","text":"cannot roll back the transaction."}]},{"anchor":"Observing-a-cancellation-end-to-end","level":2,"type":"heading","text":"Observing a cancellation end-to-end"},{"inlineContent":[{"type":"codeVoice","code":"ModalStore.events"},{"type":"text","text":" surfaces "},{"type":"codeVoice","code":".commandIntercepted(.cancelled(...))"},{"type":"text","text":" "},{"type":"text","text":"while a direct "},{"type":"codeVoice","code":"NavigationStore.execute(_:)"},{"type":"text","text":" cancellation is returned"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"NavigationResult.cancelled"},{"type":"text","text":"; a path-reconciliation policy may"},{"type":"text","text":" "},{"type":"text","text":"separately emit "},{"type":"codeVoice","code":".pathMismatch"},{"type":"text","text":". For a "},{"code":"FlowStore","type":"codeVoice"},{"text":" in particular,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStore.events"},{"text":" wraps both in ","type":"text"},{"code":".navigation(...)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":".modal(...)"},{"type":"text","text":" "},{"type":"text","text":"cases so one subscriber sees the whole picture. Capture the stream before"},{"type":"text","text":" "},{"text":"starting its lifecycle-owned task to register the subscriber synchronously.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let events = flowStore.events","let observationTask = Task { @MainActor in","    for await event in events {","        if case .modal(.commandIntercepted(_, .cancelled(let reason))) = event {","            Log.info(\"modal cancelled: \\(reason)\")","        }","        if case .intentRejected(_, .middlewareRejected(let name)) = event {","            Log.info(\"flow intent rejected by: \\(name ?? \"nil\")\")","        }","    }","}"]},{"anchor":"Testing-middleware-with-FlowTestStore","level":2,"type":"heading","text":"Testing middleware with FlowTestStore"},{"inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"type":"text","text":" (in "},{"code":"InnoRouterTesting","type":"codeVoice"},{"type":"text","text":") asserts the cancellation"},{"text":" ","type":"text"},{"text":"chain without mounting SwiftUI:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func entitlementGateBlocksPremiumPush() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: entitlementGateNavigation(hasPremium: { false }), debugName: \"gate\")","            ])","        )","    )","","    store.send(.push(.premiumDetail))","","    store.receiveIntentRejected(","        intent: .push(.premiumDetail),","        reason: .middlewareRejected(debugName: \"gate\")","    )","    store.finish()","}"]},{"level":2,"type":"heading","text":"Next steps","anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","isActive":true,"type":"reference"},{"type":"text","text":" to see how middleware"},{"type":"text","text":" "},{"type":"text","text":"interacts with a multi-step flow plus a child coordinator."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Read the "},{"code":"Tutorial-TestingFlows","type":"codeVoice"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" documentation catalog for the full host-less"},{"type":"text","text":" "},{"type":"text","text":"test harness tour."}],"type":"paragraph"}]}]}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that pairs completion callbacks with the middlewares"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"code":"willExecute","type":"codeVoice"},{"type":"text","text":" hook actually ran."}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","type":"topic","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"code":"EnvironmentRouter","type":"codeVoice"},{"type":"text","text":" actions for InnoRouter."}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"type":"topic","role":"article","kind":"article","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","title":"Building a Login Onboarding Flow","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", then let the signup "},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","type":"topic","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","role":"collection"}}}