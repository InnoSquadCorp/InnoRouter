{"kind":"article","metadata":{"roleHeading":"Article","title":"Case study: shipping a 12-screen onboarding flow","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"variants":[{"paths":["\/documentation\/innorouterswiftui\/casestudy-onboardingflow"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/CaseStudy-OnboardingFlow","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A representative composition of "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", "},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"FlowPlan","type":"codeVoice"},{"type":"text","text":", and "},{"code":"NavigationMiddleware","type":"codeVoice"},{"type":"text","text":" for a 12-screen"},{"type":"text","text":" "},{"type":"text","text":"onboarding sequence with conditional branches, deep-link"},{"type":"text","text":" "},{"type":"text","text":"resumption, and entitlement gating."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"primaryContentSections":[{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"name":"Note","type":"aside","style":"note","content":[{"inlineContent":[{"type":"text","text":"This is a synthesized case study against the public InnoRouter"},{"type":"text","text":" "},{"type":"text","text":"surface (v5.0). It does not represent a specific shipped app"},{"type":"text","text":" "},{"type":"text","text":"but is structured to match the shape of recurring requests"},{"type":"text","text":" "},{"type":"text","text":"from teams evaluating the framework."}],"type":"paragraph"}]},{"anchor":"The-brief","type":"heading","level":2,"text":"The brief"},{"type":"paragraph","inlineContent":[{"text":"The flow:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Launch screen.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Welcome + region picker."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Phone-number entry."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"SMS verification (modal sheet)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Profile photo (skippable).","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Display name.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Permission primer (one screen per permission requested)."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Notification opt-in (system prompt, conditional next step)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Home location (skippable).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Work location (skippable).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Subscription pitch (modal sheet, conditional).","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Welcome-home with feature tour.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Constraints:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Auth state is owned by an existing ","type":"text"},{"code":"AuthClient","type":"codeVoice"},{"text":". The flow","type":"text"},{"text":" ","type":"text"},{"text":"reads it but doesn’t own it.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Step ordering depends on user input (region → which","type":"text"},{"text":" ","type":"text"},{"text":"permissions to request, region → subscription eligibility).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The user can deep-link in via ","type":"text"},{"code":"inno:\/\/onboarding\/profile","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"resume mid-flow with prior steps already validated.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Analytics fires on every step entry. A push from outside the"},{"type":"text","text":" "},{"type":"text","text":"flow (e.g. a referral landing) shouldn’t double-fire entry"},{"type":"text","text":" "},{"type":"text","text":"events."}]}]}]},{"level":2,"type":"heading","text":"The composition","anchor":"The-composition"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Routable","enum OnboardingRoute: Codable {","    case launch","    case welcome","    case phoneNumber","    case profilePhoto","    case displayName","    case permissionPrimer(Permission)","    case homeLocation","    case workLocation","    case smsVerification(phoneNumber: String)","    case subscription(plan: SubscriptionPlan)","    case welcomeHome","}"]},{"type":"paragraph","inlineContent":[{"text":"One route type covers both push destinations and modal-only","type":"text"},{"text":" ","type":"text"},{"text":"destinations. ","type":"text"},{"type":"codeVoice","code":"FlowStore<OnboardingRoute>"},{"text":" exposes ","type":"text"},{"type":"codeVoice","code":"path: [RouteStep<OnboardingRoute>]"},{"text":": ","type":"text"},{"type":"codeVoice","code":".push(...)"},{"text":" steps drive the","type":"text"},{"text":" ","type":"text"},{"text":"navigation stack, while ","type":"text"},{"type":"codeVoice","code":".sheet(...)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".cover(...)"},{"text":" steps","type":"text"},{"text":" ","type":"text"},{"text":"drive modal presentation. Because the single route type is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":", the entire flow state is serializable to a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":".","type":"text"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["store.send(.presentSheet(.smsVerification(phoneNumber: phoneNumber)))","","let rehydrationPlan: FlowPlan<OnboardingRoute> = .init(steps: [","    .push(.launch),","    .push(.welcome),","    .sheet(.subscription(plan: subscriptionPlan)),","])"]},{"level":2,"anchor":"The-driver","text":"The driver","type":"heading"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@MainActor","final class OnboardingDriver: ChildCoordinator {","    typealias Route = OnboardingRoute","    typealias Result = OnboardingResult","","    var onFinish: (@MainActor @Sendable (OnboardingResult) -> Void)?","    var onCancel: (@MainActor @Sendable () -> Void)?","","    let store: FlowStore<OnboardingRoute>","    private let auth: AuthClient","    private let analytics: AnalyticsClient","","    init(auth: AuthClient, analytics: AnalyticsClient) {","        self.auth = auth","        self.analytics = analytics","        self.store = FlowStore(","            configuration: FlowStoreConfiguration(","                navigation: NavigationStoreConfiguration(","                    middlewares: [","                        .init(middleware: AnalyticsMiddleware(analytics: analytics),","                              debugName: \"analytics\"),","                        .init(middleware: EntitlementGate(auth: auth),","                              debugName: \"entitlement\"),","                    ]","                ),","                onEvent: { [analytics] event in","                    switch event {","                    case .pathChanged(_, let new):","                        analytics.record(.flowPathChanged(new))","                    case .intentRejected(_, let reason):","                        analytics.record(.flowRejected(reason))","                    case .navigation, .modal:","                        break","                    }","                },","                queueCoalescePolicy: .dropQueued","            )","        )","    }","","    func start() {","        store.send(.replaceStack([.launch, .welcome]))","    }","","    func handleDeepLink(_ url: URL) async {","        guard let plan = OnboardingDeepLink.plan(from: url, auth: auth) else {","            store.send(.push(.welcome))","            return","        }","        _ = store.apply(plan)","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"ChildCoordinator","type":"codeVoice"},{"text":" returns an ","type":"text"},{"type":"codeVoice","code":"OnboardingResult"},{"text":" to the parent","type":"text"},{"text":" ","type":"text"},{"text":"when the flow finishes:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["enum OnboardingResult {","    case completed(profile: Profile)","    case abandoned(at: OnboardingRoute)","}"]},{"type":"paragraph","inlineContent":[{"text":"The app-defined flow owner first stores ","type":"text"},{"type":"codeVoice","code":"onboardingDriver"},{"text":" in state that","type":"text"},{"type":"text","text":" "},{"text":"presents the sheet, then directly awaits","type":"text"},{"type":"text","text":" "},{"code":"onboardingDriver.waitForResult() async -> OnboardingResult?","type":"codeVoice"},{"text":". The method waits","type":"text"},{"text":" ","type":"text"},{"text":"for the result but never presents the driver. Its structured call threads","type":"text"},{"text":" ","type":"text"},{"text":"caller-task cancellation back through ","type":"text"},{"type":"codeVoice","code":"parentDidCancel()"},{"text":" and returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if","type":"text"},{"text":" ","type":"text"},{"text":"the sheet shell tears down its awaiting task. The owner clears its presentation","type":"text"},{"text":" ","type":"text"},{"text":"state after the call returns.","type":"text"}]},{"type":"heading","text":"What the middlewares earn","level":2,"anchor":"What-the-middlewares-earn"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnalyticsMiddleware"},{"text":" records ","type":"text"},{"code":".willExecute","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".didExecute","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"events for every navigation command, deduplicated against the"},{"type":"text","text":" "},{"type":"codeVoice","code":".pathChanged"},{"type":"text","text":" case handled by "},{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"type":"text","text":"."},{"text":" ","type":"text"},{"type":"text","text":"Because middleware fires "},{"inlineContent":[{"text":"before","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"type":"text","text":"state mutates, the analytics event always carries the intended"},{"text":" ","type":"text"},{"text":"target route, not the post-cancellation snapshot.","type":"text"}]},{"inlineContent":[{"type":"codeVoice","code":"EntitlementGate"},{"type":"text","text":" reads "},{"code":"auth.isEligible(for: route)","type":"codeVoice"},{"type":"text","text":" for each"},{"text":" ","type":"text"},{"text":"navigation prefix. If the user is not yet eligible for a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"branch, navigation middleware cancels the "},{"type":"codeVoice","code":".replaceStack"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".reset"},{"text":" command with a typed reason; the flow falls back to","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":".dropQueued"},{"text":" policy, dismissing any speculative modal state","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that was queued behind the rejected navigation rewrite."},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"type":"codeVoice","code":".intentRejected"},{"type":"text","text":" case records a structured"},{"text":" ","type":"text"},{"type":"codeVoice","code":".middlewareRejected(debugName: \"entitlement\")"},{"type":"text","text":" event so the"},{"type":"text","text":" "},{"type":"text","text":"analytics layer can correlate with the same span ID."}],"type":"paragraph"},{"text":"What `FlowPlan` earns","anchor":"What-FlowPlan-earns","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A deep link "},{"type":"codeVoice","code":"inno:\/\/onboarding\/profile"},{"text":" deserializes into:","type":"text"}]},{"code":["let plan: FlowPlan<OnboardingRoute> = .init(","    steps: [","        .push(.launch),","        .push(.welcome),","        .push(.phoneNumber),","        .push(.profilePhoto),","    ]",")"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"code":"store.apply(plan)","type":"codeVoice"},{"type":"text","text":" is atomic: every step previews against"},{"text":" ","type":"text"},{"type":"text","text":"middleware in order, and the entire plan rolls back if any"},{"text":" ","type":"text"},{"text":"preview rejects. The user never sees a half-applied flow even","type":"text"},{"text":" ","type":"text"},{"text":"if the entitlement gate decides one of the intermediate steps","type":"text"},{"text":" ","type":"text"},{"text":"is currently unreachable.","type":"text"}]},{"inlineContent":[{"text":"Because ","type":"text"},{"code":"OnboardingRoute","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", the same ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"type":"text","text":" can"},{"text":" ","type":"text"},{"text":"be persisted to ","type":"text"},{"type":"codeVoice","code":"UserDefaults"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"scenePhase: .background"},{"type":"text","text":" "},{"type":"text","text":"and restored on the next cold launch via"},{"type":"text","text":" "},{"code":"FlowPlan(validating:)","type":"codeVoice"},{"type":"text","text":" — the validating constructor rejects"},{"type":"text","text":" "},{"type":"text","text":"invariant violations (e.g. two modal steps) before the"},{"type":"text","text":" "},{"type":"text","text":"authority sees them."}],"type":"paragraph"},{"type":"heading","text":"What `InnoRouterTesting` earns","level":2,"anchor":"What-InnoRouterTesting-earns"},{"code":["@Test","func onboardingResumesFromProfile() async throws {","    let auth = AuthClient.signedIn(region: .us)","    let analytics = RecordingAnalytics()","    let test = FlowTestStore<OnboardingRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: EntitlementGate(auth: auth)),","            ])","        )","    )","","    test.send(.push(.launch))","    test.expect(navigation: [.launch])","    try await test.apply(","        FlowPlan(steps: [","            .push(.launch),","            .push(.welcome),","            .push(.phoneNumber),","            .push(.profilePhoto),","        ])","    )","    test.expect(navigation: [.launch, .welcome, .phoneNumber, .profilePhoto])","    test.expect(modal: nil)","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"No SwiftUI host in scope. The exact same store configuration —","type":"text"},{"text":" ","type":"text"},{"text":"including production analytics middleware — is exercised in","type":"text"},{"text":" ","type":"text"},{"text":"the test and in production. ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"text":" reuses the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"text":", so the test can also verify","type":"text"},{"text":" ","type":"text"},{"text":"that ","type":"text"},{"type":"codeVoice","code":"analytics.record(.flowPathChanged(...))"},{"text":" fired exactly","type":"text"},{"text":" ","type":"text"},{"text":"once per applied step.","type":"text"}]},{"level":2,"text":"Observed wins","anchor":"Observed-wins","type":"heading"},{"inlineContent":[{"text":"In a comparable TCA-modeled flow before the swap, the same","type":"text"},{"text":" ","type":"text"},{"text":"feature carried:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"~340 lines of "},{"type":"codeVoice","code":"Reducer"},{"type":"text","text":" boilerplate for navigation actions"},{"type":"text","text":" "},{"type":"text","text":"alone (push \/ pop \/ present \/ dismiss \/ forward \/ hydrate)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Three custom test harnesses to assert state restoration,"},{"type":"text","text":" "},{"type":"text","text":"deep-link replay, and entitlement gating in isolation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A bespoke “is the queue stale?” check after every cancelled","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"command because TCA’s "},{"type":"codeVoice","code":"@Presents"},{"type":"text","text":" carry-over isn’t governed"},{"type":"text","text":" "},{"type":"text","text":"by a policy at the framework level."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The InnoRouter version drops the navigation reducer"},{"type":"text","text":" "},{"type":"text","text":"boilerplate entirely (the framework owns the state machine),"},{"text":" ","type":"text"},{"text":"folds the three test harnesses into one ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"suite, and pushes the queue-coalesce decision into a single"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStoreConfiguration"},{"type":"text","text":" setting that participates in the"},{"type":"text","text":" "},{"type":"text","text":"analytics middleware’s span ID without extra wiring."}]},{"type":"heading","text":"When this composition is overkill","anchor":"When-this-composition-is-overkill","level":2},{"type":"paragraph","inlineContent":[{"text":"For a single-screen flow with no entitlement gating and no deep link, declare","type":"text"},{"text":" ","type":"text"},{"text":"the destinations with ","type":"text"},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" and use "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":". Promote to an externally"},{"type":"text","text":" "},{"type":"text","text":"owned "},{"code":"NavigationStore<R>","type":"codeVoice"},{"type":"text","text":" + "},{"code":"NavigationHost","type":"codeVoice"},{"type":"text","text":" only when another boundary needs"},{"type":"text","text":" "},{"type":"text","text":"the store."},{"type":"text","text":" "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" earns its surface specifically when:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Multiple steps need atomic deep-link rehydration."}]}]},{"content":[{"inlineContent":[{"text":"The modal authority is genuinely concurrent with the","type":"text"},{"text":" ","type":"text"},{"text":"navigation stack (sheets, covers).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A coordinator-level result ("},{"type":"codeVoice","code":"OnboardingResult"},{"type":"text","text":") needs to"},{"type":"text","text":" "},{"type":"text","text":"bubble back to the parent."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Middleware needs to gate or telemeter the entire flow.","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","type":"topic","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"code":"EnvironmentRouter","type":"codeVoice"},{"type":"text","text":" actions for InnoRouter."}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","type":"topic","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","role":"collection"}}}