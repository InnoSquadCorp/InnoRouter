{"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Coordinators in InnoRouter are SwiftUI-adapted reference authorities, not UIKit-era imperative routers."}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Coordinators-and-Environment-Intent","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","title":"Coordinators and environment router","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Coordinator role","anchor":"Coordinator-role"},{"type":"paragraph","inlineContent":[{"code":"Coordinator","type":"codeVoice"},{"type":"text","text":" exists for cases where view intent should flow through a policy object before it reaches the store."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A coordinator:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"receives ","type":"text"},{"code":"NavigationIntent","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"decides whether to forward, rewrite, or replace commands"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"maps routes to destinations"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"stays observable for SwiftUI"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" remains "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" by design because it is a shared authority object, not ephemeral view state."}],"type":"paragraph"},{"level":2,"anchor":"Environment-router-actions","text":"Environment router actions","type":"heading"},{"inlineContent":[{"code":"EnvironmentRouter","type":"codeVoice"},{"text":" is the primary route-action API for views. It exposes","type":"text"},{"text":" ","type":"text"},{"text":"discoverable ","type":"text"},{"code":"RouterActions","type":"codeVoice"},{"text":" methods such as ","type":"text"},{"code":"go","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":", and, for a","type":"text"},{"text":" ","type":"text"},{"code":"RouterTab","type":"codeVoice"},{"text":", ","type":"text"},{"code":"select","type":"codeVoice"},{"text":" without revealing host-owned state. Advanced","type":"text"},{"text":" ","type":"text"},{"code":"NavigationIntent","type":"codeVoice"},{"text":" values remain available through the explicit ","type":"text"},{"code":"send(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"escape hatch:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["struct ProductRow: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    let productID: String","","    var body: some View {","        Button(\"Open\") {","            router.go(.product(id: productID))","        }","","        Button(\"Replace stack\") {","            router.send(.replaceStack([.catalog, .product(id: productID)]))","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"router.send(_:)"},{"type":"text","text":" when code needs to construct a "},{"type":"codeVoice","code":"NavigationIntent"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalIntent"},{"type":"text","text":" directly, and "},{"type":"codeVoice","code":"router.send(flow:)"},{"type":"text","text":" for an explicit "},{"type":"codeVoice","code":"FlowIntent"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"When stack and modal authorities use different route types, declare one"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" property for each route type."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps view code declarative:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"child views do not need a direct store reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"macro diagnostics catch invalid "},{"code":"@Router","type":"codeVoice"},{"type":"text","text":" declarations at compile time"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"fail-fast environment behavior catches host wiring mistakes at runtime"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"multi-host trees can keep separate routing authorities in the same hierarchy","type":"text"}],"type":"paragraph"}]}]},{"text":"Host scoping and authority replacement","level":3,"type":"heading","anchor":"Host-scoping-and-authority-replacement"},{"inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"advanced store-backed host publishes one route-typed authority to its own view"},{"type":"text","text":" "},{"type":"text","text":"subtree. SwiftUI environment value semantics keep sibling hosts independent."},{"type":"text","text":" "},{"type":"text","text":"When a nested host uses the same "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" type, it replaces the complete"},{"type":"text","text":" "},{"type":"text","text":"authority for that subtree instead of merging capabilities from two stores."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This replacement prevents an inner stack-only host from accidentally driving"},{"type":"text","text":" "},{"type":"text","text":"an outer modal or flow authority. Different route types can coexist in one"},{"type":"text","text":" "},{"type":"text","text":"subtree; views declare one "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" property for each route type"},{"type":"text","text":" "},{"type":"text","text":"they use. The registration and storage types are implementation details, so"},{"type":"text","text":" "},{"type":"text","text":"custom view trees should compose the public hosts rather than write router"},{"type":"text","text":" "},{"type":"text","text":"environment state directly."}],"type":"paragraph"},{"anchor":"Flow-and-tab-coordinators","text":"Flow and tab coordinators","level":2,"type":"heading"},{"inlineContent":[{"code":"RouterTabHost","type":"codeVoice"},{"text":" is the macro-first tab surface. It owns selection and badge","type":"text"},{"text":" ","type":"text"},{"text":"state locally, renders every generated ","type":"text"},{"code":"RouterTab","type":"codeVoice"},{"text":" case through native","type":"text"},{"text":" ","type":"text"},{"code":"TabView","type":"codeVoice"},{"text":", and exposes ","type":"text"},{"code":"select","type":"codeVoice"},{"text":", ","type":"text"},{"code":"setBadge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"clearBadge","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"clearAllBadges","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"EnvironmentRouter","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["struct InboxButton: View {","    @EnvironmentRouter(AppTab.self) private var router","","    var body: some View {","        Button(\"Inbox\") {","            router.select(.inbox)","            router.setBadge(3, for: .inbox)","        }","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"StepCoordinator"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"TabCoordinator"},{"text":" remain advanced composition tools and","type":"text"},{"text":" ","type":"text"},{"text":"complement ","type":"text"},{"type":"codeVoice","code":"NavigationStore"},{"text":"; they do not replace it.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Recommended mental model:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" owns route-stack authority"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"RouterTabHost","type":"codeVoice"},{"type":"text","text":" owns local macro-first shell tab state"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"TabCoordinator"},{"type":"text","text":" owns externally managed or custom-shell tab state"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StepCoordinator"},{"type":"text","text":" owns local step state inside a destination"}]}]}]},{"inlineContent":[{"type":"text","text":"Use composition rather than trying to collapse all three responsibilities into one type."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/coordinators-and-environment-intent"]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","type":"topic","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","abstract":[{"type":"text","text":