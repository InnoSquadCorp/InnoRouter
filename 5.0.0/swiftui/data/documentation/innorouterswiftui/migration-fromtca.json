{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"This guide walks a TCA project through replacing its navigation","type":"text"},{"text":" ","type":"text"},{"text":"layer with InnoRouter while keeping the rest of the architecture","type":"text"},{"text":" ","type":"text"},{"text":"(reducers, effects, state) intact. InnoRouter is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"replacement for TCA’s reducer composition — it replaces the","type":"text"},{"text":" ","type":"text"},{"text":"parts of TCA that own ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation state"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"modal authority"}],"type":"emphasis"},{"text":".","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Migration-FromTCA"},"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Migrating navigation from TCA to InnoRouter"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Why this migration","anchor":"Why-this-migration"},{"inlineContent":[{"text":"TCA’s navigation surface (","type":"text"},{"code":"StackState<Element>","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@Presents","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationStackStore"},{"type":"text","text":") bundles three responsibilities:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State authority"}]},{"text":" — what is on the stack, what modal is up.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action plumbing"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"Action.path(.push(...))"},{"type":"text","text":", "},{"type":"codeVoice","code":"delegate"},{"type":"text","text":" "},{"type":"text","text":"actions, "},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":" from the parent."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View binding"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"NavigationStackStore"},{"type":"text","text":" translates child"},{"type":"text","text":" "},{"type":"text","text":"stores into "},{"type":"codeVoice","code":"NavigationLink"},{"type":"text","text":"s."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"InnoRouter takes ownership of (1) and (3) and replaces (2)"},{"type":"text","text":" "},{"type":"text","text":"with a typed "},{"type":"codeVoice","code":"NavigationIntent"},{"type":"text","text":" enum that flows through the"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI environment. The reducer surface shrinks because the"},{"type":"text","text":" "},{"type":"text","text":"parent reducer no longer needs to forward navigation actions"},{"type":"text","text":" "},{"type":"text","text":"into "},{"type":"codeVoice","code":"StackState"},{"type":"text","text":" mutations."}],"type":"paragraph"},{"level":2,"text":"The minimal swap","type":"heading","anchor":"The-minimal-swap"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A canonical TCA navigation feature looks like this:"}]},{"syntax":"swift skip doc-fragment","code":["@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable {","        var path = StackState<Path.State>()","    }","","    enum Action {","        case path(StackActionOf<Path>)","    }","","    @Reducer","    struct Path {","        enum State: Equatable { case detail(DetailFeature.State) }","        enum Action { case detail(DetailFeature.Action) }","        var body: some ReducerOf<Self> {","            Scope(state: \\.detail, action: \\.detail) { DetailFeature() }","        }","    }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","            .forEach(\\.path, action: \\.path) { Path() }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        NavigationStackStore(store.scope(state: \\.path, action: \\.path)) {","            RootView(store: store)","        } destination: { store in","            switch store.state {","            case .detail:","                if let detail = store.scope(state: \\.detail, action: \\.detail) {","                    DetailView(store: detail)","                }","            }","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After migration:"}]},{"syntax":"swift skip doc-fragment","code":["@Router","enum AppRoute {","    case detail(DetailFeature.State.ID)","","    var destination: some View {","        switch self {","        case .detail(let id):","            DetailView(\/* hydrate from id *\/)","        }","    }","}","","@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable { \/* business state only *\/ }","","    enum Action { \/* business actions only *\/ }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        RouterHost(AppRoute.self) {","            RootView(store: store)","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three things changed:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"The reducer’s ","type":"text"},{"code":"path: StackState<Path.State>","type":"codeVoice"},{"text":" is gone — the","type":"text"},{"text":" ","type":"text"},{"text":"parent reducer no longer carries navigation state.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The parent action enum no longer routes","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"case path(StackActionOf<Path>)"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The view uses macro-generated destinations with "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" in place of"},{"type":"text","text":" "},{"code":"NavigationStackStore","type":"codeVoice"},{"type":"text","text":" + "},{"code":"Path","type":"codeVoice"},{"type":"text","text":" reducer composition. No navigation store is"},{"type":"text","text":" "},{"type":"text","text":"exposed to the feature for this self-contained stack."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"If a TCA dependency, deep-link handler, or restoration boundary must access"},{"type":"text","text":" "},{"type":"text","text":"the navigation authority, promote the store to the app boundary. "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" "},{"type":"text","text":"still removes the destination closure, so the advanced form keeps the correct"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" closure order:"}],"type":"paragraph"},{"code":["@State private var navigationStore = NavigationStore<AppRoute>()","","NavigationHost(store: navigationStore) {","    RootView(store: store)","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"heading","anchor":"Modal-presentation-Presents-%E2%86%92-ModalStore","text":"Modal presentation (`@Presents` → `ModalStore`)","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TCA’s "},{"code":"@Presents","type":"codeVoice"},{"text":" is conceptually equivalent to a ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"slot. Replace:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@ObservableState","struct State {","    @Presents var sheet: SheetFeature.State?","}","","enum Action {","    case sheet(PresentationAction<SheetFeature.Action>)","}","","\/\/ View",".sheet(item: $store.scope(state: \\.sheet, action: \\.sheet)) { … }"]},{"type":"paragraph","inlineContent":[{"text":"with:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["\/\/ State + Action no longer carry the modal slot.","","\/\/ View","ModalHost(store: modalStore) { route in","    switch route { case .sheet: SheetView(…) }","} content: {","    RootView()","}"]},{"type":"paragraph","inlineContent":[{"text":"The reducer no longer fires ","type":"text"},{"code":"Action.sheet(.presented(…))","type":"codeVoice"},{"text":"; the view reads","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@EnvironmentRouter(AppModalRoute.self)"},{"text":" and calls ","type":"text"},{"type":"codeVoice","code":"router.sheet(_:)"},{"text":". Move to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":" only when stack and modal state must form one atomic timeline;","type":"text"},{"text":" ","type":"text"},{"text":"flow-specific intents use ","type":"text"},{"type":"codeVoice","code":"router.send(flow:)"},{"text":" through the same environment","type":"text"},{"text":" ","type":"text"},{"text":"router surface.","type":"text"}]},{"anchor":"Stack-+-modal-as-one-value-StackState-+-Presents-%E2%86%92-FlowStore","level":2,"text":"Stack + modal as one value (`StackState` + `@Presents` → `FlowStore`)","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"If a feature uses both navigation and modal authority, replace","type":"text"},{"type":"text","text":" "},{"text":"both with a single ","type":"text"},{"code":"FlowStore<Route>","type":"codeVoice"},{"text":" and observe ","type":"text"},{"code":"path: [RouteStep<Route>]","type":"codeVoice"},{"text":" as the single source of truth. The","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" value type makes the entire flow state Codable for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"deep-link rehydration and state restoration."}]},{"anchor":"Testing-TestStore-%E2%86%92-NavigationTestStore--FlowTestStore","level":2,"text":"Testing — `TestStore` → `NavigationTestStore` \/ `FlowTestStore`","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" ships host-less test stores that mirror"},{"text":" ","type":"text"},{"text":"TCA’s strict-exhaustivity ergonomics. Swap:","type":"text"}]},{"code":["let testStore = TestStore(initialState: AppFeature.State()) { AppFeature() }","await testStore.send(.path(.push(id: 0, state: .detail(...))))"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"with:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let test = NavigationTestStore<AppRoute>()","test.execute(.push(.detail(id)))","test.expect(state: [.detail(id)])"]},{"inlineContent":[{"type":"text","text":"The test store keeps the analytics \/ diagnostic "},{"type":"codeVoice","code":"onEvent"},{"text":" callback the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"production store wired through "},{"type":"codeVoice","code":"NavigationStoreConfiguration"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"text","text":"so the test asserts production telemetry without"},{"type":"text","text":" "},{"type":"codeVoice","code":"@testable import"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"What-stays-in-TCA","type":"heading","level":2,"text":"What stays in TCA"},{"inlineContent":[{"text":"InnoRouter explicitly does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" replace:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Business logic reducers ("},{"type":"codeVoice","code":"Reduce { state, action in … }"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Side effects (","type":"text"},{"type":"codeVoice","code":"Effect.send"},{"type":"text","text":", "},{"type":"codeVoice","code":"Effect.run"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Dependency injection (","type":"text"},{"code":"@Dependency","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross-feature coordination (parent ⇄ child reducer composition"},{"type":"text","text":" "},{"type":"text","text":"for non-navigation concerns)"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical migrated codebase keeps every reducer in place; the"},{"type":"text","text":" "},{"type":"text","text":"delta is the state slots and actions removed because navigation"},{"type":"text","text":" "},{"type":"text","text":"no longer needs reducer-level modeling."}]},{"type":"heading","level":2,"text":"Migration sequence","anchor":"Migration-sequence"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Start with a leaf feature whose navigation state lives only in the parent"},{"type":"text","text":" "},{"type":"text","text":"reducer’s "},{"type":"codeVoice","code":"StackState"},{"type":"text","text":". Declare its route with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" and replace the"},{"type":"text","text":" "},{"type":"text","text":"view-layer wiring with "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Strip the matching "},{"code":"path","type":"codeVoice"},{"text":" slot and ","type":"text"},{"code":"Path","type":"codeVoice"},{"text":" reducer from the","type":"text"},{"text":" ","type":"text"},{"text":"parent reducer. Verify the existing tests still pass against","type":"text"},{"text":" ","type":"text"},{"text":"the trimmed reducer state.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeat per feature. The blast radius per migration is contained because"},{"type":"text","text":" "},{"type":"text","text":"each "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" owns an independent local "},{"type":"codeVoice","code":"FlowStore"},{"text":" behind","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Tackle modal authority feature-by-feature once the navigation","type":"text"},{"type":"text","text":" "},{"text":"stacks are ported. ","type":"text"},{"type":"codeVoice","code":"@Presents"},{"text":" is the cheapest swap.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"For features with both stack and modal authority, migrate","type":"text"},{"type":"text","text":" "},{"type":"text","text":"them last by lifting the combined state into "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"capturing the deep-link flow through "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"anchor":"Common-pitfalls","type":"heading","text":"Common pitfalls","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action forwarding instinct."}]},{"type":"text","text":" TCA users habitually plumb navigation"},{"type":"text","text":" "},{"type":"text","text":"through actions even when the feature doesn’t need it. With"},{"text":" ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"type":"text","text":", the view calls "},{"code":"router.go(...)","type":"codeVoice"},{"type":"text","text":" directly; the reducer"},{"text":" ","type":"text"},{"type":"text","text":"never sees a navigation action unless you explicitly want to gate one"},{"text":" ","type":"text"},{"type":"text","text":"through middleware."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Strict concurrency floor.","type":"text"}],"type":"strong"},{"type":"text","text":" InnoRouter requires iOS 18 \/"},{"text":" ","type":"text"},{"type":"text","text":"Swift 6.3. If the project still targets iOS 13–17, plan the"},{"type":"text","text":" "},{"type":"text","text":"platform bump as a separate PR before the navigation"},{"type":"text","text":" "},{"type":"text","text":"migration."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"codeVoice","code":"@Bindable store"},{"type":"text","text":" ergonomics."}]},{"type":"text","text":" "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"@Observable","type":"codeVoice"},{"text":" and works with ","type":"text"},{"code":"@Bindable","type":"codeVoice"},{"type":"text","text":" directly — no"},{"text":" ","type":"text"},{"code":"bindable","type":"codeVoice"},{"text":" modifier or scoped binding helpers are needed.","type":"text"}],"type":"paragraph"}]}]},{"text":"Reference","type":"heading","anchor":"Reference","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Router"},{"text":" \/ ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"@EnvironmentRouter"}]}]},{"content":[{"inlineContent":[{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"NavigationHost","type":"codeVoice"},{"text":" for externally owned authority","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ModalStore","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"ModalHost"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"FlowHost","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"FlowPlan","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" ("},{"type":"codeVoice","code":"NavigationTestStore"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalTestStore"},{"text":", ","type":"text"},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":")"}],"type":"paragraph"}]}]}],"kind":"content"}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/migration-fromtca"]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","type":"topic","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"code":"EnvironmentRouter","type":"codeVoice"},{"type":"text","text":" actions for InnoRouter."}]},"doc://c