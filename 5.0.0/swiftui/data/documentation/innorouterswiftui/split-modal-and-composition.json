{"kind":"article","abstract":[{"type":"text","text":"Choose one macro-first host for the local surface. "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"RouterSplitHost","type":"codeVoice"},{"text":" unify stack and modal actions, ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":" narrows a","type":"text"},{"text":" ","type":"text"},{"text":"feature to modal actions, and ","type":"text"},{"type":"codeVoice","code":"RouterTabHost"},{"text":" owns native tab state.","type":"text"},{"type":"text","text":" "},{"text":"Externally owned stores and coordinator hosts remain advanced authorities.","type":"text"}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/split-modal-and-composition"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"anchor":"Split-navigation","level":2,"type":"heading","text":"Split navigation"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"type":"text","text":" for a macro-first sidebar\/detail layout. It owns the"},{"type":"text","text":" "},{"type":"text","text":"detail stack and modal authority locally, builds destinations from the"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" enum, and exposes both through "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":":"}]},{"type":"codeListing","code":["RouterSplitHost(AppRoute.self) {","    SidebarView()","} root: {","    ContentUnavailableView(\"Select an item\", systemImage: \"sidebar.left\")","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All stack and modal actions pass through the same "},{"type":"codeVoice","code":"FlowStore"},{"text":", so a push is","type":"text"},{"text":" ","type":"text"},{"text":"still rejected while a modal route is the flow tail. Use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationSplitHost"},{"text":" or ","type":"text"},{"code":"CoordinatorSplitHost","type":"codeVoice"},{"text":" when the application must own","type":"text"},{"text":" ","type":"text"},{"text":"an advanced stack-only authority directly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Important scope boundary:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"RouterSplitHost"},{"text":" owns the detail stack and modal authority","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"advanced split hosts own only the detail stack","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"sidebar selection remains app-owned","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"column visibility remains system-managed","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"compact adaptation remains system-managed"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps shell state out of the stack authority."}]},{"type":"aside","name":"Platform","style":"note","content":[{"type":"paragraph","inlineContent":[{"text":"","type":"text"},{"type":"codeVoice","code":"NavigationSplitHost"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CoordinatorSplitHost"},{"type":"text","text":" are "},{"type":"strong","inlineContent":[{"type":"text","text":"unavailable on watchOS"}]},{"type":"text","text":" "},{"type":"text","text":"because SwiftUI’s "},{"type":"codeVoice","code":"NavigationSplitView"},{"type":"text","text":" is unavailable there. watchOS apps should fall back"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"CoordinatorHost","type":"codeVoice"},{"type":"text","text":" in the "},{"code":"#else","type":"codeVoice"},{"type":"text","text":" branch of a"},{"type":"text","text":" "},{"type":"codeVoice","code":"#if !os(watchOS)"},{"type":"text","text":" check."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterSplitHost"},{"text":" remains visible to watchOS callers as an explicitly","type":"text"},{"text":" ","type":"text"},{"text":"unavailable declaration, whose compiler diagnostic directs macro-first code","type":"text"},{"type":"text","text":" "},{"text":"to ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"text":".","type":"text"}]}]},{"type":"heading","anchor":"Modal-navigation","text":"Modal navigation","level":2},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"RouterModalHost"},{"text":" when a feature needs only sheet and cover presentation:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["RouterModalHost(AppRoute.self) {","    ModalLauncher()","}"]},{"type":"paragraph","inlineContent":[{"text":"Descendants use the same typed environment router as every other macro-first","type":"text"},{"text":" ","type":"text"},{"text":"surface:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@EnvironmentRouter(AppRoute.self) private var router","","Button(\"Edit\") {","    router.sheet(.editor)","}","","Button(\"Preview\") {","    router.cover(.preview)","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":" owns its "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" locally and publishes only modal"},{"type":"text","text":" "},{"type":"text","text":"capability. An accidental "},{"type":"codeVoice","code":"go"},{"type":"text","text":" call therefore reports a missing navigation"},{"type":"text","text":" "},{"type":"text","text":"capability instead of silently inventing a stack."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" with "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" when restoration, middleware management, or"},{"type":"text","text":" "},{"type":"text","text":"direct observation requires the application to own the modal authority."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS and tvOS, "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" uses native "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":" and "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" presentation."},{"type":"text","text":" "},{"type":"text","text":"On other supported platforms, "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" requests degrade to "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The advanced modal authority intentionally stays separate from a stack-only"},{"type":"text","text":" "},{"type":"text","text":"authority:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"modal intent uses "},{"type":"codeVoice","code":"ModalIntent"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"stack intent uses "},{"type":"codeVoice","code":"NavigationIntent"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"modal queue state lives in ","type":"text"},{"type":"codeVoice","code":"ModalStore"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"stack state lives in ","type":"text"},{"code":"NavigationStore","type":"codeVoice"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Modal queue rules are intentionally small:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"present"},{"text":" shows immediately when no modal is active.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"present","type":"codeVoice"},{"type":"text","text":" appends to "},{"code":"queuedPresentations","type":"codeVoice"},{"type":"text","text":" when another modal is"},{"type":"text","text":" "},{"type":"text","text":"active."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"dismissCurrent","type":"codeVoice"},{"text":" dismisses the active modal and promotes the first","type":"text"},{"text":" ","type":"text"},{"text":"queued presentation, if one exists.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dismissAll"},{"type":"text","text":" clears both the active modal and the queue."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"replaceCurrent"},{"type":"text","text":" swaps only the active presentation and leaves the"},{"type":"text","text":" "},{"text":"queue untouched; observers receive ","type":"text"},{"code":".replaced","type":"codeVoice"},{"text":" before the command","type":"text"},{"text":" ","type":"text"},{"text":"interception event.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dismissCurrent"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"dismissAll"},{"text":" attempts enter modal middleware even when","type":"text"},{"text":" ","type":"text"},{"text":"there is no active presentation or queue. The resulting command can remain a","type":"text"},{"text":" ","type":"text"},{"text":"no-op, be cancelled, or be rewritten by middleware; this matches direct","type":"text"},{"text":" ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" execution instead of hiding empty-state attempts in ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":".","type":"text"}]},{"inlineContent":[{"text":"When middleware cancels a FlowStore modal preview, the captured participants","type":"text"},{"text":" ","type":"text"},{"text":"still receive ","type":"text"},{"type":"codeVoice","code":"didExecute"},{"text":", observers receive ","type":"text"},{"type":"codeVoice","code":".commandIntercepted"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ModalQueueCancellationPolicy"},{"text":" is applied to the preview state. If that policy","type":"text"},{"text":" ","type":"text"},{"text":"changes the live queue, ","type":"text"},{"type":"codeVoice","code":".queueChanged"},{"text":" is delivered before the interception","type":"text"},{"text":" ","type":"text"},{"text":"and flow-level rejection. During an atomic reset, a cancellation previewed from","type":"text"},{"text":" ","type":"text"},{"text":"an intermediate shadow is finalized with the actual live state that survived","type":"text"},{"text":" ","type":"text"},{"text":"rollback. Successful navigation and modal previews that preceded that","type":"text"},{"text":" ","type":"text"},{"text":"cancellation stay off the public ","type":"text"},{"type":"codeVoice","code":"didExecute"},{"text":" path and run their package-owned","type":"text"},{"text":" ","type":"text"},{"text":"discard cleanup instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"alert","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"confirmationDialog","type":"codeVoice"},{"text":" stay outside this framework surface and should remain feature-owned state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"ModalStoreConfiguration"},{"type":"text","text":" uses one "},{"code":"onEvent","type":"codeVoice"},{"text":" callback for the complete","type":"text"},{"text":" ","type":"text"},{"text":"modal observation surface:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let configuration = ModalStoreConfiguration<AppRoute>(","    onEvent: { event in","        switch event {","        case .presented(let presentation):","            analytics.recordPresented(presentation)","        case .dismissed(let presentation, let reason):","            analytics.recordDismissed(presentation, reason: reason)","        case .replaced(let old, let new):","            analytics.recordReplacement(from: old, to: new)","        case .queueChanged(let old, let new):","            diagnostics.recordQueueChange(from: old, to: new)","        case .commandIntercepted(let command, let result):","            diagnostics.record(command, result: result)","        case .middlewareMutation(let mutation):","            diagnostics.record(mutation)","        }","    }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When migrating to 5.0, merge the former modal lifecycle closures into"},{"type":"text","text":" "},{"type":"text","text":"this switch. "},{"type":"codeVoice","code":"ModalStore.events"},{"type":"text","text":" emits the same cases asynchronously."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" does not choose a modal presentation style. Automatic URL handling"},{"type":"text","text":" "},{"type":"text","text":"pushes through "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" or selects through"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":"; an application that needs a URL to open a sheet or cover must"},{"type":"text","text":" "},{"type":"text","text":"apply that policy at its flow boundary."}]},{"anchor":"Composition","text":"Composition","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recommended composition rules are:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose exactly one local macro-first authority for a route type in a","type":"text"},{"text":" ","type":"text"},{"text":"subtree: ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Put shell state such as tabs or app mode outside feature-local routing.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use distinct route types for nested authorities that must remain"},{"type":"text","text":" "},{"type":"text","text":"independent."}]}]},{"content":[{"inlineContent":[{"text":"Promote to ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ModalHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":", or a coordinator host","type":"text"},{"text":" ","type":"text"},{"text":"only when the application owns that state.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Keep feature-local routing inside the destination that owns it.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not wrap "},{"type":"codeVoice","code":"RouterHost"},{"text":" in ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":" for the same route type:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" already owns both capabilities, and a nested same-route host"},{"type":"text","text":" "},{"type":"text","text":"replaces the outer authority for its subtree. These rules keep each authority"},{"type":"text","text":" "},{"type":"text","text":"narrow without creating one application-wide store."}]}],"kind":"content"}],"metadata":{"roleHeading":"Article","title":"Split, modal, and composition patterns","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Split-Modal-and-Composition","interfaceLanguage":"swift"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","type":"topic","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"code":"EnvironmentRouter","type":"codeVoice"},{"type":"text","text":" actions for InnoRouter."}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","type":"topic","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","role":"collection"}}}