{"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"Match a URL, apply an authentication policy, and produce a","type":"text"},{"text":" ","type":"text"},{"code":"NavigationPlan","type":"codeVoice"},{"text":" that ","type":"text"},{"code":"NavigationStore.executeBatch","type":"codeVoice"},{"text":" applies in one","type":"text"},{"text":" ","type":"text"},{"text":"observable step. Queue the deep link while the user is signed out,","type":"text"},{"text":" ","type":"text"},{"text":"replay it after sign-in, and surface cancellation reasons through","type":"text"},{"text":" ","type":"text"},{"text":"typed outcomes.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation"},"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Reconciling Deep Links End-to-End"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Scenario","level":2,"text":"Scenario","type":"heading"},{"inlineContent":[{"code":"myapp:\/\/app\/order\/42","type":"codeVoice"},{"text":" should land the user on the order detail for","type":"text"},{"text":" ","type":"text"},{"text":"order 42, but only when they’re signed in. If the link arrives","type":"text"},{"text":" ","type":"text"},{"text":"while signed out, the app must remember it, route through the","type":"text"},{"text":" ","type":"text"},{"text":"sign-in flow, and then replay it — without dropping the original","type":"text"},{"text":" ","type":"text"},{"text":"URL context.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This tutorial intentionally uses an externally owned "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"deep-link effect handler must apply plans outside the SwiftUI host. A local"},{"type":"text","text":" "},{"type":"text","text":"single-route feature should start with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" + "},{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" + "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which installs incoming-URL handling automatically. Promote to this shape when"},{"type":"text","text":" "},{"type":"text","text":"authentication, pending replay, multi-step plans, restoration, or direct"},{"type":"text","text":" "},{"type":"text","text":"effect-handler ownership needs the authority."}],"type":"paragraph"},{"anchor":"Modeling-the-routes","level":2,"text":"Modeling the routes","type":"heading"},{"code":["\/\/ This host-independent excerpt uses plain Route conformance. Add @Router and","\/\/ a destination property when this same enum also owns SwiftUI rendering.","enum AppRoute: Route {","    case home","    case signIn","    case order(id: String)","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"anchor":"Wiring-the-pipeline","level":2,"text":"Wiring the pipeline","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":" owns the validate-then-match-then-authorize flow. Pass the"},{"type":"text","text":" "},{"type":"text","text":"matcher directly so matcher input-limit failures remain typed rejections:"}],"type":"paragraph"},{"code":["import Synchronization","","let authentication = Mutex(false)","let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/home\") { _ in .home }","    DeepLinkMapping(\"\/signin\") { _ in .signIn }","    DeepLinkMapping(\"\/order\/:id\") { parameters in","        guard let id = parameters.firstValue(forName: \"id\") else { return nil }","        return .order(id: id)","    }","}","","let policy = DeepLinkAuthenticationPolicy<AppRoute>.required(","    shouldRequireAuthentication: { route in","        if case .order = route { return true }","        return false","    },","    isAuthenticated: { authentication.withLock { $0 } }",")","","let pipeline = DeepLinkPipeline(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    matcher: matcher,","    authenticationPolicy: policy",")"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"anchor":"Handling-a-URL","level":2,"text":"Handling a URL","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"DeepLinkEffectHandler","type":"codeVoice"},{"text":" bridges the pipeline output into","type":"text"},{"type":"text","text":" "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["let store = NavigationStore<AppRoute>()","let effectHandler = DeepLinkEffectHandler(","    navigator: store,","    matcher: matcher,","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    authenticationPolicy: policy",")","","func handle(_ url: URL) {","    switch effectHandler.handle(url) {","    case .executed:","        break \/\/ The validated NavigationPlan has already been applied.","    case .executionFailed(_, let batch):","        Log.warning(\"deep-link batch failed after \\(batch.executedCommands.count) attempted commands\")","    case .pending:","        _ = store.execute(.push(.signIn))","    case .applicationRejected(_, let failure):","        Log.warning(\"deep-link plan rejected: \\(failure)\")","    case .rejected(let reason):","        Log.warning(\"deep link rejected: \\(reason)\")","    case .unhandled(let url):","        Log.warning(\"deep link unhandled: \\(url)\")","    case .invalidURL, .missingDeepLinkURL, .noPendingDeepLink:","        break","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"text":"Replaying after sign-in","level":2,"anchor":"Replaying-after-sign-in","type":"heading"},{"inlineContent":[{"text":"Once the user signs in, the handler resumes any queued deep link:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["func userDidSignIn() {","    authentication.withLock { $0 = true }","    _ = effectHandler.resumePendingDeepLink()","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The handler consults the retained "},{"type":"codeVoice","code":"PendingDeepLink"},{"type":"text","text":", re-evaluates"},{"type":"text","text":" "},{"type":"text","text":"the authentication policy, and only commits the batch if the new"},{"type":"text","text":" "},{"type":"text","text":"state now permits the original URL. Any stale pending link (one"},{"type":"text","text":" "},{"type":"text","text":"the user cancelled or that no longer validates) is dropped."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Observing the reconciliation","anchor":"Observing-the-reconciliation"},{"inlineContent":[{"code":"NavigationStore.events","type":"codeVoice"},{"text":" exposes the full sequence of batch +","type":"text"},{"text":" ","type":"text"},{"text":"path-mismatch events as a single stream, which is handy for","type":"text"},{"text":" ","type":"text"},{"text":"diagnostics dashboards. Capture the stream before starting its lifecycle-owned","type":"text"},{"text":" ","type":"text"},{"text":"task so the subscriber is registered before any immediate reconciliation","type":"text"},{"type":"text","text":" "},{"type":"text","text":"command:"}],"type":"paragraph"},{"code":["let events = store.events","let observationTask = Task { @MainActor in","    for await event in events {","        switch event {","        case .batchExecuted(let result):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .pathMismatch(let event):","            analytics.track(\"deep_link_mismatch\", [","                \"policy\": event.policy.rawValue,","                \"old\": event.oldPath.map(String.init(describing:)),","                \"new\": event.newPath.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"anchor":"Testing-the-chain","type":"heading","text":"Testing the chain"},{"inlineContent":[{"code":"NavigationTestStore","type":"codeVoice"},{"type":"text","text":" (in "},{"code":"InnoRouterTesting","type":"codeVoice"},{"type":"text","text":") asserts the batch +"},{"type":"text","text":" "},{"type":"text","text":"side effects for each branch:"}],"type":"paragraph"},{"type":"codeListing","code":["@Test","@MainActor","func signedOutDeepLinkDefersUntilSignIn() {","    let store = NavigationTestStore<AppRoute>()","    let handler = DeepLinkEffectHandler(","        navigator: store.store,","        matcher: matcher,","        authenticationPolicy: policy","    )","","    let result = handler.handle(URL(string: \"myapp:\/\/app\/order\/42\")!)","","    #expect(result == .pending(handler.pendingDeepLink!))","    #expect(store.state.path.isEmpty)","    store.finish()","}"],"syntax":"swift skip doc-fragment"},{"text":"Next steps","type":"heading","anchor":"Next-steps","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},{"text":" for how the sign-in flow that","type":"text"},{"text":" ","type":"text"},{"text":"replays this deep link is modelled.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts"},{"type":"text","text":" if the existing app"},{"type":"text","text":" "},{"type":"text","text":"still uses "},{"type":"codeVoice","code":"ModalHost { NavigationHost { ... } }"},{"type":"text","text":" pairs."}]}]}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation"]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"type":"topic","role":"article","kind":"article","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","title":"Building a Login Onboarding Flow","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", then let the signup "},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MigratingFromNestedHosts":{"title":"Migrating from Nested Hosts to `FlowHost`","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts","url":"\/documentation\/innorouterswiftui\/tutorial-migratingfromnestedhosts","role":"article","type":"topic","abstract":[{"type":"text","text":"Replace manually composed "},{"code":"ModalHost { NavigationHost { ... } }","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"surfaces with a single "},{"code":"FlowHost","type":"codeVoice"},{"type":"text","text":" backed by "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":". Preserve"},{"type":"text","text":" "},{"type":"text","text":"existing "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" configurations while"},{"type":"text","text":" "},{"type":"text","text":"unlocking a serializable "},{"code":"[RouteStep<R>]","type":"codeVoice"},{"type":"text","text":" path and"},{"type":"text","text":" "},{"code":"FlowStore.apply(_:)","type":"codeVoice"},{"text":" for restoration + deep-link hydration.","type":"text"}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","type":"topic","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"code":"EnvironmentRouter","type":"codeVoice"},{"type":"text","text":" actions for InnoRouter."}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","type":"topic","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","role":"collection"}}}