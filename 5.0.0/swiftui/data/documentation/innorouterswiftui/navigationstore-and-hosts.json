ation, event observation, or another application boundary needs direct","type":"text"},{"type":"text","text":" "},{"type":"text","text":"access. The "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":" generated by "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" keeps this advanced host"},{"text":" ","type":"text"},{"text":"concise:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@State private var navigation = NavigationStore<AppRoute>()","","NavigationHost(store: navigation) {","    HomeView()","}"]},{"anchor":"What-the-store-owns","type":"heading","level":2,"text":"What the store owns"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" owns:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the current ","type":"text"},{"type":"codeVoice","code":"RouteStack"},{"text":" snapshot","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"command execution","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"batch execution","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"transactional execution"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"path reconciliation from ","type":"text"},{"code":"NavigationStack(path:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"middleware registry orchestration","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"typed observation events for analytics and diagnostics","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Configuration is centralized in ","type":"text"},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Its synchronous observation surface is one ","type":"text"},{"type":"codeVoice","code":"onEvent"},{