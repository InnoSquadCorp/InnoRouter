xt","text":"publish one route-typed authority consumed through "},{"type":"codeVoice","code":"@EnvironmentRouter"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"bridge system path changes back into router commands","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views should not mutate a store directly. The default view-facing surface is"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"RouterActions"},{"type":"text","text":" methods emit typed"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationIntent"},{"type":"text","text":" values. Use "},{"type":"codeVoice","code":"go"},{"type":"text","text":", "},{"type":"codeVoice","code":"back"},{"type":"text","text":", and the other focused conveniences"},{"type":"text","text":" "},{"type":"text","text":"for common transitions, and "},{"type":"codeVoice","code":"send(_:)"},{"text":" as the explicit escape hatch for an","type":"text"},{"text":" ","type":"text"},{"text":"advanced intent. The same ","type":"text"},{"type":"codeVoice","code":"@EnvironmentRouter(Route.self)"},{"text":" surface is used for","type":"text"},{"text":" ","type":"text"},{"text":"navigation, modal, flow, and tab capabilities supplied by the matching host.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"onEvent"},{"text":" for synchronous analytics or diagnostics and ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" when an","type":"text"},{"text":" ","type":"text"},{"text":"asynchronous consumer should own the observation task. Supplying ","type":"text"},{"type":"codeVoice","code":"logger"},{"text":" ","type":"text"},{"text":"also records private, structured summaries through the store’s internal OSLog","type":"text"},{"text":" ","type":"text"},{"text":"integration; no separate telemetry adapter is required.","type":"text"}]},{"anchor":"Intent-command-shape","type":"heading","level":3,"text":"Intent command shape"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore.send(_:)"},{"type":"text","text":" and the navigation adapter owned by "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" "},{"type":"text","text":"use the same middleware-visible command shape:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"empty "},{"type":"codeVoice","code":"goMany"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"pushMany"},{"type":"text","text":" -> no command"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"one route -> "},{"code":".push","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"multiple routes -> one atomic "},{"type":"codeVoice","code":".pushAll"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"backBy","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"popCount","type":"codeVoice"},{"text":" equal to the current stack depth -> ","type":"text"},{"code":".popToRoot","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"With no modal tail, pop attempts enter middleware even on an empty stack."},{"type":"text","text":" "},{"type":"text","text":"The engine may still return a no-op or failure, but middleware can consistently"},{"type":"text","text":" "},{"type":"text","text":"observe, cancel, or rewrite the attempt. A modal tail remains the flow boundary:"},{"type":"text","text":" "},{"type":"text","text":"stack-pop intents do not bypass it."}]},{"text":"Path reconciliation","level":2,"type":"heading","anchor":"Path-reconciliation"},{"inlineContent":[{"type":"text","text":"When SwiftUI changes the path, InnoRouter translates that change back into semantic commands:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"prefix shrink -> ","type":"text"},{"code":".popCount","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".popToRoot","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"prefix expand -> per-step ","type":"text"},{"type":"codeVoice","code":".push"},{"text":" batch","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"mismatch -> "},{"code":"NavigationPathMismatchPolicy","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This preserves command meaning instead of treating every path change as a blind replacement."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"NavigationStoreConfiguration"},{"text":" defaults to ","type":"text"},{"type":"codeVoice","code":".replace"},{"text":", which treats the","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI binding as the source of truth for a non-prefix rewrite and emits","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"type":"codeVoice","code":"NavigationPathMismatchEvent"},{"text":". For debug or pre-release builds, use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".assertAndReplace"},{"text":" to make unexpected rewrites loud while still","type":"text"},{"text":" ","type":"text"},{"text":"recovering. Use ","type":"text"},{"type":"codeVoice","code":".ignore"},{"text":" only when the store must remain the sole","type":"text"},{"text":" ","type":"text"},{"text":"authority, and ","type":"text"},{"type":"codeVoice","code":".custom"},{"text":" when a host has domain-specific repair rules.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"kind":"symbol","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","type":"topic","title":"InnoRouterTesting","url":"\/documenta