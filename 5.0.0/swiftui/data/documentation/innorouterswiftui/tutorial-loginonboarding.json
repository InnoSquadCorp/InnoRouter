entation/InnoRouterSwiftUI/Tutorial-MiddlewareComposition":{"type":"topic","role":"article","kind":"article","title":"Composing Middleware Across Navigation and Modal","url":"\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" and "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that pairs completion callbacks with the middlewares"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"code":"willExecute","type":"codeVoice"},{"type":"text","text":" hook actually ran."}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","type":"topic","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"code":"EnvironmentRouter","type":"codeVoice"},{"type":"text","text":" actions for InnoRouter."}]}}}