{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/router-macro-first"]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First"},"abstract":[{"text":"Declare route data and destination views in one enum, then select the host that","type":"text"},{"text":" ","type":"text"},{"text":"matches the surface. Stack, modal, split, tab, and single-route deep-link","type":"text"},{"text":" ","type":"text"},{"text":"handling all keep the same ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":" action API.","type":"text"}],"sections":[],"metadata":{"title":"Macro-first routing with `@Router`","roleHeading":"Article","role":"article","modules":[{"name":"InnoRouterTesting"}]},"primaryContentSections":[{"content":[{"text":"Declare a router","anchor":"Declare-a-router","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" product and use the canonical imports:"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" to an enum with at least one route case and one get-only"},{"type":"text","text":" "},{"type":"text","text":"instance computed property whose exact declaration shape is"},{"type":"text","text":" "},{"type":"codeVoice","code":"var destination: some View"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import SwiftUI","import InnoRouter","","@Router","enum LibraryRoute {","    case book(id: String)","    case account","","    var destination: some View {","        switch self {","        case .book(let id):","            Text(\"Book \\(id)\")","        case .account:","            Text(\"Account\")","        }","    }","}"],"syntax":"swift compile","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Do not add "},{"type":"codeVoice","code":": Route"},{"type":"text","text":" or "},{"type":"codeVoice","code":": DestinationRoute"},{"type":"text","text":". "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" supplies"},{"type":"text","text":" "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":", which already refines "},{"type":"codeVoice","code":"Route"},{"type":"text","text":", "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"What the macro generates","anchor":"What-the-macro-generates","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the "},{"type":"codeVoice","code":"destination"},{"type":"text","text":" property is valid, "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" adds "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" unless they are already present. It also emits the equivalent of:"}]},{"syntax":"swift skip generated expansion","type":"codeListing","code":["extension LibraryRoute: InnoRouterSwiftUI.DestinationRoute {","    @Swift.MainActor","    @SwiftUI.ViewBuilder","    static func destination(for route: Self) -> some SwiftUI.View {","        route.destination","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated witness follows the enum’s effective access level. A public"},{"type":"text","text":" "},{"type":"text","text":"route can therefore keep its instance "},{"type":"codeVoice","code":"destination"},{"type":"text","text":" hook private while the"},{"type":"text","text":" "},{"type":"text","text":"protocol witness remains public."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" does not generate case paths. When a macro-first router also needs"},{"type":"text","text":" "},{"text":"typed case extraction, compose it with ","type":"text"},{"code":"@CasePathable","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["import SwiftUI","import InnoRouter","","@Router","@CasePathable","enum SearchRoute {","    case result(id: String)","","    var destination: some View {","        Text(\"Result\")","    }","}","","let route = SearchRoute.result(id: \"42\")","route[case: SearchRoute.Cases.result]  \/\/ Optional(\"42\")"],"syntax":"swift compile"},{"level":2,"type":"heading","anchor":"Choose-a-host","text":"Choose a host"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The host owns local state. Start with the narrowest host that covers the"},{"type":"text","text":" "},{"type":"text","text":"feature:"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Surface","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Macro-first host","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Common actions from ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Stack plus modal","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RouterHost"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"go"},{"type":"text","text":", "},{"type":"codeVoice","code":"back"},{"type":"text","text":", "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":", "},{"type":"codeVoice","code":"cover"},{"type":"text","text":", "},{"type":"codeVoice","code":"dismiss"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Modal only","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RouterModalHost"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"sheet"},{"type":"text","text":", "},{"type":"codeVoice","code":"cover"},{"type":"text","text":", "},{"type":"codeVoice","code":"dismiss"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Split detail stack plus modal"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterSplitHost"}]}],[{"type":"paragraph","inlineContent":[{"code":"go","type":"codeVoice"},{"text":", ","type":"text"},{"code":"back","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":", ","type":"text"},{"code":"cover","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dismiss","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Native tabs"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterTabHost"}]}],[{"type":"paragraph","inlineContent":[{"code":"select","type":"codeVoice"},{"type":"text","text":", "},{"code":"setBadge","type":"codeVoice"},{"type":"text","text":", "},{"code":"clearBadge","type":"codeVoice"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"Promote state to a ","type":"text"},{"type":"codeVoice","code":"NavigationStore"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ModalStore"},{"text":", ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"codeVoice","code":"TabCoordinator"},{"type":"text","text":" only when another application boundary must restore, observe,"},{"type":"text","text":" "},{"type":"text","text":"or mutate that authority directly."}]},{"level":2,"anchor":"Stack-and-modal-routing","type":"heading","text":"Stack and modal routing"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" for the common stack-plus-modal surface:","type":"text"}],"type":"paragraph"},{"code":["RouterHost(LibraryRoute.self) {","    LibraryHomeView()","}"],"syntax":"swift skip surrounding view declaration","type":"codeListing"},{"inlineContent":[{"text":"Descendants read typed actions from ","type":"text"},{"code":"EnvironmentRouter","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@EnvironmentRouter(LibraryRoute.self) private var router","","Button(\"Account\") {","    router.go(.account)","}","","Button(\"Account sheet\") {","    router.sheet(.account)","}"],"syntax":"swift skip surrounding view declaration","type":"codeListing"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"RouterModalHost"},{"text":" when the feature must not expose stack actions:","type":"text"}],"type":"paragraph"},{"code":["RouterModalHost(LibraryRoute.self) {","    LibraryHomeView()","}"],"syntax":"swift skip surrounding view declaration","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Calling an action unsupported by the nearest host, such as "},{"type":"codeVoice","code":"go"},{"type":"text","text":" below a"},{"type":"text","text":" "},{"type":"text","text":"modal-only host, follows "},{"type":"codeVoice","code":"EnvironmentMissingPolicy"},{"type":"text","text":" and fails loudly by"},{"type":"text","text":" "},{"type":"text","text":"default."}],"type":"paragraph"},{"level":2,"anchor":"Split-routing","type":"heading","text":"Split routing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RouterSplitHost"},{"text":" for a sidebar with a locally owned detail stack and modal","type":"text"},{"text":" ","type":"text"},{"text":"authority:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip surrounding view declaration","code":["RouterSplitHost(LibraryRoute.self) {","    LibrarySidebar()","} root: {","    ContentUnavailableView(\"Select a book\", systemImage: \"books.vertical\")","}"]},{"type":"paragraph","inlineContent":[{"text":"Sidebar selection and column visibility remain application and system state;","type":"text"},{"text":" ","type":"text"},{"text":"routes pushed from descendants appear in the detail column. ","type":"text"},{"type":"codeVoice","code":"RouterSplitHost"},{"text":" ","type":"text"},{"text":"is unavailable on watchOS, where the compiler directs callers to ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"text":".","type":"text"}]},{"type":"heading","level":2,"anchor":"Native-tabs","text":"Native tabs"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mark every parameterless case with "},{"type":"codeVoice","code":"@TabItem"},{"type":"text","text":". "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" then supplies"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTab"},{"type":"text","text":", "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":", and the metadata consumed by "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","enum AppTab {","    @TabItem(\"Home\", systemImage: \"house\")","    case home","","    @TabItem(\"Account\", systemImage: \"person\")","    case account","","    var destination: some View {","        switch self {","        case .home:","            Text(\"Home\")","        case .account:","            Text(\"Account\")","        }","    }","}","","struct AppTabs: View {","    var body: some View {","        RouterTabHost(AppTab.self, initial: .home)","    }","}","","struct AccountShortcut: View {","    @EnvironmentRouter(AppTab.self) private var router","","    var body: some View {","        Button(\"Account\") {","            router.select(.account)","            router.setBadge(1, for: .account)","        }","    }","}"]},{"type":"heading","level":2,"anchor":"Automatic-single-route-deep-links","text":"Automatic single-route deep links"},{"type":"paragraph","inlineContent":[{"text":"Give ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" literal origin allowlists and attach ","type":"text"},{"code":"@DeepLink","type":"codeVoice"},{"text":" to the cases","type":"text"},{"text":" ","type":"text"},{"text":"that accept URLs:","type":"text"}]},{"type":"codeListing","syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router(","    deepLinkSchemes: [\"myapp\", \"https\"],","    deepLinkHosts: [\"app.example.com\"]",")","enum DeepLinkRoute {","    @DeepLink(\"\/books\/:id\")","    case book(id: String)","","    case account","","    var destination: some View {","        switch self {","        case .book(let id):","            Text(\"Book \\(id)\")","        case .account:","            Text(\"Account\")","        }","    }","}","","struct DeepLinkRoot: View {","    var body: some View {","        RouterHost(DeepLinkRoute.self) {","            Text(\"Library\")","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"onOpenURL"},{"type":"text","text":" or parser is needed for this single-route path:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" pushes the resolved route."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterSplitHost"},{"text":" pushes it into the detail stack.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":" selects the resolved tab."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Origin allowlists fail closed. Generated matching prefers literal paths, then"},{"type":"text","text":" "},{"type":"text","text":"typed parameters, then terminal wildcards. Authentication, pending replay,"},{"type":"text","text":" "},{"type":"text","text":"multi-step plans, modal presentation style, and multi-window scene selection"},{"type":"text","text":" "},{"type":"text","text":"remain application-boundary concerns; use the deep-link pipeline and an"},{"type":"text","text":" "},{"type":"text","text":"externally owned store for those advanced policies."}]},{"type":"heading","level":2,"text":"Diagnostics","anchor":"Diagnostics"},{"type":"paragraph","inlineContent":[{"text":"The macros reject invalid declaration shapes before emitting a partial","type":"text"},{"text":" ","type":"text"},{"text":"conformance. Diagnostic codes are stable and grouped by surface:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"E001","type":"codeVoice"},{"type":"text","text":"–"},{"code":"E006","type":"codeVoice"},{"type":"text","text":", "},{"code":"W001","type":"codeVoice"},{"type":"text","text":"–"},{"code":"W003","type":"codeVoice"},{"type":"text","text":": enum and destination declarations"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"E007"},{"type":"text","text":"–"},{"type":"codeVoice","code":"E016"},{"type":"text","text":", "},{"type":"codeVoice","code":"W004"},{"type":"text","text":"–"},{"type":"codeVoice","code":"W005"},{"type":"text","text":": tabs"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"E017","type":"codeVoice"},{"text":"–","type":"text"},{"code":"E029","type":"codeVoice"},{"text":", ","type":"text"},{"code":"W006","type":"codeVoice"},{"text":"–","type":"text"},{"code":"W007","type":"codeVoice"},{"text":", ","type":"text"},{"code":"W012","type":"codeVoice"},{"text":": deep links","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"E030"},{"type":"text","text":"–"},{"type":"codeVoice","code":"E049"},{"text":", ","type":"text"},{"type":"codeVoice","code":"W008"},{"text":"–","type":"text"},{"type":"codeVoice","code":"W011"},{"text":": opt-in spatial scenes","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","type":"reference"},{"text":" for the complete code-to-recovery catalog.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The Swift type checker remains responsible for view initializer arguments,","type":"text"},{"text":" ","type":"text"},{"text":"exhaustive switching, and ","type":"text"},{"type":"codeVoice","code":"Hashable"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"Sendable"},{"text":" payload requirements. A","type":"text"},{"text":" ","type":"text"},{"text":"constrained generic router is supported when its payload meets those route","type":"text"},{"text":" ","type":"text"},{"text":"requirements:","type":"text"}]},{"code":["import SwiftUI","import InnoRouter","","@Router","enum DetailRoute<Value: Hashable & Sendable> {","    case detail(Value)","","    var destination: some View {","        Text(\"Detail\")","    }","}"],"syntax":"swift compile","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The macro cannot prove that a view is mounted below a matching host or that the","type":"text"},{"text":" ","type":"text"},{"text":"host publishes the action being invoked because SwiftUI’s environment","type":"text"},{"text":" ","type":"text"},{"text":"hierarchy is built at runtime. ","type":"text"},{"code":"EnvironmentRouter","type":"codeVoice"},{"text":" therefore diagnoses a","type":"text"},{"text":" ","type":"text"},{"text":"missing host, mismatched route type, or unavailable capability at action time.","type":"text"}]},{"level":2,"text":"Manual escape hatch","anchor":"Manual-escape-hatch","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Advanced targets can keep the compiler-plugin target out of their build graph"},{"type":"text","text":" "},{"type":"text","text":"by depending on the granular "},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":" product and writing the"},{"text":" ","type":"text"},{"text":"conformance directly:","type":"text"}]},{"syntax":"swift compile","type":"codeListing","code":["import SwiftUI","import InnoRouterSwiftUI","","enum ManualRoute: DestinationRoute {","    case settings","","    @MainActor","    @ViewBuilder","    static func destination(for route: Self) -> some View {","        switch route {","        case .settings:","            Text(\"Settings\")","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"This path keeps the same "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" runtime"},{"type":"text","text":" "},{"type":"text","text":"semantics; only the generated declaration work becomes explicit."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"abstract":[{"type":"text","text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to"},{"type":"text","text":" "},{"type":"text","text":"find the recovery without depending on the compiler’s surrounding wording."},{"type":"text","text":" "},{"type":"text","text":"Errors prevent the macro from emitting an incomplete routing contract."},{"type":"text","text":" "},{"type":"text","text":"Warnings identify valid code whose generated behavior is likely surprising or"},{"type":"text","text":" "},{"type":"text","text":"whose explicit declarations are redundant."}],"role":"article","title":"Macro diagnostics","kind":"article","url":"\/documentation\/innoroutermacros\/macro-diagnostics","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","type":"topic"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"abstract":[],"role":"collection","title":"InnoRouterTesting","kind":"symbol","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","type":"topic"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"url":"\/documentation\/innoroutermacros\/innoroutermacros","type":"topic","title":"InnoRouterMacros","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","abstract":[{"text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path","type":"text"},{"text":" ","type":"text"},{"text":"available for advanced composition.","type":"text"}],"role":"collectionGroup"}}}