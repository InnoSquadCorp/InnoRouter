{"abstract":[{"text":"InnoRouter macros infer generated member visibility from the attached enum.","type":"text"},{"text":" ","type":"text"},{"text":"They do not widen an internal route into public API.","type":"text"}],"sections":[],"primaryContentSections":[{"content":[{"text":"`@Routable` and `@CasePathable`","type":"heading","anchor":"Routable-and-CasePathable","level":2},{"type":"paragraph","inlineContent":[{"text":"For every ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"@CasePathable","type":"codeVoice"},{"text":") enum the macros emit:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"enum Cases { … }"},{"type":"text","text":" containing one "},{"type":"codeVoice","code":"static let"},{"type":"text","text":" per case."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"func is(_ casePath:) -> Bool"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"subscript(case:) -> Value?"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The access keyword applied to "},{"type":"codeVoice","code":"Cases"},{"text":", every case-path member, ","type":"text"},{"code":"is(_:)","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"subscript(case:)","type":"codeVoice"},{"text":" is inferred from the enclosing enum:","type":"text"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Enum modifier","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated members"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"public enum Foo","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"public"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"package enum Foo","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"package"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"internal enum Foo","type":"codeVoice"},{"text":" (or no modifier)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"internal","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"fileprivate enum Foo","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"fileprivate","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"private enum Foo","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"fileprivate","type":"codeVoice"},{"text":" (the narrowest level that remains reachable across the macro expansion)","type":"text"}]}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"Each case ","type":"text"},{"type":"codeVoice","code":"static let"},{"type":"text","text":" also receives any "},{"type":"codeVoice","code":"@available(...)"},{"type":"text","text":" attribute attached"},{"type":"text","text":" "},{"type":"text","text":"to the enum case, so a case gated on an OS version does not produce a"},{"type":"text","text":" "},{"type":"codeVoice","code":"CasePath"},{"type":"text","text":" member with wider availability than the underlying case."}]},{"level":2,"text":"`@Router`","anchor":"Router","type":"heading"},{"inlineContent":[{"code":"@Router","type":"codeVoice"},{"text":" adds ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@ViewBuilder","type":"codeVoice"},{"text":" to the developer-declared","type":"text"},{"text":" ","type":"text"},{"text":"instance ","type":"text"},{"code":"destination","type":"codeVoice"},{"text":" property. It does not change that property’s declared","type":"text"},{"text":" ","type":"text"},{"text":"access level.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The generated ","type":"text"},{"type":"codeVoice","code":"static destination(for:)"},{"text":" protocol witness follows the enum’s","type":"text"},{"text":" ","type":"text"},{"text":"effective access level. This means a public router can keep the instance hook","type":"text"},{"text":" ","type":"text"},{"text":"private while exposing only the witness required by ","type":"text"},{"type":"codeVoice","code":"DestinationRoute"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import SwiftUI","import InnoRouter","","@Router","public enum PublicRoute {","    case settings","","    private var destination: some View {","        Text(\"Settings\")","    }","}"],"type":"codeListing","syntax":"swift compile"},{"inlineContent":[{"type":"text","text":"For a "},{"type":"codeVoice","code":"private"},{"type":"text","text":" enum, the generated witness uses "},{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":", matching the"},{"type":"text","text":" "},{"type":"text","text":"case-path macros’ same-file fallback. Do not declare "},{"type":"codeVoice","code":": DestinationRoute"},{"type":"text","text":" "},{"type":"text","text":"yourself; "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" supplies the conformance and warns when the direct"},{"type":"text","text":" "},{"type":"text","text":"conformance is redundant."}],"type":"paragraph"},{"anchor":"Compatibility-for-pre-OSS-snapshots","level":2,"text":"Compatibility for pre-OSS snapshots","type":"heading"},{"inlineContent":[{"type":"text","text":"Before the 4.0.0 OSS release, internal macro snapshots always emitted"},{"type":"text","text":" "},{"type":"text","text":"case-path members as "},{"type":"codeVoice","code":"public"},{"type":"text","text":". Teams that tested those snapshots should check"},{"type":"text","text":" "},{"type":"text","text":"three patterns:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Enum and CasePath usage already match.","type":"text"}],"type":"strong"},{"text":" No action is needed. Generated","type":"text"},{"text":" ","type":"text"},{"text":"members tighten to match the enum, and same-module consumer code keeps","type":"text"},{"text":" ","type":"text"},{"text":"compiling.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"A sibling module reads generated members from a non-public enum.","type":"text"}],"type":"strong"},{"text":" Mark","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the enum "},{"code":"public","type":"codeVoice"},{"type":"text","text":"; the old expansion was widening the surface implicitly."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Enum cases are gated on "},{"type":"codeVoice","code":"@available(...)"},{"type":"text","text":"."}]},{"text":" Generated ","type":"text"},{"type":"codeVoice","code":"CasePath"},{"text":" members","type":"text"},{"text":" ","type":"text"},{"text":"now carry the same availability. Narrow the enclosing function or branch on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"if #available(...)"},{"text":" at any downstream call site that used a wider window.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","anchor":"Why-private-maps-to-fileprivate","level":2,"text":"Why `private` maps to `fileprivate`"},{"inlineContent":[{"text":"Generated declarations can originate from distinct macro expansion roles.","type":"text"},{"text":" ","type":"text"},{"text":"Using ","type":"text"},{"code":"fileprivate","type":"codeVoice"},{"text":" preserves same-file access between those declarations while","type":"text"},{"text":" ","type":"text"},{"text":"remaining narrower than module-wide ","type":"text"},{"code":"internal","type":"codeVoice"},{"text":" visibility.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Manual-visibility-control","level":2,"text":"Manual visibility control"},{"inlineContent":[{"text":"The macros do not expose a visibility override. Mark the enclosing enum","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"public"},{"type":"text","text":" when its generated members must be public; otherwise generated members"},{"type":"text","text":" "},{"type":"text","text":"follow the declaration’s effective access level. If a generated surface is not"},{"type":"text","text":" "},{"type":"text","text":"appropriate, remove the macro and write the conformance or case-path members"},{"type":"text","text":" "},{"type":"text","text":"explicitly."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","title":"Macro-generated access levels","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/guide-macrovisibility"]}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"url":"\/documentation\/innoroutermacros\/innoroutermacros","type":"topic","title":"InnoRouterMacros","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","abstract":[{"text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path","type":"text"},{"text":" ","type":"text"},{"text":"available for advanced composition.","type":"text"}],"role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"abstract":[],"role":"collection","title":"InnoRouterTesting","kind":"symbol","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","type":"topic"}}}