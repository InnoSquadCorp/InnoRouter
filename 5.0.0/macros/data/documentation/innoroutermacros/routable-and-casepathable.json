{"kind":"article","identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For most SwiftUI routers, start with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":". It combines route data and"},{"type":"text","text":" "},{"type":"text","text":"destination views in one enum. Add one of the case-path macros only when a"},{"type":"text","text":" "},{"type":"text","text":"feature also needs to inspect or extract a particular enum case."}]},{"type":"heading","text":"`@Routable`","anchor":"Routable","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" generates "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" conformance plus typed "},{"type":"codeVoice","code":"Cases"},{"type":"text","text":", "},{"type":"codeVoice","code":"is(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"subscript(case:)"},{"type":"text","text":" helpers. It is useful for route models that do not own"},{"type":"text","text":" "},{"type":"text","text":"destination views, such as a domain route consumed by a coordinator or planner."}]},{"type":"paragraph","inlineContent":[{"text":"Do not repeat ","type":"text"},{"type":"codeVoice","code":": Route"},{"type":"text","text":"; the macro supplies that conformance:"}]},{"code":["import InnoRouter","","@Routable","enum AccountRoute {","    case overview","    case profile(userID: String)","}","","let route = AccountRoute.profile(userID: \"42\")","route[case: AccountRoute.Cases.profile]  \/\/ Optional(\"42\")","route.is(AccountRoute.Cases.overview)    \/\/ false"],"type":"codeListing","syntax":"swift compile"},{"type":"heading","level":2,"text":"`@CasePathable`","anchor":"CasePathable"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@CasePathable"},{"text":" generates the same case-path members without adding","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Route"},{"text":" conformance. Compose it with ","type":"text"},{"type":"codeVoice","code":"@Router"},{"text":" when a destination-owning","type":"text"},{"text":" ","type":"text"},{"text":"router also needs typed extraction:","type":"text"}]},{"code":["import SwiftUI","import InnoRouter","","@Router","@CasePathable","enum SearchRoute {","    case result(id: String)","","    var destination: some View {","        Text(\"Search result\")","    }","}","","let route = SearchRoute.result(id: \"42\")","route[case: SearchRoute.Cases.result]  \/\/ Optional(\"42\")"],"type":"codeListing","syntax":"swift compile"},{"type":"paragraph","inlineContent":[{"type":"text","text":"It is also useful on enums that are not routes at all but still need reusable"},{"type":"text","text":" "},{"type":"text","text":"case extraction."}]},{"type":"heading","level":2,"text":"Examples vs smoke fixtures","anchor":"Examples-vs-smoke-fixtures"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The repository intentionally builds both example layers:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Examples\/"},{"type":"text","text":" covers macro-first entry points and explicitly advanced Store \/"},{"type":"text","text":" "},{"type":"text","text":"Coordinator composition; every human-facing example has a SwiftPM build"},{"type":"text","text":" "},{"type":"text","text":"target."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ExamplesSmoke\/","type":"codeVoice"},{"text":" mirrors the public runtime surface with conservative","type":"text"},{"text":" ","type":"text"},{"text":"fixtures. Its dedicated ","type":"text"},{"code":"MacrosSmoke.swift","type":"codeVoice"},{"text":" target depends only on","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouter","type":"codeVoice"},{"text":" and proves the one-product macro-first consumer contract.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Macro expansion itself is covered by ","type":"text"},{"code":"InnoRouterMacrosTests","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterMacrosBehaviorTests","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","text":"Limitations: generic enums","anchor":"Limitations-generic-enums","level":2},{"type":"paragraph","inlineContent":[{"text":"Both ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@CasePathable","type":"codeVoice"},{"text":" reject generic enum declarations with an","type":"text"},{"text":" ","type":"text"},{"text":"explicit compiler error:","type":"text"}]},{"type":"codeListing","code":["@Routable","enum Generic<T> { case detail(T) } \/\/ error: @Routable does not support generic enum declarations"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"The generated ","type":"text"},{"code":"enum Cases","type":"codeVoice"},{"text":" would need to materialise ","type":"text"},{"code":"CasePath<Self, T>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"members for each generic instantiation, but Swift does not propagate the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"parent’s generic parameters into a nested type that way. Diagnostic ID"},{"text":" ","type":"text"},{"code":"InnoRouterMacro.E003","type":"codeVoice"},{"type":"text","text":" is emitted on the generic parameter clause. See"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","isActive":true},{"type":"text","text":" for the complete diagnostic catalog."}]},{"type":"paragraph","inlineContent":[{"text":"This limitation does not apply to ","type":"text"},{"type":"codeVoice","code":"@Router"},{"text":". A constrained generic router is","type":"text"},{"text":" ","type":"text"},{"text":"supported as long as its payloads satisfy the ","type":"text"},{"type":"codeVoice","code":"Route"},{"text":" requirements:","type":"text"}]},{"syntax":"swift compile","type":"codeListing","code":["import SwiftUI","import InnoRouter","","@Router","enum DetailRoute<Value: Hashable & Sendable> {","    case detail(Value)","","    var destination: some View {","        Text(\"Detail\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"If a case-path route needs a generic data shape, expose a concrete payload type","type":"text"},{"text":" ","type":"text"},{"text":"from the non-generic route enum:","type":"text"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["struct DetailPayload<Value: Hashable & Sendable>: Hashable, Sendable {","    let value: Value","}","","typealias StringDetailPayload = DetailPayload<String>","","@Routable","enum AppRoute {","    case home","    case detail(StringDetailPayload)","}"]}]}],"metadata":{"roleHeading":"Article","role":"article","title":"Routable and CasePathable","modules":[{"name":"InnoRouterTesting"}]},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"sections":[],"abstract":[{"type":"text","text":"Use case-path macros when route code needs typed enum extraction in addition to"},{"type":"text","text":" "},{"type":"text","text":"InnoRouter’s macro-first destination routing."}],"variants":[{"paths":["\/documentation\/innoroutermacros\/routable-and-casepathable"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0}