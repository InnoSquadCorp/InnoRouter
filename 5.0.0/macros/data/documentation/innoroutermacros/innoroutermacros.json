{"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"InnoRouter 5 makes macros part of the canonical ","type":"text"},{"code":"InnoRouter","type":"codeVoice"},{"text":" product. Most","type":"text"},{"text":" ","type":"text"},{"text":"applications add that one product and use one import:","type":"text"}]},{"type":"codeListing","code":["import SwiftUI","import InnoRouter"],"syntax":"swift compile"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The module exposes five macros with separate responsibilities:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"@Router","type":"codeVoice"},{"type":"text","text":" is the default macro-first path. It turns route cases and an"},{"type":"text","text":" "},{"type":"text","text":"instance "},{"code":"destination","type":"codeVoice"},{"type":"text","text":" view into a "},{"code":"DestinationRoute","type":"codeVoice"},{"type":"text","text":" that works with"},{"type":"text","text":" "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":", and generates tab or deep-link capabilities when their marker"},{"type":"text","text":" "},{"type":"text","text":"macros are present."}]}]},{"content":[{"inlineContent":[{"code":"@TabItem","type":"codeVoice"},{"type":"text","text":" marks parameterless router cases and generates the metadata used"},{"type":"text","text":" "},{"type":"text","text":"by "},{"code":"RouterTabHost","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" maps literal URL paths to typed router cases. "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" validates"},{"type":"text","text":" "},{"type":"text","text":"literal scheme and host allowlists and generates the "},{"type":"codeVoice","code":"DeepLinkRoute"},{"type":"text","text":" "},{"type":"text","text":"resolver. Generated matching prefers literal paths, then typed parameters,"},{"type":"text","text":" "},{"type":"text","text":"then terminal wildcards, regardless of case declaration order."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@Routable","type":"codeVoice"},{"text":" adds ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" conformance plus typed ","type":"text"},{"code":"Cases","type":"codeVoice"},{"text":", ","type":"text"},{"code":"is(_:)","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"subscript(case:)"},{"text":" helpers. It does not build destination views.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":" adds the same case-path helpers without adding "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" "},{"type":"text","text":"conformance."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every generated conformance has a plain Swift equivalent. Applications that"},{"type":"text","text":" "},{"type":"text","text":"need externally owned stores, coordinators, restoration, or custom dependency"},{"type":"text","text":" "},{"type":"text","text":"construction can continue to use the runtime APIs directly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The opt-in "},{"type":"codeVoice","code":"InnoRouterSpatial"},{"type":"text","text":" product adds "},{"type":"codeVoice","code":"@SceneRouter"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Scene"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"visionOS app scenes. Those macros generate the scene tree installed in"},{"type":"text","text":" "},{"type":"codeVoice","code":"App.body"},{"type":"text","text":"; they are intentionally not part of the default "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" "},{"type":"text","text":"umbrella."}]},{"level":2,"text":"Macro-first quick start","type":"heading","anchor":"Macro-first-quick-start"},{"code":["import SwiftUI","import InnoRouter","","@Router","enum AppRoute {","    case detail(id: String)","    case settings","","    var destination: some View {","        switch self {","        case .detail(let id):","            Text(\"Detail \\(id)\")","        case .settings:","            Text(\"Settings\")","        }","    }","}","","struct AppRoot: View {","    var body: some View {","        RouterHost(AppRoute.self) {","            HomeView()","        }","    }","}","","struct HomeView: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    var body: some View {","        Button(\"Open settings\") {","            router.go(.settings)","        }","    }","}"],"type":"codeListing","syntax":"swift compile"},{"type":"paragraph","inlineContent":[{"code":"@Router","type":"codeVoice"},{"type":"text","text":" supplies "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" through "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":", so do not add either"},{"type":"text","text":" "},{"type":"text","text":"conformance to "},{"type":"codeVoice","code":"AppRoute"},{"type":"text","text":". The "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" remains ordinary Swift and receives the"},{"type":"text","text":" "},{"type":"text","text":"compiler’s exhaustive-case checking."}]},{"level":2,"text":"Advanced granular imports","anchor":"Advanced-granular-imports","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import InnoRouter"},{"type":"text","text":" is the default application entry point. It re-exports the"},{"type":"text","text":" "},{"type":"text","text":"Core, SwiftUI, deep-link, and macro declarations together."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use granular products only when a target intentionally needs a narrower graph:"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product and import"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Advanced use case"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterCore"}]}],[{"type":"paragraph","inlineContent":[{"text":"Typed route state and command execution without SwiftUI or a compiler-plugin target in this target’s build graph.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"InnoRouterSwiftUI","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Manually conformed routes, externally owned stores, hosts, and coordinators without a compiler-plugin target in this target’s build graph.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterDeepLink"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Deep-link matching and planning without the SwiftUI authority layer."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterMacros"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A feature target that wants macro declarations plus their Core, SwiftUI, and deep-link runtime requirements without the full umbrella target."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterSpatial"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"visionOS windows, volumes, immersive spaces, and ornaments. This remains opt-in."}]}]]],"type":"table"},{"inlineContent":[{"text":"Keeping the compiler-plugin target out of a consumer target’s build graph","type":"text"},{"text":" ","type":"text"},{"text":"requires depending on granular runtime products instead of the ","type":"text"},{"type":"codeVoice","code":"InnoRouter"},{"text":" ","type":"text"},{"text":"umbrella. SwiftPM still resolves this package’s package-level ","type":"text"},{"type":"codeVoice","code":"swift-syntax"},{"text":" ","type":"text"},{"text":"dependency. Merely omitting a macro attribute from a file does not remove the","type":"text"},{"text":" ","type":"text"},{"text":"umbrella target’s macro dependency.","type":"text"}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/innoroutermacros"]}],"abstract":[{"type":"text","text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path"},{"type":"text","text":" "},{"type":"text","text":"available for advanced composition."}],"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable"]},{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics"]}],"metadata":{"role":"collectionGroup","modules":[{"name":"InnoRouterTesting"}],"title":"InnoRouterMacros"},"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"abstract":[],"role":"collection","title":"InnoRouterTesting","kind":"symbol","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","type":"topic"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"abstract":[{"type":"text","text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to"},{"type":"text","text":" "},{"type":"text","text":"find the recovery without depending on the compiler’s surrounding wording."},{"type":"text","text":" "},{"type":"text","text":"Errors prevent the macro from emitting an incomplete routing contract."},{"type":"text","text":" "},{"type":"text","text":"Warnings identify valid code whose generated behavior is likely surprising or"},{"type":"text","text":" "},{"type":"text","text":"whose explicit declarations are redundant."}],"role":"article","title":"Macro diagnostics","kind":"article","url":"\/documentation\/innoroutermacros\/macro-diagnostics","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","type":"topic"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Routable-and-CasePathable":{"title":"Routable and CasePathable","type":"topic","url":"\/documentation\/innoroutermacros\/routable-and-casepathable","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable","abstract":[{"type":"text","text":"Use case-path macros when route code needs typed enum extraction in addition to"},{"type":"text","text":" "},{"type":"text","text":"InnoRouter’s macro-first destination routing."}],"role":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Router-Macro-First":{"abstract":[{"type":"text","text":"Declare route data and destination views in one enum, then select the host that"},{"type":"text","text":" "},{"type":"text","text":"matches the surface. Stack, modal, split, tab, and single-route deep-link"},{"type":"text","text":" "},{"type":"text","text":"handling all keep the same "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" action API."}],"role":"article","title":"Macro-first routing with `@Router`","kind":"article","url":"\/documentation\/innoroutermacros\/router-macro-first","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","type":"topic"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Guide-MacroVisibility":{"kind":"article","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","title":"Macro-generated access levels","url":"\/documentation\/innoroutermacros\/guide-macrovisibility","abstract":[{"text":"InnoRouter macros infer generated member visibility from the attached enum.","type":"text"},{"text":" ","type":"text"},{"text":"They do not widen an internal route into public API.","type":"text"}],"role":"article"}}}