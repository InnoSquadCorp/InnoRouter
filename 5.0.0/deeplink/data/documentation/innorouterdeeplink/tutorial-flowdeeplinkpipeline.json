{"primaryContentSections":[{"content":[{"level":2,"text":"Scenario","anchor":"Scenario","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"myapp:\/\/app\/home\/detail\/42","type":"codeVoice"},{"type":"text","text":" should land the user on the order detail"},{"type":"text","text":" "},{"type":"text","text":"for order 42. "},{"code":"myapp:\/\/app\/onboarding\/privacy","type":"codeVoice"},{"type":"text","text":" should open a privacy"},{"type":"text","text":" "},{"type":"text","text":"sheet over the current screen. Authenticated routes like"},{"type":"text","text":" "},{"code":"myapp:\/\/app\/secure","type":"codeVoice"},{"type":"text","text":" defer until sign-in completes, then replay."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Push-only pipelines ("},{"code":"DeepLinkPipeline","type":"codeVoice"},{"type":"text","text":" → "},{"code":"NavigationPlan<R>","type":"codeVoice"},{"type":"text","text":") can’t"},{"type":"text","text":" "},{"type":"text","text":"express a URL that terminates on a modal. "},{"code":"FlowDeepLinkPipeline","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"solves that by emitting "},{"code":"FlowPlan","type":"codeVoice"},{"type":"text","text":" — a single value holding both"},{"type":"text","text":" "},{"type":"text","text":"the navigation prefix and the tail sheet\/cover."}]},{"level":2,"text":"Routes","anchor":"Routes","type":"heading"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["enum AppRoute: Route {","    case home","    case detail(id: String)","    case comments(id: String)","    case privacyPolicy","    case secure","}"]},{"level":2,"text":"Defining the matcher","anchor":"Defining-the-matcher","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"DeepLinkMapping","type":"codeVoice"},{"type":"text","text":" handlers return a "},{"inlineContent":[{"type":"text","text":"complete"}],"type":"strong"},{"type":"text","text":" "},{"code":"FlowPlan","type":"codeVoice"},{"type":"text","text":" so"},{"type":"text","text":" "},{"type":"text","text":"multi-segment URLs expand atomically. The shared pattern syntax uses"},{"type":"text","text":" "},{"code":":parameter","type":"codeVoice"},{"type":"text","text":" for captures, terminal "},{"code":"*","type":"codeVoice"},{"type":"text","text":" wildcard,"},{"type":"text","text":" "},{"type":"text","text":"path-only (host and scheme are filtered separately by the pipeline)."},{"type":"text","text":" "},{"type":"text","text":"Non-terminal wildcards such as "},{"code":"\/store\/*\/receipt","type":"codeVoice"},{"type":"text","text":" are invalid and"},{"type":"text","text":" "},{"type":"text","text":"surface diagnostics instead of matching."}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let matcher = DeepLinkMatcher<FlowPlan<AppRoute>> {","    DeepLinkMapping(\"\/home\") { _ in","        FlowPlan(steps: [.push(.home)])","    }","    DeepLinkMapping(\"\/home\/detail\/:id\") { params in","        guard let id = params.firstValue(forName: \"id\") else { return nil }","        return FlowPlan(steps: [.push(.home), .push(.detail(id: id))])","    }","    DeepLinkMapping(\"\/home\/detail\/:id\/comments\/:cid\") { params in","        guard let id = params.firstValue(forName: \"id\"),","              let cid = params.firstValue(forName: \"cid\") else { return nil }","        return FlowPlan(steps: [","            .push(.home),","            .push(.detail(id: id)),","            .push(.comments(id: cid))","        ])","    }","    DeepLinkMapping(\"\/onboarding\/privacy\") { _ in","        FlowPlan(steps: [.sheet(.privacyPolicy)])","    }","    DeepLinkMapping(\"\/secure\") { _ in","        FlowPlan(steps: [.push(.secure)])","    }","}"]},{"level":2,"text":"Wiring the pipeline","anchor":"Wiring-the-pipeline","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"FlowDeepLinkPipeline","type":"codeVoice"},{"type":"text","text":" composes scheme\/host validation,"},{"type":"text","text":" "},{"code":"DeepLinkAuthenticationPolicy","type":"codeVoice"},{"type":"text","text":" (reused from the push-only surface),"},{"type":"text","text":" "},{"type":"text","text":"and the matcher:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let pipeline = FlowDeepLinkPipeline<AppRoute>(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    matcher: matcher,","    authenticationPolicy: .required(","        shouldRequireAuthentication: { route in","            if case .secure = route { return true }","            return false","        },","        isAuthenticated: { SessionStore.shared.isAuthenticated }","    )",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For unguarded apps pass "},{"code":".notRequired","type":"codeVoice"},{"type":"text","text":" (the default) and skip the"},{"type":"text","text":" "},{"type":"text","text":"policy closure entirely."}]},{"anchor":"Applying-through-FlowStore","type":"heading","level":2,"text":"Applying through FlowStore"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowDeepLinkEffectHandler"},{"text":" bridges the pipeline output into any","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowPlanApplier"},{"type":"text","text":". It also owns the pending slot, so keep the handler"},{"type":"text","text":" "},{"type":"text","text":"in a stable owner rather than rebuilding it inside a SwiftUI body."},{"text":" ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" already conforms:","type":"text"}]},{"type":"codeListing","code":["import Foundation","import SwiftUI","import InnoRouter","import InnoRouterEffects","","private final class SessionStore {","    static let shared = SessionStore()","","    private let lock = NSLock()","    private var signedIn = false","","    var isAuthenticated: Bool {","        lock.withLock { signedIn }","    }","","    func markAuthenticated() {","        lock.withLock { signedIn = true }","    }","}","","@MainActor","private final class DeepLinkCoordinator {","    let flow: FlowStore<AppRoute>","    let handler: FlowDeepLinkEffectHandler<AppRoute>","    private let session: SessionStore","","    init(session: SessionStore = .shared) {","        self.session = session","        let flow = FlowStore<AppRoute>()","        self.flow = flow","","        let matcher = DeepLinkMatcher<FlowPlan<AppRoute>> {","            DeepLinkMapping(\"\/home\") { _ in","                FlowPlan(steps: [.push(.home)])","            }","            DeepLinkMapping(\"\/onboarding\/privacy\") { _ in","                FlowPlan(steps: [.sheet(.privacyPolicy)])","            }","            DeepLinkMapping(\"\/secure\") { _ in","                FlowPlan(steps: [.push(.secure)])","            }","        }","        let pipeline = FlowDeepLinkPipeline(","            allowedSchemes: [\"myapp\"],","            allowedHosts: [\"app\"],","            matcher: matcher,","            authenticationPolicy: .required(","                shouldRequireAuthentication: { route in","                    if case .secure = route { return true }","                    return false","                },","                isAuthenticated: { session.isAuthenticated }","            )","        )","        self.handler = FlowDeepLinkEffectHandler(","            pipeline: pipeline,","            applier: flow","        )","    }","","    func userDidSignIn() {","        session.markAuthenticated()","        _ = handler.resumePendingDeepLink()","    }","}","","@main","struct DemoApp: App {","    @State private var coordinator = DeepLinkCoordinator()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: coordinator.flow,","                destination: { route in","                    switch route {","                    case .home:","                        Text(\"Home\")","                    case .detail(let id):","                        Text(\"Detail \\(id)\")","                    case .comments(let id):","                        Text(\"Comments \\(id)\")","                    case .privacyPolicy:","                        Text(\"Privacy\")","                    case .secure:","                        Text(\"Secure\")","                    }","                },","                root: { Text(\"Root\") }","            )","            .onOpenURL { url in","                _ = coordinator.handler.handle(url)","            }","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"A single ","type":"text"},{"code":"handler.handle(url)","type":"codeVoice"},{"text":" call:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Runs scheme\/host validation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Walks the matcher for a ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Runs the authentication policy across the plan until it finds the"},{"text":" ","type":"text"},{"type":"text","text":"first protected route."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Either applies the plan through "},{"type":"codeVoice","code":"flow.apply(_:)"},{"type":"text","text":" or stores it as"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"FlowPendingDeepLink"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"level":2,"text":"Replaying after sign-in","anchor":"Replaying-after-sign-in","type":"heading"},{"inlineContent":[{"type":"text","text":"Once the user signs in, resume the pending deep link:"}],"type":"paragraph"},{"code":["func userDidSignIn() {","    coordinator.userDidSignIn()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The handler re-consults the authentication policy (now returning"},{"text":" ","type":"text"},{"type":"codeVoice","code":"true"},{"type":"text","text":"), drops the pending reference, and applies the plan atomically."},{"type":"text","text":" "},{"text":"For an async gate (e.g. token refresh), use:","type":"text"}],"type":"paragraph"},{"code":["await coordinator.handler.resumePendingDeepLinkIfAllowed { pending in","    \/\/ Return true once the refresh has produced a live session.","    await AuthService.shared.refreshTokenIfNeeded()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The handler keeps a single pending slot:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"a newly deferred URL replaces the older pending link","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"clearPendingDeepLink()","type":"codeVoice"},{"type":"text","text":" drops the slot explicitly"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"stale pending links (ones the user replaced by opening a different"},{"text":" ","type":"text"},{"text":"URL) are therefore dropped automatically","type":"text"}]}]}]},{"anchor":"Observing-the-chain","type":"heading","level":2,"text":"Observing the chain"},{"type":"paragraph","inlineContent":[{"text":"All three authorities surface on ","type":"text"},{"type":"codeVoice","code":"FlowStore.events"},{"text":" as one","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":". A single subscriber sees the batch execution on the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"navigation store, the modal presentation (if any), and the"},{"type":"text","text":" "},{"type":"text","text":"settled FlowStore-level event as one chain. "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" wraps inner"},{"type":"text","text":" "},{"type":"text","text":"navigation \/ modal events synchronously before emitting the"},{"type":"text","text":" "},{"type":"text","text":"flow-level event, so one subscriber can assert the same ordering that"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"type":"text","text":" observes. Capture the stream before starting"},{"type":"text","text":" "},{"type":"text","text":"its lifecycle-owned task so the subscriber exists before applying the link."}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let events = flow.events","let observationTask = Task { @MainActor in","    for await event in events {","        switch event {","        case .navigation(.batchExecuted(let result)):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .modal(.presented(let presentation)):","            analytics.track(\"deep_link_opened_modal\", [","                \"route\": String(describing: presentation.route)","            ])","        case .pathChanged(_, let new):","            analytics.track(\"flow_path\", [","                \"steps\": new.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"]},{"level":2,"text":"Host-less testing","anchor":"Host-less-testing","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"type":"text","text":" wraps the same "},{"code":"flowStore.apply","type":"codeVoice"},{"type":"text","text":" path:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@Test","@MainActor","func multiSegmentURLRehydrates() {","    let store = FlowTestStore<AppRoute>()","    let handler = FlowDeepLinkEffectHandler(pipeline: pipeline, applier: store.store)","","    _ = handler.handle(URL(string: \"myapp:\/\/app\/home\/detail\/42\")!)","","    store.receiveNavigation { event in","        if case .batchExecuted = event { return true }","        return false","    }","    store.receivePathChanged { _, new in","        new == [.push(.home), .push(.detail(id: \"42\"))]","    }","}"]},{"level":2,"text":"Next steps","anchor":"Next-steps","type":"heading"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"See the push-only "},{"type":"codeVoice","code":"Tutorial-DeepLinkReconciliation"},{"type":"text","text":" "},{"type":"text","text":"walk-through in the "},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":" catalog for apps that"},{"type":"text","text":" "},{"type":"text","text":"don’t yet need modal-terminal URLs."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read the "},{"type":"codeVoice","code":"Tutorial-LoginOnboarding"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":" documentation catalog to see how the"},{"type":"text","text":" "},{"type":"text","text":"authenticated-replay loop fits a greenfield flow that uses"},{"type":"text","text":" "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" for a sign-up sheet."}]}]}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterdeeplink\/tutorial-flowdeeplinkpipeline"]}],"metadata":{"roleHeading":"Article","title":"Rehydrating Composite Flows from a URL","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Tutorial-FlowDeepLinkPipeline","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"abstract":[{"text":"Map a URL to a ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":" with push prefix and optional modal","type":"text"},{"text":" ","type":"text"},{"text":"terminal step, run it through authentication gating, and replay the","type":"text"},{"text":" ","type":"text"},{"text":"deferred link through ","type":"text"},{"type":"codeVoice","code":"FlowDeepLinkEffectHandler"},{"text":" — all in one","type":"text"},{"text":" ","type":"text"},{"text":"atomic ","type":"text"},{"type":"codeVoice","code":"FlowStore.apply(_:)"},{"text":".","type":"text"}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"role":"collection","title":"InnoRouterTesting","type":"topic","kind":"symbol","abstract":[],"url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"type":"topic","role":"collectionGroup","title":"InnoRouterDeepLink","kind":"article","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","abstract":[{"text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter.","type":"text"}]}}}