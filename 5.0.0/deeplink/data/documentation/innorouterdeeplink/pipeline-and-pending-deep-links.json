{"primaryContentSections":[{"content":[{"anchor":"Construction","type":"heading","level":2,"text":"Construction"},{"type":"paragraph","inlineContent":[{"text":"Pass a matcher directly so matcher-specific input limits remain typed","type":"text"},{"type":"text","text":" "},{"type":"text","text":"rejections and the pipeline can reuse its parsed URL:"}]},{"type":"codeListing","code":["let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/products\/:id\") { parameters in","        parameters.firstValue(forName: \"id\").map { .product(id: $0) }","    }","}","","let pipeline = DeepLinkPipeline(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app.example.com\"],","    matcher: matcher",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"For routing rules that need the complete raw URL rather than pattern","type":"text"},{"text":" ","type":"text"},{"text":"matching, use the explicit escape hatch:","type":"text"}]},{"type":"codeListing","code":["let pipeline = DeepLinkPipeline<AppRoute>(","    customResolver: { url in legacyRouter.route(for: url) }",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"A custom resolver’s ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" result is ","type":"text"},{"type":"codeVoice","code":".unhandled"},{"text":". Pipeline-level input limits","type":"text"},{"text":" ","type":"text"},{"text":"still apply, but only the ","type":"text"},{"type":"codeVoice","code":"matcher:"},{"text":" path can preserve matcher-specific limit","type":"text"},{"text":" ","type":"text"},{"text":"violations.","type":"text"}]},{"type":"heading","level":2,"anchor":"Pipeline-stages","text":"Pipeline stages"},{"type":"paragraph","inlineContent":[{"text":"A pipeline can:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reject a URL when configured input limits are exceeded"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reject a URL by scheme or host"}]}]},{"content":[{"inlineContent":[{"text":"leave it unhandled","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"resolve it into a route","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"require authentication","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"convert the route into a ","type":"text"},{"code":"NavigationPlan","type":"codeVoice"}]}]}]},{"type":"heading","level":2,"text":"Pending deep links","anchor":"Pending-deep-links"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When authentication is required but not currently satisfied, the pipeline returns "},{"type":"codeVoice","code":"DeepLinkDecision.pending(_:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is deliberate:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the route that triggered authentication deferral is preserved","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the navigation plan is preserved"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"replay responsibility remains explicit at the app boundary","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That keeps auth transitions and navigation transitions separate instead of blending them into one hidden side effect."}]},{"type":"heading","level":2,"anchor":"Planning","text":"Planning"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The planner converts a route into the exact command list that should run after acceptance. This makes deep-link execution deterministic and testable."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Authentication checks the routes referenced by the produced"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":", including nested sequences and fallback commands."},{"type":"text","text":" "},{"type":"text","text":"If a custom planner returns no route-bearing commands, the pipeline"},{"type":"text","text":" "},{"type":"text","text":"falls back to the originally resolved route."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect handlers and coordinator bridges validate a produced"},{"type":"text","text":" "},{"code":"NavigationPlan","type":"codeVoice"},{"type":"text","text":" against the current "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" before executing it."},{"type":"text","text":" "},{"type":"text","text":"Plans that are obviously impossible, such as "},{"type":"codeVoice","code":".pop"},{"type":"text","text":" on an empty stack,"},{"type":"text","text":" "},{"type":"text","text":"surface as typed application rejections instead of partially running."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterdeeplink\/pipeline-and-pending-deep-links"]}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"title":"Pipeline and pending deep links","roleHeading":"Article","role":"article"},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Pipeline-and-Pending-Deep-Links","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"abstract":[{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":" is where URL acceptance and app policy meet."}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/In