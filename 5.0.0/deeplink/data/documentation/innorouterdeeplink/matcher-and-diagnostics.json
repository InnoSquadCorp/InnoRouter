{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Pattern-model","type":"heading","level":2,"text":"Pattern model"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Patterns support:"}]},{"items":[{"content":[{"inlineContent":[{"text":"literal segments","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"named parameters such as ","type":"text"},{"code":":id","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"terminal wildcard ","type":"text"},{"code":"*","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps matching simple and predictable for app routing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wildcards are terminal-only. A pattern like "},{"code":"\/api\/*\/users","type":"codeVoice"},{"type":"text","text":" is invalid:"},{"type":"text","text":" "},{"type":"text","text":"it produces a "},{"code":".nonTerminalWildcard(pattern:index:)","type":"codeVoice"},{"type":"text","text":" diagnostic and does"},{"type":"text","text":" "},{"type":"text","text":"not match runtime paths."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Captured values stay available as strings through "},{"code":"firstValue(forName:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"values(forName:)","type":"codeVoice"},{"type":"text","text":". For common scalar types, use the typed overloads:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let id = parameters.firstValue(forName: \"id\", as: UUID.self)","let page = parameters.firstValue(forName: \"page\", as: Int.self)","let selectedTags = parameters.values(forName: \"tag\", as: String.self)"]},{"anchor":"Match-precedence","type":"heading","level":2,"text":"Match precedence"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Match precedence remains declaration-order based."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That means:"}]},{"items":[{"content":[{"inlineContent":[{"text":"earlier patterns win","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"diagnostics do not change runtime behavior","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"ordering is still part of the matcher contract","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Diagnostics","type":"heading","level":2,"text":"Diagnostics"},{"type":"paragraph","inlineContent":[{"code":"DeepLinkMatcherConfiguration","type":"codeVoice"},{"type":"text","text":" can surface diagnostics for common authoring mistakes:"}]},{"items":[{"content":[{"inlineContent":[{"text":"duplicate patterns","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"wildcard shadowing","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"non-terminal wildcards","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"invalid parameter names; parameter names must match","type":"text"},{"text":" ","type":"text"},{"code":"^[A-Za-z_][A-Za-z0-9_]*$","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"parameter-heavy patterns that subsume more specific later patterns","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Diagnostics are available for every matcher output. They are intended"},{"type":"text","text":" "},{"type":"text","text":"to catch ambiguous authoring early without changing the matcher’s"},{"type":"text","text":" "},{"type":"text","text":"runtime semantics."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For release-readiness gates, use "},{"code":"DeepLinkMatcher(strict:)","type":"codeVoice"},{"type":"text","text":" with either"},{"type":"text","text":" "},{"type":"text","text":"a route or "},{"code":"FlowPlan<R>","type":"codeVoice"},{"type":"text","text":" output. Strict initializers throw"},{"type":"text","text":" "},{"code":"DeepLinkMatcherStrictError","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"the full diagnostic list instead of only logging warnings, and accept"},{"type":"text","text":" "},{"type":"text","text":"the same "},{"code":"DeepLinkInputLimits","type":"codeVoice"},{"type":"text","text":" guardrails used by non-strict matchers."}]},{"text":"Input limits","anchor":"Input-limits","type":"heading","level":2},{"inlineContent":[{"code":"DeepLinkInputLimits","type":"codeVoice"},{"text":" guards runtime URLs before matching. Configure it","type":"text"},{"text":" ","type":"text"},{"text":"on ","type":"text"},{"type":"codeVoice","code":"DeepLinkMatcherConfiguration"},{"text":", ","type":"text"},{"type":"codeVoice","code":"DeepLinkPipeline"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowDeepLinkPipeline"},{"text":" to cap absolute URL length, path segment count,","type":"text"},{"text":" ","type":"text"},{"text":"and query item count. Direct matcher calls still return ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" because","type":"text"},{"text":" ","type":"text"},{"text":"their public contract is optional. Pipeline and effect-handler paths","type":"text"},{"type":"text","text":" "},{"type":"text","text":"surface limit violations as typed"},{"type":"text","text":" "},{"type":"codeVoice","code":"DeepLinkRejectionReason.inputLimitExceeded"},{"text":" rejections instead of","type":"text"},{"text":" ","type":"text"},{"text":"“no match” outcomes when the pipeline receives the matcher through its","type":"text"},{"type":"text","text":" "},{"code":"matcher:","type":"codeVoice"},{"type":"text","text":" initializer. The "},{"code":"customResolver:","type":"codeVoice"},{"text":" escape hatch can surface only","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the pipeline’s own limits because an optional resolver result does not carry"},{"type":"text","text":" "},{"text":"matcher-specific rejection information.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"codeVoice","code":"DeepLinkMatcher"},{"type":"text","text":" is the URL-pattern front door for route and "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" deep-link outputs."}],"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"title":"Matcher and diagnostics","roleHeading":"Article","role":"article"},"variants":[{"paths":["\/documentation\/innorouterdeeplink\/matcher-and-diagnostics"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Matcher-and-Diagnostics","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"role":"collection","title":"InnoRouterTesting","type":"topic","kind":"symbol","abstract":[],"url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"type":"topic","role":"collectionGroup","title":"InnoRouterDeepLink","kind":"article","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","abstract":[{"text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRoute