keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}],"platforms":["macOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"level":2,"text":"Overview","anchor":"overview","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"code":"TestStore","type":"codeVoice"},{"type":"text","text":" exhaustivity model:"},{"type":"text","text":" "},{"type":"text","text":"events collected from the underlying authority’s unified "},{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"code":"receive(...)","type":"codeVoice"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"code":".strict","type":"codeVoice"},{"type":"text","text":" mode, the store reports events left pending at "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"code":"assertNoPendingEvents()","type":"codeVoice"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}]},{"style":"note","content":[{"inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"unknown test"}]},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}],"type":"paragraph"}],"type":"aside","name":"Note"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/innoroutertesting\/testexhaustivity"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting/TestExhaustivity/strict":{"type":"topic","role":"symbol","title":"TestExhaustivity.strict","kind":"symbol","url":"\/documentation\/innoroutertesting\/testexhaustivity\/strict","fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"strict"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict","abstract":[{"text":"Every observed event must be drained through ","type":"text"},{"type":"codeVoice","code":"receive(...)"},{"text":" before","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"finish()"},{"text":" or deallocation. Pending events fail the test. This is the","type":"text"},{"text":" ","type":"text"},{"text":"default and matches TCA’s ","type":"text"},{"type":"codeVoice","code":"exhaustive"},{"text":" semantics.","type":"text"}]},"doc://com.innosquad.innorouter.docs.deeplink/SH":{"title":"Swift.Hashable","type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/SH"},"doc://co