{"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"variants":[{"paths":["\/documentation\/innorouterdeeplink\/tutorial-flowdeeplinkpipeline"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"title":"Rehydrating Composite Flows from a URL","roleHeading":"Article"},"abstract":[{"type":"text","text":"Map a URL to a "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" with push prefix and optional modal"},{"type":"text","text":" "},{"type":"text","text":"terminal step, run it through authentication gating, and replay the"},{"type":"text","text":" "},{"type":"text","text":"deferred link through "},{"type":"codeVoice","code":"FlowDeepLinkEffectHandler"},{"type":"text","text":" — all in one"},{"type":"text","text":" "},{"type":"text","text":"atomic "},{"type":"codeVoice","code":"FlowStore.apply(_:)"},{"type":"text","text":"."}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Tutorial-FlowDeepLinkPipeline","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Scenario","type":"heading","level":2,"anchor":"Scenario"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"myapp:\/\/app\/home\/detail\/42"},{"text":" should land the user on the order detail","type":"text"},{"text":" ","type":"text"},{"text":"for order 42. ","type":"text"},{"type":"codeVoice","code":"myapp:\/\/app\/onboarding\/privacy"},{"text":" should open a privacy","type":"text"},{"text":" ","type":"text"},{"text":"sheet over the current screen. Authenticated routes like","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"myapp:\/\/app\/secure"},{"text":" defer until sign-in completes, then replay.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Push-only pipelines ("},{"code":"DeepLinkPipeline","type":"codeVoice"},{"type":"text","text":" → "},{"code":"NavigationPlan<R>","type":"codeVoice"},{"type":"text","text":") can’t"},{"type":"text","text":" "},{"type":"text","text":"express a URL that terminates on a modal. "},{"code":"FlowDeepLinkPipeline","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"solves that by emitting "},{"code":"FlowPlan","type":"codeVoice"},{"text":" — a single value holding both","type":"text"},{"text":" ","type":"text"},{"text":"the navigation prefix and the tail sheet\/cover.","type":"text"}]},{"text":"Routes","type":"heading","level":2,"anchor":"Routes"},{"syntax":"swift skip doc-fragment","code":["enum AppRoute: Route {","    case home","    case detail(id: String)","    case comments(id: String)","    case privacyPolicy","    case secure","}"],"type":"codeListing"},{"text":"Defining the matcher","type":"heading","level":2,"anchor":"Defining-the-matcher"},{"type":"paragraph","inlineContent":[{"code":"FlowDeepLinkMapping","type":"codeVoice"},{"text":" handlers return a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"complete"}]},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" so","type":"text"},{"text":" ","type":"text"},{"text":"multi-segment URLs expand atomically. Pattern syntax matches","type":"text"},{"text":" ","type":"text"},{"code":"DeepLinkMapping","type":"codeVoice"},{"text":": ","type":"text"},{"type":"codeVoice","code":":parameter"},{"type":"text","text":" for captures, terminal "},{"type":"codeVoice","code":"*"},{"type":"text","text":" wildcard,"},{"type":"text","text":" "},{"type":"text","text":"path-only (host and scheme are filtered separately by the pipeline)."},{"type":"text","text":" "},{"type":"text","text":"Non-terminal wildcards such as "},{"type":"codeVoice","code":"\/store\/*\/receipt"},{"type":"text","text":" are invalid and"},{"text":" ","type":"text"},{"text":"surface diagnostics instead of matching.","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["let matcher = FlowDeepLinkMatcher<AppRoute> {","    FlowDeepLinkMapping(\"\/home\") { _ in","        FlowPlan(steps: [.push(.home)])","    }","    FlowDeepLinkMapping(\"\/home\/detail\/:id\") { params in","        guard let id = params.firstValue(forName: \"id\") else { return nil }","        return FlowPlan(steps: [.push(.home), .push(.detail(id: id))])","    }","    FlowDeepLinkMapping(\"\/home\/detail\/:id\/comments\/:cid\") { params in","        guard let id = params.firstValue(forName: \"id\"),","              let cid = params.firstValue(forName: \"cid\") else { return nil }","        return FlowPlan(steps: [","            .push(.home),","            .push(.detail(id: id)),","            .push(.comments(id: cid))","        ])","    }","    FlowDeepLinkMapping(\"\/onboarding\/privacy\") { _ in","        FlowPlan(steps: [.sheet(.privacyPolicy)])","    }","    FlowDeepLinkMapping(\"\/secure\") { _ in","        FlowPlan(steps: [.push(.secure)])","    }","}"],"type":"codeListing"},{"text":"Wiring the pipeline","type":"heading","level":2,"anchor":"Wiring-the-pipeline"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowDeepLinkPipeline"},{"type":"text","text":" composes scheme\/host validation,"},{"type":"text","text":" "},{"type":"codeVoice","code":"DeepLinkAuthenticationPolicy"},{"type":"text","text":" (reused from the push-only surface),"},{"type":"text","text":" "},{"type":"text","text":"and the matcher:"}]},{"syntax":"swift skip doc-fragment","code":["let pipeline = FlowDeepLinkPipeline<AppRoute>(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    matcher: matcher,","    authenticationPolicy: .required(","        shouldRequireAuthentication: { route in","            if case .secure = route { return true }","            return false","        },","        isAuthenticated: { SessionStore.shared.isAuthenticated }","    )",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"For unguarded apps pass ","type":"text"},{"code":".notRequired","type":"codeVoice"},{"text":" (the default) and skip the","type":"text"},{"text":" ","type":"text"},{"text":"policy closure entirely.","type":"text"}]},{"text":"Applying through FlowStore","type":"heading","level":2,"anchor":"Applying-through-FlowStore"},{"type":"paragraph","inlineContent":[{"code":"FlowDeepLinkEffectHandler","type":"codeVoice"},{"text":" bridges the pipeline output into any","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlanApplier","type":"codeVoice"},{"text":". It also owns the pending slot, so keep the handler","type":"text"},{"text":" ","type":"text"},{"text":"in a stable owner rather than rebuilding it inside a SwiftUI body.","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" already conforms:","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["import Foundation","import SwiftUI","import InnoRouter","import InnoRouterDeepLinkEffects","","private final class SessionStore {","    static let shared = SessionStore()","","    private let lock = NSLock()","    private var signedIn = false","","    var isAuthenticated: Bool {","        lock.withLock { signedIn }","    }","","    func markAuthenticated() {","        lock.withLock { signedIn = true }","    }","}","","@MainActor","private final class DeepLinkCoordinator {","    let flow: FlowStore<AppRoute>","    let handler: FlowDeepLinkEffectHandler<AppRoute>","    private let session: SessionStore","","    init(session: SessionStore = .shared) {","        self.session = session","        let flow = FlowStore<AppRoute>()","        self.flow = flow","","        let matcher = FlowDeepLinkMatcher<AppRoute> {","            FlowDeepLinkMapping(\"\/home\") { _ in","                FlowPlan(steps: [.push(.home)])","            }","            FlowDeepLinkMapping(\"\/onboarding\/privacy\") { _ in","                FlowPlan(steps: [.sheet(.privacyPolicy)])","            }","            FlowDeepLinkMapping(\"\/secure\") { _ in","                FlowPlan(steps: [.push(.secure)])","            }","        }","        let pipeline = FlowDeepLinkPipeline(","            allowedSchemes: [\"myapp\"],","            allowedHosts: [\"app\"],","            matcher: matcher,","            authenticationPolicy: .required(","                shouldRequireAuthentication: { route in","                    if case .secure = route { return true }","                    return false","                },","                isAuthenticated: { session.isAuthenticated }","            )","        )","        self.handler = FlowDeepLinkEffectHandler(","            pipeline: pipeline,","            applier: flow","        )","    }","","    func userDidSignIn() {","        session.markAuthenticated()","        _ = handler.resumePendingDeepLink()","    }","}","","@main","struct DemoApp: App {","    @State private var coordinator = DeepLinkCoordinator()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: coordinator.flow,","                destination: { route in","                    switch route {","                    case .home:","                        Text(\"Home\")","                    case .detail(let id):","                        Text(\"Detail \\(id)\")","                    case .comments(let id):","                        Text(\"Comments \\(id)\")","                    case .privacyPolicy:","                        Text(\"Privacy\")","                    case .secure:","                        Text(\"Secure\")","                    }","                },","                root: { Text(\"Root\") }","            )","            .onOpenURL { url in","                _ = coordinator.handler.handle(url)","            }","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A single "},{"type":"codeVoice","code":"handler.handle(url)"},{"type":"text","text":" call:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Runs scheme\/host validation.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Walks the matcher for a ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Runs the authentication policy across the plan until it finds the"},{"type":"text","text":" "},{"type":"text","text":"first protected route."}]}]},{"content":[{"inlineContent":[{"text":"Either applies the plan through ","type":"text"},{"type":"codeVoice","code":"flow.apply(_:)"},{"text":" or stores it as","type":"text"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"type":"codeVoice","code":"FlowPendingDeepLink"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"text":"Replaying after sign-in","type":"heading","level":2,"anchor":"Replaying-after-sign-in"},{"type":"paragraph","inlineContent":[{"text":"Once the user signs in, resume the pending deep link:","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["func userDidSignIn() {","    coordinator.userDidSignIn()","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The handler re-consults the authentication policy (now returning","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"true"},{"text":"), drops the pending reference, and applies the plan atomically.","type":"text"},{"text":" ","type":"text"},{"text":"For an async gate (e.g. token refresh), use:","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["await coordinator.handler.resumePendingDeepLinkIfAllowed { pending in","    \/\/ Return true once the refresh has produced a live session.","    await AuthService.shared.refreshTokenIfNeeded()","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The handler keeps a single pending slot:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a newly deferred URL replaces the older pending link"}]}]},{"content":[{"inlineContent":[{"code":"clearPendingDeepLink()","type":"codeVoice"},{"type":"text","text":" drops the slot explicitly"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"stale pending links (ones the user replaced by opening a different","type":"text"},{"text":" ","type":"text"},{"text":"URL) are therefore dropped automatically","type":"text"}]}]}]},{"text":"Observing the chain","type":"heading","level":2,"anchor":"Observing-the-chain"},{"type":"paragraph","inlineContent":[{"text":"All three authorities surface on ","type":"text"},{"code":"FlowStore.events","type":"codeVoice"},{"text":" as one","type":"text"},{"text":" ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":". A single subscriber sees the batch execution on the","type":"text"},{"text":" ","type":"text"},{"text":"navigation store, the modal presentation (if any), and the","type":"text"},{"text":" ","type":"text"},{"text":"settled FlowStore-level event as one chain. ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" wraps inner","type":"text"},{"text":" ","type":"text"},{"text":"navigation \/ modal callbacks synchronously before emitting the","type":"text"},{"text":" ","type":"text"},{"text":"flow-level event, so one subscriber can assert the same ordering the","type":"text"},{"text":" ","type":"text"},{"text":"matching configuration callbacks observe.","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["Task {","    for await event in flow.events {","        switch event {","        case .navigation(.batchExecuted(let result)):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .modal(.presented(let presentation)):","            analytics.track(\"deep_link_opened_modal\", [","                \"route\": String(describing: presentation.route)","            ])","        case .pathChanged(_, let new):","            analytics.track(\"flow_path\", [","                \"steps\": new.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"],"type":"codeListing"},{"text":"Host-less testing","type":"heading","level":2,"anchor":"Host-less-testing"},{"type":"paragraph","inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"text":" wraps the same ","type":"text"},{"code":"flowStore.apply","type":"codeVoice"},{"text":" path:","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func multiSegmentURLRehydrates() {","    let store = FlowTestStore<AppRoute>()","    let handler = FlowDeepLinkEffectHandler(pipeline: pipeline, applier: store.store)","","    _ = handler.handle(URL(string: \"myapp:\/\/app\/home\/detail\/42\")!)","","    store.receiveNavigation { event in","        if case .batchExecuted = event { return true }","        return false","    }","    store.receivePathChanged { _, new in","        new == [.push(.home), .push(.detail(id: \"42\"))]","    }","}"],"type":"codeListing"},{"text":"Next steps","type":"heading","level":2,"anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"See the push-only "},{"type":"codeVoice","code":"Tutorial-DeepLinkReconciliation"},{"type":"text","text":" "},{"type":"text","text":"walk-through in the "},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":" catalog for apps that"},{"type":"text","text":" "},{"type":"text","text":"don’t yet need modal-terminal URLs."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read the ","type":"text"},{"code":"Tutorial-LoginOnboarding","type":"codeVoice"},{"text":" guide in the","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterSwiftUI","type":"codeVoice"},{"text":" documentation catalog to see how the","type":"text"},{"text":" ","type":"text"},{"text":"authenticated-replay loop fits a greenfield flow that uses","type":"text"},{"text":" ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":" for a sign-up sheet.","type":"text"}]}]}]}]}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","role":"collectionGroup","kind":"article","type":"topic","abstract":[{"text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter.","type":"text"}],"title":"InnoRouterDeepLink","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"role":"collection","url":"\/documentation\/innoroutertesting","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","kind":"symbol","title":"InnoRouterTesting","abstract":[]}}}