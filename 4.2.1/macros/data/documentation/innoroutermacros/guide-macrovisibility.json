{"sections":[],"primaryContentSections":[{"content":[{"text":"What gets generated, and at what level","anchor":"What-gets-generated-and-at-what-level","type":"heading","level":2},{"inlineContent":[{"text":"For every ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"@CasePathable","type":"codeVoice"},{"text":") enum the macros emit:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"enum Cases { … }","type":"codeVoice"},{"text":" containing one ","type":"text"},{"code":"static let","type":"codeVoice"},{"text":" per case.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"func is(_ casePath:) -> Bool","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"subscript(case:) -> Value?"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"The access keyword applied to all four is inferred from the"},{"type":"text","text":" "},{"type":"text","text":"enclosing enum:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Enum modifier","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Generated members"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"public enum Foo"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"public"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"package enum Foo","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"package","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"internal enum Foo"},{"text":" (or no modifier)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"internal"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"fileprivate enum Foo","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"fileprivate","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"private enum Foo"}],"type":"paragraph"}],[{"inlineContent":[{"code":"fileprivate","type":"codeVoice"},{"text":" (lowest level the macro can emit while still letting same-file ","type":"text"},{"code":"is(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"subscript(case:)","type":"codeVoice"},{"text":" callers reach the cases)","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"Each case ","type":"text"},{"type":"codeVoice","code":"static let"},{"text":" also receives any ","type":"text"},{"type":"codeVoice","code":"@available(...)"},{"text":" ","type":"text"},{"text":"attribute attached to the enum case, so a case gated on an OS","type":"text"},{"text":" ","type":"text"},{"text":"version no longer produces a CasePath member with a wider","type":"text"},{"text":" ","type":"text"},{"text":"availability than the underlying case.","type":"text"}],"type":"paragraph"},{"anchor":"Compatibility-for-pre-OSS-snapshots","text":"Compatibility for pre-OSS snapshots","level":2,"type":"heading"},{"inlineContent":[{"text":"Before the 4.0.0 OSS release, internal macro snapshots always emitted","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"public"},{"text":". Teams that tested those snapshots should check three","type":"text"},{"text":" ","type":"text"},{"text":"patterns:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Enum and CasePath usage already match."}],"type":"strong"},{"text":" No action — the","type":"text"},{"text":" ","type":"text"},{"text":"generated members tighten to ","type":"text"},{"code":"internal","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"fileprivate","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"fileprivate","type":"codeVoice"},{"text":" matching the enum and the consumer code keeps","type":"text"},{"type":"text","text":" "},{"type":"text","text":"compiling because it was within the same module already."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Enum is not ","type":"text"},{"code":"public","type":"codeVoice"},{"text":" but a sibling module reads the","type":"text"},{"text":" ","type":"text"},{"text":"generated CasePath members.","type":"text"}]},{"type":"text","text":" Mark the enum "},{"type":"codeVoice","code":"public"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"pre-OSS behaviour was effectively widening the surface for you;"},{"type":"text","text":" "},{"type":"text","text":"4.0.0 makes the boundary explicit."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Enum cases are gated on ","type":"text"},{"code":"@available(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"strong"},{"type":"text","text":" The generated"},{"type":"text","text":" "},{"type":"text","text":"CasePath members now carry the same availability. If a"},{"type":"text","text":" "},{"type":"text","text":"downstream call site compiled under a wider availability"},{"type":"text","text":" "},{"type":"text","text":"window before, narrow the enclosing function or branch on"},{"type":"text","text":" "},{"code":"if #available(...)","type":"codeVoice"},{"type":"text","text":" to match."}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Why `private` enums emit `fileprivate`","anchor":"Why-private-enums-emit-fileprivate","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift does not let an extension method (the macro emits"},{"type":"text","text":" "},{"code":"is(_:)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"subscript(case:)","type":"codeVoice"},{"text":" as members on the enum itself,","type":"text"},{"text":" ","type":"text"},{"text":"not on a generated extension) reference a ","type":"text"},{"code":"private","type":"codeVoice"},{"text":" ","type":"text"},{"text":"declaration in its own scope when that declaration came from","type":"text"},{"text":" ","type":"text"},{"text":"a distinct macro plugin call. Falling back to ","type":"text"},{"code":"fileprivate","type":"codeVoice"},{"text":" ","type":"text"},{"text":"gives the same effective scope for any caller in the same file","type":"text"},{"text":" ","type":"text"},{"text":"without breaking the macro expansion.","type":"text"}]},{"text":"Opt-out","anchor":"Opt-out","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"@Routable(visibility: .public)"},{"type":"text","text":" argument is on the v4.x"},{"type":"text","text":" "},{"type":"text","text":"roadmap for consumers that intentionally want the wider surface"},{"type":"text","text":" "},{"type":"text","text":"without making the enclosing enum public. Until then, mark the"},{"type":"text","text":" "},{"type":"text","text":"enum "},{"type":"codeVoice","code":"public"},{"type":"text","text":" to widen the generated members."}]}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Starting in 4.0.0 the "},{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":" macros"},{"type":"text","text":" "},{"type":"text","text":"infer the access level of every generated member from the"},{"type":"text","text":" "},{"type":"text","text":"enclosing enum. The previous behaviour emitted everything as"},{"type":"text","text":" "},{"type":"codeVoice","code":"public"},{"type":"text","text":", which leaked CasePath surface for "},{"type":"codeVoice","code":"internal"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"private"},{"type":"text","text":" enums that never intended that visibility."}],"hierarchy":{"paths":[