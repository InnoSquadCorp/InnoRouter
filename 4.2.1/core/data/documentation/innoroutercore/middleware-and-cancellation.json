{"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/middleware-and-cancellation"]}],"sections":[],"metadata":{"title":"Middleware and cancellation","modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"kind":"article","abstract":[{"text":"Middleware is the cross-cutting policy layer for navigation execution.","type":"text"}],"primaryContentSections":[{"content":[{"anchor":"Interception-phase","level":2,"text":"Interception phase","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"NavigationMiddleware.willExecute(_:state:)","type":"codeVoice"},{"text":" runs before the engine applies a command.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It returns "},{"type":"codeVoice","code":"NavigationInterception"},{"type":"text","text":":"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".proceed(updatedCommand)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".cancel(reason)","type":"codeVoice"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"This allows middleware to:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"rewrite commands","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"block execution","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"attach a typed cancellation reason"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Cancellation reasons live in "},{"type":"codeVoice","code":"NavigationCancellationReason"},{"type":"text","text":" and stay visible in the final "},{"type":"codeVoice","code":"NavigationResult"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Post-execution phase","type":"heading","anchor":"Post-execution-phase","level":2},{"inlineContent":[{"code":"NavigationMiddleware.didExecute(_:result:state:)","type":"codeVoice"},{"text":" folds the execution result after the engine runs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method can:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"inspect the final ","type":"text"},{"code":"RouteStack","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"transform the "},{"type":"codeVoice","code":"NavigationResult"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"attach analytics or logging side effects"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"It cannot mutate router state directly. State mutation authority stays in the executor."}],"type":"paragraph"},{"text":"Why middleware is synchronous","type":"heading","anchor":"Why-middleware-is-synchronous","level":2},{"inlineContent":[{"type":"text","text":"Core middleware is intentionally synchronous. Async policy checks belong at the app boundary rather than inside the core execution pipeline."}],"type":"paragraph"},{"inlineContent":[{"text":"If an app needs async authorization, use the effect-layer guarded execution helpers instead of making core middleware re-entrant and actor-heavy.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","title":"Inn