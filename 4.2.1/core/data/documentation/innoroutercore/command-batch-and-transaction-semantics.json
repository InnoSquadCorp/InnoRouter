{"abstract":[{"type":"text","text":"InnoRouter exposes three different execution semantics on purpose."}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"title":"Command, batch, and transaction semantics","role":"article","roleHeading":"Article"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Single-command execution","anchor":"Single-command-execution"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationCommand"},{"type":"text","text":" models one navigation transition or a recursive command composition."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Important cases:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".push","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".pushAll","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":".pop","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".popCount"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".popToRoot"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".popTo"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".replace","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sequence"}]}]},{"content":[{"inlineContent":[{"code":".whenCancelled","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"NavigationEngine","type":"codeVoice"},{"type":"text","text":" executes these commands against a "},{"code":"RouteStack","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Sequence semantics","anchor":"Sequence-semantics"},{"type":"paragraph","inlineContent":[{"code":".sequence","type":"codeVoice"},{"text":" is command algebra, not a transaction.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That means:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"commands execute left-to-right","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"earlier successful steps stay applied even if a later step fails"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"later steps still run unless the sequence itself has no more elements"}]}]},{"content":[{"inlineContent":[{"text":"the final result is ","type":"text"},{"code":"NavigationResult.multiple(_:)","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":".sequence","type":"codeVoice"},{"type":"text","text":" when partial success is acceptable and the command stream itself is the point."}]},{"type":"heading","level":2,"text":"Fallback semantics","anchor":"Fallback-semantics"},{"inlineContent":[{"type":"codeVoice","code":".whenCancelled(primary, fallback:)"},{"type":"text","text":" is also command algebra."}],"type":"paragraph"},{"inlineContent":[{"text":"That means:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"primary"},{"type":"text","text":" runs first"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if "},{"type":"codeVoice","code":"primary"},{"type":"text","text":" reports anything other than success, the store restores the snapshot and runs "},{"type":"codeVoice","code":"fallback"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"both legs still pass through middleware recursively"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"single-command execution only emits the committed state change"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"transaction execution keeps public middleware observation commit-only, while discarded preview legs run internal cleanup","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".whenCancelled"},{"type":"text","text":" when rollback-to-fallback semantics belong to one logical command."}],"type":"paragraph"},{"anchor":"Batch-semantics","type":"heading","level":2,"text":"Batch semantics"},{"inlineContent":[{"type":"codeVoice","code":"NavigationBatchExecutor.executeBatch(_:stopOnFailure:)"},{"text":" is for observation batching.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Batch execution still runs commands one step at a time, but it lets higher layers coalesce observation:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"step middleware still runs","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stopOnFailure: false"},{"text":" keeps later commands running after a failure","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stopOnFailure: true"},{"type":"text","text":" stops the batch after the first failed step"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the store can emit one aggregated callback"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the caller gets a structured "},{"type":"codeVoice","code":"NavigationBatchResult"}]}]}]},{"inlineContent":[{"text":"Use batch execution when the caller wants one “transition event” while still preserving per-step execution.","type":"text"}],"type":"paragraph"},{"anchor":"Transaction-semantics","type":"heading","level":2,"text":"Transaction semantics"},{"inlineContent":[{"type":"codeVoice","code":"NavigationTransactionExecutor.executeTransaction(_:)"},{"type":"text","text":" is the atomic option."}],"type":"paragraph"},{"inlineContent":[{"text":"Transactions:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"preview commands on a shadow stack"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"abort on the first failure or cancellation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"leave the real state unchanged on failure","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"commit the final state all at once on success","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"surface public ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" \/ transaction observation only for committed leaves","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"run internal discard cleanup for previewed leaves that never commit"}]}]}]},{"inlineContent":[{"text":"Use transactions when all-or-nothing semantics are required.","type":"text"}],"type":"paragraph"},{"anchor":"Typed-failures","type":"heading","level":2,"text":"Typed failures"},{"inlineContent":[{"text":"Core legality failures stay in typed results instead of exceptions:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.emptyStack"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.invalidPopCount(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NavigationResult.insufficientStackDepth(requested:available:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.routeNotFound(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.cancelled(_:)"}]}]}]},{"inlineContent":[{"text":"This keeps navigation failure in normal control flow and makes policy handling easy to pattern-match.","type":"