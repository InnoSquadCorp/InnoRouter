{"abstract":[{"type":"text","text":"How the "},{"type":"codeVoice","code":"events"},{"type":"text","text":" stream of every store handles slow or stuck subscribers."}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"kind":"article","variants":[{"paths":["\/documentation\/innoroutercore\/event-stream-backpressure"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Event Stream Backpressure","role":"article"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"Every ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SceneStore","type":"codeVoice"},{"text":" ","type":"text"},{"text":"publishes an ","type":"text"},{"code":"events: AsyncStream","type":"codeVoice"},{"type":"text","text":" that fans every observation event"},{"type":"text","text":" "},{"type":"text","text":"out to every subscriber. The fan-out is implemented as a per-subscriber"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncStream.Continuation"},{"type":"text","text":", which means a slow or cancelled subscriber"},{"type":"text","text":" "},{"type":"text","text":"that never drains its stream would otherwise retain every event"},{"type":"text","text":" "},{"type":"text","text":"indefinitely — behaving as an unbounded leak when the broadcaster"},{"text":" ","type":"text"},{"text":"outlives all consumers.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To bound that growth, every store accepts an"},{"type":"text","text":" "},{"type":"codeVoice","code":"EventBufferingPolicy"},{"type":"text","text":" in its configuration."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Default-policy","text":"Default policy"},{"inlineContent":[{"type":"text","text":"The default is "},{"type":"codeVoice","code":"EventBufferingPolicy.default"},{"type":"text","text":", which is"},{"type":"text","text":" "},{"type":"codeVoice","code":".bufferingNewest(1024)"},{"type":"text","text":". The number is sized for realistic navigation"},{"type":"text","text":" "},{"type":"text","text":"bursts (a few hundred events for the longest deep-link replay we have"},{"type":"text","text":" "},{"type":"text","text":"measured) while keeping the retained working set bounded so a stuck"},{"type":"text","text":" "},{"text":"subscriber cannot balloon memory in production.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Choosing-a-policy","text":"Choosing a policy"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Policy","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Behaviour"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"When to use"}]}]],[[{"inlineContent":[{"code":".bufferingNewest(N)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Retain at most "},{"code":"N","type":"codeVoice"},{"type":"text","text":" most-recently-broadcast events per subscriber, dropping older events when the buffer fills."}],"type":"paragraph"}],[{"inlineContent":[{"text":"Production code that prefers loss-of-history over memory growth under contention. The default.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".bufferingOldest(N)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Retain at most "},{"type":"codeVoice","code":"N"},{"type":"text","text":" oldest-broadcast events per subscriber, dropping newer events when the buffer fills."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Audit pipelines that care about the "},{"inlineContent":[{"type":"text","text":"first"}],"type":"emphasis"},{"type":"text","text":" burst more than the latest tail (rare)."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":".unbounded","type":"codeVoice"}]}],[{"inlineContent":[{"text":"Buffer every event until the subscriber drains it.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Test harnesses or short-lived subscribers where you control lifetime and require deterministic, lossless ordering."}],"type":"paragraph"}]]],"type":"table","header":"row"},{"level":2,"type":"heading","anchor":"Configuring-per-store","text":"Configuring per store"},{"inlineContent":[{"type":"text","text":"The policy is set per store at construction time via its configuration:"}],"type":"paragraph"},{"code":["let store = try NavigationStore<HomeRoute>(","    initialPath: [.list],","    configuration: NavigationStoreConfiguration(","        eventBufferingPolicy: .bufferingNewest(2048)","    )",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"Modal and Flow stores expose the same knob, with one policy per","type":"text"},{"text":" ","type":"text"},{"text":"published stream:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"code":"NavigationStoreConfiguration.eventBufferingPolicy","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ModalStoreConfiguration.eventBufferingPolicy"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FlowStoreConfiguration.eventBufferingPolicy"},{"type":"text","text":" for the flow-level"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore.events"},{"type":"text","text":" fan-out"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FlowStoreConfiguration.navigation.eventBufferingPolicy"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStoreConfiguration.modal.eventBufferingPolicy"},{"type":"text","text":" for the wrapped"},{"type":"text","text":" "},{"type":"text","text":"inner store streams"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","text":"Drop semantics under load","anchor":"Drop-semantics-under-load","level":2},{"type":"paragraph","inlineContent":[{"text":"Under sustained backpressure, the store keeps emitting events. Whether","type":"text"},{"text":" ","type":"text"},{"text":"the event reaches a slow subscriber depends on the policy chosen for","type":"text"},{"text":" ","type":"text"},{"text":"that subscriber’s store:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".bufferingNewest(N)"},{"type":"text","text":": oldest events are dropped silently. The"},{"type":"text","text":" "},{"type":"text","text":"subscriber sees a contiguous tail of the most recent N events the"},{"type":"text","text":" "},{"type":"text","text":"store emitted."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".bufferingOldest(N)","type":"codeVoice"},{"text":": newer events are dropped silently after the","type":"text"},{"text":" ","type":"text"},{"text":"buffer fills. The subscriber sees the first N events emitted after","type":"text"},{"text":" ","type":"text"},{"text":"it started subscribing.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unbounded"},{"text":": nothing is dropped, but the per-subscriber queue can","type":"text"},{"text":" ","type":"text"},{"text":"grow without bound while the subscriber falls behind.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Drops are not surfaced as an event. If your analytics pipeline must"},{"type":"text","text":" "},{"type":"text","text":"distinguish “no event happened” from “an event was buffered out”, use"},{"type":"text","text":" "},{"type":"codeVoice","code":".unbounded"},{"type":"text","text":" for that subscriber and rely on your own pacing rather"},{"type":"text","text":" "},{"type":"text","text":"than the broadcaster."}]},{"type":"heading","text":"Lifetime contract","anchor":"Lifetime-contract","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each subscriber owns one "},{"code":"AsyncStream","type":"codeVoice"},{"type":"text","text":". When the subscriber’s"},{"type":"text","text":" "},{"type":"text","text":"iterator goes out of scope, "},{"code":"AsyncStream.Continuation.onTermination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"fires and the broadcaster releases its slot. Stores also finish all"},{"type":"text","text":" "},{"type":"text","text":"outstanding continuations on "},{"code":"isolated deinit","type":"codeVoice"},{"type":"text","text":", so "},{"code":"for await","type":"codeVoice"},{"type":"text","text":" loops"},{"type":"text","text":" "},{"type":"text","text":"terminate naturally when their store is released — no manual cleanup"},{"type":"text","text":" "},{"type":"text","text":"required."}]},{"type":"heading","text":"Related","anchor":"Related","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Rejection-Reasons","isActive":true,"type":"reference"}]}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Event-Stream-Backpressure","interfaceLanguage":"swift"},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Middleware-and-Cancellation":{"abstract":[{"text":"Middleware is the cross-cutting policy layer for navigation execution.","type":"text"}],"kind":"article","role":"article","url":"\/documentation\/innoroutercore\/middleware-and-cancellation","title":"Middleware and cancellation","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","type":"topic"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","kind":"symbol","type":"topic","url":"\/documentation\/innoroutertesting","role":"collection"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"title":"InnoRouterCore","abstract":[{"type":"text","text":"State, command, result, and execution primitives for InnoRouter."}],"url":"\/documentation\/innoroutercore\/innoroutercore","kind":"article","type":"topic","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Rejection-Reasons":{"kind":"article","role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Rejection-Reasons","type":"topic","title":"Rejection Reasons catalog","url":"\/documentation\/innoroutercore\/rejection-reasons","abstract":[{"type":"text","text":"One-stop reference for every rejection \/ cancellation \/ failure"},{"type":"text","text":" "},{"type":"text","text":"taxonomy in the InnoRouter stack — when each case fires, where it"},{"type":"text","text":" "},{"type":"text","text":"originates, and how to handle it."}]}}}