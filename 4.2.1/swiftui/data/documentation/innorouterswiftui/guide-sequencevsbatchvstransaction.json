{"primaryContentSections":[{"content":[{"anchor":"Decision-matrix","type":"heading","level":2,"text":"Decision matrix"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"You want…","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reach for"}]}],[{"type":"paragraph","inlineContent":[{"text":"Why","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"One observable change for multiple commands, best-effort"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NavigationStore.executeBatch(_:stopOnFailure:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Per-step results, exactly one ","type":"text"},{"type":"codeVoice","code":"onChange"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" notification, optional fail-fast","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"All-or-nothing atomic apply with rollback on failure"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NavigationStore.executeTransaction(_:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shadow-state preview, journal-based discard, single ","type":"text"},{"code":"onTransactionExecuted","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Express the composite as one ","type":"text"},{"inlineContent":[{"type":"text","text":"command"}],"type":"emphasis"},{"text":" that the engine can validate, plan, or rebuild","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NavigationCommand.sequence([...])","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Pure value composition; flows through ","type":"text"},{"code":"NavigationEngine","type":"codeVoice"},{"text":" as a single command unit","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Schedule a single command after a quiet window"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DebouncingNavigator","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Async wrapping navigator, ","type":"text"},{"code":"Clock","type":"codeVoice"},{"text":"-injectable","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Rate-limit per key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ThrottleNavigationMiddleware","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Synchronous interception, last-accept timestamp"}],"type":"paragraph"}]]]},{"anchor":"Mental-model","type":"heading","level":2,"text":"Mental model"},{"inlineContent":[{"type":"codeVoice","code":".sequence"},{"type":"text","text":" is a "},{"type":"strong","inlineContent":[{"text":"value","type":"text"}]},{"type":"text","text":". It is just another "},{"type":"codeVoice","code":"NavigationCommand"},{"type":"text","text":" "},{"type":"text","text":"case, so it has the same semantics as any single command:"},{"type":"text","text":" "},{"type":"text","text":"deep-link planners can produce it, middleware can match against"},{"type":"text","text":" "},{"type":"text","text":"it, the engine evaluates it left-to-right and reports the"},{"type":"text","text":" "},{"type":"text","text":"component results as "},{"type":"codeVoice","code":".multiple([...])"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"code":"executeBatch","type":"codeVoice"},{"text":" is an ","type":"text"},{"inlineContent":[{"type":"text","text":"execution mode"}],"type":"strong"},{"text":". The store iterates the","type":"text"},{"text":" ","type":"text"},{"text":"commands, accepts partial success unless ","type":"text"},{"code":"stopOnFailure: true","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and coalesces observation: the SwiftUI state stays correct after","type":"text"},{"text":" ","type":"text"},{"text":"each step but only one ","type":"text"},{"code":"onChange","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" event surfaces at the","type":"text"},{"text":" ","type":"text"},{"text":"end. Use it for analytics-clean compound actions (“complete","type":"text"},{"text":" ","type":"text"},{"text":"checkout: replace stack + dismiss modal”).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"executeTransaction"},{"type":"text","text":" is an "},{"inlineContent":[{"text":"atomicity mode","type":"text"}],"type":"strong"},{"type":"text","text":". The store applies"},{"type":"text","text":" "},{"type":"text","text":"each command to a shadow stack, journals what middleware accepted"},{"type":"text","text":" "},{"type":"text","text":"or rejected, and only commits if every step succeeds. On failure,"},{"type":"text","text":" "},{"type":"text","text":"the journal walks back through the discarded acceptances so"},{"type":"text","text":" "},{"text":"middleware see consistent before\/after states. Use it for","type":"text"},{"text":" ","type":"text"},{"text":"correctness-critical compound actions (“if any step rejects, the","type":"text"},{"text":" ","type":"text"},{"text":"user sees no half-applied state”).","type":"text"}],"type":"paragraph"},{"anchor":"Worked-examples","type":"heading","level":2,"text":"Worked examples"},{"anchor":"Compose-a-single-command-that-drives-a-deep-link-plan","type":"heading","level":3,"text":"Compose a single command that drives a deep link plan"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let plan = NavigationPlan<AppRoute>(commands: [","    .replace([.home]),","    .push(.detail(id))","])","\/\/ Pass the plan to a single .sequence — the engine evaluates each","\/\/ component and reports `.multiple([...])` results.","let result = store.execute(.sequence(plan.commands))"]},{"inlineContent":[{"type":"text","text":"Use when the deep-link planner already represents the path as a"},{"type":"text","text":" "},{"type":"text","text":"sequence of "},{"type":"codeVoice","code":"NavigationCommand"},{"type":"text","text":"s and you want the planner output"},{"type":"text","text":" "},{"type":"text","text":"to flow through the same code path as a single command."}],"type":"paragraph"},{"anchor":"Apply-a-checkout-flow-as-one-observable-step","type":"heading","level":3,"text":"Apply a checkout flow as one observable step"},{"syntax":"swift skip doc-fragment","code":["let batch = store.executeBatch([","    .replace([.home]),","    .push(.orderConfirmation),","], stopOnFailure: false)","\/\/ Exactly one `events` emission of `.batchExecuted(batch)`.","analytics.track(batch.events) \/\/ snapshot, no per-step amplification"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use when partial success is acceptable but every step must show"},{"type":"text","text":" "},{"type":"text","text":"up in the same analytics event."}],"type":"paragraph"},{"anchor":"KYC-step-requiring-all-or-nothing","type":"heading","level":3,"text":"KYC step requiring all-or-nothing"},{"syntax":"swift skip doc-fragment","code":["let transaction = store.executeTransaction([","    .replace([.kycRoot]),","    .push(.kycDocumentUpload),","    .push(.kycReview),","])","guard transaction.isCommitted else {","    \/\/ Stack is back to its pre-transaction state; show error.","    return","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use when leaving the user on a half-rolled-out screen would be"},{"type":"text","text":" "},{"type":"text","text":"worse than showing a “please retry” message."}],"type":"paragraph"},{"anchor":"Async-debounce-on-a-search-field","type":"heading","level":3,"text":"Async debounce on a search field"},{"syntax":"swift skip doc-fragment","code":["let debouncing = DebouncingNavigator(","    wrapping: store,","    interval: .milliseconds(300)",")","\/\/ Each keystroke calls debouncedExecute; only the latest survives.","await debouncing.debouncedExecute(.replace([.searchResults(query: q)]))"],"type":"codeListing"},{"inli