":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DebouncingNavigator"}]}]}],"type":"unorderedList"}],"kind":"content"}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"role":"article","title":"Choosing Between `.sequence`, `executeBatch`, and `executeTransaction`","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}]},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"kind":"article","variants":[{"paths":["\/documentation\/innorouterswiftui\/guide-sequencevsbatchvstransaction"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Three ways to apply more than one navigation command in a row."},{"type":"text","text":" "},{"type":"text","text":"They are not interchangeable — pick the one whose contract matches"},{"type":"text","text":" "},{"type":"text","text":"the call site."}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Guide-SequenceVsBatchVsTransaction","interfaceLanguage":"swift"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"kind":"symbol","abstract":[],"title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","title":"InnoRouterSwiftUI","type":"topic","abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"ur