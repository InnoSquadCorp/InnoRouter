{"sections":[],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Split-Modal-and-Composition"},"kind":"article","metadata":{"title":"Split, modal, and composition patterns","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Stack navigation, split detail navigation, and modal presentation are intentionally separate authorities.","type":"text"}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/split-modal-and-composition"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Split navigation","level":2,"anchor":"Split-navigation","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"NavigationSplitHost"},{"type":"text","text":" or "},{"type":"codeVoice","code":"CoordinatorSplitHost"},{"type":"text","text":" when the app has a sidebar\/detail layout."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Important scope boundary:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter owns only the detail stack"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"sidebar selection remains app-owned"}]}]},{"content":[{"inlineContent":[{"text":"column visibility remains app-owned","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"compact adaptation remains app-owned","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This keeps shell state out of the stack authority."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NavigationSplitHost"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CoordinatorSplitHost"},{"type":"text","text":" are "},{"type":"strong","inlineContent":[{"type":"text","text":"unavailable on watchOS"}]},{"type":"text","text":" "},{"type":"text","text":"because SwiftUI’s "},{"type":"codeVoice","code":"NavigationSplitView"},{"type":"text","text":" is unavailable there. watchOS apps should fall back"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"CoordinatorHost"},{"type":"text","text":" in the "},{"type":"codeVoice","code":"#else"},{"type":"text","text":" branch of a"},{"type":"text","text":" "},{"type":"codeVoice","code":"#if !os(watchOS)"},{"type":"text","text":" check."}]}],"name":"Platform","style":"note","type":"aside"},{"text":"Modal navigation","level":2,"type":"heading","anchor":"Modal-navigation"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" with "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" when "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":" or "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" should be routed with the same discipline as stack navigation."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"On iOS and tvOS, "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" uses native "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":" and "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" presentation."},{"type":"text","text":" "},{"type":"text","text":"On other supported platforms, "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" requests degrade to "},{"type":"