pe":"text","text":" "},{"type":"text","text":"queue untouched; observers receive "},{"type":"codeVoice","code":".replaced"},{"type":"text","text":" before the command"},{"type":"text","text":" "},{"type":"text","text":"interception event."}]}]}]},{"type":"paragraph","inlineContent":[{"code":"alert","type":"codeVoice"},{"type":"text","text":" and "},{"code":"confirmationDialog","type":"codeVoice"},{"type":"text","text":" stay outside this framework surface and should remain feature-owned state."}]},{"type":"heading","level":2,"anchor":"Composition","text":"Composition"},{"type":"paragraph","inlineContent":[{"text":"The recommended composition order is:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"shell state such as tabs or app mode"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" if modal routing should be shared"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" or "},{"type":"codeVoice","code":"CoordinatorHost"},{"type":"text","text":" for stack routing"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"feature-local flow state inside a destination","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps each authority narrow and avoids one giant store owning every kind of navigation."}]}]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","title":"InnoRouterSwiftUI","type":"topic","abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","kind":"article","role":"collectionGroup"},"doc://c