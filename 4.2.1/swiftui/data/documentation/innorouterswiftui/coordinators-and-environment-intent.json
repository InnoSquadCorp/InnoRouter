{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Coordinator-role","type":"heading","level":2,"text":"Coordinator role"},{"inlineContent":[{"code":"Coordinator","type":"codeVoice"},{"text":" exists for cases where view intent should flow through a policy object before it reaches the store.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A coordinator:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"receives "},{"type":"codeVoice","code":"NavigationIntent"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"decides whether to forward, rewrite, or replace commands"}]}]},{"content":[{"inlineContent":[{"text":"maps routes to destinations","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"stays observable for SwiftUI"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" remains "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" by design because it is a shared authority object, not ephemeral view state."}],"type":"paragraph"},{"anchor":"Environment-intent","type":"heading","level":2,"text":"Environment intent"},{"inlineContent":[{"code":"EnvironmentNavigationIntent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"EnvironmentModalIntent","type":"codeVoice"},{"text":" are the primary view-facing APIs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This keeps view code declarative:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"child views do not need a direct store reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"fail-fast behavior catches host wiring mistakes early","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"multi-host trees can keep separate routing authorities in the same hierarchy"}],"type":"paragraph"}]}]},{"anchor":"Sibling-hosts-and-duplicate-registration","type":"heading","level":3,"text":"Sibling hosts and duplicate registration"},{"inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" owns its own"},{"type":"text","text":" "},{"type":"codeVoice","code":"*EnvironmentStorage"},{"type":"text","text":" instance through "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", so SwiftUI scopes the"},{"type":"text","text":" "},{"type":"text","text":"handler table to the host’s view subtree. Re-registering the"},{"type":"text","text":" "},{"type":"text","text":"same routing authority is allowed across SwiftUI updates, even when"},{"type":"text","text":" "},{"type":"text","text":"the forwarding closure is freshly allocated. A sibling host with a"},{"type":"text","text":" "},{"type":"text","text":"different authority that registers against the same "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" type in"},{"type":"text","text":" "},{"type":"text","text":"the same environment scope is treated as a wiring bug: in Debug"},{"type":"text","text":" "},{"type":"text","text":"builds the storage setter traps with "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":", and in"},{"type":"text","text":" "},{"type":"text","text":"Release it logs an error through the "},{"type":"codeVoice","code":"duplicate-dispatcher"},{"type":"text","text":" "},{"type":"codeVoice","code":"os_log"},{"type":"text","text":" category before letting the overwrite proceed (preserving"},{"type":"text","text":" "},{"type":"text","text":"prior behaviour for production cold-starts)."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If two surfaces legitimately need different routing authorities,"},{"type":"text","text":" "},{"type":"text","text":"either give them distinct "},{"code":"Route","type":"codeVoice"},{"type":"text","text":" types or scope them with separate"},{"type":"text","text":" "},{"type":"text","text":"environment subtrees so each host gets its own storage."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Low-level tests or custom integrations that write directly into an"},{"type":"text","text":" "},{"type":"text","text":"environment storage should either assign a handler once per storage"},{"type":"text","text":" "},{"type":"text","text":"instance, or call the explicit owner registration helper with a stable"},{"type":"text","text":" "},{"type":"text","text":"store \/ coordinator identity. The host modifiers do this for normal"},{"type":"text","text":" "},{"code":"NavigationHost","type":"codeVoice"},{"type":"text","text":", "},{"code":"ModalHost","type":"codeVoice"},{"type":"text","text":", and "},{"code":"FlowHost","type":"codeVoice"},{"type":"text","text":" usage."}],"type":"paragraph"},{"anchor":"Flow-and-tab-coordinators","type":"heading","level":2,"text":"Flow and tab coordinators"},{"inlineContent":[{"type":"codeVoice","code":"FlowCoordinator"},{"type":"text","text":" and "},{"type":"codeVoice","code":"TabCoordinator"},{"type":"text","text":" complement "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":"; they do not replace it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Recommended mental model:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" owns route-stack authority"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"TabCoordinator","type":"codeVoice"},{"text":" owns shell tab state","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FlowCoordinator","type":"codeVoice"},{"text":" owns local step state inside a destination","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"Use composition rather than trying to collapse all three responsibilities into one type."}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"title":"Coordinators and environment intent","role":"article","roleHeading":"Article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/coordinators-and-environment-intent"]}],"abstract":[{"type":"text","text":"Coordinators in InnoRouter are SwiftUI-adapted reference authorities, not UIKit-era imperative routers."}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Coordinators-and-Environment-Intent","interfaceLanguage":"swift"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","title":"InnoRouterSwiftUI","type":"topic","abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","kind":"article","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"kind":"symbol","abstract":[],"title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting","type":"topic"}}}