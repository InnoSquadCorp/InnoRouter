{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"title":"Case study: shipping a 12-screen onboarding flow","roleHeading":"Article"},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"This is a synthesized case study against the public InnoRouter","type":"text"},{"text":" ","type":"text"},{"text":"surface (v4.0). It does not represent a specific shipped app","type":"text"},{"text":" ","type":"text"},{"text":"but is structured to match the shape of recurring requests","type":"text"},{"text":" ","type":"text"},{"text":"from teams evaluating the framework.","type":"text"}]}],"style":"note"},{"type":"heading","text":"The brief","level":2,"anchor":"The-brief"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The flow:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Launch screen.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Welcome + region picker.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Phone-number entry."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"SMS verification (modal sheet).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Profile photo (skippable)."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Display name."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Permission primer (one screen per permission requested)."}]}]},{"content":[{"inlineContent":[{"text":"Notification opt-in (system prompt, conditional next step).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home location (skippable)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Work location (skippable)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Subscription pitch (modal sheet, conditional)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Welcome-home with feature tour."}]}]}]},{"inlineContent":[{"type":"text","text":"Constraints:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Auth state is owned by an existing ","type":"text"},{"type":"codeVoice","code":"AuthClient"},{"text":". The flow","type":"text"},{"text":" ","type":"text"},{"text":"reads it but doesn’t own it.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Step ordering depends on user input (region → which","type":"text"},{"text":" ","type":"text"},{"text":"permissions to request, region → subscription eligibility).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The user can deep-link in via "},{"type":"codeVoice","code":"inno:\/\/onboarding\/profile"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"resume mid-flow with prior steps already validated."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Analytics fires on every step entry. A push from outside the","type":"text"},{"text":" ","type":"text"},{"text":"flow (e.g. a referral landing) shouldn’t double-fire entry","type":"text"},{"text":" ","type":"text"},{"text":"events.","type":"text"}]}]}],"type":"unorderedList"},{"text":"The composition","anchor":"The-composition","level":2,"type":"heading"},{"syntax":"swift skip doc-fragment","code":["@Routable","enum OnboardingRoute: Route, Codable {","    case launch","    case welcome","    case phoneNumber","    case profilePhoto","    case displayName","    case permissionPrimer(Permission)","    case homeLocation","    case workLocation","    case smsVerification(phoneNumber: String)","    case subscription(plan: SubscriptionPlan)","    case welcomeHome","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"One route type covers both push destinations and modal-only"},{"type":"text","text":" "},{"type":"text","text":"destinations. "},{"type":"codeVoice","code":"FlowStore<OnboardingRoute>"},{"type":"text","text":" exposes "},{"type":"codeVoice","code":"path: [RouteStep<OnboardingRoute>]"},{"type":"text","text":": "},{"type":"codeVoice","code":".push(...)"},{"type":"text","text":" steps drive the"},{"type":"text","text":" "},{"type":"text","text":"navigation stack, while "},{"type":"codeVoice","code":".sheet(...)"},{"type":"text","text":" and "},{"type":"codeVoice","code":".cover(...)"},{"type":"text","text":" steps"},{"type":"text","text":" "},{"type":"text","text":"drive modal presentation. Because the single route type is"},{"type":"text","text":" "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", the entire flow state is serializable to a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["store.send(.presentSheet(.smsVerification(phoneNumber: phoneNumber)))","","let rehydrationPlan: FlowPlan<OnboardingRoute> = .init(steps: [","    .push(.launch),","    .push(.welcome),","    .sheet(.subscription(plan: subscriptionPlan)),","])"],"type":"codeListing"},{"level":2,"anchor":"The-driver","type":"heading","text":"The driver"},{"syntax":"swift skip doc-fragment","code":["@MainActor","final class OnboardingDriver: ChildCoordinator {","    typealias Route = OnboardingRoute","    typealias Result = OnboardingResult","","    let store: FlowStore<OnboardingRoute>","    private let auth: AuthClient","    private let analytics: AnalyticsClient","","    init(auth: AuthClient, analytics: AnalyticsClient) {","        self.auth = auth","        self.analytics = analytics","        self.store = FlowStore(","            configuration: FlowStoreConfiguration(","                navigation: NavigationStoreConfiguration(","                    middlewares: [","                        .init(middleware: AnalyticsMiddleware(analytics: analytics),","                              debugName: \"analytics\"),","                        .init(middleware: EntitlementGate(auth: auth),","                              debugName: \"entitlement\"),","                    ]","                ),","                onPathChanged: { [analytics] _, new in","                    analytics.record(.flowPathChanged(new))","                },","                queueCoalescePolicy: .dropQueued","            )","        )","    }","","    func start() {","        store.send(.replaceStack([.launch, .welcome]))","    }","","    func handleDeepLink(_ url: URL) async {","        guard let plan = OnboardingDeepLink.plan(from: url, auth: auth) else {","            store.send(.push(.welcome))","            return","        }","        _ = store.apply(plan)","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ChildCoordinator"},{"text":" returns an ","type":"text"},{"code":"OnboardingResult","type":"codeVoice"},{"text":" to the parent","type":"text"},{"text":" ","type":"text"},{"text":"when the flow finishes:","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["enum OnboardingResult {","    case completed(profile: Profile)","    case abandoned(at: OnboardingRoute)","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The parent calls","type":"text"},{"text":" ","type":"text"},{"code":"parent.push(child: onboardingDriver) -> Task<OnboardingResult?>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"await","type":"codeVoice"},{"text":"s the inline result, which threads cancellation back","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"code":"parentDidCancel()","type":"codeVoice"},{"text":" if the user pulls down on the","type":"text"},{"text":" ","type":"text"},{"text":"sheet shell.","type":"text"}]},{"level":2,"anchor":"What-the-middlewares-earn","type":"heading","text":"What the middlewares earn"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnalyticsMiddleware"},{"type":"text","text":" records "},{"type":"codeVoice","code":".willExecute"},{"type":"text","text":" and "},{"type":"codeVoice","code":".didExecute"},{"type":"text","text":" "},{"type":"text","text":"events for every navigation command, deduplicated against the"},{"type":"text","text":" "},{"type":"codeVoice","code":"onPathChanged"},{"type":"text","text":" callback. Because middleware fires "},{"type":"strong","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" "},{"type":"text","text":"state mutates, the analytics event always carries the intended"},{"type":"text","text":" "},{"type":"text","text":"target route, not the post-cancellation snapshot."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EntitlementGate"},{"type":"text","text":" reads "},{"type":"codeVoice","code":"auth.isEligible(for: route)"},{"type":"text","text":" for each"},{"type":"text","text":" "},{"type":"text","text":"navigation prefix. If the user is not yet eligible for a"},{"type":"text","text":" "},{"type":"text","text":"branch, navigation middleware cancels the "},{"type":"codeVoice","code":".replaceStack"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":".reset"},{"type":"text","text":" command with a typed reason; the flow falls back to"},{"type":"text","text":" "},{"type":"codeVoice","code":".dropQueued"},{"type":"text","text":" policy, dismissing any speculative modal state"},{"type":"text","text":" "},{"type":"text","text":"that was queued behind the rejected navigation rewrite."},{"type":"text","text":" "},{"type":"codeVoice","code":"onIntentRejected"},{"type":"text","text":" records a structured"},{"type":"text","text":" "},{"type":"codeVoice","code":".middlewareRejected(debugName: \"entitlement\")"},{"type":"text","text":" event so the"},{"type":"text","text":" "},{"type":"text","text":"analytics layer can correlate with the same span ID."}]},{"level":2,"anchor":"What-FlowPlan-earns","type":"heading","text":"What `FlowPlan` earns"},{"type":"paragraph","inlineContent":[{"text":"A deep link ","type":"text"},{"type":"codeVoice","code":"inno:\/\/onboarding\/profile"},{"text":" deserializes into:","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["let plan: FlowPlan<OnboardingRoute> = .init(","    steps: [","        .push(.launch),","        .push(.welcome),","        .push(.phoneNumber),","        .push(.profilePhoto),","    ]",")"],"type":"codeListing"},{"inlineContent":[{"code":"store.apply(plan)","type":"codeVoice"},{"type":"text","text":" is atomic: every step previews against"},{"type":"text","text":" "},{"type":"text","text":"middleware in order, and the entire plan rolls back if any"},{"type":"text","text":" "},{"type":"text","text":"preview rejects. The user never sees a half-applied flow even"},{"type":"text","text":" "},{"type":"text","text":"if the entitlement gate decides one of the intermediate steps"},{"type":"text","text":" "},{"type":"text","text":"is currently unreachable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Because "},{"type":"codeVoice","code":"OnboardingRoute"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", the same "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"be persisted to "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" on "},{"type":"codeVoice","code":"scenePhase: .background"},{"type":"text","text":" "},{"type":"text","text":"and restored on the next cold launch via"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan(validating:)"},{"type":"text","text":" — the validating constructor rejects"},{"type":"text","text":" "},{"type":"text","text":"invariant violations (e.g. two modal steps) before the"},{"type":"text","text":" "},{"type":"text","text":"authority sees them."}],"type":"paragraph"},{"text":"What `InnoRouterTesting` earns","anchor":"What-InnoRouterTesting-earns","level":2,"type":"heading"},{"syntax":"swift skip doc-fragment","code":["@Test","func onboardingResumesFromProfile() async throws {","    let auth = AuthClient.signedIn(region: .us)","    let analytics = RecordingAnalytics()","    let test = FlowTestStore<OnboardingRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: EntitlementGate(auth: auth)),","            ])","        )","    )","","    test.send(.push(.launch))","    test.expect(navigation: [.launch])","    try await test.apply(","        FlowPlan(steps: [","            .push(.launch),","            .push(.welcome),","            .push(.phoneNumber),","            .push(.profilePhoto),","        ])","    )","    test.expect(navigation: [.launch, .welcome, .phoneNumber, .profilePhoto])","    test.expect(modal: nil)","}"],"type":"codeListing"},{"inlineContent":[{"text":"No SwiftUI host in scope. The exact same store configuration —","type":"text"},{"text":" ","type":"text"},{"text":"including production analytics middleware — is exercised in","type":"text"},{"text":" ","type":"text"},{"text":"the test and in production. ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"text":" reuses the","type":"text"},{"text":" ","type":"text"},{"code":"FlowStoreConfiguration","type":"codeVoice"},{"text":" callbacks, so the test can also verify","type":"text"},{"text":" ","type":"text"},{"text":"that ","type":"text"},{"code":"analytics.record(.flowPathChanged(...))","type":"codeVoice"},{"text":" fired exactly","type":"text"},{"text":" ","type":"text"},{"text":"once per applied step.","type":"text"}],"type":"paragraph"},{"text":"Observed wins","anchor":"Observed-wins","level":2,"type":"heading"},{"inlineContent":[{"text":"In a comparable TCA-modeled flow before the swap, the same","type":"text"},{"text":" ","type":"text"},{"text":"feature carried:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"~340 lines of "},{"type":"codeVoice","code":"Reducer"},{"type":"text","text":" boilerplate for navigation actions"},{"type":"text","text":" "},{"type":"text","text":"alone (push \/ pop \/ present \/ dismiss \/ forward \/ hydrate)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Three custom test harnesses to assert state restoration,"},{"type":"text","text":" "},{"type":"text","text":"deep-link replay, and entitlement gating in isolation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A bespoke “is the queue stale?” check after every cancelled","type":"text"},{"text":" ","type":"text"},{"text":"command because TCA’s ","type":"text"},{"code":"@Presents","type":"codeVoice"},{"text":" carry-over isn’t governed","type":"text"},{"text":" ","type":"text"},{"text":"by a policy at the framework level.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The InnoRouter version drops the navigation reducer","type":"text"},{"text":" ","type":"text"},{"text":"boilerplate entirely (the framework owns the state machine),","type":"text"},{"text":" ","type":"text"},{"text":"folds the three test harnesses into one ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"text":" ","type":"text"},{"text":"suite, and pushes the queue-coalesce decision into a single","type":"text"},{"text":" ","type":"text"},{"code":"FlowStoreConfiguration","type":"codeVoice"},{"text":" setting that participates in the","type":"text"},{"text":" ","type":"text"},{"text":"analytics middleware’s span ID without extra wiring.","type":"text"}],"type":"paragraph"},{"text":"When this composition is overkill","anchor":"When-this-composition-is-overkill","level":2,"type":"heading"},{"inlineContent":[{"text":"For a single-screen flow with no entitlement gating and no deep","type":"text"},{"text":" ","type":"text"},{"text":"link, drop straight to ","type":"text"},{"code":"NavigationStore<R>","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" earns its surface specifically when:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Multiple steps need atomic deep-link rehydration."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The modal authority is genuinely concurrent with the","type":"text"},{"text":" ","type":"text"},{"text":"navigation stack (sheets, covers).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A coordinator-level result ("},{"type":"codeVoice","code":"OnboardingResult"},{"type":"text","text":") needs to"},{"type":"text","text":" "},{"type":"text","text":"bubble back to the parent."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Middleware needs to gate or telemeter the entire flow."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/CaseStudy-OnboardingFlow","interfaceLanguage":"swift"},"variants":[{"paths":["\/documentation\/innorouterswiftui\/casestudy-onboardingflow"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"kind":"article","abstract":[{"type":"text","text":"A representative composition of "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":", and "},{"type":"codeVoice","code":"NavigationMiddleware"},{"type":"text","text":" for a 12-screen"},{"type":"text","text":" "},{"type":"text","text":"onboarding sequence with conditional branches, deep-link"},{"type":"text","text":" "},{"type":"text","text":"resumption, and entitlement gating."}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","title":"InnoRouterSwiftUI","type":"topic","abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","kind":"article","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"kind":"symbol","abstract":[],"title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting","type":"topic"}}}