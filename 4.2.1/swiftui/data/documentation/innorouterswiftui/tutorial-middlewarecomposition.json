{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"metadata":{"role":"article","title":"Composing Middleware Across Navigation and Modal","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article"},"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that guarantees "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" only runs for middlewares"},{"text":" ","type":"text"},{"text":"that accepted the command.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"anchor":"Scenario","type":"heading","text":"Scenario","level":2},{"type":"paragraph","inlineContent":[{"text":"Every ","type":"text"},{"code":"NavigationCommand","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ModalCommand","type":"codeVoice"},{"text":" should be logged","type":"text"},{"text":" ","type":"text"},{"text":"before it executes. A feature-flagged screen must be gated behind","type":"text"},{"text":" ","type":"text"},{"text":"an entitlement check. An analytics call must fire after the","type":"text"},{"text":" ","type":"text"},{"text":"command commits — but only for middlewares that actually","type":"text"},{"text":" ","type":"text"},{"text":"participated in the ","type":"text"},{"type":"codeVoice","code":"willExecute"},{"text":" decision.","type":"text"}]},{"anchor":"Modeling-routes","type":"heading","text":"Modeling routes","level":2},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["enum AppRoute: Route {","    case home","    case premiumDetail","    case paywall","}"]},{"anchor":"Logging-middleware","type":"heading","text":"Logging middleware","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reuse the "},{"type":"codeVoice","code":"AnyNavigationMiddleware"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"AnyModalMiddleware"},{"type":"text","text":" "},{"type":"text","text":"closure initializers so a minimal shared logger composes without"},{"type":"text","text":" "},{"type":"text","text":"boilerplate:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@MainActor","func loggingNavigationMiddleware() -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(","        willExecute: { command, _ in","            Log.debug(\"navigation command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, _, result in","            Log.debug(\"navigation committed: \\(command) -> \\(result)\")","            return result","        }","    )","}","","@MainActor","func loggingModalMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(","        willExecute: { command, _, _ in","            Log.debug(\"modal command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, _, _ in","            Log.debug(\"modal committed: \\(command)\")","        }","    )","}"]},{"anchor":"Entitlement-gating","type":"heading","text":"Entitlement gating","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The gate is itself a middleware; denying a command is just"},{"type":"text","text":" "},{"type":"text","text":"returning "},{"type":"codeVoice","code":".cancel(reason)"},{"type":"text","text":":"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@MainActor","func entitlementGateNavigation(hasPremium: @escaping @MainActor () -> Bool) -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(willExecute: { command, _ in","        guard case .push(.premiumDetail) = command, !hasPremium() else {","            return .proceed(command)","        }","        return .cancel(.middleware(debugName: \"entitlement-gate\", command: command))","    })","}"]},{"type":"paragraph","inlineContent":[{"text":"The cancellation surfaces through","type":"text"},{"text":" ","type":"text"},{"code":"onCommandIntercepted(.cancelled(...))","type":"codeVoice"},{"text":" on the store and through","type":"text"},{"text":" ","type":"text"},{"code":"FlowRejectionReason.middlewareRejected(debugName: \"entitlement-gate\")","type":"codeVoice"},{"text":" ","type":"text"},{"text":"when used from ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"text":"Wiring it all","anchor":"Wiring-it-all","type":"heading"},{"code":["let navStore = NavigationStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingNavigationMiddleware(), debugName: \"logging\"),","            .init(middleware: entitlementGateNavigation(hasPremium: { EntitlementStore.shared.hasPremium }), debugName: \"entitlement-gate\"),","        ]","    )",")","","let modalStore = ModalStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingModalMiddleware(), debugName: \"logging\"),","        ]","    )",")"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"text":"Participant discipline","anchor":"Participant-discipline","type":"heading"},{"inlineContent":[{"type":"text","text":"When a middleware cancels a command, only the middlewares that"},{"type":"text","text":" "},{"type":"text","text":"already returned "},{"type":"codeVoice","code":".proceed"},{"type":"text","text":" observe "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":". The ones that"},{"type":"text","text":" "},{"type":"text","text":"either didn’t run yet (because a predecessor cancelled) or that"},{"type":"text","text":" "},{"type":"text","text":"themselves cancelled are not consulted."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That guarantee is why the logger safely appears "},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"entitlement gate — the logger’s "},{"code":"didExecute","type":"codeVoice"},{"type":"text","text":" fires even if the"},{"type":"text","text":" "},{"type":"text","text":"gate cancels, so the cancellation is still recorded. Reordering"},{"type":"text","text":" "},{"type":"text","text":"to "},{"code":"[entitlement-gate, logging]","type":"codeVoice"},{"type":"text","text":" would skip the logger’s"},{"type":"text","text":" "},{"code":"didExecute","type":"codeVoice"},{"type":"text","text":" on cancellation."}],"type":"paragraph"},{"text":"Observing a cancellation end-to-end","level":2,"anchor":"Observing-a-cancellation-end-to-end","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"ModalStore.events"},{"type":"text","text":" surfaces "},{"type":"codeVoice","code":".commandIntercepted(.cancelled(...))"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"NavigationStore.events"},{"type":"text","text":" surfaces the same through"},{"type":"text","text":" "},{"type":"codeVoice","code":".pathMismatch"},{"type":"text","text":" (if the rewrite triggered a policy) plus the"},{"type":"text","text":" "},{"type":"text","text":"direct cancellation. For a "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" in particular,"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore.events"},{"type":"text","text":" wraps both in "},{"type":"codeVoice","code":".navigation(...)"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".modal(...)"},{"type":"text","text":" "},{"type":"text","text":"cases so one subscriber sees the whole picture."}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["Task {","    for await event in flowStore.events {","        if case .modal(.commandIntercepted(_, .cancelled(let reason))) = event {","            Log.info(\"modal cancelled: \\(reason)\")","        }","        if case .intentRejected(_, .middlewareRejected(let name)) = event {","            Log.info(\"flow intent rejected by: \\(name ?? \"nil\")\")","        }","    }","}"]},{"text":"Testing middleware with FlowTestStore","level":2,"anchor":"Testing-middleware-with-FlowTestStore","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":") asserts the cancellation"},{"type":"text","text":" "},{"type":"text","text":"chain without mounting SwiftUI:"}],"type":"paragraph"},{"type":"codeListing","code":["@Test","@MainActor","func entitlementGateBlocksPremiumPush() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: entitlementGateNavigation(hasPremium: { false }), debugName: \"gate\")","            ])","        )","    )","","    store.send(.push(.premiumDetail))","","    store.receiveIntentRejected(","        intent: .push(.premiumDetail),","        reason: .middlewareRejected(debugName: \"gate\")","    )","    store.expectNoMoreEvents()","}"],"syntax":"swift skip doc-fragment"},{"type":"heading","text":"Next steps","level":2,"anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","isActive":true,"type":"reference"},{"text":" to see how middleware","type":"text"},{"text":" ","type":"text"},{"text":"interacts with a multi-step flow plus a child coordinator.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Read the "},{"code":"Tutorial-TestingFlows","type":"codeVoice"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"code":"InnoRouterTesting","type":"codeVoice"},{"type":"text","text":" documentation catalog for the full host-less"},{"type":"text","text":" "},{"type":"text","text":"test harness tour."}],"type":"paragraph"}]}]}],"kind":"content"}],"sections":[],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","title":"InnoRouterSwiftUI","type":"topic","abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","kind":"article","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"type":"topic","abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then scope the signup sub-flow through a "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" and await its result inline."}],"title":"Building a Login Onboarding Flow","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","role":"article","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"kind":"symbol","abstract":[],"title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting","type":"topic"}}}