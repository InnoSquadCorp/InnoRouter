{"metadata":{"title":"Observing Stores via Protocol Adapters","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-StoreObserver","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-storeobserver"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"code":"StoreObserver","type":"codeVoice"},{"text":" is a thin protocol adapter over the ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" that every InnoRouter store publishes. Use it when","type":"text"},{"text":" ","type":"text"},{"text":"protocol dispatch reads clearer than a ","type":"text"},{"code":"for await","type":"codeVoice"},{"text":" loop — typically","type":"text"},{"text":" ","type":"text"},{"text":"in AppDelegate wiring, analytics adapters, or anywhere you want","type":"text"},{"text":" ","type":"text"},{"text":"static methods instead of iterator plumbing.","type":"text"}],"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Scenario","type":"heading","text":"Scenario"},{"inlineContent":[{"text":"An analytics adapter wants to react to every navigation change,","type":"text"},{"text":" ","type":"text"},{"text":"modal present, and flow path rewrite. Writing three ","type":"text"},{"type":"codeVoice","code":"for await"},{"text":" ","type":"text"},{"text":"loops, one per store, reads noisy. ","type":"text"},{"type":"codeVoice","code":"StoreObserver"},{"text":" lets the adapter","type":"text"},{"text":" ","type":"text"},{"text":"implement three typed ","type":"text"},{"type":"codeVoice","code":"handle(_:)"},{"type":"text","text":" methods and subscribe once per"},{"type":"text","text":" "},{"type":"text","text":"store."}],"type":"paragraph"},{"level":2,"anchor":"Implementation","type":"heading","text":"Implementation"},{"code":["@MainActor","final class AnalyticsObserver: StoreObserver {","    typealias RouteType = AppRoute","","    func handle(_ event: NavigationEvent<AppRoute>) {","        if case .changed(_, let to) = event {","            Analytics.track(\"nav_change\", [\"path\": to.path.description])","        }","    }","","    func handle(_ event: ModalEvent<AppRoute>) {","        if case .presented(let presentation) = event {","            Analytics.track(\"modal_open\", [\"route\": \"\\(presentation.route)\"])","        }","    }","","    func handle(_ event: FlowEvent<AppRoute>) {","        if case .intentRejected(_, let reason) = event {","            Analytics.track(\"flow_rejected\", [\"reason\": \"\\(reason)\"])","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"Any subset of the three "},{"type":"codeVoice","code":"handle(_:)"},{"type":"text","text":" methods is fine — the others"},{"type":"text","text":" "},{"type":"text","text":"default to no-ops via a protocol extension."}],"type":"paragraph"},{"level":2,"anchor":"Attaching","type":"heading","text":"Attaching"},{"code":["let observer = AnalyticsObserver()","let navSubscription = navigationStore.observe(observer)","let modalSubscription = modalStore.observe(observer)","let flowSubscription = flowStore.observe(observer)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"observe(_:)"},{"type":"text","text":" returns a "},{"type":"codeVoice","code":"StoreObserverSubscription"},{"type":"text","text":". Keep it"},{"type":"text","text":" "},{"type":"text","text":"around for the observer’s lifetime; when the"},{"type":"text","text":" "},{"type":"codeVoice","code":"StoreObserverSubscription"},{"type":"text","text":" itself is deinitialized it auto-cancels"},{"type":"text","text":" "},{"type":"text","text":"via "},{"type":"codeVoice","code":"isolated deinit"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To stop observing early:"}],"type":"paragraph"},{"code":["navSubscription.cancel()"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"Subsequent store events are not delivered to the observer.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"FlowStore-routing","type":"heading","text":"FlowStore routing"},{"inlineContent":[{"code":"FlowStore.observe(_:)","type":"codeVoice"},{"type":"text","text":" is special: it iterates the flow’s"},{"type":"text","text":" "},{"code":"events","type":"codeVoice"},{"type":"text","text":" stream (which already wraps inner navigation \/ modal"},{"type":"text","text":" "},{"type":"text","text":"emissions) and routes them through the observer’s matching typed"},{"type":"text","text":" "},{"code":"handle(_:)","type":"codeVoice"},{"type":"text","text":" overload. One subscription covers all three authorities"},{"type":"text","text":" "},{"type":"text","text":"on a flow surface."}],"type":"paragraph"},{"code":["let flowSubscription = flowStore.observe(observer)","\/\/ observer.handle(.navigation(.changed(…))) → observer.handle(_:NavigationEvent)","\/\/ observer.handle(.modal(.presented(…)))    → observer.handle(_:ModalEvent)","\/\/ observer.handle(.pathChanged(…))          → observer.handle(_:FlowEvent)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"level":2,"anchor":"When-to-reach-for-for-await-instead","type":"heading","text":"When to reach for `for await` instead"},{"inlineContent":[{"type":"text","text":"Use the raw "},{"code":"events","type":"codeVoice"},{"type":"text","text":" stream when:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"cancellation flow needs to compose with other async sequences"},{"type":"text","text":" "},{"type":"text","text":"(combine, merge, retry, …)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the handler body wants to ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" inside an event (e.g. log to","type":"text"},{"text":" ","type":"text"},{"text":"a remote service and gate subsequent events on the response)","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"events feed a structured concurrency pipeline with explicit task"},{"type":"text","text":" "},{"type":"text","text":"lifetimes"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"StoreObserver"},{"type":"text","text":" when:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the adapter is a long-lived object (analytics, crash reporting)"},{"type":"text","text":" "},{"type":"text","text":"and protocol methods read clearer than an iterator loop"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"multiple stores feed the same observer with typed dispatch"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Multiple-observers","type":"heading","text":"Multiple observers"},{"inlineContent":[{"type":"text","text":"Every "},{"type":"codeVoice","code":"observe(_:)"},{"type":"text","text":" call creates an independent subscription, so"},{"type":"text","text":" "},{"type":"text","text":"multiple observers on the same store all receive the same events."},{"type":"text","text":" "},{"type":"text","text":"Fan-out is free — the underlying "},{"type":"codeVoice","code":"events"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":" multicasts"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"codeVoice","code":"EventBroadcaster"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Next-steps","type":"heading","text":"Next steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling","isActive":true},{"type":"text","text":" for one more use case — observing"},{"type":"text","text":" "},{"type":"text","text":"throttle cancellations through the same protocol dispatch."}]}]},{"content":[{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","isActive":true,"type":"reference"},{"text":" for pre-execution hooks","type":"text"},{"text":" ","type":"text"},{"text":"that complement post-execution observation.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","title":"InnoRouterSwiftUI","type":"topic","abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","kind":"article","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MiddlewareComposition":{"type":"topic","kind":"article","url":"\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","title":"Composing Middleware Across Navigation and Modal","abstract":[{"text":"Install logging, entitlement gating, and analytics middleware on","type":"text"},{"text":" ","type":"text"},{"text":"both ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":". Inspect the participant","type":"text"},{"text":" ","type":"text"},{"text":"discipline that guarantees ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" only runs for middlewares","type":"text"},{"text":" ","type":"text"},{"text":"that accepted the command.","type":"text"}],"role":"article"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-Throttling":{"role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-throttling","kind":"article","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling","title":"Throttling Rapid Navigation Taps","abstract":[{"text":"Rate-limit navigation commands without threading timestamps through","type":"text"},{"text":" ","type":"text"},{"text":"every call site. ","type":"text"},{"code":"ThrottleNavigationMiddleware","type":"codeVoice"},{"text":" cancels commands that","type":"text"},{"text":" ","type":"text"},{"text":"arrive within a minimum interval of a previously accepted command","type":"text"},{"text":" ","type":"text"},{"text":"sharing the same key.","type":"text"}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"kind":"symbol","abstract":[],"title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting","type":"topic"}}}