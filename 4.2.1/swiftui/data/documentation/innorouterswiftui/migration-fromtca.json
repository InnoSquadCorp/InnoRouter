"type":"text"},{"code":"NavigationIntent","type":"codeVoice"},{"text":" enum that flows through the","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI environment. The reducer surface shrinks because the","type":"text"},{"text":" ","type":"text"},{"text":"parent reducer no longer needs to forward navigation actions","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"code":"StackState","type":"codeVoice"},{"text":" mutations.","type":"text"}],"type":"paragraph"},{"anchor":"The-minimal-swap","type":"heading","level":2,"text":"The minimal swap"},{"inlineContent":[{"type":"text","text":"A canonical TCA navigation feature looks like this:"}],"type":"paragraph"},{"code":["@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable {","        var path = StackState<Path.State>()","    }","","    enum Action {","        case path(StackActionOf<Path>)","    }","","    @Reducer","    struct Path {","        enum State: Equatable { case detail(DetailFeature.State) }","        enum Action { case detail(DetailFeature.Action) }","        var body: some ReducerOf<Self> {","            Scope(state: \\.detail, action: \\.detail) { DetailFeature() }","        }","    }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","            .forEach(\\.path, action: \\.path) { Path() }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        NavigationStackStore(store.scope(state: \\.path, action: \\.path)) {","            RootView(store: store)","        } destination: { store in","            switch store.state {","            case .detail:","                if let detail = store.scope(state: \\.detail, action: \\.detail) {","                    DetailView(store: detail)","                }","            }","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"After migration:","type":"text"}],"type":"paragraph"},{"code":["@Routable","enum AppRoute: Route {","    case detail(DetailFeature.State.ID)","}","","@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable { \/* business state only *\/ }","","    enum Action { \/* business actions only *\/ }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","    @State private var navigationStore = NavigationStore<AppRoute>()","","    var body: some View {","        NavigationHost(store: navigationStore) {","            RootView(store: store)","        } destination: { route in","            switch route {","            case .detail(let id):","                DetailView(\/* hydrate from id *\/)","            }","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"Three things changed:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The reducer’s "},{"code":"path: StackState<Path.State>","type":"codeVoice"},{"type":"text","text":" is gone — the"},{"type":"text","text":" "},{"type":"text","text":"parent reducer no longer carries navigation state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The parent action enum no longer routes","type":"text"},{"text":" ","type":"text"},{"code":"case path(StackActionOf<Path>)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"The view uses "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" + "},{"type":"codeVoice","code":"NavigationStore<AppRoute>"},{"type":"text","text":" "},{"type":"text","text":"in place of "},{"type":"codeVoice","code":"NavigationStackStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"Path"},{"type":"text","text":" reducer"},{"type":"text","text":" "},{"type":"text","text":"composition."}],"type":"paragraph"}]}]},{"anchor":"Modal-presentation-Presents-%E2%86%92-ModalStore","type":"heading","level":2,"text":"Modal presentation (`@Presents` → `ModalStore`)"},{"inlineContent":[{"text":"TCA’s ","type":"text"},{"type":"codeVoice","code":"@Presents"},{"text":" is conceptually equivalent to a ","type":"text"},{"type":"codeVoice","code":"ModalStore"},{"text":" ","type":"text"},{"text":"slot. Replace:","type":"text"}],"type":"paragraph"},{"code":["@ObservableState","struct State {","    @Presents var sheet: SheetFeature.State?","}","","enum Action {","    case sheet(PresentationAction<SheetFeature.Action>)","}","","\/\/ View",".sheet(item: $store.scope(state: \\.sheet, action: \\.sheet)) { … }"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"with:","type":"text"}],"type":"paragraph"},{"code":["\/\/ State + Action no longer carry the modal slot.","","\/\/ View","ModalHost(store: modalStore) { route in","    switch route { case .sheet: SheetView(…) }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"The reducer no longer fires "},{"type":"codeVoice","code":"Action.sheet(.presented(…))"},{"type":"text","text":"; the"},{"type":"text","text":" "},{"type":"text","text":"view dispatches "},{"type":"codeVoice","code":"flowStore.send(.presentSheet(.sheet))"},{"type":"text","text":" directly"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"codeVoice","code":"@EnvironmentFlowIntent"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Stack-+-modal-as-one-value-StackState-+-Presents-%E2%86%92-FlowStore","type":"heading","level":2,"text":"Stack + modal as one value (`StackState` + `@Presents` → `FlowStore`)"},{"inlineContent":[{"text":"If a feature uses both navigation and modal authority, replace","type":"text"},{"text":" ","type":"text"},{"text":"both with a single ","ty