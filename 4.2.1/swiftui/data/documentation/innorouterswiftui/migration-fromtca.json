es ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" replace:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Business logic reducers (","type":"text"},{"code":"Reduce { state, action in … }","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Side effects ("},{"type":"codeVoice","code":"Effect.send"},{"type":"text","text":", "},{"type":"codeVoice","code":"Effect.run"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dependency injection ("},{"type":"codeVoice","code":"@Dependency"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross-feature coordination (parent ⇄ child reducer composition"},{"type":"text","text":" "},{"type":"text","text":"for non-navigation concerns)"}]}]}]},{"inlineContent":[{"type":"text","text":"A typical migrated codebase keeps every reducer in place; the"},{"type":"text","text":" "},{"type":"text","text":"delta is the state slots and actions removed because navigation"},{"type":"text","text":" "},{"type":"text","text":"no longer needs reducer-level modeling."}],"type":"paragraph"},{"anchor":"Migration-sequence","type":"heading","level":2,"text":"Migration sequence"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Start with a leaf feature whose navigation state lives only","type":"text"},{"text":" ","type":"text"},{"text":"in the parent reducer’s ","type":"text"},{"type":"codeVoice","code":"StackState"},{"text":". Replace its view-layer","type":"text"},{"text":" ","type":"text"},{"text":"wiring with ","type":"text"},{"type":"codeVoice","code":"NavigationHost"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"NavigationStore"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineC