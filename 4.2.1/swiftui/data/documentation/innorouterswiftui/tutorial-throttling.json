{"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Scenario","anchor":"Scenario","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Users double-tap a “Buy” button. The first tap pushes the purchase","type":"text"},{"text":" ","type":"text"},{"text":"screen; the second should be silently dropped. Rolling that logic","type":"text"},{"text":" ","type":"text"},{"text":"into every button is noise — middleware is the right layer.","type":"text"}]},{"text":"Installation","anchor":"Installation","type":"heading","level":2},{"type":"codeListing","code":["let store = NavigationStore<AppRoute>(","    configuration: NavigationStoreConfiguration(","        middlewares: [","            .init(","                middleware: AnyNavigationMiddleware(","                    ThrottleNavigationMiddleware<AppRoute>(","                        interval: .milliseconds(300)","                    )","                ),","                debugName: \"throttle\"","            )","        ]","    )",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default initializer uses "},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":" and groups all"},{"type":"text","text":" "},{"type":"text","text":"commands under a single global window. Within 300 ms of a previous"},{"type":"text","text":" "},{"type":"text","text":"successfully executed command, the next one is cancelled. If the"},{"type":"text","text":" "},{"type":"text","text":"middleware is registered with "},{"type":"codeVoice","code":"debugName: \"throttle\""},{"type":"text","text":", the surfaced"},{"type":"text","text":" "},{"type":"text","text":"reason becomes "},{"type":"codeVoice","code":".cancelled(.middleware(debugName: \"throttle\", command: …))"},{"type":"text","t