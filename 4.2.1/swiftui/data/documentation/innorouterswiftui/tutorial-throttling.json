"type":"text"},{"text":" ","type":"text"},{"code":".whenCancelled(primary, fallback:)","type":"codeVoice"},{"text":" treats a throttled command the","type":"text"},{"text":" ","type":"text"},{"text":"same as any other cancelled command:","type":"text"}]},{"type":"codeListing","code":["store.execute(","    .whenCancelled(","        .push(.detail),","        fallback: .push(.home)","    )",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"If the throttle middleware cancels the ","type":"text"},{"code":".push(.detail)","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"fallback ","type":"text"},{"code":".push(.home)","type":"codeVoice"},{"text":" is attempted next. ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" ","type":"text"},{"text":"routes that fallback back through the full middleware chain, so a","type":"text"},{"text":" ","type":"text"},{"text":"global throttle key can cancel the fallback too if it still lands","type":"text"},{"text":" ","type":"text"},{"text":"inside the same throttle window.","type":"text"}]},{"text":"Debounce?","anchor":"Debounce","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Debounce semantics — “wait N ms, then fire the latest” — live in"},{"type":"text","text":" "},{"code":"DebouncingNavigator","type":"codeVoice"},{"type":"text","text":", not in "},{"code":"NavigationCommand","type":"codeVoice"},{"type":"text","text":". That keeps the"},{"type":"text","text":" "},{"type":"text","text":"engine synchronous while the async wrapper owns the timer,"},{"type":"text","text":" "},{"type":"text","text":"cancellation, and "},{"code":"Clock","type":"codeVoice"},{"type":"text","text":" injection needed for deterministic tests."},{"type":"text","text":" "},{"type":"text","text":"Use throttle middleware for synchronous “reject too soon” behavior"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"De