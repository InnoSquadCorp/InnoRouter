type":"text","text":" "},{"type":"text","text":"continuation plumbing to surface the sheet result back to the"},{"type":"text","text":" "},{"type":"text","text":"parent. "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" collapse this to a single"},{"type":"text","text":" "},{"type":"text","text":"store and one "},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}]},{"text":"Routes","type":"heading","anchor":"Routes","level":2},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["enum AppRoute: Route {","    case welcome","    case preAuth","    case signup","    case home(UserID)","}"]},{"text":"Wiring the flow host","type":"heading","anchor":"Wiring-the-flow-host","level":2},{"type":"paragraph","inlineContent":[{"code":"FlowHost","type":"codeVoice"},{"text":" composes an inner ","type":"text"},{"code":"ModalHost","type":"codeVoice"},{"text":" over a ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"exposes both authorities through a single ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@main","struct DemoApp: App {","    @State private var flow = FlowStore<AppRoute>(initial: [.push(.welcome)])","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: flow,","                destination: destination,","                root: { WelcomeRootView() }","            )","        }","    }","","    @ViewBuilder","    private func destination(_ route: AppRoute) -> some View {","        switch route {","        case .welcome:","            WelcomeRootView()","        case .preAuth:","            PreAuthDetailView()","        case .signup:","            SignUpView()","        case .home(let id):","            HomeView(userID: id)","        }","    }","}"]},{"text":"Emitting intents from views","type":"heading","anchor":"Emitting-intents-from-views","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views never mutate "},{"code":"FlowStore.path","type":"codeVoice"},{"type":"text","text":" directly; they emit"},{"type":"text","text":" "},{"code":"FlowIntent","type":"codeVoice"},{"type":"text","text":" values through the environment dispatcher so"},{"type":"text","text":" "},{"type":"text","text":"middleware and telemetry observe every step:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["struct WelcomeRootView: View {","    @EnvironmentFlowIntent<AppRoute> private var flow","","    var body: some View {","        VStack {","            Button(\"Continue\") {","                flow.send(.push(.preAuth))","            }","            Button(\"Create account\") {","                flow.send(.presentSheet(.signup))","            }","        }","    }","}"]},{"text":"Awaiting a signup sub-flow","type":"heading","anchor":"Awaiting-a-signup-sub-flow","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The signup sheet opens its own "},{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" that owns the step"},{"type":"text","text":" "},{"type":"text","text":"progression (email → password → confirmation). The outer"},{"type":"text","text":" "},{"type":"text","text":"onboarding coordinator launches it via "},{"type":"codeVoice","code":"push(child:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"await"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"the final "},{"type":"codeVoice","code":"UserID"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@MainActor","final class SignUpCoordinator: ChildCoordinator {","    typealias Result = UserID","    typealias RouteType = AppRoute","","    \/\/ ...step state + methods omitted","","    func userDidCreateAccount(_ userID: UserID) {","        onFinish(userID)   \/\/ emits the result back to the parent","    }","","    func userCancelled() {","        onCancel()          \/\/ parent sees nil","    }","}","","@MainActor","final class OnboardingCoordinator: Coordinator {","    typealias RouteType = AppRoute","    let navigationStore: NavigationStore<AppRoute>","","    func startSignUpFlow() async {","        let result = await push(child: SignUpCoordinator())","        if let userID = result {","            navigationStore.send(.go(.home(userID)))","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"push(child:)","type":"codeVoice"},{"text":" installs the child’s ","type":"text"},{"code":"onFinish","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onCancel","type":"codeVoice"},{"text":" ","type":"text"},{"text":"callbacks synchronously, so the child can emit a result at any","type":"text"},{"text":" ","type":"text"},{"text":"point — even before the parent’s ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" suspends — without a","type":"text"},{"text":" ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" re-entrancy deadlock. See","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"..\/..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md"},{"text":" ","type":"text"},{"text":"for the design rationale.","type":"text"}]},{"text":"Verifying the flow host-lessly","type":"heading","anchor":"Verifying-the-flow-host-lessly","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":") exercises the full chain"},{"type":"text","text":" "},{"type":"text","text":"in a unit test without mounting any SwiftUI host:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func signUpCompletesOnboarding() {","    let store