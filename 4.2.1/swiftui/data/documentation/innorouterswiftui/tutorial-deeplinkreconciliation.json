{"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"metadata":{"role":"article","title":"Reconciling Deep Links End-to-End","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article"},"kind":"article","abstract":[{"text":"Match a URL, apply an authentication policy, and produce a","type":"text"},{"text":" ","type":"text"},{"code":"NavigationPlan","type":"codeVoice"},{"text":" that ","type":"text"},{"code":"NavigationStore.executeBatch","type":"codeVoice"},{"text":" applies in one","type":"text"},{"text":" ","type":"text"},{"text":"observable step. Queue the deep link while the user is signed out,","type":"text"},{"text":" ","type":"text"},{"text":"replay it after sign-in, and surface cancellation reasons through","type":"text"},{"text":" ","type":"text"},{"text":"typed outcomes.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation"},"primaryContentSections":[{"content":[{"text":"Scenario","type":"heading","anchor":"Scenario","level":2},{"type":"paragraph","inlineContent":[{"code":"myapp:\/\/order\/42","type":"codeVoice"},{"text":" should land the user on the order detail for","type":"text"},{"text":" ","type":"text"},{"text":"order 42, but only when they’re signed in. If the link arrives","type":"text"},{"text":" ","type":"text"},{"text":"while signed out, the app must remember it, route through the","type":"text"},{"text":" ","type":"text"},{"text":"sign-in flow, and then replay it — without dropping the original","type":"text"},{"text":" ","type":"text"},{"text":"URL context.","type":"text"}]},{"text":"Modeling the routes","type":"heading","anchor":"Modeling-the-routes","level":2},{"type":"codeListing","code":["enum AppRoute: Route {","    case home","    case signIn","    case order(id: String)","}"],"syntax":"swift skip doc-fragment"},{"text":"Wiring the pipeline","type":"heading","anchor":"Wiring-the-pipeline","level":2},{"type":"paragraph","inlineContent":[{"code":"DeepLinkPipeline","type":"codeVoice"},{"text":" owns the match-then-validate-then-authorize flow:","type":"text"}]},{"type":"codeListing","code":["let matcher = DeepLinkMatcher<AppRoute>(patterns: [","    .init(pattern: \"myapp:\/\/home\")                   { _ in .home },","    .init(pattern: \"myapp:\/\/signin\")                 { _ in .signIn },","    .init(pattern: \"myapp:\/\/order\/:id\")              { params in","        guard let id = params[\"id\"] else { return nil }","        return .order(id: id)","    },","])","","let policy: DeepLinkAuthenticationPolicy<AppRoute> = { route, isAuthenticated in","    switch route {","    case .home, .signIn:","        return .proceed","    case .order where !isAuthenticated:","        return .defer \/\/ the pipeline will queue a PendingDeepLink","    case .order:","        return .proceed","    }","}","","let pipeline = DeepLinkPipeline(matcher: matcher, policy: policy)"],"syntax":"swift skip doc-fragment"},{"text":"Handling a URL","type":"heading","anchor":"Handling-a-URL","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"DeepLinkEffectHandler"},{"text":" bridges the pipeline output into","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationStore"},{"text":":","type":"text"}]},{"type":"codeListing","code":["@MainActor","final class AppCoordinator {","    let store: NavigationStore<AppRoute>","    let pipeline: DeepLinkPipeline<AppRoute>","    let effectHandler: DeepLinkEffectHandler<AppRoute>","","    func handle(_ url: URL, isAuthenticated: Bool) {","        let outcome = pipeline.process(url: url, isAuthenticated: isAuthenticated)","","        switch outcome {","        case .plan(let plan):","            _ = store.executeBatch(plan.commands)","        case .pending(let pending):","            effectHandler.retain(pending)","            store.send(.go(.signIn))","        case .rejected(let reason):","            Log.warning(\"deep link rejected: \\(reason)\")","        case .unhandled(let url):","            Log.warning(\"deep link unhandled: \\(url)\")","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"text":"Replaying after sign-in","type":"heading","anchor":"Replaying-after-sign-in","level":2},{"inlineContent":[{"text":"Once the user signs in, the handler resumes any queued deep link:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["func userDidSignIn() {","    effectHandler.resumePendingDeepLinkIfAllowed(","        isAuthenticated: true,","        executor: { plan in","            _ = store.executeBatch(plan.commands)","        }","    )","}"],"type":"codeListing"},{"inlineContent":[{"text":"The handler consults the retained ","type":"text"},{"code":"PendingDeepLink","type":"codeVoice"},{"text":", re-evaluates","type":"text"},{"text":" ","type":"text"},{"text":"the authentication policy, and only commits the batch if the new","type":"text"},{"text":" ","type":"text"},{"text":"state now permits the original URL. Any stale pending link (one","type":"text"},{"text":" ","type":"text"},{"text":"the user cancelled or that no longer validates) is dropped.","type":"text"}],"type":"paragraph"},{"text":"Observing the reconciliation","anchor":"Observing-the-reconciliation","type":"heading","level":2},{"inlineContent":[{"code":"NavigationStore.events","type":"codeVoice"},{"text":" exposes the full sequence of batch +","type":"text"},{"text":" ","type":"text"},{"text":"path-mismatch events as a single stream, which is handy for","type":"text"},{"text":" ","type":"text"},{"text":"diagnostics dashboards:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["Task {","    for await event in store.events {","        switch event {","        case .batchExecuted(let result):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .pathMismatch(let event):","            analytics.track(\"deep_link_mismatch\", [","                \"policy\": event.policy.rawValue,","                \"old\": event.oldPath.map(String.init(describing:)),","                \"new\": event.newPath.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"],"type":"codeListing"},{"text":"Testing the chain","anchor":"Testing-the-chain","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"NavigationTestStore"},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"InnoRouterTesting"},{"text":") asserts the batch +","type":"text"},{"text":" ","type":"text"},{"text":"side effects for each branch:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func signedOutDeepLinkDefersUntilSignIn() {","    let store = NavigationTestStore<AppRoute>()","    \/\/ ...pipeline + handler wired to `store.store`","    pipeline.handle(URL(string: \"myapp:\/\/order\/42\")!, isAuthenticated: false)","","    store.receiveChange { _, new in new.path == [.signIn] }","    \/\/ Pending deep link remains queued; no .batchExecuted yet.","}"],"type":"codeListing"},{"text":"Next steps","anchor":"Next-steps","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Read "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},{"type":"text","text":" for how the sign-in flow that"},{"type":"text","text":" "},{"type":"text","text":"replays this deep link is modelled."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts","type":"reference","isActive":true},{"text":" if the existing app","type":"text"},{"text":" ","type":"text"},{"text":"still uses ","type":"text"},{"code":"ModalHost { NavigationHost { ... } }","type":"codeVoice"},{"text":" pairs.","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"type":"topic","abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then scope the signup sub-flow through a "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" and await its result inline."}],"title":"Building a Login Onboarding Flow","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","role":"article","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MigratingFromNestedHosts":{"url":"\/documentation\/innorouterswiftui\/tutorial-migratingfromnestedhosts","role":"article","abstract":[{"type":"text","text":"Replace manually composed "},{"code":"ModalHost { NavigationHost { ... } }","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"surfaces with a single "},{"code":"FlowHost","type":"codeVoice"},{"type":"text","text":" backed by "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":". Preserve"},{"type":"text","text":" "},{"type":"text","text":"existing "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" configurations while"},{"type":"text","text":" "},{"type":"text","text":"unlocking a serializable "},{"code":"[RouteStep<R>]","type":"codeVoice"},{"type":"text","text":" path and"},{"type":"text","text":" "},{"code":"FlowStore.apply(_:)","type":"codeVoice"},{"type":"text","text":" for restoration + deep-link hydration."}],"title":"Migrating from Nested Hosts to `FlowHost`","type":"topic","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","title":"InnoRouterSwiftUI","type":"topic","abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","kind":"article","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"kind":"symbol","abstract":[],"title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting","type":"topic"}}}