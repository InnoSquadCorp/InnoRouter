{"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-loginonboarding"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Scenario","anchor":"Scenario","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The app launches on a welcome screen. Tapping "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Continue"}]},{"type":"text","text":" pushes a"},{"type":"text","text":" "},{"type":"text","text":"pre-auth detail screen. Tapping "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Create account"}]},{"type":"text","text":" presents a signup"},{"type":"text","text":" "},{"type":"text","text":"sheet. When the signup finishes (or is cancelled) the owning flow"},{"type":"text","text":" "},{"type":"text","text":"resumes — either navigating to "},{"type":"codeVoice","code":".home(user)"},{"type":"text","text":" or staying put."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Modeling this with raw "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" means two"},{"type":"text","text":" "},{"type":"text","text":"authority objects, two view-layer hosts, and hand-rolled"},{"type":"text","text":" "},{"type":"text","text":"continuation plumbing to surface the sheet result back to the"},{"type":"text","text":" "},{"type":"text","text":"owner. "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" collapse this to a single"},{"type":"text","text":" "},{"type":"text","text":"store and one "},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This flow has crossed the macro-first local-stack boundary: push and modal"},{"type":"text","text":" "},{"type":"text","text":"state must share one externally owned, serializable authority. A push-only"},{"type":"text","text":" "},{"type":"text","text":"version should stay on "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" + "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" instead."}],"type":"paragraph"},{"text":"Routes","anchor":"Routes","type":"heading","level":2},{"syntax":"swift skip doc-fragment","code":["enum AppRoute: Route {","    case preAuth","    case signup","    case home(UserID)","}"],"type":"codeListing"},{"text":"Wiring the flow host","anchor":"Wiring-the-flow-host","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" renders environment-free navigation and modal surfaces around one"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then publishes a unified router authority to its view subtree:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@main","struct DemoApp: App {","    @State private var onboarding = OnboardingCoordinator()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: onboarding.flowStore,","                destination: destination,","                root: {","                    WelcomeRootView {","                        Task { await onboarding.startSignUpFlow() }","                    }","                }","            )","        }","    }","","    @ViewBuilder","    private func destination(_ route: AppRoute) -> some View {","        switch route {","        case .preAuth:","            PreAuthDetailView()","        case .signup:","            if let signUp = onboarding.activeSignUp {","                SignUpView(coordinator: signUp)","            }","        case .home(let id):","            HomeView(userID: id)","        }","    }","}"],"type":"codeListing"},{"text":"Emitting intents from views","anchor":"Emitting-intents-from-views","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Views never mutate "},{"type":"codeVoice","code":"FlowStore.path"},{"type":"text","text":" directly. They read typed actions from"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":"; the host projects those actions through "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"middleware and event observation see every step:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["struct WelcomeRootView: View {","    @EnvironmentRouter(AppRoute.self) private var router","    let startSignUp: @MainActor () -> Void","","    var body: some View {","        VStack {","            Button(\"Continue\") {","                router.go(.preAuth)","            }","            Button(\"Create account\") {","                startSignUp()","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"router.send(flow:)","type":"codeVoice"},{"type":"text","text":" only for flow-specific operations that do not have a"},{"type":"text","text":" "},{"type":"text","text":"focused action, such as resetting a complete "},{"code":"RouteStep","type":"codeVoice"},{"type":"text","text":" path."}],"type":"paragraph"},{"text":"Awaiting a signup sub-flow","anchor":"Awaiting-a-signup-sub-flow","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The signup sheet opens its own child coordinator that owns the step progression"},{"type":"text","text":" "},{"type":"text","text":"(email → password → confirmation). The app-defined onboarding owner keeps that"},{"type":"text","text":" "},{"type":"text","text":"child in presentation state, presents it through the same "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", then"},{"type":"text","text":" "},{"code":"await","type":"codeVoice"},{"type":"text","text":"s the final "},{"code":"UserID","type":"codeVoice"},{"type":"text","text":" through "},{"code":"signUp.waitForResult()","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@MainActor","final class SignUpCoordinator: ChildCoordinator {","    typealias Result = UserID","","    var onFinish: (@MainActor @Sendable (UserID) -> Void)?","    var onCancel: (@MainActor @Sendable () -> Void)?","","    \/\/ ...step state + methods omitted","","    func userDidCreateAccount(_ userID: UserID) {","        onFinish?(userID)   \/\/ emits the result back to the owner","    }","","    func userCancelled() {","        onCancel?()          \/\/ the owner sees nil","    }","}","","@Observable","@MainActor","final class OnboardingCoordinator {","    let flowStore = FlowStore<AppRoute>()","","    \/\/ The sheet content observes this app-owned placement state.","    var activeSignUp: SignUpCoordinator?","","    func startSignUpFlow() async {","        guard activeSignUp == nil else { return }","","        let signUp = SignUpCoordinator()","        activeSignUp = signUp","        defer { activeSignUp = nil }","","        flowStore.send(.presentSheet(.signup))","        let result = await signUp.waitForResult()","        flowStore.send(.dismiss)","","        if let userID = result {","            flowStore.send(.push(.home(userID)))","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"activeSignUp","type":"codeVoice"},{"type":"text","text":" determines which child the "},{"code":".signup","type":"codeVoice"},{"type":"text","text":" destination renders;"},{"type":"text","text":" "},{"code":"flowStore","type":"codeVoice"},{"type":"text","text":" remains the sole push-and-modal authority. "},{"code":"waitForResult()","type":"codeVoice"},{"type":"text","text":" only"},{"type":"text","text":" "},{"type":"text","text":"waits for a result and never presents the child. It installs the child’s "},{"code":"onFinish","type":"codeVoice"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"code":"onCancel","type":"codeVoice"},{"type":"text","text":" callbacks before its first suspension, so the child can emit a"},{"type":"text","text":" "},{"type":"text","text":"result at any point after the asynchronous call begins without a "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"re-entrancy deadlock. Cancelling the caller task that awaits "},{"code":"waitForResult()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"resolves it with "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", invokes "},{"code":"parentDidCancel()","type":"codeVoice"},{"type":"text","text":", and runs the "},{"code":"defer","type":"codeVoice"},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"clears the app-owned placement state. See"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md"},{"type":"text","text":" "},{"type":"text","text":"for the design rationale."}],"type":"paragraph"},{"text":"Verifying the flow host-lessly","anchor":"Verifying-the-flow-host-lessly","type":"heading","level":2},{"inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"type":"text","text":" (in "},{"code":"InnoRouterTesting","type":"codeVoice"},{"type":"text","text":") exercises the full chain"},{"type":"text","text":" "},{"type":"text","text":"in a unit test without mounting any SwiftUI host:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func signUpCompletesOnboarding() {","    let store = FlowTestStore<AppRoute>()","","    store.send(.presentSheet(.signup))","    store.receiveModal { if case .presented = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","","    store.send(.dismiss)","    store.receiveModal { if case .dismissed = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","}"],"type":"codeListing"},{"text":"Next steps","anchor":"Next-steps","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","type":"reference"},{"text":" to add analytics and","type":"text"},{"text":" ","type":"text"},{"text":"authentication gating to the same flow.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","type":"reference"},{"text":" to extend the host so a","type":"text"},{"text":" ","type":"text"},{"text":"push-notification URL can drop the user directly into ","type":"text"},{"code":".home","type":"codeVoice"},{"text":" ","type":"text"},{"text":"state on launch.","type":"text"}]}]}],"type":"unorderedList"}]}],"metadata":{"roleHeading":"Article","title":"Building a Login Onboarding Flow","role":"article","modules":[{"name":"InnoRouterTesting"}]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"abstract":[{"text":"Compose push, sheet, and cover steps into a single serializable flow with","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", then let the signup ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":" expose its result directly","type":"text"},{"text":" ","type":"text"},{"text":"to the same app-defined flow owner.","type":"text"}],"kind":"article","references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"kind":"article"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","abstract":[],"role":"collection","kind":"symbol","title":"InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MiddlewareComposition":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","type":"topic","title":"Composing Middleware Across Navigation and Modal","role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition","abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"type":"codeVoice","code":"NavigationStore"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that pairs completion callbacks with the middlewares"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" hook actually ran."}],"kind":"article"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-DeepLinkReconciliation":{"title":"Reconciling Deep Links End-to-End","url":"\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation","type":"topic","abstract":[{"text":"Match a URL, apply an authentication policy, and produce a","type":"text"},{"text":" ","type":"text"},{"code":"NavigationPlan","type":"codeVoice"},{"text":" that ","type":"text"},{"code":"NavigationStore.executeBatch","type":"codeVoice"},{"text":" applies in one","type":"text"},{"text":" ","type":"text"},{"text":"observable step. Queue the deep link while the user is signed out,","type":"text"},{"text":" ","type":"text"},{"text":"replay it after sign-in, and surface cancellation reasons through","type":"text"},{"text":" ","type":"text"},{"text":"typed outcomes.","type":"text"}],"role":"article","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation"},"../../../../Docs/design-child-coordinator-handoff.md":{"title":"Docs\/design-child-coordinator-handoff.md","type":"link","titleInlineContent":[{"type":"codeVoice","code":"Docs\/design-child-coordinator-handoff.md"}],"identifier":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","url":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md"}}}