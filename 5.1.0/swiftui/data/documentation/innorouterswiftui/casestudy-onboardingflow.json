{"variants":[{"paths":["\/documentation\/innorouterswiftui\/casestudy-onboardingflow"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"name":"Note","style":"note","content":[{"inlineContent":[{"type":"text","text":"This is a synthesized case study against the public InnoRouter"},{"type":"text","text":" "},{"type":"text","text":"surface (v5.0). It does not represent a specific shipped app"},{"type":"text","text":" "},{"type":"text","text":"but is structured to match the shape of recurring requests"},{"type":"text","text":" "},{"type":"text","text":"from teams evaluating the framework."}],"type":"paragraph"}],"type":"aside"},{"anchor":"The-brief","level":2,"text":"The brief","type":"heading"},{"inlineContent":[{"text":"The flow:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Launch screen.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Welcome + region picker.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Phone-number entry.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"SMS verification (modal sheet).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Profile photo (skippable).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Display name.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Permission primer (one screen per permission requested).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Notification opt-in (system prompt, conditional next step)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Home location (skippable)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Work location (skippable)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Subscription pitch (modal sheet, conditional)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Welcome-home with feature tour.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Constraints:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Auth state is owned by an existing "},{"type":"codeVoice","code":"AuthClient"},{"type":"text","text":". The flow"},{"type":"text","text":" "},{"type":"text","text":"reads it but doesn’t own it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Step ordering depends on user input (region → which"},{"type":"text","text":" "},{"type":"text","text":"permissions to request, region → subscription eligibility)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The user can deep-link in via "},{"type":"codeVoice","code":"inno:\/\/onboarding\/profile"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"resume mid-flow with prior steps already validated."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Analytics fires on every step entry. A push from outside the"},{"type":"text","text":" "},{"type":"text","text":"flow (e.g. a referral landing) shouldn’t double-fire entry"},{"type":"text","text":" "},{"type":"text","text":"events."}],"type":"paragraph"}]}]},{"text":"The composition","type":"heading","level":2,"anchor":"The-composition"},{"code":["@Routable","enum OnboardingRoute: Codable {","    case launch","    case welcome","    case phoneNumber","    case profilePhoto","    case displayName","    case permissionPrimer(Permission)","    case homeLocation","    case workLocation","    case smsVerification(phoneNumber: String)","    case subscription(plan: SubscriptionPlan)","    case welcomeHome","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"One route type covers both push destinations and modal-only","type":"text"},{"text":" ","type":"text"},{"text":"destinations. ","type":"text"},{"code":"FlowStore<OnboardingRoute>","type":"codeVoice"},{"text":" exposes ","type":"text"},{"code":"path: [RouteStep<OnboardingRoute>]","type":"codeVoice"},{"text":": ","type":"text"},{"code":".push(...)","type":"codeVoice"},{"text":" steps drive the","type":"text"},{"text":" ","type":"text"},{"text":"navigation stack, while ","type":"text"},{"code":".sheet(...)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".cover(...)","type":"codeVoice"},{"text":" steps","type":"text"},{"text":" ","type":"text"},{"text":"drive modal presentation. Because the single route type is","type":"text"},{"text":" ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", the entire flow state is serializable to a","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":".","type":"text"}]},{"code":["store.send(.presentSheet(.smsVerification(phoneNumber: phoneNumber)))","","let rehydrationPlan: FlowPlan<OnboardingRoute> = .init(steps: [","    .push(.launch),","    .push(.welcome),","    .sheet(.subscription(plan: subscriptionPlan)),","])"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"text":"The driver","type":"heading","level":2,"anchor":"The-driver"},{"code":["@MainActor","final class OnboardingDriver: ChildCoordinator {","    typealias Route = OnboardingRoute","    typealias Result = OnboardingResult","","    var onFinish: (@MainActor @Sendable (OnboardingResult) -> Void)?","    var onCancel: (@MainActor @Sendable () -> Void)?","","    let store: FlowStore<OnboardingRoute>","    private let auth: AuthClient","    private let analytics: AnalyticsClient","","    init(auth: AuthClient, analytics: AnalyticsClient) {","        self.auth = auth","        self.analytics = analytics","        self.store = FlowStore(","            configuration: FlowStoreConfiguration(","                navigation: NavigationStoreConfiguration(","                    middlewares: [","                        .init(middleware: AnalyticsMiddleware(analytics: analytics),","                              debugName: \"analytics\"),","                        .init(middleware: EntitlementGate(auth: auth),","                              debugName: \"entitlement\"),","                    ]","                ),","                onEvent: { [analytics] event in","                    switch event {","                    case .pathChanged(_, let new):","                        analytics.record(.flowPathChanged(new))","                    case .intentRejected(_, let reason):","                        analytics.record(.flowRejected(reason))","                    case .navigation, .modal:","                        break","                    }","                },","                queueCoalescePolicy: .dropQueued","            )","        )","    }","","    func start() {","        store.send(.replaceStack([.launch, .welcome]))","    }","","    func handleDeepLink(_ url: URL) async {","        guard let plan = OnboardingDeepLink.plan(from: url, auth: auth) else {","            store.send(.push(.welcome))","            return","        }","        _ = store.apply(plan)","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"code":"ChildCoordinator","type":"codeVoice"},{"text":" returns an ","type":"text"},{"code":"OnboardingResult","type":"codeVoice"},{"text":" to the parent","type":"text"},{"text":" ","type":"text"},{"text":"when the flow finishes:","type":"text"}]},{"code":["enum OnboardingResult {","    case completed(profile: Profile)","    case abandoned(at: OnboardingRoute)","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"The app-defined flow owner first stores ","type":"text"},{"code":"onboardingDriver","type":"codeVoice"},{"text":" in state that","type":"text"},{"text":" ","type":"text"},{"text":"presents the sheet, then directly awaits","type":"text"},{"text":" ","type":"text"},{"code":"onboardingDriver.waitForResult() async -> OnboardingResult?","type":"codeVoice"},{"text":". The method waits","type":"text"},{"text":" ","type":"text"},{"text":"for the result but never presents the driver. Its structured call threads","type":"text"},{"text":" ","type":"text"},{"text":"caller-task cancellation back through ","type":"text"},{"code":"parentDidCancel()","type":"codeVoice"},{"text":" and returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if","type":"text"},{"text":" ","type":"text"},{"text":"the sheet shell tears down its awaiting task. The owner clears its presentation","type":"text"},{"text":" ","type":"text"},{"text":"state after the call returns.","type":"text"}]},{"text":"What the middlewares earn","type":"heading","level":2,"anchor":"What-the-middlewares-earn"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnalyticsMiddleware"},{"type":"text","text":" records "},{"type":"codeVoice","code":".willExecute"},{"type":"text","text":" and "},{"type":"codeVoice","code":".didExecute"},{"type":"text","text":" "},{"type":"text","text":"events for every navigation command, deduplicated against the"},{"type":"text","text":" "},{"type":"codeVoice","code":".pathChanged"},{"type":"text","text":" case handled by "},{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because middleware fires "},{"type":"strong","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"state mutates, the analytics event always carries the intended"},{"type":"text","text":" "},{"type":"text","text":"target route, not the post-cancellation snapshot."}]},{"type":"paragraph","inlineContent":[{"code":"EntitlementGate","type":"codeVoice"},{"text":" reads ","type":"text"},{"code":"auth.isEligible(for: route)","type":"codeVoice"},{"text":" for each","type":"text"},{"text":" ","type":"text"},{"text":"navigation prefix. If the user is not yet eligible for a","type":"text"},{"text":" ","type":"text"},{"text":"branch, navigation middleware cancels the ","type":"text"},{"code":".replaceStack","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":".reset","type":"codeVoice"},{"text":" command with a typed reason; the flow falls back to","type":"text"},{"text":" ","type":"text"},{"code":".dropQueued","type":"codeVoice"},{"text":" policy, dismissing any speculative modal state","type":"text"},{"text":" ","type":"text"},{"text":"that was queued behind the rejected navigation rewrite.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":".intentRejected","type":"codeVoice"},{"text":" case records a structured","type":"text"},{"text":" ","type":"text"},{"code":".middlewareRejected(debugName: \"entitlement\")","type":"codeVoice"},{"text":" event so the","type":"text"},{"text":" ","type":"text"},{"text":"analytics layer can correlate with the same span ID.","type":"text"}]},{"text":"What `FlowPlan` earns","type":"heading","level":2,"anchor":"What-FlowPlan-earns"},{"type":"paragraph","inlineContent":[{"text":"A deep link ","type":"text"},{"code":"inno:\/\/onboarding\/profile","type":"codeVoice"},{"text":" deserializes into:","type":"text"}]},{"code":["let plan: FlowPlan<OnboardingRoute> = .init(","    steps: [","        .push(.launch),","        .push(.welcome),","        .push(.phoneNumber),","        .push(.profilePhoto),","    ]",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"code":"store.apply(plan)","type":"codeVoice"},{"text":" is atomic: every step previews against","type":"text"},{"text":" ","type":"text"},{"text":"middleware in order, and the entire plan rolls back if any","type":"text"},{"text":" ","type":"text"},{"text":"preview rejects. The user never sees a half-applied flow even","type":"text"},{"text":" ","type":"text"},{"text":"if the entitlement gate decides one of the intermediate steps","type":"text"},{"text":" ","type":"text"},{"text":"is currently unreachable.","type":"text"}]},{"inlineContent":[{"text":"Because ","type":"text"},{"code":"OnboardingRoute","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", the same ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"be persisted to ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"scenePhase: .background","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and restored on the next cold launch via","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlan(validating:)","type":"codeVoice"},{"text":" — the validating constructor rejects","type":"text"},{"text":" ","type":"text"},{"text":"invariant violations (e.g. two modal steps) before the","type":"text"},{"text":" ","type":"text"},{"text":"authority sees them.","type":"text"}],"type":"paragraph"},{"anchor":"What-InnoRouterTesting-earns","level":2,"text":"What `InnoRouterTesting` earns","type":"heading"},{"syntax":"swift skip doc-fragment","code":["@Test","func onboardingResumesFromProfile() async throws {","    let auth = AuthClient.signedIn(region: .us)","    let analytics = RecordingAnalytics()","    let test = FlowTestStore<OnboardingRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: EntitlementGate(auth: auth)),","            ])","        )","    )","","    test.send(.push(.launch))","    test.expect(navigation: [.launch])","    try await test.apply(","        FlowPlan(steps: [","            .push(.launch),","            .push(.welcome),","            .push(.phoneNumber),","            .push(.profilePhoto),","        ])","    )","    test.expect(navigation: [.launch, .welcome, .phoneNumber, .profilePhoto])","    test.expect(modal: nil)","}"],"type":"codeListing"},{"inlineContent":[{"text":"No SwiftUI host in scope. The exact same store configuration —","type":"text"},{"text":" ","type":"text"},{"text":"including production analytics middleware — is exercised in","type":"text"},{"text":" ","type":"text"},{"text":"the test and in production. ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"text":" reuses the","type":"text"},{"text":" ","type":"text"},{"code":"FlowStoreConfiguration.onEvent","type":"codeVoice"},{"text":", so the test can also verify","type":"text"},{"text":" ","type":"text"},{"text":"that ","type":"text"},{"type":"codeVoice","code":"analytics.record(.flowPathChanged(...))"},{"text":" fired exactly","type":"text"},{"text":" ","type":"text"},{"text":"once per applied step.","type":"text"}],"type":"paragraph"},{"anchor":"Observed-wins","level":2,"text":"Observed wins","type":"heading"},{"inlineContent":[{"text":"In a comparable TCA-modeled flow before the swap, the same","type":"text"},{"text":" ","type":"text"},{"text":"feature carried:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"~340 lines of ","type":"text"},{"code":"Reducer","type":"codeVoice"},{"text":" boilerplate for navigation actions","type":"text"},{"text":" ","type":"text"},{"text":"alone (push \/ pop \/ present \/ dismiss \/ forward \/ hydrate).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Three custom test harnesses to assert state restoration,","type":"text"},{"text":" ","type":"text"},{"text":"deep-link replay, and entitlement gating in isolation.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A bespoke “is the queue stale?” check after every cancelled"},{"type":"text","text":" "},{"type":"text","text":"command because TCA’s "},{"type":"codeVoice","code":"@Presents"},{"type":"text","text":" carry-over isn’t governed"},{"type":"text","text":" "},{"type":"text","text":"by a policy at the framework level."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The InnoRouter version drops the navigation reducer","type":"text"},{"text":" ","type":"text"},{"text":"boilerplate entirely (the framework owns the state machine),","type":"text"},{"type":"text","text":" "},{"type":"text","text":"folds the three test harnesses into one "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" "},{"type":"text","text":"suite, and pushes the queue-coalesce decision into a single"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStoreConfiguration"},{"text":" setting that participates in the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"analytics middleware’s span ID without extra wiring."}],"type":"paragraph"},{"anchor":"When-this-composition-is-overkill","level":2,"text":"When this composition is overkill","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For a single-screen flow with no entitlement gating and no deep link, declare","type":"text"},{"text":" ","type":"text"},{"text":"the destinations with ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" and use ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":". Promote to an externally","type":"text"},{"text":" ","type":"text"},{"text":"owned ","type":"text"},{"code":"NavigationStore<R>","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":" only when another boundary needs","type":"text"},{"text":" ","type":"text"},{"text":"the store.","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" earns its surface specifically when:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Multiple steps need atomic deep-link rehydration.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The modal authority is genuinely concurrent with the","type":"text"},{"text":" ","type":"text"},{"text":"navigation stack (sheets, covers).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A coordinator-level result (","type":"text"},{"code":"OnboardingResult","type":"codeVoice"},{"text":") needs to","type":"text"},{"text":" ","type":"text"},{"text":"bubble back to the parent.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Middleware needs to gate or telemeter the entire flow.","type":"text"}],"type":"paragraph"}]}]}]}],"metadata":{"title":"Case study: shipping a 12-screen onboarding flow","modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article"},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/CaseStudy-OnboardingFlow","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"text":"A representative composition of ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"NavigationMiddleware","type":"codeVoice"},{"text":" for a 12-screen","type":"text"},{"text":" ","type":"text"},{"text":"onboarding sequence with conditional branches, deep-link","type":"text"},{"text":" ","type":"text"},{"text":"resumption, and entitlement gating.","type":"text"}],"kind":"article","references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRou