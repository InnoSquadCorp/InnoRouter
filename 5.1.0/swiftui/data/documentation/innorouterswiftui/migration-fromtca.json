{"metadata":{"title":"Migrating navigation from TCA to InnoRouter","role":"article","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Migration-FromTCA","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/migration-fromtca"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Why this migration","anchor":"Why-this-migration"},{"inlineContent":[{"type":"text","text":"TCA’s navigation surface ("},{"type":"codeVoice","code":"StackState<Element>"},{"type":"text","text":", "},{"type":"codeVoice","code":"@Presents"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStackStore"},{"type":"text","text":") bundles three responsibilities:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"State authority"}],"type":"strong"},{"text":" — what is on the stack, what modal is up.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Action plumbing"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"Action.path(.push(...))","type":"codeVoice"},{"text":", ","type":"text"},{"code":"delegate","type":"codeVoice"},{"text":" ","type":"text"},{"text":"actions, ","type":"text"},{"code":".dismiss","type":"codeVoice"},{"text":" from the parent.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"View binding"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"NavigationStackStore","type":"codeVoice"},{"text":" translates child","type":"text"},{"text":" ","type":"text"},{"text":"stores into ","type":"text"},{"code":"NavigationLink","type":"codeVoice"},{"text":"s.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"InnoRouter takes ownership of (1) and (3) and replaces (2)"},{"type":"text","text":" "},{"type":"text","text":"with a typed "},{"type":"codeVoice","code":"NavigationIntent"},{"type":"text","text":" enum that flows through the"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI environment. The reducer surface shrinks because the"},{"type":"text","text":" "},{"type":"text","text":"parent reducer no longer needs to forward navigation actions"},{"type":"text","text":" "},{"type":"text","text":"into "},{"type":"codeVoice","code":"StackState"},{"type":"text","text":" mutations."}],"type":"paragraph"},{"type":"heading","level":2,"text":"The minimal swap","anchor":"The-minimal-swap"},{"inlineContent":[{"type":"text","text":"A canonical TCA navigation feature looks like this:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable {","        var path = StackState<Path.State>()","    }","","    enum Action {","        case path(StackActionOf<Path>)","    }","","    @Reducer","    struct Path {","        enum State: Equatable { case detail(DetailFeature.State) }","        enum Action { case detail(DetailFeature.Action) }","        var body: some ReducerOf<Self> {","            Scope(state: \\.detail, action: \\.detail) { DetailFeature() }","        }","    }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","            .forEach(\\.path, action: \\.path) { Path() }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        NavigationStackStore(store.scope(state: \\.path, action: \\.path)) {","            RootView(store: store)","        } destination: { store in","            switch store.state {","            case .detail:","                if let detail = store.scope(state: \\.detail, action: \\.detail) {","                    DetailView(store: detail)","                }","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"After migration:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@Router","enum AppRoute {","    case detail(DetailFeature.State.ID)","","    var destination: some View {","        switch self {","        case .detail(let id):","            DetailView(\/* hydrate from id *\/)","        }","    }","}","","@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable { \/* business state only *\/ }","","    enum Action { \/* business actions only *\/ }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        RouterHost(AppRoute.self) {","            RootView(store: store)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Three things changed:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"The reducer’s ","type":"text"},{"code":"path: StackState<Path.State>","type":"codeVoice"},{"text":" is gone — the","type":"text"},{"text":" ","type":"text"},{"text":"parent reducer no longer carries navigation state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The parent action enum no longer routes","type":"text"},{"text":" ","type":"text"},{"code":"case path(StackActionOf<Path>)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The view uses macro-generated destinations with ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" in place of","type":"text"},{"text":" ","type":"text"},{"code":"NavigationStackStore","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"Path","type":"codeVoice"},{"text":" reducer composition. No navigation store is","type":"text"},{"text":" ","type":"text"},{"text":"exposed to the feature for this self-contained stack.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"If a TCA dependency, deep-link handler, or restoration boundary must access"},{"type":"text","text":" "},{"type":"text","text":"the navigation authority, promote the store to the app boundary. "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" "},{"type":"text","text":"still removes the destination closure, so the advanced form keeps the correct"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" closure order:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@State private var navigationStore = NavigationStore<AppRoute>()","","NavigationHost(store: navigationStore) {","    RootView(store: store)","}"],"type":"codeListing"},{"type":"heading","level":2,"text":"Modal presentation (`@Presents` → `ModalStore`)","anchor":"Modal-presentation-Presents-%E2%86%92-ModalStore"},{"inlineContent":[{"type":"text","text":"TCA’s "},{"type":"codeVoice","code":"@Presents"},{"type":"text","text":" is conceptually equivalent to a "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" "},{"type":"text","text":"slot. Replace:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@ObservableState","struct State {","    @Presents var sheet: SheetFeature.State?","}","","enum Action {","    case sheet(PresentationAction<SheetFeature.Action>)","}","","\/\/ View",".sheet(item: $store.scope(state: \\.sheet, action: \\.sheet)) { … }"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"with:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["\/\/ State + Action no longer carry the modal slot.","","\/\/ View","ModalHost(store: modalStore) { route in","    switch route { case .sheet: SheetView(…) }","} content: {","    RootView()","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The reducer no longer fires "},{"type":"codeVoice","code":"Action.sheet(.presented(…))"},{"type":"text","text":"; the view reads"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter(AppModalRoute.self)"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"router.sheet(_:)"},{"type":"text","text":". Move to"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" only when stack and modal state must form one atomic timeline;"},{"type":"text","text":" "},{"type":"text","text":"flow-specific intents use "},{"type":"codeVoice","code":"router.send(flow:)"},{"type":"text","text":" through the same environment"},{"type":"text","text":" "},{"type":"text","text":"router surface."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Stack + modal as one value (`StackState` + `@Presents` → `FlowStore`)","anchor":"Stack-+-modal-as-one-value-StackState-+-Presents-%E2%86%92-FlowStore"},{"inlineContent":[{"text":"If a feature uses both navigation and modal authority, replace","type":"text"},{"text":" ","type":"text"},{"text":"both with a single ","type":"text"},{"code":"FlowStore<Route>","type":"codeVoice"},{"text":" and observe ","type":"text"},{"code":"path: [RouteStep<Route>]","type":"codeVoice"},{"text":" as the single source of truth. The","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" value type makes the entire flow state Codable for","type":"text"},{"text":" ","type":"text"},{"text":"deep-link rehydration and state restoration.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Testing — `TestStore` → `NavigationTestStore` \/ `FlowTestStore`","anchor":"Testing-TestStore-%E2%86%92-NavigationTestStore--FlowTestStore"},{"inlineContent":[{"code":"InnoRouterTesting","type":"codeVoice"},{"text":" ships host-less test stores that mirror","type":"text"},{"text":" ","type":"text"},{"text":"TCA’s strict-exhaustivity ergonomics. Swap:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let testStore = TestStore(initialState: AppFeature.State()) { AppFeature() }","await testStore.send(.path(.push(id: 0, state: .detail(...))))"],"type":"codeListing"},{"inlineContent":[{"text":"with:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let test = NavigationTestStore<AppRoute>()","test.execute(.push(.detail(id)))","test.expect(state: [.detail(id)])"],"type":"codeListing"},{"inlineContent":[{"text":"The test store keeps the analytics \/ diagnostic ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" callback the","type":"text"},{"text":" ","type":"text"},{"text":"production store wired through ","type":"text"},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so the test asserts production telemetry without","type":"text"},{"text":" ","type":"text"},{"code":"@testable import","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"What stays in TCA","anchor":"What-stays-in-TCA"},{"inlineContent":[{"type":"text","text":"InnoRouter explicitly does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" replace:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Business logic reducers (","type":"text"},{"code":"Reduce { state, action in … }","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Side effects (","type":"text"},{"code":"Effect.send","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Effect.run","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Dependency injection (","type":"text"},{"code":"@Dependency","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Cross-feature coordination (parent ⇄ child reducer composition"},{"type":"text","text":" "},{"text":"for non-navigation concerns)","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"A typical migrated codebase keeps every reducer in place; the","type":"text"},{"text":" ","type":"text"},{"text":"delta is the state slots and actions removed because navigation","type":"text"},{"text":" ","type":"text"},{"text":"no longer needs reducer-level modeling.","type":"text"}]},{"type":"heading","level":2,"text":"Migration sequence","anchor":"Migration-sequence"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Start with a leaf feature whose navigation state lives only in the parent","type":"text"},{"text":" ","type":"text"},{"text":"reducer’s ","type":"text"},{"code":"StackState","type":"codeVoice"},{"text":". Declare its route with ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" and replace the","type":"text"},{"text":" ","type":"text"},{"text":"view-layer wiring with ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Strip the matching ","type":"text"},{"code":"path","type":"codeVoice"},{"text":" slot and ","type":"text"},{"code":"Path","type":"codeVoice"},{"text":" reducer from the","type":"text"},{"text":" ","type":"text"},{"text":"parent reducer. Verify the existing tests still pass against","type":"text"},{"text":" ","type":"text"},{"text":"the trimmed reducer state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Repeat per feature. The blast radius per migration is contained because","type":"text"},{"text":" ","type":"text"},{"text":"each ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" owns an independent local "},{"code":"FlowStore","type":"codeVoice"},{"text":" behind","type":"text"},{"text":" ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Tackle modal authority feature-by-feature once the navigation"},{"type":"text","text":" "},{"type":"text","text":"stacks are ported. "},{"code":"@Presents","type":"codeVoice"},{"text":" is the cheapest swap.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"For features with both stack and modal authority, migrate","type":"text"},{"text":" ","type":"text"},{"text":"them last by lifting the combined state into ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"capturing the deep-link flow through ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Common pitfalls","anchor":"Common-pitfalls"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Action forwarding instinct.","type":"text"}],"type":"strong"},{"text":" TCA users habitually plumb navigation","type":"text"},{"text":" ","type":"text"},{"text":"through actions even when the feature doesn’t need it. With","type":"text"},{"text":" ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":", the view calls ","type":"text"},{"code":"router.go(...)","type":"codeVoice"},{"text":" directly; the reducer","type":"text"},{"text":" ","type":"text"},{"text":"never sees a navigation action unless you explicitly want to gate one","type":"text"},{"text":" ","type":"text"},{"text":"through middleware.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Strict concurrency floor.","type":"text"}],"type":"strong"},{"text":" InnoRouter requires iOS 18 \/","type":"text"},{"text":" ","type":"text"},{"text":"Swift 6.3. If the project still targets iOS 13–17, plan the","type":"text"},{"text":" ","type":"text"},{"text":"platform bump as a separate PR before the navigation","type":"text"},{"text":" ","type":"text"},{"text":"migration.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"@Bindable store","type":"codeVoice"},{"text":" ergonomics.","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" and works with "},{"type":"codeVoice","code":"@Bindable"},{"type":"text","text":" directly — no"},{"type":"text","text":" "},{"type":"codeVoice","code":"bindable"},{"type":"text","text":" modifier or scoped binding helpers are needed."}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Reference","anchor":"Reference"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"@Router","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NavigationStore","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":" for externally owned authority","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ModalStore","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"ModalHost","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"FlowStore","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"FlowPlan","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"InnoRouterTesting","type":"codeVoice"},{"text":" (","type":"text"},{"code":"NavigationTestStore","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"ModalTestStore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"abstract":[{"text":"This guide walks a TCA project through replacing its navigation","type":"text"},{"text":" ","type":"text"},{"text":"layer with InnoRouter while keeping the rest of the architecture","type":"text"},{"text":" ","type":"text"},{"text":"(reducers, effects, state) intact. InnoRouter is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"replacement for TCA’s reducer composition — it replaces the","type":"text"},{"text":" ","type":"text"},{"text":"parts of TCA that own ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation state"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"modal authority"}],"type":"emphasis"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"kind":"article","references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"kind":"article"},"doc://c