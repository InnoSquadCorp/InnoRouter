{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/navigationstore-and-hosts"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Start-macro-first","level":2,"text":"Start macro-first"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a local stack and modal flow, declare destinations on the route and let"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" own the unified store:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Router","enum AppRoute {","    case detail(id: String)","    case settings","","    var destination: some View {","        switch self {","        case .detail(let id):","            DetailView(id: id)","        case .settings:","            SettingsView()","        }","    }","}","","struct AppRoot: View {","    var body: some View {","        RouterHost(AppRoute.self) {","            HomeView()","        }","    }","}","","struct HomeView: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    var body: some View {","        Button(\"Open settings\") {","            router.go(.settings)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" generates "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" and "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":" conformance. If the host"},{"type":"text","text":" "},{"type":"text","text":"is missing or the route type does not match the nearest host,"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" follows "},{"type":"codeVoice","code":"EnvironmentMissingPolicy"},{"type":"text","text":" and fails loudly by"},{"type":"text","text":" "},{"type":"text","text":"default."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add literal origin allowlists and "},{"code":"@DeepLink","type":"codeVoice"},{"type":"text","text":" markers when a URL resolves to"},{"type":"text","text":" "},{"type":"text","text":"one pushed route. "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" installs the incoming-URL handler automatically;"},{"type":"text","text":" "},{"type":"text","text":"no application "},{"code":"onOpenURL","type":"codeVoice"},{"type":"text","text":" bridge is needed for that path."}]},{"type":"heading","anchor":"Promote-the-store-when-another-boundary-needs-it","level":2,"text":"Promote the store when another boundary needs it"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create the "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" outside the host when authentication or pending"},{"type":"text","text":" "},{"type":"text","text":"replay, multi-step deep-link reconciliation, state restoration, middleware"},{"type":"text","text":" "},{"type":"text","text":"mutation, event observation, or another application boundary needs direct"},{"type":"text","text":" "},{"type":"text","text":"access. The "},{"code":"DestinationRoute","type":"codeVoice"},{"type":"text","text":" generated by "},{"code":"@Router","type":"codeVoice"},{"type":"text","text":" keeps this advanced host"},{"type":"text","text":" "},{"type":"text","text":"concise:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@State private var navigation = NavigationStore<AppRoute>()","","NavigationHost(store: navigation) {","    HomeView()","}"]},{"type":"heading","anchor":"What-the-store-owns","level":2,"text":"What the store owns"},{"type":"paragraph","inlineContent":[{"code":"NavigationStore","type":"codeVoice"},{"text":" owns:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"the current ","type":"text"},{"code":"RouteStack","type":"codeVoice"},{"text":" snapshot","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"command execution","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"batch execution","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"transactional execution","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"path reconciliation from ","type":"text"},{"code":"NavigationStack(path:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"middleware registry orchestration","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"typed observation events for analytics and diagnostics","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Configuration is centralized in ","type":"text"},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Its synchronous observation surface is one ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" callback that","type":"text"},{"text":" ","type":"text"},{"text":"switches over ","type":"text"},{"code":"NavigationEvent","type":"codeVoice"},{"text":"; ","type":"text"},{"code":"NavigationStore.events","type":"codeVoice"},{"text":" provides the","type":"text"},{"text":" ","type":"text"},{"text":"same cases as an ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let configuration = NavigationStoreConfiguration<AppRoute>(","    onEvent: { event in","        switch event {","        case .changed(_, let new):","            analytics.recordPath(new.path)","        case .batchExecuted(let result):","            analytics.recordBatch(result)","        case .transactionExecuted(let result):","            analytics.recordTransaction(result)","        case .middlewareMutation(let mutation):","            diagnostics.record(mutation)","        case .pathMismatch(let mismatch):","            diagnostics.record(mismatch)","        }","    }",")"]},{"type":"paragraph","inlineContent":[{"text":"For a 5.0 migration, move the bodies of the former per-event","type":"text"},{"text":" ","type":"text"},{"text":"configuration closures into these switch cases. No compatibility","type":"text"},{"text":" ","type":"text"},{"text":"closures remain.","type":"text"}]},{"anchor":"Host-responsibilities","text":"Host responsibilities","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CoordinatorHost"},{"type":"text","text":" connect SwiftUI navigation UI to the store or coordinator:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"render the root view"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"render destinations for pushed routes"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"publish one route-typed authority consumed through "},{"type":"codeVoice","code":"@EnvironmentRouter"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"bridge system path changes back into router commands"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Views should not mutate a store directly. The default view-facing surface is"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":", whose "},{"type":"codeVoice","code":"RouterActions"},{"type":"text","text":" methods emit typed"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationIntent"},{"type":"text","text":" values. Use "},{"type":"codeVoice","code":"go"},{"type":"text","text":", "},{"type":"codeVoice","code":"back"},{"type":"text","text":", and the other focused conveniences"},{"type":"text","text":" "},{"type":"text","text":"for common transitions, and "},{"type":"codeVoice","code":"send(_:)"},{"type":"text","text":" as the explicit escape hatch for an"},{"type":"text","text":" "},{"type":"text","text":"advanced intent. The same "},{"type":"codeVoice","code":"@EnvironmentRouter(Route.self)"},{"type":"text","text":" surface is used for"},{"type":"text","text":" "},{"type":"text","text":"navigation, modal, flow, and tab capabilities supplied by the matching host."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" for synchronous analytics or diagnostics and "},{"type":"codeVoice","code":"events"},{"type":"text","text":" when an"},{"type":"text","text":" "},{"type":"text","text":"asynchronous consumer should own the observation task. Supplying "},{"type":"codeVoice","code":"logger"},{"type":"text","text":" "},{"type":"text","text":"also records private, structured summaries through the store’s internal OSLog"},{"type":"text","text":" "},{"type":"text","text":"integration; no separate telemetry adapter is required."}],"type":"paragraph"},{"anchor":"Intent-command-shape","text":"Intent command shape","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"NavigationStore.send(_:)"},{"type":"text","text":" and the navigation adapter owned by "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" "},{"type":"text","text":"use the same middleware-visible command shape:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"empty "},{"type":"codeVoice","code":"goMany"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"pushMany"},{"type":"text","text":" -> no command"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"one route -> "},{"type":"codeVoice","code":".push"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"multiple routes -> one atomic "},{"type":"codeVoice","code":".pushAll"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"backBy"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"popCount"},{"type":"text","text":" equal to the current stack depth -> "},{"type":"codeVoice","code":".popToRoot"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"With no modal tail, pop attempts enter middleware even on an empty stack."},{"type":"text","text":" "},{"type":"text","text":"The engine may still return a no-op or failure, but middleware can consistently"},{"type":"text","text":" "},{"type":"text","text":"observe, cancel, or rewrite the attempt. A modal tail remains the flow boundary:"},{"type":"text","text":" "},{"type":"text","text":"stack-pop intents do not bypass it."}],"type":"paragraph"},{"anchor":"Path-reconciliation","text":"Path reconciliation","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When SwiftUI changes the path, InnoRouter translates that change back into semantic commands:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"prefix shrink -> "},{"type":"codeVoice","code":".popCount"},{"type":"text","text":" or "},{"type":"codeVoice","code":".popToRoot"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"prefix expand -> per-step "},{"type":"codeVoice","code":".push"},{"type":"text","text":" batch"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"mismatch -> "},{"type":"codeVoice","code":"NavigationPathMismatchPolicy"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This preserves command meaning instead of treating every path change as a blind replacement."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"NavigationStoreConfiguration"},{"type":"text","text":" defaults to "},{"type":"codeVoice","code":".replace"},{"type":"text","text":", which treats the"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI binding as the source of truth for a non-prefix rewrite and emits"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"NavigationPathMismatchEvent"},{"type":"text","text":". For debug or pre-release builds, use"},{"type":"text","text":" "},{"type":"codeVoice","code":".assertAndReplace"},{"type":"text","text":" to make unexpected rewrites loud while still"},{"type":"text","text":" "},{"type":"text","text":"recovering. Use "},{"type":"codeVoice","code":".ignore"},{"type":"text","text":" only when the store must remain the sole"},{"type":"text","text":" "},{"type":"text","text":"authority, and "},{"type":"codeVoice","code":".custom"},{"type":"text","text":" when a host has domain-specific repair rules."}],"type":"paragraph"}]}],"metadata":{"roleHeading":"Article","role":"article","title":"NavigationStore and hosts","modules":[{"name":"InnoRouterTesting"}]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/NavigationStore-and-Hosts","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"abstract":[{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" is the default self-contained stack-plus-modal surface."},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" is the advanced stack-only authority to use when the"},{"type":"text","text":" "},{"type":"text","text":"application needs to own navigation state outside a host."}],"kind":"article","references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","abstract":[],"role":"collection"