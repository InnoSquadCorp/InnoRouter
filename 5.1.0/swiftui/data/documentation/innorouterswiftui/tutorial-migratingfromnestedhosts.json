{"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-migratingfromnestedhosts"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"inlineContent":[{"type":"text","text":"This is an advanced promotion path. A self-contained push-only feature should"},{"type":"text","text":" "},{"type":"text","text":"stay on "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" + "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":"; introduce the externally owned stores below"},{"type":"text","text":" "},{"type":"text","text":"only when push and modal state must be restored or deep-linked as one value."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Starting point","anchor":"Starting-point"},{"inlineContent":[{"type":"text","text":"An app that shipped before "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" landed typically has:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@main","struct LegacyApp: App {","    @State private var nav = NavigationStore<AppRoute>()","    @State private var modal = ModalStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            ModalHost(store: modal, destination: destination) {","                NavigationHost(store: nav, destination: destination) {","                    RootView()","                }","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Two stores. Two hosts. Path + modal state cannot be round-tripped","type":"text"},{"text":" ","type":"text"},{"text":"as one value — the app can’t persist “user is 3 screens deep","type":"text"},{"text":" ","type":"text"},{"text":"inside a presented sheet” without hand-serializing both halves.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Target shape","anchor":"Target-shape"},{"syntax":"swift skip doc-fragment","code":["@main","struct MigratedApp: App {","    @State private var flow = FlowStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: flow,","                destination: destination,","                root: { RootView() }","            )","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"One store. One host. ","type":"text"},{"code":"flow.path: [RouteStep<AppRoute>]","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"single source of truth; push + sheet + cover are three cases of","type":"text"},{"text":" ","type":"text"},{"text":"the same enum.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Migration steps","anchor":"Migration-steps"},{"type":"heading","level":3,"text":"1. Swap the host layering","anchor":"1-Swap-the-host-layering"},{"inlineContent":[{"text":"Replace the nested host pair with ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":". It renders environment-free","type":"text"},{"text":" ","type":"text"},{"text":"navigation and modal surfaces around one ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", then publishes one","type":"text"},{"text":" ","type":"text"},{"text":"unified authority for ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":". External observable behavior stays","type":"text"},{"text":" ","type":"text"},{"text":"the same without exposing the inner stores as independent mutation surfaces.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"2. Route view actions through `EnvironmentRouter`","anchor":"2-Route-view-actions-through-EnvironmentRouter"},{"inlineContent":[{"text":"Old:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["navigationStore.send(.go(.detail))","modalStore.present(.sheet, style: .sheet)"],"type":"codeListing"},{"inlineContent":[{"text":"New:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@EnvironmentRouter(AppRoute.self) private var router","\/\/ ...","router.go(.detail)","router.sheet(.sheet)"],"type":"codeListing"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"router.send(flow:)","type":"codeVoice"},{"text":" only for flow-specific operations such as resetting a","type":"text"},{"text":" ","type":"text"},{"text":"complete ","type":"text"},{"code":"RouteStep","type":"codeVoice"},{"text":" path.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"FlowStore.send","type":"codeVoice"},{"text":" routes navigation and modal intents through the corresponding","type":"text"},{"text":" ","type":"text"},{"text":"configured middleware and reports their wrapped events through the unified","type":"text"},{"text":" ","type":"text"},{"text":"flow observation stream.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"3. Port store configuration through `FlowStoreConfiguration`","anchor":"3-Port-store-configuration-through-FlowStoreConfiguration"},{"inlineContent":[{"code":"FlowStoreConfiguration","type":"codeVoice"},{"text":" composes ","type":"text"},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"text":" +","type":"text"},{"text":" ","type":"text"},{"code":"ModalStoreConfiguration","type":"codeVoice"},{"text":", so existing configs port 1:1:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let flow = FlowStore<AppRoute>(","    configuration: .init(","        navigation: legacyNavigationConfiguration,","        modal: legacyModalConfiguration,","        onEvent: { event in","            switch event {","            case .pathChanged(let old, let new):","                Log.debug(\"flow path: \\(old) -> \\(new)\")","            case .intentRejected(let intent, let reason):","                Log.info(\"flow rejected \\(intent): \\(reason)\")","            case .navigation(let event):","                Log.debug(\"navigation event: \\(event)\")","            case .modal(let event):","                Log.debug(\"modal event: \\(event)\")","            }","        }","    )",")"],"type":"codeListing"},{"inlineContent":[{"text":"In 5.0, each store configuration has one typed ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" callback.","type":"text"},{"text":" ","type":"text"},{"text":"Remove the former per-case callback arguments and switch over the","type":"text"},{"text":" ","type":"text"},{"text":"matching event enum instead. The flow-level callback also receives","type":"text"},{"text":" ","type":"text"},{"text":"the inner navigation and modal events as wrapped cases; callbacks","type":"text"},{"text":" ","type":"text"},{"text":"already installed on the two legacy configurations still receive","type":"text"},{"text":" ","type":"text"},{"text":"their direct ","type":"text"},{"code":"NavigationEvent","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"ModalEvent","type":"codeVoice"},{"text":" values.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"4. Handle the two new invariant-violation paths","anchor":"4-Handle-the-two-new-invariant-violation-paths"},{"inlineContent":[{"code":"FlowStore","type":"codeVoice"},{"text":" rejects intents that would violate its invariants:","type":"text"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Intent situation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Reason emitted","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".push","type":"codeVoice"},{"text":" while a modal tail is active","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":".pushBlockedByModalTail","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".reset([.sheet, .push])","type":"codeVoice"},{"text":" (modal not at tail)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":".invalidResetPath","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Any intent cancelled by middleware","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":".middlewareRejected(debugName:)","type":"codeVoice"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"Subscribe to ","type":"text"},{"code":"flow.events","type":"codeVoice"},{"text":" or handle ","type":"text"},{"code":".intentRejected","type":"codeVoice"},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"text":"configuration’s ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" closure. The legacy","type":"text"},{"text":" ","type":"text"},{"text":"stores never had this signal; before the migration, a push attempt","type":"text"},{"text":" ","type":"text"},{"text":"during a sheet presentation silently no-opped or tripped up the","type":"text"},{"text":" ","type":"text"},{"text":"app in subtle ways.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"5. Adopt `apply(_:)` for deep links and restoration","anchor":"5-Adopt-apply-for-deep-links-and-restoration"},{"inlineContent":[{"code":"FlowPlan<R>.steps","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"[RouteStep<R>]","type":"codeVoice"},{"text":", so once your routes opt","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["extension AppRoute: Codable {}"],"type":"codeListing"},{"inlineContent":[{"code":"StatePersistence<AppRoute>","type":"codeVoice"},{"text":" round-trips the whole flow state:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let persistence = StatePersistence<AppRoute>()","","\/\/ On app background","try persistence.encode(FlowPlan(steps: flow.path)).write(to: url)","","\/\/ On launch","if let data = try? Data(contentsOf: url) {","    flow.apply(try persistence.decode(data))","}"],"type":"codeListing"},{"inlineContent":[{"text":"Deep-link resolvers can emit a ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" directly and hand it to","type":"text"},{"text":" ","type":"text"},{"code":"flow.apply(_:)","type":"codeVoice"},{"text":" to hydrate a push + sheet terminal URL in one","type":"text"},{"text":" ","type":"text"},{"text":"atomic step.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"text":"6. Migrate tests incrementally","anchor":"6-Migrate-tests-incrementally"},{"inlineContent":[{"code":"NavigationTestStore","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ModalTestStore","type":"codeVoice"},{"text":" remain available, so tests that","type":"text"},{"text":" ","type":"text"},{"text":"infer their event types can keep the same test-store setup. Removed event","type":"text"},{"text":" ","type":"text"},{"text":"typealiases do not preserve explicit annotations: migrate those annotations to","type":"text"},{"text":" ","type":"text"},{"code":"NavigationEvent<R>","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"ModalEvent<M>","type":"codeVoice"},{"text":", and use ","type":"text"},{"code":"FlowEvent<R>","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"text":". Re-home the highest-value scenarios onto ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"text":"you get a chance — a single ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"text":" subscription asserts both","type":"text"},{"text":" ","type":"text"},{"text":"navigation and modal emissions in the same FIFO queue, which usually","type":"text"},{"text":" ","type":"text"},{"text":"compresses a 40-line legacy test into 15 lines.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Rollback story","anchor":"Rollback-story"},{"inlineContent":[{"text":"The migration is per-flow. Any screen tree that still uses the","type":"text"},{"text":" ","type":"text"},{"text":"nested host pair continues to build. ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":" lives alongside","type":"text"},{"text":" ","type":"text"},{"code":"ModalHost","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":"; adopting one doesn’t remove the","type":"text"},{"text":" ","type":"text"},{"text":"others. Incremental migration by flow (onboarding, settings,","type":"text"},{"text":" ","type":"text"},{"text":"checkout, …) is supported.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Next steps","anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},{"text":" to see a greenfield flow","type":"text"},{"text":" ","type":"text"},{"text":"composed with ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Read the ","type":"text"},{"code":"Tutorial-TestingFlows","type":"codeVoice"},{"text":" guide in the","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":" documentation catalog for the full host-less","type":"text"},{"text":" ","type":"text"},{"text":"test harness story.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"See the ","type":"text"},{"type":"strong","inlineContent":[{"code":"send(_:)","type":"codeVoice"},{"text":" vs ","type":"text"},{"code":"execute(_:)","type":"codeVoice"},{"text":" — picking the right entry","type":"text"},{"text":" ","type":"text"},{"text":"point","type":"text"}]},{"text":" section of the README for guidance on choosing among","type":"text"},{"text":" ","type":"text"},{"code":"send","type":"codeVoice"},{"text":", ","type":"text"},{"code":"execute","type":"codeVoice"},{"text":", ","type":"text"},{"code":"executeBatch","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"executeTransaction","type":"codeVoice"},{"text":" once","type":"text"},{"text":" ","type":"text"},{"text":"the flow is migrated.","type":"text"}],"type":"paragraph"}]}]}]}],"metadata":{"title":"Migrating from Nested Hosts to `FlowHost`","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"type":"text","text":"Replace manually composed "},{"code":"ModalHost { NavigationHost { ... } }","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"surfaces with a single "},{"code":"FlowHost","type":"codeVoice"},{"type":"text","text":" backed by "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":". Preserve"},{"type":"text","text":" "},{"type":"text","text":"existing "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" configurations while"},{"type":"text","text":" "},{"type":"text","text":"unlocking a serializable "},{"code":"[RouteStep<R>]","type":"codeVoice"},{"type":"text","text":" path and"},{"type":"text","text":" "},{"code":"FlowStore.apply(_:)","type":"codeVoice"},{"type":"text","text":" for restoration + deep-link hydration."}],"kind":"article","references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","abstract":[],"role":"collection","kind":"symbol","title":"InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","type":"topic","abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"code":"FlowStore","type":"codeVoice"},{"text":", then let the signup ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}],"role":"article","kind":"article","title":"Building a Login Onboarding Flow"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"kind":"article"}}}