":"paragraph"}]},{"content":[{"inlineContent":[{"text":"fail-fast environment behavior catches host wiring mistakes at runtime","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"multi-host trees can keep separate routing authorities in the same hierarchy","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Host-scoping-and-authority-replacement","level":3,"text":"Host scoping and authority replacement","type":"heading"},{"inlineContent":[{"text":"Each ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"advanced store-backed host publishes one route-typed authority to its own view","type":"text"},{"text":" ","type":"text"},{"text":"subtree. SwiftUI environment value semantics keep sibling hosts independent.","type":"text"},{"text":" ","type":"text"},{"text":"When a nested host uses the same ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" type, it replaces the complete","type":"text"},{"text":" ","type":"text"},{"text":"authority for that subtree instead of merging capabilities from two stores.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This replacement prevents an inner stack-only host from accidentally driving","type":"text"},{"text":" ","type":"text"},{"text":"an outer modal or flow authority. Different route types can coexist in one","type":"text"},{"text":" ","type":"text"},{"text":"subtree; views declare one ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":" property for each route type","type":"text"},{"text":" ","type":"text"},{"text":"they use. The registration and storage types are implementation details, so","type":"text"},{"text":" ","type":"text"},{"text":"cus