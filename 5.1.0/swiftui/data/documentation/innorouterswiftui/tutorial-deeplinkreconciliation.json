{"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Scenario","text":"Scenario","type":"heading"},{"inlineContent":[{"code":"myapp:\/\/app\/order\/42","type":"codeVoice"},{"text":" should land the user on the order detail for","type":"text"},{"text":" ","type":"text"},{"text":"order 42, but only when they’re signed in. If the link arrives","type":"text"},{"text":" ","type":"text"},{"text":"while signed out, the app must remember it, route through the","type":"text"},{"text":" ","type":"text"},{"text":"sign-in flow, and then replay it — without dropping the original","type":"text"},{"text":" ","type":"text"},{"text":"URL context.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This tutorial intentionally uses an externally owned ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"deep-link effect handler must apply plans outside the SwiftUI host. A local","type":"text"},{"text":" ","type":"text"},{"text":"single-route feature should start with ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"@DeepLink","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which installs incoming-URL handling automatically. Promote to this shape when","type":"text"},{"text":" ","type":"text"},{"text":"authentication, pending replay, multi-step plans, restoration, or direct","type":"text"},{"text":" ","type":"text"},{"text":"effect-handler ownership needs the authority.","type":"text"}]},{"text":"Modeling the routes","type":"heading","level":2,"anchor":"Modeling-the-routes"},{"code":["\/\/ This host-independent excerpt uses plain Route conformance. Add @Router and","\/\/ a destination property when this same enum also owns SwiftUI rendering.","enum AppRoute: Route {","    case home","    case signIn","    case order(id: String)","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"anchor":"Wiring-the-pipeline","level":2,"text":"Wiring the pipeline","type":"heading"},{"inlineContent":[{"code":"DeepLinkPipeline","type":"codeVoice"},{"text":" owns the validate-then-match-then-authorize flow. Pass the","type":"text"},{"text":" ","type":"text"},{"text":"matcher directly so matcher input-limit failures remain typed rejections:","type":"text"}],"type":"paragraph"},{"code":["import Synchronization","","let authentication = Mutex(false)","let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/home\") { _ in .home }","    DeepLinkMapping(\"\/signin\") { _ in .signIn }","    DeepLinkMapping(\"\/order\/:id\") { parameters in","        guard let id = parameters.firstValue(forName: \"id\") else { return nil }","        return .order(id: id)","    }","}","","let policy = DeepLinkAuthenticationPolicy<AppRoute>.required(","    shouldRequireAuthentication: { route in","        if case .order = route { return true }","        return false","    },","    isAuthenticated: { authentication.withLock { $0 } }",")","","let pipeline = DeepLinkPipeline(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    matcher: matcher,","    authenticationPolicy: policy",")"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"text":"Handling a URL","type":"heading","level":2,"anchor":"Handling-a-URL"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"DeepLinkEffectHandler","type":"codeVoice"},{"text":" bridges the pipeline output into","type":"text"},{"text":" ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["let store = NavigationStore<AppRoute>()","let effectHandler = DeepLinkEffectHandler(","    navigator: store,","    matcher: matcher,","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    authenticationPolicy: policy",")","","func handle(_ url: URL) {","    switch effectHandler.handle(url) {","    case .executed:","        break \/\/ The validated NavigationPlan has already been applied.","    case .executionFailed(_, let batch):","        Log.warning(\"deep-link batch failed after \\(batch.executedCommands.count) attempted commands\")","    case .pending:","        _ = store.execute(.push(.signIn))","    case .applicationRejected(_, let failure):","        Log.warning(\"deep-link plan rejected: \\(failure)\")","    case .rejected(let reason):","        Log.warning(\"deep link rejected: \\(reason)\")","    case .unhandled(let url):","        Log.warning(\"deep link unhandled: \\(url)\")","    case .invalidURL, .missingDeepLinkURL, .noPendingDeepLink:","        break","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"text":"Replaying after sign-in","type":"heading","level":2,"anchor":"Replaying-after-sign-in"},{"type":"paragraph","inlineContent":[{"text":"Once the user signs in, the handler resumes any queued deep link:","type":"text"}]},{"code":["func userDidSignIn() {","    authentication.withLock { $0 = true }","    _ = effectHandler.resumePendingDeepLink()","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"The handler consults the retained ","type":"text"},{"code":"PendingDeepLink","type":"codeVoice"},{"text":", re-evaluates","type":"text"},{"text":" ","type":"text"},{"text":"the authentication policy, and only commits the batch if the new","type":"text"},{"text":" ","type":"text"},{"text":"state now permits the original URL. Any stale pending link (one","type":"text"},{"text":" ","type":"text"},{"text":"the user cancelled or that no longer validates) is dropped.","type":"text"}]},{"text":"Observing the reconciliation","type":"heading","level":2,"anchor":"Observing-the-reconciliation"},{"type":"paragraph","inlineContent":[{"code":"NavigationStore.events","type":"codeVoice"},{"text":" exposes the full sequence of batch +","type":"text"},{"text":" ","type":"text"},{"text":"path-mismatch events as a single stream, which is handy for","type":"text"},{"text":" ","type":"text"},{"text":"diagnostics dashboards. Capture the stream before starting its lifecycle-owned","type":"text"},{"text":" ","type":"text"},{"text":"task so the subscriber is registered before any immediate reconciliation","type":"text"},{"text":" ","type":"text"},{"text":"command:","type":"text"}]},{"code":["let events = store.events","let observationTask = Task { @MainActor in","    for await event in events {","        switch event {","        case .batchExecuted(let result):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .pathMismatch(let event):","            analytics.track(\"deep_link_mismatch\", [","                \"policy\": event.policy.rawValue,","                \"old\": event.oldPath.map(String.init(describing:)),","                \"new\": event.newPath.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"text":"Testing the chain","type":"heading","level":2,"anchor":"Testing-the-chain"},{"type":"paragraph","inlineContent":[{"code":"NavigationTestStore","type":"codeVoice"},{"text":" (in ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":") asserts the batch +","type":"text"},{"text":" ","type":"text"},{"text":"side effects for each branch:","type":"text"}]},{"code":["@Test","@MainActor","func signedOutDeepLinkDefersUntilSignIn() {","    let store = NavigationTestStore<AppRoute>()","    let handler = DeepLinkEffectHandler(","        navigator: store.store,","        matcher: matcher,","        authenticationPolicy: policy","    )","","    let result = handler.handle(URL(string: \"myapp:\/\/app\/order\/42\")!)","","    #expect(result == .pending(handler.pendingDeepLink!))","    #expect(store.state.path.isEmpty)","    store.finish()","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"anchor":"Next-steps","text":"Next steps","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","isActive":true,"type":"reference"},{"text":" for how the sign-in flow that","type":"text"},{"text":" ","type":"text"},{"text":"replays this deep link is modelled.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts","type":"reference","isActive":true},{"text":" if the existing app","type":"text"},{"text":" ","type":"text"},{"text":"still uses ","type":"text"},{"code":"ModalHost { NavigationHost { ... } }","type":"codeVoice"},{"text":" pairs.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article","title":"Reconciling Deep Links End-to-End"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"type":"text","text":"Match a URL, apply an authentication policy, and produce a"},{"text":" ","type":"text"},{