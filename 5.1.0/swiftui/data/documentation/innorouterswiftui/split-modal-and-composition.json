{"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/innorouterswiftui\/split-modal-and-composition"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"abstract":[{"text":"Choose one macro-first host for the local surface. ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" unify stack and modal actions, "},{"code":"RouterModalHost","type":"codeVoice"},{"text":" narrows a","type":"text"},{"text":" ","type":"text"},{"text":"feature to modal actions, and ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"text":" owns native tab state.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Externally owned stores and coordinator hosts remain advanced authorities."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Split navigation","anchor":"Split-navigation"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"text":" for a macro-first sidebar\/detail layout. It owns the","type":"text"},{"text":" ","type":"text"},{"text":"detail stack and modal authority locally, builds destinations from the","type":"text"},{"text":" ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" enum, and exposes both through ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["RouterSplitHost(AppRoute.self) {","    SidebarView()","} root: {","    ContentUnavailableView(\"Select an item\", systemImage: \"sidebar.left\")","}"]},{"type":"paragraph","inlineContent":[{"text":"All stack and modal actions pass through the same ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", so a push is","type":"text"},{"text":" ","type":"text"},{"text":"still rejected while a modal route is the flow tail. Use","type":"text"},{"text":" ","type":"text"},{"code":"NavigationSplitHost","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"CoordinatorSplitHost","type":"codeVoice"},{"text":" when the application must own","type":"text"},{"text":" ","type":"text"},{"text":"an advanced stack-only authority directly.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Important scope boundary:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"RouterSplitHost","type":"codeVoice"},{"text":" owns the detail stack and modal authority","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"advanced split hosts own only the detail stack","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"sidebar selection remains app-owned","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"column visibility remains system-managed","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"compact adaptation remains system-managed","type":"text"}]}]}]},{"inlineContent":[{"text":"This keeps shell state out of the stack authority.","type":"text"}],"type":"paragraph"},{"style":"note","type":"aside","name":"Platform","content":[{"inlineContent":[{"text":"","type":"text"},{"code":"NavigationSplitHost","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"CoordinatorSplitHost","type":"codeVoice"},{"text":" are ","type":"text"},{"type":"strong","inlineContent":[{"text":"unavailable on watchOS","type":"text"}]},{"text":" ","type":"text"},{"text":"because SwiftUI’s ","type":"text"},{"code":"NavigationSplitView","type":"codeVoice"},{"text":" is unavailable there. watchOS apps should fall back","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"CoordinatorHost","type":"codeVoice"},{"text":" in the ","type":"text"},{"code":"#else","type":"codeVoice"},{"text":" branch of a","type":"text"},{"text":" ","type":"text"},{"code":"#if !os(watchOS)","type":"codeVoice"},{"text":" check.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"RouterSplitHost","type":"codeVoice"},{"text":" remains visible to watchOS callers as an explicitly","type":"text"},{"text":" ","type":"text"},{"text":"unavailable declaration, whose compiler diagnostic directs macro-first code","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"type":"heading","level":2,"text":"Modal navigation","anchor":"Modal-navigation"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":" when a feature needs only sheet and cover presentation:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["RouterModalHost(AppRoute.self) {","    ModalLauncher()","}"],"type":"codeListing"},{"inlineContent":[{"text":"Descendants use the same typed environment router as every other macro-first","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"surface:"}],"type":"paragraph"},{"code":["@EnvironmentRouter(AppRoute.self) private var router","","Button(\"Edit\") {","    router.sheet(.editor)","}","","Button(\"Preview\") {","    router.cover(.preview)","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"code":"RouterModalHost","type":"codeVoice"},{"text":" owns its ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" locally and publishes only modal","type":"text"},{"type":"text","text":" "},{"type":"text","text":"capability. An accidental "},{"type":"codeVoice","code":"go"},{"type":"text","text":" call therefore reports a missing navigation"},{"type":"text","text":" "},{"type":"text","text":"capability instead of silently inventing a stack."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" with "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" when restoration, middleware management, or"},{"type":"text","text":" "},{"type":"text","text":"direct observation requires the application to own the modal authority."}],"type":"paragraph"},{"inlineContent":[{"text":"On iOS and tvOS, ","type":"text"},{"code":"ModalHost","type":"codeVoice"},{"text":" uses native ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"fullScreenCover","type":"codeVoice"},{"text":" presentation.","type":"text"},{"text":" ","type":"text"},{"text":"On other supported platforms, ","type":"text"},{"code":"fullScreenCover","type":"codeVoice"},{"text":" requests degrade to ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The advanced modal authority intentionally stays separate from a stack-only","type":"text"},{"text":" ","type":"text"},{"text":"authority:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"modal intent uses "},{"type":"codeVoice","code":"ModalIntent"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"stack intent uses "},{"type":"codeVoice","code":"NavigationIntent"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"modal queue state lives in "},{"type":"codeVoice","code":"ModalStore"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"stack state lives in ","type":"text"},{"code":"NavigationStore","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Modal queue rules are intentionally small:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"present","type":"codeVoice"},{"text":" shows immediately when no modal is active.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"present","type":"codeVoice"},{"text":" appends to ","type":"text"},{"code":"queuedPresentations","type":"codeVoice"},{"text":" when another modal is","type":"text"},{"text":" ","type":"text"},{"text":"active.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"dismissCurrent","type":"codeVoice"},{"text":" dismisses the active modal and promotes the first","type":"text"},{"text":" ","type":"text"},{"text":"queued presentation, if one exists.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"dismissAll","type":"codeVoice"},{"text":" clears both the active modal and the queue.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"replaceCurrent","type":"codeVoice"},{"text":" swaps only the active presentation and leaves the","type":"text"},{"text":" ","type":"text"},{"text":"queue untouched; observers receive ","type":"text"},{"code":".replaced","type":"codeVoice"},{"text":" before the command","type":"text"},{"text":" ","type":"text"},{"text":"interception event.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"code":"dismissCurrent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"dismissAll","type":"codeVoice"},{"text":" attempts enter modal middleware even when","type":"text"},{"text":" ","type":"text"},{"text":"there is no active presentation or queue. The resulting command can remain a","type":"text"},{"text":" ","type":"text"},{"text":"no-op, be cancelled, or be rewritten by middleware; this matches direct","type":"text"},{"text":" ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" execution instead of hiding empty-state attempts in ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Every convenience mutator reports its effective outcome as a","type":"text"},{"text":" ","type":"text"},{"code":"@discardableResult","type":"codeVoice"},{"text":": ","type":"text"},{"code":"present","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"ModalPresentResult","type":"codeVoice"},{"text":", while","type":"text"},{"text":" ","type":"text"},{"code":"replaceCurrent","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dismissCurrent","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"dismissAll","type":"codeVoice"},{"text":" return the same","type":"text"},{"text":" ","type":"text"},{"code":"ModalExecutionResult","type":"codeVoice"},{"text":" that ","type":"text"},{"code":"execute(_:)","type":"codeVoice"},{"text":" produces. Callers can branch on a","type":"text"},{"text":" ","type":"text"},{"text":"middleware cancellation or an empty-state ","type":"text"},{"code":".noop","type":"codeVoice"},{"text":" directly at the call site","type":"text"},{"text":" ","type":"text"},{"text":"instead of subscribing to the event stream; call sites that ignore the","type":"text"},{"text":" ","type":"text"},{"text":"result compile unchanged.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When middleware cancels a FlowStore modal preview, the captured participants","type":"text"},{"text":" ","type":"text"},{"text":"still receive ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":", observers receive ","type":"text"},{"code":".commandIntercepted","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"ModalQueueCancellationPolicy","type":"codeVoice"},{"text":" is applied to the preview state. If that policy","type":"text"},{"text":" ","type":"text"},{"text":"changes the live queue, ","type":"text"},{"code":".queueChanged","type":"codeVoice"},{"text":" is delivered before the interception","type":"text"},{"text":" ","type":"text"},{"text":"and flow-level rejection. During an atomic reset, a cancellation previewed from","type":"text"},{"text":" ","type":"text"},{"text":"an intermediate shadow is finalized with the actual live state that survived","type":"text"},{"text":" ","type":"text"},{"text":"rollback. Successful navigation and modal previews that preceded that","type":"text"},{"text":" ","type":"text"},{"text":"cancellation stay off the public ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" path and run their package-owned","type":"text"},{"text":" ","type":"text"},{"text":"discard cleanup instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"alert","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"confirmationDialog","type":"codeVoice"},{"text":" stay outside this framework surface and should remain feature-owned state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"ModalStoreConfiguration","type":"codeVoice"},{"text":" uses one ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" callback for the complete","type":"text"},{"text":" ","type":"text"},{"text":"modal observation surface:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let configuration = ModalStoreConfiguration<AppRoute>(","    onEvent: { event in","        switch event {","        case .presented(let presentation):","            analytics.recordPresented(presentation)","        case .dismissed(let presentation, let reason):","            analytics.recordDismissed(presentation, reason: reason)","        case .replaced(let old, let new):","            analytics.recordReplacement(from: old, to: new)","        case .queueChanged(let old, let new):","            diagnostics.recordQueueChange(from: old, to: new)","        case .commandIntercepted(let command, let result):","            diagnostics.record(command, result: result)","        case .middlewareMutation(let mutation):","            diagnostics.record(mutation)","        }","    }",")"],"type":"codeListing"},{"inlineContent":[{"text":"When migrating to 5.0, merge the former modal lifecycle closures into","type":"text"},{"text":" ","type":"text"},{"text":"this switch. ","type":"text"},{"code":"ModalStore.events","type":"codeVoice"},{"text":" emits the same cases asynchronously.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"@DeepLink","type":"codeVoice"},{"text":" does not choose a modal presentation style. Automatic URL handling","type":"text"},{"text":" ","type":"text"},{"text":"pushes through ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"text":" or selects through","type":"text"},{"text":" ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"text":"; an application that needs a URL to open a sheet or cover must","type":"text"},{"text":" ","type":"text"},{"text":"apply that policy at its flow boundary.","type":"text"}],"type":"paragraph"},{"anchor":"Composition","text":"Composition","level":2,"type":"heading"},{"inlineContent":[{"text":"The recommended composition rules are:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Choose exactly one local macro-first authority for a route type in a","type":"text"},{"text":" ","type":"text"},{"text":"subtree: ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Put shell state such as tabs or app mode outside feature-local routing.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use distinct route types for nested authorities that must remain","type":"text"},{"text":" ","type":"text"},{"text":"independent.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Promote to ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ModalHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":", or a coordinator host","type":"text"},{"text":" ","type":"text"},{"text":"only when the application owns that state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Keep feature-local routing inside the destination that owns it.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"Do not wrap ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":" for the same route type:","type":"text"},{"text":" ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" already owns both capabilities, and a nested same-route host","type":"text"},{"text":" ","type":"text"},{"text":"replaces the outer authority for its subtree. These rules keep each authority","type":"text"},{"text":" ","type":"text"},{"text":"narrow without creating one application-wide store.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"sections":[],"kind":"article","metadata":{"title":"Split, modal, and composition patterns","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Split-Modal-and-Composition"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"kind":"article"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","abstract":[],"role":"collection","kind":"symbol","title":"InnoRouterTesting"}}}