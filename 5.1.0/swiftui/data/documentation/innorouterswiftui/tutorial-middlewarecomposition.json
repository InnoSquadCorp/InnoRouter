{"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"abstract":[{"text":"Install logging, entitlement gating, and analytics middleware on","type":"text"},{"text":" ","type":"text"},{"text":"both ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":". Inspect the participant","type":"text"},{"text":" ","type":"text"},{"text":"discipline that pairs completion callbacks with the middlewares","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"code":"willExecute","type":"codeVoice"},{"text":" hook actually ran.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Scenario","type":"heading","anchor":"Scenario","level":2},{"type":"paragraph","inlineContent":[{"text":"Every ","type":"text"},{"code":"NavigationCommand","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ModalCommand","type":"codeVoice"},{"text":" should be logged","type":"text"},{"text":" ","type":"text"},{"text":"before it executes. A feature-flagged screen must be gated behind","type":"text"},{"text":" ","type":"text"},{"text":"an entitlement check. An analytics call must fire after an","type":"text"},{"text":" ","type":"text"},{"text":"execution attempt finishes — but only for middlewares that actually","type":"text"},{"text":" ","type":"text"},{"text":"participated in the ","type":"text"},{"code":"willExecute","type":"codeVoice"},{"text":" decision.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This tutorial starts at the externally owned-store tier because middleware is","type":"text"},{"text":" ","type":"text"},{"text":"installed when the authority is created. A self-contained stack without custom","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"policy should use "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" + "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" instead."}]},{"text":"Modeling routes","type":"heading","anchor":"Modeling-routes","level":2},{"syntax":"swift skip doc-fragment","code":["enum AppRoute: Route {","    case home","    case premiumDetail","    case paywall","}"],"type":"codeListing"},{"type":"heading","level":2,"text":"Logging middleware","anchor":"Logging-middleware"},{"type":"paragraph","inlineContent":[{"text":"Reuse the ","type":"text"},{"code":"AnyNavigationMiddleware","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"AnyModalMiddleware","type":"codeVoice"},{"text":" ","type":"text"},{"text":"closure initializers so a minimal shared logger composes without","type":"text"},{"text":" ","type":"text"},{"text":"boilerplate:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@MainActor","func loggingNavigationMiddleware() -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(","        willExecute: { command, _ in","            Log.debug(\"navigation command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, result, _ in","            Log.debug(\"navigation finished: \\(command) -> \\(result)\")","            return result","        }","    )","}","","@MainActor","func loggingModalMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(","        willExecute: { command, _, _ in","            Log.debug(\"modal command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, _, _ in","            Log.debug(\"modal finished: \\(command)\")","        }","    )","}"]},{"text":"Entitlement gating","type":"heading","level":2,"anchor":"Entitlement-gating"},{"type":"paragraph","inlineContent":[{"text":"The gate is itself a middleware; denying a command is just","type":"text"},{"text":" ","type":"text"},{"text":"returning ","type":"text"},{"code":".cancel(reason)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@MainActor","func entitlementGateNavigation(hasPremium: @escaping @MainActor () -> Bool) -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(willExecute: { command, _ in","        guard case .push(.premiumDetail) = command, !hasPremium() else {","            return .proceed(command)","        }","        return .cancel(.middleware(debugName: \"entitlement-gate\", command: command))","    })","}"]},{"inlineContent":[{"text":"The cancellation surfaces through","type":"text"},{"text":" ","type":"text"},{"code":"ModalStoreConfiguration.onEvent","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":".commandIntercepted(_, .cancelled(...))","type":"codeVoice"},{"text":" and through","type":"text"},{"text":" ","type":"text"},{"code":"FlowRejectionReason.middlewareRejected(debugName: \"entitlement-gate\")","type":"codeVoice"},{"text":" ","type":"text"},{"text":"when used from ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Wiring it all","type":"heading","level":2,"anchor":"Wiring-it-all"},{"code":["let navStore = NavigationStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingNavigationMiddleware(), debugName: \"logging\"),","            .init(middleware: entitlementGateNavigation(hasPremium: { EntitlementStore.shared.hasPremium }), debugName: \"entitlement-gate\"),","        ]","    )",")","","let modalStore = ModalStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingModalMiddleware(), debugName: \"logging\"),","        ]","    )",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"text":"Participant discipline","type":"heading","level":2,"anchor":"Participant-discipline"},{"type":"paragraph","inlineContent":[{"text":"When a middleware cancels a command, every middleware whose","type":"text"},{"text":" ","type":"text"},{"code":"willExecute","type":"codeVoice"},{"text":" hook ran is a participant, including the cancelling","type":"text"},{"text":" ","type":"text"},{"text":"middleware itself. Middleware later in the chain did not run and","type":"text"},{"text":" ","type":"text"},{"text":"therefore receives no completion callback.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"That guarantee is why the logger safely appears ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"text":" the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"entitlement gate — the logger’s "},{"type":"codeVoice","code":"didExecute"},{"text":" fires even if the","type":"text"},{"text":" ","type":"text"},{"text":"gate cancels, so the cancellation is still recorded. Reordering","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"type":"codeVoice","code":"[entitlement-gate, logging]"},{"type":"text","text":" would skip the logger’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" on cancellation."}]},{"type":"paragraph","inlineContent":[{"text":"For direct and batch ","type":"text"},{"code":".whenCancelled","type":"codeVoice"},{"text":" execution, ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"attempt-level: it can run for a leg whose ","type":"text"},{"code":"RouteStack","type":"codeVoice"},{"type":"text","text":" change is"},{"type":"text","text":" "},{"type":"text","text":"later discarded. Use the aggregate result and "},{"code":".changed","type":"codeVoice"},{"type":"text","text":" event to"},{"type":"text","text":" "},{"text":"observe durable state. Transactions instead keep ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"commit-only; its returned fold can change reporting after commit but"},{"text":" ","type":"text"},{"type":"text","text":"cannot roll back the transaction."}]},{"type":"heading","level":2,"text":"Observing a cancellation end-to-end","anchor":"Observing-a-cancellation-end-to-end"},{"type":"paragraph","inlineContent":[{"code":"ModalStore.events","type":"codeVoice"},{"text":" surfaces ","type":"text"},{"code":".commandIntercepted(.cancelled(...))","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"while a direct "},{"code":"NavigationStore.execute(_:)","type":"codeVoice"},{"type":"text","text":" cancellation is returned"},{"text":" ","type":"text"},{"text":"as ","type":"text"},{"code":"NavigationResult.cancelled","type":"codeVoice"},{"text":"; a path-reconciliation policy may","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"separately emit "},{"code":".pathMismatch","type":"codeVoice"},{"text":". For a ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" in particular,","type":"text"},{"type":"text","text":" "},{"code":"FlowStore.events","type":"codeVoice"},{"type":"text","text":" wraps both in "},{"code":".navigation(...)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".modal(...)","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"cases so one subscriber sees the whole picture. Capture the stream before"},{"type":"text","text":" "},{"text":"starting its lifecycle-owned task to register the subscriber synchronously.","type":"text"}]},{"code":["let events = flowStore.events","let observationTask = Task { @MainActor in","    for await event in events {","        if case .modal(.commandIntercepted(_, .cancelled(let reason))) = event {","            Log.info(\"modal cancelled: \\(reason)\")","        }","        if case .intentRejected(_, .middlewareRejected(let name)) = event {","            Log.info(\"flow intent rejected by: \\(name ?? \"nil\")\")","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"level":2,"type":"heading","text":"Testing middleware with FlowTestStore","anchor":"Testing-middleware-with-FlowTestStore"},{"inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"text":" (in ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":") asserts the cancellation","type":"text"},{"text":" ","type":"text"},{"text":"chain without mounting SwiftUI:","type":"text"}],"type":"paragraph"},{"code":["@Test","@MainActor","func entitlementGateBlocksPremiumPush() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: entitlementGateNavigation(hasPremium: { false }), debugName: \"gate\")","            ])","        )","    )","","    store.send(.push(.premiumDetail))","","    store.receiveIntentRejected(","        intent: .push(.premiumDetail),","        reason: .middlewareRejected(debugName: \"gate\")","    )","    store.finish()","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"text":"Next steps","type":"heading","level":2,"anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},{"type":"text","text":" to see how middleware"},{"type":"text","text":" "},{"type":"text","text":"interacts with a multi-step flow plus a child coordinator."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read the "},{"type":"codeVoice","code":"Tutorial-TestingFlows"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" documentation catalog for the full host-less"},{"type":"text","text":" "},{"type":"text","text":"test harness tour."}]}]}]}],"kind":"content"}],"sections":[],"kind":"article","metadata":{"title":"Composing Middleware Across Navigation and Modal","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"kind":"article"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","type":"topic","abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"code":"FlowStore","type":"codeVoice"},{"text":", then let the signup ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}],"role":"article","kind":"article","title":"Building a Login Onboarding Flow"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","abstract":[],"role":"collection","kind":"symbol","title":"InnoRouterTesting"}}}