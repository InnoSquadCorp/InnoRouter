{"kind":"article","primaryContentSections":[{"kind":"content","content":[{"text":"Scenario","type":"heading","level":2,"anchor":"Scenario"},{"type":"paragraph","inlineContent":[{"text":"Users double-tap a “Buy” button. The first tap pushes the purchase","type":"text"},{"text":" ","type":"text"},{"text":"screen; the second should be silently dropped. Rolling that logic","type":"text"},{"text":" ","type":"text"},{"text":"into every button is noise — middleware is the right layer.","type":"text"}]},{"text":"Installation","type":"heading","level":2,"anchor":"Installation"},{"syntax":"swift skip doc-fragment","code":["let store = NavigationStore<AppRoute>(","    configuration: NavigationStoreConfiguration(","        middlewares: [","            .init(","                middleware: AnyNavigationMiddleware(","                    ThrottleNavigationMiddleware<AppRoute>(","                        interval: .milliseconds(300)","                    )","                ),","                debugName: \"throttle\"","            )","        ]","    )",")"],"type":"codeListing"},{"inlineContent":[{"text":"The default initializer uses ","type":"text"},{"code":"ContinuousClock","type":"codeVoice"},{"text":" and groups all","type":"text"},{"text":" ","type":"text"},{"text":"commands under a single global window. Within 300 ms of a previous","type":"text"},{"text":" ","type":"text"},{"text":"successfully executed command, the next one is cancelled. If the","type":"text"},{"text":" ","type":"text"},{"text":"middleware is registered with ","type":"text"},{"code":"debugName: \"throttle\"","type":"codeVoice"},{"text":", the surfaced","type":"text"},{"text":" ","type":"text"},{"text":"reason becomes ","type":"text"},{"code":".cancelled(.middleware(debugName: \"throttle\", command: …))","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Per-command-keys","level":2,"text":"Per-command keys"},{"inlineContent":[{"type":"text","text":"Group throttle windows by the command’s identity or shape:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["AnyNavigationMiddleware(","    ThrottleNavigationMiddleware<AppRoute>(interval: .milliseconds(300)) { command in","        if case .push(let route) = command {","            return \"push-\\(route)\"   \/\/ each push route gets its own window","        }","        return nil                    \/\/ other commands pass through","    }",")"]},{"inlineContent":[{"type":"text","text":"Return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to opt a command out of throttling entirely."}],"type":"paragraph"},{"anchor":"Testing-with-an-injected-clock","text":"Testing with an injected clock","level":2,"type":"heading"},{"inlineContent":[{"text":"The middleware is generic over ","type":"text"},{"code":"Clock","type":"codeVoice"},{"text":", so tests can drive time","type":"text"},{"text":" ","type":"text"},{"text":"deterministically:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let clock = TestClock()","let throttle = ThrottleNavigationMiddleware<AppRoute, TestClock>(","    interval: .milliseconds(300),","    clock: clock,","    key: { _ in \"all\" }",")","store.addMiddleware(AnyNavigationMiddleware(throttle), debugName: \"throttle\")","","store.send(.go(.home))","clock.advance(by: .milliseconds(50))","store.send(.go(.detail))         \/\/ cancelled — within window","","clock.advance(by: .milliseconds(400))","store.send(.go(.settings))       \/\/ accepted — beyond window"],"type":"codeListing"},{"type":"heading","level":2,"text":"Composing with `.whenCancelled`","anchor":"Composing-with-whenCancelled"},{"inlineContent":[{"type":"text","text":"A throttle cancel surfaces as "},{"code":".cancelled","type":"codeVoice"},{"type":"text","text":", so"},{"text":" ","type":"text"},{"code":".whenCancelled(primary, fallback:)","type":"codeVoice"},{"type":"text","text":" treats a throttled command the"},{"type":"text","text":" "},{"type":"text","text":"same as any other cancelled command:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["store.execute(","    .whenCancelled(","        .push(.detail),","        fallback: .push(.home)","    )",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If the throttle middleware cancels the "},{"code":".push(.detail)","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"fallback "},{"code":".push(.home)","type":"codeVoice"},{"type":"text","text":" is attempted next. "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"routes that fallback back through the full middleware chain, so a"},{"type":"text","text":" "},{"text":"global throttle key can cancel the fallback too if it still lands","type":"text"},{"text":" ","type":"text"},{"text":"inside the same throttle window. Each leg runs behind an internal","type":"text"},{"text":" ","type":"text"},{"text":"savepoint: if the fallback also fails or is cancelled, neither leg’s","type":"text"},{"text":" ","type":"text"},{"text":"partial state is committed.","type":"text"}],"type":"paragraph"},{"anchor":"Debounce","level":2,"text":"Debounce?","type":"heading"},{"inlineContent":[{"text":"Debounce semantics — “wait N ms, then fire the latest” — live in","type":"text"},{"text":" ","type":"text"},{"code":"DebouncingNavigator","type":"codeVoice"},{"text":", not in ","type":"text"},{"code":"NavigationCommand","type":"codeVoice"},{"text":". That keeps the","type":"text"},{"type":"text","text":" "},{"text":"engine synchronous while the async wrapper owns the timer,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"cancellation, and "},{"code":"Clock","type":"codeVoice"},{"type":"text","text":" injection needed for deterministic tests."},{"text":" ","type":"text"},{"type":"text","text":"Use throttle middleware for synchronous “reject too soon” behavior"},{"type":"text","text":" "},{"text":"and ","type":"text"},{"code":"DebouncingNavigator","type":"codeVoice"},{"text":" for delayed “latest wins” behavior.","type":"text"}],"type":"paragraph"},{"anchor":"Next-steps","level":2,"text":"Next steps","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/NavigationStore-and-Hosts","type":"reference","isActive":true},{"type":"text","text":" for the typed "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" callback and"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore.events"},{"text":" stream that expose throttle cancellations.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"See ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","isActive":true},{"text":" for the broader","type":"text"},{"text":" ","type":"text"},{"text":"middleware composition story (logging, entitlement gating,","type":"text"},{"text":" ","type":"text"},{"text":"analytics).","type":"text"}],"type":"paragraph"}]}]}]}],"abstract":[{"text":"Rate-limit navigation commands without threading timestamps through","type":"text"},{"type":"text","text":" "},{"type":"text","text":"every call site. "},{"code":"ThrottleNavigationMiddleware","type":"codeVoice"},{"text":" cancels commands that","type":"text"},{"text":" ","type":"text"},{"text":"arrive within a minimum interval of a previously accepted command","type":"text"},{"text":" ","type":"text"},{"text":"sharing the same key.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-throttling"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/d