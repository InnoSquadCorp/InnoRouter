{"metadata":{"title":"State Persistence and Restoration","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"primaryContentSections":[{"content":[{"text":"Overview","level":2,"type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"InnoRouter models a running flow as a single value (","type":"text"},{"code":"FlowPlan<R>","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"RouteStack<R>","type":"codeVoice"},{"text":"). When both the routes (","type":"text"},{"code":"R","type":"codeVoice"},{"text":") and the containing types","type":"text"},{"text":" ","type":"text"},{"text":"are ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", the entire state can round-trip through JSON. That is","type":"text"},{"text":" ","type":"text"},{"text":"enough for state restoration, deep-link payloads, and offline replay.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"StatePersistence<R>","type":"codeVoice"},{"text":" bundles a ","type":"text"},{"code":"JSONEncoder","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"JSONDecoder","type":"codeVoice"},{"text":" so","type":"text"},{"text":" ","type":"text"},{"text":"call sites don’t have to redeclare them:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let persistence = StatePersistence<AppRoute>()","","\/\/ At checkpoint time (e.g. scene will deactivate):","let plan = try FlowPlan(validating: flowStore.path)","let data = try persistence.encode(plan)","try data.write(to: restorationURL, options: .atomic)","","\/\/ At launch time:","if let data = try? Data(contentsOf: restorationURL) {","    let restored = try persistence.decode(data)","    flowStore.apply(restored)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI apps can wrap the value-level helper with"},{"type":"text","text":" "},{"type":"codeVoice","code":"StateRestorationAdapter"},{"type":"text","text":" from "},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let adapter = StateRestorationAdapter<AppRoute> { failure in","    diagnostics.record(failure)","}","","try adapter.snapshotNavigationStack(from: navigationStore)","_ = adapter.restoreFlowPlan(from: data, into: flowStore)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The adapter supports navigation-stack and flow-plan snapshots. Decode"},{"type":"text","text":" "},{"type":"text","text":"or apply failures are reported through the restoration failure callback"},{"type":"text","text":" "},{"type":"text","text":"and leave the existing store state untouched instead of falling back to"},{"type":"text","text":" "},{"type":"text","text":"an empty path."}]},{"text":"Validation on decode","level":2,"type":"heading","anchor":"Validation-on-decode"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" always satisfies the FlowStore invariants:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"At most one modal step."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A modal step only at the tail of "},{"type":"codeVoice","code":"steps"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"All other steps are "},{"type":"codeVoice","code":".push"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowPlan(validating:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FlowPlan.validate(_:)"},{"type":"text","text":" enforce these"},{"type":"text","text":" "},{"type":"text","text":"invariants up front and throw "},{"type":"codeVoice","code":"FlowPlanValidationError"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"text","text":"violation. Codable decode runs the same validator and converts a"},{"type":"text","text":" "},{"type":"text","text":"violation into "},{"type":"codeVoice","code":"DecodingError.dataCorruptedError"},{"type":"text","text":", so a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" round-tripped through disk or network can no longer"},{"type":"text","text":" "},{"type":"text","text":"silently produce a value that "},{"type":"codeVoice","code":"apply(_:)"},{"type":"text","text":" will reject later. If"},{"type":"text","text":" "},{"type":"text","text":"the snapshot format on disk drifts (older builds, hand-edited"},{"type":"text","text":" "},{"type":"text","text":"JSON, schema migration mid-flight), the decode call surfaces the"},{"type":"text","text":" "},{"type":"text","text":"error at restoration time — not at the next user action."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The permissive "},{"type":"codeVoice","code":"FlowPlan(steps:)"},{"type":"text","text":" initializer remains available"},{"type":"text","text":" "},{"type":"text","text":"for internal builders that already trust the origin of "},{"type":"codeVoice","code":"steps"},{"type":"text","text":"."}]},{"text":"Scope","level":2,"type":"heading","anchor":"Scope"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The helper intentionally covers only the typed "},{"type":"codeVoice","code":"Data ↔ value"},{"type":"text","text":" bridge."},{"type":"text","text":" "},{"type":"text","text":"Out of scope, by design:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Where the encoded bytes live ("},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":", a file URL, iCloud,"},{"type":"text","text":" "},{"type":"text","text":"a database) — that is app policy."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"When snapshots are taken — tie the call into "},{"type":"codeVoice","code":"ScenePhase"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"UIScene"},{"type":"text","text":" lifecycle, or a custom trigger."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Version-aware migration from older snapshot formats — add a"},{"type":"text","text":" "},{"type":"text","text":"wrapper struct around "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" if the underlying routes evolve."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Selective field redaction — encode only the fragments the app is"},{"type":"text","text":" "},{"type":"text","text":"willing to persist."}],"type":"paragraph"}]}]},{"text":"Customising the encoder","level":2,"type":"heading","anchor":"Customising-the-encoder"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any "},{"type":"codeVoice","code":"JSONEncoder"},{"type":"text","text":" and "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":" are acceptable inputs. Pass a"},{"type":"text","text":" "},{"type":"text","text":"preconfigured pair to the initializer for deterministic output, date"},{"type":"text","text":" "},{"type":"text","text":"strategies, or custom key coding:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let encoder = JSONEncoder()","encoder.outputFormatting = [.sortedKeys, .prettyPrinted]","","let decoder = JSONDecoder()","decoder.dateDecodingStrategy = .iso8601","","let persistence = StatePersistence<AppRoute>(encoder: encoder, decoder: decoder)"]},{"text":"Error surface","level":2,"type":"heading","anchor":"Error-surface"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both "},{"type":"codeVoice","code":"encode(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"decode(_:)"},{"type":"text","text":" re-throw the underlying"},{"type":"text","text":" "},{"type":"codeVoice","code":"EncodingError"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"DecodingError"},{"type":"text","text":" so call sites keep the diagnostic"},{"type":"text","text":" "},{"type":"text","text":"context needed to distinguish schema drift from I\/O failures."}]}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"variants":[{"paths":["\/documentation\/innoroutercore\/tutorial-statepersistence"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"codeVoice","code":"StatePersistence"},{"text":" is a thin helper that serializes ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouteStack"},{"text":" values to ","type":"text"},{"type":"codeVoice","code":"Data"},{"text":" for launch-time restoration. It deliberately","type":"text"},{"text":" ","type":"text"},{"text":"stops at the value boundary so apps keep full control over where — and","type":"text"},{"text":" ","type":"text"},{"text":"when — snapshots are written.","type":"text"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Tutorial-StatePersistence"},"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","kind":"symbol","url":"\/documentation\/innoroutertesting","type":"topic","role":"collection","abstract":[]},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouter