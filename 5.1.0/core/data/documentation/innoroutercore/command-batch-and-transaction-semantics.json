{"metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"article","title":"Command, batch, and transaction semantics","roleHeading":"Article"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Single-command-execution","level":2,"text":"Single-command execution","type":"heading"},{"inlineContent":[{"code":"NavigationCommand","type":"codeVoice"},{"text":" models one navigation transition or a recursive command composition.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Important cases:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".push","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".pushAll","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".pop","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".popCount","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".popToRoot","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".popTo","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".replace","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".sequence","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".whenCancelled","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"code":"NavigationEngine","type":"codeVoice"},{"text":" executes these commands against a ","type":"text"},{"code":"RouteStack","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Sequence-semantics","level":2,"text":"Sequence semantics","type":"heading"},{"inlineContent":[{"code":".sequence","type":"codeVoice"},{"text":" is command algebra, not a transaction.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That means:","type":"text"}],"type":"paragraph"},{