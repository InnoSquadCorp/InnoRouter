{"sections":[],"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Matcher and diagnostics"},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"primaryContentSections":[{"content":[{"type":"heading","text":"Pattern model","anchor":"Pattern-model","level":2},{"type":"paragraph","inlineContent":[{"text":"Patterns support:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"literal segments","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"named parameters such as "},{"code":":id","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"terminal wildcard "},{"code":"*","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"This keeps matching simple and predictable for app routing.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Wildcards are terminal-only. A pattern like ","type":"text"},{"type":"codeVoice","code":"\/api\/*\/users"},{"text":" is invalid:","type":"text"},{"text":" ","type":"text"},{"text":"it produces a ","type":"text"},{"type":"codeVoice","code":".nonTerminalWildcard(pattern:index:)"},{"text":" diagnostic and does","type":"text"},{"text":" ","type":"text"},{"text":"not match runtime paths.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Captured values stay available as strings through ","type":"text"},{"type":"codeVoice","code":"firstValue(forName:)"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"values(forName:)"},{"text":". For common scalar types, use the typed overloads:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let id = parameters.firstValue(forName: \"id\", as: UUID.self)","let page = parameters.firstValue(forName: \"page\", as: Int.self)","let selectedTags = parameters.values(forName: \"tag\", as: String.self)"]},{"type":"heading","text":"Match precedence","anchor":"Match-precedence","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Match precedence remains declaration-order based."}]},{"type":"paragraph","inlineContent":[{"text":"That means:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"earlier patterns win"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"diagnostics do not change runtime behavior","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"ordering is still part of the matcher contract","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Diagnostics","anchor":"Diagnostics","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeepLinkMatcherConfiguration"},{"text":" can surface diagnostics for common authoring mistakes:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"duplicate patterns","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"wildcard shadowing"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"non-terminal wildcards"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"invalid parameter names; parameter names must match"},{"type":"text","text":" "},{"type":"codeVoice","code":"^[A-Za-z_][A-Za-z0-9_]*$"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"parameter-heavy patterns that subsume more specific later patterns","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Diagnostics are available for every matcher output. They are intended"},{"type":"text","text":" "},{"type":"text","text":"to catch ambiguous authoring early without changing the matcher’s"},{"type":"text","text":" "},{"text":"runtime semantics.","type":"text"}]},{"inlineContent":[{"type":"text","text":"For release-readiness gates, use "},{"type":"codeVoice","code":"DeepLinkMatcher(strict:)"},{"type":"text","text":" with either"},{"type":"text","text":" "},{"type":"text","text":"a route or "},{"type":"codeVoice","code":"FlowPlan<R>"},{"type":"text","text":" output. Strict initializers throw"},{"type":"text","text":" "},{"type":"codeVoice","code":"DeepLinkMatcherStrictError"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"the full diagnostic list instead of only logging warnings, and accept"},{"type":"text","text":" "},{"type":"text","text":"the same "},{"code":"DeepLinkInputLimits","type":"codeVoice"},{"type":"text","text":" guardrails used by non-strict matchers."}],"type":"paragraph"},{"level":2,"text":"Input limits","type":"heading","anchor":"Input-limits"},{"inlineContent":[{"type":"codeVoice","code":"DeepLinkInputLimits"},{"type":"text","text":" guards runtime URLs before matching. Configure it"},{"type":"text","text":" "},{"type":"text","text":"on "},{"code":"DeepLinkMatcherConfiguration","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowDeepLinkPipeline"},{"type":"text","text":" to cap absolute URL length, path segment count,"},{"type":"text","text":" "},{"type":"text","text":"and query item count. Direct matcher calls still return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" because"},{"type":"text","text":" "},{"type":"text","text":"their public contract is optional. Pipeline and effect-handler paths"},{"type":"text","text":" "},{"type":"text","text":"surface limit violations as typed"},{"type":"text","text":" "},{"type":"codeVoice","code":"DeepLinkRejectionReason.inputLimitExceeded"},{"type":"text","text":" rejections instead of"},{"type":"text","text":" "},{"type":"text","text":"“no match” outcomes when the pipeline receives the matcher through its"},{"type":"text","text":" "},{"code":"matcher:","type":"codeVoice"},{"type":"text","text":" initializer. The "},{"type":"codeVoice","code":"customResolver:"},{"type":"text","text":" escape hatch can surface only"},{"type":"text","text":" "},{"type":"text","text":"the pipeline’s own limits because an optional resolver result does not carry"},{"type":"text","text":" "},{"type":"text","text":"matcher-specific rejection information."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"code":"DeepLinkMatcher","type":"codeVoice"},{"text":" is the URL-pattern front door for route and ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" deep-link outputs.","type":"text"}],"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Matcher-and-Diagnostics","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterdeeplink\/matcher-and-diagnostics"]}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"role":"collection","kind":"symbol","title":"InnoRouterTesting","abstract":[],"type":"topic","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"title":"InnoRouterDeepLink","type":"topic","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","kind":"article","role