{"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Construction","type":"heading","text":"Construction"},{"inlineContent":[{"text":"Pass a matcher directly so matcher-specific input limits remain typed","type":"text"},{"text":" ","type":"text"},{"text":"rejections and the pipeline can reuse its parsed URL:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/products\/:id\") { parameters in","        parameters.firstValue(forName: \"id\").map { .product(id: $0) }","    }","}","","let pipeline = DeepLinkPipeline(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app.example.com\"],","    matcher: matcher",")"]},{"inlineContent":[{"text":"For routing rules that need the complete raw URL rather than pattern","type":"text"},{"text":" ","type":"text"},{"text":"matching, use the explicit escape hatch:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let pipeline = DeepLinkPipeline<AppRoute>(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app.example.com\"],","    customResolver: { url in legacyRouter.route(for: url) }",")"]},{"inlineContent":[{"text":"A custom resolver’s ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" result is ","type":"text"},{"type":"codeVoice","code":".unhandled"},{"text":". Pipeline-level input limits","type":"text"},{"text":" ","type":"text"},{"text":"still apply, but only the ","type":"text"},{"type":"codeVoice","code":"matcher:"},{"text":" path can preserve matcher-specific limit","type":"text"},{"text":" ","type":"text"},{"text":"violations.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Always-pass-allowlists-for-untrusted-URLs","type":"heading","text":"Always pass allowlists for untrusted URLs"},{"inlineContent":[{"type":"codeVoice","code":"allowedSchemes"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"allowedHosts"},{"text":" default to ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" disables"},{"type":"text","text":" "},{"type":"text","text":"that admission check entirely. Any pipeline that receives"},{"type":"text","text":" "},{"type":"text","text":"attacker-controllable URLs — custom URL schemes, universal links, QR or"},{"type":"text","text":" "},{"type":"text","text":"NFC payloads — should pass both allowlists so the decision stays"},{"type":"text","text":" "},{"type":"text","text":"fail-closed. The "},{"code":"@DeepLink","type":"codeVoice"},{"type":"text","text":" macro path enforces an allowlist at compile"},{"type":"text","text":" "},{"type":"text","text":"time ("},{"code":"E020","type":"codeVoice"},{"type":"text","text":"); hand-rolled pipelines are expected to match that posture."},{"type":"text","text":" "},{"type":"text","text":"Omit the allowlists only when every incoming URL is constructed by your"},{"type":"text","text":" "},{"type":"text","text":"own process."}],"type":"paragraph"},{"level":2,"anchor":"Pipeline-stages","type":"heading","text":"Pipeline stages"},{"inlineContent":[{"type":"text","text":"A pipeline can:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"reject a URL when configured input limits are exceeded","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"reject a URL by scheme or host","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"leave it unhandled","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"resolve it into a route","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"require authentication","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"convert the route into a ","type":"text"},{"code":"NavigationPlan","type":"codeVoice"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Pending-deep-links","type":"heading","text":"Pending deep links"},{"inlineContent":[{"type":"text","text":"When authentication is required but not currently satisfied, the pipeline returns "},{"code":"DeepLinkDecision.pending(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is deliberate:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the route that triggered authentication deferral is preserved","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the navigation plan is preserved","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"replay responsibility remains explicit at the app boundary","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"That keeps auth transitions and navigation transitions separate instead of blending them into one hidden side effect."}],"type":"paragraph"},{"level":2,"anchor":"Planning","type":"heading","text":"Planning"},{"inlineContent":[{"type":"text","text":"The planner converts a route into the exact command list that should run after acceptance. This makes deep-link execution deterministic and testable."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Authentication checks the routes referenced by the produced"},{"type":"text","text":" "},{"code":"NavigationPlan","type":"codeVoice"},{"type":"text","text":", including nested sequences and fallback commands."},{"type":"text","text":" "},{"type":"text","text":"If a custom planner returns no route-bearing commands, the pipeline"},{"type":"text","text":" "},{"type":"text","text":"falls back to the originally resolved route."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Effect handlers and coordinator bridges validate a produced"},{"type":"text","text":" "},{"code":"NavigationPlan","type":"codeVoice"},{"type":"text","text":" against the current "},{"code":"RouteStack","type":"codeVoice"},{"type":"text","text":" before executing it."},{"type":"text","text":" "},{"type":"text","text":"Plans that are obviously impossible, such as "},{"code":".pop","type":"codeVoice"},{"type":"text","text":" on an empty stack,"},{"type":"text","text":" "},{"type":"text","text":"surface as typed application rejections instead of partially running."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article","title":"Pipeline and pending deep links"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterdeeplink\/pipeline-and-pending-deep-links"]}],"abstract":[{"code":"DeepLinkPipeline","type":"codeVoice"},{"type":"text","text":" is where URL acceptance and app policy meet."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Pipeline-and-Pending-Deep-Links"},"kind":"article","sections":[],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"role":"collection","kind":"symbol","title":"InnoRouterTesting","abstract":[],"type":"topic","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"title":"InnoRouterDeepLink","type":"topic","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handl