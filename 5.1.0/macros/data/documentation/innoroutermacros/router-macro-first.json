ost"},{"type":"text","text":" "},{"type":"text","text":"is unavailable on watchOS, where the compiler directs callers to "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Native tabs","anchor":"Native-tabs","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Mark every parameterless case with "},{"type":"codeVoice","code":"@TabItem"},{"type":"text","text":". "},{"type":"codeVoice","code":"@Router"},{"text":" then supplies","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTab"},{"type":"text","text":", "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":", and the metadata consumed by "},{"type":"codeVoice","code":"RouterTabHost"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","enum AppTab {","    @TabItem(\"Home\", systemImage: \"house\")","    case home","","    @TabItem(\"Account\", systemImage: \"person\")","    case account","","    var destination: some View {","        switch self {","        case .home:","            Text(\"Home\")","        case .account:","            Text(\"Account\")","        }","    }","}","","struct AppTabs: View {","    var body: some View {","        RouterTabHost(AppTab.self, initial: .home)","    }","}","","struct AccountShortcut: View {","    @EnvironmentRouter(AppTab.self) private var router","","    var body: some View {","        Button(\"Account\") {","            router.select(.account)","            router.setBadge(1, for: .account)","        }","    }","}"]},{"type":"heading","text":"Automatic single-route deep links","anchor":"Automatic-single-route-deep-links","level":2},{"type":"paragraph","inlineContent":[{"text":"Give ","type":"text"},{"type":"codeVoice","code":"@Router"},{"text":" literal origin allowlists and attach ","type":"text"},{"type":"codeVoice","code":"@DeepLink"},{"text":" to the cases","type":"