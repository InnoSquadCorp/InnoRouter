{"abstract":[{"type":"text","text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path"},{"type":"text","text":" "},{"type":"text","text":"available for advanced composition."}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"]]},"topicSections":[{"title":"Essentials","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable"],"anchor":"Essentials"},{"title":"Guides","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics"],"anchor":"Guides"}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"InnoRouter 5 makes macros part of the canonical ","type":"text"},{"code":"InnoRouter","type":"codeVoice"},{"text":" product. Most","type":"text"},{"text":" ","type":"text"},{"text":"applications add that one product and use one import:","type":"text"}],"type":"paragraph"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter"],"type":"codeListing"},{"inlineContent":[{"text":"The module exposes five macros with separate responsibilities:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" is the default macro-first path. It turns route cases and an"},{"type":"text","text":" "},{"type":"text","text":"instance "},{"type":"codeVoice","code":"destination"},{"type":"text","text":" view into a "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":" that works with"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":", and generates tab or deep-link capabilities when their marker"},{"type":"text","text":" "},{"type":"text","text":"macros are present."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@TabItem"},{"type":"text","text":" marks parameterless router cases and generates the metadata used"},{"type":"text","text":" "},{"type":"text","text":"by "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" maps literal URL paths to typed router cases. "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" validates"},{"type":"text","text":" "},{"type":"text","text":"literal scheme and host allowlists and generates the "},{"type":"codeVoice","code":"DeepLinkRoute"},{"type":"text","text":" "},{"type":"text","text":"resolver. Generated matching prefers literal paths, then typed parameters,"},{"type":"text","text":" "},{"type":"text","text":"then terminal wildcards, regardless of case declaration order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" adds "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" conformance plus typed "},{"type":"codeVoice","code":"Cases"},{"type":"text","text":", "},{"type":"codeVoice","code":"is(_:)"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"subscript(case:)"},{"type":"text","text":" helpers. It does not build destination views."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":" adds the same case-path helpers without adding "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" "},{"type":"text","text":"conformance."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Every generated conformance has a plain Swift equivalent. Applications that","type":"text"},{"text":" ","type":"text"},{"text":"need externally owned stores, coordinators, restoration, or custom dependency","type":"text"},{"text":" ","type":"text"},{"text":"construction can continue to use the runtime APIs directly.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The opt-in ","type":"text"},{"code":"InnoRouterSpatial","type":"codeVoice"},{"text":" product adds ","type":"text"},{"code":"@SceneRouter","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Scene","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"visionOS app scenes. Those macros generate the scene tree installed in","type":"text"},{"text":" ","type":"text"},{"code":"App.body","type":"codeVoice"},{"text":"; they are intentionally not part of the default ","type":"text"},{"code":"InnoRouter","type":"codeVoice"},{"text":" ","type":"text"},{"text":"umbrella.","type":"text"}],"type":"paragraph"},{"anchor":"Macro-first-quick-start","level":2,"text":"Macro-first quick start","type":"heading"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","enum AppRoute {","    case detail(id: String)","    case settings","","    var destination: some View {","        switch self {","        case .detail(let id):","            Text(\"Detail \\(id)\")","        case .settings:","            Text(\"Settings\")","        }","    }","}","","struct AppRoot: View {","    var body: some View {","        RouterHost(AppRoute.self) {","            HomeView()","        }","    }","}","","struct HomeView: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    var body: some View {","        Button(\"Open settings\") {","            router.go(.settings)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"@Router","type":"codeVoice"},{"text":" supplies ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"DestinationRoute","type":"codeVoice"},{"text":", so do not add either","type":"text"},{"text":" ","type":"text"},{"text":"conformance to ","type":"text"},{"code":"AppRoute","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" remains ordinary Swift and receives the","type":"text"},{"text":" ","type":"text"},{"text":"compiler’s exhaustive-case checking.","type":"text"}],"type":"paragraph"},{"anchor":"Advanced-granular-imports","level":2,"text":"Advanced granular imports","type":"heading"},{"inlineContent":[{"code":"import InnoRouter","type":"codeVoice"},{"text":" is the default application entry point. It re-exports the","type":"text"},{"text":" ","type":"text"},{"text":"Core, SwiftUI, deep-link, and macro declarations together.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use granular products only when a target intentionally needs a narrower graph:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Product and import"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Advanced use case"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterCore"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Typed route state and command execution without SwiftUI or a compiler-plugin target in this target’s build graph."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterSwiftUI"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Manually conformed routes, externally owned stores, hosts, and coordinators without a compiler-plugin target in this target’s build graph."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterDeepLink"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Deep-link matching and planning without the SwiftUI authority layer."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterMacros"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A feature target that wants macro declarations plus their Core, SwiftUI, and deep-link runtime requirements without the full umbrella target."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterSpatial"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"visionOS windows, volumes, immersive spaces, and ornaments. This remains opt-in."}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"Keeping the compiler-plugin target out of a consumer target’s build graph","type":"text"},{"text":" ","type":"text"},{"text":"requires depending on granular runtime products instead of the ","type":"text"},{"code":"InnoRouter","type":"codeVoice"},{"text":" ","type":"text"},{"text":"umbrella. SwiftPM still resolves this package’s package-level ","type":"text"},{"code":"swift-syntax","type":"codeVoice"},{"text":" ","type":"text"},{"text":"dependency. Merely omitting a macro attribute from a file does not remove the","type":"text"},{"text":" ","type":"text"},{"text":"umbrella target’s macro dependency.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/innoroutermacros\/innoroutermacros"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"collectionGroup","title":"InnoRouterMacros"},"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"abstract":[{"text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to","type":"text"},{"text":" ","type":"text"},{"text":"find the recovery without depending on the compiler’s surrounding wording.","type":"text"},{"text":" ","type":"text"},{"text":"Errors prevent the macro from emitting 