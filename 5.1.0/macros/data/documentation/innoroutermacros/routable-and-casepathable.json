{"abstract":[{"text":"Use case-path macros when route code needs typed enum extraction in addition to","type":"text"},{"text":" ","type":"text"},{"text":"InnoRouter’s macro-first destination routing.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","primaryContentSections":[{"content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"text":"For most SwiftUI routers, start with ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":". It combines route data and","type":"text"},{"text":" ","type":"text"},{"text":"destination views in one enum. Add one of the case-path macros only when a","type":"text"},{"text":" ","type":"text"},{"text":"feature also needs to inspect or extract a particular enum case.","type":"text"}],"type":"paragraph"},{"anchor":"Routable","level":2,"text":"`@Routable`","type":"heading"},{"inlineContent":[{"code":"@Routable","type":"codeVoice"},{"text":" generates ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" conformance plus typed ","type":"text"},{"code":"Cases","type":"codeVoice"},{"text":", ","type":"text"},{"code":"is(_:)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"subscript(case:)","type":"codeVoice"},{"text":" helpers. It is useful for route models that do not own","type":"text"},{"text":" ","type":"text"},{"text":"destination views, such as a domain route consumed by a coordinator or planner.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Do not repeat ","type":"text"},{"code":": Route","type":"codeVoice"},{"text":"; the macro supplies that conformance:","type":"text"}],"type":"paragraph"},{"syntax":"swift compile","code":["import InnoRouter","","@Routable","enum AccountRoute {","    case overview","    case profile(userID: String)","}","","let route = AccountRoute.profile(userID: \"42\")","route[case: AccountRoute.Cases.profile]  \/\/ Optional(\"42\")","route.is(AccountRoute.Cases.overview)    \/\/ false"],"type":"codeListing"},{"anchor":"CasePathable","level":2,"text":"`@CasePathable`","type":"heading"},{"inlineContent":[{"code":"@CasePathable","type":"codeVoice"},{"text":" generates the same case-path members without adding","type":"text"},{"text":" ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" conformance. Compose it with ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" when a destination-owning","type":"text"},{"text":" ","type":"text"},{"text":"router also needs typed extraction:","type":"text"}],"type":"paragraph"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","@CasePathable","enum SearchRoute {","    case result(id: String)","","    var destination: some View {","        Text(\"Search result\")","    }","}","","let route = SearchRoute.result(id: \"42\")","route[case: SearchRoute.Cases.result]  \/\/ Optional(\"42\")"],"type":"codeListing"},{"inlineContent":[{"text":"It is also useful on enums that are not routes at all but still need reusable","type":"text"},{"text":" ","type":"text"},{"text":"case extraction.","type":"text"}],"type":"paragraph"},{"anchor":"Examples-vs-smoke-fixtures","level":2,"text":"Examples vs smoke fixtures","type":"heading"},{"inlineContent":[{"text":"The repository intentionally builds both example layers:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Examples\/"},{"type":"text","text":" covers macro-first entry points and explicitly advanced Store \/"},{"type":"text","text":" "},{"type":"text","text":"Coordinator composition; every human-facing example has a SwiftPM build"},{"type":"text","text":" "},{"type":"text","text":"target."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ExamplesSmoke\/"},{"type":"text","text":" mirrors the public runtime surface with conservative"},{"type":"text","text":" "},{"type":"text","text":"fixtures. Its dedicated "},{"type":"codeVoice","code":"MacrosSmoke.swift"},{"type":"text","text":" target depends only on"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" and proves the one-product macro-first consumer contract."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Macro expansion itself is covered by ","type":"text"},{"code":"InnoRouterMacrosTests","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterMacrosBehaviorTests","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Limitations-generic-enums","level":2,"text":"Limitations: generic enums","type":"heading"},{"inlineContent":[{"text":"Both ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@CasePathable","type":"codeVoice"},{"text":" reject generic enum declarations with an","type":"text"},{"text":" ","type":"text"},{"text":"explicit compiler error:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@Routable","enum Generic<T> { case detail(T) } \/\/ error: @Routable does not support generic enum declarations"],"type":"codeListing"},{"inlineContent":[{"text":"The generated ","type":"text"},{"code":"enum Cases","type":"codeVoice"},{"text":" would need to materialise ","type":"text"},{"code":"CasePath<Self, T>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"members for each generic instantiation, but Swift does not propagate the","type":"text"},{"text":" ","type":"text"},{"text":"parent’s generic parameters into a nested type that way. Diagnostic ID","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterMacro.E003","type":"codeVoice"},{"text":" is emitted on the generic parameter clause. See","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics"},{"text":" for the complete diagnostic catalog.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This limitation does not apply to ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":". A constrained generic router is","type":"text"},{"text":" ","type":"text"},{"text":"supported as long as its payloads satisfy the ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" requirements:","type":"text"}],"type":"paragraph"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","enum DetailRoute<Value: Hashable & Sendable> {","    case detail(Value)","","    var destination: some View {","        Text(\"Detail\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"If a case-path route needs a generic data shape, expose a concrete payload type","type":"text"},{"text":" ","type":"text"},{"text":"from the non-generic route enum:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["struct DetailPayload<Value: Hashable & Sendable>: Hashable, Sendable {","    let value: Value","}","","typealias StringDetailPayload = DetailPayload<String>","","@Routable","enum AppRoute {","    case home","    case detail(StringDetailPayload)","}"],"type":"codeListing"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/innoroutermacros\/routable-and-casepathable"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"title":"Routable and CasePathable","roleHeading":"Article","role":"article","modules":[{"name":"InnoRouterTesting"}]},"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"abstract":[{"text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to","type":"text"},{"text":" ","type":"text"},{"text":"find the recovery without depending on the compiler’s surrounding wording.","type":"text"},{"text":" ","type":"text"},{"text":"Errors prevent the macro from emitting an incomplete routing contract.","type":"text"},{"text":" ","type":"text"},{"text":"Warnings identify valid code whose generated behavior is likely surprising or","type":"text"},{"text":" ","type":"text"},{"text":"whose explicit declarations are redundant.","type":"text"}],"title":"Macro diagnostics","url":"\/documentation\/innoroutermacros\/macro-diagnostics","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","kind":"article","type":"topic","role":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"kind":"symbol","url":"\/documentation\/innoroutertesting","type":"topic","abstract":[],"title":"InnoRouterTesting","role":"collection","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"abstract":[{"text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path","type":"text"},{"text":" ","type":"text"},{"text":"available for advanced composition.","type":"text"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","title":"InnoRouterMacros","url":"\/documentation\/innoroutermacros\/innoroutermacros","kind":"article","type":"topic","role":"collectionGroup"}}}