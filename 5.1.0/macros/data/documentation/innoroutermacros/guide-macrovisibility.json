{"abstract":[{"type":"text","text":"InnoRouter macros infer generated member visibility from the attached enum."},{"type":"text","text":" "},{"type":"text","text":"They do not widen an internal route into public API."}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","primaryContentSections":[{"content":[{"type":"heading","text":"`@Routable` and `@CasePathable`","anchor":"Routable-and-CasePathable","level":2},{"type":"paragraph","inlineContent":[{"text":"For every ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"@CasePathable","type":"codeVoice"},{"text":") enum the macros emit:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"enum Cases { … }"},{"type":"text","text":" containing one "},{"type":"codeVoice","code":"static let"},{"text":" per case.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"func is(_ casePath:) -> Bool"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"subscript(case:) -> Value?"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"The access keyword applied to ","type":"text"},{"code":"Cases","type":"codeVoice"},{"text":", every case-path member, ","type":"text"},{"code":"is(_:)","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"subscript(case:)","type":"codeVoice"},{"text":" is inferred from the enclosing enum:","type":"text"}]},{"type":"table","rows":[[[{"inlineContent":[{"text":"Enum modifier","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Generated members"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"public enum Foo"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"public"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"package enum Foo"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"package"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"internal enum Foo","type":"codeVoice"},{"text":" (or no modifier)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"internal","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"fileprivate enum Foo","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"fileprivate"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"private enum Foo"}],"type":"paragraph"}],[{"inlineContent":[{"code":"fileprivate","type":"codeVoice"},{"text":" (the narrowest level that remains reachable across the macro expansion)","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"type":"paragraph","inlineContent":[{"text":"Each case ","type":"text"},{"code":"static let","type":"codeVoice"},{"text":" also receives any ","type":"text"},{"code":"@available(...)","type":"codeVoice"},{"text":" attribute attached","type":"text"},{"text":" ","type":"text"},{"text":"to the enum case, so a case gated on an OS version does not produce a","type":"text"},{"text":" ","type":"text"},{"code":"CasePath","type":"codeVoice"},{"text":" member with wider availability than the underlying case.","type":"text"}]},{"type":"heading","text":"`@Router`","anchor":"Router","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" adds "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" to the developer-declared"},{"text":" ","type":"text"},{"type":"text","text":"instance "},{"type":"codeVoice","code":"destination"},{"type":"text","text":" property. It does not change that property’s declared"},{"type":"text","text":" "},{"type":"text","text":"access level."}]},{"inlineContent":[{"type":"text","text":"The generated "},{"type":"codeVoice","code":"static destination(for:)"},{"type":"text","text":" protocol witness follows the enum’s"},{"type":"text","text":" "},{"type":"text","text":"effective access level. This means a public router can keep the instance hook"},{"type":"text","text":" "},{"type":"text","text":"private while exposing only the witness required by "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift compile","type":"codeListing","code":["import SwiftUI","import InnoRouter","","@Router","public enum PublicRoute {","    case settings","","    private var destination: some View {","        Text(\"Settings\")","    }","}"]},{"inlineContent":[{"type":"text","text":"For a "},{"type":"codeVoice","code":"private"},{"type":"text","text":" enum, the generated witness uses "},{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":", matching the"},{"type":"text","text":" "},{"type":"text","text":"case-path macros’ same-file fallback. Do not declare "},{"type":"codeVoice","code":": DestinationRoute"},{"type":"text","text":" "},{"type":"text","text":"yourself; "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" supplies the conformance and warns when the direct"},{"type":"text","text":" "},{"type":"text","text":"conformance is redundant."}],"type":"paragraph"},{"anchor":"Compatibility-for-pre-OSS-snapshots","type":"heading","level":2,"text":"Compatibility for pre-OSS snapshots"},{"inlineContent":[{"type":"text","text":"Before the 4.0.0 OSS release, internal macro snapshots always emitted"},{"type":"text","text":" "},{"type":"text","text":"case-path members as "},{"type":"codeVoice","code":"public"},{"type":"text","text":". Teams that tested those snapshots should check"},{"type":"text","text":" "},{"type":"text","text":"three patterns:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Enum and CasePath usage already match."}]},{"type":"text","text":" No action is needed. Generated"},{"type":"text","text":" "},{"type":"text","text":"members tighten to match the enum, and same-module consumer code keeps"},{"type":"text","text":" "},{"type":"text","text":"compiling."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"A sibling module reads generated members from a non-public enum."}]},{"type":"text","text":" Mark"},{"type":"text","text":" "},{"type":"text","text":"the enum "},{"type":"codeVoice","code":"public"},{"type":"text","text":"; the old expansion was widening the surface implicitly."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Enum cases are gated on "},{"type":"codeVoice","code":"@available(...)"},{"type":"text","text":"."}],"type":"strong"},{"text":" Generated ","type":"text"},{"code":"CasePath","type":"codeVoice"},{"text":" members","type":"text"},{"text":" ","type":"text"},{"text":"now carry the same availability. Narrow the enclosing function or branch on","type":"text"},{"text":" ","type":"text"},{"code":"if #available(...)","type":"codeVoice"},{"text":" at any downstream call site that used a wider window.","type":"text"}]}]}],"type":"orderedList"},{"text":"Why `private` maps to `fileprivate`","anchor":"Why-private-maps-to-fileprivate","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Generated declarations can originate from distinct macro expansion roles."},{"type":"text","text":" "},{"type":"text","text":"Using "},{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":" preserves same-file access between those declarations while"},{"type":"text","text":" "},{"type":"text","text":"remaining narrower than module-wide "},{"type":"codeVoice","code":"internal"},{"type":"text","text":" visibility."}],"type":"paragraph"},{"text":"Manual visibility control","anchor":"Manual-visibility-control","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The macros do not expose a visibility override. Mark the enclosing enum"},{"type":"text","text":" "},{"type":"codeVoice","code":"public"},{"type":"text","text":" when its generated members must be public; otherwise generated members"},{"type":"text","text":" "},{"type":"text","text":"follow the declaration’s effective access level. If a generated surface is not"},{"type":"text","text":" "},{"type":"text","text":"appropriate, remove the macro and write the conformance or case-path members"},{"type":"text","text":" "},{"type":"text","text":"explicitly."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/innoroutermacros\/guide-macrovisibility"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"title":"Macro-generated access levels","role":"article","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}]},"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"kind":"symbol","url":"\/documentation\/innoroutertesting","type":"topic","abstract":[],"title":"InnoRouterTesting","role":"collection","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"abstract":[{"text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path","type":"text"},{"text":" ","type":"text"},{"text":"available for advanced composition.","type":"text"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/docum