{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Setup","type":"heading","level":2,"text":"Setup"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" to the test target only:"}]},{"code":[".testTarget(","    name: \"AppTests\",","    dependencies: [","        .product(name: \"InnoRouter\",        package: \"InnoRouter\"),","        .product(name: \"InnoRouterTesting\", package: \"InnoRouter\"),","    ]",")"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Then import both modules alongside Swift Testing:","type":"text"}]},{"code":["import Testing","import InnoRouter","import InnoRouterTesting"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"anchor":"The-happy-path","type":"heading","level":2,"text":"The happy path"},{"code":["private enum AppRoute: Route {","    case welcome, preAuth, signup","}","","@Test","@MainActor","func pushingPreAuthEmitsNavigationAndPathChange() {","    let store = FlowTestStore<AppRoute>()","","    store.send(.push(.preAuth))","","    store.receiveNavigation { event in","        if case .changed(_, let to) = event { return to.path == [.preAuth] }","        return false","    }","    store.receivePathChanged { old, new in","        old.isEmpty && new == [.push(.preAuth)]","    }","    store.expectNoMoreEvents()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" owns a real "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" and subscribes to every"},{"type":"text","text":" "},{"type":"text","text":"observation surface it exposes (flow, inner navigation, inner"},{"type":"text","text":" "},{"type":"text","text":"modal). Events land in one FIFO queue; "},{"type":"codeVoice","code":"receive*"},{"type":"text","text":" helpers dequeue"},{"type":"text","text":" "},{"type":"text","text":"them in the order the production stores emit."}]},{"anchor":"Modal-+-cancellation","type":"heading","level":2,"text":"Modal + cancellation"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"text":" surfaces cancellations as first-class events, so","type":"text"},{"text":" ","type":"text"},{"text":"tests can assert them precisely:","type":"text"}]},{"code":["@MainActor","private func blockSheetMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(willExecute: { command, _, _ in","        if case .present(let p) = command, p.style == .sheet {","            return .cancel(.middleware(debugName: nil, command: command))","        }","        return .proceed(command)","    })","}","","@Test","@MainActor","func sheetBlockingMiddlewareCancelsTheIntent() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            modal: .init(","                middlewares: [.init(middleware: blockSheetMiddleware(), debugName: \"BlockSheet\")]","            )","        )","    )","","    store.send(.presentSheet(.signup))","","    \/\/ The preview path never commits — only .intentRejected fires.","    store.receiveIntentRejected(","        intent: .presentSheet(.signup),","        reason: .middlewareRejected(debugName: \"BlockSheet\")","    )","    #expect(store.path.isEmpty)","    store.expectNoMoreEvents()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"text":"Skipping and draining","level":2,"type":"heading","anchor":"Skipping-and-draining"},{"type":"paragraph","inlineContent":[{"code":"skipReceivedEvents()","type":"codeVoice"},{"text":" discards everything currently queued","type":"text"},{"text":" ","type":"text"},{"text":"without asserting, which is useful when a test only cares about","type":"text"},{"text":" ","type":"text"},{"text":"events ","type":"text"},{"inlineContent":[{"type":"text","text":"after"}],"type":"emphasis"},{"text":" a setup mutation:","type":"text"}]},{"code":["store.send(.presentSheet(.signup)) \/\/ enqueues .modal + .pathChanged","store.skipReceivedEvents()         \/\/ we don't care about setup","","store.send(.push(.preAuth))","store.receiveIntentRejected(intent: .push(.preAuth), reason: .pushBlockedByModalTail)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"text":"Exhaustivity","level":2,"type":"heading","anchor":"Exhaustivity"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Default is "},{"type":"codeVoice","code":"TestExhaustivity.strict"},{"type":"text","text":" — any unasserted event at"},{"type":"text","text":" "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" (or at deinit of the test store) triggers a Swift"},{"type":"text","text":" "},{"type":"text","text":"Testing "},{"type":"codeVoice","code":"Issue.record"},{"type":"text","text":". This catches the common mistake of"},{"type":"text","text":" "},{"type":"text","text":"“missed that the modal also fired a "},{"type":"codeVoice","code":".presented"},{"type":"text","text":" after the"},{"type":"text","text":" "},{"type":"text","text":"intended intent.”"}]},{"inlineContent":[{"text":"Opt out selectively:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let store = FlowTestStore<AppRoute>(exhaustivity: .off)"],"type":"codeListing"},{"inlineContent":[{"code":".off","type":"codeVoice"},{"type":"text","text":" preserves per-call assertions; only the end-of-life drain"},{"type":"text","text":" "},{"type":"text","text":"check is silenced. Useful when migrating a legacy test in stages."}],"type":"paragraph"},{"text":"Direct state inspection","level":2,"type":"heading","anchor":"Direct-state-inspection"},{"inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"text":" exposes the projected ","type":"text"},{"code":"path","type":"codeVoice"},{"text":" for occasional direct","type":"text"},{"text":" ","type":"text"},{"text":"assertions:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["#expect(store.path == [.push(.preAuth)])"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer "},{"type":"codeVoice","code":"receive*"},{"type":"text","text":" for production assertions — they cover both"},{"type":"text","text":" "},{"type":"text","text":"state and the emission order — but escape hatches are useful for"},{"type":"text","text":" "},{"type":"text","text":"sanity checks. The inner "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" behind a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" are SPI in 4.0; use public flow events and "},{"type":"codeVoice","code":"path"},{"type":"text","text":" unless"},{"type":"text","text":" "},{"type":"text","text":"you are writing focused package-internal invariant tests."}]},{"text":"Testing middleware behaviour directly","anchor":"Testing-middleware-behaviour-directly","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The modal-blocking example above tests middleware "},{"type":"emphasis","inlineContent":[{"text":"through","type":"text"}]},{"type":"text","text":" a flow"},{"type":"text","text":" "},{"type":"text","text":"store. Sometimes you want to test the middleware itself — does it"},{"type":"text","text":" "},{"type":"text","text":"correctly pass through, cancel, or rewrite commands for every input"},{"type":"text","text":" "},{"type":"text","text":"shape? "},{"type":"codeVoice","code":"NavigationTestStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"ModalTestStore"},{"type":"text","text":" let you do that"},{"type":"text","text":" "},{"type":"text","text":"without a FlowStore in the middle."}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@MainActor","private final class RecordingMiddleware: NavigationMiddleware {","    typealias RouteType = AppRoute","","    private(set) var seenCommands: [NavigationCommand<AppRoute>] = []","","    func willExecute(","        _ command: NavigationCommand<AppRoute>,","        state: RouteStack<AppRoute>","    ) -> NavigationInterception<AppRoute> {","        seenCommands.append(command)","        if case .push(let route) = command, route == .signup {","            return .cancel(.middleware(debugName: \"BlockSignup\", command: command))","        }","        return .proceed(command)","    }","","    func didExecute(","        _ command: NavigationCommand<AppRoute>,","        result: NavigationResult<AppRoute>,","        state: RouteStack<AppRoute>","    ) -> NavigationResult<AppRoute> {","        result","    }","}","","@Test","@MainActor","func middlewareCancelsSignupButNotWelcome() {","    let middleware = RecordingMiddleware()","    let store = NavigationTestStore<AppRoute>(","        configuration: .init(","            middlewares: [.init(middleware: middleware, debugName: \"Recorder\")]","        )","    )","","    store.send(.push(.welcome))","    store.receiveChange { _, to in to.path == [.welcome] }","","    store.send(.push(.signup))","    store.receiveIntercepted(reason: .middleware(debugName: \"BlockSignup\", command: .push(.signup)))","","    #expect(middleware.seenCommands.count == 2)","    store.expectNoMoreEvents()","}"]},{"type":"paragraph","inlineContent":[{"text":"Recording middlewares work naturally with ","type":"text"},{"type":"codeVoice","code":"@MainActor final class"},{"text":" ","type":"text"},{"text":"and mutable state. Pair them with ","type":"text"},{"type":"codeVoice","code":"receiveIntercepted"},{"text":" to assert","type":"text"},{"text":" ","type":"text"},{"text":"which interceptions fired and in what order, and with direct","type":"text"},{"text":" ","type":"text"},{"text":"reads on the middleware instance to assert which commands it saw.","type":"text"}]},{"text":"Property-based test recipes","anchor":"Property-based-test-recipes","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"InnoRouter’s own property-based suites use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Tests\/InnoRouterTests\/PropertyTestSupport.swift"},{"text":". That helper lives","type":"text"},{"text":" ","type":"text"},{"text":"in this repository’s test target, not in the shipped","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"InnoRouterTesting"},{"text":" product, so downstream apps should copy or adapt","type":"text"},{"text":" ","type":"text"},{"text":"the pattern rather than expect ","type":"text"},{"type":"codeVoice","code":"@testable import InnoRouterTesting"},{"text":" ","type":"text"},{"text":"to expose ","type":"text"},{"type":"codeVoice","code":"SeededGenerator"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Arbitrary"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"FlowModelState"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The idiom is ","type":"text"},{"inlineContent":[{"type":"text","text":"Swift Testing "},{"type":"codeVoice","code":"@Test(arguments:)"},{"type":"text","text":" iterated over many"},{"type":"text","text":" "},{"type":"text","text":"seeds"}],"type":"strong"},{"text":", each seed driving a deterministic random intent stream:","type":"text"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@Test(arguments: 0..<100)","@MainActor","func randomFlowIntentsPreserveInvariants(seed: UInt64) async {","    var rng = SeededGenerator(seed: seed)","    let store = FlowTestStore<AppRoute>(exhaustivity: .off)","","    for _ in 0..<30 {","        let intent = Arbitrary.flowIntent(","            rng: &rng,","            routes: [.welcome, .preAuth, .signup]","        )","        store.send(intent)","    }","","    \/\/ Invariant: modal-tail is always the final step, never in the middle.","    let modalIndices = store.path.indices.filter { store.path[$0].isModal }","    #expect(modalIndices.allSatisfy { $0 == store.path.count - 1 })","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift Testing runs the 100 parameterised cases in parallel by"},{"text":" ","type":"text"},{"text":"default, so total wall-clock time stays close to a single iteration.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A pairs-with pattern: "},{"type":"strong","inlineContent":[{"text":"run the random stream through both the","type":"text"},{"text":" ","type":"text"},{"text":"real store and a reference model","type":"text"}]},{"type":"text","text":", then assert they agree step by"},{"type":"text","text":" "},{"type":"text","text":"step. That’s how "},{"type":"codeVoice","code":"FlowStorePropertyBasedTests"},{"type":"text","text":" catches subtle"},{"type":"text","text":" "},{"type":"text","text":"divergences between the journal-driven implementation and the"},{"type":"text","text":" "},{"type":"text","text":"intended semantics. See this repository’s PropertyTestSupport source"},{"type":"text","text":" "},{"type":"text","text":"for the model-driven "},{"type":"codeVoice","code":"FlowModelState"},{"type":"text","text":" pattern."}]},{"text":"Next steps","anchor":"Next-steps","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read the "},{"code":"Tutorial-LoginOnboarding","type":"codeVoice"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"code":"InnoRouterSwiftUI","type":"codeVoice"},{"type":"text","text":" documentation catalog for the end-to-end flow"},{"type":"text","text":" "},{"type":"text","text":"being tested here."}]}]},{"content":[{"inlineContent":[{"text":"Read the ","type":"text"},{"type":"codeVoice","code":"Tutorial-MiddlewareComposition"},{"text":" guide in the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"text":" documentation catalog for the middleware","type":"text"},{"text":" ","type":"text"},{"text":"surfaces the harness asserts against.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cross-reference ","type":"text"},{"code":"<doc:Rejection-Reasons>","type":"codeVoice"},{"text":" (in InnoRouterCore) for","type":"text"},{"text":" ","type":"text"},{"text":"the full rejection taxonomy your ","type":"text"},{"code":"receiveIntentRejected","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"receiveIntercepted","type":"codeVoice"},{"text":" calls can pattern-match on.","type":"text"}]}]}],"type":"unorderedList"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutertesting\/tutorial-testingflows"]}],"abstract":[{"type":"text","text":"Assert the complete chain triggered by a single "},{"type":"codeVoice","code":"FlowIntent"},{"type":"text","text":" —"},{"type":"text","text":" "},{"type":"text","text":"navigation, modal, middleware cancellation, path reconciliation —"},{"type":"text","text":" "},{"type":"text","text":"through a single FIFO receive queue, without mounting any SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"host."}],"metadata":{"modules":[{"name":"InnoRouterMacros"}],"roleHeading":"Article","role":"article","title":"Testing Flows End-to-End with `FlowTestStore`"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/Tutorial-TestingFlows"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterMacros"],["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterMacros","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/InnoRouterTesting"]]},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/InnoRouterTesting":{"abstract":[{"text":"Host-less, Swift-Testing native assertion harness for InnoRouter’s navigation, modal, and flow authorities.","type":"text"}],"url":"\/documentation\/innoroutertesting\/innoroutertesting","type":"topic","kind":"article","title":"InnoRouterTesting","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterMacros":{"title":"InnoRouterMacros","kind":"symbol","type":"topic","role":"collection","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterMacros","url":"\/documentation\/innoroutermacros","abstract":[]}}}