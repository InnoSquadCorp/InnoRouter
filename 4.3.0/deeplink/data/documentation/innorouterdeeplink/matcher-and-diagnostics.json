:" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"values(forName:)"},{"type":"text","text":". For common scalar types, use the typed overloads:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let id = parameters.firstValue(forName: \"id\", as: UUID.self)","let page = parameters.firstValue(forName: \"page\", as: Int.self)","let selectedTags = parameters.values(forName: \"tag\", as: String.self)"]},{"text":"Match precedence","type":"heading","anchor":"Match-precedence","level":2},{"inlineContent":[{"text":"Match precedence remains declaration-order based.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That means:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"earlier patterns win","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"diagnostics do not change runtime behavior"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"ordering is still part of the matcher contract","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Diagnostics","type":"heading","anchor":"Diagnostics","level":2},{"inlineContent":[{"type":"codeVoice","code":"DeepLinkMatcherConfiguration"},{"text":" can surface diagnostics for common authoring mistakes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"duplicate patterns","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"wildcard shadowing"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"non-terminal wildcards"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"invalid parameter names; parameter names must match"},{"type":"text","text":" "},{"type":"codeVoice","code":"^[A-Za-z_][A-Za-z0-9_]*$"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"parameter-heavy patterns that subsume more specific later patterns","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Diagnostics are available on both push-only and flow matchers. They","type":"text"},{"text":" ","type":"text"},{"text":"are intended to catch ambiguous authoring early without changing the","type":"text"},{"text":" ","type":"text"},{"text":"matcher’s runtime semantics.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For release-readiness gates, use the throwing strict initializers:"},{"type":"text","text":" "},{"type":"codeVoice","code":"DeepLinkMatcher(strict:)"},{"type":"text","text":" for push-only mappings and"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowDeepLinkMatcher(strict:)"},{"type":"text","text":" for mappings that expand into a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":". Strict initializers throw "},{"type":"codeVoice","code":"DeepLinkMatcherStrictError"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"the full diagnostic list instead of only logging warnings, and accept"},{"type":"text","text":" "},{"type":"text","text":"the same "},{"type":"codeVoice","code":"DeepLinkInputLimits"},{"type":"text","text":" guardrails used by non-strict matchers."}],"type":"paragraph"},{"level":2,"anchor":"Input-limits","text":"Input limits","type":"heading"},{"inlineContent":[{"code":"DeepLinkInputLimits","type":"codeVoice"},{"text":" guards runtime URLs before matching. Configure it","type":"text"},{"text":" ","type":"text"},{"text":"on ","type":"text"},{"code":"DeepLinkMatcherConfiguration","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DeepLinkPipeline","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"code":"FlowDeepLinkPipeline","type":"codeVoice"},{"text":" to cap absolute URL length, path segment count,","type":"text"},{"text":" ","type":"text"},{"text":"and query item count. Direct matcher calls still return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" because","type":"text"},{"text":" ","type":"text"},{"text":"their public contract is optional. Pipeline and effect-handler paths","type":"text"},{"text":" ","type":"text"},{"text":"surface limit violations as typed","type":"text"},{"text":" ","type":"text"},{"code":"DeepLinkRejectionReason.inputLimitExceeded","type":"codeVoice"},{"text":" rejections instead of","type":"text"},{"text":" ","type":"text"},{"text":"“no match” outcomes.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"article","title":"Matcher and diagnostics","roleHeading":"Article"},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Matcher-and-Diagnostics"},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","kind":"symbol","type":"topic","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"abstract":[{"text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter.","type":"text"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","kind":"article","role":"collectionGroup","title":"InnoRouterDeepLink","type":"topic"}}}