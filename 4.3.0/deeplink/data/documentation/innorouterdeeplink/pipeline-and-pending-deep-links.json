{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"level":2,"text":"Pipeline stages","anchor":"Pipeline-stages","type":"heading"},{"inlineContent":[{"text":"A pipeline can:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reject a URL when configured input limits are exceeded"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"reject a URL by scheme or host","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"leave it unhandled","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"resolve it into a route"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"require authentication","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"convert the route into a "},{"type":"codeVoice","code":"NavigationPlan"}]}]}],"type":"unorderedList"},{"level":2,"text":"Pending deep links","anchor":"Pending-deep-links","type":"heading"},{"inlineContent":[{"type":"text","text":"When authentication is required but not currently satisfied, the pipeline returns "},{"type":"codeVoice","code":"DeepLinkDecision.pending(_:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"This is deliberate:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"the route that triggered authentication deferral is preserved"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"the navigation plan is preserved","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"replay responsibility remains explicit at the app boundary","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"That keeps auth transitions and navigation transitions separate instead of blending them into one hidden side effect."}],"type":"paragraph"},{"level":2,"text":"Planning","anchor":"Planning","type":"heading"},{"inlineContent":[{"text":"The planner converts a route into the exact command list that should run after acceptance. This makes deep-link execution deterministic and testable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Authentication checks the routes referenced by the produced","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationPlan"},{"text":", including nested sequences and fallback commands.","type":"text"},{"text":" ","type":"text"},{"text":"If a custom planner returns no route-bearing commands, the pipeline","type":"text"},{"text":" ","type":"text"},{"text":"falls back to the originally resolved route.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Effect handlers and coordinator bridges validate a produced"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":" against the current "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" before executing it."},{"type":"text","text":" "},{"type":"text","text":"Plans that are obviously impossible, such as "},{"type":"codeVoice","code":".pop"},{"type":"text","text":" on an empty stack,"},{"type":"text","text":" "},{"type":"text","text":"surface as typed application rejections instead of partially running."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/innorouterdeeplink\/pipeline-and-pending-deep-links"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article","title":"Pipeline and pending deep links"},"abstract":[{"type":"codeVoice","code":"DeepLinkPipeline"},{"text":" is where URL acceptance and app policy meet.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"