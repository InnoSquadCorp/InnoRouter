{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"title":"`@Routable` \/ `@CasePathable` access level inference"},"abstract":[{"text":"Starting in 4.0.0 the ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@CasePathable","type":"codeVoice"},{"text":" macros","type":"text"},{"text":" ","type":"text"},{"text":"infer the access level of every generated member from the","type":"text"},{"text":" ","type":"text"},{"text":"enclosing enum. The previous behaviour emitted everything as","type":"text"},{"text":" ","type":"text"},{"code":"public","type":"codeVoice"},{"text":", which leaked CasePath surface for ","type":"text"},{"code":"internal","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"private","type":"codeVoice"},{"text":" enums that never intended that visibility.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"What gets generated, and at what level","anchor":"What-gets-generated-and-at-what-level"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For every "},{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":") enum the macros emit:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"enum Cases { … }","type":"codeVoice"},{"type":"text","text":" containing one "},{"code":"static let","type":"codeVoice"},{"type":"text","text":" per case."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"func is(_ casePath:) -> Bool"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"subscript(case:) -> Value?"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The access keyword applied to all four is inferred from the"},{"type":"text","text":" "},{"type":"text","text":"enclosing enum:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enum modifier"}]}],[{"inlineContent":[{"text":"Generated members","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"public enum Foo","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"public"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"package enum Foo"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"package"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"internal enum Foo"},{"type":"text","text":" (or no modifier)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"internal"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"fileprivate enum Foo"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"fileprivate"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"private enum Foo","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":" (lowest level the macro can emit while still letting same-file "},{"type":"codeVoice","code":"is(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"subscript(case:)"},{"type":"text","text":" callers reach the cases)"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each case "},{"type":"codeVoice","code":"static let"},{"type":"text","text":" also receives any "},{"type":"codeVoice","code":"@available(...)"},{"type":"text","text":" "},{"type":"text","text":"attribute attached to the enum case, so a case gated on an OS"},{"type":"text","text":" "},{"type":"text","text":"version no longer produces a CasePath member with a wider"},{"type":"text","text":" "},{"type":"text","text":"availability than the underlying case."}]},{"type":"heading","level":2,"text":"Compatibility for pre-OSS snapshots","anchor":"Compatibility-for-pre-OSS-snapshots"},{"type":"paragraph","inlineContent":[{"text":"Before the 4.0.0 OSS release, internal macro snapshots always emitted","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"public"},{"text":". Teams that tested those snapshots should check three","type":"text"},{"text":" ","type":"text"},{"text":"patterns:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Enum and CasePath usage already match."}]},{"type":"text","text":" No action — the"},{"type":"text","text":" "},{"type":"text","text":"generated members tighten to "},{"code":"internal","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"fileprivate","type":"codeVoice"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"code":"fileprivate","type":"codeVoice"},{"type":"text","text":" matching the enum and the consumer code keeps"},{"type":"text","text":" "},{"type":"text","text":"compiling because it was within the same module already."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Enum is not ","type":"text"},{"code":"public","type":"codeVoice"},{"text":" but a sibling module reads the","type":"text"},{"text":" ","type":"text"},{"text":"generated CasePath members.","type":"text"}],"type":"strong"},{"type":"text","text":" Mark the enum "},{"code":"public","type":"codeVoice"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"pre-OSS behaviour was effectively widening the surface for you;"},{"type":"text","text":" "},{"type":"text","text":"4.0.0 makes the boundary explicit."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Enum cases are gated on "},{"type":"codeVoice","code":"@available(...)"},{"type":"text","text":"."}]},{"text":" The generated","type":"text"},{"text":" ","type":"text"},{"text":"CasePath members now carry the same availability. If a","type":"text"},{"text":" ","type":"text"},{"text":"downstream call site compiled under a wider availability","type":"text"},{"text":" ","type":"text"},{"text":"window before, narrow the enclosing function or branch on","type":"text"},{"text":" ","type":"text"},{"code":"if #available(...)","type":"codeVoice"},{"text":" to match.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"text":"Why `private` enums emit `fileprivate`","anchor":"Why-private-enums-emit-fileprivate"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift does not let an extension method (the macro emits"},{"type":"text","text":" "},{"type":"codeVoice","code":"is(_:)"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"subscript(case:)"},{"type":"text","text":" as members on the enum itself,"},{"type":"text","text":" "},{"type":"text","text":"not on a generated extension) reference a "},{"type":"codeVoice","code":"private"},{"type":"text","text":" "},{"type":"text","text":"declaration in its own scope when that declaration came from"},{"type":"text","text":" "},{"type":"text","text":"a distinct macro plugin call. Falling back to "},{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":" "},{"type":"text","text":"gives the same effective scope for any caller in the same file"},{"type":"text","text":" "},{"type":"text","text":"without breaking the macro expansion."}]},{"type":"heading","level":2,"text":"Opt-out","anchor":"Opt-out"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"@Routable(visibility: .public)","type":"codeVoice"},{"text":" argument is on the v4.x","type":"text"},{"text":" ","type":"text"},{"text":"roadmap for consumers that intentionally want the wider surface","type":"text"},{"text":" ","type":"text"},{"text":"without making the enclosing enum public. Until then, mark the","type":"text"},{"text":" ","type":"text"},{"text":"enum ","type":"text"},{"code":"public","type":"codeVoice"},{"text":" to widen the generated members.","type":"text"}]}]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","interfaceLanguage":"swift"},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/guide-macrovisibility"]}],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"abstract":[],"type":"topic","role":"collection","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","kind":"symbol","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"url":"\/documentation\/innoroutermacros\/innoroutermacros","role":"collectionGroup","title":"InnoRouterMacros","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","type":"topic","abstract":[{"text":"Route and case-path convenience macros for InnoRouter.","type":"text"}],"kind":"article"}}}