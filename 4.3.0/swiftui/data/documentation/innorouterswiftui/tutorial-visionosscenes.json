{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article","title":"visionOS: windows, volumetric scenes, immersive spaces, and ornaments"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-visionosscenes"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-VisionOSScenes"},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"visionOS exposes three distinct “scene” primitives that are not"},{"type":"text","text":" "},{"type":"text","text":"modelled by "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"a regular window, declared with ","type":"text"},{"code":"WindowGroup(id:for:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"a volumetric window, declared with "},{"type":"codeVoice","code":"WindowGroup(id:for:).windowStyle(.volumetric)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"an immersive space, declared with "},{"type":"codeVoice","code":"ImmersiveSpace(id:)"}]}]}]},{"inlineContent":[{"text":"SwiftUI’s openers for these (","type":"text"},{"code":"@Environment(\\.openWindow)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"@Environment(\\.openImmersiveSpace)","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@Environment(\\.dismissImmersiveSpace)","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"@Environment(\\.dismissWindow)","type":"codeVoice"},{"text":") are only reachable from a view’s","type":"text"},{"text":" ","type":"text"},{"code":"body","type":"codeVoice"},{"text":". InnoRouter provides a thin ","type":"text"},{"code":"SceneStore","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"SceneHost","type":"codeVoice"},{"text":" pair","type":"text"},{"text":" ","type":"text"},{"text":"that mirrors the ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":" discipline:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"the store owns the desired scene state and publishes intents"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"the host sits in the view tree and translates intents into the","type":"text"},{"text":" ","type":"text"},{"text":"matching environment action","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"subscribers observe outcomes through "},{"type":"codeVoice","code":"SceneStore.events"}]}]}]},{"text":"Declaring scenes in your App","type":"heading","level":2,"anchor":"Declaring-scenes-in-your-App"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["import SwiftUI","","import InnoRouter","import InnoRouterMacros","","@Routable","enum SpatialRoute {","    case main","    case theatre","}","","private let spatialScenes = SceneRegistry<SpatialRoute>(","    .window(.main, id: \"main\"),","    .immersive(.theatre, id: \"theatre\", style: .mixed)",")","","@main","struct MyApp: App {","    @State private var sceneStore = SceneStore<SpatialRoute>()","","    var body: some Scene {","        \/\/ Host-owned scene: SceneHost only. Do NOT also attach a","        \/\/ SceneAnchor here — the host already reconciles its own","        \/\/ scene's lifecycle, and a redundant anchor registers a","        \/\/ fallback dispatcher on the scene the host already owns.","        WindowGroup(id: \"main\", for: UUID.self) { $sceneID in","            ContentView()","                .innoRouterSceneHost(","                    sceneStore,","                    scenes: spatialScenes,","                    attachedTo: .main,","                    instanceID: sceneID","                )","        } defaultValue: {","            UUID()","        }","","        \/\/ Non-host scene: SceneAnchor only. Keeps the store's","        \/\/ inventory in sync with system-driven appear\/disappear and","        \/\/ can temporarily serve dismissals if the host scene is gone;","        \/\/ fallback opens are still limited to the same scene.","        ImmersiveSpace(id: \"theatre\") {","            TheatreView()","                .innoRouterSceneAnchor(","                    sceneStore,","                    scenes: spatialScenes,","                    attachedTo: .theatre","                )","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"The shared "},{"type":"codeVoice","code":"SceneRegistry"},{"type":"text","text":" keeps route-to-id mapping and declaration"},{"type":"text","text":" "},{"type":"text","text":"metadata in one place."}],"type":"paragraph"},{"text":"Which modifier goes where?","type":"heading","level":3,"anchor":"Which-modifier-goes-where"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Scene declaration","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"SceneHost"}]}],[{"type":"paragraph","inlineContent":[{"text":"Attach ","type":"text"},{"type":"codeVoice","code":"SceneAnchor"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app’s primary "},{"type":"codeVoice","code":"WindowGroup"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✅ exactly once"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌ redundant"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Secondary "},{"type":"codeVoice","code":"WindowGroup"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✅"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"ImmersiveSpace","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✅"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any scene that isn’t the host’s scene"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"❌"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"✅"}]}]]]},{"inlineContent":[{"type":"text","text":"A mnemonic: "},{"inlineContent":[{"type":"text","text":"“one host per store, one anchor per non-host scene”"}],"type":"strong"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"SceneHost"},{"type":"text","text":" is the single primary dispatcher; "},{"type":"codeVoice","code":"SceneAnchor"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"lifecycle reconciler that also serves as a restricted fallback"},{"type":"text","text":" "},{"type":"text","text":"dispatcher for its own scene. Fallback anchors are deliberately"},{"type":"text","text":" "},{"type":"text","text":"limited to same-scene opens and any dismissal — a cross-scene open"},{"type":"text","text":" "},{"type":"text","text":"arriving while the host is gone is rejected with"},{"type":"text","text":" "},{"type":"codeVoice","code":"SceneRejectionReason.fallbackCannotDispatch"},{"type":"text","text":" so the queue advances"},{"type":"text","text":" "},{"type":"text","text":"rather than silently succeeding on a scene the anchor can’t reach."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Window and volumetric host or anchor scenes use the "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" supplied by"},{"type":"text","text":" "},{"type":"text","text":"a value-based "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":"; immersive spaces keep the route-only"},{"type":"text","text":" "},{"type":"text","text":"overloads."}],"type":"paragraph"},{"text":"Opening and dismissing scenes","type":"heading","level":2,"anchor":"Opening-and-dismissing-scenes"},{"inlineContent":[{"text":"From anywhere that holds a reference to the store:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["\/\/ In the main window:","let mainWindow = sceneStore.openWindow(.main)","sceneStore.openImmersive(.theatre, style: .mixed)","","\/\/ Somewhere else later:","sceneStore.dismissWindow(mainWindow)","sceneStore.dismissImmersive()"]},{"inlineContent":[{"type":"codeVoice","code":"VolumetricSize"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ImmersiveStyle"},{"text":" are declaration-backed metadata,","type":"text"},{"text":" ","type":"text"},{"text":"not dynamic environment parameters. If a request’s kind, size, or","type":"text"},{"text":" ","type":"text"},{"text":"style does not match the registry entry, the host emits","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SceneEvent.rejected(.open(...), reason: .sceneDeclarationMismatch)"},{"text":" ","type":"text"},{"text":"and leaves the active scene inventory untouched.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"SceneHost"},{"type":"text","text":" modifier is the preferred primary dispatcher: it"},{"type":"text","text":" "},{"type":"text","text":"observes pending request tokens, claims work, dispatches through the"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI environment, and reports success back into the store."},{"type":"text","text":" "},{"type":"codeVoice","code":"SceneAnchor"},{"type":"text","text":" mirrors that dispatch loop as a fallback only when no"},{"type":"text","text":" "},{"type":"text","text":"explicit host is currently alive. If "},{"type":"codeVoice","code":"openImmersiveSpace"},{"type":"text","text":" returns"},{"type":"text","text":" "},{"type":"codeVoice","code":".userCancelled"},{"type":"text","text":" or "},{"type":"codeVoice","code":".error"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the host emits a"},{"type":"text","text":" "},{"type":"codeVoice","code":"SceneEvent.rejected(.open(.immersive(...)), reason: .environmentReturnedFailure)"},{"type":"text","text":" "},{"type":"text","text":"and leaves the active scene inventory untouched. "},{"type":"codeVoice","code":"currentScene"},{"type":"text","text":" remains"},{"type":"text","text":" "},{"type":"text","text":"a recency-ordered summary of that inventory, while "},{"type":"codeVoice","code":"activeScenes"},{"type":"text","text":" "},{"type":"text","text":"exposes the full inventory. Calling "},{"type":"codeVoice","code":"dismissImmersive()"},{"type":"text","text":" without an active"},{"type":"text","text":" "},{"type":"text","text":"immersive scene emits"},{"type":"text","text":" "},{"type":"codeVoice","code":"SceneEvent.rejected(.dismissImmersive, reason: .nothingActive)"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"SceneAnchor"},{"type":"text","text":" still never emits public lifecycle events; it reconciles"},{"type":"text","text":" "},{"type":"text","text":"inventory when the system opens or closes a scene outside the store’s"},{"type":"text","text":" "},{"type":"text","text":"explicit command path and can temporarily forward commands while the"},{"type":"text","text":" "},{"type":"text","text":"preferred host scene is gone."}],"type":"paragraph"},{"text":"Observing lifecycle through `events`","type":"heading","level":2,"anchor":"Observing-lifecycle-through-events"},{"inlineContent":[{"code":"SceneStore.events","type":"codeVoice"},{"type":"text","text":" is an "},{"code":"AsyncStream<SceneEvent<R>>","type":"codeVoice"},{"type":"text","text":" that mirrors"},{"type":"text","text":" "},{"type":"text","text":"the "},{"code":"events","type":"codeVoice"},{"type":"text","text":" channel shipped by "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" and "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["Task {","    for await event in sceneStore.events {","        analytics.record(event)","    }","}"]},{"inlineContent":[{"type":"text","text":"The event taxonomy ("},{"type":"codeVoice","code":"presented"},{"type":"text","text":", "},{"type":"codeVoice","code":"dismissed"},{"type":"text","text":", "},{"type":"codeVoice","code":"rejected"},{"type":"text","text":") is"},{"type":"text","text":" "},{"type":"text","text":"deliberately minimal. Rejections carry the original "},{"type":"codeVoice","code":"SceneIntent"},{"type":"text","text":" so"},{"type":"text","text":" "},{"type":"text","text":"subscribers can distinguish undeclared routes, declaration mismatches,"},{"type":"text","text":" "},{"type":"text","text":"stale window handles, and environment failures without synthesising"},{"type":"text","text":" "},{"type":"text","text":"placeholder routes."}],"type":"paragraph"},{"text":"Ornaments on any platform","type":"heading","level":2,"anchor":"Ornaments-on-any-platform"},{"inlineContent":[{"type":"codeVoice","code":"View.innoRouterOrnament(_:content:)"},{"type":"text","text":" attaches an ornament on"},{"type":"text","text":" "},{"type":"text","text":"visionOS (delegating to SwiftUI’s"},{"type":"text","text":" "},{"code":"ornament(attachmentAnchor:contentAlignment:ornament:)","type":"codeVoice"},{"type":"text","text":") and"},{"type":"text","text":" "},{"type":"text","text":"degrades to a no-op on every other platform. That keeps call sites"},{"type":"text","text":" "},{"type":"text","text":"unconditional:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["ContentView()","    .innoRouterOrnament(OrnamentAnchor(anchor: .bottom, alignment: .center)) {","        ControlBar()","    }"]},{"inlineContent":[{"code":"OrnamentAnchor","type":"codeVoice"},{"text":" lives in ","type":"text"},{"code":"InnoRouterCore","type":"codeVoice"},{"text":" so ornament placement is","type":"text"},{"text":" ","type":"text"},{"text":"serialisable and testable on platforms that never materialise the","type":"text"},{"text":" ","type":"text"},{"text":"visual effect.","type":"text"}],"type":"paragraph"},{"text":"Composing with `FlowStore`","type":"heading","level":2,"anchor":"Composing-with-FlowStore"},{"inlineContent":[{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":" is intentionally "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" composed into "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"RouteStep"},{"type":"text","text":" captures transitions inside a single scene (push \/ sheet"},{"type":"text","text":" "},{"type":"text","text":"\/ cover); spatial presentations are multi-scene events and would"},{"type":"text","text":" "},{"type":"text","text":"break the "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" contract. Apps that need both simply own a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore<R>"},{"type":"text","text":" and a "},{"type":"codeVoice","code":"SceneStore<R>"},{"type":"text","text":" side-by-side — the "},{"type":"codeVoice","code":"R"},{"type":"text","text":" can be"},{"type":"text","text":" "},{"type":"text","text":"the same route enum or two distinct enums, depending on whether the"},{"type":"text","text":" "},{"type":"text","text":"spatial surface shares routes with the primary flow."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Coordinate visionOS spatial presentations through "},{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"SceneHost"},{"type":"text","text":", and "},{"type":"codeVoice","code":"innoRouterOrnament"},{"type":"text","text":"."}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"role":"collection","abstract":[],"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","kind":"article","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","title":"InnoRouterSwiftUI","role":"collectionGroup"}}}