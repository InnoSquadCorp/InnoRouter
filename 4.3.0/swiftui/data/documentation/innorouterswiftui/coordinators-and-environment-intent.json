{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Coordinators-and-Environment-Intent"},"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Coordinators in InnoRouter are SwiftUI-adapted reference authorities, not UIKit-era imperative routers.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Coordinator role","anchor":"Coordinator-role","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" exists for cases where view intent should flow through a policy object before it reaches the store."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"A coordinator:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"receives "},{"code":"NavigationIntent","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"decides whether to forward, rewrite, or replace commands","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"maps routes to destinations","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"stays observable for SwiftUI"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"Coordinator"},{"text":" remains ","type":"text"},{"type":"codeVoice","code":"AnyObject"},{"text":" by design because it is a shared authority object, not ephemeral view state.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Environment intent","anchor":"Environment-intent","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"EnvironmentNavigationIntent"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"EnvironmentModalIntent"},{"text":" are the primary view-facing APIs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This keeps view code declarative:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"child views do not need a direct store reference","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"fail-fast behavior catches host wiring mistakes early"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"multi-host trees can keep separate routing authorities in the same hierarchy"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":3,"text":"Sibling hosts and duplicate registration","anchor":"Sibling-hosts-and-duplicate-registration","type":"heading"},{"inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" owns its own"},{"type":"text","text":" "},{"type":"codeVoice","code":"*EnvironmentStorage"},{"type":"text","text":" instance through "},{"type":"codeVoice","code":"@State"},{"type":"text","text":", so SwiftUI scopes the"},{"type":"text","text":" "},{"type":"text","text":"handler table to the host’s view subtree. Re-registering the"},{"type":"text","text":" "},{"type":"text","text":"same routing authority is allowed across SwiftUI updates, even when"},{"type":"text","text":" "},{"type":"text","text":"the forwarding closure is freshly allocated. A sibling host with a"},{"type":"text","text":" "},{"type":"text","text":"different authority that registers against the same "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" type in"},{"type":"text","text":" "},{"type":"text","text":"the same environment scope is treated as a wiring bug: in Debug"},{"type":"text","text":" "},{"type":"text","text":"builds the storage setter traps with "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":", and in"},{"type":"text","text":" "},{"type":"text","text":"Release it logs an error through the "},{"type":"codeVoice","code":"duplicate-dispatcher"},{"type":"text","text":" "},{"type":"codeVoice","code":"os_log"},{"type":"text","text":" category before letting the overwrite proceed (preserving"},{"type":"text","text":" "},{"type":"text","text":"prior behaviour for production cold-starts)."}],"type":"paragraph"},{"inlineContent":[{"text":"If two surfaces legitimately need different routing authorities,","type":"text"},{"text":" ","type":"text"},{"text":"either give them distinct ","type":"text"},{"type":"codeVoice","code":"Route"},{"text":" types or scope them with separate","type":"text"},{"text":" ","type":"text"},{"text":"environment subtrees so each host gets its own storage.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Low-level tests or custom integrations that write directly into an","type":"text"},{"text":" ","type":"text"},{"text":"environment storage should either assign a handler once per storage","type":"text"},{"text":" ","type":"text"},{"text":"instance, or call the explicit owner registration helper with a stable","type":"text"},{"text":" ","type":"text"},{"text":"store \/ coordinator identity. The host modifiers do this for normal","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationHost"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ModalHost"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"FlowHost"},{"text":" usage.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Flow-and-tab-coordinators","text":"Flow and tab coordinators","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"FlowCoordinator"},{"type":"text","text":" and "},{"type":"codeVoice","code":"TabCoordinator"},{"type":"text","text":" complement "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":"; they do not replace it."}],"type":"paragraph"},{"inlineContent":[{"text":"Recommended mental model:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" owns route-stack authority"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"TabCoordinator"},{"type":"text","text":" owns shell tab state"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FlowCoordinator"},{"type":"text","text":" owns local step state inside a destination"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Use composition rather than trying to collapse all three responsibilities into one type.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/coordinators-and-environment-intent"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article","title":"Coordinators and environment intent"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"role":"collection","abstract":[],"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","kind":"article","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","title":"InnoRouterSwiftUI","role":"collectionGroup"}}}