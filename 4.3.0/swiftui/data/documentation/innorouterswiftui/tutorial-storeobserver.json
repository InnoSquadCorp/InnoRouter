{"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-StoreObserver","interfaceLanguage":"swift"},"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"code":"StoreObserver","type":"codeVoice"},{"text":" is a thin protocol adapter over the ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" that every InnoRouter store publishes. Use it when","type":"text"},{"text":" ","type":"text"},{"text":"protocol dispatch reads clearer than a ","type":"text"},{"code":"for await","type":"codeVoice"},{"text":" loop — typically","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in AppDelegate wiring, analytics adapters, or anywhere you want"},{"type":"text","text":" "},{"type":"text","text":"static methods instead of iterator plumbing."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Scenario","anchor":"Scenario","type":"heading"},{"inlineContent":[{"type":"text","text":"An analytics adapter wants to react to every navigation change,"},{"type":"text","text":" "},{"type":"text","text":"modal present, and flow path rewrite. Writing three "},{"type":"codeVoice","code":"for await"},{"type":"text","text":" "},{"type":"text","text":"loops, one per store, reads noisy. "},{"type":"codeVoice","code":"StoreObserver"},{"type":"text","text":" lets the adapter"},{"type":"text","text":" "},{"type":"text","text":"implement three typed "},{"type":"codeVoice","code":"handle(_:)"},{"type":"text","text":" methods and subscribe once per"},{"type":"text","text":" "},{"type":"text","text":"store."}],"type":"paragraph"},{"level":2,"text":"Implementation","type":"heading","anchor":"Implementation"},{"code":["@MainActor","final class AnalyticsObserver: StoreObserver {","    typealias RouteType = AppRoute","","    func handle(_ event: NavigationEvent<AppRoute>) {","        if case .changed(_, let to) = event {","            Analytics.track(\"nav_change\", [\"path\": to.path.description])","        }","    }","","    func handle(_ event: ModalEvent<AppRoute>) {","        if case .presented(let presentation) = event {","            Analytics.track(\"modal_open\", [\"route\": \"\\(presentation.route)\"])","        }","    }","","    func handle(_ event: FlowEvent<AppRoute>) {","        if case .intentRejected(_, let reason) = event {","            Analytics.track(\"flow_rejected\", [\"reason\": \"\\(reason)\"])","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"Any subset of the three ","type":"text"},{"type":"codeVoice","code":"handle(_:)"},{"text":" methods is fine — the others","type":"text"},{"text":" ","type":"text"},{"text":"default to no-ops via a protocol extension.","type":"text"}]},{"level":2,"text":"Attaching","type":"heading","anchor":"Attaching"},{"code":["let observer = AnalyticsObserver()","let navSubscription = navigationStore.observe(observer)","let modalSubscription = modalStore.observe(observer)","let flowSubscription = flowStore.observe(observer)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"observe(_:)"},{"text":" returns a ","type":"text"},{"type":"codeVoice","code":"StoreObserverSubscription"},{"text":". Keep it","type":"text"},{"text":" ","type":"text"},{"text":"around for the observer’s lifetime; when the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"StoreObserverSubscription"},{"text":" itself is deinitialized it auto-cancels","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"type":"codeVoice","code":"isolated deinit"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To stop observing early:"}]},{"code":["navSubscription.cancel()"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Subsequent store events are not delivered to the observer."}]},{"level":2,"text":"FlowStore routing","type":"heading","anchor":"FlowStore-routing"},{"type":"paragraph","inlineContent":[{"code":"FlowStore.observe(_:)","type":"codeVoice"},{"type":"text","text":" is special: it iterates the flow’s"},{"type":"text","text":" "},{"code":"events","type":"codeVoice"},{"type":"text","text":" stream (which already wraps inner navigation \/ modal"},{"type":"text","text":" "},{"type":"text","text":"emissions) and routes them through the observer’s matching typed"},{"type":"text","text":" "},{"code":"handle(_:)","type":"codeVoice"},{"type":"text","text":" overload. One subscription covers all three authorities"},{"type":"text","text":" "},{"type":"text","text":"on a flow surface."}]},{"code":["let flowSubscription = flowStore.observe(observer)","\/\/ observer.handle(.navigation(.changed(…))) → observer.handle(_:NavigationEvent)","\/\/ observer.handle(.modal(.presented(…)))    → observer.handle(_:ModalEvent)","\/\/ observer.handle(.pathChanged(…))          → observer.handle(_:FlowEvent)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"level":2,"text":"When to reach for `for await` instead","type":"heading","anchor":"When-to-reach-for-for-await-instead"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the raw "},{"code":"events","type":"codeVoice"},{"type":"text","text":" stream when:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"cancellation flow needs to compose with other async sequences","type":"text"},{"text":" ","type":"text"},{"text":"(combine, merge, retry, …)","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the handler body wants to ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" inside an event (e.g. log to","type":"text"},{"text":" ","type":"text"},{"text":"a remote service and gate subsequent events on the response)","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"events feed a structured concurrency pipeline with explicit task","type":"text"},{"text":" ","type":"text"},{"text":"lifetimes","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"StoreObserver"},{"text":" when:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the adapter is a long-lived object (analytics, crash reporting)","type":"text"},{"text":" ","type":"text"},{"text":"and protocol methods read clearer than an iterator loop","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"multiple stores feed the same observer with typed dispatch","type":"text"}]}]}]},{"level":2,"text":"Multiple observers","type":"heading","anchor":"Multiple-observers"},{"type":"paragraph","inlineContent":[{"text":"Every ","type":"text"},{"code":"observe(_:)","type":"codeVoice"},{"text":" call creates an independent subscription, so","type":"text"},{"text":" ","type":"text"},{"text":"multiple observers on the same store all receive the same events.","type":"text"},{"text":" ","type":"text"},{"text":"Fan-out is free — the underlying ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" multicasts","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"code":"EventBroadcaster","type":"codeVoice"},{"text":".","type":"text"}]},{"level":2,"text":"Next steps","type":"heading","anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling","isActive":true},{"type":"text","text":" for one more use case — observing"},{"type":"text","text":" "},{"type":"text","text":"throttle cancellations through the same protocol dispatch."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","type":"reference","isActive":true},{"type":"text","text":" for pre-execution hooks"},{"type":"text","text":" "},{"type":"text","text":"that complement post-execution observation."}]}]}]}]}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-storeobserver"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Observing Stores via Protocol Adapters","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","kind":"article","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","title":"InnoRouterSwiftUI","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"role":"collection","abstract":[],"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MiddlewareCompo