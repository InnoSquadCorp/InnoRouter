ion.isCommitted else {","    \/\/ Stack is back to its pre-transaction state; show error.","    return","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use when leaving the user on a half-rolled-out screen would be"},{"type":"text","text":" "},{"type":"text","text":"worse than showing a “please retry” message."}]},{"anchor":"Async-debounce-on-a-search-field","type":"heading","level":3,"text":"Async debounce on a search field"},{"code":["let debouncing = DebouncingNavigator(","    wrapping: store,","    interval: .milliseconds(300)",")","\/\/ Each keystroke calls debouncedExecute; only the latest survives.","await debouncing.debouncedExecute(.replace([.searchResults(query: q)]))"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use when the user is generating commands faster than the"},{"type":"text","text":" "},{"type":"text","text":"navigation surface should react."}]},{"anchor":"Anti-patterns","type":"heading","level":2,"text":"Anti-patterns"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wrapping "},{"type":"codeVoice","code":"executeBatch"},{"type":"text","text":" in another "},{"type":"codeVoice","code":"executeBatch"},{"type":"text","text":" to “compose”"},{"type":"text","text":" "},{"type":"text","text":"events."}]},{"type":"text","text":" Use "},{"type":"codeVoice","code":".sequence"},{"type":"text","text":" inside one batch instead."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Calling ","type":"text"},{"code":"executeTransaction","type":"codeVoice"},{"text":" for analytics-clean grouping.","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"The shadow-state cost is wasted; reach for "},{"code":"executeBatch","type":"codeVoice"},{"type":"text","text":"."}]}]},