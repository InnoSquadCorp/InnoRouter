{"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-loginonboarding"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","roleHeading":"Article","title":"Building a Login Onboarding Flow","modules":[{"name":"InnoRouterTesting"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Scenario","level":2,"text":"Scenario"},{"type":"paragraph","inlineContent":[{"text":"The app launches on a welcome screen. Tapping ","type":"text"},{"inlineContent":[{"type":"text","text":"Continue"}],"type":"emphasis"},{"text":" pushes a","type":"text"},{"text":" ","type":"text"},{"text":"pre-auth detail screen. Tapping ","type":"text"},{"inlineContent":[{"type":"text","text":"Create account"}],"type":"emphasis"},{"text":" presents a signup","type":"text"},{"text":" ","type":"text"},{"text":"sheet. When the signup finishes (or is cancelled) the parent flow","type":"text"},{"text":" ","type":"text"},{"text":"resumes — either navigating to ","type":"text"},{"code":".home(user)","type":"codeVoice"},{"text":" or staying put.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modeling this with raw "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" + "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" means two"},{"type":"text","text":" "},{"type":"text","text":"authority objects, two view-layer hosts, and hand-rolled"},{"type":"text","text":" "},{"type":"text","text":"continuation plumbing to surface the sheet result back to the"},{"type":"text","text":" "},{"type":"text","text":"parent. "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" + "},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" collapse this to a single"},{"type":"text","text":" "},{"type":"text","text":"store and one "},{"code":"await","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Routes","level":2,"text":"Routes"},{"code":["enum AppRoute: Route {","    case welcome","    case preAuth","    case signup","    case home(UserID)","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"heading","anchor":"Wiring-the-flow-host","level":2,"text":"Wiring the flow host"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" composes an inner "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" over a "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"exposes both authorities through a single "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":":"}]},{"code":["@main","struct DemoApp: App {","    @State private var flow = FlowStore<AppRoute>(initial: [.push(.welcome)])","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: flow,","                destination: destination,","                root: { WelcomeRootView() }","            )","        }","    }","","    @ViewBuilder","    private func destination(_ route: AppRoute) -> some View {","        switch route {","        case .welcome:","            WelcomeRootView()","        case .preAuth:","            PreAuthDetailView()","        case .signup:","            SignUpView()","        case .home(let id):","            HomeView(userID: id)","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"heading","anchor":"Emitting-intents-from-views","level":2,"text":"Emitting intents from views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views never mutate "},{"type":"codeVoice","code":"FlowStore.path"},{"type":"text","text":" directly; they emit"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowIntent"},{"type":"text","text":" values through the environment dispatcher so"},{"type":"text","text":" "},{"type":"text","text":"middleware and telemetry observe every step:"}]},{"code":["struct WelcomeRootView: View {","    @EnvironmentFlowIntent<AppRoute> private var flow","","    var body: some View {","        VStack {","            Button(\"Continue\") {","                flow.send(.push(.preAuth))","            }","            Button(\"Create account\") {","                flow.send(.presentSheet(.signup))","            }","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"heading","anchor":"Awaiting-a-signup-sub-flow","level":2,"text":"Awaiting a signup sub-flow"},{"type":"paragraph","inlineContent":[{"text":"The signup sheet opens its own ","type":"text"},{"code":"Coordinator","type":"codeVoice"},{"text":" that owns the step","type":"text"},{"text":" ","type":"text"},{"text":"progression (email → password → confirmation). The outer","type":"text"},{"text":" ","type":"text"},{"text":"onboarding coordinator launches it via ","type":"text"},{"code":"push(child:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"await","type":"codeVoice"},{"text":"s","type":"text"},{"text":" ","type":"text"},{"text":"the final ","type":"text"},{"code":"UserID","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["@MainActor","final class SignUpCoordinator: ChildCoordinator {","    typealias Result = UserID","    typealias RouteType = AppRoute","","    \/\/ ...step state + methods omitted","","    func userDidCreateAccount(_ userID: UserID) {","        onFinish(userID)   \/\/ emits the result back to the parent","    }","","    func userCancelled() {","        onCancel()          \/\/ parent sees nil","    }","}","","@MainActor","final class OnboardingCoordinator: Coordinator {","    typealias RouteType = AppRoute","    let navigationStore: NavigationStore<AppRoute>","","    func startSignUpFlow() async {","        let result = await push(child: SignUpCoordinator())","        if let userID = result {","            navigationStore.send(.go(.home