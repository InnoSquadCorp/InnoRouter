"type":"codeVoice"},{"text":", ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"text":")","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Migration-FromTCA","interfaceLanguage":"swift"},"sections":[],"kind":"article","abstract":[{"text":"This guide walks a TCA project through replacing its navigation","type":"text"},{"text":" ","type":"text"},{"text":"layer with InnoRouter while keeping the rest of the architecture","type":"text"},{"text":" ","type":"text"},{"text":"(reducers, effects, state) intact. InnoRouter is ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"replacement for TCA’s reducer composition — it replaces the","type":"text"},{"text":" ","type":"text"},{"text":"parts of TCA that own ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation state"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"modal authority"}],"type":"emphasis"},{"text":".","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"article","title":"Migrating navigation from TCA to InnoRouter","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/migration-fromtca"]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"type":"topic","iden