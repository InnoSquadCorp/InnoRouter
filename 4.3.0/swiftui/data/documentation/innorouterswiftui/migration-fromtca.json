{"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"content":[{"level":2,"text":"Why this migration","anchor":"Why-this-migration","type":"heading"},{"inlineContent":[{"type":"text","text":"TCA’s navigation surface ("},{"type":"codeVoice","code":"StackState<Element>"},{"type":"text","text":", "},{"type":"codeVoice","code":"@Presents"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStackStore"},{"type":"text","text":") bundles three responsibilities:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State authority"}]},{"type":"text","text":" — what is on the stack, what modal is up."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Action plumbing"}],"type":"strong"},{"text":" — ","type":"text"},{"code":"Action.path(.push(...))","type":"codeVoice"},{"text":", ","type":"text"},{"code":"delegate","type":"codeVoice"},{"text":" ","type":"text"},{"text":"actions, ","type":"text"},{"code":".dismiss","type":"codeVoice"},{"text":" from the parent.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View binding"}]},{"type":"text","text":" — "},{"code":"NavigationStackStore","type":"codeVoice"},{"type":"text","text":" translates child"},{"type":"text","text":" "},{"type":"text","text":"stores into "},{"code":"NavigationLink","type":"codeVoice"},{"type":"text","text":"s."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"InnoRouter takes ownership of (1) and (3) and replaces (2)","type":"text"},{"text":" ","type":"text"},{"text":"with a typed ","type":"text"},{"type":"codeVoice","code":"NavigationIntent"},{"text":" enum that flows through the","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI environment. The reducer surface shrinks because the","type":"text"},{"text":" ","type":"text"},{"text":"parent reducer no longer needs to forward navigation actions","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"type":"codeVoice","code":"StackState"},{"text":" mutations.","type":"text"}],"type":"paragraph"},{"level":2,"text":"The minimal swap","anchor":"The-minimal-swap","type":"heading"},{"inlineContent":[{"text":"A canonical TCA navigation feature looks like this:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable {","        var path = StackState<Path.State>()","    }","","    enum Action {","        case path(StackActionOf<Path>)","    }","","    @Reducer","    struct Path {","        enum State: Equatable { case detail(DetailFeature.State) }","        enum Action { case detail(DetailFeature.Action) }","        var body: some ReducerOf<Self> {","            Scope(state: \\.detail, action: \\.detail) { DetailFeature() }","        }","    }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","            .forEach(\\.path, action: \\.path) { Path() }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        NavigationStackStore(store.scope(state: \\.path, action: \\.path)) {","            RootView(store: store)","        } destination: { store in","            switch store.state {","            case .detail:","                if let detail = store.scope(state: \\.detail, action: \\.detail) {","                    DetailView(store: detail)","                }","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"After migration:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@Routable","enum AppRoute: Route {","    case detail(DetailFeature.State.ID)","}","","@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable { \/* business state only *\/ }","","    enum Action { \/* business actions only *\/ }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","    @State private var navigationStore = NavigationStore<AppRoute>()","","    var body: some View {","        NavigationHost(store: navigationStore) {","            RootView(store: store)","        } destination: { route in","            switch route {","            case .detail(let id):","                DetailView(\/* hydrate from id *\/)","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Three things changed:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The reducer’s ","type":"text"},{"type":"codeVoice","code":"path: StackState<Path.State>"},{"text":" is gone — the","type":"text"},{"text":" ","type":"text"},{"text":"parent reducer no longer carries navigation state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The parent action enum no longer routes"},{"type":"text","text":" "},{"code":"case path(StackActionOf<Path>)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The view uses ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"NavigationStore<AppRoute>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"in place of ","type":"text"},{"code":"NavigationStackStore","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"Path","type":"codeVoice"},{"text":" reducer","type":"text"},{"text":" ","type":"text"},{"text":"composition.","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Modal-presentation-Presents-%E2%86%92-ModalStore","text":"Modal presentation (`@Presents` → `ModalStore`)","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TCA’s "},{"type":"codeVoice","code":"@Presents"},{"type":"text","text":" is conceptually equivalent to a "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" "},{"type":"text","text":"slot. Replace:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@ObservableState","struct State {","    @Presents var sheet: SheetFeature.State?","}","","enum Action {","    case sheet(PresentationAction<SheetFeature.Action>)","}","","\/\/ View",".sheet(item: $store.scope(state: \\.sheet, action: \\.sheet)) { … }"]},{"type":"paragraph","inlineContent":[{"text":"with:","type":"text"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["\/\/ State + Action no longer carry the modal slot.","","\/\/ View","ModalHost(store: modalStore) { route in","    switch route { case .sheet: SheetView(…) }","}"]},{"type":"paragraph","inlineContent":[{"text":"The reducer no longer fires ","type":"text"},{"code":"Action.sheet(.presented(…))","type":"codeVoice"},{"text":"; the","type":"text"},{"text":" ","type":"text"},{"text":"view dispatches ","type":"text"},{"code":"flowStore.send(.presentSheet(.sheet))","type":"codeVoice"},{"text":" directly","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"code":"@EnvironmentFlowIntent","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"Stack-+-modal-as-one-value-StackState-+-Presents-%E2%86%92-FlowStore","text":"Stack + modal as one value (`StackState` + `@Presents` → `FlowStore`)","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"If a feature uses both navigation and modal authority, replace","type":"text"},{"text":" ","type":"text"},{"text":"both with a single ","type":"text"},{"code":"FlowStore<Route>","type":"codeVoice"},{"text":" and observe ","type":"text"},{"code":"path: [RouteStep<Route>]","type":"codeVoice"},{"text":" as the single source of truth. The","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" value type makes the entire flow state Codable for","type":"text"},{"text":" ","type":"text"},{"text":"deep-link rehydration and state restoration.","type":"text"}]},{"anchor":"Testing-TestStore-%E2%86%92-NavigationTestStore--FlowTestStore","text":"Testing — `TestStore` → `NavigationTestStore` \/ `FlowTestStore`","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" ships host-less test stores that mirror"},{"type":"text","text":" "},{"type":"text","text":"TCA’s strict-exhaustivity ergonomics. Swap:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let testStore = TestStore(initialState: AppFeature.State()) { AppFeature() }","await testStore.send(.path(.push(id: 0, state: .detail(...))))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"with:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let test = NavigationTestStore<AppRoute>()","test.execute(.push(.detail(id)))","test.expect(state: [.detail(id)])"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The test store keeps any analytics \/ diagnostic callbacks the"},{"type":"text","text":" "},{"type":"text","text":"production store wired through "},{"type":"codeVoice","code":"NavigationStoreConfiguration"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so the test asserts production telemetry without"},{"type":"text","text":" "},{"type":"codeVoice","code":"@testable import"},{"type":"text","text":"."}]},{"anchor":"What-stays-in-TCA","text":"What stays in TCA","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter explicitly does "},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"type":"text","text":" replace:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Business logic reducers ("},{"type":"codeVoice","code":"Reduce { state, action in … }"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Side effects ("},{"type":"codeVoice","code":"Effect.send"},{"type":"text","text":", "},{"type":"codeVoice","code":"Effect.run"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dependency injection ("},{"code":"@Dependency","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Cross-feature coordination (parent ⇄ child reducer composition"},{"type":"text","text":" "},{"type":"text","text":"for non-navigation concerns)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical migrated codebase keeps every reducer in place; the"},{"type":"text","text":" "},{"type":"text","text":"delta is the state slots and actions removed because navigation"},{"type":"text","text":" "},{"type":"text","text":"no longer needs reducer-level modeling."}]},{"anchor":"Migration-sequence","text":"Migration sequence","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Start with a leaf feature whose navigation state lives only"},{"type":"text","text":" "},{"type":"text","text":"in the parent reducer’s "},{"type":"codeVoice","code":"StackState"},{"type":"text","text":". Replace its view-layer"},{"type":"text","text":" "},{"type":"text","text":"wiring with "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" + "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Strip the matching ","type":"text"},{"code":"path","type":"codeVoice"},{"text":" slot and ","type":"text"},{"code":"Path","type":"codeVoice"},{"text":" reducer from the","type":"text"},{"text":" ","type":"text"},{"text":"parent reducer. Verify the existing tests still pass against","type":"text"},{"text":" ","type":"text"},{"text":"the trimmed reducer state.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Repeat per feature. The blast radius per migration is"},{"type":"text","text":" "},{"type":"text","text":"contained because each "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" is independent."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Tackle modal authority feature-by-feature once the navigation","type":"text"},{"text":" ","type":"text"},{"text":"stacks are ported. ","type":"text"},{"code":"@Presents","type":"codeVoice"},{"text":" is the cheapest swap.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"For features with both stack and modal authority, migrate"},{"type":"text","text":" "},{"type":"text","text":"them last by lifting the combined state into "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"capturing the deep-link flow through "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"orderedList"},{"anchor":"Common-pitfalls","text":"Common pitfalls","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Action forwarding instinct.","type":"text"}],"type":"strong"},{"text":" TCA users habitually plumb","type":"text"},{"text":" ","type":"text"},{"text":"navigation through actions even when the feature doesn’t need","type":"text"},{"text":" ","type":"text"},{"text":"it. With ","type":"text"},{"code":"@EnvironmentNavigationIntent","type":"codeVoice"},{"text":", the view dispatches","type":"text"},{"text":" ","type":"text"},{"text":"intents directly; the reducer never sees a navigation action","type":"text"},{"text":" ","type":"text"},{"text":"unless you explicitly want to gate one through middleware.","type":"text"}]}]},{"conten