{"abstract":[{"text":"Match a URL, apply an authentication policy, and produce a","type":"text"},{"text":" ","type":"text"},{"code":"NavigationPlan","type":"codeVoice"},{"text":" that ","type":"text"},{"code":"NavigationStore.executeBatch","type":"codeVoice"},{"text":" applies in one","type":"text"},{"text":" ","type":"text"},{"text":"observable step. Queue the deep link while the user is signed out,","type":"text"},{"text":" ","type":"text"},{"text":"replay it after sign-in, and surface cancellation reasons through","type":"text"},{"text":" ","type":"text"},{"text":"typed outcomes.","type":"text"}],"kind":"article","variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Scenario","type":"heading","anchor":"Scenario"},{"inlineContent":[{"code":"myapp:\/\/order\/42","type":"codeVoice"},{"text":" should land the user on the order detail for","type":"text"},{"text":" ","type":"text"},{"text":"order 42, but only when they’re signed in. If the link arrives","type":"text"},{"text":" ","type":"text"},{"text":"while signed out, the app must remember it, route through the","type":"text"},{"text":" ","type":"text"},{"text":"sign-in flow, and then replay it — without dropping the original","type":"text"},{"text":" ","type":"text"},{"text":"URL context.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Modeling the routes","type":"heading","anchor":"Modeling-the-routes"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["enum AppRoute: Route {","    case home","    case signIn","    case order(id: String)","}"]},{"level":2,"text":"Wiring the pipeline","type":"heading","anchor":"Wiring-the-pipeline"},{"inlineContent":[{"code":"DeepLinkPipeline","type":"codeVoice"},{"text":" owns the match-then-validate-then-authorize flow:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let matcher = DeepLinkMatcher<AppRoute>(patterns: [","    .init(pattern: \"myapp:\/\/home\")                   { _ in .home },","    .init(pattern: \"myapp:\/\/signin\")                 { _ in .signIn },","    .init(pattern: \"myapp:\/\/order\/:id\")              { params in","        guard let id = params[\"id\"] else { return nil }","        return .order(id: id)","    },","])","","let policy: DeepLinkAuthenticationPolicy<AppRoute> = { route, isAuthenticated in","    switch route {","    case .home, .signIn:","        return .proceed","    case .order where !isAuthenticated:","        return .defer \/\/ the pipeline will queue a PendingDeepLink","    case .order:","        return .proceed","    }","}","","let pipeline = DeepLinkPipeline(matcher: matcher, policy: policy)"]},{"level":2,"text":"Handling a URL","type":"heading","anchor":"Handling-a-URL"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DeepLinkEffectHandler"},{"type":"text","text":" bridges the pipeline output into"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@MainActor","final class AppCoordinator {","    let store: NavigationStore<AppRoute>","    let pipeline: DeepLinkPipeline<AppRoute>","    let effectHandler: DeepLinkEffectHandler<AppRoute>","","    func handle(_ url: URL, isAuthenticated: Bool) {","        let outcome = pipeline.process(url: url, isAuthenticated: isAuthenticated)","","        switch outcome {","        case .plan(let plan):","            _ = store.executeBatch(plan.commands)","        case .pending(let pending):","            effectHandler.retain(pending)","            store.send(.go(.signIn))","        case .rejected(let reason):","            Log.warning(\"deep link rejected: \\(reason)\")","        case .unhandled(let url):","            Log.warning(\"deep link unhandled: \\(url)\")","        }","    }","}"]},{"level":2,"text":"Replaying after sign-in","type":"heading","anchor":"Replaying-after-sign-in"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once the user signs in, the handler resumes any queued deep link:"}]},{"syntax":"swift skip doc-fragment","code":["func userDidSignIn() {","    effectHandler.resumePendingDeepLinkIfAllowed(","        isAuthenticated: true,","        executor: { plan in","            _ = store.executeBatch(plan.commands)","        }","    )","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The handler consults the retained ","type":"text"},{"type":"codeVoice","code":"PendingDeepLink"},{"text":", re-evaluates","type":"text"},{"text":" ","type":"text"},{"text":"the authentication policy, and only commits the batch if the new","type":"text"},{"text":" ","type":"text"},{"text":"state now permits the original URL. Any stale pending link (one","type":"text"},{"text":" ","type":"text"},{"text":"the user cancelled or that no longer validates) is dropped.","type":"text"}]},{"level":2,"anchor":"Observing-the-reconciliation","type":"heading","text":"Observing the reconciliation"},{"type":"paragraph","inlineContent":[{"code":"NavigationStore.events","type":"codeVoice"},{"text":" exposes the full sequence of batch +","type":"text"},{"text":" ","type":"text"},{"text":"path-mismatch events as a single stream, which is handy for","type":"text"},{"text":" ","type":"text"},{"text":"diagnostics dashboards:","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["Task {","    for await event in store.events {","        switch event {","        case .batchExecuted(let result):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .pathMismatch(let event):","            analytics.track(\"deep_link_mismatch\", [","                \"policy\": event.policy.rawValue,","                \"old\": event.oldPath.map(String.init(describing:)),","                \"new\": event.newPath.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Testing-the-chain","type":"heading","text":"Testing the chain"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTestStore"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":") asserts the batch +"},{"type":"text","text":" "},{"type":"text","text":"side effects for each branch:"}]},{"syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func signedOutDeepLinkDefersUntilSignIn() {","    let store = NavigationTestStore<AppRoute>()","    \/\/ ...pipeline + handler wired to `store.store`","    pipeline.handle(URL(string: \"myapp:\/\/order\/42\")!, isAuthenticated: false)","","    store.receiveChange { _, new in new.path == [.signIn] }","    \/\/ Pending deep link remains queued; no .batchExecuted yet.","}"],"type":"codeListing"},{"level":2,"anchor":"Next-steps","type":"heading","text":"Next steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","type":"reference","isActive":true},{"text":" for how the sign-in flow that","type":"text"},{"text":" ","type":"text"},{"text":"replays this deep link is modelled.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts","isActive":true,"type":"reference"},{"text":" if the existing app","type":"text"},{"text":" ","type":"text"},{"text":"still uses ","type":"text"},{"code":"ModalHost { NavigationHost { ... } }","type":"codeVoice"},{"text":" pairs.","type":"text"}],"type":"paragraph"}]}]}]}],"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"title":"Reconciling Deep Links End-to-End","roleHeading":"Article"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"abstract":[{"text":"Compose push, sheet, and cover steps into a single serializable flow with ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", then scope the signup sub-flow through a ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":" and await its result inline.","type":"text"}],"kind":"article","type":"topic","title":"Building a Login Onboarding Flow","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"role":"collection","abstract":[],"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"type":"topic","identifier":"doc:\/\/com.innosq