{"abstract":[{"text":"Rate-limit navigation commands without threading timestamps through","type":"text"},{"text":" ","type":"text"},{"text":"every call site. ","type":"text"},{"code":"ThrottleNavigationMiddleware","type":"codeVoice"},{"text":" cancels commands that","type":"text"},{"text":" ","type":"text"},{"text":"arrive within a minimum interval of a previously accepted command","type":"text"},{"text":" ","type":"text"},{"text":"sharing the same key.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Scenario","level":2,"type":"heading","text":"Scenario"},{"inlineContent":[{"text":"Users double-tap a “Buy” button. The first tap pushes the purchase","type":"text"},{"text":" ","type":"text"},{"text":"screen; the second should be silently dropped. Rolling that logic","type":"text"},{"text":" ","type":"text"},{"text":"into every button is noise — middleware is the right layer.","type":"text"}],"type":"paragraph"},{"anchor":"Installation","level":2,"type":"heading","text":"Installation"},{"code":["let store = NavigationStore<AppRoute>(","    configuration: NavigationStoreConfiguration(","        middlewares: [","            .init(","                middleware: AnyNavigationMiddleware(","                    ThrottleNavigationMiddleware<AppRoute>(","                        interval: .milliseconds(300)","                    )","                ),","                debugName: \"throttle\"","            )","        ]","    )",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"The default initializer uses "},{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":" and groups all"},{"type":"text","text":" "},{"type":"text","text":"commands under a single global window. Within 300 ms of a previous"},{"type":"text","text":" "},{"type":"text","text":"successfully executed command, the next one is cancelled. If the"},{"type":"text","text":" "},{"type":"text","text":"middleware is registered with "},{"code":"debugName: \"throttle\"","type":"codeVoice"},{"type":"text","text":", the surfaced"},{"type":"text","text":" "},{"type":"text","text":"reason becomes "},{"code":".cancelled(.middleware(debugName: \"throttle\", command: …))","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Per-command-keys","level":2,"type":"heading","text":"Per-command keys"},{"inlineContent":[{"type":"text","text":"Group throttle windows by the command’s identity or shape:"}],"type":"paragraph"},{"code":["AnyNavigationMiddleware(","    ThrottleNavigationMiddleware<AppRoute>(interval: .milliseconds(300)) { command in","        if case .push(let route) = command {","            return \"push-\\(route)\"   \/\/ each push route gets its own window","        }","        return nil                    \/\/ other commands pass through","    }",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"Return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" to opt a command out of throttling entirely."}],"type":"paragraph"},{"anchor":"Testing-with-an-injected-clock","level":2,"type":"heading","text":"Testing with an injected clock"},{"inlineContent":[{"type":"text","text":"The middleware is generic over "},{"type":"codeVoice","code":"Clock"},{"type":"text","text":", so tests can drive time"},{"type":"text","text":" "},{"type":"text","text":"deterministically:"}],"type":"paragraph"},{"code":["let clock = TestClock()","let throttle = ThrottleNavigationMiddleware<AppRoute, TestClock>(","    interval: .milliseconds(300),","    clock: clock,","    key: { _ in \"all\" }",")","store.addMiddleware(AnyNavigationMiddleware(throttle), debugName: \"throttle\")","","store.send(.go(.home))","clock.advance(by: .milliseconds(50))","store.send(.go(.detail))         \/\/ cancelled — within window","","clock.advance(by: .milliseconds(400))","store.send(.go(.settings))       \/\/ accepted — beyond window"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"anchor":"Composing-with-whenCancelled","level":2,"type":"heading","text":"Composing with `.whenCancelled`"},{"inlineContent":[{"type":"text","text":"A throttle cancel surfaces as "},{"type":"codeVoice","code":".cancelled"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"codeVoice","code":".whenCancelled(primary, fallback:)"},{"type":"text","text":" treats a throttled command the"},{"type":"text","text":" "},{"type":"text","text":"same as any other cancelled command:"}],"type":"paragraph"},{"code":["store.execute(","    .whenCancelled(","        .push(.detail),","        fallback: .push(.home)","    )",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"If the throttle middleware cancels the "},{"type":"codeVoice","code":".push(.detail)"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"fallback "},{"type":"codeVoice","code":".push(.home)"},{"type":"text","text":" is attempted next. "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" "},{"text":"routes that fallback back through the full middleware chain, so a","type":"text"},{"text":" ","type":"text"},{"text":"global throttle key can cancel the fallback too if it still lands","type":"text"},{"text":" ","type":"text"},{"text":"inside the same throttle window.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Debounce?","anchor":"Debounce","level":2},{"inlineContent":[{"type":"text","text":"Debounce semantics — “wait N ms, then fire the latest” — live in"},{"type":"text","text":" "},{"code":"DebouncingNavigator","type":"codeVoice"},{"type":"text","text":", not in "},{"code":"NavigationCommand","type":"codeVoice"},{"type":"text","text":". That keeps the"},{"type":"text","text":" "},{"type":"text","text":"engine synchronous while the async wrapper owns the timer,"},{"type":"text","text":" "},{"type":"text","text":"cancellation, and "},{"code":"Clock","type":"codeVoice"},{"type":"text","text":" injection needed for deterministic tests."},{"type":"text","text":" "},{"type":"text","text":"Use throttle middleware for synchronous “reject too soon” behavior"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"DebouncingNavigator","type":"codeVoice"},{"type":"text","text":" for delayed “latest wins” behavior."}],"type":"paragraph"},{"type":"heading","text":"Next steps","anchor":"Next-steps","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-StoreObserver"},{"type":"text","text":" for a protocol-style adapter"},{"type":"text","text":" "},{"type":"text","text":"that can observe throttle cancellations via"},{"type":"text","text":" "},{"code":"NavigationStore.events","type":"codeVoice"},{"type":"text","text":" without threading callbacks."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},{"type":"text","text":" for the broader"},{"type":"text","text":" "},{"type":"text","text":"middleware composition story (logging, entitlement gating,"},{"type":"text","text":" "},{"type":"text","text":"analytics)."}]}]}],"type":"unorderedList"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling"},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-throttling"]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Throttling Rapid Navigation Taps","role":"article"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-StoreObserver":{"kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-StoreObserver","role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-storeobserver","abstract":[{"code":"StoreObserver","type":"codeVoice"},{"text":" is a thin protocol adapter over the ","type":"text"},{"code":"events","type":"codeVoice"},{"type":"text","text":" "},{"code":"AsyncStream","type":"codeVoice"},{"type":"text","text":" that every InnoRouter store publishes. Use it when"},{"type":"text","text":" "},{"type":"text","text":"protocol dispatch reads clearer than a "},{"code":"for await","type":"codeVoice"},{"type":"text","text":" loop — typically"},{"type":"text","text":" "},{"type":"text","text":"in AppDelegate wiring, analytics adapters, or anywhere you want"},{"type":"text","text":" "},{"type":"text","text":"static methods instead of iterator plumbing."}],"title":"Observing Stores via Protocol Adapters","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"role":"collection","abstract":[],"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.sw