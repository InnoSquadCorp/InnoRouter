{"metadata":{"title":"Composing Middleware Across Navigation and Modal","modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"text":"Install logging, entitlement gating, and analytics middleware on","type":"text"},{"text":" ","type":"text"},{"text":"both ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":". Inspect the participant","type":"text"},{"text":" ","type":"text"},{"text":"discipline that guarantees ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" only runs for middlewares","type":"text"},{"text":" ","type":"text"},{"text":"that accepted the command.","type":"text"}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","interfaceLanguage":"swift"},"kind":"article","primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Scenario","anchor":"Scenario"},{"type":"paragraph","inlineContent":[{"text":"Every ","type":"text"},{"code":"NavigationCommand","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ModalCommand","type":"codeVoice"},{"text":" should be logged","type":"text"},{"text":" ","type":"text"},{"text":"before it executes. A feature-flagged screen must be gated behind","type":"text"},{"text":" ","type":"text"},{"text":"an entitlement check. An analytics call must fire after the","type":"text"},{"text":" ","type":"text"},{"text":"command commits — but only for middlewares that actually","type":"text"},{"type":"text","text":" "},{"type":"text","text":"participated in the "},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" decision."}]},{"level":2,"type":"heading","text":"Modeling routes","anchor":"Modeling-routes"},{"code":["enum AppRoute: Route {","    case home","    case premiumDetail","    case paywall","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"type":"heading","text":"Logging middleware","anchor":"Logging-middleware"},{"type":"paragraph","inlineContent":[{"text":"Reuse the ","type":"text"},{"code":"AnyNavigationMiddleware","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"AnyModalMiddleware","type":"codeVoice"},{"text":" ","type":"text"},{"text":"closure initializers so a minimal shared logger composes without","type":"text"},{"text":" ","type":"text"},{"text":"boilerplate:","type":"text"}]},{"code":["@MainActor","func loggingNavigationMiddleware() -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(","        willExecute: { command, _ in","            Log.debug(\"navigation command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, _, result in","            Log.debug(\"navigation committed: \\(command) -> \\(result)\")","            return result","        }","    )","}","","@MainActor","func loggingModalMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(","        willExecute: { command, _, _ in","            Log.debug(\"modal command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, _, _ in","            Log.debug(\"modal committed: \\(command)\")","        }","    )","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"type":"heading","text":"Entitlement gating","anchor":"Entitlement-gating"},{"type":"paragraph","inlineContent":[{"text":"The gate is itself a middleware; denying a command is just","type":"text"},{"text":" ","type":"text"},{"text":"returning ","type":"text"},{"code":".cancel(reason)","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["@MainActor","func entitlementGateNavigation(hasPremium: @escaping @MainActor () -> Bool) -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(willExecute: { command, _ in","        guard case .push(.premiumDetail) = command, !hasPremium() else {","            return .proceed(command)","        }","        return .cancel(.middleware(debugName: \"entitlement-gate\", command: command))","    })","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cancellation surfaces through"},{"type":"text","text":" "},{"type":"codeVoice","code":"onCommandIntercepted(.cancelled(...))"},{"type":"text","text":" on the store and through"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowRejectionReason.middlewareRejected(debugName: \"entitlement-gate\")"},{"type":"text","text":" "},{"type":"text","text":"when used from "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Wiring it all","anchor":"Wiring-it-all"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let navStore = NavigationStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingNavigationMiddleware(), debugName: \"logging\"),","            .init(middleware: entitlementGateNavigation(hasPremium: { EntitlementStore.shared.hasPremium }), debugName: \"entitlement-gate\"),","        ]","    )",")","","let modalStore = ModalStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingModalMiddleware(), debugName: \"logging\"),","        ]","    )",")"]},{"type":"heading","level":2,"text":"Participant discipline","anchor":"Participant-discipline"},{"type":"paragraph","inlineContent":[{"text":"When a middleware cancels a command, only the middlewares that","type":"text"},{"text":" ","type":"text"},{"text":"already returned ","type":"text"},{"code":".proceed","type":"codeVoice"},{"text":" observe ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":". The ones that","type":"text"},{"text":" ","type":"text"},{"text":"either didn’t run yet (because a predecessor cancelled) or that","type":"text"},{"text":" ","type":"text"},{"text":"themselves cancelled are not consulted.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That guarantee is why the logger safely appears "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"entitlement gate — the logger’s "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" fires even if the"},{"type":"text","text":" "},{"type":"text","text":"gate cancels, so the cancellation is still recorded. Reordering"},{"type":"text","text":" "},{"type":"text","text":"to "},{"code":"[entitlement-gate, logging]","type":"codeVoice"},{"type":"text","text":" would skip the logger’s"},{"type":"text","text":" "},{"code":"didExecute","type":"codeVoice"},{"type":"text","text":" on cancellation."}]},{"type":"heading","level":2,"text":"Observing a cancellation end-to-end","anchor":"Observing-a-cancellation-end-to-end"},{"type":"paragraph","inlineContent":[{"code":"ModalStore.events","type":"codeVoice"},{"type":"text","text":" surfaces "},{"code":".commandIntercepted(.cancelled(...))","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"NavigationStore.events","type":"codeVoice"},{"type":"text","text":" surfaces the same through"},{"type":"text","text":" "},{"code":".pathMismatch","type":"codeVoice"},{"type":"text","text":" (if the rewrite triggered a policy) plus the"},{"type":"text","text":" "},{"type":"text","text":"direct cancellation. For a "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" in particular,"},{"type":"text","text":" "},{"code":"FlowStore.events","type":"codeVoice"},{"type":"text","text":" wraps both in "},{"code":".navigation(...)","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":".modal(...)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"cases so one subscriber sees the whole picture."}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["Task {","    for await event in flowStore.events {","        if case .modal(.commandIntercepted(_, .cancelled(let reason))) = event {","            Log.info(\"modal cancelled: \\(reason)\")","        }","        if case .intentRejected(_, .middlewareRejected(let name)) = event {","            Log.info(\"flow intent rejected by: \\(name ?? \"nil\")\")","        }","    }","}"]},{"type":"heading","level":2,"text":"Testing middleware with FlowTestStore","anchor":"Testing-middleware-with-FlowTestStore"},{"type":"paragraph","inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"type":"text","text":" (in "},{"code":"InnoRouterTesting","type":"codeVoice"},{"type":"text","text":") asserts the cancellation"},{"type":"text","text":" "},{"type":"text","text":"chain without mounting SwiftUI:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func entitlementGateBlocksPremiumPush() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: entitlementGateNavigation(hasPremium: { false }), debugName: \"gate\")","            ])","        )","    )","","    store.send(.push(.premiumDetail))","","    store.receiveIntentRejected(","        intent: .push(.premiumDetail),","        reason: .middlewareRejected(debugName: \"gate\")","    )","    store.expectNoMoreEvents()","}"]},{"type":"heading","level":2,"text":"Next steps","anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","type":"reference","isActive":true},{"type":"text","text":" to see how middleware"},{"type":"text","text":" "},{"type":"text","text":"interacts with a multi-step flow plus a child coordinator."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read the "},{"type":"codeVoice","code":"Tutorial-TestingFlows"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" documentation catalog for the full host-less"},{"type":"text","text":" "},{"type":"text","text":"test harness tour."}]}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"role":"collection","abstract":[],"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"abstract":[{"text":"Compose push, sheet, and cover steps into a single serializable flow with ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", then scope the signup sub-flow through a ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":" and await its result inline.","type":"text"}],"kind":"article","type":"topic","title":"Building a Login Onboarding Flow","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"type":"tex