{"variants":[{"paths":["\/documentation\/innorouterswiftui\/casestudy-onboardingflow"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/CaseStudy-OnboardingFlow","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"kind":"article","metadata":{"modules":[{"name":"InnoRouterTesting"}],"title":"Case study: shipping a 12-screen onboarding flow","role":"article","roleHeading":"Article"},"abstract":[{"text":"A representative composition of ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"NavigationMiddleware","type":"codeVoice"},{"text":" for a 12-screen","type":"text"},{"text":" ","type":"text"},{"text":"onboarding sequence with conditional branches, deep-link","type":"text"},{"text":" ","type":"text"},{"text":"resumption, and entitlement gating.","type":"text"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This is a synthesized case study against the public InnoRouter"},{"type":"text","text":" "},{"type":"text","text":"surface (v4.0). It does not represent a specific shipped app"},{"type":"text","text":" "},{"type":"text","text":"but is structured to match the shape of recurring requests"},{"type":"text","text":" "},{"type":"text","text":"from teams evaluating the framework."}]}],"style":"note"},{"level":2,"anchor":"The-brief","type":"heading","text":"The brief"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The flow:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Launch screen."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Welcome + region picker.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Phone-number entry.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"SMS verification (modal sheet)."}]}]},{"content":[{"inlineContent":[{"text":"Profile photo (skippable).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Display name.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Permission primer (one screen per permission requested).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Notification opt-in (system prompt, conditional next step)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Home location (skippable).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Work location (skippable).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Subscription pitch (modal sheet, conditional)."}]}]},{"content":[{"inlineContent":[{"text":"Welcome-home with feature tour.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Constraints:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Auth state is owned by an existing "},{"type":"codeVoice","code":"AuthClient"},{"type":"text","text":". The flow"},{"type":"text","text":" "},{"type":"text","text":"reads it but doesn’t own it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Step ordering depends on user input (region → which"},{"type":"text","text":" "},{"type":"text","text":"permissions to request, region → subscription eligibility)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user can deep-link in via ","type":"text"},{"code":"inno:\/\/onboarding\/profile","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"resume mid-flow with prior steps already validated.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Analytics fires on every step entry. A push from outside the","type":"text"},{"text":" ","type":"text"},{"text":"flow (e.g. a referral landing) shouldn’t double-fire entry","type":"text"},{"text":" ","type":"text"},{"text":"events.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"The-composition","text":"The composition","type":"heading"},{"code":["@Routable","enum OnboardingRoute: Route, Codable {","    case launch","    case welcome","    case phoneNumber","    case profilePhoto","    case displayName","    case permissionPrimer(Permission)","    case homeLocation","    case workLocation","    case smsVerification(phoneNumber: String)","    case subscription(plan: SubscriptionPlan)","    case welcomeHome","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"text":"One route type covers both push destinations and modal-only","type":"text"},{"text":" ","type":"text"},{"text":"destinations. ","type":"text"},{"code":"FlowStore<OnboardingRoute>","type":"codeVoice"},{"text":" exposes ","type":"text"},{"code":"path: [RouteStep<OnboardingRoute>]","type":"codeVoice"},{"text":": ","type":"text"},{"code":".push(...)","type":"codeVoice"},{"text":" steps drive the","type":"text"},{"text":" ","type":"text"},{"text":"navigation stack, while ","type":"text"},{"code":".sheet(...)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".cover(...)","type":"codeVoice"},{"text":" steps","type":"text"},{"text":" ","type":"text"},{"text":"drive modal presentation. Because the single route type is","type":"text"},{"text":" ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", the entire flow state is serializable to a","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["store.send(.presentSheet(.smsVerification(phoneNumber: phoneNumber)))","","let rehydrationPlan: FlowPlan<OnboardingRoute> = .init(steps: [","    .push(.launch),","    .push(.welcome),","    .sheet(.subscription(plan: subscriptionPlan)),","])"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"text":"The driver","anchor":"The-driver","level":2,"type":"heading"},{"code":["@MainActor","final class OnboardingDriver: ChildCoordinator {","    typealias Route = OnboardingRoute","    typealias Result = OnboardingResult","","    let store: FlowStore<OnboardingRoute>","    private let auth: AuthClient","    private let analytics: AnalyticsClient","","    init(auth: AuthClient, analytics: AnalyticsClient) {","        self.auth = auth","        self.analytics = analytics","        self.store = FlowStore(","            configuration: FlowStoreConfiguration(","                navigation: NavigationStoreConfiguration(","                    middlewares: [","                        .init(middleware: AnalyticsMiddleware(analytics: analytics),","                              debugName: \"analytics\"),","                        .init(middleware: EntitlementGate(auth: auth),","                              debugName: \"entitlement\"),","                    ]","                ),","                onPathChanged: { [analytics] _, new in","                    analytics.record(.flowPathChanged(new))","                },","                queueCoalescePolicy: .dropQueued","            )","        )","    }","","    func start() {","        store.send(.replaceStack([.launch, .welcome]))","    }","","    func handleDeepLink(_ url: URL) async {","        guard let plan = OnboardingDeepLink.plan(from: url, auth: auth) else {","            store.send(.push(.welcome))","            return","        }","        _ = store.apply(plan)","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" returns an "},{"type":"codeVoice","code":"OnboardingResult"},{"type":"text","text":" to the parent"},{"type":"text","text":" "},{"type":"text","text":"when the flow finishes:"}]},{"code":["enum OnboardingResult {","    case completed(profile: Profile)","    case abandoned(at: OnboardingRoute)","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"The parent calls","type":"text"},{"text":" ","type":"text"},{"code":"parent.push(child: onboardingDriver) -> Task<OnboardingResult?>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"await","type":"codeVoice"},{"text":"s the inline result, which threads cancellation back","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"code":"parentDidCancel()","type":"codeVoice"},{"text":" if the user pulls down on the","type":"text"},{"text":" ","type":"text"},{"text":"sheet shell.","type":"text"}]},{"text":"What the middlewares earn","anchor":"What-the-middlewares-earn","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"code":"AnalyticsMiddleware","type":"codeVoice"},{"text":" records ","type":"text"},{"code":".willExecute","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".didExecute","type":"codeVoice"},{"text":" ","type":"text"},{"text":"events for every navigation command, deduplicated against the","type":"text"},{"text":" ","type":"text"},{"code":"onPathChanged","type":"codeVoice"},{"text":" callback. Because middleware fires ","type":"text"},{"inlineContent":[{"text":"before","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"state mutates, the analytics event always carries the intended","type":"text"},{"text":" ","type":"text"},{"text":"target route, not the post-cancellation snapshot.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"EntitlementGate","type":"codeVoice"},{"text":" reads ","type":"text"},{"code":"auth.isEligible(for: route)","type":"codeVoice"},{"text":" for each","type":"text"},{"text":" ","type":"text"},{"text":"navigation prefix. If the user is not yet eligible for a","type":"text"},{"text":" ","type":"text"},{"text":"branch, navigation middleware cancels the ","type":"text"},{"code":".replaceStack","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":".reset","type":"codeVoice"},{"text":" command with a typed reason; the flow falls back to","type":"text"},{"text":" ","type":"text"},{"code":".dropQueued","type":"codeVoice"},{"text":" policy, dismissing any speculative modal state","type":"text"},{"text":" ","type":"text"},{"text":"that was queued behind the rejected navigation rewrite.","type":"text"},{"text":" ","type":"text"},{"code":"onIntentRejected","type":"codeVoice"},{"text":" records a structured","type":"text"},{"text":" ","type":"text"},{"code":".middlewareRejected(debugName: \"entitlement\")","type":"codeVoice"},{"text":" event so the","type":"text"},{"text":" ","type":"text"},{"text":"analytics layer can correlate with the same span ID.","type":"text"}]},{"text":"What `FlowPlan` earns","anchor":"What-FlowPlan-earns","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A deep link "},{"code":"inno:\/\/onboarding\/profile","type":"codeVoice"},{"type":"text","text":" deserializes into:"}]},{"code":["let plan: FlowPlan<OnboardingRoute> = .init(","    steps: [","        .push(.launch),","        .push(.welcome),","        .push(.phoneNumber),","        .push(.profilePhoto),","    ]",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"store.apply(plan)"},{"type":"text","text":" is atomic: every step previews against"},{"type":"text","text":" "},{"type":"text","text":"middleware in order, and the entire plan rolls back if any"},{"type":"text","text":" "},{"type":"text","text":"preview rejects. The user never sees a half-applied flow even"},{"type":"text","text":" "},{"type":"text","text":"if the entitlement gate decides one of the intermediate steps"},{"type":"text","text":" "},{"type":"text","text":"is currently unreachable."}]},{"type":"paragraph","inlineContent":[{"text":"Because ","type":"text"},{"code":"OnboardingRoute","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", the same ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"be persisted to ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"scenePhase: .background","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and restored on the next cold launch via","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlan(validating:)","type":"codeVoice"},{"text":" — the validating constructor rejects","type":"text"},{"text":" ","type":"text"},{"text":"invariant violations (e.g. two modal steps) before the","type":"text"},{"text":" ","type":"text"},{"text":"authority sees them.","type":"text"}]},{"text":"What `InnoRouterTesting` earns","anchor":"What-InnoRouterTesting-earns","level":2,"type":"heading"},{"code":["@Test","func onboardingResumesFromProfile() async throws {","    let auth = AuthClient.signedIn(region: .us)","    let analytics = RecordingAnalytics()","    let test = FlowTestStore<OnboardingRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: EntitlementGate(auth: auth)),","            ])","        )","    )","","    test.send(.push(.launch))","    test.expect(navigation: [.launch])","    try await test.apply(","        FlowPlan(steps: [","            .push(.launch),","            .push(.welcome),","            .push(.phoneNumber),","            .push(.profilePhoto),","        ])","    )","    test.expect(navigation: [.launch, .welcome, .phoneNumber, .profilePhoto])","    test.expect(modal: nil)","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"No SwiftUI host in scope. The exact same store configuration —","type":"text"},{"text":" ","type":"text"},{"text":"including production analytics middleware — is exercised in","type":"text"},{"text":" ","type":"text"},{"text":"the test and in production. ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"text":" reuses the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStoreConfiguration"},{"text":" callbacks, so the test can also verify","type":"text"},{"type":"text","text":" "},{"type":"text","text":"that "},{"type":"codeVoice","code":"analytics.record(.flowPathChanged(...))"},{"type":"text","text":" fired exactly"},{"type":"text","text":" "},{"type":"text","text":"once per applied step."}]},{"text":"Observed wins","anchor":"Observed-wins","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"In a comparable TCA-modeled flow before the swap, the same","type":"text"},{"text":" ","type":"text"},{"text":"feature carried:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"~340 lines of ","type":"text"},{"code":"Reducer","type":"codeVoice"},{"text":" boilerplate for navigation actions","type":"text"},{"text":" ","type":"text"},{"text":"alone (push \/ pop \/ present \/ dismiss \/ forward \/ hydrate).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Three custom test harnesses to assert state restoration,"},{"type":"text","text":" "},{"type":"text","text":"deep-link replay, and entitlement gating in isolation."}]}]},{"content":[{"inlineContent":[{"text":"A bespoke “is the queue stale?” check after every cancelled","type":"text"},{"text":" ","type":"text"},{"text":"command because TCA’s ","type":"text"},{"code":"@Presents","type":"codeVoice"},{"text":" carry-over isn’t governed","type":"text"},{"text":" ","type":"text"},{"text":"by a policy at the framework level.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The InnoRouter version drops the navigation reducer"},{"type":"text","text":" "},{"type":"text","text":"boilerplate entirely (the framework owns the state machine),"},{"type":"text","text":" "},{"type":"text","text":"folds the three test harnesses into one "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" "},{"type":"text","text":"suite, and pushes the queue-coalesce decision into a single"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStoreConfiguration"},{"type":"text","text":" setting that participates in the"},{"type":"text","text":" "},{"type":"text","text":"analytics middleware’s span ID without extra wiring."}]},{"text":"When this composition is overkill","anchor":"When-this-composition-is-overkill","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a single-screen flow with no entitlement gating and no deep"},{"type":"text","text":" "},{"type":"text","text":"link, drop straight to "},{"code":"NavigationStore<R>","type":"codeVoice"},{"type":"text","text":" + "},{"code":"NavigationHost","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" earns its surface specifically when:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Multiple steps need atomic deep-link rehydration."}]}]},{"content":[{"inlineContent":[{"text":"The modal authority is genuinely concurrent with the","type":"text"},{"text":" ","type":"text"},{"text":"navigation stack (sheets, covers).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"A coordinator-level result ("},{"code":"OnboardingResult","type":"codeVoice"},{"type":"text","text":") needs to"},{"type":"text","text":" "},{"type":"text","text":"bubble back to the parent."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Middleware needs to gate or telemeter the entire flow."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"role":"collection","abstract":[],"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"type":"text","text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter."}],"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","kind":"article","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","title":"InnoRouterSwiftUI","role":"collectionGroup"}}}