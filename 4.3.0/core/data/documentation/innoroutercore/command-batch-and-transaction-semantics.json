nce"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".whenCancelled"}]}]}],"type":"unorderedList"},{"inlineContent":[{"code":"NavigationEngine","type":"codeVoice"},{"type":"text","text":" executes these commands against a "},{"code":"RouteStack","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Sequence semantics","anchor":"Sequence-semantics","type":"heading"},{"inlineContent":[{"code":".sequence","type":"codeVoice"},{"text":" is command algebra, not a transaction.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That means:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"commands execute left-to-right","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"earlier successful steps stay applied even if a later step fails"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"later steps still run unless the sequence itself has no more elements"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the final result is "},{"type":"codeVoice","code":"NavigationResult.multiple(_:)"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".sequence"},{"type":"text","text":" when partial success is acceptable and the command stream itself is the point."}],"type":"paragraph"},{"level":2,"text":"Fallback semantics","anchor":"Fallback-semantics","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".whenCancelled(primary, fallback:)"},{"type":"text","text":" is also command algebra."}]},{"type":"paragraph","inlineContent":[{"text":"That means:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"primary","type":"codeVoice"},{"text":" runs first","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"if "},{"code":"primary","type":"codeVoice"},{"type":"text","text":" reports anything other than success, the store restores the snapshot and runs "},{"code":"fallback","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"both legs still pass through middleware recursively"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"single-command execution only emits the committed state change","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"transaction execution keeps public middleware observation commit-only, while discarded preview legs run internal cleanup"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".whenCancelled"},{"type":"text","text":" when rollback-to-fallback semantics belong to one logical command."}]},{"type":"heading","anchor":"Batch-semantics","level":2,"text":"Batch semantics"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationBatchExecutor.executeBatch(_:stopOnFailure:)"},{"type":"text","text":" is for observation batching."}]},{"type":"paragraph","inlineContent":[{"text":"Batch execution still runs commands one step at a time, but it lets higher layers coalesce observation:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"step middleware still runs"}]}]},{"content":[{"inlineContent":[{"code":"stopOnFailure: false","type":"codeVoice"},{"text":" keeps later commands running after a failure","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"stopOnFailure: true"},{"type":"text","text":" stops the batch after the first failed step"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the store can emit one aggregated callback"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the caller gets a structured "},{"code":"NavigationBatchResult","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use batch execution when the caller wants one “transition event” while still preserving per-step execution."}]},{"type":"heading","anchor":"Transaction-semantics","level":2,"text":"Transaction semantics"},{"type":"paragraph","inlineContent":[{"code":"NavigationTransactionExecutor.executeTransaction(_:)","type":"codeVoice"},{"text":" is the atomic option.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transactions:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"preview commands on a shadow stack","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"abort on the first failure or cancellation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"leave the real state unchanged on failure"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"commit the final state all at once on success","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"surface public ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" \/ transaction observation only for committed leaves","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"run internal discard cleanup for previewed leaves that never commit","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use transactions when all-or-nothing semantics are required."}]},{"type":"heading","anchor":"Typed-failures","level":2,"text":"Typed failures"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Core legality failures stay in typed results instead of exceptions:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"NavigationResult.emptyStack","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"t