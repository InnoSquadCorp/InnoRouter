{"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Release-and-requirements","type":"heading","text":"Release and requirements"},{"inlineContent":[{"text":"This catalog describes stable InnoRouter ","type":"text"},{"inlineContent":[{"type":"text","text":"7.0.0"}],"type":"strong"},{"type":"text","text":". Use Swift 6.3+ with"},{"text":" ","type":"text"},{"type":"text","text":"iOS\/iPadOS\/Mac Catalyst 18+, macOS 15+, tvOS 18+, watchOS 11+, or visionOS 2+."},{"text":" ","type":"text"},{"text":"Apps import the ","type":"text"},{"code":"InnoRouter","type":"codeVoice"},{"type":"text","text":" product; "},{"code":"InnoRouterTesting","type":"codeVoice"},{"type":"text","text":" and"},{"text":" ","type":"text"},{"type":"codeVoice","code":"InnoRouterInspector"},{"text":" are optional. Platform-specific scenes and presentations","type":"text"},{"type":"text","text":" "},{"text":"retain their availability constraints. Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouter\/Migrating-To-InnoRouter-7","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"when moving from 6.x; older release notes remain historical evidence."}],"type":"paragraph"},{"level":2,"anchor":"Overview","type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare one route enum with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":". The generated conformance unlocks one"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterStore<Route>"},{"type":"text","text":", one recursive "},{"type":"codeVoice","code":"RouterState<Route>"},{"type":"text","text":", and one"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterAction<Route>"},{"type":"text","text":" request vocabulary."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":", and "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" render native SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"containers over that authority. "},{"type":"codeVoice","code":"RouterPlan<Route>"},{"type":"text","text":" represents an exact target"},{"type":"text","text":" "},{"type":"text","text":"shared by deep links, restoration, and transactions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter supports typed presentations and scenes, native tab"},{"type":"text","text":" "},{"type":"text","text":"and split hosts, deep-link admission, snapshot restoration, bounded scheduling,"},{"type":"text","text":" "},{"type":"text","text":"and optional testing and Inspector tools. Applications choose their storage,"},{"type":"text","text":" "},{"type":"text","text":"recovery, and policy behavior explicitly while the store remains the single"},{"type":"text","text":" "},{"type":"text","text":"navigation authority."}]},{"type":"heading","level":3,"text":"Added in 6.1.0","anchor":"Added-in-610"},{"type":"paragraph","inlineContent":[{"text":"Version 6.1.0 adds explicit tab-topology restoration for apps whose tab","type":"text"},{"text":" ","type":"text"},{"text":"catalog changes between launches. ","type":"text"},{"type":"codeVoice","code":"RouterTabRestorationTopology"},{"text":" adds missing","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"current scopes while preserving saved paths and orphaned branches. Partial"},{"text":" ","type":"text"},{"text":"restoration reports describe structural changes through ","type":"text"},{"type":"codeVoice","code":"topologyChanges"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"It also added opt-in snapshot byte limits, automatic partial validation,","type":"text"},{"text":" ","type":"text"},{"text":"and explicit ","type":"text"},{"type":"codeVoice","code":"@TabItem"},{"text":" identifiers while preserving the 6.0 defaults at that","type":"text"},{"text":" ","type":"text"},{"text":"time. In 7.0, legacy snapshot codecs and file storage have finite provisional","type":"text"},{"text":" ","type":"text"},{"text":"defaults. Codec JSON depth, token and duplicate-key preflight also runs before","type":"text"},{"text":" ","type":"text"},{"text":"typed decoding and after every migration. Use measured finite overrides when","type":"text"},{"text":" ","type":"text"},{"text":"needed; an explicit nil opt-out is excluded from the bounded-decoding guarantee.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouter\/Restoring-Tab-Navigation","type":"reference"},{"text":" for catalog ownership, outcome handling,","type":"text"},{"text":" ","type":"text"},{"text":"and a complete, compiled example with file persistence.","type":"text"}]},{"type":"codeListing","syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","enum AppRoute {","    case detail(id: String)","","    var destination: some View {","        switch self {","        case .detail(let id):","            Text(\"Detail \\(id)\")","        }","    }","}","","struct AppRoot: View {","    var body: some View {","        RouterHost(AppRoute.self) {","            Text(\"Home\")","        }","    }","}"]},{"anchor":"API-overview","text":"API overview","level":2,"type":"heading"},{"anchor":"Runtime","text":"Runtime","level":3,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"RouterStore","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"RouterState","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"RouterAction","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"RouterPlan","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":