{"kind":"article","metadata":{"title":"InnoRouterTesting","role":"collectionGroup","roleHeading":"API Collection","modules":[{"name":"InnoRouterTesting"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/innoroutertesting\/innoroutertesting"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/InnoRouterTesting","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"A host-less assertion harness for the canonical InnoRouter 6 transition"},{"type":"text","text":" "},{"text":"pipeline.","type":"text"}],"topicSections":[{"title":"Harness","identifiers":["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestStore","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/TestExhaustivity","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterActionSequence","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterActionStep","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestRuntime","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestClock","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestRequest","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestPendingWork","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRecorder","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFixture","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioControl","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRequestSemantics","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioSceneLifetime","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioCancellationOrigin","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioExpectation","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioMetadata","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioReplayEnvironment","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureProjection","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureResolver","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioGeneratedFiles","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioSourceGenerator","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRunner"],"anchor":"Harness"}],"sections":[],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"RouterTestStore<Route>","type":"codeVoice"},{"text":" wraps the production ","type":"text"},{"code":"RouterStore","type":"codeVoice"},{"text":", reducer, and","type":"text"},{"text":" ","type":"text"},{"text":"policies. It buffers events synchronously, allowing a test to assert the exact","type":"text"},{"text":" ","type":"text"},{"code":"started → policyPrepared → committed\/rejected","type":"codeVoice"},{"text":" lifecycle without sleeps.","type":"text"}]},{"type":"codeListing","code":["import InnoRouter","import InnoRouterTesting","import Testing","","@Test @MainActor","func opensDetail() async {","    let store = RouterTestStore<AppRoute>()","","    await store.send(.push(.detail(id: \"42\")))","    store.receiveStarted()","    store.receiveCommitted { state, revision in","        state == .rootStack(path: [.detail(id: \"42\")]) && revision == 1","    }","    store.finish()","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"code":"TestExhaustivity.strict","type":"codeVoice"},{"text":" mode records a Swift Testing issue when","type":"text"},{"type":"text","text":" "},{"type":"text","text":"events remain at "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" or deinitialization. Use "},{"type":"codeVoice","code":".off"},{"text":" only while","type":"text"},{"type":"text","text":" "},{"text":"incrementally migrating a large suite. Production ","type":"text"},{"type":"codeVoice","code":"onEvent"},{"text":" callbacks are","type":"text"},{"text":" ","type":"text"},{"text":"preserved and run before an event enters the assertion queue.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use predicates when a transition identifier is generated at runtime, or compare","type":"text"},{"text":" ","type":"text"},{"text":"an exact ","type":"text"},{"code":"RouterEvent","type":"codeVoice"},{"text":" when the fixture owns every value.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"send(_:context:)"},{"type":"text","text":" accepts production transition provenance and animation;"},{"text":" ","type":"text"},{"text":"passing a ","type":"text"},{"code":"RouterPlan","type":"codeVoice"},{"text":" applies one exact target. Codable routes can use","type":"text"},{"text":" ","type":"text"},{"code":"snapshot(using:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"restore(from:using:recovery:)","type":"codeVoice"},{"type":"text","text":" to verify the same codec,"},{"text":" ","type":"text"},{"type":"text","text":"migration, policy, and provenance path used by an application. "},{"type":"codeVoice","code":"assertState"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"receiveUnchanged"},{"type":"text","text":" complete the value-level assertion surface."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For timeout, expiry, cancellation, and overlapping-request tests, install a"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTestRuntime"},{"type":"text","text":" and start requests without awaiting them:"}]},{"type":"codeListing","code":["let runtime = RouterTestRuntime(transitionIDSeed: 1)","let store = RouterTestStore<AppRoute>(","    configuration: .init(policyTimeout: .seconds(30)),","    runtime: runtime",")","let request = store.start(.push(.checkout))","","await request.waitUntilStarted()","await runtime.clock.waitUntilScheduled()","runtime.clock.advance(by: .seconds(30))","let outcome = await request.result"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"The start and timer-registration barriers are production lifecycle signals,","type":"text"},{"type":"text","text":" "},{"text":"not scheduler guesses. ","type":"text"},{"code":"RouterTestRequest.cancel()","type":"codeVoice"},{"type":"text","text":" targets one request, while"},{"text":" ","type":"text"},{"type":"codeVoice","code":"waitForEvent(where:)"},{"type":"text","text":" waits for an exact later lifecycle condition. Strict"},{"type":"text","text":" "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" reports outstanding requests, policy deferrals, and virtual timers,"},{"type":"text","text":" "},{"type":"text","text":"then cancels only work created by this test harness. Existing test-store"},{"type":"text","text":" "},{"type":"text","text":"initializers retain live time unless a runtime is explicitly supplied."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterActionSequence<Route>"},{"type":"text","text":" stores Codable production actions and each step’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTransitionContext"},{"type":"text","text":" as a versioned, deterministically encoded fixture."},{"type":"text","text":" "},{"type":"text","text":"Construct "},{"type":"codeVoice","code":"RouterActionStep"},{"type":"text","text":" values when provenance, animation, request keys,"},{"type":"text","text":" "},{"type":"text","text":"coalescing, or resumed-deferral metadata differ between steps. The convenience"},{"type":"text","text":" "},{"type":"codeVoice","code":"init(actions:context:)"},{"type":"text","text":" applies one context to every action. "},{"type":"codeVoice","code":"replay(on:)"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"each step through "},{"code":"RouterTestStore","type":"codeVoice"},{"type":"text","text":", including production policy rejection."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supply the original initial state, policies, and runtime dependencies when"},{"type":"text","text":" "},{"type":"text","text":"constructing the test store. Replay is sequential and does not reproduce"},{"type":"text","text":" "},{"type":"text","text":"concurrent request timing. Fixtures contain route payloads and request keys;"},{"type":"text","text":" "},{"type":"text","text":"review them before sharing. Use Inspector bundles for redacted support exports."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterScenarioRecorder"},{"type":"text","text":" is the explicit bridge from a reproduced bug to a"},{"type":"text","text":" "},{"type":"text","text":"regression fixture. It observes request, start, cancellation, and terminal"},{"type":"text","text":" "},{"type":"text","text":"boundaries synchronously, bounds retained route payloads, and reports"},{"type":"text","text":" "},{"type":"text","text":"unfinished, dropped, or control-incomplete requests. Format v5 records"},{"type":"text","text":" "},{"type":"text","text":"route-schema, environment, dependency\/effect capabilities, the initial"},{"type":"text","text":" "},{"type":"text","text":"revision, every request’s relative "},{"type":"codeVoice","code":"expectedRevision"},{"type":"text","text":", its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioCancellationOrigin"},{"type":"text","text":", serializable"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRequestSemantics"},{"type":"text","text":", and logical submit, wait, cancel,"},{"type":"text","text":" "},{"type":"text","text":"virtual-time, deferral-resolution, and terminal controls. This preserves"},{"type":"text","text":" "},{"type":"text","text":"history navigation-only rebasing and stale-state checks through queued and"},{"type":"text","text":" "},{"type":"text","text":"repeatedly deferred requests. Format v7 records the complete feature mapping"},{"type":"text","text":" "},{"type":"text","text":"path for ordinary feature actions, presentation mutations, completions, and"},{"type":"text","text":" "},{"type":"text","text":"feature plans. Scene-local requests bind ownership to the logical Scene"},{"type":"text","text":" "},{"type":"text","text":"lifetime created by the replay sequence rather than serializing process-local"},{"type":"text","text":" "},{"type":"text","text":"UUID tokens. Replay requires a"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureResolver"},{"type":"text","text":" built from the same macro-generated mapping;"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureProjection"},{"type":"text","text":" to compose nested mappings. Missing,"},{"type":"text","text":" "},{"type":"text","text":"duplicate, or tampered resolver paths fail before the first production request."},{"type":"text","text":" "},{"type":"text","text":"Format v6 and earlier, plus unknown future versions, are rejected"},{"type":"text","text":" "},{"type":"text","text":"instead of guessing execution conditions. Use the recorder’s "},{"type":"codeVoice","code":"resolveDeferred"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"advanceTime"},{"type":"text","text":" operations when"},{"type":"text","text":" "},{"type":"text","text":"capturing those decisions so replay never invents unavailable scheduling data."},{"type":"text","text":" "},{"type":"text","text":"Preflight validates the exact action provenance stored by each deferral while"},{"type":"text","text":" "},{"type":"text","text":"allowing a history target to differ from the merged state that preserves"},{"type":"text","text":" "},{"type":"text","text":"already-open scenes, badges, and non-conflicting presentations. A resumed"},{"type":"text","text":" "},{"type":"text","text":"history request with an explicit request-cancellation control is portable. A"},{"type":"text","text":" "},{"type":"text","text":"request cancelled by an unrecorded history stop or reset is rejected as"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioReplayError\/unsupportedHistoryLifetime(step:)"},{"type":"text","text":" (and by the"},{"type":"text","text":" "},{"type":"text","text":"matching source-generation error) before replay mutates a store; reproduce and"},{"type":"text","text":" "},{"type":"text","text":"record that lifecycle explicitly before generating a portable fixture."},{"type":"text","text":" "},{"type":"text","text":"A raw recording is intentionally incomplete:"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterScenarioFixture.settingExpectations(_:)"},{"type":"text","text":" must provide a developer-owned"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterScenarioExpectation"},{"type":"text","text":" for every observation before"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterScenarioSourceGenerator"},{"type":"text","text":" emits Swift Testing source. Generated tests use"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRunner"},{"type":"text","text":" to preserve overlaps, cancellation, timeout, and"},{"type":"text","text":" "},{"type":"text","text":"approval controls, map fresh deferral identities, and compare each request’s"},{"type":"text","text":" "},{"type":"text","text":"own terminal snapshot and revision delta on the production test store. Replay"},{"type":"text","text":" "},{"type":"text","text":"preflights a caller-declared "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioReplayEnvironment"},{"type":"text","text":" before the"},{"type":"text","text":" "},{"type":"text","text":"first request and requires the test store’s complete state to equal the"},{"type":"text","text":" "},{"type":"text","text":"fixture’s initial state. If replay fails or its task is cancelled, it cancels"},{"type":"text","text":" "},{"type":"text","text":"and drains its own request and deferral handles before returning while leaving"},{"type":"text","text":" "},{"type":"text","text":"unrelated store work untouched."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioSourceGenerator\/generateFiles(_:routeTypeName:fixtureFileName:testName:storeFactory:environmentFactory:featureResolversFactory:)"},{"type":"text","text":" "},{"type":"text","text":"returns separate Swift Testing and JSON fixture artifacts. Use"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterScenarioFixture.decode(from:maximumByteCount:maximumStepCount:)"},{"type":"text","text":" at an"},{"type":"text","text":" "},{"type":"text","text":"import boundary."}]}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterTestStore":{"title":"RouterTestStore","type":"topic","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouterTestStore","kind":"identifier"}],"navigatorTitle":[{"text":"RouterTestStore","kind":"identifier"}],"url":"\/documentation\/innoroutertesting\/routerteststore","abstract":[{"type":"text","text":"Host-less assertion harness for the macro-first "},{"type":"codeVoice","code":"RouterStore"},{"type":"text","text":" pipeline."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestStore","role":"symbol","kind":"symbol"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterScenarioCancellationOrigin":{"title":"RouterScenarioCancellationOrigin","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouterScenarioCancellationOrigin","kind":"identifier"}],"navigatorTitle":[{"text":"RouterScenarioCancellationOrigin","kind":"identifier"}],"url":"\/documentation\/innoroutertesting\/routerscenariocancellationorigin","abstract":[{"type":"text","text":"Recorded cause for a cancelled request terminal."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioCancellationOrigin","role":"symbol","kind":"symbol"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterScenarioControl":{"title":"RouterScenarioControl","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"RouterScenarioControl"}],"navigatorTitle":[{"text":"RouterScenarioControl","kind":"identifier"}],"url":"\/documentation\/innoroutertesting\/routerscenariocontrol","abstract":[{"type":"text","text":"One deterministic scheduling decision in a captured or authored replay."},{"type":"text","text":" "},{"type":"text","text":"Request IDs are logical fixture identities and are remapped to fresh"},{"type":"text","text":" "},{"type":"text","text":"production transition IDs by "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRunner","isActive":true},{"type":"text","text":"."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioControl","role":"symbol","kind":"symbol"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterScenarioFeatureProjection":{"kind":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouterScenarioFeatureProjection","kind":"identifier"}],"role":"symbol","navigatorTitle":[{"text":"RouterScenarioFeatureProjection","kind":"identifier"}],"title":"RouterScenarioFeatureProjection","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureProjection","abstract":[{"type":"text","text":"A typed projection chain used to build a replay resolver from the same"},{"type":"text","text":" "},{"type":"text","text":"macro-generated feature mappings used by production routing."}],"type":"topic","url":"\/documentation\/innoroutertesting\/routerscenariofeatureprojection"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterScenarioRequestSemantics":{"title":"RouterScenarioRequestSemantics","type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"