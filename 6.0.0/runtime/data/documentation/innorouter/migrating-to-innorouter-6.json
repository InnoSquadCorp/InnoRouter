{"sections":[],"primaryContentSections":[{"content":[{"text":"Dependency","type":"heading","anchor":"Dependency","level":2},{"inlineContent":[{"type":"text","text":"Replace granular runtime products with the umbrella product:"}],"type":"paragraph"},{"code":[".product(name: \"InnoRouter\", package: \"InnoRouter\")"],"syntax":"swift skip package-manifest-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" and "},{"type":"codeVoice","code":"InnoRouterInspector"},{"type":"text","text":" only to targets that use them."}],"type":"paragraph"},{"text":"Route declaration and host","type":"heading","anchor":"Route-declaration-and-host","level":2},{"inlineContent":[{"text":"Before, an application could manually compose separate stack and modal stores.","type":"text"},{"text":" ","type":"text"},{"text":"In 6.0, declare destinations once and choose a native host:","type":"text"}],"type":"paragraph"},{"code":["import InnoRouter","import SwiftUI","","@Router","enum AppRoute {","    case home","    case detail(id: String)","","    var destination: some View { \/* exhaustive switch *\/ }","}","","RouterHost(AppRoute.self) {","    AppRoute.destination(for: .home)","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"AppRoute.makeRouterStore()","type":"codeVoice"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"RouterHost(store:)"},{"type":"text","text":" only when an app"},{"type":"text","text":" "},{"type":"text","text":"boundary must retain the authority."}],"type":"paragraph"},{"anchor":"Feature-metadata-namespace","type":"heading","level":2,"text":"Feature metadata namespace"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature mappings stay under "},{"type":"codeVoice","code":"AppRoute.Feature"},{"type":"text","text":", such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRoute.Feature.account"},{"type":"text","text":". The generated structural metadata array is now"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRoute.routerFeatureCatalog"},{"type":"text","text":". Replace any pre-release 6.0 source that read"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AppRoute.Feature.catalog"},{"text":"; no compatibility alias is provided because it would","type":"text"},{"text":" ","type":"text"},{"text":"again collide with a valid ","type":"text"},{"code":"@FeatureRoute case catalog(ChildRoute)","type":"codeVoice"},{"text":" mapping.","type":"text"}]},{"anchor":"Request-vocabulary","text":"Request vocabulary","type":"heading","level":2},{"rows":[[[{"inlineContent":[{"text":"5.x","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"6.0"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"independent stack\/modal\/flow stores","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"RouterStore<Route>"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"navigation, modal, and flow intents"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RouterAction<Route>","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"navigation and flow plans"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RouterPlan<Route>","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"direct inner-store mutation"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"await store.perform(action)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"separate store event types"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterEvent<Route>"},{"type":"text","text":" with one transition ID"}]}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"text":"Named environment helpers such as ","type":"text"},{"code":"go","type":"codeVoice"},{"text":", ","type":"text"},{"code":"back","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"cover","type":"codeVoice"},{"text":" remain","type":"text"},{"text":" ","type":"text"},{"text":"convenient projections of ","type":"text"},{"code":"RouterAction","type":"codeVoice"},{"type":"text","text":"; they do not form another public"},{"type":"text","text":" "},{"type":"text","text":"request language."}]},{"inlineContent":[{"type":"text","text":"The repository’s "},{"type":"codeVoice","code":"MigrationSmoke"},{"type":"text","text":" fixture compiles the exact published 5.2.1"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore"},{"text":" scenario and this 6.0 replacement as separate downstream","type":"text"},{"text":" ","type":"text"},{"text":"packages, then compares their encoded final path. It intentionally proves a","type":"text"},{"text":" ","type":"text"},{"text":"migration rather than preserving the removed type names.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Tabs and split layouts","anchor":"Tabs-and-split-layouts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace per-tab stores with branches in one "},{"code":"RouterState","type":"codeVoice"},{"type":"text","text":" tree. Apply"},{"type":"text","text":" "},{"code":"@TabItem","type":"codeVoice"},{"type":"text","text":" only to parameterless tab roots; ordinary detail routes can remain"},{"type":"text","text":" "},{"type":"text","text":"unmarked in the same "},{"code":"@Router","type":"codeVoice"},{"type":"text","text":" enum. "},{"code":"RouterTabHost","type":"codeVoice"},{"type":"text","text":" creates and scopes the"},{"type":"text","text":" "},{"type":"text","text":"branches. The macro-generated scope ID is based on the case name and is safe to"},{"type":"text","text":" "},{"type":"text","text":"persist across localization and reordering."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an app-retained split tree, construct "},{"type":"codeVoice","code":"RouterContainerState(style: .split, ...)"},{"type":"text","text":", create one "},{"type":"codeVoice","code":"RouterStore"},{"type":"text","text":", and pass it to "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterThreeColumnSplitHost"},{"type":"text","text":". "},{"type":"codeVoice","code":"RouterSplitState"},{"type":"text","text":" persists native visibility and"},{"type":"text","text":" "},{"type":"text","text":"preferred compact column alongside the two- or three-column scope topology."}]},{"text":"Async policy","anchor":"Async-policy","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Replace middleware executors with ordered ","type":"text"},{"code":"RouterPolicy","type":"codeVoice"},{"text":" values:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let policy = RouterPolicy<AppRoute>(name: \"session\") { transition in","    session.isAuthenticated ? .allow : .reject(\"authentication-required\")","}","","let store = AppRoute.makeRouterStore(","    configuration: .init(policies: [policy])",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Policies inspect an immutable candidate. Do not mutate navigation or business"},{"type":"text","text":" "},{"type":"text","text":"state from a policy closure."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When approval must arrive later, return "},{"code":".deferRequest(id)","type":"codeVoice"},{"type":"text","text":". The store releases"},{"type":"text","text":" "},{"type":"text","text":"its execution lane and exposes payload-safe metadata in "},{"code":"deferredTransitions","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Resolve the request explicitly; unchanged-state resume is the default, and"},{"type":"text","text":" "},{"type":"text","text":"rebasing on current state must be selected deliberately."}]},{"type":"heading","level":2,"anchor":"Deep-links","text":"Deep links"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace push-only or flow-only pipelines with "},{"type":"codeVoice","code":"RouterLinkPipeline"},{"type":"text","text":". A route"},{"type":"text","text":" "},{"type":"text","text":"matcher is promoted to an exact root-stack plan by default; pass a plan matcher"},{"type":"text","text":" "},{"type":"text","text":"or planner closure for tabs, presentations, windows, or immersive state."}]},{"type":"paragraph","inlineContent":[{"text":"Authentication evaluates every route in the target tree. A pending decision","type":"text"},{"text":" ","type":"text"},{"text":"retains the complete plan, so replay does not reconstruct intent chains. Put","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that value in "},{"type":"codeVoice","code":"RouterPendingLinkSlot"},{"type":"text","text":", then call "},{"type":"codeVoice","code":"resume(on:)"},{"type":"text","text":" after login;"},{"type":"text","text":" "},{"type":"text","text":"replacement, cancellation, and rejection retention are explicit."}]},{"inlineContent":[{"type":"text","text":"Authentication state may be isolated to any actor. Its closure and the final"},{"type":"text","text":" "},{"type":"text","text":"decision are therefore asynchronous:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let pipeline = RouterLinkPipeline<AppRoute>(","    originPolicy: originPolicy,","    matcher: matcher,","    authenticationPolicy: .required(","        shouldRequireAuthentication: { $0.requiresSession },","        isAuthenticated: { await session.isAuthenticated }","    )",")","","let decision = await pipeline.decide(for: url)"],"type":"codeListing"},{"anchor":"Persistence","level":2,"text":"Persistence","type":"heading"},{"inlineContent":[{"text":"Replace raw stack\/flow encoding with ","type":"text"},{"type":"codeVoice","code":"RouterSnapshotCodec<Route>"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let codec = try RouterSnapshotCodec<AppRoute>(currentVersion: 2, migrations: [v1ToV2])","let data = try await store.snapshot(using: codec)","let result = try await store.restore(from: data, using: codec, recovery: .fail)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Migrations must be adjacent and deterministic. Choose "},{"type":"codeVoice","code":".fail"},{"type":"text","text":" or an explicit"},{"type":"text","text":" "},{"type":"text","text":"app fallback; 6.0 never silently restores an empty router."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Prefer "},{"type":"codeVoice","code":"RouterSnapshotMigration.codable(from:to:decoding:transform:)"},{"type":"text","text":" when the"},{"type":"text","text":" "},{"type":"text","text":"legacy payload has a known shape. It decodes an app-owned legacy DTO and"},{"type":"text","text":" "},{"type":"text","text":"encodes the next payload with stable key ordering, avoiding fragile raw JSON"},{"type":"text","text":" "},{"type":"text","text":"string rewrites."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Snapshot encoding and decoding execute away from the main actor. Restoration"},{"type":"text","text":" "},{"type":"text","text":"also captures the current revision before loading and rejects the decoded plan"},{"type":"text","text":" "},{"type":"text","text":"as stale if the live router commits while storage is being read."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"When the app wants lifecycle-driven persistence, retain a","type":"text"},{"text":" ","type":"text"},{"code":"RouterRestorationDriver","type":"codeVoice"},{"text":" with an app-selected ","type":"text"},{"code":"RouterSnapshotStorage","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"attach ","type":"text"},{"code":"routerStateRestoration(_:)","type":"codeVoice"},{"text":" at the root. The driver still restores","type":"text"},{"text":" ","type":"text"},{"text":"through the canonical policy pipeline and does not select a cloud service or","type":"text"},{"type":"text","text":" "},{"type":"text","text":"storage location."}]},{"type":"paragraph","inlineContent":[{"text":"Persist an authentication continuation separately with","type":"text"},{"type":"text","text":" "},{"code":"RouterPendingLinkPersistenceDriver","type":"codeVoice"},{"type":"text","text":" and app-selected"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterPendingLinkStorage"},{"text":". It stores the exact pending plan, not the source URL","type":"text"},{"text":" ","type":"text"},{"text":"alone, and refuses to overwrite a newer in-memory submission after a slow load.","type":"text"}]},{"type":"heading","anchor":"Macro-first-state-reads","level":2,"text":"Macro-first state reads"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep ordinary destinations on "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" for actions. Replace direct"},{"type":"text","text":" "},{"text":"store injection used only for UI state with ","type":"text"},{"code":"@EnvironmentRouterState","type":"codeVoice"},{"text":"; its","type":"text"},{"text":" ","type":"text"},{"code":"RouterStateReader","type":"codeVoice"},{"type":"text","text":" exposes read-only stack, presentation, tab, badge, window,"},{"type":"text","text":" "},{"type":"text","text":"and immersive projections from the same nearest scope."}]},{"type":"heading","anchor":"Result-bearing-presentation","level":2,"text":"Result-bearing presentation"},{"type":"paragraph","inlineContent":[{"text":"Replace child-coordinator callbacks with one exact presentation lifetime:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let outcome: RouterPresentationOutcome<Profile> = await router.present(","    .profileEditor,","    expecting: Profile.self",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination calls "},{"type":"codeVoice","code":"finishPresentation(returning:)"},{"type":"text","text":". Treat "},{"type":"codeVoice","code":".dismissed"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":".cancelled"},{"type":"text","text":", and "},{"type":"codeVoice","code":".rejected"},{"type":"text","text":" as separate terminal states."}]},{"type":"heading","anchor":"Tests-and-inspection","level":2,"text":"Tests and inspection"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace per-store test harnesses with "},{"type":"codeVoice","code":"RouterTestStore"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"RouterInspectorRecorder"},{"type":"text","text":" to the canonical "},{"code":"RouterStore","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Expect "},{"code":"started","type":"codeVoice"},{"type":"text","text":", one event per prepared policy, and one terminal event with"},{"type":"text","text":" "},{"type":"text","text":"the same transition identifier."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read source, animation, and metadata from the "},{"code":"context","type":"codeVoice"},{"type":"text","text":" carried by every"},{"type":"text","text":" "},{"type":"text","text":"terminal event; terminal diagnostics no longer infer "},{"code":".programmatic","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Default inspector metadata is structural and redacted. Supply a formatter"},{"type":"text","text":" "},{"type":"text","text":"only when the app explicitly accepts payload exposure."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Import exported sessions into the recorder or use "},{"code":"RouterInspectorPlayback","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"RouterInspectorComparison","type":"codeVoice"},{"type":"text","text":" for offline step-through diagnosis."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use bookmarks, correlated elapsed\/duration metadata, arbitrary state"},{"type":"text","text":" "},{"text":"comparison, and pause-on-rejection to isolate a failing transition. JSON file","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"import remains a developer-only, non-mutating workflow."}]}]}]},{"level":2,"text":"Removed without an automatic adapter","type":"heading","anchor":"Removed-without-an-automatic-adapter"},{"inlineContent":[{"type":"text","text":"The 5.x coordinator callback lifecycle, modal queues, effect handlers, and"},{"type":"text","text":" "},{"type":"text","text":"automatic scene ownership cannot be translated safely into aliases: they have"},{"type":"text","text":" "},{"text":"different lifetime and atomicity semantics. Move business effects outside the","type":"text"},{"text":" ","type":"text"},{"text":"router, model the visible target as ","type":"text"},{"code":"RouterState","type":"codeVoice"},{"text":", and invoke native window or","type":"text"},{"text":" ","type":"text"},{"text":"immersive APIs through a macro-generated ","type":"text"},{"code":"RouterSceneRoute","type":"codeVoice"},{"text":" catalog when","type":"text"},{"text":" ","type":"text"},{"text":"committed state changes. Scene actions on unconstrained route types are no","type":"text"},{"text":" ","type":"text"},{"text":"longer part of the public surface. Native open failures are repaired through","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the normal reducer and event path, but that corrective removal cannot be"},{"type":"text","text":" "},{"type":"text","text":"rejected by an application policy because the failed scene does not exist to"},{"type":"text","text":" "},{"type":"text","text":"preserve."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Each native scene now owns a recursive "},{"code":"RouterNode","type":"codeVoice"},{"type":"text","text":" within that same state."},{"type":"text","text":" "},{"type":"text","text":"Use the macro-generated typed "},{"code":"Route.Scene","type":"codeVoice"},{"type":"text","text":" request and render the matching"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouterWindowHost"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"RouterImmersiveSpaceHost"},{"text":"; do not host a second store in","type":"text"},{"text":" ","type":"text"},{"text":"the scene.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouter\/Migrating-To-InnoRouter-6"},"kind":"article","metadata":{"title":"Migrating to InnoRouter 6","modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"InnoRouter 6 deliberately replaces the parallel 5.x routing authorities with","type":"text"},{"text":" ","type":"text"},{"text":"one macro-first state\/store model. This is a breaking migration, not a set of","type":"text"},{"text":" ","type":"text"},{"text":"deprecated aliases.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouter\/migrating-to-innorouter-6"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting"]]},"references":{"doc://com.innosquad.innorouter.docs.runtime/documentation/InnoRouterTesting":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting","role":"collection","kind":"symbol","url":"\/documentation\/innoroutertesting","abstract":[],"title":"InnoRouterTesting"}}}