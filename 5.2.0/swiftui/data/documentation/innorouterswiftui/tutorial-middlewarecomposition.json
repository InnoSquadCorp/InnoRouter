{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},"primaryContentSections":[{"content":[{"level":2,"text":"Scenario","type":"heading","anchor":"Scenario"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every "},{"type":"codeVoice","code":"NavigationCommand"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalCommand"},{"type":"text","text":" should be logged"},{"type":"text","text":" "},{"type":"text","text":"before it executes. A feature-flagged screen must be gated behind"},{"type":"text","text":" "},{"text":"an entitlement check. An analytics call must fire after an","type":"text"},{"text":" ","type":"text"},{"text":"execution attempt finishes — but only for middlewares that actually","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"participated in the "},{"type":"codeVoice","code":"willExecute"},{"text":" decision.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This tutorial starts at the externally owned-store tier because middleware is","type":"text"},{"type":"text","text":" "},{"text":"installed when the authority is created. A self-contained stack without custom","type":"text"},{"text":" ","type":"text"},{"text":"policy should use ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" instead."}]},{"anchor":"Modeling-routes","text":"Modeling routes","level":2,"type":"heading"},{"type":"codeListing","code":["enum AppRoute: Route {","    case home","    case premiumDetail","    case paywall","}"],"syntax":"swift skip doc-fragment"},{"anchor":"Logging-middleware","text":"Logging middleware","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reuse the "},{"type":"codeVoice","code":"AnyNavigationMiddleware"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"AnyModalMiddleware"},{"type":"text","text":" "},{"type":"text","text":"closure initializers so a minimal shared logger composes without"},{"type":"text","text":" "},{"type":"text","text":"boilerplate:"}]},{"code":["@MainActor","func loggingNavigationMiddleware() -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(","        willExecute: { command, _ in","            Log.debug(\"navigation command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, result, _ in","            Log.debug(\"navigation finished: \\(command) -> \\(result)\")","            return result","        }","    )","}","","@MainActor","func loggingModalMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(","        willExecute: { command, _, _ in","            Log.debug(\"modal command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, _, _ in","            Log.debug(\"modal finished: \\(command)\")","        }","    )","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"anchor":"Entitlement-gating","text":"Entitlement gating","level":2,"type":"heading"},{"inlineContent":[{"text":"The gate is itself a middleware; denying a command is just","type":"text"},{"text":" ","type":"text"},{"text":"returning ","type":"text"},{"code":".cancel(reason)","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@MainActor","func entitlementGateNavigation(hasPremium: @escaping @MainActor () -> Bool) -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(willExecute: { command, _ in","        guard case .push(.premiumDetail) = command, !hasPremium() else {","            return .proceed(command)","        }","        return .cancel(.middleware(debugName: \"entitlement-gate\", command: command))","    })","}"],"type":"codeListing"},{"inlineContent":[{"text":"The cancellation surfaces through","type":"text"},{"text":" ","type":"text"},{"code":"ModalStoreConfiguration.onEvent","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":".commandIntercepted(_, .cancelled(...))","type":"codeVoice"},{"text":" and through","type":"text"},{"text":" ","type":"text"},{"code":"FlowRejectionReason.middlewareRejected(debugName: \"entitlement-gate\")","type":"codeVoice"},{"text":" ","type":"text"},{"text":"when used from ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Wiring-it-all","type":"heading","level":2,"text":"Wiring it all"},{"syntax":"swift skip doc-fragment","code":["let navStore = NavigationStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingNavigationMiddleware(), debugName: \"logging\"),","            .init(middleware: entitlementGateNavigation(hasPremium: { EntitlementStore.shared.hasPremium }), debugName: \"entitlement-gate\"),","        ]","    )",")","","let modalStore = ModalStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingModalMiddleware(), debugName: \"logging\"),","        ]","    )",")"],"type":"codeListing"},{"anchor":"Participant-discipline","type":"heading","level":2,"text":"Participant discipline"},{"inlineContent":[{"type":"text","text":"When a middleware cancels a command, every middleware whose"},{"type":"text","text":" "},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" hook ran is a participant, including the cancelling"},{"text":" ","type":"text"},{"text":"middleware itself. Middleware later in the chain did not run and","type":"text"},{"type":"text","text":" "},{"text":"therefore receives no completion callback.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"That guarantee is why the logger safely appears ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"type":"text","text":" the"},{"text":" ","type":"text"},{"type":"text","text":"entitlement gate — the logger’s "},{"code":"didExecute","type":"codeVoice"},{"type":"text","text":" fires even if the"},{"text":" ","type":"text"},{"type":"text","text":"gate cancels, so the cancellation is still recorded. Reordering"},{"type":"text","text":" "},{"text":"to ","type":"text"},{"type":"codeVoice","code":"[entitlement-gate, logging]"},{"text":" would skip the logger’s","type":"text"},{"text":" ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" on cancellation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For direct and batch ","type":"text"},{"code":".whenCancelled","type":"codeVoice"},{"text":" execution, ","type":"text"},{"type":"codeVoice","code":"didExecute"},{"text":" is","type":"text"},{"type":"text","text":" "},{"text":"attempt-level: it can run for a leg whose ","type":"text"},{"type":"codeVoice","code":"RouteStack"},{"text":" change is","type":"text"},{"type":"text","text":" "},{"text":"later discarded. Use the aggregate result and ","type":"text"},{"code":".changed","type":"codeVoice"},{"type":"text","text":" event to"},{"text":" ","type":"text"},{"type":"text","text":"observe durable state. Transactions instead keep "},{"code":"didExecute","type":"codeVoice"},{"type":"text","text":" "},{"text":"commit-only; its returned fold can change reporting after commit but","type":"text"},{"type":"text","text":" "},{"text":"cannot roll back the transaction.","type":"text"}]},{"type":"heading","text":"Observing a cancellation end-to-end","anchor":"Observing-a-cancellation-end-to-end","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ModalStore.events"},{"type":"text","text":" surfaces "},{"type":"codeVoice","code":".commandIntercepted(.cancelled(...))"},{"text":" ","type":"text"},{"text":"while a direct ","type":"text"},{"type":"codeVoice","code":"NavigationStore.execute(_:)"},{"text":" cancellation is returned","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"as "},{"type":"codeVoice","code":"NavigationResult.cancelled"},{"type":"text","text":"; a path-reconciliation policy may"},{"type":"text","text":" "},{"type":"text","text":"separately emit "},{"type":"codeVoice","code":".pathMismatch"},{"type":"text","text":". For a "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" in particular,"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore.events"},{"type":"text","text":" wraps both in "},{"type":"codeVoice","code":".navigation(...)"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".modal(...)"},{"type":"text","text":" "},{"type":"text","text":"cases so one subscriber sees the whole picture. Capture the stream before"},{"type":"text","text":" "},{"type":"text","text":"starting its lifecycle-owned task to register the subscriber synchronously."}]},{"type":"codeListing","code":["let events = flowStore.events","let observationTask = Task { @MainActor in","    for await event in events {","        if case .modal(.commandIntercepted(_, .cancelled(let reason))) = event {","            Log.info(\"modal cancelled: \\(reason)\")","        }","        if case .intentRejected(_, .middlewareRejected(let name)) = event {","            Log.info(\"flow intent rejected by: \\(name ?? \"nil\")\")","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"heading","text":"Testing middleware with FlowTestStore","anchor":"Testing-middleware-with-FlowTestStore","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":") asserts the cancellation"},{"type":"text","text":" "},{"type":"text","text":"chain without mounting SwiftUI:"}]},{"type":"codeListing","code":["@Test","@MainActor","func entitlementGateBlocksPremiumPush() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: entitlementGateNavigation(hasPremium: { false }), debugName: \"gate\")","            ])","        )","    )","","    store.send(.push(.premiumDetail))","","    store.receiveIntentRejected(","        intent: .push(.premiumDetail),","        reason: .middlewareRejected(debugName: \"gate\")","    )","    store.finish()","}"],"syntax":"swift skip doc-fragment"},{"type":"heading","text":"Next steps","anchor":"Next-steps","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","isActive":true},{"text":" to see how middleware","type":"text"},{"text":" ","type":"text"},{"text":"interacts with a multi-step flow plus a child coordinator.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read the ","type":"text"},{"type":"codeVoice","code":"Tutorial-TestingFlows"},{"text":" guide in the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"InnoRouterTesting"},{"text":" documentation catalog for the full host-less","type":"text"},{"text":" ","type":"text"},{"text":"test harness tour.","type":"text"}]}]}]}],"kind":"content"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition"]}],"abstract":[{"text":"Install logging, entitlement gating, and analytics middleware on","type":"text"},{"text":" ","type":"text"},{"text"