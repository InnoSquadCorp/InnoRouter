{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Split-Modal-and-Composition"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"abstract":[{"type":"text","text":"Choose one macro-first host for the local surface. "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" unify stack and modal actions, "},{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":" narrows a"},{"type":"text","text":" "},{"type":"text","text":"feature to modal actions, and "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":" owns native tab state."},{"type":"text","text":" "},{"type":"text","text":"Externally owned stores and coordinator hosts remain advanced authorities."}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/split-modal-and-composition"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Split, modal, and composition patterns","modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article"},"kind":"article","sections":[],"primaryContentSections":[{"content":[{"level":2,"text":"Split navigation","anchor":"Split-navigation","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" for a macro-first sidebar\/detail layout. It owns the"},{"type":"text","text":" "},{"type":"text","text":"detail stack and modal authority locally, builds destinations from the"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" enum, and exposes both through "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["RouterSplitHost(AppRoute.self) {","    SidebarView()","} root: {","    ContentUnavailableView(\"Select an item\", systemImage: \"sidebar.left\")","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"All stack and modal actions pass through the same "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", so a push is"},{"type":"text","text":" "},{"type":"text","text":"still rejected while a modal route is the flow tail. Use"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationSplitHost"},{"type":"text","text":" or "},{"type":"codeVoice","code":"CoordinatorSplitHost"},{"type":"text","text":" when the application must own"},{"type":"text","text":" "},{"type":"text","text":"an advanced stack-only authority directly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Important scope boundary:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" owns the detail stack and modal authority"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"advanced split hosts own only the detail stack"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"sidebar selection remains app-owned"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"column visibility remains system-managed"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"compact adaptation remains system-managed"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This keeps shell state out of the stack authority."}],"type":"paragraph"},{"style":"note","name":"Platform","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NavigationSplitHost"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CoordinatorSplitHost"},{"type":"text","text":" are "},{"type":"strong","inlineContent":[{"text":"unavailable on watchOS","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"because SwiftUI’s "},{"type":"codeVoice","code":"NavigationSplitView"},{"type":"text","text":" is unavailable there. watchOS apps should fall back"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"CoordinatorHost"},{"type":"text","text":" in the "},{"type":"codeVoice","code":"#else"},{"type":"text","text":" branch of a"},{"type":"text","text":" "},{"type":"codeVoice","code":"#if !os(watchOS)"},{"type":"text","text":" check."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" remains visible to watchOS callers as an explicitly"},{"type":"text","text":" "},{"type":"text","text":"unavailable declaration, whose compiler diagnostic directs macro-first code"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":"."}]}],"type":"aside"},{"level":2,"text":"Modal navigation","anchor":"Modal-navigation","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":" when a feature needs only sheet and cover presentation:"}],"type":"paragraph"},{"code":["RouterModalHost(AppRoute.self) {","    ModalLauncher()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"AppRoute"},{"type":"text","text":" has generated "},{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" mappings, the modal host presents a"},{"type":"text","text":" "},{"type":"text","text":"resolved incoming URL as a sheet automatically. Configure a different"},{"type":"text","text":" "},{"type":"text","text":"host-wide style when needed:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["RouterModalHost(AppRoute.self, deepLinkStyle: .fullScreenCover) {","    ModalLauncher()","}"]},{"type":"paragraph","inlineContent":[{"text":"Descendants use the same typed environment router as every other macro-first","type":"text"},{"text":" ","type":"text"},{"text":"surface:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@EnvironmentRouter(AppRoute.self) private var router","","Button(\"Edit\") {","    router.sheet(.editor)","}","","Button(\"Preview\") {","    router.cover(.preview)","}"]},{"type":"paragraph","inlineContent":[{"code":"RouterModalHost","type":"codeVoice"},{"text":" owns its ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" locally and publishes only modal","type":"text"},{"text":" ","type":"text"},{"text":"capability. An accidental ","type":"text"},{"code":"go","type":"codeVoice"},{"text":" call therefore reports a missing navigation","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"capability instead of silently inventing a stack."}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"ModalHost","type":"codeVoice"},{"text":" when restoration, middleware management, or","type":"text"},{"type":"text","text":" "},{"type":"text","text":"direct observation requires the application to own the modal authority."}]},{"type":"paragraph","inlineContent":[{"text":"On iOS and tvOS, ","type":"text"},{"type":"codeVoice","code":"ModalHost"},{"text":" uses native ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"fullScreenCover","type":"codeVoice"},{"text":" presentation.","type":"text"},{"text":" ","type":"text"},{"text":"On other supported platforms, ","type":"text"},{"code":"fullScreenCover","type":"codeVoice"},{"text":" requests degrade to ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The advanced modal authority intentionally stays separate from a stack-only","type":"text"},{"text":" ","type":"text"},{"text":"authority:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"modal intent uses ","type":"text"},{"code":"ModalIntent","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"stack intent uses ","type":"text"},{"code":"NavigationIntent","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"modal queue state lives in "},{"type":"codeVoice","code":"ModalStore"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"stack state lives in "},{"type":"codeVoice","code":"NavigationStore"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modal queue rules are intentionally small:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"present"},{"type":"text","text":" shows immediately when no modal is active."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"present"},{"type":"text","text":" appends to "},{"type":"codeVoice","code":"queuedPresentations"},{"type":"text","text":" when another modal is"},{"type":"text","text":" "},{"type":"text","text":"active."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"dismissCurrent"},{"type":"text","text":" dismisses the active modal and promotes the first"},{"type":"text","text":" "},{"type":"text","text":"queued presentation, if one exists."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"dismissAll"},{"type":"text","text":" clears both the active modal and the queue."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"replaceCurrent"},{"type":"text","text":" swaps only the active presentation and leaves the"},{"type":"text","text":" "},{"type":"text","text":"queue untouched; observers receive "},{"type":"codeVoice","code":".replaced"},{"type":"text","text":" before the command"},{"type":"text","text":" "},{"type":"text","text":"interception event."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"dismissCurrent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"dismissAll","type":"codeVoice"},{"text":" attempts enter modal middleware even when","type":"text"},{"text":" ","type":"text"},{"text":"there is no active presentation or queue. The resulting command can remain a","type":"text"},{"text":" ","type":"text"},{"text":"no-op, be cancelled, or be rewritten by middleware; this matches direct","type":"text"},{"text":" ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" execution instead of hiding empty-state attempts in ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Every convenience mutator reports its effective outcome as a","type":"text"},{"text":" ","type":"text"},{"code":"@discardableResult","type":"codeVoice"},{"text":": ","type":"text"},{"code":"present","type":"codeVoice"},{"text":" returns ","type":"text"},{"code":"ModalPresentResult","type":"codeVoice"},{"text":", while","type":"text"},{"text":" ","type":"text"},{"code":"replaceCurrent","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"dismissCurrent"},{"type":"text","text":", and "},{"type":"codeVoice","code":"dismissAll"},{"type":"text","text":" return the same"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalExecutionResult"},{"text":" that ","type":"text"},{"code":"execute(_:)","type":"codeVoice"},{"text":" produces. Callers can branch on a","type":"text"},{"text":" ","type":"text"},{"text":"middleware cancellation or an empty-state ","type":"text"},{"code":".noop","type":"codeVoice"},{"text":" directly at the call site","type":"text"},{"text":" ","type":"text"},{"text":"instead of subscribing to the event stream; call sites that ignore the","type":"text"},{"text":" ","type":"text"},{"text":"result compile unchanged.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When middleware cancels a FlowStore modal preview, the captured participants","type":"text"},{"text":" ","type":"text"},{"text":"still receive ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":", observers receive ","type":"text"},{"code":".commandIntercepted","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"ModalQueueCancellationPolicy","type":"codeVoice"},{"text":" is applied to the preview state. If that policy","type":"text"},{"text":" ","type":"text"},{"text":"changes the live queue, ","type":"text"},{"code":".queueChanged","type":"codeVoice"},{"text":" is delivered before the interception","type":"text"},{"text":" ","type":"text"},{"text":"and flow-level rejection. During an atomic reset, a cancellation previewed from","type":"text"},{"text":" ","type":"text"},{"text":"an intermediate shadow is finalized with the actual live state that survived","type":"text"},{"text":" ","type":"text"},{"text":"rollback. Successful navigation and modal previews that preceded that","type":"text"},{"text":" ","type":"text"},{"text":"cancellation stay off the public ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" path and run their package-owned","type":"text"},{"text":" ","type":"text"},{"text":"discard cleanup instead.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"alert","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"confirmationDialog","type":"codeVoice"},{"text":" stay outside this framework surface and should remain feature-owned state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"ModalStoreConfiguration","type":"codeVoice"},{"text":" uses one ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" callback for the complete","type":"text"},{"text":" ","type":"text"},{"text":"modal observation surface:","type":"text"}]},{"type":"codeListing","code":["let configuration = ModalStoreConfiguration<AppRoute>(","    onEvent: { event in","        switch event {","        case .presented(let presentation):","            analytics.recordPresented(presentation)","        case .dismissed(let presentation, let reason):","            analytics.recordDismissed(presentation, reason: reason)","        case .replaced(let old, let new):","            analytics.recordReplacement(from: old, to: new)","        case .queueChanged(let old, let new):","            diagnostics.recordQueueChange(from: old, to: new)","        case .commandIntercepted(let command, let result):","            diagnostics.record(command, result: result)","        case .middlewareMutation(let mutation):","            diagnostics.record(mutation)","        }","    }",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"When migrating to 5.0, merge the former modal lifecycle closures into","type":"text"},{"text":" ","type":"text"},{"text":"this switch. ","type":"text"},{"code":"ModalStore.events","type":"codeVoice"},{"text":" emits the same cases asynchronously.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Automatic URL handling pushes through ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"presents through ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":", or selects through ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":" applies one host-wide deep-link style; per-route presentation","type":"text"},{"text":" ","type":"text"},{"text":"policy still belongs at an application-owned flow boundary.","type":"text"}]},{"level":2,"type":"heading","text":"Composition","anchor":"Composition"},{"type":"paragraph","inlineContent":[{"text":"The recommended composition rules are:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose exactly one local macro-first authority for a route type in a"},{"type":"text","text":" "},{"type":"text","text":"subtree: "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Put shell state such as tabs or app mode outside feature-local routing."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use distinct route types for nested authorities that must remain"},{"type":"text","text":" "},{"type":"text","text":"independent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Promote to "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":", or a coordinator host"},{"type":"text","text":" "},{"type":"text","text":"only when the application owns that state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep feature-local routing inside the destination that owns it."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Do not wrap ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" in ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":" for the same route type:","type":"text"},{"text":" ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" already owns both capabilities, and a nested same-route host","type":"text"},{"text":" ","type":"text"},{"text":"replaces the outer authority for its subtree. These rules keep each authority","type":"text"},{"text":" ","type":"text"},{"text":"narrow without creating one application-wide store.","type":"text"}]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","type":"topic","title":"InnoRouterTesting","abstract":[],"kind":"symbol","role":"collection","url":"\/documentation\/innoroutertesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"role":"collectionGroup","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","abstract":[{"text":"Macro-first SwiftUI routing, externally owned stores, modal routing,","type":"text"},{"text":" ","type":"text"},{"text":"coordinators, and typed ","type":"text"},{"code":"EnvironmentRouter","type":"codeVoice"},{"text":" actions for InnoRouter.","type":"text"}],"kind":"article","type":"topic","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"}}}