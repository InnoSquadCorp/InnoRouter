Content":[{"type":"text","text":"execution mode"}]},{"text":". The store iterates the","type":"text"},{"text":" ","type":"text"},{"text":"commands, accepts partial success unless ","type":"text"},{"code":"stopOnFailure: true","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and coalesces observation: the SwiftUI state stays correct after","type":"text"},{"text":" ","type":"text"},{"text":"each step but only one ","type":"text"},{"code":".changed","type":"codeVoice"},{"text":" event surfaces at the end, followed","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":".batchExecuted","type":"codeVoice"},{"text":", through both ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"events","type":"codeVoice"},{"text":". Use it for","type":"text"},{"text":" ","type":"text"},{"text":"analytics-clean compound actions (“complete","type":"text"},{"text":" ","type":"text"},{"text":"checkout: replace stack + dismiss modal”).","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"executeTransaction","type":"codeVoice"},{"text":" is an ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"atomicity mode"}]},{"text":". The store applies","type":"text"},{"text":" ","type":"text"},{"text":"each command to a shadow stack, journals what middleware accepted","type":"text"},{"text":" ","type":"text"},{"text":"or rejected, and only commits if every step succeeds. On failure,","type":"text"},{"text":" ","type":"text"},{"text":"the journal walks back through the discarded acceptances so","type":"text"},{"text":" ","type":"text"},{"text":"middleware see consistent before\/after states. Use it for","type":"text"},{"text":" ","type":"text"},{"text":"correctness-critical compound actions (“if any step rejects, the","type":"text"},{"text":" ","type":"text"},{"text":"user sees no half-applied state”). An empty command list is not a","type":"text"},{"text":" ","type":"text"},{"text":"transactional success: it returns an uncommitted result with no","type":"text"},{"text":" ","type":"text"},{"text":"failure index because no command ran.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":".whenCancelled","type":"codeVoice"},{"text":" adds a smaller savepoint ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"inside one command"}]},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"primary and fallback each start from the same local snapshot, and","type":"text"},{"text":" ","type":"text"},{"text":"only one successful leg can change the stack. It does not turn a","type":"text"},{"text":" ","type":"text"},{"text":"surrounding batch into a transaction; later batch commands still","type":"text"},{"text":" ","type":"text"},{"text":"follow the batch’s continuation policy.","type":"text"}]},{"type":"heading","text":"Worked examples","anchor":"Worked-examples","level":2},{"type":"heading","text":"Compose a single command that drives a deep link plan","anchor":"Compose-a-single-command-that-drives-a-deep-link-plan","level":3},{"type":"codeListing","code":["let plan = NavigationPlan<AppRoute>(commands: [","    .replace([.home]),","    .push(.detail(id))","])","\/\/ Pass the plan to a single .sequence — the engine evaluates each","\/\/ component and reports `.multiple([...])` results.","let result = store.execute(.sequence(plan.commands))"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"Use when the deep-link planner already represents the path as a","type":"text"},{"text":" ","type":"text"},{"text":"sequence of ","type":"text"},{"code":"NavigationCommand","type":"codeVoice"},{"text":"s and you want the planner output","type":"text"},{"text":" ","type":"text"},{"text":"to flow through the same code path as a single command.","type":"text"}]},{"type":"heading","text":"Apply a checkout flow as one observable step","anchor":"Apply-a-checkout-flow-as-one-observable-