{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation"},"primaryContentSections":[{"content":[{"type":"heading","text":"Scenario","anchor":"Scenario","level":2},{"inlineContent":[{"type":"codeVoice","code":"myapp:\/\/app\/order\/42"},{"type":"text","text":" should land the user on the order detail for"},{"type":"text","text":" "},{"type":"text","text":"order 42, but only when they’re signed in. If the link arrives"},{"type":"text","text":" "},{"type":"text","text":"while signed out, the app must remember it, route through the"},{"type":"text","text":" "},{"type":"text","text":"sign-in flow, and then replay it — without dropping the original"},{"text":" ","type":"text"},{"text":"URL context.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This tutorial intentionally uses an externally owned ","type":"text"},{"type":"codeVoice","code":"NavigationStore"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"deep-link effect handler must apply plans outside the SwiftUI host. A local","type":"text"},{"type":"text","text":" "},{"type":"text","text":"single-route feature should start with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" + "},{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" + "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which installs incoming-URL handling automatically. Promote to this shape when"},{"type":"text","text":" "},{"type":"text","text":"authentication, pending replay, multi-step plans, restoration, or direct"},{"type":"text","text":" "},{"type":"text","text":"effect-handler ownership needs the authority."}],"type":"paragraph"},{"level":2,"text":"Modeling the routes","anchor":"Modeling-the-routes","type":"heading"},{"code":["\/\/ This host-independent excerpt uses plain Route conformance. Add @Router and","\/\/ a destination property when this same enum also owns SwiftUI rendering.","enum AppRoute: Route {","    case home","    case signIn","    case order(id: String)","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"text":"Wiring the pipeline","anchor":"Wiring-the-pipeline","type":"heading"},{"inlineContent":[{"code":"DeepLinkPipeline","type":"codeVoice"},{"text":" owns the validate-then-match-then-authorize flow. Pass the","type":"text"},{"text":" ","type":"text"},{"text":"matcher directly so matcher input-limit failures remain typed rejections:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import Synchronization","","let authentication = Mutex(false)","let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/home\") { _ in .home }","    DeepLinkMapping(\"\/signin\") { _ in .signIn }","    DeepLinkMapping(\"\/order\/:id\") { parameters in","        guard let id = parameters.firstValue(forName: \"id\") else { return nil }","        return .order(id: id)","    }","}","","let policy = DeepLinkAuthenticationPolicy<AppRoute>.required(","    shouldRequireAuthentication: { route in","        if case .order = route { return true }","        return false","    },","    isAuthenticated: { authentication.withLock { $0 } }",")","","let pipeline = DeepLinkPipeline(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    matcher: matcher,","    authenticationPolicy: policy",")"],"syntax":"swift skip doc-fragment"},{"text":"Handling a URL","anchor":"Handling-a-URL","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"DeepLinkEffectHandler"},{"text":" bridges the pipeline output into","type":"text"},{"type":"text","text":" "},{"code":"NavigationStore","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let store = NavigationStore<AppRoute>()","let effectHandler = DeepLinkEffectHandler(","    navigator: store,","    matcher: matcher,","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    authenticationPolicy: policy",")","","func handle(_ url: URL) {","    switch effectHandler.handle(url) {","    case .executed:","        break \/\/ The validated NavigationPlan has already been applied.","    case .executionFailed(_, let batch):","        Log.warning(\"deep-link batch failed after \\(batch.executedCommands.count) attempted commands\")","    case .pending:","        _ = store.execute(.push(.signIn))","    case .applicationRejected(_, let failure):","        Log.warning(\"deep-link plan rejected: \\(failure)\")","    case .rejected(let reason):","        Log.warning(\"deep link rejected: \\(reason)\")","    case .unhandled(let url):","        Log.warning(\"deep link unhandled: \\(url)\")","    case .invalidURL, .missingDeepLinkURL, .noPendingDeepLink:","        break","    }","}"],"syntax":"swift skip doc-fragment"},{"text":"Replaying after sign-in","anchor":"Replaying-after-sign-in","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Once the user signs in, the handler resumes any queued deep link:","type":"text"}]},{"type":"codeListing","code":["func userDidSignIn() {","    authentication.withLock { $0 = true }","    _ = effectHandler.resumePendingDeepLink()","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"The handler consults the retained ","type":"text"},{"code":"PendingDeepLink","type":"codeVoice"},{"text":", re-evaluates","type":"text"},{"text":" ","type":"text"},{"text":"the authentication policy, and only commits the batch if the new","type":"text"},{"text":" ","type":"text"},{"text":"state now permits the original URL. Any stale pending link (one","type":"text"},{"text":" ","type":"text"},{"text":"the user cancelled or that no longer validates) is dropped.","type":"text"}]},{"text":"Observing the reconciliation","anchor":"Observing-the-reconciliation","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore.events"},{"type":"text","text":" exposes the full sequence of batch +"},{"text":" ","type":"text"},{"text":"path-mismatch events as a single stream, which is handy for","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"diagnostics dashboards. Capture the stream before starting its lifecycle-owned"},{"text":" ","type":"text"},{"type":"text","text":"task so the subscriber is registered before any immediate reconciliation"},{"text":" ","type":"text"},{"type":"text","text":"command:"}]},{"type":"codeListing","code":["let events = store.events","let observationTask = Task { @MainActor in","    for await event in events {","        switch event {","        case .batchExecuted(let result):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .pathMismatch(let event):","            analytics.track(\"deep_link_mismatch\", [","                \"policy\": event.policy.rawValue,","                \"old\": event.oldPath.map(String.init(describing:)),","                \"new\": event.newPath.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"text":"Testing the chain","anchor":"Testing-the-chain","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTestStore"},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"InnoRouterTesting"},{"text":") asserts the batch +","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"side effects for each branch:"}]},{"code":["@Test","@MainActor","func signedOutDeepLinkDefersUntilSignIn() {","    let store = NavigationTestStore<AppRoute>()","    let handler = DeepLinkEffectHandler(","        navigator: store.store,","        matcher: matcher,","        authenticationPolicy: policy","    )","","    let result = handler.handle(URL(string: \"myapp:\/\/app\/order\/42\")!)","","    #expect(result == .pending(handler.pendingDeepLink!))","    #expect(store.state.path.isEmpty)","    store.finish()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"heading","text":"Next steps","anchor":"Next-steps","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Read "},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","type":"reference"},{"text":" for how the sign-in flow that","type":"text"},{"text":" ","type":"text"},{"text":"replays this deep link is modelled.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts","type":"reference"},{"text":" if the existing app","type":"text"},{"text":" ","type":"text"},{"text":"still uses ","type":"text"},{"code":"ModalHost { NavigationHost { ... } }","type":"codeVoice"},{"text":" pairs.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Match a URL, apply an authentication policy, and produce a"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":" that "},{"type":"codeVoice","code":"NavigationStore.executeBatch"},{"type":"text","text":" applies in one"},{"type":"text","text":" "},{"type":"text","text":"observable step. Queue the deep link while the user is signed out,"},{"type":"text","text":" "},{"type":"text","text":"replay it after sign-in, and surface cancellation reasons through"},{"type":"text","text":" "},{"type":"text","text":"typed outcomes."}],"sections":[],"metadata":{"role":"article","roleHeading":"Article","title":"Reconciling Deep Links End-to-End","modules":[{"name":"InnoRouterTesting"}]},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","abstract":[{"text":"Compose push, sheet, and cover steps into a single serializable flow with","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", then let the signup ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":" expose its result directly","type":"text"},{"text":" ","type":"text"},{"text":"to the same app-defined flow owner.","type":"text"}],"kind":"article","type":"topic","title":"Building a Login Onboarding Flow","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"role":"collectionGroup","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","abstract":[{"text":"Macro-first SwiftUI routing, externally owned stores, modal routing,","type":"text"},{"text":" ","type":"text"},{"text":"coordinators, and typed ","type":"text"},{"code":"EnvironmentRouter","type":"codeVoice"},{"text":" actions for InnoRouter.","type":"text"}],"kind":"article","type":"topic","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MigratingFromNestedHosts":{"role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-migratingfromnestedhosts","abstract":[{"text":"Replace manually composed ","type":"text"},{"code":"ModalHost { NavigationHost { ... } }","type":"codeVoice"},{"text":" ","type":"text"},{"text":"surfaces with a single ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":" backed by ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":". Preserve","type":"text"},{"text":" ","type":"text"},{"text":"existing ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" configurations while","type":"text"},{"text":" ","type":"text"},{"text":"unlocking a serializable ","type":"text"},{"code":"[RouteStep<R>]","type":"codeVoice"},{"text":" path and","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore.apply(_:)","type":"codeVoice"},{"text":" for restoration + deep-link hydration.","type":"text"}],"kind":"article","type":"topic","title":"Migrating from Nested Hosts to `FlowHost`","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","type":"topic","title":"InnoRouterTesting","abstract":[],"kind":"symbol","role":"collection","url":"\/documentation\/innoroutertesting"}}}