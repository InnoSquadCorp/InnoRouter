":"text","text":" and "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that pairs completion callbacks with the middlewares"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" hook actually ran."}],"kind":"article","role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/NavigationStore-and-Hosts":{"role":"article","url":"\/documentation\/innorouterswiftui\/navigationstore-and-hosts","abstract":[{"code":"RouterHost","type":"codeVoice"},{"text":" is the default self-contained stack-plus-modal surface.","type":"text"},{"text":" ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" is the advanced stack-only authority to use when the","type":"text"},{"text":" ","type":"text"},{"text":"application needs to own navigation state outside a host.","type":"text"}],"kind":"article","type":"topic","title":"NavigationStore and hosts","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/NavigationStore-and-Hosts"}}}