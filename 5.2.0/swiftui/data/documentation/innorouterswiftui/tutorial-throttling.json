{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-throttling"]}],"abstract":[{"type":"text","text":"Rate-limit navigation commands without threading timestamps through"},{"type":"text","text":" "},{"type":"text","text":"every call site. "},{"type":"codeVoice","code":"ThrottleNavigationMiddleware"},{"type":"text","text":" cancels commands that"},{"type":"text","text":" "},{"type":"text","text":"arrive within a minimum interval of a previously accepted command"},{"type":"text","text":" "},{"type":"text","text":"sharing the same key."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Scenario","level":2,"text":"Scenario"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Users double-tap a “Buy” button. The first tap pushes the purchase"},{"type":"text","text":" "},{"type":"text","text":"screen; the second should be silently dropped. Rolling that logic"},{"type":"text","text":" "},{"type":"text","text":"into every button is noise — middleware is the right layer."}]},{"text":"Installation","anchor":"Installation","type":"heading","level":2},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let store = NavigationStore<AppRoute>(","    configuration: NavigationStoreConfiguration(","        middlewares: [","            .init(","                middleware: AnyNavigationMiddleware(","                    ThrottleNavigationMiddleware<AppRoute>(","                        interval: .milliseconds(300)","                    )","                ),","                debugName: \"throttle\"","            )","        ]","    )",")"]},{"type":"paragraph","inlineContent":[{"text":"The default initializer uses ","type":"text"},{"code":"ContinuousClock","type":"codeVoice"},{"text":" and groups all","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"commands under a single global window. Within 300 ms of a previous"},{"type":"text","text":" "},{"type":"text","text":"successfully executed command, the next one is cancelled. If the"},{"type":"text","text":" "},{"text":"middleware is registered with ","type":"text"},{"code":"debugName: \"throttle\"","type":"codeVoice"},{"text":", the surfaced","type":"text"},{"text":" ","type":"text"},{"text":"reason becomes ","type":"text"},{"code":".cancelled(.middleware(debugName: \"throttle\", command: …))","type":"codeVoice"},{"text":".","type":"text"}]},{"anchor":"Per-command-keys","level":2,"type":"heading","text":"Per-command keys"},{"inlineContent":[{"text":"Group throttle windows by the command’s identity or shape:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["AnyNavigationMiddleware(","    ThrottleNavigationMiddleware<AppRoute>(interval: .milliseconds(300)) { command in","        if case .push(let route) = command {","            return \"push-\\(route)\"   \/\/ each push route gets its own window","        }","        return nil                    \/\/ other commands pass through","    }",")"]},{"inlineContent":[{"type":"text","text":"Return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to opt a command out of throttling entirely."}],"type":"paragraph"},{"text":"Testing with an injected clock","anchor":"Testing-with-an-injected-clock","type":"heading","level":2},{"inlineContent":[{"text":"The middleware is generic over ","type":"text"},{"code":"Clock","type":"codeVoice"},{"text":", so tests can drive time","type":"text"},{"type":"text","text":" "},{"type":"text","text":"deterministically:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let clock = TestClock()","let throttle = ThrottleNavigationMiddleware<AppRoute, TestClock>(","    interval: .milliseconds(300),","    clock: clock,","    key: { _ in \"all\" }",")","store.addMiddleware(AnyNavigationMiddleware(throttle), debugName: \"throttle\")","","store.send(.go(.home))","clock.advance(by: .milliseconds(50))","store.send(.go(.detail))         \/\/ cancelled — within window","","clock.advance(by: .milliseconds(400))","store.send(.go(.settings))       \/\/ accepted — beyond window"],"type":"codeListing"},{"anchor":"Composing-with-whenCancelled","level":2,"type":"heading","text":"Composing with `.whenCancelled`"},{"inlineContent":[{"text":"A throttle cancel surfaces as ","type":"text"},{"type":"codeVoice","code":".cancelled"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".whenCancelled(primary, fallback:)"},{"type":"text","text":" treats a throttled command the"},{"type":"text","text":" "},{"text":"same as any other cancelled command:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["store.execute(","    .whenCancelled(","        .push(.detail),","        fallback: .push(.home)","    )",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If the throttle middleware cancels the "},{"code":".push(.detail)","type":"codeVoice"},{"type":"text","text":", the"},{"text":" ","type":"text"},{"text":"fallback ","type":"text"},{"code":".push(.home)","type":"codeVoice"},{"text":" is attempted next. ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" ","type":"text"},{"text":"routes that fallback back through the full middleware chain, so a","type":"text"},{"text":" ","type":"text"},{"text":"global throttle key can cancel the fallback too if it still lands","type":"text"},{"text":" ","type":"text"},{"text":"inside the same throttle window. Each leg runs behind an internal","type":"text"},{"text":" ","type":"text"},{"text":"savepoint: if the fallback also fails or is cancelled, neither leg’s","type":"text"},{"text":" ","type":"text"},{"text":"partial state is committed.","type":"text"}],"type":"paragraph"},{"anchor":"Debounce","text":"Debounce?","type":"heading","level":2},{"inlineContent":[{"text":"Debounce semantics — “wait N ms, then fire the latest” — live in","type":"text"},{"text":" ","type":"text"},{"code":"DebouncingNavigator","type":"codeVoice"},{"text":", not in ","type":"text"},{"code":"NavigationCommand","type":"codeVoice"},{"text":". That keeps the","type":"text"},{"text":" ","type":"text"},{"text":"engine synchronous while the async wrapper owns the timer,","type":"text"},{"text":" ","type":"text"},{"text":"cancellation, and ","type":"text"},{"type":"codeVoice","code":"Clock"},{"text":" injection needed for deterministic tests.","type":"text"},{"text":" ","type":"text"},{"text":"Use throttle middleware for synchronous “reject too soon” behavior","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"DebouncingNavigator","type":"codeVoice"},{"type":"text","text":" for delayed “latest wins” behavior."}],"type":"paragraph"},{"text":"Next steps","level":2,"anchor":"Next-steps","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/NavigationStore-and-Hosts","isActive":true,"type":"reference"},{"text":" for the typed ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" callback and"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore.events"},{"type":"text","text":" stream that expose throttle cancellations."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","isActive":true,"type":"reference"},{"text":" for the broader","type":"text"},{"text":" ","type":"text"},{"text":"middleware composition story (logging, entitlement gating,","type":"text"},{"type":"text","text":" "},{"text":"analytics).","type":"text"}]}]}]}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/