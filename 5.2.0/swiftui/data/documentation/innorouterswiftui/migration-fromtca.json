{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Migration-FromTCA"},"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","primaryContentSections":[{"content":[{"type":"heading","anchor":"Why-this-migration","text":"Why this migration","level":2},{"type":"paragraph","inlineContent":[{"text":"TCA’s navigation surface (","type":"text"},{"type":"codeVoice","code":"StackState<Element>"},{"type":"text","text":", "},{"code":"@Presents","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"NavigationStackStore","type":"codeVoice"},{"type":"text","text":") bundles three responsibilities:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"State authority"}],"type":"strong"},{"text":" — what is on the stack, what modal is up.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Action plumbing"}],"type":"strong"},{"type":"text","text":" — "},{"code":"Action.path(.push(...))","type":"codeVoice"},{"text":", ","type":"text"},{"code":"delegate","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"actions, "},{"code":".dismiss","type":"codeVoice"},{"type":"text","text":" from the parent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"View binding"}]},{"type":"text","text":" — "},{"code":"NavigationStackStore","type":"codeVoice"},{"text":" translates child","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"stores into "},{"code":"NavigationLink","type":"codeVoice"},{"type":"text","text":"s."}]}]}]},{"inlineContent":[{"text":"InnoRouter takes ownership of (1) and (3) and replaces (2)","type":"text"},{"text":" ","type":"text"},{"text":"with a typed ","type":"text"},{"code":"NavigationIntent","type":"codeVoice"},{"text":" enum that flows through the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"SwiftUI environment. The reducer surface shrinks because the"},{"text":" ","type":"text"},{"type":"text","text":"parent reducer no longer needs to forward navigation actions"},{"text":" ","type":"text"},{"type":"text","text":"into "},{"code":"StackState","type":"codeVoice"},{"type":"text","text":" mutations."}],"type":"paragraph"},{"text":"The minimal swap","anchor":"The-minimal-swap","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A canonical TCA navigation feature looks like this:"}]},{"type":"codeListing","code":["@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable {","        var path = StackState<Path.State>()","    }","","    enum Action {","        case path(StackActionOf<Path>)","    }","","    @Reducer","    struct Path {","        enum State: Equatable { case detail(DetailFeature.State) }","        enum Action { case detail(DetailFeature.Action) }","        var body: some ReducerOf<Self> {","            Scope(state: \\.detail, action: \\.detail) { DetailFeature() }","        }","    }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","            .forEach(\\.path, action: \\.path) { Path() }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        NavigationStackStore(store.scope(state: \\.path, action: \\.path)) {","            RootView(store: store)","        } destination: { store in","            switch store.state {","            case .detail:","                if let detail = store.scope(state: \\.detail, action: \\.detail) {","                    DetailView(store: detail)","                }","            }","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"After migration:"}]},{"type":"codeListing","code":["@Router","enum AppRoute {","    case detail(DetailFeature.State.ID)","","    var destination: some View {","        switch self {","        case .detail(let id):","            DetailView(\/* hydrate from id *\/)","        }","    }","}","","@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable { \/* business state only *\/ }","","    enum Action { \/* business actions only *\/ }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        RouterHost(AppRoute.self) {","            RootView(store: store)","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Three things changed:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The reducer’s "},{"code":"path: StackState<Path.State>","type":"codeVoice"},{"type":"text","text":" is gone — the"},{"type":"text","text":" "},{"type":"text","text":"parent reducer no longer carries navigation state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The parent action enum no longer routes"},{"type":"text","text":" "},{"code":"case path(StackActionOf<Path>)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The view uses macro-generated destinations with "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" in place of"},{"type":"text","text":" "},{"code":"NavigationStackStore","type":"codeVoice"},{"type":"text","text":" + "},{"code":"Path","type":"codeVoice"},{"type":"text","text":" reducer composition. No navigation store is"},{"type":"text","text":" "},{"type":"text","text":"exposed to the feature for this self-contained stack."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a TCA dependency, deep-link handler, or restoration boundary must access"},{"type":"text","text":" "},{"type":"text","text":"the navigation authority, promote the store to the app boundary. "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" "},{"type":"text","text":"still removes the destination closure, so the advanced form keeps the correct"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" closure order:"}]},{"code":["@State private var navigationStore = NavigationStore<AppRoute>()","","NavigationHost(store: navigationStore) {","    RootView(store: store)","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"heading","anchor":"Modal-presentation-Presents-%E2%86%92-ModalStore","text":"Modal presentation (`@Presents` → `ModalStore`)","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TCA’s "},{"code":"@Presents","type":"codeVoice"},{"type":"text","text":" is conceptually equivalent to a "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"slot. Replace:"}]},{"code":["@ObservableState","struct State {","    @Presents var sheet: SheetFeature.State?","}","","enum Action {","    case sheet(PresentationAction<SheetFeature.Action>)","}","","\/\/ View",".sheet(item: $store.scope(state: \\.sheet, action: \\.sheet)) { … }"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"with:"}]},{"code":["\/\/ State + Action no longer carry the modal slot.","","\/\/ View","ModalHost(store: modalStore) { route in","    switch route { case .sheet: SheetView(…) }","} content: {","    RootView()","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The reducer no longer fires "},{"type":"codeVoice","code":"Action.sheet(.presented(…))"},{"type":"text","text":"; the view reads"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter(AppModalRoute.self)"},{"type":"text","text":" and calls "},{"type":"codeVoice","code":"router.sheet(_:)"},{"type":"text","text":". Move to"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" only when stack and modal state must form one atomic timeline;"},{"type":"text","text":" "},{"type":"text","text":"flow-specific intents use "},{"type":"codeVoice","code":"router.send(flow:)"},{"type":"text","text":" through the same environment"},{"type":"text","text":" "},{"type":"text","text":"router surface."}]},{"anchor":"Stack-+-modal-as-one-value-StackState-+-Presents-%E2%86%92-FlowStore","text":"Stack + modal as one value (`StackState` + `@Presents` → `FlowStore`)","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a feature uses both navigation and modal authority, replace"},{"type":"text","text":" "},{"type":"text","text":"both with a single "},{"type":"codeVoice","code":"FlowStore<Route>"},{"type":"text","text":" and observe "},{"type":"codeVoice","code":"path: [RouteStep<Route>]"},{"type":"text","text":" as the single source of truth. The"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" value type makes the entire flow state Codable for"},{"type":"text","text":" "},{"type":"text","text":"deep-link rehydration and state restoration."}]},{"type":"heading","anchor":"Testing-TestStore-%E2%86%92-NavigationTestStore--FlowTestStore","level":2,"text":"Testing — `TestStore` → `NavigationTestStore` \/ `FlowTestStore`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" ships host-less test stores that mirror"},{"type":"text","text":" "},{"type":"text","text":"TCA’s strict-exhaustivity ergonomics. Swap:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let testStore = TestStore(initialState: AppFeature.State()) { AppFeature() }","await testStore.send(.path(.push(id: 0, state: .detail(...))))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"with:"}]},{"code":["let test = NavigationTestStore<AppRoute>()","test.execute(.push(.detail(id)))","test.expect(state: [.detail(id)])"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The test store keeps the analytics \/ diagnostic "},{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" callback the"},{"type":"text","text":" "},{"type":"text","text":"production store wired through "},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so the test asserts production telemetry without"},{"type":"text","text":" "},{"type":"codeVoice","code":"@testable import"},{"type":"text","text":"."}]},{"anchor":"What-stays-in-TCA","text":"What stays in TCA","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter explicitly does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" replace:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Business logic reducers ("},{"code":"Reduce { state, action in … }","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Side effects ("},{"code":"Effect.send","type":"codeVoice"},{"type":"text","text":", "},{"code":"Effect.run","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dependency injection ("},{"code":"@Dependency","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross-feature coordination (parent ⇄ child reducer composition"},{"type":"text","text":" "},{"type":"text","text":"for non-navigation concerns)"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical migrated codebase keeps every reducer in place; the"},{"type":"text","text":" "},{"type":"text","text":"delta is the state slots and actions removed because navigation"},{"type":"text","text":" "},{"type":"text","text":"no longer needs reducer-level modeling."}]},{"anchor":"Migration-sequence","text":"Migration sequence","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Start with a leaf feature whose navigation state lives only in the parent"},{"type":"text","text":" "},{"type":"text","text":"reducer’s "},{"code":"StackState","type":"codeVoice"},{"type":"text","text":". Declare its route with "},{"code":"@Router","type":"codeVoice"},{"type":"text","text":" and replace the"},{"type":"text","text":" "},{"type":"text","text":"view-layer wiring with "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Strip the matching "},{"code":"path","type":"codeVoice"},{"type":"text","text":" slot and "},{"code":"Path","type":"codeVoice"},{"type":"text","text":" reducer from the"},{"type":"text","text":" "},{"type":"text","text":"parent reducer. Verify the existing tests still pass against"},{"type":"text","text":" "},{"type":"text","text":"the trimmed reducer state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeat per feature. The blast radius per migration is contained because"},{"type":"text","text":" "},{"type":"text","text":"each "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" owns an independent local "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" behind"},{"type":"text","text":" "},{"code":"@EnvironmentRouter","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tackle modal authority feature-by-feature once the navigation"},{"type":"text","text":" "},{"type":"text","text":"stacks are ported. "},{"code":"@Presents","type":"codeVoice"},{"type":"text","text":" is the cheapest swap."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For features with both stack and modal authority, migrate"},{"type":"text","text":" "},{"type":"text","text":"them last by lifting the combined state into "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"capturing the deep-link flow through "},{"code":"FlowPlan","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"anchor":"Common-pitfalls","text":"Common pitfalls","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Action forwarding instinct."}],"type":"strong"},{"type":"text","text":" TCA users habitually plumb navigation"},{"type":"text","text":" "},{"type":"text","text":"through actions even when the feature doesn’t need it. With"},{"type":"text","text":" "},{"code":"@EnvironmentRouter","type":"codeVoice"},{"type":"text","text":", the view calls "},{"code":"router.go(...)","type":"codeVoice"},{"type":"text","text":" directly; the reducer"},{"type":"text","text":" "},{"type":"text","text":"never sees a navigation action unless you explicitly want to gate one"},{"type":"text","text":" "},{"type":"text","text":"through middleware."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Strict concurrency floor."}],"type":"strong"},{"type":"text","text":" InnoRouter requires iOS 18 \/"},{"type":"text","text":" "},{"type":"text","text":"Swift 6.3. If the project still targets iOS 13–17, plan the"},{"type":"text","text":" "},{"type":"text","text":"platform bump as a separate PR before the navigation"},{"type":"text","text":" "},{"type":"text","text":"migration."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"codeVoice","code":"@Bindable store"},{"type":"text","text":" ergonomics."}],"type":"strong"},{"type":"text","text":" "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" and works with "},{"code":"@Bindable","type":"codeVoice"},{"type":"text","text":" directly — no"},{"type":"text","text":" "},{"code":"bindable","type":"codeVoice"},{"type":"text","text":" modifier or scoped binding helpers are needed."}]}]}],"type":"unorderedList"},{"anchor":"Reference","text":"Reference","level":2,"type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"@Router","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"@EnvironmentRouter","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"NavigationHost","type":"codeVoice"},{"type":"text","text":" for externally owned authority"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"ModalHost","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"FlowHost","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"FlowPlan","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"InnoRouterTesting","type":"codeVoice"},{"type":"text","text":" ("},{"code":"NavigationTestStore","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"ModalTestStore","type":"codeVoice"},{"type":"text","text":", "},{"code":"FlowTestStore","type":"codeVoice"},{"type":"text","text":")"}]}]}],"type":"unorderedList"}],"kind":"content"}],"abstract":[{"type":"text","text":"This guide walks a TCA project through replacing its navigation"},{"type":"text","text":" "},{"type":"text","text":"layer with InnoRouter while keeping the rest of the architecture"},{"type":"text","text":" "},{"type":"text","text":"(reducers, effects, state) intact. InnoRouter is "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"replacement for TCA’s reducer composition — it replaces the"},{"type":"text","text":" "},{"type":"text","text":"parts of TCA that own "},{"type":"emphasis","inlineContent":[{"text":"navigation state","type":"text"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"text":"modal authority","type":"text"}]},{"type":"text","text":"."}],"metadata":{"roleHeading":"Article","title":"Migrating navigation from TCA to InnoRouter","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"variants":[{"paths":["\/documentation\/innorouterswiftui\/migration-fromtca"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","type":"topic","title":"InnoRouterTesting","abstract":[],"kind":"symbol","role":"collection","url":"\/documentation\/innoroutertesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"role":"collectionGroup","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","abstract":[{"text":"Macro-first SwiftUI routing, externally owned stores, modal routing,","type":"text"},{"text":" ","type":"text"},{"text":"coordinators, and typed ","type":"text"},{"code":"EnvironmentRouter","type":"codeVoice"},{"text":" actions for InnoRouter.","type":"text"}],"kind":"article","type":"topic","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"}}}