{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts"},"metadata":{"roleHeading":"Article","title":"Migrating from Nested Hosts to `FlowHost`","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"abstract":[{"type":"text","text":"Replace manually composed "},{"type":"codeVoice","code":"ModalHost { NavigationHost { ... } }"},{"type":"text","text":" "},{"type":"text","text":"surfaces with a single "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" backed by "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":". Preserve"},{"type":"text","text":" "},{"type":"text","text":"existing "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" configurations while"},{"type":"text","text":" "},{"type":"text","text":"unlocking a serializable "},{"type":"codeVoice","code":"[RouteStep<R>]"},{"type":"text","text":" path and"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore.apply(_:)"},{"type":"text","text":" for restoration + deep-link hydration."}],"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"overview","level":2},{"type":"paragraph","inlineContent":[{"text":"This is an advanced promotion path. A self-contained push-only feature should","type":"text"},{"text":" ","type":"text"},{"text":"stay on ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":"; introduce the externally owned stores below","type":"text"},{"text":" ","type":"text"},{"text":"only when push and modal state must be restored or deep-linked as one value.","type":"text"}]},{"type":"heading","text":"Starting point","anchor":"Starting-point","level":2},{"type":"paragraph","inlineContent":[{"text":"An app that shipped before ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" landed typically has:","type":"text"}]},{"type":"codeListing","code":["@main","struct LegacyApp: App {","    @State private var nav = NavigationStore<AppRoute>()","    @State private var modal = ModalStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            ModalHost(store: modal, destination: destination) {","                NavigationHost(store: nav, destination: destination) {","                    RootView()","                }","            }","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"Two stores. Two hosts. Path + modal state cannot be round-tripped","type":"text"},{"text":" ","type":"text"},{"text":"as one value — the app can’t persist “user is 3 screens deep","type":"text"},{"text":" ","type":"text"},{"text":"inside a presented sheet” without hand-serializing both halves.","type":"text"}]},{"type":"heading","text":"Target shape","anchor":"Target-shape","level":2},{"type":"codeListing","code":["@main","struct MigratedApp: App {","    @State private var flow = FlowStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: flow,","                destination: destination,","                root: { RootView() }","            )","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"One store. One host. ","type":"text"},{"code":"flow.path: [RouteStep<AppRoute>]","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"single source of truth; push + sheet + cover are three cases of","type":"text"},{"text":" ","type":"text"},{"text":"the same enum.","type":"text"}]},{"type":"heading","text":"Migration steps","anchor":"Migration-steps","level":2},{"type":"heading","text":"1. Swap the host layering","anchor":"1-Swap-the-host-layering","level":3},{"type":"paragraph","inlineContent":[{"text":"Replace the nested host pair with ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":". It renders environment-free","type":"text"},{"text":" ","type":"text"},{"text":"navigation and modal surfaces around one ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", then publishes one","type":"text"},{"text":" ","type":"text"},{"text":"unified authority for ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":". External observable behavior stays","type":"text"},{"text":" ","type":"text"},{"text":"the same without exposing the inner stores as independent mutation surfaces.","type":"text"}]},{"type":"heading","text":"2. Route view actions through `EnvironmentRouter`","anchor":"2-Route-view-actions-through-EnvironmentRouter","level":3},{"type":"paragraph","inlineContent":[{"text":"Old:","type":"text"}]},{"type":"codeListing","code":["navigationStore.send(.go(.detail))","modalStore.present(.sheet, style: .sheet)"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"New:","type":"text"}]},{"type":"codeListing","code":["@EnvironmentRouter(AppRoute.self) private var router","\/\/ ...","router.go(.detail)","router.sheet(.sheet)"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"router.send(flow:)","type":"codeVoice"},{"text":" only for flow-specific operations such as resetting a","type":"text"},{"text":" ","type":"text"},{"text":"complete ","type":"text"},{"code":"RouteStep","type":"codeVoice"},{"text":" path.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"FlowStore.send","type":"codeVoice"},{"text":" routes navigation and modal intents through the corresponding","type":"text"},{"text":" ","type":"text"},{"text":"configured middleware and reports their wrapped events through the unified","type":"text"},{"text":" ","type":"text"},{"text":"flow observation stream.","type":"text"}]},{"type":"heading","text":"3. Port store configuration through `FlowStoreConfiguration`","anchor":"3-Port-store-configuration-through-FlowStoreConfiguration","level":3},{"type":"paragraph","inlineContent":[{"code":"FlowStoreConfiguration","type":"codeVoice"},{"text":" composes ","type":"text"},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"text":" +","type":"text"},{"text":" ","type":"text"},{"code":"ModalStoreConfiguration","type":"codeVoice"},{"text":", so existing configs port 1:1:","type":"text"}]},{"type":"codeListing","code":["let flow = FlowStore<AppRoute>(","    configuration: .init(","        navigation: legacyNavigationConfiguration,","        modal: legacyModalConfiguration,","        onEvent: { event in","            switch event {","            case .pathChanged(let old, let new):","                Log.debug(\"flow path: \\(old) -> \\(new)\")","            case .intentRejected(let intent, let reason):","                Log.info(\"flow rejected \\(intent): \\(reason)\")","            case .navigation(let event):","                Log.debug(\"navigation event: \\(event)\")","            case .modal(let event):","                Log.debug(\"modal event: \\(event)\")","            }","        }","    )",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"In 5.0, each store configuration has one typed ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" callback.","type":"text"},{"text":" ","type":"text"},{"text":"Remove the former per-case callback arguments and switch over the","type":"text"},{"text":" ","type":"text"},{"text":"matching event enum instead. The flow-level callback also receives","type":"text"},{"text":" ","type":"text"},{"text":"the inner navigation and modal events as wrapped cases; callbacks","type":"text"},{"text":" ","type":"text"},{"text":"already installed on the two legacy configurations still receive","type":"text"},{"text":" ","type":"text"},{"text":"their direct ","type":"text"},{"code":"NavigationEvent","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"ModalEvent","type":"codeVoice"},{"text":" values.","type":"text"}]},{"type":"heading","text":"4. Handle the two new invariant-violation paths","anchor":"4-Handle-the-two-new-invariant-violation-paths","level":3},{"type":"paragraph","inlineContent":[{"code":"FlowStore","type":"codeVoice"},{"text":" rejects intents that would violate its invariants:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Intent situation"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reason emitted"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".push"},{"type":"text","text":" while a modal tail is active"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pushBlockedByModalTail"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".reset([.sheet, .push])"},{"type":"text","text":" (modal not at tail)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidResetPath"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Any intent cancelled by middleware"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".middlewareRejected(debugName:)"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"Subscribe to ","type":"text"},{"code":"flow.events","type":"codeVoice"},{"text":" or handle ","type":"text"},{"code":".intentRejected","type":"codeVoice"},{"text":" in the","type":"text"},{"text":" ","type":"text"},{"text":"configuration’s ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" closure. The legacy","type":"text"},{"text":" ","type":"text"},{"text":"stores never had this signal; before the migration, a push attempt","type":"text"},{"text":" ","type":"text"},{"text":"during a sheet presentation silently no-opped or tripped up the","type":"text"},{"text":" ","type":"text"},{"text":"app in subtle ways.","type":"text"}]},{"type":"heading","text":"5. Adopt `apply(_:)` for deep links and restoration","anchor":"5-Adopt-apply-for-deep-links-and-restoration","level":3},{"type":"paragraph","inlineContent":[{"code":"FlowPlan<R>.steps","type":"codeVoice"},{"text":" is ","type":"text"},{"code":"[RouteStep<R>]","type":"codeVoice"},{"text":", so once your routes opt","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["extension AppRoute: Codable {}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StatePersistence<AppRoute>"},{"text":" round-trips the whole flow state:","type":"text"}]},{"type":"codeListing","code":["let persistence = StatePersistence<AppRoute>()","","\/\/ On app background","try persistence.encode(FlowPlan(steps: flow.path)).write(to: url)","","\/\/ On launch","if let data = try? Data(contentsOf: url) {","    flow.apply(try persistence.decode(data))","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Deep-link resolvers can emit a "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" directly and hand it to"},{"type":"text","text":" "},{"type":"codeVoice","code":"flow.apply(_:)"},{"type":"text","text":" to hydrate a push + sheet terminal URL in one"},{"type":"text","text":" "},{"type":"text","text":"atomic step."}]},{"type":"heading","level":3,"text":"6. Migrate tests incrementally","anchor":"6-Migrate-tests-incrementally"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTestStore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalTestStore"},{"type":"text","text":" remain available, so tests that"},{"type":"text","text":" "},{"type":"text","text":"infer their event types can keep the same test-store setup. Removed event"},{"type":"text","text":" "},{"type":"text","text":"typealiases do not preserve explicit annotations: migrate those annotations to"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationEvent<R>"},{"type":"text","text":" or "},{"type":"codeVoice","code":"ModalEvent<M>"},{"type":"text","text":", and use "},{"type":"codeVoice","code":"FlowEvent<R>"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":". Re-home the highest-value scenarios onto "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" when"},{"text":" ","type":"text"},{"text":"you get a chance — a single ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"type":"text","text":" subscription asserts both"},{"type":"text","text":" "},{"type":"text","text":"navigation and modal emissions in the same FIFO queue, which usually"},{"type":"text","text":" "},{"type":"text","text":"compresses a 40-line legacy test into 15 lines."}]},{"type":"heading","level":2,"text":"Rollback story","anchor":"Rollback-story"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The migration is per-flow. Any screen tree that still uses the"},{"type":"text","text":" "},{"type":"text","text":"nested host pair continues to build. "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" lives alongside"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":"; adopting one doesn’t remove the"},{"type":"text","text":" "},{"type":"text","text":"others. Incremental migration by flow (onboarding, settings,"},{"type":"text","text":" "},{"type":"text","text":"checkout, …) is supported."}]},{"type":"heading","level":2,"text":"Next steps","anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","type":"reference"},{"text":" to see a greenfield flow","type":"text"},{"text":" ","type":"text"},{"text":"composed with ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read the ","type":"text"},{"code":"Tutorial-TestingFlows","type":"codeVoice"},{"text":" guide in the","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":" documentation catalog for the full host-less","type":"text"},{"text":" ","type":"text"},{"text":"test harness story.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"See the ","type":"text"},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"send(_:)"},{"type":"text","text":" vs "},{"type":"codeVoice","code":"execute(_:)"},{"type":"text","text":" — picking the right entry"},{"type":"text","text":" "},{"type":"text","text":"point"}]},{"text":" section of the README for guidance on choosing among","type":"text"},{"text":" ","type":"text"},{"code":"send","type":"codeVoice"},{"text":", ","type":"text"},{"code":"execute","type":"codeVoice"},{"text":", ","type":"text"},{"code":"executeBatch","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"executeTransaction","type":"codeVoice"},{"text":" once","type":"text"},{"text":" ","type":"text"},{"text":"the flow is migrated.","type":"text"}]}]}]}]}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-migratingfromnestedhosts"],"traits":[{"interface