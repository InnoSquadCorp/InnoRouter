{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Article","title":"Building a Login Onboarding Flow","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then let the signup "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}],"kind":"article","primaryContentSections":[{"content":[{"type":"heading","anchor":"Scenario","text":"Scenario","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app launches on a welcome screen. Tapping "},{"type":"emphasis","inlineContent":[{"text":"Continue","type":"text"}]},{"type":"text","text":" pushes a"},{"type":"text","text":" "},{"type":"text","text":"pre-auth detail screen. Tapping "},{"type":"emphasis","inlineContent":[{"text":"Create account","type":"text"}]},{"type":"text","text":" presents a signup"},{"type":"text","text":" "},{"type":"text","text":"sheet. When the signup finishes (or is cancelled) the owning flow"},{"type":"text","text":" "},{"type":"text","text":"resumes — either navigating to "},{"type":"codeVoice","code":".home(user)"},{"type":"text","text":" or staying put."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modeling this with raw "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" means two"},{"type":"text","text":" "},{"type":"text","text":"authority objects, two view-layer hosts, and hand-rolled"},{"type":"text","text":" "},{"type":"text","text":"continuation plumbing to surface the sheet result back to the"},{"type":"text","text":" "},{"type":"text","text":"owner. "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" collapse this to a single"},{"type":"text","text":" "},{"type":"text","text":"store and one "},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This flow has crossed the macro-first local-stack boundary: push and modal"},{"type":"text","text":" "},{"type":"text","text":"state must share one externally owned, serializable authority. A push-only"},{"type":"text","text":" "},{"type":"text","text":"version should stay on "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" + "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" instead."}]},{"type":"heading","anchor":"Routes","text":"Routes","level":2},{"type":"codeListing","code":["enum AppRoute: Route {","    case preAuth","    case signup","    case home(UserID)","}"],"syntax":"swift skip doc-fragment"},{"type":"heading","anchor":"Wiring-the-flow-host","text":"Wiring the flow host","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" renders environment-free navigation and modal surfaces around one"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then publishes a unified router authority to its view subtree:"}]},{"type":"codeListing","code":["@main","struct DemoApp: App {","    @State private var onboarding = OnboardingCoordinator()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: onboarding.flowStore,","                destination: destination,","                root: {","                    WelcomeRootView {","                        Task { await onboarding.startSignUpFlow() }","                    }","                }","            )","        }","    }","","    @ViewBuilder","    private func destination(_ route: AppRoute) -> some View {","        switch route {","        case .preAuth:","            PreAuthDetailView()","        case .signup:","            if let signUp = onboarding.activeSignUp {","                SignUpView(coordinator: signUp)","            }","        case .home(let id):","            HomeView(userID: id)","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"heading","anchor":"Emitting-intents-from-views","text":"Emitting intents from views","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views never mutate "},{"type":"codeVoice","code":"FlowStore.path"},{"type":"text","text":" directly. They read typed actions from"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":"; the host projects those actions through "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"middleware and event observation see every step:"}]},{"type":"codeListing","code":["struct WelcomeRootView: View {","    @EnvironmentRouter(AppRoute.self) private var router","    let startSignUp: @MainActor () -> Void","","    var body: some View {","        VStack {","            Button(\"Continue\") {","                router.go(.preAuth)","            }","            Button(\"Create account\") {","                startSignUp()","            }","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"router.send(flow:)"},{"type":"text","text":" only for flow-specific operations that do not have a"},{"type":"text","text":" "},{"type":"text","text":"focused action, such as resetting a complete "},{"type":"codeVoice","code":"RouteStep"},{"type":"text","text":" path."}]},{"type":"heading","anchor":"Awaiting-a-signup-sub-flow","text":"Awaiting a signup sub-flow","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The signup sheet opens its own child coordinator that owns the step progression"},{"type":"text","text":" "},{"type":"text","text":"(email → password → confirmation). The app-defined onboarding owner keeps that"},{"type":"text","text":" "},{"type":"text","text":"child in presentation state, presents it through the same "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then"},{"type":"text","text":" "},{"type":"codeVoice","code":"await"},{"type":"text","text":"s the final "},{"type":"codeVoice","code":"UserID"},{"type":"text","text":" through "},{"type":"codeVoice","code":"signUp.waitForResult()"},{"type":"text","text":":"}]},{"type":"codeListing","code":["@MainActor","final class SignUpCoordinator: ChildCoordinator {","    typealias Result = UserID","","    var onFinish: (@MainActor @Sendable (UserID) -> Void)?","    var onCancel: (@MainActor @Sendable () -> Void)?","","    \/\/ ...step state + methods omitted","","    func userDidCreateAccount(_ userID: UserID) {","        onFinish?(userID)   \/\/ emits the result back to the owner","    }","","    func userCancelled() {","        onCancel?()          \/\/ the owner sees nil","    }","}","","@Observable","@MainActor","final class OnboardingCoordinator {","    let flowStore = FlowStore<AppRoute>()","","    \/\/ The sheet content observes this app-owned placement state.","    var activeSignUp: SignUpCoordinator?","","    func startSignUpFlow() async {","        guard activeSignUp == nil else { return }","","        let signUp = SignUpCoordinator()","        activeSignUp = signUp","        defer { activeSignUp = nil }","","        flowStore.send(.presentSheet(.signup))","        let result = await signUp.waitForResult()","        flowStore.send(.dismiss)","","        if let userID = result {","            flowStore.send(.push(.home(userID)))","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"activeSignUp"},{"type":"text","text":" determines which child the "},{"type":"codeVoice","code":".signup"},{"type":"text","text":" destination renders;"},{"type":"text","text":" "},{"type":"codeVoice","code":"flowStore"},{"type":"text","text":" remains the sole push-and-modal authority. "},{"type":"codeVoice","code":"waitForResult()"},{"type":"text","text":" only"},{"type":"text","text":" "},{"type":"text","text":"waits for a result and never presents the child. It installs the child’s "},{"type":"codeVoice","code":"onFinish"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"onCancel"},{"type":"text","text":" callbacks before its first suspension, so the child can emit a"},{"type":"text","text":" "},{"type":"text","text":"result at any point after the asynchronous call begins without a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"text","text":"re-entrancy deadlock. Cancelling the caller task that awaits "},{"type":"codeVoice","code":"waitForResult()"},{"type":"text","text":" "},{"type":"text","text":"resolves it with "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", invokes "},{"type":"codeVoice","code":"parentDidCancel()"},{"type":"text","text":", and runs the "},{"type":"codeVoice","code":"defer"},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"clears the app-owned placement state. See"},{"type":"text","text":" "},{"identifier":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"for the design rationale."}]},{"type":"heading","anchor":"Verifying-the-flow-host-lessly","text":"Verifying the flow host-lessly","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":") exercises the full chain"},{"type":"text","text":" "},{"type":"text","text":"in a unit test without mounting any SwiftUI host:"}]},{"type":"codeListing","code":["@Test","@MainActor","func signUpCompletesOnboarding() {","    let store = FlowTestStore<AppRoute>()","","    store.send(.presentSheet(.signup))","    store.receiveModal { if case .presented = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","","    store.send(.dismiss)","    store.receiveModal { if case .dismissed = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","}"],"syntax":"swift skip doc-fragment"},{"type":"heading","anchor":"Next-steps","text":"Next steps","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","isActive":true},{"type":"text","text":" to add analytics and"},{"type":"text","text":" "},{"type":"text","text":"authentication gating to the same flow."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","isActive":true},{"type":"text","text":" to extend the host so a"},{"type":"text","text":" "},{"type":"text","text":"push-notification URL can drop the user directly into "},{"type":"codeVoice","code":".home"},{"type":"text","text":" "},{"type":"text","text":"state on launch."}]}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-loginonboarding"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","type":"topic","title":"InnoRouterTesting","abstract":[],"kind":"symbol","role":"collection","url":"\/documentation\/innoroutertesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-DeepLinkReconciliation":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","type":"topic","title":"Reconciling Deep Links End-to-End","abstract":[{"text":"Match a URL, apply an authentication policy, and produce a","type":"text"},{"type":"text","text":" "},{"code":"NavigationPlan","type":"codeVoice"},{"type":"text","text":" that "},{"type":"codeVoice","code":"NavigationStore.executeBatch"},{"type":"text","text":" applies in one"},{"type":"text","text":" "},{"type":"text","text":"observable step. Queue the deep link while the user is signed out,"},{"type":"text","text":" "},{"type":"text","text":"replay it after sign-in, and surface cancellation reasons through"},{"type":"text","text":" "},{"type":"text","text":"typed outcomes."}],"kind":"article","role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"role":"collectionGroup","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","abstract":[{"text":"Macro-first SwiftUI routing, externally owned stores, modal routing,","type":"text"},{"text":" ","type":"text"},{"text":"coordinators, and typed ","type":"text"},{"code":"EnvironmentRouter","type":"codeVoice"},{"text":" actions for InnoRouter.","type":"text"}],"kind":"article","type":"topic","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MiddlewareComposition":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","type":"topic","title":"Composing Middleware Across Navigation and Modal","abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that pairs completion callbacks with the middlewares"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" hook actually ran."}],"kind":"article","role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition"},"../../../../Docs/design-child-coordinator-handoff.md":{"title":"Docs\/design-child-coordinator-handoff.md","identifier":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","titleInlineContent":[{"type":"codeVoice","code":"Docs\/design-child-coordinator-handoff.md"}],"type":"link","url":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md"}}}