:)","type":"codeVoice"},{"text":" protocol witness follows the enum’s","type":"text"},{"text":" ","type":"text"},{"text":"effective access level. This means a public router can keep the instance hook","type":"text"},{"text":" ","type":"text"},{"text":"private while exposing only the witness required by ","type":"text"},{"code":"DestinationRoute","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import SwiftUI","import InnoRouter","","@Router","public enum PublicRoute {","    case settings","","    private var destination: some View {","        Text(\"Settings\")","    }","}"],"syntax":"swift compile","type":"codeListing"},{"inlineContent":[{"text":"For a ","type":"text"},{"code":"private","type":"codeVoice"},{"text":" enum, the generated witness uses ","type":"text"},{"code":"fileprivate","type":"codeVoice"},{"text":", matching the","type":"text"},{"text":" ","type":"text"},{"text":"case-path macros’ same-file fallback. Do not declare ","type":"text"},{"code":": DestinationRoute","type":"codeVoice"},{"text":" ","type":"text"},{"text":"yourself; ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" supplies the conformance and warns when the direct","type":"text"},{"text":" ","type":"text"},{"text":"conformance is redundant.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Compatibility for pre-OSS snapshots","anchor":"Compatibility-for-pre-OSS-snapshots","type":"heading"},{"inlineContent":[{"text":"Before the 4.0.0 OSS release, internal macro snapshots always emitted","type":"text"},{"text":" ","type":"text"},{"text":"case-path members as ","type":"text"},{"code":"public","type":"codeVoice"},{"text":". Teams that tested those snapshots should check","type":"text"},{"text":" ","type":"text"},{"text":"three patterns:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Enum and CasePath usage already match."}]},{"text":" No 