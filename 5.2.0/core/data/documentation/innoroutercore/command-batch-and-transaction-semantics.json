e"},{"text":" is an attempt log, not a commit log. It records effective","type":"text"},{"text":" ","type":"text"},{"text":"commands passed to the engine, including attempts later discarded by either","type":"text"},{"text":" ","type":"text"},{"text":"savepoint or transaction rollback; middleware interceptions cancelled before","type":"text"},{"text":" ","type":"text"},{"text":"the engine are not included. The savepoint protects ","type":"text"},{"code":"RouteStack","type":"codeVoice"},{"text":" authority, not","type":"text"},{"text":" ","type":"text"},{"text":"arbitrary side effects performed by attempt-level middleware callbacks.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":".whenCancelled","type":"codeVoice"},{"text":" when rollback-to-fallback semantics belong to one logical command.","type":"text"}]},{"level":2,"anchor":"Batch-semantics","text":"Batch semantics","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"NavigationBatchExecutor.executeBatch(_:stopOnFailure:)","type":"codeVoice"},{"text":" is for observation batching.","type":"text"}]},{"inlineContent":[{"text":"Batch execution still runs commands one step at a time, but it lets higher layers coalesce observation:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"step middleware still runs","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"stopOnFailure: false"},{"text":" keeps later commands running after a failure","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"stopOnFailure: true","type":"codeVoice"},{"text":" stops the batch after the first failed step","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"the store emits aggregated ","type":"text"},{"code":".changed","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".batchExecuted","type":"codeVoice"},{"text":" cases","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"events","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"the caller gets a structured ","type":"text"},{"code":"NavigationBatchResult","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Use batch execution when the caller wants one “transition event” while still preserving per-step execution.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Transaction semantics","type":"heading","anchor":"Transaction-semantics"},{"inlineContent":[{"code":"NavigationTransactionExecutor.executeTransaction(_:)","type":"codeVoice"},{"text":" is the atomic option.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Transactions:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"reject an empty command list as uncommitted, with no failure index because no step ran","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"preview commands on a shadow stack","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"abort on the first failure or cancellation","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"leave the real state unchanged on failure","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"commit the final state all at once on success","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"surface public ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" \/ transaction observation only for committed leaves","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"run internal discard cleanup for previewed leaves that never commit","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Use transactions when all-or-nothing semantics are required."