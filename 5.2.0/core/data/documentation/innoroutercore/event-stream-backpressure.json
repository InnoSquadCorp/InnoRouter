{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/event-stream-backpressure"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Event-Stream-Backpressure"},"abstract":[{"text":"How the ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" stream of every store handles slow or stuck subscribers.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Every ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"FlowStore"},{"text":", and ","type":"text"},{"code":"SceneStore","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"publishes an "},{"code":"events: AsyncStream","type":"codeVoice"},{"type":"text","text":" that fans every observation event"},{"type":"text","text":" "},{"type":"text","text":"out to every subscriber. The fan-out is implemented as a per-subscriber"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncStream.Continuation"},{"type":"text","text":", which means a slow or cancelled subscriber"},{"type":"text","text":" "},{"type":"text","text":"that never drains its stream would otherwise retain every event"},{"text":" ","type":"text"},{"text":"indefinitely — behaving as an unbounded leak when the broadcaster","type":"text"},{"text":" ","type":"text"},{"text":"outlives all consumers.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"To bound that growth, every store uses an ","type":"text"},{"code":"EventBufferingPolicy","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" expose the policy through"},{"type":"text","text":" "},{"type":"text","text":"their configurations. "},{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":" currently uses the default policy."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each access to a store’s "},{"code":"events","type":"codeVoice"},{"text":" property creates and synchronously registers","type":"text"},{"text":" ","type":"text"},{"text":"a new subscriber. Capture that stream before starting its lifecycle-owned task;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise a route mutation performed immediately after task creation can occur","type":"text"},{"text":" ","type":"text"},{"text":"before the task first evaluates ","type":"text"},{"code":"store.events","type":"codeVoice"},{"type":"text","text":". Request a fresh stream for each"},{"type":"text","text":" "},{"type":"text","text":"independent consumer."}]},{"type":"heading","level":2,"text":"Default policy","anchor":"Default-policy"},{"inlineContent":[{"type":"text","text":"The default is "},{"type":"codeVoice","code":"EventBufferingPolicy.default"},{"type":"text","text":", which is"},{"type":"text","text":" "},{"type":"codeVoice","code":".bufferingNewest(1024)"},{"type":"text","text":". The number is sized for realistic navigation"},{"type":"text","text":" "},{"type":"text","text":"bursts (a few hundred events for the longest deep-link replay we have"},{"type":"text","text":" "},{"type":"text","text":"measured) while keeping the retained working set bounded so a stuck"},{"type":"text","text":" "},{"type":"text","text":"subscriber cannot balloon memory in production."}],"type":"paragraph"},{"level":2,"anchor":"Choosing-a-policy","text":"Choosing a policy","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Policy","type":"text"}]}],[{"inlineContent":[{"text":"Behaviour","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When to use"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".bufferingNewest(N)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Retain at most ","type":"text"},{"code":"N","type":"codeVoice"},{"text":" most-recently-broadcast events per subscriber, dropping older events when the buffer fills.","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Production code that prefers loss-of-history over memory growth under contention. The default.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".bufferingOldest(N)","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Retain at most "},{"type":"codeVoice","code":"N"},{"text":" oldest-broadcast events per subscriber, dropping newer events when the buffer fills.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Audit pipelines that care about the "},{"type":"emphasis","inlineContent":[{"text":"first","type":"text"}]},{"type":"text","text":" burst more than the latest tail (rare)."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".unbounded"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Buffer every event until the subscriber drains it."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Test harnesses or short-lived subscribers where you control lifetime and require deterministic, lossless ordering."}],"type":"paragraph"}]]],"header":"row","type":"table"},{"level":2,"anchor":"Configuring-supported-stores","text":"Configuring supported stores","type":"heading"},{"inlineContent":[{"type":"text","text":"For Navigation, Modal, and Flow stores, the policy is set at construction"},{"type":"text","text":" "},{"type":"text","text":"time via the store’s configuration:"}],"type":"paragraph"},{"code":["let store = try NavigationStore<HomeRoute>(","    initialPath: [.list],","    configuration: NavigationStoreConfiguration(","        eventBufferingPolicy: .bufferingNewest(2048)","    )",")"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Modal and Flow stores expose the same knob, with one policy per"},{"type":"text","text":" "},{"type":"text","text":"published stream:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"NavigationStoreConfiguration.eventBufferingPolicy","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ModalStoreConfiguration.eventBufferingPolicy","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"FlowStoreConfiguration.eventBufferingPolicy","type":"codeVoice"},{"text":" for the flow-level","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore.events","type":"codeVoice"},{"text":" fan-out","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"FlowStoreConfiguration.navigation.eventBufferingPolicy","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"FlowStoreConfiguration.modal.eventBufferingPolicy","type":"codeVoice"},{"text":" for the wrapped","type":"text"},{"text":" ","type":"text"},{"text":"inner store streams","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":" does not currently expose a buffering configuration. Its events"},{"type":"text","text":" "},{"type":"text","text":"stream always uses "},{"type":"codeVoice","code":"EventBufferingPolicy.default"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Drop semantics under load","type":"heading","anchor":"Drop-semantics-under-load"},{"inlineContent":[{"type":"text","text":"Under sustained backpressure, the store keeps emitting events. Whether"},{"type":"text","text":" "},{"type":"text","text":"the event reaches a slow subscriber depends on the policy chosen for"},{"type":"text","text":" "},{"type":"text","text":"that subscriber’s store:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":".bufferingNewest(N)","type":"codeVoice"},{"text":": oldest events are dropped silently. The","type":"text"},{"text":" ","type":"text"},{"text":"subscriber sees a contiguous tail of the most recent N events the","type":"text"},{"text":" ","type":"text"},{"text":"store emitted.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".bufferingOldest(N)","type":"codeVoice"},{"text":": newer events are dropped silently after the","type":"text"},{"text":" ","type":"text"},{"text":"buffer fills. The subscriber sees the first N events emitted after","type":"text"},{"text":" ","type":"text"},{"text":"it started subscribing.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".unbounded","type":"codeVoice"},{"text":": nothing is dropped, but the per-subscriber queue can","type":"text"},{"text":" ","type":"text"},{"text":"grow without bound while the subscriber falls behind.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Drops are not surfaced as an event. If your analytics pipeline must"},{"type":"text","text":" "},{"type":"text","text":"distinguish “no event happened” from “an event was buffered out”, use"},{"type":"text","text":" "},{"type":"codeVoice","code":".unbounded"},{"type":"text","text":" for that subscriber and rely on your own pacing rather"},{"type":"text","text":" "},{"type":"text","text":"than the broadcaster."}],"type":"paragraph"},{"level":2,"text":"Lifetime contract","type":"heading","anchor":"Lifetime-contract"},{"inlineContent":[{"type":"text","text":"Each subscriber owns one "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":". When the subscriber’s"},{"type":"text","text":" "},{"type":"text","text":"iterator goes out of scope, "},{"type":"codeVoice","code":"AsyncStream.Continuation.onTermination"},{"type":"text","text":" "},{"type":"text","text":"fires and the broadcaster removes that slot from its private"},{"type":"text","text":" "},{"type":"text","text":"continuation storage. When a store releases its broadcaster, that"},{"type":"text","text":" "},{"type":"text","text":"storage deinitializes, snapshots any outstanding continuations, and"},{"type":"text","text":" "},{"type":"text","text":"finishes them outside the broadcaster’s actor-isolated deinitializer."},{"type":"text","text":" "},{"type":"text","text":"Cancelling the consumer task also terminates the subscription. Tie that task to"},{"type":"text","text":" "},{"type":"text","text":"the owning feature or scene; "},{"type":"codeVoice","code":"for await"},{"type":"text","text":" loops additionally terminate naturally"},{"type":"text","text":" "},{"type":"text","text":"when their store is released."}],"type":"paragraph"},{"level":2,"text":"Related","type":"heading","anchor":"Related"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Rejection-Reasons"}]}]}],"type":"unorderedList"}]}],"metadata":{"role":"article","roleHeading":"Article","title":"Event Stream Backpressure","modules":[{"name":"InnoRouterTesting"}]},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Rejection-Reasons":{"kind":"article","url":"\/documentation\/innoroutercore\/rejection-reasons","role":"article","abstract":[{"text":"One-stop reference for every rejection \/ cancellation \/ failure","type":"text"},{"text":" ","type":"text"},{"text":"taxonomy in the InnoRouter stack — when each case fires, where it","type":"text"},{"text":" ","type":"text"},{"text":"originates, and how to handle it.","type":"text"}],"title":"Rejection Reasons catalog","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Rejection-Reasons"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","abstract":[],"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","role":"collection"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Middleware-and-Cancellation":{"kind":"article","url":"\/documentation\/innoroutercore\/middleware-and-cancellation","role":"article","abstract":[{"text":"Middleware is the cross-cutting policy layer for navigation execution.","type":"text"}],"title":"Middleware and cancellation","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"abstract":[{"text":"State, command, result, and execution primitives for InnoRouter.","type":"text"}],"title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","kind":"article","role":"collectionGroup","url":"\/documentation\/innoroutercore\/innoroutercore","type":"topic"}}}