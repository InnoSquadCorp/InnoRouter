":"Source","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Symbol","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Emits through","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"FlowStore.send(_ intent:)","type":"codeVoice"},{"text":" refusal","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"FlowRejectionReason","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"FlowStoreConfiguration.onEvent","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"FlowStore.events","type":"codeVoice"},{"text":" as ","type":"text"},{"code":"FlowEvent.intentRejected","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"FlowStore.apply(_ plan:)","type":"codeVoice"},{"text":" rejection","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"FlowPlanApplyResult.rejected(currentPath:reason:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Synchronous return value with the exact ","type":"text"},{"code":"FlowRejectionReason","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"FlowRejectionReason","text":"`FlowRejectionReason`","type":"heading","level":3},{"rows":[[[{"inlineContent":[{"text":"Case","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When it fires","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Typical handling","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".pushBlockedByModalTail","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":".push(_)","type":"codeVoice"},{"text":" requested while the flow tail is a ","type":"text"},{"code":".sheet","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".cover","type":"codeVoice"},{"text":" step","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Dismiss first, or use ","type":"text"},{"code":".reset(_:)","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".invalidResetPath","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A ","type":"text"},{"code":".reset([_])","type":"codeVoice"},{"text":" path violates FlowStore invariants (e.g. multiple modal steps, or a modal not at the tail)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Fix the path before sending","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".middlewareRejected(debugName:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A navigation or modal middleware cancelled the underlying command, or the navigation engine rejected it during atomic preview. A ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" name can mean an anonymous middleware cancellation or an engine-level refusal; ","type":"text"},{"code":"FlowStore.path","type":"codeVoice"},{"text":" is rolled back","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Observe a named middleware when present; macro-first hosts log the internal rejection origin, otherwise inspect the requested intent and current path","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".reentrantApply","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"FlowStore.apply(_:)","type":"codeVoice"},{"text":" was called synchronously while the store was already delivering a mutation event","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Schedule ","type":"text"},{"code":"send(.reset(_))","type":"codeVoice"},{"text":" from the callback so the mutation is deferred","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"Scene-visionOS","text":"Scene (visionOS)","type":"heading","level":2},{"rows":[[[{"inlineContent":[{"text":"Source","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Symbol","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Emits through","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"SceneStore","type":"codeVoice"},{"text":" intent validation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"SceneRejectionReason","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"SceneEvent.rejected(_:reason:)","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"SceneEvent.hostRegistrationRejected(reason:)","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"SceneRejectionReason","text":"`SceneRejectionReason`","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated "},{"type":"codeVoice","code":"@SceneRouter"},{"type":"text","text":" trees attach cooperative full-authority hosts to every"},{"type":"text","text":" "},{"type":"text","text":"live scene root. If the elected host disappears, a surviving generated host is"},{"type":"text","text":" "},{"type":"text","text":"promoted automatically. The fallback-anchor and duplicate-host recovery steps"},{"type":"text","text":" "},{"type":"text","text":"below are therefore manual "},{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":" composition guidance; do not replace a"},{"type":"text","text":" "},{"type":"text","text":"generated host with a manual host or anchor."}]},{"rows":[[[{"inlineContent":[{"text":"Case","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When it fires","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Typical handling","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".environmentReturnedFailure","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OpenImmersiveSpaceAction.Result","type":"codeVoice"},{"text":" was ","type":"text"},{"code":".userCancelled","type":"codeVoice"},{"text":" or ","type":"text"},{"code":".error","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"User intent; surface a retry affordance if appropriate","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".nothingActive","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"dismissImmersive()","type":"codeVoice"},{"text":" called while the entire scene inventory is empty","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Gate upstream; or ignore as idempotent","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".activeSceneMismatch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"dismissImmersive()","type":"codeVoice"},{"text":" called with no active immersive space while another window or volume remains active","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Inspect ","type":"text"},{"code":"store.activeScenes","type":"codeVoice"},{"text":"; dismiss the intended scene type instead","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".sceneNotDeclared","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Requested route missing from the shared ","type":"text"},{"code":"SceneRegistry","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Add the declaration, or fix the route","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".sceneDeclarationMismatch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Presentation kind \/ size \/ style does not match the registry entry","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Use the registry’s declaration unchanged","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".sceneInstanceNotActive","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"dismissWindow(_:)","type":"codeVoice"},{"text":" received a window or volume presentation UUID that is not active in the inventory","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Keep the exact presentation returned by ","type":"text"},{"code":"openWindow","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"openVolumetric","type":"codeVoice"},{"text":", and avoid stale handles","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".supersededByNewerIntent","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A newer intent replaced the pending one before the host committed it","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Expected during rapid intent bursts; no action","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".fallbackCannotDispatch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Manual composition only: a fallback ","type":"text"},{"code":"innoRouterSceneAnchor","type":"codeVoice"},{"text":" cannot serve a cross-scene open while the elected host is not live","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Re-attach the manual ","type":"text"},{"code":"innoRouterSceneHost","type":"codeVoice"},{"text":", or surface UI asking the user to focus the target scene","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".duplicateHostRegistration","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A cooperative generated host lost election, or a manual second ","type":"text"},{"code":"innoRouterSceneHost","type":"codeVoice"},{"text":" tried to register with the same store","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Generated: no action; a surviving dormant host retries after the elected host disappears. Manual: enforce one host per store","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".hostTornDownDuringDispatch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The dispatcher’s ","type":"text"},{"code":"Task","type":"codeVoice"},{"text":" was cancelled while a claimed intent was mid-flight","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Re-issue the intent once a host is live again","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"Deep-links","text":"Deep links","type":"heading","level":2},{"rows":[[[{"inlineContent":[{"text":"Source","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Symbol","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Emits through","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"DeepLinkPipeline.decide(for:)","type":"codeVoice"},{"text":" URL policy","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeepLinkRejectionReason","type":"codeVoice"},{"text":" (wrapped in ","type":"text"},{"code":"DeepLinkDecision.rejected","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeepLinkEffectHandler.Result.rejected","type":"codeVoice"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"DeepLinkRejectionReason","text":"`DeepLinkRejectionReason`","type":"heading","level":3},{"rows":[[[{"inlineContent":[{"text":"Case","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When it fires","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Typical handling","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".schemeNotAllowed(actualScheme:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"URL scheme not in ","type":"text"},{"code":"allowedSchemes","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Log, drop the URL silently, or surface a diagnostic","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".hostNotAllowed(actualHost:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"URL host not in ","type":"text"},{"code":"allowedHosts","type":"codeVoice"},{"text":", or an allowlisted external URL contains user-info or an explicit port","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Reject the URL; for non-canonical authority components, fix the producer rather than weakening the allowlist","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".inputLimitExceeded(violation)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Raw URL length, path segment count, query item count, or decoded component size exceeds ","type":"text"},{"code":"DeepLinkInputLimits","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Reject the input without retrying; adjust limits only when the app intentionally accepts a larger contract","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"Deep-link-effect-results","text":"Deep-link effect results","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"The typed outcome from "},{"type":"codeVoice","code":"DeepLinkEffectHandler"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"FlowDeepLinkEffectHandler"},{"type":"text","text":":"}]},{"rows":[[[{"inlineContent":[{"text":"Case","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Meaning","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".executed(plan:batch:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Every command in the plan succeeded; per-command results remain available in ","type":"text"},{"code":"batch","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".executionFailed(plan:batch:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Batch execution was attempted, but at least one command failed or was cancelled; inspect ","type":"text"},{"code":"batch.stateAfter","type":"codeVoice"},{"text":" for partial changes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".applicationRejected(plan:failure:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The push-only handler’s preflight rejected the plan before batch execution, so navigation state is unchanged","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".applicationRejected(plan:path:reason:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The flow authority rejected an atomic plan; ","type":"text"},{"code":"path","type":"codeVoice"},{"text":" is its snapshot at the rejection point and ","type":"text"},{"code":"reason","type":"codeVoice"},{"text":" preserves the exact ","type":"text"},{"code":"FlowRejectionReason","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".pending(_)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Authorisation deferred; plan stored as ","type":"text"},{"code":"pendingDeepLink","type":"codeVoice"},{"text":" for later replay","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".rejected(reason:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"URL rejected by scheme, host, canonical-origin, or input-limit policy — see ","type":"text"},{"code":"DeepLinkRejectionReason","type":"codeVoice"},{"text":" above","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".unhandled(url:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"URL did not resolve to any route","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".invalidURL(input:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A string input could not be parsed as a URL","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".missingDeepLinkURL","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"A ","type":"text"},{"code":"DeepLinkEffect","type":"codeVoice"},{"text":" carried no URL","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".noPendingDeepLink","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"resumePendingDeepLink()","type":"codeVoice"},{"text":" called with nothing stored","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"anchor":"How-to-observe-every-rejection-in-one-place","text":"How to observe every rejection in one place","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every store exposes an "},{"type":"codeVoice","code":"events: AsyncStream<Event>"},{"type":"text","text":" where rejection"},{"type":"text","text":" "},{"type":"text","text":"cases arrive alongside successful transitions. A single analytics"},{"type":"text","text":" "},{"type":"text","text":"listener can cover the full surface. Capture each stream before starting its"},{"type":"text","text":" "},{"type":"text","text":"lifecycle-owned task so every subscriber is registered synchronously:"}]},{"code":["let navigationResult = navigationStore.execute(.push(.profile))","if case .cancelled(let reason) = navigationResult {","    analytics.record(\"nav-cancel\", reason: reason)","}","let modalEvents = modalStore.events","let modalObservationTask = Task { @MainActor in","    for await event in modalEvents {","        if case .commandIntercepted(_, .cancelled(let reason)) = event {","            analytics.record(\"modal-cancel\", reason: reason)","        }","    }","}","let flowEvents = flowStore.events","let flowObservationTask = Task { @MainActor in","    for await event in flowEvents {","        if case .intentRejected(_, let reason) = event {","            analytics.record(\"flow-reject\", reason: reason)","        }","    }","}","#if os(visionOS)","let sceneEvents = sceneStore.events","let sceneObservationTask = Task { @MainActor in","    for await event in sceneEvents {","        if case .rejected(let intent, let reason) = event {","            analytics.record(\"scene-reject-\\(intent)\", reason: reason)","        } else if case .hostRegistrationRejected(let reason) = event {","            analytics.record(\"scene-host-reject\", reason: reason)","        }","    }","}","#endif"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Deep-link outcomes surface through "},{"type":"codeVoice","code":"DeepLinkEffectHandler.handle(_:)"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"text","text":"return value rather than a stream, so wrap the call at the"},{"type":"text","text":" "},{"type":"text","text":"scene-phase boundary:"}]},{"code":["let outcome = deepLinkHandler.handle(url)","switch outcome {","case .executed, .pending, .noPendingDeepLink:","    break","case .executionFailed(_, let batch):","    analytics.record(\"deeplink-execution-failed\", results: batch.results)","case .applicationRejected(_, let failure):","    analytics.record(\"deeplink-application-rejected\", result: failure.result)","case .rejected(let reason):","    analytics.record(\"deeplink-reject\", reason: reason)","case .unhandled(let url):","    analytics.record(\"deeplink-unhandled\", url: url)","case .invalidURL(let input):","    analytics.record(\"deeplink-invalid-url\", input: input)","case .missingDeepLinkURL:","    analytics.record(\"deeplink-missing-url\")","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"anchor":"Related","text":"Related","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics"}],"type":"paragraph"}]}]}],"kind":"content"}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"article","title":"Rejection Reasons catalog","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Middleware-and-Cancellation":{"kind":"article","url":"\/documentation\/innoroutercore\/middleware-and-cancellation","role":"article","abstract":[{"text":"Middleware is the cross-cutting policy layer for navigation execution.","type":"text"}],"title":"Middleware and cancellation","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","abstract":[],"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","role":"collection"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"abstract":[{"text":"State, command, result, and execution primitives for InnoRouter.","type":"text"}],"title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","kind":"article","role":"collectionGroup","url":"\/documentation\/innoroutercore\/innoroutercore","type":"topic"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Command-Batch-and-Transaction-Semantics":{"kind":"article","url":"\/documentation\/innoroutercore\/command-batch-and-transaction-semantics","role":"article","abstract":[{"type":"text","text":"InnoRouter exposes three different execution semantics on purpose."}],"title":"Command, batch, and transaction semantics","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics"}}}