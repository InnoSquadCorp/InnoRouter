 "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"type":"codeVoice","code":".strict"},{"type":"text","text":" mode, the store reports events left pending at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"type":"emphasis","inlineContent":[{"text":"unknown test","type":"text"}]},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}]}],"style":"note"}]}],"topicSections":[{"generated":true,"title":"Enumeration Cases","identifiers":["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict"],"anchor":"Enumeration-Cases"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting\/TestExhaustivity","interfaceLanguage":"swift"},"references":{"doc://com.innosquad.innorouter.docs.core/s8SendableP":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting/TestExhaustivity/off":{"type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","url":"\/documentation\/innoroutertesting\/testexhaustivity\/off","title":"TestExhaustivity.off","abstract":[{"text":"The test store still delivers events through ","type":"text"},{"type":"codeVoice","code":"receive(...)"},{"text":", but pending","type":"text"},{"text":" ","type":"text"},{"text":"events at ","type":"text"},{"type":"codeVoice","code":"finish()"},{"text":" or deallocation are silently discarded. Explicit","type":"text"},{"text":" ","type":"text"},{"text":"assertions and events emitted after ","type":"text"},{"type":"codeVoice","code":"finish()"},{"text":" still report issues.","type":"text"},{"text":" ","type":"text"},{"text":"Useful for incremental migrations of large legacy suites.","type":"text"}],"role":"symbol","fragmen