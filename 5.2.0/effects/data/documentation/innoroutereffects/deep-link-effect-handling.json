{"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Coordinator and app-shell owners can inject an already configured"},{"type":"text","text":" "},{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":" with "},{"type":"codeVoice","code":"init(pipeline:navigator:)"},{"type":"text","text":". The handler then becomes"},{"type":"text","text":" "},{"type":"text","text":"the single owner of execution and pending replay; mirror returned results into"},{"type":"text","text":" "},{"type":"text","text":"observable app state only when UI state needs that projection. Live auth and"},{"type":"text","text":" "},{"type":"text","text":"policy state should be read by the pipeline’s closures because the handler"},{"type":"text","text":" "},{"type":"text","text":"retains the pipeline value supplied at initialization."}]},{"type":"paragraph","inlineContent":[{"text":"Important result shapes include:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".executed"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".executionFailed","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".applicationRejected"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".pending","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".rejected","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unhandled"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".invalidURL"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".missingDeepLinkURL"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".noPendingDeepLink","type":"codeVoice"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The handler keeps deep-link execution explicit:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"it does not hide pending replay"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"it does not collapse rejection into generic failure"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"it validates the produced "},{"code":"NavigationPlan","type":"codeVoice"},{"type":"text","text":" before execution and"},{"type":"text","text":" "},{"type":"text","text":"reports "},{"code":".applicationRejected","type":"codeVoice"},{"type":"text","text":" when the current stack cannot apply it"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"its flow counterpart preserves the authority’s exact"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowRejectionReason"},{"type":"text","text":" in "},{"type":"codeVoice","code":".applicationRejected(plan:path:reason:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"it reports "},{"type":"codeVoice","code":".executionFailed"},{"type":"text","text":" with the full batch when middleware or"},{"type":"text","text":" "},{"type":"text","text":"command execution prevents every step from succeeding"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"it keeps batch execution payloads visible to the caller","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"it keeps exactly one pending slot, replacing older deferred links with newer","type":"text"},{"text":" ","type":"text"},{"text":"requests even when their URL and plan values are equal","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"it reinstalls app-owned in-memory handoffs through "},{"type":"codeVoice","code":"restore(pending:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"it lets callers drop the slot explicitly via "},{"type":"codeVoice","code":"clearPendingDeepLink()"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"PendingDeepLink"},{"type":"text","text":" does not define a cross-launch serialization contract. For"},{"type":"text","text":" "},{"type":"text","text":"durable pending links, use "},{"code":"FlowPendingDeepLinkPersistence","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowDeepLinkEffectHandler.restore(pending:)"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"resumePendingDeepLinkIfAllowed"},{"type":"text","text":" when auth state must be checked"},{"type":"text","text":" "},{"type":"text","text":"asynchronously before replaying a stored plan. Its "},{"type":"codeVoice","code":"rethrows"},{"type":"text","text":" contract accepts"},{"type":"text","text":" "},{"type":"text","text":"both nonthrowing authorization checks and token refresh or session probes that"},{"type":"text","text":" "},{"type":"text","text":"can fail before a boolean authorization decision exists."}],"type":"paragraph"},{"inlineContent":[{"text":"Pending replay uses request identity rather than value equality. If a new","type":"text"},{"text":" ","type":"text"},{"text":"equal-valued request arrives while the authorization closure is suspended, the","type":"text"},{"text":" ","type":"text"},{"text":"in-flight call returns that replacement as ","type":"text"},{"type":"codeVoice","code":".pending"},{"text":"; only a later replay may","type":"text"},{"text":" ","type":"text"},{"text":"consume it.","type":"text"}],"type":"paragraph"}]}],"abstract":[{"type":"codeVoice","code":"DeepLinkEffectHandler"},{"type":"text","text":" turns a "},{"type":"codeVoice","code":"DeepLinkDecision"},{"type":"text","text":" into a typed execution result."}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.effects\/documentation\/InnoRou