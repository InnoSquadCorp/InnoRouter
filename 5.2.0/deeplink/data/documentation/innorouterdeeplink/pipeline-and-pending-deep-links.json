{"metadata":{"role":"article","title":"Pipeline and pending deep links","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}]},"kind":"article","sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Pipeline-and-Pending-Deep-Links"},"primaryContentSections":[{"content":[{"type":"heading","text":"Construction","anchor":"Construction","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass a matcher directly so matcher-specific input limits remain typed"},{"type":"text","text":" "},{"text":"rejections and the pipeline can reuse its parsed URL:","type":"text"}]},{"type":"codeListing","code":["let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/products\/:id\") { parameters in","        parameters.firstValue(forName: \"id\").map { .product(id: $0) }","    }","}","","let pipeline = DeepLinkPipeline(","    originPolicy: .allowlisted(","        schemes: [\"myapp\"],","        hosts: [\"app.example.com\"]","    ),","    matcher: matcher",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For routing rules that need the complete raw URL rather than pattern"},{"type":"text","text":" "},{"type":"text","text":"matching, use the explicit escape hatch:"}]},{"type":"codeListing","code":["let pipeline = DeepLinkPipeline<AppRoute>(","    originPolicy: .allowlisted(","        schemes: [\"myapp\"],","        hosts: [\"app.example.com\"]","    ),","    customResolver: { url in legacyRouter.route(for: url) }",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A custom resolver’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" result is "},{"type":"codeVoice","code":".unhandled"},{"type":"text","text":". Pipeline-level input limits"},{"type":"text","text":" "},{"type":"text","text":"still apply, but only the "},{"type":"codeVoice","code":"matcher:"},{"type":"text","text":" path can preserve matcher-specific limit"},{"type":"text","text":" "},{"type":"text","text":"violations."}]},{"type":"heading","text":"Always declare an origin policy","anchor":"Always-declare-an-origin-policy","level":3},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"DeepLinkOriginPolicy.allowlisted(schemes:hosts:)"},{"type":"text","text":" for every pipeline"},{"type":"text","text":" "},{"type":"text","text":"that receives attacker-controllable URLs — custom URL schemes, universal"},{"type":"text","text":" "},{"type":"text","text":"links, notifications, QR or NFC payloads. Choose "},{"type":"codeVoice","code":".trustedInProcess"},{"type":"text","text":" only"},{"type":"text","text":" "},{"type":"text","text":"when every incoming URL is constructed by your own process. The older"},{"type":"text","text":" "},{"type":"text","text":"optional-allowlist initializer remains source-compatible, but an omitted"},{"type":"text","text":" "},{"type":"text","text":"allowlist disables that admission check. The "},{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" macro path enforces"},{"type":"text","text":" "},{"type":"text","text":"an allowlist at compile time ("},{"type":"codeVoice","code":"E020"},{"type":"text","text":")."}]},{"type":"heading","text":"Pipeline stages","anchor":"Pipeline-stages","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A pipeline can:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reject a URL when configured input limits are exceeded"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reject a URL by scheme or host"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"leave it unhandled","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"resolve it into a route"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"require authentication"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"convert the route into a "},{"type":"codeVoice","code":"NavigationPlan"}]}]}]},{"type":"heading","text":"Pending deep links","anchor":"Pending-deep-links","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When authentication is required but not currently satisfied, the pipeline returns "},{"type":"codeVoice","code":"DeepLinkDecision.pending(_:)"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is deliberate:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the route that triggered authentication deferral is preserved"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the navigation plan is preserved"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"replay responsibility remains explicit at the app boundary"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That keeps auth transitions and navigation transitions separate instead of blending them into one hidden side effect."}]},{"type":"heading","text":"Planning","anchor":"Planning","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The planner converts a route into the exact command list that should run after acceptance. This makes deep-link execution deterministic and testable."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Authentication checks the routes referenced by the produced"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":", including nested sequences and fallback commands."},{"type":"text","text":" "},{"type":"text","text":"If a custom planner returns no route-bearing commands, the pipeline"},{"type":"text","text":" "},{"type":"text","text":"falls back to the originally resolved route."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect handlers and coordinator bridges validate a produced"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":" against the current "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" before executing it."},{"type":"text","text":" "},{"type":"text","text":"Plans that are obviously impossible, such as "},{"type":"codeVoice","code":".pop"},{"type":"text","text":" on an empty stack,"},{"type":"text","text":" "},{"type":"text","text":"surface as typed application rejections instead of partially running."}]}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterdeeplink\/pipeline-and-pending-deep-links"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"abstract":[{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":" is where URL acceptance and app policy meet."}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"abstract":[],"role":"collection","type":"topic","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","kind":"symbol"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","title":"InnoRouterDeepLink","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter."}]}}}