{"metadata":{"role":"article","title":"Matcher and diagnostics","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}]},"kind":"article","sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Matcher-and-Diagnostics"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Pattern model","anchor":"Pattern-model","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Patterns support:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"literal segments","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"named parameters such as ","type":"text"},{"code":":id","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"terminal wildcard ","type":"text"},{"code":"*","type":"codeVoice"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"This keeps matching simple and predictable for app routing."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Wildcards are terminal-only. A pattern like "},{"code":"\/api\/*\/users","type":"codeVoice"},{"type":"text","text":" is invalid:"},{"type":"text","text":" "},{"type":"text","text":"it produces a "},{"code":".nonTerminalWildcard(pattern:index:)","type":"codeVoice"},{"type":"text","text":" diagnostic and does"},{"type":"text","text":" "},{"type":"text","text":"not match runtime paths."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Captured values stay available as strings through "},{"code":"firstValue(forName:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"values(forName:)","type":"codeVoice"},{"type":"text","text":". For common scalar types, use the typed overloads:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let id = parameters.firstValue(forName: \"id\", as: UUID.self)","let page = parameters.firstValue(forName: \"page\", as: Int.self)","let selectedTags = parameters.values(forName: \"tag\", as: String.self)"]},{"anchor":"Match-precedence","type":"heading","text":"Match precedence","level":2},{"inlineContent":[{"type":"text","text":"Match precedence remains declaration-order based."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That means:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"earlier patterns win","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"diagnostics do not change runtime behavior","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"ordering is still part of the matcher contract","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Diagnostics","type":"heading","text":"Diagnostics","level":2},{"inlineContent":[{"code":"DeepLinkMatcherConfiguration","type":"codeVoice"},{"type":"text","text":" can surface diagnostics for common authoring mistakes:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"duplicate patterns","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"wildcard shadowing","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"non-terminal wildcards","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"invalid parameter names; parameter names must match","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"^[A-Za-z_][A-Za-z0-9_]*$"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"parameter-heavy patterns that subsume more specific later patterns","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Diagnostics are available for every matcher output. They are intended"},{"type":"text","text":" "},{"type":"text","text":"to catch ambiguous authoring early without changing the matcher’s"},{"type":"text","text":" "},{"type":"text","text":"runtime semantics."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For release-readiness gates, use "},{"code":"DeepLinkMatcher(strict:)","type":"codeVoice"},{"type":"text","text":" with either"},{"type":"text","text":" "},{"type":"text","text":"a route or "},{"code":"FlowPlan<R>","type":"codeVoice"},{"type":"text","text":" output. Strict initializers throw"},{"type":"text","text":" "},{"code":"DeepLinkMatcherStrictError","type":"codeVoice"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"the full diagnostic list instead of only logging warnings, and accept"},{"type":"text","text":" "},{"type":"text","text":"the same "},{"code":"DeepLinkInputLimits","type":"codeVoice"},{"type":"text","text":" guardrails used by non-strict matchers."}],"type":"paragraph"},{"anchor":"Input-limits","type":"heading","text":"Input limits","level":2},{"inlineContent":[{"code":"DeepLinkInputLimits","type":"codeVoice"},{"type":"text","text":" guards runtime URLs before matching. Configure it"},{"type":"text","text":" "},{"type":"text","text":"on "},{"code":"DeepLinkMatcherConfiguration","type":"codeVoice"},{"type":"text","text":", "},{"code":"DeepLinkPipeline","type":"codeVoice"},{"type":"text","text":", or"},{"type":"text","text":" "},{"code":"FlowDeepLinkPipeline","type":"codeVoice"},{"type":"text","text":" to cap absolute URL length, path segment count,"},{"type":"text","text":" "},{"type":"text","text":"and query item count. Direct matcher calls still return "},{"code":"nil","type":"codeVoice"},{"type":"text","text":" because"},{"type":"text","text":" "},{"type":"text","text":"their public contract is optional. Pipeline and effect-handler paths"},{"type":"text","text":" "},{"type":"text","text":"surface limit violations as typed"},{"type":"text","text":" "},{"code":"DeepLinkRejectionReason.inputLimitExceeded","type":"codeVoice"},{"type":"text","text":" rejections instead of"},{"type":"text","text":" "},{"type":"text","text":"“no match” outcomes when the pipeline receives the matcher through its"},{"type":"text","text":" "},{"code":"matcher:","type":"codeVoice"},{"type":"text","text":" initializer. The "},{"code":"customResolver:","type":"codeVoice"},{"type":"text","text":" escape hatch can surface only"},{"type":"text","text":" "},{"type":"text","text":"the pipeline’s own limits because an optional resolver result does not carry"},{"type":"text","text":" "},{"type":"text","text":"matcher-specific rejection information."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterdeeplink\/matcher-and-diagnostics"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"abstract":[{"type":"codeVoice","code":"DeepLinkMatcher"},{"type":"text","text":" is the URL-pattern front door for route and "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" deep-link outputs."}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"abstract":[],"role":"collection","type":"topic","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","kind":"symbol"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","title":"InnoRouterDeepLink","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handling