{"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Tutorial-FlowDeepLinkPipeline"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Article","role":"article","title":"Rehydrating Composite Flows from a URL","modules":[{"name":"InnoRouterTesting"}]},"primaryContentSections":[{"content":[{"anchor":"Scenario","type":"heading","text":"Scenario","level":2},{"inlineContent":[{"type":"codeVoice","code":"myapp:\/\/app\/home\/detail\/42"},{"text":" should land the user on the order detail","type":"text"},{"text":" ","type":"text"},{"text":"for order 42. ","type":"text"},{"type":"codeVoice","code":"myapp:\/\/app\/onboarding\/privacy"},{"text":" should open a privacy","type":"text"},{"text":" ","type":"text"},{"text":"sheet over the current screen. Authenticated routes like","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"myapp:\/\/app\/secure"},{"text":" defer until sign-in completes, then replay.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Push-only pipelines (","type":"text"},{"type":"codeVoice","code":"DeepLinkPipeline"},{"text":" → ","type":"text"},{"type":"codeVoice","code":"NavigationPlan<R>"},{"text":") can’t","type":"text"},{"text":" ","type":"text"},{"text":"express a URL that terminates on a modal. ","type":"text"},{"type":"codeVoice","code":"FlowDeepLinkPipeline"},{"text":" ","type":"text"},{"text":"solves that by emitting ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":" — a single value holding both","type":"text"},{"text":" ","type":"text"},{"text":"the navigation prefix and the tail sheet\/cover.","type":"text"}],"type":"paragraph"},{"anchor":"Routes","type":"heading","text":"Routes","level":2},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["enum AppRoute: Route {","    case home","    case detail(id: String)","    case comments(id: String)","    case privacyPolicy","    case secure","}"]},{"anchor":"Defining-the-matcher","type":"heading","text":"Defining the matcher","level":2},{"inlineContent":[{"type":"codeVoice","code":"DeepLinkMapping"},{"text":" handlers return a ","type":"text"},{"inlineContent":[{"text":"complete","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":" so","type":"text"},{"text":" ","type":"text"},{"text":"multi-segment URLs expand atomically. The shared pattern syntax uses","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":":parameter"},{"text":" for captures, terminal ","type":"text"},{"type":"codeVoice","code":"*"},{"text":" wildcard,","type":"text"},{"text":" ","type":"text"},{"text":"path-only (host and scheme are filtered separately by the pipeline).","type":"text"},{"text":" ","type":"text"},{"text":"Non-terminal wildcards such as ","type":"text"},{"type":"codeVoice","code":"\/store\/*\/receipt"},{"text":" are invalid and","type":"text"},{"text":" ","type":"text"},{"text":"surface diagnostics instead of matching.","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let matcher = DeepLinkMatcher<FlowPlan<AppRoute>> {","    DeepLinkMapping(\"\/home\") { _ in","        FlowPlan(steps: [.push(.home)])","    }","    DeepLinkMapping(\"\/home\/detail\/:id\") { params in","        guard let id = params.firstValue(forName: \"id\") else { return nil }","        return FlowPlan(steps: [.push(.home), .push(.detail(id: id))])","    }","    DeepLinkMapping(\"\/home\/detail\/:id\/comments\/:cid\") { params in","        guard let id = params.firstValue(forName: \"id\"),","              let cid = params.firstValue(forName: \"cid\") else { return nil }","        return FlowPlan(steps: [","            .push(.home),","            .push(.detail(id: id)),","            .push(.comments(id: cid))","        ])","    }","    DeepLinkMapping(\"\/onboarding\/privacy\") { _ in","        FlowPlan(steps: [.sheet(.privacyPolicy)])","    }","    DeepLinkMapping(\"\/secure\") { _ in","        FlowPlan(steps: [.push(.secure)])","    }","}"]},{"anchor":"Wiring-the-pipeline","type":"heading","text":"Wiring the pipeline","level":2},{"inlineContent":[{"type":"codeVoice","code":"FlowDeepLinkPipeline"},{"text":" composes scheme\/host validation,","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DeepLinkAuthenticationPolicy"},{"text":" (reused from the push-only surface),","type":"text"},{"text":" ","type":"text"},{"text":"and the matcher:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let pipeline = FlowDeepLinkPipeline<AppRoute>(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    matcher: matcher,","    authenticationPolicy: .required(","        shouldRequireAuthentication: { route in","            if case .secure = route { return true }","            return false","        },","        isAuthenticated: { SessionStore.shared.isAuthenticated }","    )",")"]},{"inlineContent":[{"text":"For unguarded apps pass ","type":"text"},{"type":"codeVoice","code":".notRequired"},{"text":" (the default) and skip the","type":"text"},{"text":" ","type":"text"},{"text":"policy closure entirely.","type":"text"}],"type":"paragraph"},{"anchor":"Applying-through-FlowStore","type":"heading","text":"Applying through FlowStore","level":2},{"inlineContent":[{"type":"codeVoice","code":"FlowDeepLinkEffectHandler"},{"text":" bridges the pipeline output into any","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowPlanApplier"},{"text":". It also owns the pending slot, so keep the handler","type":"text"},{"text":" ","type":"text"},{"text":"in a stable owner rather than rebuilding it inside a SwiftUI body.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":" already conforms:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["import Foundation","import SwiftUI","import InnoRouter","import InnoRouterEffects","","private final class SessionStore {","    static let shared = SessionStore()","","    private let lock = NSLock()","    private var signedIn = false","","    var isAuthenticated: Bool {","        lock.withLock { signedIn }","    }","","    func markAuthenticated() {","        lock.withLock { signedIn = true }","    }","}","","@MainActor","private final class DeepLinkCoordinator {","    let flow: FlowStore<AppRoute>","    let handler: FlowDeepLinkEffectHandler<AppRoute>","    private let session: SessionStore","","    init(session: SessionStore = .shared) {","        self.session = session","        let flow = FlowStore<AppRoute>()","        self.flow = flow","","        let matcher = DeepLinkMatcher<FlowPlan<AppRoute>> {","            DeepLinkMapping(\"\/home\") { _ in","                FlowPlan(steps: [.push(.home)])","            }","            DeepLinkMapping(\"\/onboarding\/privacy\") { _ in","                FlowPlan(steps: [.sheet(.privacyPolicy)])","            }","            DeepLinkMapping(\"\/secure\") { _ in","                FlowPlan(steps: [.push(.secure)])","            }","        }","        let pipeline = FlowDeepLinkPipeline(","            originPolicy: .allowlisted(","                schemes: [\"myapp\"],","                hosts: [\"app\"]","            ),","            matcher: matcher,","            authenticationPolicy: .required(","                shouldRequireAuthentication: { route in","                    if case .secure = route { return true }","                    return false","                },","                isAuthenticated: { session.isAuthenticated }","            )","        )","        self.handler = FlowDeepLinkEffectHandler(","            pipeline: pipeline,","            applier: flow","        )","    }","","    func userDidSignIn() {","        session.markAuthenticated()","        _ = handler.resumePendingDeepLink()","    }","}","","@main","struct DemoApp: App {","    @State private var coordinator = DeepLinkCoordinator()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: coordinator.flow,","                destination: { route in","                    switch route {","                    case .home:","                        Text(\"Home\")","                    case .detail(let id):","                        Text(\"Detail \\(id)\")","                    case .comments(let id):","                        Text(\"Comments \\(id)\")","                    case .privacyPolicy:","                        Text(\"Privacy\")","                    case .secure:","                        Text(\"Secure\")","                    }","                },","                root: { Text(\"Root\") }","            )","            .onOpenURL { url in","                _ = coordinator.handler.handle(url)","            }","        }","    }","}"]},{"inlineContent":[{"text":"A single ","type":"text"},{"type":"codeVoice","code":"handler.handle(url)"},{"text":" call:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Runs scheme\/host validation."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Walks the matcher for a "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Runs the authentication policy across the plan until it finds the"},{"type":"text","text":" "},{"type":"text","text":"first protected route."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Either applies the plan through "},{"type":"codeVoice","code":"flow.apply(_:)"},{"type":"text","text":" or stores it as"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"FlowPendingDeepLink"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"anchor":"Replaying-after-sign-in","type":"heading","text":"Replaying after sign-in","level":2},{"inlineContent":[{"text":"Once the user signs in, resume the pending deep link:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["func userDidSignIn() {","    coordinator.userDidSignIn()","}"]},{"inlineContent":[{"text":"The handler re-consults the authentication policy (now returning","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"true"},{"text":"), drops the pending reference, and applies the plan atomically.","type":"text"},{"text":" ","type":"text"},{"text":"For an async gate (e.g. token refresh), use:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["await coordinator.handler.resumePendingDeepLinkIfAllowed { pending in","    \/\/ Return true once the refresh has produced a live session.","    await AuthService.shared.refreshTokenIfNeeded()","}"]},{"inlineContent":[{"text":"The handler keeps a single pending slot:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a newly deferred URL replaces the older pending link"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"clearPendingDeepLink()"},{"type":"text","text":" drops the slot explicitly"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"stale pending links (ones the user replaced by opening a different"},{"type":"text","text":" "},{"type":"text","text":"URL) are therefore dropped automatically"}]}]}],"type":"unorderedList"},{"anchor":"Observing-the-chain","type":"heading","text":"Observing the chain","level":2},{"inlineContent":[{"text":"All three authorities surface on ","type":"text"},{"type":"codeVoice","code":"FlowStore.events"},{"text":" as one","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":". A single subscriber sees the batch execution on the","type":"text"},{"text":" ","type":"text"},{"text":"navigation store, the modal presentation (if any), and the","type":"text"},{"text":" ","type":"text"},{"text":"settled FlowStore-level event as one chain. ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":" wraps inner","type":"text"},{"text":" ","type":"text"},{"text":"navigation \/ modal events synchronously before emitting the","type":"text"},{"text":" ","type":"text"},{"text":"flow-level event, so one subscriber can assert the same ordering that","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"text":" observes. Capture the stream before starting","type":"text"},{"text":" ","type":"text"},{"text":"its lifecycle-owned task so the subscriber exists before applying the link.","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let events = flow.events","let observationTask = Task { @MainActor in","    for await event in events {","        switch event {","        case .navigation(.batchExecuted(let result)):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .modal(.presented(let presentation)):","            analytics.track(\"deep_link_opened_modal\", [","                \"route\": String(describing: presentation.route)","            ])","        case .pathChanged(_, let new):","            analytics.track(\"flow_path\", [","                \"steps\": new.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"]},{"anchor":"Host-less-testing","type":"heading","text":"Host-less testing","level":2},{"inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"text":" wraps the same ","type":"text"},{"type":"codeVoice","code":"flowStore.apply"},{"text":" path:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@Test","@MainActor","func multiSegmentURLRehydrates() {","    let store = FlowTestStore<AppRoute>()","    let handler = FlowDeepLinkEffectHandler(pipeline: pipeline, applier: store.store)","","    _ = handler.handle(URL(string: \"myapp:\/\/app\/home\/detail\/42\")!)","","    store.receiveNavigation { event in","        if case .batchExecuted = event { return true }","        return false","    }","    store.receivePathChanged { _, new in","        new == [.push(.home), .push(.detail(id: \"42\"))]","    }","}"]},{"anchor":"Next-steps","type":"heading","text":"Next steps","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"See the push-only "},{"type":"codeVoice","code":"Tutorial-DeepLinkReconciliation"},{"type":"text","text":" "},{"type":"text","text":"walk-through in the "},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":" catalog for apps that"},{"type":"text","text":" "},{"type":"text","text":"don’t yet need modal-terminal URLs."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read the "},{"type":"codeVoice","code":"Tutorial-LoginOnboarding"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":" documentation catalog to see how the"},{"type":"text","text":" "},{"type":"text","text":"authenticated-replay loop fits a greenfield flow that uses"},{"type":"text","text":" "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" for a sign-up sheet."}]}]}],"type":"unorderedList"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterdeeplink\/tutorial-flowdeeplinkpipeline"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"abstract":[{"type":"text","text":"Map a URL to a "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" with push prefix and optional modal"},{"type":"text","text":" "},{"type":"text","text":"terminal step, run it through authentication gating, and replay the"},{"type":"text","text":" "},{"type":"text","text":"deferred link through "},{"type":"codeVoice","code":"FlowDeepLinkEffectHandler"},{"type":"text","text":" — all in one"},{"type":"text","text":" "},{"type":"text","text":"atomic "},{"type":"codeVoice","code":"FlowStore.apply(_:)"},{"type":"text","text":"."}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","title":"InnoRouterDeepLink","role":"collectionGroup","type":"topic","abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter."}]},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"abstract":[],"role":"collection","type":"topic","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","kind":"symbol"}}}