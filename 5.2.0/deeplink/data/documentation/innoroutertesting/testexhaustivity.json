{"kind":"symbol","identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"metadata":{"remoteSource":{"url":"https:\/\/github.com\/InnoSquadCorp\/InnoRouter\/blob\/5.2.0\/Sources\/InnoRouterTesting\/TestExhaustivity.swift#L25","fileName":"TestExhaustivity.swift"},"roleHeading":"Enumeration","modules":[{"name":"InnoRouterTesting"}],"title":"TestExhaustivity","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}],"role":"symbol","externalID":"s:17InnoRouterTesting16TestExhaustivityO","navigatorTitle":[{"kind":"identifier","text":"TestExhaustivity"}],"symbolKind":"enum"},"topicSections":[{"generated":true,"title":"Enumeration Cases","identifiers":["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict"],"anchor":"Enumeration-Cases"},{"generated":true,"title":"Default Implementations","identifiers":["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations"],"anchor":"Default-Implementations"}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/com.innosquad.innorouter.docs.deeplink\/SQ","doc:\/\/com.innosquad.innorouter.docs.deeplink\/SH","doc:\/\/com.innosquad.innorouter.docs.deeplink\/s8SendableP","doc:\/\/com.innosquad.innorouter.docs.deeplink\/s16SendableMetatypeP"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}],"platforms":["macOS"],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"anchor":"overview","type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"type":"codeVoice","code":"TestStore"},{"type":"text","text":" exhaustivity model:"},{"type":"text","text":" "},{"type":"text","text":"events collected from the underlying authority’s unified "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"type":"codeVoice","code":".strict"},{"type":"text","text":" mode, the store reports events left pending at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}],"type":"paragraph"},{"type":"aside","name":"Note","content":[{"inlineContent":[{"text":"Swift Testing currently attributes issues recorded inside an","type":"text"},{"text":" ","type":"text"},{"text":"isolated ","type":"text"},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"unknown test"}]},{"text":" rather than to the test that","type":"text"},{"text":" ","type":"text"},{"text":"owned the store, which makes a deinit-time leftover-event failure","type":"text"},{"text":" ","type":"text"},{"text":"hard to locate. Until that is resolved upstream, await all work and end","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}],"type":"paragraph"}],"style":"note"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutertesting\/testexhaustivity"]}],"abstract":[{"text":"Controls how strictly a test store checks pending events when observation","type":"text"},{"text":" ","type":"text"},{"text":"finishes.","type":"text"}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting/TestExhaustivity/Equatable-Implementations":{"abstract":[],"kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations","title":"Equatable Implementations","role":"collectionGroup","type":"topic","url":"\/documentation\/innoroutertesting\/testexhaustivity\/equatable-implementations"},"doc://com.innosquad.innorouter.docs.deeplink/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/s16SendableMetatypeP"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting/TestExhaustivity/off":{"url":"\/documentation\/innoroutertesting\/testexhaustivity\/off","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","title":"TestExhaustivity.off","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"off"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"The test store still delivers events through "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":", but pending"},{"type":"text","text":" "},{"type":"text","text":"events at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation are silently discarded. Explicit"},{"type":"text","text":" "},{"type":"text","text":"assertions and events emitted after "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" still report issues."},{"type":"text","text":" "},{"type":"text","text":"Useful for incremental migrations of large legacy suites."}]},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting/TestExhaustivity":{"abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"text":" ","type":"text"},{"type":"text","text":"finishes."}],"kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity","title":"TestExhaustivity","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}],"role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"TestExhaustivity"}],"url":"\/documentation\/innoroutertesting\/testexhaustivity"},"doc://com.innosquad.innorouter.docs.deeplink/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/s8SendableP"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"abstract":[],"role":"collection","type":"topic","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","kind":"symbol"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting/TestExhaustivity/strict":{"url":"\/documentation\/innoroutertesting\/testexhaustivity\/strict","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict","title":"TestExhaustivity.strict","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"strict"}],"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Every observed event must be drained through "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation. Pending events fail the test. This is the"},{"type":"text","text":" "},{"type":"text","text":"default and matches TCA’s "},{"type":"codeVoice","code":"exhaustive"},{"type":"text","text":" semantics."}]},"doc://com.innosquad.innorouter.docs.deeplink/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/SH"},"doc://com.innosquad.innorouter.docs.deeplink/SQ":{"type":"unresolvable","title":"Swift.Equatable","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/SQ"}}}