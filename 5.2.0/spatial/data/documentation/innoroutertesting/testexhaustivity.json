{"abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"type":"text","text":" "},{"type":"text","text":"finishes."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting"]]},"sections":[],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting\/TestExhaustivity","interfaceLanguage":"swift"},"topicSections":[{"generated":true,"identifiers":["doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict"],"title":"Enumeration Cases","anchor":"Enumeration-Cases"},{"generated":true,"identifiers":["doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations"}],"kind":"symbol","metadata":{"navigatorTitle":[{"kind":"identifier","text":"TestExhaustivity"}],"roleHeading":"Enumeration","modules":[{"name":"InnoRouterTesting"}],"title":"TestExhaustivity","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TestExhaustivity","kind":"identifier"}],"externalID":"s:17InnoRouterTesting16TestExhaustivityO","symbolKind":"enum","remoteSource":{"fileName":"TestExhaustivity.swift","url":"https:\/\/github.com\/InnoSquadCorp\/InnoRouter\/blob\/5.2.0\/Sources\/InnoRouterTesting\/TestExhaustivity.swift#L25"},"role":"symbol"},"relationshipsSections":[{"kind":"relationships","type":"conformsTo","identifiers":["doc:\/\/com.innosquad.innorouter.docs.spatial\/SQ","doc:\/\/com.innosquad.innorouter.docs.spatial\/SH","doc:\/\/com.innosquad.innorouter.docs.spatial\/s8SendableP","doc:\/\/com.innosquad.innorouter.docs.spatial\/s16SendableMetatypeP"],"title":"Conforms To"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TestExhaustivity","kind":"identifier"}]}]},{"kind":"content","content":[{"type":"heading","anchor":"overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"type":"codeVoice","code":"TestStore"},{"type":"text","text":" exhaustivity model:"},{"type":"text","text":" "},{"type":"text","text":"events collected from the underlying authority’s unified "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"type":"codeVoice","code":".strict"},{"type":"text","text":" mode, the store reports events left pending at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"type":"emphasis","inlineContent":[{"text":"unknown test","type":"text"}]},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}]}],"style":"note","name":"Note"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutertesting\/testexhaustivity"]}],"references":{"doc://com.innosquad.innorouter.docs.spatial/documentation/InnoRouterTesting/TestExhaustivity/off":{"abstract":[{"type":"text","text":"The test store still delivers events through "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":", but pending"},{"type":"text","text":" "},{"type":"text","text":"events at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation are silently discarded. Explicit"},{"type":"text","text":" "},{"type":"text","text":"assertions and events emitted after "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" still report issues."},{"type":"text","text":" "},{"type":"text","text":"Useful for incremental migrations of large legacy suites."}],"type":"topic","url":"\/documentation\/innoroutertesting\/testexhaustivity\/off","title":"TestExhaustivity.off","identifier":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"off"}],"kind":"symbol","role":"symbol"},"doc://com.innosquad.innorouter.docs.spa