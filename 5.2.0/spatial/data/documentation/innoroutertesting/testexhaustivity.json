nnosquad.innorouter.docs.spatial/documentation/InnoRouterTesting/TestExhaustivity/strict":{"fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"strict","kind":"identifier"}],"abstract":[{"type":"text","text":"Every observed event must be drained through "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation. Pending events fail the test. This is the"},{"type":"text","text":" "},{"type":"text","text":"default and matches TCA’s "},{"type":"codeVoice","code":"exhaustive"},{"type":"text","text":" semantics."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict","kind":"symbol","role":"symbol","url":"\/documentation\/innoroutertesting\/testexhaustivity\/strict","title":"TestExhaustivity.strict","type":"topic"},"doc://com.innosquad.innorouter.docs.spatial/SQ":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.spatial\/SQ","type":"unresolvable","title":"Swift.Equatable"}}}