enum AppRoute: Route {","    case welcome, preAuth, signup","}","","@Test","@MainActor","func pushingPreAuthEmitsNavigationAndPathChange() {","    let store = FlowTestStore<AppRoute>()","","    store.send(.push(.preAuth))","","    store.receiveNavigation { event in","        if case .changed(_, let to) = event { return to.path == [.preAuth] }","        return false","    }","    store.receivePathChanged { old, new in","        old.isEmpty && new == [.push(.preAuth)]","    }","    store.finish()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"text":" owns a real ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":" and subscribes to every","type":"text"},{"text":" ","type":"text"},{"text":"observation surface it exposes (flow, inner navigation, inner","type":"text"},{"text":" ","type":"text"},{"text":"modal). Events land in one FIFO queue; ","type":"text"},{"type":"codeVoice","code":"receive*"},{"text":" helpers dequeue","type":"text"},{"text":" ","type":"text"},{"text":"them in the order the production stores emit.","type":"text"}]},{"text":"Modal + cancellation","type":"heading","level":2,"anchor":"Modal-+-cancellation"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"text":" surfaces cancellations as first-class events, so","type":"text"},{"text":" ","type":"text"},{"text":"tests can assert them precisely:","type":"text"}]},{"code":["@MainActor","private func blockSheetMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(willExecute: { command, _, _ in","        if case .present(let p) = command, p.style == .sheet {","            return .cancel(.middleware(debugName: nil, command: command))","        }","        return .proceed(command)","    })","}","","@Test","@MainActor","func sheetBlockingMiddlewareCancelsTheIntent() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            modal: .init(","                middlewares: [.init(middleware: blockSheetMiddleware(), debugName: \"BlockSheet\")]","            )","        )","    )","","    store.send(.presentSheet(.signup))","","    \/\/ The preview path never commits — only .intentRejected fires.","    store.receiveIntentRejected(","        intent: .presentSheet(.signup),","        reason: .middlewareRejected(debugName: \"BlockSheet\")","    )","    #expect(store.path.isEmpty)","    store.finish()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"text":"Skipping and draining","type":"heading","level":2,"anchor":"Skipping-and-draining"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"skipReceivedEvents()"},{"text":" discards everything currently queued","type":"text"},{"text":" ","type":"text"},{"text":"without asserting, which is useful when a test only cares about","type":"text"},{"text":" ","type":"text"},{"text":"events ","type":"text"},{"inlineContent":[{"text":"after","type":"text"}],"type":"emphasis"},{"text":" a setup mutation:","type":"text"}]},{"code":["store.send(.presentSheet(.signup)) \/\/ enqueues .modal + .pathChanged","store.skipReceivedEvents()         \/\/ we don't care about setup","","store.send(.push(.preAuth))","store.receiveIntentRejected(intent: .push(.preAuth), reason: .pushBlockedByModalTail)"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"text":"Exhaustivity","type":"heading","level":2,"anchor":"Exhaustivity"},{"type":"paragraph","inlineContent":[{"text":"Default is ","type":"text"},{"type":"codeVoice","code":"TestExhaustivity.strict"},{"text":" — any unasserted event at","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"finish()"},{"text":" (or at deinit of the test store) triggers a Swift","type":"text"},{"text":" ","type":"text"},{"text":"Testing ","type":"text"},{"type":"codeVoice","code":"Issue.record"},{"text":". This catches the common mistake of","type":"text"},{"text":" ","type":"text"},{"text":"“missed that the modal also fired a ","type":"text"},{"type":"codeVoice","code":".presented"},{"text":" after the","type":"text"},{"text":" ","type":"text"},{"text":"intended intent.”","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Opt out selectively:","type":"text"}]},{"code":["let store = FlowTestStore<AppRoute>(exhaustivity: .off)"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".off"},{"text":" preserves per-call assertions; only the end-of-life drain","type":"text"},{"text":" ","type":"text"},{"text":"check is silenced. Useful when migrating a legacy test in stages.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"text":" between test phases when you need a","type":"text"},{"text":" ","type":"text"},{"text":"non-terminal checkpoint. It reports and consumes the current pending","type":"text"},{"text":" ","type":"text"},{"text":"snapshot, but later operations continue to enqueue. After awaiting all","type":"text"},{"text":" ","type":"text"},{"text":"work, call ","type":"text"},{"type":"codeVoice","code":"finish()"},{"text":" once: it closes observation, and the first event","type":"text"},{"text":" ","type":"text"},{"text":"emitted past that boundary is an issue in either exhaustivity mode.","type":"text"}]},{"text":"Direct state inspection","type":"heading","level":2,"anchor":"Direct-state-inspection"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"text":" exposes the projected ","type":"text"},{"type":"codeVoice","code":"path"},{"text":" for occasional direct","type":"text"},{"text":" ","type":"text"},{"text":"assertions:","type":"text"}]},{"code":["#expect(store.path == [.push(.preAuth)])"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Prefer ","type":"text"},{"type":"codeVoice","code":"receive*"},{"text":" for production assertions — they cover both","type":"text"},{"text":" ","type":"text"},{"text":"state and the emission order — but escape hatches are useful for","type":"text"},{"text":" ","type":"text"},{"text":"sanity checks. The inner ","type":"text"},{"type":"codeVoice","code":"NavigationStore"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"ModalStore"},{"text":" behind a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":" are SPI in 4.0; use public flow events and ","type":"text"},{"type":"codeVoice","code":"path"},{"text":" unless","type":"text"},{"text":" ","type":"text"},{"text":"you are writing focused package-internal invariant tests.","type":"text"}]},{"text":"Testing middleware behaviour directly","type":"heading","level":2,"anchor":"Testing-middleware-behaviour-directly"},{"type":"paragraph","inlineContent":[{"text":"The modal-blocking example above tests middleware ","type":"text"},{"inlineContent":[{"text":"through","type":"text"}],"type":"emphasis"},{"text":" a flow","type":"text"},{"text":" ","type":"text"},{"text":"store. Sometimes you want to test the middleware itself — does it","type":"text"},{"text":" ","type":"text"},{"text":"correctly pass through, cancel, or rewrite commands for every input","type":"text"},{"text":" ","type":"text"},{"text":"shape? ","type":"text"},{"type":"codeVoice","code":"NavigationTestStore"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"ModalTestStore"},{"text":" let you do that","type":"text"},{"text":" ","type":"text"},{"text":"without a FlowStore in the middle.","type":"text"}]},{"code":["@MainActor","private final class RecordingMiddleware: NavigationMiddleware {","    typealias RouteType = AppRoute","","    private(set) var seenCommands: [NavigationCommand<AppRoute>] = []","","    func willExecute(","        _ command: NavigationCommand<AppRoute>,","        state: RouteStack<AppRoute>","    ) -> NavigationInterception<AppRoute> {","        seenCommands.append(command)","        if case .push(let route) = command, route == .signup {","            return .cancel(.middleware(debugName: \"BlockSignup\", command: command))","        }","        return .proceed(command)","    }","","    func didExecute(","        _ command: NavigationCommand<AppRoute>,","        result: NavigationResult<AppRoute>,","        state: RouteStack<AppRoute>","    ) -> NavigationResult<AppRoute> {","        result","    }","}","","@Test","@MainActor","func middlewareCancelsSignupButNotWelcome() {","    let middleware = RecordingMiddleware()","    let store = NavigationTestStore<AppRoute>(","        configuration: .init(","            middlewares: [.init(middleware: middleware, debugName: \"Recorder\")]","        )","    )","","    store.send(.push(.welcome))","    store.receiveChange { _, to in to.path == [.welcome] }","","    store.send(.push(.signup))","    store.receiveIntercepted(reason: .middleware(debugName: \"BlockSignup\", command: .push(.signup)))","","    #expect(middleware.seenCommands.count == 2)","    store.finish()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Recording middlewares work naturally with ","type":"text"},{"type":"codeVoice","code":"@MainActor final class"},{"text":" ","type":"text"},{"text":"and mutable state. Pair them with ","type":"text"},{"type":"codeVoice","code":"receiveIntercepted"},{"text":" to assert","type":"text"},{"text":" ","type":"text"},{"text":"which interceptions fired and in what order, and with direct","type":"text"},{"text":" ","type":"text"},{"text":"reads on the middleware instance to assert which commands it saw.","type":"text"}]},{"text":"Property-based test recipes","type":"heading","level":2,"anchor":"Property-based-test-recipes"},{"type":"paragraph","inlineContent":[{"text":"InnoRouter’s own property-based suites use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Tests\/InnoRouterTests\/PropertyTestSupport.swift"},{"text":". That helper lives","type":"text"},{"text":" ","type":"text"},{"text":"in this repository’s test target, not in the shipped","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"InnoRouterTesting"},{"text":" product, so downstream apps should copy or adapt","type":"text"},{"text":" ","type":"text"},{"text":"the pattern rather than expect ","type":"text"},{"type":"codeVoice","code":"@testable import InnoRouterTesting"},{"text":" ","type":"text"},{"text":"to expose ","type":"text"},{"type":"codeVoice","code":"SeededGenerator"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Arbitrary"},{"text":", or ","type":"text"},{"type":"codeVoice","code":"FlowModelState"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The idiom is ","type":"text"},{"inlineContent":[{"text":"Swift Testing ","type":"text"},{"code":"@Test(arguments:)","type":"codeVoice"},{"text":" iterated over many","type":"text"},{"text":" ","type":"text"},{"text":"seeds","type":"text"}],"type":"strong"},{"text":", each seed driving a deterministic random intent stream:","type":"text"}]},{"code":["@Test(arguments: 0..<100)","@MainActor","func randomFlowIntentsPreserveInvariants(seed: UInt64) async {","    var rng = SeededGenerator(seed: seed)","    let store = FlowTestStore<AppRoute>(exhaustivity: .off)","","    for _ in 0..<30 {","        let intent = Arbitrary.flowIntent(","            rng: &rng,","            routes: [.welcome, .preAuth, .signup]","        )","        store.send(intent)","    }","","    \/\/ Invariant: modal-tail is always the final step, never in the middle.","    let modalIndices = store.path.indices.filter { store.path[$0].isModal }","    #expect(modalIndices.allSatisfy { $0 == store.path.count - 1 })","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Swift Testing runs the 100 parameterised cases in parallel by","type":"text"},{"text":" ","type":"text"},{"text":"default, so total wall-clock time stays close to a single iteration.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A pairs-with pattern: ","type":"text"},{"inlineContent":[{"text":"run the random stream through both the","type":"text"},{"text":" ","type":"text"},{"text":"real store and a reference model","type":"text"}],"type":"strong"},{"text":", then assert they agree step by","type":"text"},{"text":" ","type":"text"},{"text":"step. That’s how ","type":"text"},{"type":"codeVoice","code":"FlowStorePropertyBasedTests"},{"text":" catches subtle","type":"text"},{"text":" ","type":"text"},{"text":"divergences between the journal-driven implementation and the","type":"text"},{"text":" ","type":"text"},{"text":"intended semantics. See this repository’s PropertyTestSupport source","type":"text"},{"text":" ","type":"text"},{"text":"for the model-driven ","type":"text"},{"type":"codeVoice","code":"FlowModelState"},{"text":" pattern.","type":"text"}]},{"text":"Next steps","type":"heading","level":2,"anchor":"Next-steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Read the ","type":"text"},{"code":"Tutorial-LoginOnboarding","type":"codeVoice"},{"text":" guide in the","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterSwiftUI","type":"codeVoice"},{"text":" documentation catalog for the end-to-end flow","type":"text"},{"text":" ","type":"text"},{"text":"being tested here.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read the ","type":"text"},{"code":"Tutorial-MiddlewareComposition","type":"codeVoice"},{"text":" guide in the","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterSwiftUI","type":"codeVoice"},{"text":" documentation catalog for the middleware","type":"text"},{"text":" ","type":"text"},{"text":"surfaces the harness asserts against.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cross-reference ","type":"text"},{"code":"<doc:Rejection-Reasons>","type":"codeVoice"},{"text":" (in InnoRouterCore) for","type":"text"},{"text":" ","type":"text"},{"text":"the full rejection taxonomy your ","type":"text"},{"code":"receiveIntentRejected","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"receiveIntercepted","type":"codeVoice"},{"text":" calls can pattern-match on.","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"role":"article","title":"Testing Flows End-to-End with `FlowTestStore`","modules":[{"name":"InnoRouterMacros"}],"roleHeading":"Article"},"references":{"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/InnoRouterTesting":{"title":"InnoRouterTesting","kind":"article","url":"\/documentation\/innoroutertesting\/innoroutertesting","role":"collectionGroup","abstract":[{"text":"Host-less, Swift-Testing native assertion harness for InnoRouter’s navigation, modal, and flow authorities.","type":"text"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/InnoRouterTesting","type":"topic"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterMacros":{"title":"InnoRouterMacros","kind":"symbol","url":"\/documentation\/innoroutermacros","role":"collection","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterMacros","type":"topic"}}}