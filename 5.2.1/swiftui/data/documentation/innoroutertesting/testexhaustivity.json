{"relationshipsSections":[{"kind":"relationships","title":"Conforms To","type":"conformsTo","identifiers":["doc:\/\/com.innosquad.innorouter.docs.swiftui\/SQ","doc:\/\/com.innosquad.innorouter.docs.swiftui\/SH","doc:\/\/com.innosquad.innorouter.docs.swiftui\/s8SendableP","doc:\/\/com.innosquad.innorouter.docs.swiftui\/s16SendableMetatypeP"]}],"kind":"symbol","abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"type":"text","text":" "},{"type":"text","text":"finishes."}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting\/TestExhaustivity","interfaceLanguage":"swift"},"topicSections":[{"title":"Enumeration Cases","anchor":"Enumeration-Cases","identifiers":["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict"],"generated":true},{"title":"Default Implementations","anchor":"Default-Implementations","identifiers":["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations"],"generated":true}],"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"code":"TestStore","type":"codeVoice"},{"type":"text","text":" exhaustivity model:"},{"type":"text","text":" "},{"type":"text","text":"events collected from the underlying authority’s unified "},{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"code":"receive(...)","type":"codeVoice"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"code":".strict","type":"codeVoice"},{"type":"text","text":" mode, the store reports events left pending at "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"code":"assertNoPendingEvents()","type":"codeVoice"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Swift Testing currently attributes issues recorded inside an","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"isolated "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"unknown test"}]},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/innoroutertesting\/testexhaustivity"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"remoteSource":{"fileName":"TestExhaustivity.swift","url":"https:\/\/github.com\/InnoSquadCorp\/InnoRouter\/blob\/5.2.1\/Sources\/InnoRouterTesting\/TestExhaustivity.swift#L25"},"symbolKind":"enum","navigatorTitle":[{"kind":"identifier","text":"TestExhaustivity"}],"role":"symbol","externalID":"s:17InnoRouterTesting16TestExhaustivityO","roleHeading":"Enumeration","modules":[{"name":"InnoRouterTesting"}],"title":"TestExhaustivity","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}]},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.swiftui/s8SendableP":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/s8SendableP","type":"unresolvable","title":"Swift.Sendable"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting/TestExhaustivity/Equatable-Implementations":{"title":"Equatable Implementations","url":"\/documentation\/innoroutertesting\/testexhaustivity\/equatable-implementations","abstract":[],"role":"collectionGroup","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations","kind":"article"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting/TestExhaustivity":{"title":"TestExhaustivity","navigatorTitle":[{"kind":"identifier","text":"TestExhaustivity"}],"kind":"symbol","url":"\/documentation\/innoroutertesting\/testexhaustivity","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting\/TestExhaustivity","abstract":[{"text":"Controls how strictly a test store checks pending events when observation","type":"text"},{"text":" ","type":"text"},{"text":"finishes.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}]},"doc://com.innosquad.innorouter.docs.swiftui/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","kind":"symbol","type":"topic","role":"collection","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting/TestExhaustivity/strict":{"url":"\/documentation\/innoroutertesting\/testexhaustivity\/strict","title":"TestExhaustivity.strict","abstract":[{"type":"text","text":"Every observed event must be drained through "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation. Pending events fail the test. This is the"},{"type":"text","text":" "},{"type":"text","text":"default and matches TCA’s "},{"type":"codeVoice","code":"exhaustive"},{"type":"text","text":" semantics."}],"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"strict","kind":"identifier"}],"kind":"symbol","role":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting/TestExhaustivity/off":{"kind":"symbol","abstract":[{"text":"The test store still delivers events through ","type":"text"},{"code":"receive(...)","type":"codeVoice"},{"text":", but pending","type":"text"},{"text":" ","type":"text"},{"text":"events at ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" or deallocation are silently discarded. Explicit","type":"text"},{"text":" ","type":"text"},{"text":"assertions and events emitted after ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" still report issues.","type":"text"},{"text":" ","type":"text"},{"text":"Useful for incremental migrations of large legacy suites.","type":"text"}],"role":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","title":"TestExhaustivity.off","type":"topic","url":"\/documentation\/innoroutertesting\/testexhaustivity\/off","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"off"}]},"doc://com.innosquad.innorouter.docs.swiftui/SQ":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/SQ","type":"unresolvable","title":"Swift.Equatable"},"doc://com.innosquad.innorouter.docs.swiftui/SH":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/SH","title":"Swift.Hashable"}}}