{"kind":"article","abstract":[{"type":"text","text":"Coordinators in InnoRouter are SwiftUI-adapted reference authorities, not UIKit-era imperative routers."}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Coordinators-and-Environment-Intent","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Coordinator role","anchor":"Coordinator-role"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" exists for cases where view intent should flow through a policy object before it reaches the store."}]},{"type":"paragraph","inlineContent":[{"text":"A coordinator:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"receives "},{"code":"NavigationIntent","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"decides whether to forward, rewrite, or replace commands","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"maps routes to destinations","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"stays observable for SwiftUI"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"code":"Coordinator","type":"codeVoice"},{"type":"text","text":" remains "},{"code":"AnyObject","type":"codeVoice"},{"type":"text","text":" by design because it is a shared authority object, not ephemeral view state."}]},{"anchor":"Environment-router-actions","text":"Environment router actions","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" is the primary route-action API for views. It exposes"},{"type":"text","text":" "},{"type":"text","text":"discoverable "},{"type":"codeVoice","code":"RouterActions"},{"type":"text","text":" methods such as "},{"type":"codeVoice","code":"go"},{"type":"text","text":", "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":", and, for a"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTab"},{"type":"text","text":", "},{"type":"codeVoice","code":"select"},{"type":"text","text":" without revealing host-owned state. Advanced"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationIntent"},{"type":"text","text":" values remain available through the explicit "},{"code":"send(_:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"escape hatch:","type":"text"}]},{"type":"codeListing","code":["struct ProductRow: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    let productID: String","","    var body: some View {","        Button(\"Open\") {","            router.go(.product(id: productID))","        }","","        Button(\"Replace stack\") {","            router.send(.replaceStack([.catalog, .product(id: productID)]))","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"router.send(_:)"},{"type":"text","text":" when code needs to construct a "},{"type":"codeVoice","code":"NavigationIntent"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalIntent"},{"type":"text","text":" directly, and "},{"type":"codeVoice","code":"router.send(flow:)"},{"type":"text","text":" for an explicit "},{"type":"codeVoice","code":"FlowIntent"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"When stack and modal authorities use different route types, declare one"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" property for each route type."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps view code declarative:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"child views do not need a direct store reference"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"macro diagnostics catch invalid "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" declarations at compile time"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"fail-fast environment behavior catches host wiring mistakes at runtime","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"multi-host trees can keep separate routing authorities in the same hierarchy","type":"text"}],"type":"paragraph"}]}]},{"text":"Host scoping and authority replacement","anchor":"Host-scoping-and-authority-replacement","type":"heading","level":3},{"inlineContent":[{"type":"text","text":"Each "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":", "},{"code":"RouterModalHost","type":"codeVoice"},{"type":"text","text":", "},{"code":"RouterSplitHost","type":"codeVoice"},{"type":"text","text":", "},{"code":"RouterTabHost","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"advanced store-backed host publishes one route-typed authority to its own view"},{"type":"text","text":" "},{"type":"text","text":"subtree. SwiftUI environment value semantics keep sibling hosts independent."},{"type":"text","text":" "},{"type":"text","text":"When a nested host uses the same "},{"code":"Route","type":"codeVoice"},{"type":"text","text":" type, it replaces the complete"},{"type":"text","text":" "},{"type":"text","text":"authority for that subtree instead of merging capabilities from two stores."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This replacement prevents an inner stack-only host from accidentally driving"},{"type":"text","text":" "},{"type":"text","text":"an outer modal or flow authority. Different route types can coexist in one"},{"type":"text","text":" "},{"type":"text","text":"subtree; views declare one "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" property for each route type"},{"type":"text","text":" "},{"type":"text","text":"they use. The registration and storage types are implementation details, so"},{"type":"text","text":" "},{"type":"text","text":"custom view trees should compose the public hosts rather than write router"},{"type":"text","text":" "},{"type":"text","text":"environment state directly."}],"type":"paragraph"},{"type":"heading","level":2,"text":"Flow and tab coordinators","anchor":"Flow-and-tab-coordinators"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterTabHost"},{"text":" is the macro-first tab surface. It owns selection and badge","type":"text"},{"text":" ","type":"text"},{"text":"state locally, renders every generated ","type":"text"},{"type":"codeVoice","code":"RouterTab"},{"text":" case through native","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"TabView"},{"text":", and exposes ","type":"text"},{"type":"codeVoice","code":"select"},{"text":", ","type":"text"},{"type":"codeVoice","code":"setBadge"},{"text":", ","type":"text"},{"type":"codeVoice","code":"clearBadge"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"clearAllBadges"},{"text":" through ","type":"text"},{"type":"codeVoice","code":"EnvironmentRouter"},{"text":":","type":"text"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["struct InboxButton: View {","    @EnvironmentRouter(AppTab.self) private var router","","    var body: some View {","        Button(\"Inbox\") {","            router.select(.inbox)","            router.setBadge(3, for: .inbox)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"StepCoordinator","type":"codeVoice"},{"type":"text","text":" and "},{"code":"TabCoordinator","type":"codeVoice"},{"type":"text","text":" remain advanced composition tools and"},{"type":"text","text":" "},{"type":"text","text":"complement "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":"; they do not replace it."}]},{"type":"paragraph","inlineContent":[{"text":"Recommended mental model:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" owns route-stack authority"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":" owns local macro-first shell tab state"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"TabCoordinator","type":"codeVoice"},{"type":"text","text":" owns externally managed or custom-shell tab state"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"StepCoordinator"},{"text":" owns local step state inside a destination","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Use composition rather than trying to collapse all three responsibilities into one type."}],"type":"paragraph"}],"kind":"content"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"variants":[{"paths":["\/documentation\/innorouterswiftui\/coordinators-and-environment-intent"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"title":"Coordinators and environment router","role":"article","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","kind":"symbol","type":"topic","role":"collection","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","title":"InnoRouterSwiftUI","type":"topic","url":"\/documentation\/innorouterswiftui\/innorouterswiftui"}}}