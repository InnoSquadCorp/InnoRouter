{"metadata":{"role":"article","title":"Migrating from Nested Hosts to `FlowHost`","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}]},"abstract":[{"text":"Replace manually composed ","type":"text"},{"code":"ModalHost { NavigationHost { ... } }","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"surfaces with a single "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" backed by "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":". Preserve"},{"type":"text","text":" "},{"text":"existing ","type":"text"},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" configurations while"},{"type":"text","text":" "},{"type":"text","text":"unlocking a serializable "},{"type":"codeVoice","code":"[RouteStep<R>]"},{"type":"text","text":" path and"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore.apply(_:)"},{"type":"text","text":" for restoration + deep-link hydration."}],"sections":[],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"This is an advanced promotion path. A self-contained push-only feature should","type":"text"},{"text":" ","type":"text"},{"text":"stay on ","type":"text"},{"type":"codeVoice","code":"@Router"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"text":"; introduce the externally owned stores below","type":"text"},{"text":" ","type":"text"},{"text":"only when push and modal state must be restored or deep-linked as one value.","type":"text"}]},{"level":2,"type":"heading","text":"Starting point","anchor":"Starting-point"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An app that shipped before "},{"type":"codeVoice","code":"FlowStore"},{"text":" landed typically has:","type":"text"}]},{"code":["@main","struct LegacyApp: App {","    @State private var nav = NavigationStore<AppRoute>()","    @State private var modal = ModalStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            ModalHost(store: modal, destination: destination) {","                NavigationHost(store: nav, destination: destination) {","                    RootView()","                }","            }","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Two stores. Two hosts. Path + modal state cannot be round-tripped"},{"type":"text","text":" "},{"type":"text","text":"as one value — the app can’t persist “user is 3 screens deep"},{"type":"text","text":" "},{"type":"text","text":"inside a presented sheet” without hand-serializing both halves."}],"type":"paragraph"},{"anchor":"Target-shape","text":"Target shape","level":2,"type":"heading"},{"code":["@main","struct MigratedApp: App {","    @State private var flow = FlowStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: flow,","                destination: destination,","                root: { RootView() }","            )","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"One store. One host. "},{"type":"codeVoice","code":"flow.path: [RouteStep<AppRoute>]"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"single source of truth; push + sheet + cover are three cases of"},{"type":"text","text":" "},{"type":"text","text":"the same enum."}]},{"type":"heading","text":"Migration steps","anchor":"Migration-steps","level":2},{"type":"heading","text":"1. Swap the host layering","anchor":"1-Swap-the-host-layering","level":3},{"type":"paragraph","inlineContent":[{"text":"Replace the nested host pair with ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":". It renders environment-free","type":"text"},{"text":" ","type":"text"},{"text":"navigation and modal surfaces around one ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", then publishes one"},{"text":" ","type":"text"},{"text":"unified authority for ","type":"text"},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":". External observable behavior stays"},{"type":"text","text":" "},{"type":"text","text":"the same without exposing the inner stores as independent mutation surfaces."}]},{"text":"2. Route view actions through `EnvironmentRouter`","type":"heading","anchor":"2-Route-view-actions-through-EnvironmentRouter","level":3},{"inlineContent":[{"text":"Old:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["navigationStore.send(.go(.detail))","modalStore.present(.sheet, style: .sheet)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"New:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@EnvironmentRouter(AppRoute.self) private var router","\/\/ ...","router.go(.detail)","router.sheet(.sheet)"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"router.send(flow:)","type":"codeVoice"},{"type":"text","text":" only for flow-specific operations such as resetting a"},{"type":"text","text":" "},{"type":"text","text":"complete "},{"code":"RouteStep","type":"codeVoice"},{"type":"text","text":" path."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"FlowStore.send"},{"type":"text","text":" routes navigation and modal intents through the corresponding"},{"type":"text","text":" "},{"type":"text","text":"configured middleware and reports their wrapped events through the unified"},{"type":"text","text":" "},{"type":"text","text":"flow observation stream."}],"type":"paragraph"},{"text":"3. Port store configuration through `FlowStoreConfiguration`","type":"heading","anchor":"3-Port-store-configuration-through-FlowStoreConfiguration","level":3},{"inlineContent":[{"code":"FlowStoreConfiguration","type":"codeVoice"},{"type":"text","text":" composes "},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"type":"text","text":" +"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalStoreConfiguration"},{"type":"text","text":", so existing configs port 1:1:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let flow = FlowStore<AppRoute>(","    configuration: .init(","        navigation: legacyNavigationConfiguration,","        modal: legacyModalConfiguration,","        onEvent: { event in","            switch event {","            case .pathChanged(let old, let new):","                Log.debug(\"flow path: \\(old) -> \\(new)\")","            case .intentRejected(let intent, let reason):","                Log.info(\"flow rejected \\(intent): \\(reason)\")","            case .navigation(let event):","                Log.debug(\"navigation event: \\(event)\")","            case .modal(let event):","                Log.debug(\"modal event: \\(event)\")","            }","        }","    )",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In 5.0, each store configuration has one typed "},{"code":"onEvent","type":"codeVoice"},{"text":" callback.","type":"text"},{"text":" ","type":"text"},{"text":"Remove the former per-case callback arguments and switch over the","type":"text"},{"text":" ","type":"text"},{"text":"matching event enum instead. The flow-level callback also receives","type":"text"},{"text":" ","type":"text"},{"text":"the inner navigation and modal events as wrapped cases; callbacks","type":"text"},{"text":" ","type":"text"},{"text":"already installed on the two legacy configurations still receive","type":"text"},{"text":" ","type":"text"},{"text":"their direct ","type":"text"},{"code":"NavigationEvent","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"ModalEvent","type":"codeVoice"},{"text":" values.","type":"text"}]},{"text":"4. Handle the two new invariant-violation paths","anchor":"4-Handle-the-two-new-invariant-violation-paths","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" rejects intents that would violate its invariants:"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Intent situation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Reason emitted","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".push","type":"codeVoice"},{"type":"text","text":" while a modal tail is active"}],"type":"paragraph"}],[{"inlineContent":[{"code":".pushBlockedByModalTail","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".reset([.sheet, .push])"},{"text":" (modal not at tail)","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":".invalidResetPath","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Any intent cancelled by middleware"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".middlewareRejected(debugName:)"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Subscribe to "},{"code":"flow.events","type":"codeVoice"},{"type":"text","text":" or handle "},{"code":".intentRejected","type":"codeVoice"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"text","text":"configuration’s "},{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" closure. The legacy"},{"type":"text","text":" "},{"type":"text","text":"stores never had this signal; before the migration, a push attempt"},{"type":"text","text":" "},{"type":"text","text":"during a sheet presentation silently no-opped or tripped up the"},{"type":"text","text":" "},{"type":"text","text":"app in subtle ways."}]},{"type":"heading","level":3,"text":"5. Adopt `apply(_:)` for deep links and restoration","anchor":"5-Adopt-apply-for-deep-links-and-restoration"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowPlan<R>.steps"},{"type":"text","text":" is "},{"code":"[RouteStep<R>]","type":"codeVoice"},{"text":", so once your routes opt","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"into "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":":"}]},{"code":["extension AppRoute: Codable {}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StatePersistence<AppRoute>"},{"type":"text","text":" round-trips the whole flow state:"}]},{"code":["let persistence = StatePersistence<AppRoute>()","","\/\/ On app background","try persistence.encode(FlowPlan(steps: flow.path)).write(to: url)","","\/\/ On launch","if let data = try? Data(contentsOf: url) {","    flow.apply(try persistence.decode(data))","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Deep-link resolvers can emit a "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" directly and hand it to"},{"type":"text","text":" "},{"type":"codeVoice","code":"flow.apply(_:)"},{"type":"text","text":" to hydrate a push + sheet terminal URL in one"},{"type":"text","text":" "},{"type":"text","text":"atomic step."}]},{"level":3,"text":"6. Migrate tests incrementally","type":"heading","anchor":"6-Migrate-tests-incrementally"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTestStore"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ModalTestStore"},{"text":" remain available, so tests that","type":"text"},{"text":" ","type":"text"},{"text":"infer their event types can keep the same test-store setup. Removed event","type":"text"},{"text":" ","type":"text"},{"text":"typealiases do not preserve explicit annotations: migrate those annotations to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationEvent<R>"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"ModalEvent<M>"},{"text":", and use ","type":"text"},{"type":"codeVoice","code":"FlowEvent<R>"},{"text":" with","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":". Re-home the highest-value scenarios onto "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"you get a chance — a single "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" subscription asserts both"},{"type":"text","text":" "},{"type":"text","text":"navigation and modal emissions in the same FIFO queue, which usually"},{"type":"text","text":" "},{"type":"text","text":"compresses a 40-line legacy test into 15 lines."}]},{"level":2,"anchor":"Rollback-story","type":"heading","text":"Rollback story"},{"inlineContent":[{"type":"text","text":"The migration is per-flow. Any screen tree that still uses the"},{"type":"text","text":" "},{"type":"text","text":"nested host pair continues to build. "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" lives alongside"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":"; adopting one doesn’t remove the"},{"type":"text","text":" "},{"type":"text","text":"others. Incremental migration by flow (onboarding, settings,"},{"type":"text","text":" "},{"type":"text","text":"checkout, …) is supported."}],"type":"paragraph"},{"level":2,"anchor":"Next-steps","type":"heading","text":"Next steps"},{"type":"unorderedList","it