tingFromNestedHosts"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","title":"InnoRouterSwiftUI","type":"topic","url":"\/documentation\/innorouterswiftui\/innorouterswiftui"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","kind":"symbol","type":"topic","role":"collection","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","kind":"article","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","role":"article","type":"topic","abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", then let the signup "},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}],"title":"Building a Login Onboarding Flow"}}}