{"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/casestudy-onboardingflow"]}],"metadata":{"title":"Case study: shipping a 12-screen onboarding flow","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article"},"abstract":[{"type":"text","text":"A representative composition of "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"FlowPlan","type":"codeVoice"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"NavigationMiddleware"},{"type":"text","text":" for a 12-screen"},{"text":" ","type":"text"},{"text":"onboarding sequence with conditional branches, deep-link","type":"text"},{"text":" ","type":"text"},{"text":"resumption, and entitlement gating.","type":"text"}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/CaseStudy-OnboardingFlow","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"overview","text":"Overview","type":"heading"},{"content":[{"inlineContent":[{"text":"This is a synthesized case study against the public InnoRouter","type":"text"},{"text":" ","type":"text"},{"text":"surface (v5.0). It does not represent a specific shipped app","type":"text"},{"text":" ","type":"text"},{"text":"but is structured to match the shape of recurring requests","type":"text"},{"text":" ","type":"text"},{"text":"from teams evaluating the framework.","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"level":2,"anchor":"The-brief","text":"The brief","type":"heading"},{"inlineContent":[{"type":"text","text":"The flow:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Launch screen.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Welcome + region picker."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Phone-number entry."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"SMS verification (modal sheet)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Profile photo (skippable)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Display name.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Permission primer (one screen per permission requested)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Notification opt-in (system prompt, conditional next step).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Home location (skippable)."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Work location (skippable)."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Subscription pitch (modal sheet, conditional).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Welcome-home with feature tour."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Constraints:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Auth state is owned by an existing ","type":"text"},{"code":"AuthClient","type":"codeVoice"},{"text":". The flow","type":"text"},{"text":" ","type":"text"},{"text":"reads it but doesn’t own it.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Step ordering depends on user input (region → which","type":"text"},{"text":" ","type":"text"},{"text":"permissions to request, region → subscription eligibility).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The user can deep-link in via ","type":"text"},{"type":"codeVoice","code":"inno:\/\/onboarding\/profile"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"resume mid-flow with prior steps already validated.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Analytics fires on every step entry. A push from outside the","type":"text"},{"text":" ","type":"text"},{"text":"flow (e.g. a referral landing) shouldn’t double-fire entry","type":"text"},{"text":" ","type":"text"},{"text":"events.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"type":"heading","anchor":"The-composition","text":"The composition"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@Routable","enum OnboardingRoute: Codable {","    case launch","    case welcome","    case phoneNumber","    case profilePhoto","    case displayName","    case permissionPrimer(Permission)","    case homeLocation","    case workLocation","    case smsVerification(phoneNumber: String)","    case subscription(plan: SubscriptionPlan)","    case welcomeHome","}"]},{"type":"paragraph","inlineContent":[{"text":"One route type covers both push destinations and modal-only","type":"text"},{"text":" ","type":"text"},{"text":"destinations. ","type":"text"},{"code":"FlowStore<OnboardingRoute>","type":"codeVoice"},{"text":" exposes ","type":"text"},{"code":"path: [RouteStep<OnboardingRoute>]","type":"codeVoice"},{"text":": ","type":"text"},{"type":"codeVoice","code":".push(...)"},{"type":"text","text":" steps drive the"},{"type":"text","text":" "},{"type":"text","text":"navigation stack, while "},{"type":"codeVoice","code":".sheet(...)"},{"type":"text","text":" and "},{"type":"codeVoice","code":".cover(...)"},{"type":"text","text":" steps"},{"type":"text","text":" "},{"type":"text","text":"drive modal presentation. Because the single route type is"},{"type":"text","text":" "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", the entire flow state is serializable to a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":"."}]},{"code":["store.send(.presentSheet(.smsVerification(phoneNumber: phoneNumber)))","","let rehydrationPlan: FlowPlan<OnboardingRoute> = .init(steps: [","    .push(.launch),","    .push(.welcome),","    .sheet(.subscription(plan: subscriptionPlan)),","])"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"anchor":"The-driver","text":"The driver","type":"heading","level":2},{"code":["@MainActor","final class OnboardingDriver: ChildCoordinator {","    typealias Route = OnboardingRoute","    typealias Result = OnboardingResult","","    var onFinish: (@MainActor @Sendable (OnboardingResult) -> Void)?","    var onCancel: (@MainActor @Sendable () -> Void)?","","    let store: FlowStore<OnboardingRoute>","    private let auth: AuthClient","    private let analytics: AnalyticsClient","","    init(auth: AuthClient, analytics: AnalyticsClient) {","        self.auth = auth","        self.analytics = analytics","        self.store = FlowStore(","            configuration: FlowStoreConfiguration(","                navigation: NavigationStoreConfiguration(","                    middlewares: [","                        .init(middleware: AnalyticsMiddleware(analytics: analytics),","                              debugName: \"analytics\"),","                        .init(middleware: EntitlementGate(auth: auth),","                              debugName: \"entitlement\"),","                    ]","                ),","                onEvent: { [analytics] event in","                    switch event {","                    case .pathChanged(_, let new):","                        analytics.record(.flowPathChanged(new))","                    case .intentRejected(_, let reason):","                        analytics.record(.flowRejected(reason))","                    case .navigation, .modal:","                        break","                    }","                },","                queueCoalescePolicy: .dropQueued","            )","        )","    }","","    func start() {","        store.send(.replaceStack([.launch, .welcome]))","    }","","    func handleDeepLink(_ url: URL) async {","        guard let plan = OnboardingDeepLink.plan(from: url, auth: auth) else {","            store.send(.push(.welcome))","            return","        }","        _ = store.apply(plan)","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"code":"ChildCoordinator","type":"codeVoice"},{"text":" returns an ","type":"text"},{"code":"OnboardingResult","type":"codeVoice"},{"type":"text","text":" to the parent"},{"type":"text","text":" "},{"type":"text","text":"when the flow finishes:"}]},{"code":["enum OnboardingResult {","    case completed(profile: Profile)","    case abandoned(at: OnboardingRoute)","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app-defined flow owner first stores "},{"type":"codeVoice","code":"onboardingDriver"},{"type":"text","text":" in state that"},{"type":"text","text":" "},{"type":"text","text":"presents the sheet, then directly awaits"},{"type":"text","text":" "},{"type":"codeVoice","code":"onboardingDriver.waitForResult() async -> OnboardingResult?"},{"type":"text","text":". The method waits"},{"type":"text","text":" "},{"type":"text","text":"for the result but never presents the driver. Its structured call threads"},{"type":"text","text":" "},{"type":"text","text":"caller-task cancellation back through "},{"type":"codeVoice","code":"parentDidCancel()"},{"type":"text","text":" and returns "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" if"},{"type":"text","text":" "},{"type":"text","text":"the sheet shell tears down its awaiting task. The owner clears its presentation"},{"type":"text","text":" "},{"type":"text","text":"state after the call returns."}]},{"text":"What the middlewares earn","type":"heading","level":2,"anchor":"What-the-middlewares-earn"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"AnalyticsMiddleware"},{"type":"text","text":" records "},{"type":"codeVoice","code":".willExecute"},{"type":"text","text":" and "},{"type":"codeVoice","code":".didExecute"},{"type":"text","text":" "},{"type":"text","text":"events for every navigation command, deduplicated against the"},{"type":"text","text":" "},{"type":"codeVoice","code":".pathChanged"},{"type":"text","text":" case handled by "},{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because middleware fires "},{"type":"strong","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"state mutates, the analytics event always carries the intended"},{"type":"text","text":" "},{"type":"text","text":"target route, not the post-cancellation snapshot."}]},{"inlineContent":[{"code":"EntitlementGate","type":"codeVoice"},{"type":"text","text":" reads "},{"code":"auth.isEligible(for: route)","type":"codeVoice"},{"type":"text","text":" for each"},{"type":"text","text":" "},{"type":"text","text":"navigation prefix. If the user is not yet eligible for a"},{"type":"text","text":" "},{"type":"text","text":"branch, navigation middleware cancels the "},{"code":".replaceStack","type":"codeVoice"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"code":".reset","type":"codeVoice"},{"type":"text","text":" command with a typed reason; the flow falls back to"},{"type":"text","text":" "},{"code":".dropQueued","type":"codeVoice"},{"type":"text","text":" policy, dismissing any speculative modal state"},{"type":"text","text":" "},{"type":"text","text":"that was queued behind the rejected navigation rewrite."},{"type":"text","text":" "},{"text":"The ","type":"text"},{"type":"codeVoice","code":".intentRejected"},{"text":" case records a structured","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".middlewareRejected(debugName: \"entitlement\")"},{"text":" event so the","type":"text"},{"text":" ","type":"text"},{"text":"analytics layer can correlate with the same span ID.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"What-FlowPlan-earns","text":"What `FlowPlan` earns"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A deep link "},{"type":"codeVoice","code":"inno:\/\/onboarding\/profile"},{"type":"text","text":" deserializes into:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let plan: FlowPlan<OnboardingRoute> = .init(","    steps: [","        .push(.launch),","        .push(.welcome),","        .push(.phoneNumber),","        .push(.profilePhoto),","    ]",")"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"store.apply(plan)"},{"type":"text","text":" is atomic: every step previews against"},{"type":"text","text":" "},{"type":"text","text":"middleware in order, and the entire plan rolls back if any"},{"type":"text","text":" "},{"type":"text","text":"preview rejects. The user never sees a half-applied flow even"},{"type":"text","text":" "},{"type":"text","text":"if the entitlement gate decides one of the intermediate steps"},{"type":"text","text":" "},{"type":"text","text":"is currently unreachable."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Because "},{"type":"codeVoice","code":"OnboardingRoute"},{"type":"text","text":" is "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", the same "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" can"},{"type":"text","text":" "},{"type":"text","text":"be persisted to "},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":" on "},{"type":"codeVoice","code":"scenePhase: .background"},{"type":"text","text":" "},{"type":"text","text":"and restored on the next cold launch via"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan(validating:)"},{"type":"text","text":" — the validating constructor rejects"},{"type":"text","text":" "},{"type":"text","text":"invariant violations (e.g. two modal steps) before the"},{"type":"text","text":" "},{"type":"text","text":"authority sees them."}]},{"level":2,"anchor":"What-InnoRouterTesting-earns","text":"What `InnoRouterTesting` earns","type":"heading"},{"code":["@Test","func onboardingResumesFromProfile() async throws {","    let auth = AuthClient.signedIn(region: .us)","    let analytics = RecordingAnalytics()","    let test = FlowTestStore<OnboardingRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: EntitlementGate(auth: auth)),","            ])","        )","    )","","    test.send(.push(.launch))","    test.expect(navigation: [.launch])","    try await test.apply(","        FlowPlan(steps: [","            .push(.launch),","            .push(.welcome),","            .push(.phoneNumber),","            .push(.profilePhoto),","        ])","    )","    test.expect(navigation: [.launch, .welcome, .phoneNumber, .profilePhoto])","    test.expect(modal: nil)","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"No SwiftUI host in scope. The exact same store configuration —"},{"type":"text","text":" "},{"type":"text","text":"including production analytics middleware — is exercised in"},{"type":"text","text":" "},{"type":"text","text":"the test and in production. "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" reuses the"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"type":"text","text":", so the test can also verify"},{"type":"text","text":" "},{"type":"text","text":"that "},{"type":"codeVoice","code":"analytics.record(.flowPathChanged(...))"},{"type":"text","text":" fired exactly"},{"type":"text","text":" "},{"type":"text","text":"once per applied step."}],"type":"paragraph"},{"level":2,"anchor":"Observed-wins","text":"Observed wins","type":"heading"},{"inlineContent":[{"type":"text","text":"In a comparable TCA-modeled flow before the swap, the same"},{"type":"text","text":" "},{"type":"text","text":"feature carried:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"~340 lines of ","type":"text"},{"code":"Reducer","type":"codeVoice"},{"text":" boilerplate for navigation actions","type":"text"},{"text":" ","type":"text"},{"text":"alone (push \/ pop \/ present \/ dismiss \/ forward \/ hydrate).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Three custom test harnesses to assert state restoration,"},{"type":"text","text":" "},{"type":"text","text":"deep-link replay, and entitlement gating in isolation."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A bespoke “is the queue stale?” check after every cancelled","type":"text"},{"text":" ","type":"text"},{"text":"command because TCA’s ","type":"text"},{"code":"@Presents","type":"codeVoice"},{"text":" carry-over isn’t governed","type":"text"},{"text":" ","type":"text"},{"text":"by a policy at the framework level.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The InnoRouter version drops the navigation reducer","type":"text"},{"text":" ","type":"text"},{"text":"boilerplate entirely (the framework owns the state machine),","type":"text"},{"text":" ","type":"text"},{"text":"folds the three test harnesses into one ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"suite, and pushes the queue-coalesce decision into a single"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStoreConfiguration"},{"type":"text","text":" setting that participates in the"},{"type":"text","text":" "},{"type":"text","text":"analytics middleware’s span ID without extra wiring."}]},{"level":2,"anchor":"When-this-composition-is-overkill","type":"heading","text":"When this composition is overkill"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a single-screen flow with no entitlement gating and no deep link, declare"},{"type":"text","text":" "},{"type":"text","text":"the destinations with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" and use "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":". Promote to an externally"},{"type":"text","text":" "},{"type":"text","text":"owned "},{"type":"codeVoice","code":"NavigationStore<R>"},{"type":"text","text":" + "},{"type":"codeVoice","code":"NavigationHost"},{"text":" only when another boundary needs","type":"text"},{"text":" ","type":"text"},{"text":"the store.","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" earns its surface specifically when:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Multiple steps need atomic deep-link rehydration.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The modal authority is genuinely concurrent with the"},{"text":" ","type":"text"},{"type":"text","text":"navigation stack (sheets, covers)."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"A coordinator-level result ("},{"code":"OnboardingResult","type":"codeVoice"},{"type":"text","text":") needs to"},{"type":"text","text":" "},{"text":"bubble back to the parent.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Middleware needs to gate or telemeter the entire flow.","type":"text"}]}]}],"type":"unorderedList"}]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","kind":"symbol","type":"topic","role":"collection","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","title":"InnoRouterSwiftUI","type":"topic","url":"\/documentation\/innorouterswiftui\/innorouterswiftui"}}}