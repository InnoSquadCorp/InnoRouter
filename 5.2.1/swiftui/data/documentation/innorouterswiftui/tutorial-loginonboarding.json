{"metadata":{"title":"Building a Login Onboarding Flow","roleHeading":"Article","role":"article","modules":[{"name":"InnoRouterTesting"}]},"abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then let the signup "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}],"sections":[],"kind":"article","schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Scenario","anchor":"Scenario"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app launches on a welcome screen. Tapping "},{"type":"emphasis","inlineContent":[{"text":"Continue","type":"text"}]},{"type":"text","text":" pushes a"},{"text":" ","type":"text"},{"text":"pre-auth detail screen. Tapping ","type":"text"},{"inlineContent":[{"type":"text","text":"Create account"}],"type":"emphasis"},{"text":" presents a signup","type":"text"},{"text":" ","type":"text"},{"text":"sheet. When the signup finishes (or is cancelled) the owning flow","type":"text"},{"text":" ","type":"text"},{"text":"resumes — either navigating to ","type":"text"},{"code":".home(user)","type":"codeVoice"},{"text":" or staying put.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modeling this with raw "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" means two"},{"type":"text","text":" "},{"type":"text","text":"authority objects, two view-layer hosts, and hand-rolled"},{"type":"text","text":" "},{"type":"text","text":"continuation plumbing to surface the sheet result back to the"},{"type":"text","text":" "},{"type":"text","text":"owner. "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" collapse this to a single"},{"type":"text","text":" "},{"type":"text","text":"store and one "},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"This flow has crossed the macro-first local-stack boundary: push and modal","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"state must share one externally owned, serializable authority. A push-only"},{"type":"text","text":" "},{"text":"version should stay on ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" instead.","type":"text"}]},{"text":"Routes","level":2,"anchor":"Routes","type":"heading"},{"syntax":"swift skip doc-fragment","code":["enum AppRoute: Route {","    case preAuth","    case signup","    case home(UserID)","}"],"type":"codeListing"},{"text":"Wiring the flow host","level":2,"anchor":"Wiring-the-flow-host","type":"heading"},{"inlineContent":[{"code":"FlowHost","type":"codeVoice"},{"type":"text","text":" renders environment-free navigation and modal surfaces around one"},{"type":"text","text":" "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", then publishes a unified router authority to its view subtree:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@main","struct DemoApp: App {","    @State private var onboarding = OnboardingCoordinator()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: onboarding.flowStore,","                destination: destination,","                root: {","                    WelcomeRootView {","                        Task { await onboarding.startSignUpFlow() }","                    }","                }","            )","        }","    }","","    @ViewBuilder","    private func destination(_ route: AppRoute) -> some View {","        switch route {","        case .preAuth:","            PreAuthDetailView()","        case .signup:","            if let signUp = onboarding.activeSignUp {","                SignUpView(coordinator: signUp)","            }","        case .home(let id):","            HomeView(userID: id)","        }","    }","}"],"type":"codeListing"},{"text":"Emitting intents from views","level":2,"anchor":"Emitting-intents-from-views","type":"heading"},{"inlineContent":[{"text":"Views never mutate ","type":"text"},{"type":"codeVoice","code":"FlowStore.path"},{"text":" directly. They read typed actions from","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@EnvironmentRouter"},{"text":"; the host projects those actions through ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"middleware and event observation see every step:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["struct WelcomeRootView: View {","    @EnvironmentRouter(AppRoute.self) private var router","    let startSignUp: @MainActor () -> Void","","    var body: some View {","        VStack {","            Button(\"Continue\") {","                router.go(.preAuth)","            }","            Button(\"Create account\") {","                startSignUp()","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"router.send(flow:)"},{"type":"text","text":" only for flow-specific operations that do not have a"},{"type":"text","text":" "},{"type":"text","text":"focused action, such as resetting a complete "},{"type":"codeVoice","code":"RouteStep"},{"type":"text","text":" path."}],"type":"paragraph"},{"level":2,"anchor":"Awaiting-a-signup-sub-flow","text":"Awaiting a signup sub-flow","type":"heading"},{"inlineContent":[{"text":"The signup sheet opens its own child coordinator that owns the step progression","type":"text"},{"text":" ","type":"text"},{"text":"(email → password → confirmation). The app-defined onboarding owner keeps that","type":"text"},{"text":" ","type":"text"},{"text":"child in presentation state, presents it through the same ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", then","type":"text"},{"text":" ","type":"text"},{"code":"await","type":"codeVoice"},{"text":"s the final ","type":"text"},{"code":"UserID","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"signUp.waitForResult()","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@MainActor","final class SignUpCoordinator: ChildCoordinator {","    typealias Result = UserID","","    var onFinish: (@MainActor @Sendable (UserID) -> Void)?","    var onCancel: (@MainActor @Sendable () -> Void)?","","    \/\/ ...step state + methods omitted","","    func userDidCreateAccount(_ userID: UserID) {","        onFinish?(userID)   \/\/ emits the result back to the owner","    }","","    func userCancelled() {","        onCancel?()          \/\/ the owner sees nil","    }","}","","@Observable","@MainActor","final class OnboardingCoordinator {","    let flowStore = FlowStore<AppRoute>()","","    \/\/ The sheet content observes this app-owned placement state.","    var activeSignUp: SignUpCoordinator?","","    func startSignUpFlow() async {","        guard activeSignUp == nil else { return }","","        let signUp = SignUpCoordinator()","        activeSignUp = signUp","        defer { activeSignUp = nil }","","        flowStore.send(.presentSheet(.signup))","        let result = await signUp.waitForResult()","        flowStore.send(.dismiss)","","        if let userID = result {","            flowStore.send(.push(.home(userID)))","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"activeSignUp"},{"type":"text","text":" determines which child the "},{"type":"codeVoice","code":".signup"},{"type":"text","text":" destination renders;"},{"type":"text","text":" "},{"type":"codeVoice","code":"flowStore"},{"type":"text","text":" remains the sole push-and-modal authority. "},{"type":"codeVoice","code":"waitForResult()"},{"type":"text","text":" only"},{"type":"text","text":" "},{"type":"text","text":"waits for a result and never presents the child. It installs the child’s "},{"type":"codeVoice","code":"onFinish"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"onCancel"},{"type":"text","text":" callbacks before its first suspension, so the child can emit a"},{"type":"text","text":" "},{"type":"text","text":"result at any point after the asynchronous call begins without a "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"re-entrancy deadlock. Cancelling the caller task that awaits "},{"code":"waitForResult()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"resolves it with "},{"code":"nil","type":"codeVoice"},{"type":"text","text":", invokes "},{"code":"parentDidCancel()","type":"codeVoice"},{"text":", and runs the ","type":"text"},{"type":"codeVoice","code":"defer"},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"clears the app-owned placement state. See","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","type":"reference"},{"type":"text","text":" "},{"type":"text","text":"for the design rationale."}],"type":"paragraph"},{"anchor":"Verifying-the-flow-host-lessly","level":2,"type":"heading","text":"Verifying the flow host-lessly"},{"inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"text":" (in ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":") exercises the full chain","type":"text"},{"type":"text","text":" "},{"type":"text","text":"in a unit test without mounting any SwiftUI host:"}],"type":"paragraph"},{"code":["@Test","@MainActor","func signUpCompletesOnboarding() {","    let store = FlowTestStore<AppRoute>()","","    store.send(.presentSheet(.signup))","    store.receiveModal { if case .presented = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","","    store.send(.dismiss)","    store.receiveModal { if case .dismissed = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"anchor":"Next-steps","text":"Next steps","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","type":"reference","isActive":true},{"type":"text","text":" to add analytics and"},{"type":"text","text":" "},{"text":"authentication gating to the same flow.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","type":"reference"},{"text":" to extend the host so a","type":"text"},{"text":" ","type":"text"},{"text":"push-notification URL can drop the user directly into ","type":"text"},{"code":".home","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"state on launch."}],"type":"paragraph"}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-loginonboarding"]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","interfaceLanguage":"swift"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-DeepLinkReconciliation":{"kind":"article","abstract":[{"text":"Match a URL, apply an authentication policy, and produce a","type":"text"},{"text":" ","type":"text"},{"code":"NavigationPlan","type":"codeVoice"},{"text":" that ","type":"text"},{"code":"NavigationStore.executeBatch","type":"codeVoice"},{"text":" applies in one","type":"text"},{"text":" ","type":"text"},{"text":"observable step. Queue the deep link while the user is signed out,","type":"text"},{"text":" ","type":"text"},{"text":"replay it after sign-in, and surface cancellation reasons through","type":"text"},{"text":" ","type":"text"},{"text":"typed outcomes.","type":"text"}],"role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","title":"Reconciling Deep Links End-to-End","type":"topic","url":"\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","title":"InnoRouterSwiftUI","type":"topic","url":"\/documentation\/innorouterswiftui\/innorouterswiftui"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting"