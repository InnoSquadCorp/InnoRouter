{"kind":"article","abstract":[{"text":"Choose one macro-first host for the local surface. ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" and","type":"text"},{"type":"text","text":" "},{"code":"RouterSplitHost","type":"codeVoice"},{"type":"text","text":" unify stack and modal actions, "},{"code":"RouterModalHost","type":"codeVoice"},{"type":"text","text":" narrows a"},{"type":"text","text":" "},{"type":"text","text":"feature to modal actions, and "},{"code":"RouterTabHost","type":"codeVoice"},{"type":"text","text":" owns native tab state."},{"type":"text","text":" "},{"type":"text","text":"Externally owned stores and coordinator hosts remain advanced authorities."}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Split-Modal-and-Composition"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Split-navigation","text":"Split navigation","type":"heading","level":2},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"text":" for a macro-first sidebar\/detail layout. It owns the","type":"text"},{"text":" ","type":"text"},{"text":"detail stack and modal authority locally, builds destinations from the","type":"text"},{"text":" ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" enum, and exposes both through ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["RouterSplitHost(AppRoute.self) {","    SidebarView()","} root: {","    ContentUnavailableView(\"Select an item\", systemImage: \"sidebar.left\")","}"]},{"inlineContent":[{"text":"All stack and modal actions pass through the same ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":", so a push is","type":"text"},{"text":" ","type":"text"},{"text":"still rejected while a modal route is the flow tail. Use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationSplitHost"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"CoordinatorSplitHost"},{"type":"text","text":" when the application must own"},{"type":"text","text":" "},{"type":"text","text":"an advanced stack-only authority directly."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Important scope boundary:"}]},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" owns the detail stack and modal authority"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"advanced split hosts own only the detail stack"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"sidebar selection remains app-owned"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"column visibility remains system-managed","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"compact adaptation remains system-managed"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps shell state out of the stack authority."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NavigationSplitHost"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CoordinatorSplitHost"},{"text":" are ","type":"text"},{"inlineContent":[{"type":"text","text":"unavailable on watchOS"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"because SwiftUI’s "},{"code":"NavigationSplitView","type":"codeVoice"},{"type":"text","text":" is unavailable there. watchOS apps should fall back"},{"type":"text","text":" "},{"type":"text","text":"to "},{"code":"NavigationHost","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"CoordinatorHost","type":"codeVoice"},{"type":"text","text":" in the "},{"code":"#else","type":"codeVoice"},{"type":"text","text":" branch of a"},{"type":"text","text":" "},{"code":"#if !os(watchOS)","type":"codeVoice"},{"type":"text","text":" check."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" remains visible to watchOS callers as an explicitly"},{"text":" ","type":"text"},{"text":"unavailable declaration, whose compiler diagnostic directs macro-first code","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"aside","style":"note","name":"Platform"},{"type":"heading","anchor":"Modal-navigation","text":"Modal navigation","level":2},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":" when a feature needs only sheet and cover presentation:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["RouterModalHost(AppRoute.self) {","    ModalLauncher()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"AppRoute"},{"type":"text","text":" has generated "},{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" mappings, the modal host presents a"},{"type":"text","text":" "},{"type":"text","text":"resolved incoming URL as a sheet automatically. Configure a different"},{"type":"text","text":" "},{"type":"text","text":"host-wide style when needed:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["RouterModalHost(AppRoute.self, deepLinkStyle: .fullScreenCover) {","    ModalLauncher()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Descendants use the same typed environment router as every other macro-first"},{"type":"text","text":" "},{"type":"text","text":"surface:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@EnvironmentRouter(AppRoute.self) private var router","","Button(\"Edit\") {","    router.sheet(.editor)","}","","Button(\"Preview\") {","    router.cover(.preview)","}"]},{"type":"paragraph","inlineContent":[{"code":"RouterModalHost","type":"codeVoice"},{"text":" owns its ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" locally and publishes only modal"},{"type":"text","text":" "},{"type":"text","text":"capability. An accidental "},{"type":"codeVoice","code":"go"},{"type":"text","text":" call therefore reports a missing navigation"},{"type":"text","text":" "},{"type":"text","text":"capability instead of silently inventing a stack."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" with "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" when restoration, middleware management, or"},{"type":"text","text":" "},{"type":"text","text":"direct observation requires the application to own the modal authority."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS and tvOS, "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" uses native "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":" and "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" presentation."},{"type":"text","text":" "},{"type":"text","text":"On other supported platforms, "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" requests degrade to "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The advanced modal authority intentionally stays separate from a stack-only","type":"text"},{"text":" ","type":"text"},{"text":"authority:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"modal intent uses "},{"type":"codeVoice","code":"ModalIntent"}]}]},{"content":[{"inlineContent":[{"text":"stack intent uses ","type":"text"},{"code":"NavigationIntent","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"modal queue state lives in "},{"type":"codeVoice","code":"ModalStore"}]}]},{"content":[{"inlineContent":[{"text":"stack state lives in ","type":"text"},{"code":"NavigationStore","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Modal queue rules are intentionally small:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"present","type":"codeVoice"},{"type":"text","text":" shows immediately when no modal is active."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"present"},{"type":"text","text":" appends to "},{"type":"codeVoice","code":"queuedPresentations"},{"type":"text","text":" when another modal is"},{"type":"text","text":" "},{"type":"text","text":"active."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"dismissCurrent","type":"codeVoice"},{"text":" dismisses the active modal and promotes the first","type":"text"},{"text":" ","type":"text"},{"text":"queued presentation, if one exists.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"dismissAll"},{"text":" clears both the active modal and the queue.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"replaceCurrent"},{"type":"text","text":" swaps only the active presentation and leaves the"},{"type":"text","text":" "},{"type":"text","text":"queue untouched; observers receive "},{"type":"codeVoice","code":".replaced"},{"type":"text","text":" before the command"},{"type":"text","text":" "},{"type":"text","text":"interception event."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dismissCurrent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"dismissAll"},{"type":"text","text":" attempts enter modal middleware even when"},{"type":"text","text":" "},{"type":"text","text":"there is no active presentation or queue. The resulting command can remain a"},{"type":"text","text":" "},{"type":"text","text":"no-op, be cancelled, or be rewritten by middleware; this matches direct"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" execution instead of hiding empty-state attempts in "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Every convenience mutator reports its effective outcome as a","type":"text"},{"text":" ","type":"text"},{"code":"@discardableResult","type":"codeVoice"},{"text":": ","type":"text"},{"code":"present","type":"codeVoice"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"ModalPresentResult"},{"text":", while","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"replaceCurrent"},{"type":"text","text":", "},{"type":"codeVoice","code":"dismissCurrent"},{"type":"text","text":", and "},{"type":"codeVoice","code":"dismissAll"},{"type":"text","text":" return the same"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalExecutionResult"},{"type":"text","text":" that "},{"type":"codeVoice","code":"execute(_:)"},{"type":"text","text":" produces. Callers can branch on a"},{"type":"text","text":" "},{"type":"text","text":"middleware cancellation or an empty-state "},{"type":"codeVoice","code":".noop"},{"type":"text","text":" directly at the call site"},{"type":"text","text":" "},{"type":"text","text":"instead of subscribing to the event stream; call sites that ignore the"},{"type":"text","text":" "},{"type":"text","text":"result compile unchanged."}]},{"inlineContent":[{"type":"text","text":"When middleware cancels a FlowStore modal preview, the captured participants"},{"type":"text","text":" "},{"type":"text","text":"still receive "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":", observers receive "},{"type":"codeVoice","code":".commandIntercepted"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalQueueCancellationPolicy"},{"type":"text","text":" is applied to the preview state. If that policy"},{"type":"text","text":" "},{"type":"text","text":"changes the live queue, "},{"type":"codeVoice","code":".queueChanged"},{"type":"text","text":" is delivered before the interception"},{"type":"text","text":" "},{"type":"text","text":"and flow-level rejection. During an atomic reset, a cancellation previewed from"},{"type":"text","text":" "},{"text":"an intermediate shadow is finalized with the actual live state that survived","type":"text"},{"text":" ","type":"text"},{"text":"rollback. Successful navigation and modal previews that preceded that","type":"text"},{"text":" ","type":"text"},{"text":"cancellation stay off the public ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" path and run their package-owned","type":"text"},{"text":" ","type":"text"},{"text":"discard cleanup instead.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"alert","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"confirmationDialog","type":"codeVoice"},{"text":" stay outside this framework surface and should remain feature-owned state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"ModalStoreConfiguration"},{"type":"text","text":" uses one "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" callback for the complete"},{"type":"text","text":" "},{"type":"text","text":"modal observation surface:"}],"type":"paragraph"},{"code":["let configuration = ModalStoreConfiguration<AppRoute>(","    onEvent: { event in","        switch event {","        case .presented(let presentation):","            analytics.recordPresented(presentation)","        case .dismissed(let presentation, let reason):","            analytics.recordDismissed(presentation, reason: reason)","        case .replaced(let old, let new):","            analytics.recordReplacement(from: old, to: new)","        case .queueChanged(let old, let new):","            diagnostics.recordQueueChange(from: old, to: new)","        case .commandIntercepted(let command, let result):","            diagnostics.record(command, result: result)","        case .middlewareMutation(let mutation):","            diagnostics.record(mutation)","        }","    }",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"When migrating to 5.0, merge the former modal lifecycle closures into","type":"text"},{"text":" ","type":"text"},{"text":"this switch. ","type":"text"},{"code":"ModalStore.events","type":"codeVoice"},{"text":" emits the same cases asynchronously.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Automatic URL handling pushes through "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"RouterSplitHost","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"presents through "},{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":", or selects through "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":" applies one host-wide deep-link style; per-route presentation"},{"type":"text","text":" "},{"type":"text","text":"policy still belongs at an application-owned flow boundary."}],"type":"paragraph"},{"level":2,"text":"Composition","type":"heading","anchor":"Composition"},{"inlineContent":[{"type":"text","text":"The recommended composition rules are:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose exactly one local macro-first authority for a route type in a","type":"text"},{"text":" ","type":"text"},{"text":"subtree: ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Put shell state such as tabs or app mode outside feature-local routing."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use distinct route types for nested authorities that must remain"},{"type":"text","text":" "},{"type":"text","text":"independent."}]}]},{"content":[{"inlineContent":[{"text":"Promote to ","type":"text"},{"type":"codeVoice","code":"NavigationHost"},{"text":", ","type":"text"},{"type":"codeVoice","code":"ModalHost"},{"text":", ","type":"text"},{"type":"codeVoice","code":"FlowHost"},{"text":", or a coordinator host","type":"text"},{"text":" ","type":"text"},{"text":"only when the application owns that state.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Keep feature-local routing inside the destination that owns it."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Do not wrap "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" in "},{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":" for the same route type:"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" already owns both capabilities, and a nested same-route host"},{"type":"text","text":" "},{"type":"text","text":"replaces the outer authority for its subtree. These rules keep each authority"},{"type":"text","text":" "},{"type":"text","text":"narrow without creating one application-wide store."}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/split-modal-and-composition"]}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article","title":"Split, modal, and composition patterns"},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","title":"InnoRouterSwiftUI","type":"topic","url":"\/documentation\/innorouterswiftui\/innorouterswiftui"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","kind":"symbol","type":"topic","role":"collection","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"}}}