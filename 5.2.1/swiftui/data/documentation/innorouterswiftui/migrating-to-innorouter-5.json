{"kind":"article","abstract":[{"text":"Move a 4.x application to the macro-first 5.0 surface in deliberate stages.","type":"text"},{"text":" ","type":"text"},{"text":"InnoRouter 5 removes compatibility shims and implementation-facing public API,","type":"text"},{"text":" ","type":"text"},{"text":"but keeps state-driven navigation, modal, flow, and deep-link behavior as the","type":"text"},{"text":" ","type":"text"},{"text":"advanced foundation beneath the generated hosts.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Migrating-To-InnoRouter-5","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Before changing source","level":2,"anchor":"Before-changing-source","type":"heading"},{"inlineContent":[{"type":"text","text":"Confirm the application can use the 5.0 toolchain and deployment floors:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift 6.3 or newer"}]}]},{"content":[{"inlineContent":[{"text":"iOS and iPadOS 18 or newer","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"macOS 15 or newer"}]}]},{"content":[{"inlineContent":[{"text":"tvOS 18 or newer","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"watchOS 11 or newer","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"visionOS 2 or newer","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Update the package requirement first, then resolve and build before editing"},{"type":"text","text":" "