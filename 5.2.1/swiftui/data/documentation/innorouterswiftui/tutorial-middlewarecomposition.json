{"kind":"article","abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"text":" ","type":"text"},{"type":"text","text":"both "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" and "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that pairs completion callbacks with the middlewares"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" hook actually ran."}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},"primaryContentSections":[{"content":[{"text":"Scenario","type":"heading","anchor":"Scenario","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every "},{"code":"NavigationCommand","type":"codeVoice"},{"type":"text","text":" and "},{"code":"ModalCommand","type":"codeVoice"},{"type":"text","text":" should be logged"},{"type":"text","text":" "},{"type":"text","text":"before it executes. A feature-flagged screen must be gated behind"},{"type":"text","text":" "},{"type":"text","text":"an entitlement check. An analytics call must fire after an"},{"type":"text","text":" "},{"type":"text","text":"execution attempt finishes — but only for middlewares that actually"},{"type":"text","text":" "},{"type":"text","text":"participated in the "},{"code":"willExecute","type":"codeVoice"},{"type":"text","text":" decision."}]},{"type":"paragraph","inlineContent":[{"text":"This tutorial starts at the externally owned-store tier because middleware is","type":"text"},{"text":" ","type":"text"},{"text":"installed when the authority is created. A self-contained stack without custom","type":"text"},{"text":" ","type":"text"},{"text":"policy should use ","type":"text"},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" + "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" instead."}]},{"anchor":"Modeling-routes","type":"heading","text":"Modeling routes","level":2},{"type":"codeListing","code":["enum AppRoute: Route {","    case home","    case premiumDetail","    case paywall","}"],"syntax":"swift skip doc-fragment"},{"type":"heading","level":2,"anchor":"Logging-middleware","text":"Logging middleware"},{"type":"paragraph","inlineContent":[{"text":"Reuse the ","type":"text"},{"type":"codeVoice","code":"AnyNavigationMiddleware"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"AnyModalMiddleware"},{"text":" ","type":"text"},{"type":"text","text":"closure initializers so a minimal shared logger composes without"},{"type":"text","text":" "},{"type":"text","text":"boilerplate:"}]},{"code":["@MainActor","func loggingNavigationMiddleware() -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(","        willExecute: { command, _ in","            Log.debug(\"navigation command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, result, _ in","            Log.debug(\"navigation finished: \\(command) -> \\(result)\")","            return result","        }","    )","}","","@MainActor","func loggingModalMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(","        willExecute: { command, _, _ in","            Log.debug(\"modal command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, _, _ in","            Log.debug(\"modal finished: \\(command)\")","        }","    )","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"heading","level":2,"anchor":"Entitlement-gating","text":"Entitlement gating"},{"type":"paragraph","inlineContent":[{"text":"The gate is itself a middleware; denying a command is just","type":"text"},{"type":"text","text":" "},{"text":"returning ","type":"text"},{"code":".cancel(reason)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["@MainActor","func entitlementGateNavigation(hasPremium: @escaping @MainActor () -> Bool) -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(willExecute: { command, _ in","        guard case .push(.premiumDetail) = command, !hasPremium() else {","            return .proceed(command)","        }","        return .cancel(.middleware(debugName: \"entitlement-gate\", command: command))","    })","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cancellation surfaces through"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalStoreConfiguration.onEvent"},{"type":"text","text":" as"},{"type":"text","text":" "},{"type":"codeVoice","code":".commandIntercepted(_, .cancelled(...))"},{"type":"text","text":" and through"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowRejectionReason.middlewareRejected(debugName: \"entitlement-gate\")"},{"text":" ","type":"text"},{"type":"text","text":"when used from "},{"code":"FlowStore","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Wiring it all","level":2,"type":"heading","anchor":"Wiring-it-all"},{"syntax":"swift skip doc-fragment","code":["let navStore = NavigationStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingNavigationMiddleware(), debugName: \"logging\"),","            .init(middleware: entitlementGateNavigation(hasPremium: { EntitlementStore.shared.hasPremium }), debugName: \"entitlement-gate\"),","        ]","    )",")","","let modalStore = ModalStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingModalMiddleware(), debugName: \"logging\"),","        ]","    )",")"],"type":"codeListing"},{"type":"heading","text":"Participant discipline","anchor":"Participant-discipline","level":2},{"inlineContent":[{"text":"When a middleware cancels a command, every middleware whose","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" hook ran is a participant, including the cancelling"},{"text":" ","type":"text"},{"text":"middleware itself. Middleware later in the chain did not run and","type":"text"},{"text":" ","type":"text"},{"text":"therefore receives no completion callback.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"That guarantee is why the logger safely appears "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the"},{"text":" ","type":"text"},{"type":"text","text":"entitlement gate — the logger’s "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" fires even if the"},{"type":"text","text":" "},{"type":"text","text":"gate cancels, so the cancellation is still recorded. Reordering"},{"type":"text","text":" "},{"text":"to ","type":"text"},{"code":"[entitlement-gate, logging]","type":"codeVoice"},{"type":"text","text":" would skip the logger’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" on cancellation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For direct and batch "},{"type":"codeVoice","code":".whenCancelled"},{"type":"text","text":" execution, "},{"code":"didExecute","type":"codeVoice"},{"text":" is","type":"text"},{"type":"text","text":" "},{"text":"attempt-level: it can run for a leg whose ","type":"text"},{"type":"codeVoice","code":"RouteStack"},{"text":" change is","type":"text"},{"type":"text","text":" "},{"text":"later discarded. Use the aggregate result and ","type":"text"},{"type":"codeVoice","code":".changed"},{"type":"text","text":" event to"},{"type":"text","text":" "},{"type":"text","text":"observe durable state. Transactions instead keep "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" "},{"type":"text","text":"commit-only; its returned fold can change reporting after commit but"},{"type":"text","text":" "},{"text":"cannot roll back the transaction.","type":"text"}]},{"level":2,"type":"heading","anchor":"Observing-a-cancellation-end-to-end","text":"Observing a cancellation end-to-end"},{"inlineContent":[{"type":"codeVoice","code":"ModalStore.events"},{"type":"text","text":" surfaces "},{"type":"codeVoice","code":".commandIntercepted(.cancelled(...))"},{"text":" ","type":"text"},{"text":"while a direct ","type":"text"},{"code":"NavigationStore.execute(_:)","type":"codeVoice"},{"type":"text","text":" cancellation is returned"},{"type":"text","text":" "},{"type":"text","text":"as "},{"code":"NavigationResult.cancelled","type":"codeVoice"},{"type":"text","text":"; a path-reconciliation policy may"},{"type":"text","text":" "},{"type":"text","text":"separately emit "},{"code":".pathMismatch","type":"codeVoice"},{"type":"text","text":". For a "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" in particular,"},{"type":"text","text":" "},{"code":"FlowStore.events","type":"codeVoice"},{"text":" wraps both in ","type":"text"},{"code":".navigation(...)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":".modal(...)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"cases so one subscriber sees the whole picture. Capture the stream before"},{"type":"text","text":" "},{"text":"starting its lifecycle-owned task to register the subscriber synchronously.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let events = flowStore.events","let observationTask = Task { @MainActor in","    for await event in events {","        if case .modal(.commandIntercepted(_, .cancelled(let reason))) = event {","            Log.info(\"modal cancelled: \\(reason)\")","        }","        if case .intentRejected(_, .middlewareRejected(let name)) = event {","            Log.info(\"flow intent rejected by: \\(name ?? \"nil\")\")","        }","    }","}"]},{"anchor":"Testing-middleware-with-FlowTestStore","text":"Testing middleware with FlowTestStore","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"text":" (in ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":") asserts the cancellation","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"chain without mounting SwiftUI:"}],"type":"paragraph"},{"code":["@Test","@MainActor","func entitlementGateBlocksPremiumPush() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: entitlementGateNavigation(hasPremium: { false }), debugName: \"gate\")","            ])","        )","    )","","    store.send(.push(.premiumDetail))","","    store.receiveIntentRejected(","        intent: .push(.premiumDetail),","        reason: .middlewareRejected(debugName: \"gate\")","    )","    store.finish()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"anchor":"Next-steps","text":"Next steps","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","type":"reference","isActive":true},{"text":" to see how middleware","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"interacts with a multi-step flow plus a child coordinator."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Read the "},{"code":"Tutorial-TestingFlows","type":"codeVoice"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"code":"InnoRouterTesting","type":"codeVoice"},{"type":"text","text":" documentation catalog for the full host-less"},{"type":"text","text":" "},{"type":"text","text":"test harness tour."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"title":"Composing Middleware Across Navigation and Modal","role":"article","roleHeading":"Article"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","kind":"article","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","role":"article","type":"topic","abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", then let the signup "},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}],"title":"Building a Login Onboarding Flow"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","title":"InnoRouterSwiftUI","type":"topic","url":"\/documentation\/innorouterswiftui\/innorouterswiftui"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","kind":"symbol","type":"topic","role":"collection","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"}}}