{"abstract":[{"type":"text","text":"Declare windows, volumetric windows, and immersive spaces in one route enum."},{"type":"text","text":" "},{"type":"text","text":"Install the generated scene tree once, then use route-typed environment actions"},{"type":"text","text":" "},{"type":"text","text":"from the views rendered by that tree."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Why scenes use a separate router","anchor":"Why-scenes-use-a-separate-router"},{"type":"paragraph","inlineContent":[{"text":"visionOS app scenes are not stack or modal destinations:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"a regular window uses "},{"type":"codeVoice","code":"WindowGroup(id:for:)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"a volumetric window adds "},{"type":"codeVoice","code":"windowStyle(.volumetric)"},{"type":"text","text":" and a physical size"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"an immersive space uses "},{"code":"ImmersiveSpace(id:)","type":"codeVoice"},{"type":"text","text":" and an immersion style"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Their SwiftUI open and dismiss actions are available only inside a scene’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"view hierarchy. "},{"type":"codeVoice","code":"@SceneRouter"},{"type":"text","text":" generates that scene hierarchy and publishes one"},{"type":"text","text":" "},{"type":"text","text":"route-typed authority, while "},{"type":"codeVoice","code":"@EnvironmentSceneRouter"},{"text":" keeps feature views","type":"text"},{"type":"text","text":" "},{"type":"text","text":"independent of the underlying SwiftUI action chosen for each route."}]},{"type":"heading","level":2,"text":"1. Declare the scene inventory","anchor":"1-Declare-the-scene-inventory"},{"type":"paragraph","inlineContent":[{"text":"Add the ","type":"text"},{"type":"codeVoice","code":"InnoRouterSpatial"},{"text":" product to the visionOS app target and import it","type":"text"},{"text":" ","type":"text"},{"text":"explicitly:","type":"text"}]},{"type":"codeListing","syntax":"swift skip package-manifest-fragment","code":[".product(name: \"InnoRouterSpatial\", package: \"InnoRouter\")"]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["import SwiftUI","import InnoRouterSpatial","","@SceneRouter","enum AppScene {","    @Scene(.window)","    case main","","    @Scene(","        .volumetric(width: 0.6, height: 0.4, depth: 0.4),","        id: \"model\"","    )","    case model","","    @Scene(.immersive(style: .mixed))","    case theatre","","    var destination: some View {","        switch self {","        case .main:","            MainView()","        case .model:","            ModelView()","        case .theatre:","            TheatreView()","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Every case is parameterless and has exactly one ","type":"text"},{"type":"codeVoice","code":"@Scene"},{"text":". The style carries","type":"text"},{"text":" ","type":"text"},{"text":"declaration metadata rather than request-time options:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".window"},{"text":" creates a regular value-based window","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".volumetric(width:height:depth:)"},{"text":" creates a volumetric window whose positive","type":"text"},{"text":" ","type":"text"},{"text":"finite dimensions are measured in metres","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".immersive(style:)"},{"text":" creates an immersive space","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"An explicit ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" is optional and defaults to the case name. Supply one only","type":"text"},{"text":" ","type":"text"},{"text":"when the Swift case may be renamed while the system scene identifier must stay","type":"text"},{"text":" ","type":"text"},{"text":"stable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The first case is the launch-preferred scene, so put a window or volume first","type":"text"},{"text":" ","type":"text"},{"text":"for the normal launch path. Every live generated scene participates in host","type":"text"},{"text":" ","type":"text"},{"text":"election. If the launch scene closes while another generated scene remains,","type":"text"},{"text":" ","type":"text"},{"text":"that survivor is promoted and can still open any declared scene. The macro","type":"text"},{"text":" ","type":"text"},{"text":"diagnoses missing annotations, associated values, duplicate IDs, conditional","type":"text"},{"text":" ","type":"text"},{"text":"inventories, invalid sizes, and conflicting generated members at compile time.","type":"text"}]},{"type":"heading","level":2,"text":"2. Install the generated scene tree","anchor":"2-Install-the-generated-scene-tree"},{"type":"paragraph","inlineContent":[{"text":"Use the generated static ","type":"text"},{"type":"codeVoice","code":"scenes"},{"text":" property as the app’s scene body:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@main","struct MyApp: App {","    var body: some Scene {","        AppScene.scenes","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"That single line owns the common composition:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"one ","type":"text"},{"type":"codeVoice","code":"SceneStore<AppScene>"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"one ","type":"text"},{"type":"codeVoice","code":"SceneRegistry<AppScene>"},{"text":" built from the annotations","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"cooperative ","type":"text"},{"type":"codeVoice","code":"innoRouterSceneHost"},{"text":" wiring on every generated scene root","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"automatic dispatcher promotion when the elected scene disappears","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"the matching ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"text":", volumetric style and size, or ","type":"text"},{"type":"codeVoice","code":"ImmersiveSpace"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Do not add a second store, host, or anchor around generated destinations. The","type":"text"},{"text":" ","type":"text"},{"text":"generated tree is the routing authority for that route type.","type":"text"}]},{"type":"heading","level":3,"text":"Immersive-first launch","anchor":"Immersive-first-launch"},{"type":"paragraph","inlineContent":[{"text":"An immersive scene cannot normally dispatch until the system opens it. If the","type":"text"},{"text":" ","type":"text"},{"text":"product truly launches directly into immersion, configure the app scene","type":"text"},{"text":" ","type":"text"},{"text":"manifest with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UIApplicationPreferredDefaultSceneSessionRole"},{"text":" set to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UISceneSessionRoleImmersiveSpaceApplication"},{"text":", configure","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"UISceneInitialImmersionStyle"},{"text":" when needed, and acknowledge that external","type":"text"},{"text":" ","type":"text"},{"text":"contract in source:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@SceneRouter(immersiveLaunch: true)","enum ImmersiveAppScene {","    @Scene(.immersive(style: .full))","    case experience","","    var destination: some View {","        ExperienceView()","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The macro cannot inspect "},{"code":"Info.plist","type":"codeVoice"},{"type":"text","text":"; the argument only suppresses the"},{"type":"text","text":" "},{"type":"text","text":"immersive-primary warning after the application has configured that launch"},{"type":"text","text":" "},{"type":"text","text":"contract. It warns when the acknowledgement is unnecessary for a window- or"},{"type":"text","text":" "},{"type":"text","text":"volume-first router."}]},{"type":"heading","level":2,"text":"3. Open and dismiss scenes from views","anchor":"3-Open-and-dismiss-scenes-from-views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read the nearest matching scene router just as stack and modal views read"},{"type":"text","text":" "},{"code":"@EnvironmentRouter","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["struct SceneControls: View {","    @EnvironmentSceneRouter(AppScene.self) private var scenes","    @State private var modelWindow: ScenePresentation<AppScene>?","","    var body: some View {","        VStack {","            Button(\"Open model\") {","                modelWindow = scenes.open(.model)","            }","","            Button(\"Close model\") {","                if let modelWindow {","                    scenes.dismissWindow(modelWindow)","                }","            }","","            Button(\"Enter theatre\") {","                scenes.open(.theatre)","            }","","            Button(\"Leave theatre\") {","                scenes.dismissImmersive()","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"code":"open(_:)","type":"codeVoice"},{"type":"text","text":" reads the route’s kind, ID, volumetric size, and immersive style"},{"type":"text","text":" "},{"type":"text","text":"from the generated registry. It returns a request handle for a window or"},{"type":"text","text":" "},{"type":"text","text":"volume, or an immersive presentation value; it is not a promise that the"},{"type":"text","text":" "},{"type":"text","text":"system completed the presentation. Use "},{"code":"dismissWindow(_:)","type":"codeVoice"},{"type":"text","text":" with a retained"},{"type":"text","text":" "},{"type":"text","text":"window or volume handle and "},{"code":"dismissImmersive()","type":"codeVoice"},{"type":"text","text":" for the active immersive"},{"type":"text","text":" "},{"type":"text","text":"space."}]},{"type":"paragraph","inlineContent":[{"text":"Environment resolution is lazy. Merely rendering a view outside the generated","type":"text"},{"text":" ","type":"text"},{"text":"tree does not report an error; invoking an action without the matching route","type":"text"},{"text":" ","type":"text"},{"text":"authority applies ","type":"text"},{"type":"codeVoice","code":"EnvironmentMissingPolicy"},{"text":". On visionOS the default fails","type":"text"},{"text":" ","type":"text"},{"text":"loudly and points back to installing ","type":"text"},{"type":"codeVoice","code":"AppScene.scenes"},{"text":"; a deliberately","type":"text"},{"text":" ","type":"text"},{"text":"degradable preview can opt into ","type":"text"},{"type":"codeVoice","code":".logAndDegrade"},{"text":" at its boundary. Off","type":"text"},{"text":" ","type":"text"},{"text":"visionOS no authority can exist, so shared cross-platform view code always","type":"text"},{"text":" ","type":"text"},{"text":"logs and degrades to a no-op without any opt-in.","type":"text"}]},{"type":"heading","level":2,"text":"Advanced: own the store and registry manually","anchor":"Advanced-own-the-store-and-registry-manually"},{"type":"paragraph","inlineContent":[{"text":"Use manual composition when the application must retain the store, observe","type":"text"},{"text":" ","type":"text"},{"text":"scene events, inject a registry from another boundary, or control host and","type":"text"},{"text":" ","type":"text"},{"text":"anchor placement directly. This is the plain Swift equivalent of the generated","type":"text"},{"text":" ","type":"text"},{"text":"tree:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["import SwiftUI","import InnoRouterSpatial","","enum SpatialRoute: Route {","    case main","    case theatre","}","","private let spatialScenes = SceneRegistry<SpatialRoute>(","    .window(.main, id: \"main\"),","    .immersive(.theatre, id: \"theatre\", style: .mixed)",")","","@main","struct ManualSpatialApp: App {","    @State private var sceneStore = SceneStore<SpatialRoute>()","","    var body: some Scene {","        WindowGroup(id: \"main\", for: UUID.self) { $sceneID in","            ContentView()","                .innoRouterSceneHost(","                    sceneStore,","                    scenes: spatialScenes,","                    attachedTo: .main,","                    instanceID: sceneID","                )","        } defaultValue: {","            UUID()","        }","","        ImmersiveSpace(id: \"theatre\") {","            TheatreView()","                .innoRouterSceneAnchor(","                    sceneStore,","                    scenes: spatialScenes,","                    attachedTo: .theatre","                )","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Attach exactly one host per store and one anchor to every non-host scene:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Scene declaration"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"innoRouterSceneHost"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"innoRouterSceneAnchor"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Primary "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" or volume"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Exactly once"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Never on the same scene"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Secondary "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" or volume"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Exactly once"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ImmersiveSpace"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No, unless it is the configured immersive-first host"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Exactly once otherwise"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"The host is the preferred dispatcher. Anchors reconcile system-driven"},{"type":"text","text":" "},{"type":"text","text":"appear\/disappear lifecycle and can temporarily dispatch for their own"},{"type":"text","text":" "},{"type":"text","text":"declaration if the host is gone. They reject cross-scene opens they cannot"},{"type":"text","text":" "},{"type":"text","text":"perform instead of pretending success. Value-based windows use the "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" "},{"type":"text","text":"provided by "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":"; immersive spaces use route-only host or anchor"},{"type":"text","text":" "},{"type":"text","text":"overloads."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"These fallback-anchor and duplicate-host recovery rules apply only to manual"},{"type":"text","text":" "},{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":" composition. A generated "},{"type":"codeVoice","code":"@SceneRouter"},{"type":"text","text":" tree attaches cooperative"},{"type":"text","text":" "},{"type":"text","text":"full-authority hosts to every live scene root; when the elected host disappears,"},{"type":"text","text":" "},{"type":"text","text":"a surviving generated host is promoted automatically."}],"type":"paragraph"},{"text":"Observe manual scene lifecycle","level":3,"anchor":"Observe-manual-scene-lifecycle","type":"heading"},{"inlineContent":[{"type":"text","text":"Manual ownership exposes "},{"type":"codeVoice","code":"SceneStore.events"},{"type":"text","text":". Capture the stream before"},{"type":"text","text":" "},{"type":"text","text":"starting its lifecycle task so observation is registered before the next"},{"type":"text","text":" "},{"type":"text","text":"request:"}],"type":"paragraph"},{"code":["let events = sceneStore.events","let observationTask = Task { @MainActor in","    for await event in events {","        analytics.record(event)","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"Scene lifecycle events are "},{"type":"codeVoice","code":"presented"},{"type":"text","text":", "},{"type":"codeVoice","code":"dismissed"},{"type":"text","text":", and "},{"type":"codeVoice","code":"rejected"},{"type":"text","text":"; a duplicate"},{"type":"text","text":" "},{"type":"text","text":"primary host additionally emits "},{"type":"codeVoice","code":"hostRegistrationRejected"},{"type":"text","text":". Rejections retain"},{"type":"text","text":" "},{"type":"text","text":"the original "},{"type":"codeVoice","code":"SceneIntent"},{"type":"text","text":" and distinguish undeclared routes, declaration"},{"type":"text","text":" "},{"type":"text","text":"mismatches, stale window handles, fallback-dispatch limits, and"},{"type":"text","text":" "},{"type":"text","text":"environment-returned failures such as user cancellation. The generated macro"},{"type":"text","text":" "},{"type":"text","text":"keeps its store private; promote to this manual shape when direct event"},{"type":"text","text":" "},{"type":"text","text":"observation is a requirement."}],"type":"paragraph"},{"text":"Ornaments on any platform","level":2,"anchor":"Ornaments-on-any-platform","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"View.innoRouterOrnament(_:content:)"},{"type":"text","text":" attaches a SwiftUI ornament on visionOS"},{"type":"text","text":" "},{"type":"text","text":"and is a no-op on every other supported platform, so a shared call site can"},{"type":"text","text":" "},{"type":"text","text":"remain unconditional:"}],"type":"paragraph"},{"type":"codeListing","code":["ContentView()","    .innoRouterOrnament(","        OrnamentAnchor(anchor: .bottom, alignment: .center)","    ) {","        ControlBar()","    }"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OrnamentAnchor"},{"type":"text","text":" remains serializable and testable even where the visual effect"},{"text":" ","type":"text"},{"text":"does not materialize.","type":"text"}]},{"type":"heading","level":2,"anchor":"Compose-beside-in-scene-routing","text":"Compose beside in-scene routing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":" is intentionally not part of "},{"type":"codeVoice","code":"FlowStore"},{"text":". ","type":"text"},{"type":"codeVoice","code":"RouteStep"},{"text":" describes","type":"text"},{"text":" ","type":"text"},{"text":"push, sheet, and cover transitions inside one scene, while spatial routing","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"opens or dismisses app-level scenes. An app can use "},{"type":"codeVoice","code":"@SceneRouter"},{"type":"text","text":" for its app"},{"type":"text","text":" "},{"type":"text","text":"scene inventory and a separate "},{"type":"codeVoice","code":"@Router"},{"text":" host inside any generated scene. In","type":"text"},{"text":" ","type":"text"},{"text":"the manual path it can own ","type":"text"},{"type":"codeVoice","code":"SceneStore<R>"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FlowStore<R>"},{"type":"text","text":" side by side; the"},{"type":"text","text":" "},{"type":"text","text":"route types may be shared or distinct according to the product boundary."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterspatial\/tutorial-visionosscenes"]}],"kind":"article","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterSpatial\/Tutorial-VisionOSScenes"},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article","title":"visionOS: macro-first app scenes"},"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterSpatial\/InnoRouterSpatial"]]},"references":{"doc://com.innosquad.innorouter.docs.spatial/documentation/InnoRouterSpatial/InnoRouterSpatial":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterSpatial\/InnoRouterSpatial","type":"topic","kind":"article","url":"\/documentation\/innorouterspatial\/innorouterspatial","abstract":[{"type":"text","text":"Macro-first scene routing for visionOS windows, volumes, immersive spaces, and"},{"type":"text","text":" "},{"type":"text","text":"ornaments."}],"title":"InnoRouterSpatial","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.spatial/documentation/InnoRouterTesting":{"abstract":[],"url":"\/documentation\/innoroutertesting","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting","type":"topic","role":"collection","title":"InnoRouterTesting"}}}