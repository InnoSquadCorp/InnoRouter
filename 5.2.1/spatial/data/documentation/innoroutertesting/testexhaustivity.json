forms To","kind":"relationships"}],"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}]}],"kind":"declarations"},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"code":"TestStore","type":"codeVoice"},{"type":"text","text":" exhaustivity model:"},{"type":"text","text":" "},{"type":"text","text":"events collected from the underlying authority’s unified "},{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"code":"receive(...)","type":"codeVoice"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"code":".strict","type":"codeVoice"},{"type":"text","text":" mode, the store reports events left pending at "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"code":"assertNoPendingEvents()","type":"codeVoice"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}],"type":"paragraph"},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"type":"emphasis","inlineContent":[{"text":"unknown test","type":"text"}]},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}],"type":"paragraph"}],"style":"note","type":"aside"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.spatial/documentation/InnoRouterTesting/TestExhaustivity/off":{"abstract":[{"type":"text","text":"The test store still delivers events through "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":", but pending"},{"type":"text","text":" "},{"type":"text","text":"events at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation are silently discarded. Explicit"},{"type":"text","text":" "},{"type":"text","text":"assertions and events emitted after "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" still report issues."},{"type":"text","text":" "},{"type":"text","text":"Useful for incremental migrations of large legacy suites."}],"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"off"}],"url":"\/documentation\/innoroutertesting\/testexhaustivity\/off","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","type":"topic","role":"symbol","title":"TestExhaustivity.off"},"doc://com.innosquad.innorouter.docs.spa