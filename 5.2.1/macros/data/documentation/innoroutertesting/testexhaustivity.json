ice","code":"receive(...)"},{"type":"text","text":", but pending"},{"type":"text","text":" "},{"type":"text","text":"events at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation are silently discarded. Explicit"},{"type":"text","text":" "},{"type":"text","text":"assertions and events emitted after "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" still report issues."},{"type":"text","text":" "},{"type":"text","text":"Useful for incremental migrations of large legacy suites."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"off"}],"title":"TestExhaustivity.off","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","url":"\/documentation\/innoroutertesting\/testexhaustivity\/off"},"doc://com.innosquad.innorouter.docs.macros/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/s8SendableP","title":"Swift.Sendable"}}}