,"type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"code":"receive(...)","type":"codeVoice"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"code":".strict","type":"codeVoice"},{"type":"text","text":" mode, the store reports events left pending at "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"code":"assertNoPendingEvents()","type":"codeVoice"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"inlineContent":[{"type":"text","text":"unknown test"}],"type":"emphasis"},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}]}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity"},"metadata":{"roleHeading":"Enumeration","role":"symbol","modules":[{"name":"InnoRouterTesting"}],"externalID":"s:17InnoRouterTesting16TestExhaustivityO","symbolKind":"enum","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}],"title":"TestExhaustivity","navigatorTitle":[{"kind":"identifier","text":"TestExhaustivity"}],"remoteSource":{"url":"https:\/\/github.com\/InnoSquadCorp\/InnoRouter\/blob\/5.2.1\/Sources\/InnoRouterTesting\/TestExhaustivity.swift#L25","fileName":"TestExhaustivity.swift"}},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","kind":"symbol","type":"topic","url":"\/documentation\/innoroutertesting","role":"collection","title":"InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting/TestExhaustivity/Equatable-Implementations":{"abstract":[],"kind":"article","type":"topic","role":"collectionGroup","title":"Equatable Implementations","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations","url":"\/documentation\/innoroutertesting\/testexhaustivity\/equatable-implementations"},"doc://com.innosquad.innorouter.docs.macros/SQ":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/SQ","title":"Swift.Equatable"},"doc://com.innosquad.innorouter.docs.macros/SH":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/SH","title":"Swift.Hashable"},"doc://com.innosquad.innorouter.docs.macros/s16SendableMetaty