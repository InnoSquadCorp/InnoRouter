{"kind":"article","identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","interfaceLanguage":"swift"},"metadata":{"role":"collectionGroup","title":"InnoRouterMacros","modules":[{"name":"InnoRouterTesting"}]},"abstract":[{"type":"text","text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path"},{"type":"text","text":" "},{"type":"text","text":"available for advanced composition."}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter 5 makes macros part of the canonical "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" product. Most"},{"type":"text","text":" "},{"type":"text","text":"applications add that one product and use one import:"}]},{"type":"codeListing","code":["import SwiftUI","import InnoRouter"],"syntax":"swift compile"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The module exposes five macros with separate responsibilities:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"@Router","type":"codeVoice"},{"text":" is the default macro-first path. It turns route cases and an","type":"text"},{"text":" ","type":"text"},{"text":"instance ","type":"text"},{"code":"destination","type":"codeVoice"},{"text":" view into a ","type":"text"},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":" that works with"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"text":", and generates tab or deep-link capabilities when their marker","type":"text"},{"type":"text","text":" "},{"type":"text","text":"macros are present."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@TabItem"},{"text":" marks parameterless router cases and generates the metadata used","type":"text"},{"type":"text","text":" "},{"type":"text","text":"by "},{"type":"codeVoice","code":"RouterTabHost"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@DeepLink","type":"codeVoice"},{"type":"text","text":" maps literal URL paths to typed router cases. "},{"type":"codeVoice","code":"@Router"},{"text":" validates","type":"text"},{"text":" ","type":"text"},{"text":"literal scheme and host allowlists and generates the ","type":"text"},{"type":"codeVoice","code":"DeepLinkRoute"},{"text":" ","type":"text"},{"text":"resolver. Generated matching prefers literal paths, then typed parameters,","type":"text"},{"text":" ","type":"text"},{"text":"then terminal wildcards, regardless of case declaration order.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Routable"},{"text":" adds ","type":"text"},{"type":"codeVoice","code":"Route"},{"text":" conformance plus typed ","type":"text"},{"type":"codeVoice","code":"Cases"},{"text":", ","type":"text"},{"type":"codeVoice","code":"is(_:)"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"subscript(case:)"},{"text":" helpers. It does not build destination views.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@CasePathable"},{"text":" adds the same case-path helpers without adding ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" ","type":"text"},{"text":"conformance.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Every generated conformance has a plain Swift equivalent. Applications that","type":"text"},{"type":"text","text":" "},{"text":"need externally owned stores, coordinators, restoration, or custom dependency","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"construction can continue to use the runtime APIs directly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The opt-in "},{"type":"codeVoice","code":"InnoRouterSpatial"},{"type":"text","text":" product adds "},{"type":"codeVoice","code":"@SceneRouter"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Scene"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"visionOS app scenes. Those macros generate the scene tree installed in"},{"type":"text","text":" "},{"type":"codeVoice","code":"App.body"},{"type":"text","text":"; they are intentionally not part of the default "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" "},{"type":"text","text":"umbrella."}]},{"text":"Macro-first quick start","type":"heading","level":2,"anchor":"Macro-first-quick-start"},{"type":"codeListing","code":["import SwiftUI","import InnoRouter","","@Router","enum AppRoute {","    case detail(id: String)","    case settings","","    var destination: some View {","        switch self {","        case .detail(let id):","            Text(\"Detail \\(id)\")","        case .settings:","            Text(\"Settings\")","        }","    }","}","","struct AppRoot: View {","    var body: some View {","        RouterHost(AppRoute.self) {","            HomeView()","        }","    }","}","","struct HomeView: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    var body: some View {","        Button(\"Open settings\") {","            router.go(.settings)","        }","    }","}"],"syntax":"swift compile"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" supplies "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" through "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":", so do not add either"},{"type":"text","text":" "},{"type":"text","text":"conformance to "},{"type":"codeVoice","code":"AppRoute"},{"type":"text","text":". The "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" remains ordinary Swift and receives the"},{"type":"text","text":" "},{"type":"text","text":"compiler’s exhaustive-case checking."}]},{"text":"Advanced granular imports","type":"heading","level":2,"anchor":"Advanced-granular-imports"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import InnoRouter"},{"type":"text","text":" is the default application entry point. It re-exports the"},{"type":"text","text":" "},{"type":"text","text":"Core, SwiftUI, deep-link, and macro declarations together."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use granular products only when a target intentionally needs a narrower graph:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product and import"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Advanced use case"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterCore"}]}],[{"type":"paragraph","inlineContent":[{"text":"Typed route state and command execution without SwiftUI or a compiler-plugin target in this target’s build graph.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterSwiftUI"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Manually conformed routes, externally owned stores, hosts, and coordinators without a compiler-plugin target in this target’s build graph."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterDeepLink"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Deep-link matching and planning without the SwiftUI authority layer."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterMacros"}]}],[{"type":"paragraph","inlineContent":[{"text":"A feature target that wants macro declarations plus their Core, SwiftUI, and deep-link runtime requirements without the full umbrella target.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterSpatial"}]}],[{"type":"paragraph","inlineContent":[{"text":"visionOS windows, volumes, immersive spaces, and ornaments. This remains opt-in.","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"text":"Keeping the compiler-plugin target out of a consumer target’s build graph","type":"text"},{"type":"text","text":" "},{"text":"requires depending on granular runtime products instead of the ","type":"text"},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" "},{"type":"text","text":"umbrella. SwiftPM still resolves this package’s package-level "},{"type":"codeVoice","code":"swift-syntax"},{"type":"text","text":" "},{"type":"text","text":"dependency. Merely omitting a macro attribute from a file does not remove the"},{"text":" ","type":"text"},{"type":"text","text":"umbrella target’s macro dependency."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/innoroutermacros"]}],"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable"]},{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics"]}],"sections":[],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","kind":"symbol","type":"topic","url":"\/documentation\/innoroutertesting","role":"collection","title":"InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Router-Macro-First":{"abstract":[{"text":"Declare route data and destination views in one enum, then select the host that","type":"text"},{"text":" ","type":"text"},{"text":"matches the surface. Stack, modal, split, tab, and single-route deep-link","type":"text"},{"text":" ","type":"text"},{"text":"handling all keep the same ","type":"text"},{"type":"codeVoice","code":"@EnvironmentRouter"},{"text":" action API.","type":"text"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","kind":"article","type":"topic","url":"\/documentation\/innoroutermacros\/router-macro-first","role":"article","title":"Macro-first routing with `@Router`"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Guide-MacroVisibility":{"url":"\/documentation\/innoroutermacros\/guide-macrovisibility","role":"article","kind":"article","type":"topic","title":"Macro-generated access levels","abstract":[{"type":"text","text":"InnoRouter macros infer generated member visibility from the attached enum."},{"type":"text","text":" "},{"type":"text","text":"They do not widen an internal route into public API."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"url":"\/documentation\/innoroutermacros\/macro-diagnostics","role":"article","kind":"article","type":"topic","title":"Macro diagnostics","abstract":[{"type":"text","text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to"},{"type":"text","text":" "},{"type":"text","text":"find the recovery without depending on the compiler’s surrounding wording."},{"type":"text","text":" "},{"type":"text","text":"Errors prevent the macro from emitting an incomplete routing contract."},{"type":"text","text":" "},{"type":"text","text":"Warnings identify valid code whose generated behavior is likely surprising or"},{"type":"text","text":" "},{"type":"text","text":"whose explicit declarations are redundant."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Routable-and-CasePathable":{"url":"\/documentation\/innoroutermacros\/routable-and-casepathable","role":"article","kind":"article","type":"topic","title":"Routable and CasePathable","abstract":[{"text":"Use case-path macros when route code needs typed enum extraction in addition to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"InnoRouter’s macro-first destination routing."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable"}}}