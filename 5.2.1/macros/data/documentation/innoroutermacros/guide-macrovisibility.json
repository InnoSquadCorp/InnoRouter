{"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"`@Routable` and `@CasePathable`","anchor":"Routable-and-CasePathable","level":2},{"inlineContent":[{"type":"text","text":"For every "},{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":") enum the macros emit:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"enum Cases { … }","type":"codeVoice"},{"text":" containing one ","type":"text"},{"code":"static let","type":"codeVoice"},{"text":" per case.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"func is(_ casePath:) -> Bool","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"subscript(case:) -> Value?","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"The access keyword applied to "},{"type":"codeVoice","code":"Cases"},{"type":"text","text":", every case-path member, "},{"type":"codeVoice","code":"is(_:)"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"subscript(case:)"},{"type":"text","text":" is inferred from the enclosing enum:"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enum modifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated members"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"public enum Foo"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"public"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"package enum Foo"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"package"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"internal enum Foo"},{"type":"text","text":" (or no modifier)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"internal"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"fileprivate enum Foo"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"fileprivate"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"private enum Foo"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":" (the narrowest level that remains reachable across the macro expansion)"}]}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"Each case "},{"type":"codeVoice","code":"static let"},{"type":"text","text":" also receives any "},{"type":"codeVoice","code":"@available(...)"},{"type":"text","text":" attribute attached"},{"type":"text","text":" "},{"type":"text","text":"to the enum case, so a case gated on an OS version does not produce a"},{"type":"text","text":" "},{"type":"codeVoice","code":"CasePath"},{"type":"text","text":" member with wider availability than the underlying case."}],"type":"paragraph"},{"type":"heading","text":"`@Router`","anchor":"Router","level":2},{"inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" adds "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" to the developer-declared"},{"type":"text","text":" "},{"type":"text","text":"instance "},{"type":"codeVoice","code":"destination"},{"type":"text","text":" property. It does not change that property’s declared"},{"type":"text","text":" "},{"type":"text","text":"access level."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The generated "},{"type":"codeVoice","code":"static destination(for:)"},{"type":"text","text":" protocol witness follows the enum’s"},{"type":"text","text":" "},{"type":"text","text":"effective access level. This means a public router can keep the instance hook"},{"type":"text","text":" "},{"type":"text","text":"private while exposing only the witness required by "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["import SwiftUI","import InnoRouter","","@Router","public enum PublicRoute {","    case settings","","    private var destination: some View {","        Text(\"Settings\")","    }","}"],"syntax":"swift compile"},{"inlineContent":[{"type":"text","text":"For a "},{"type":"codeVoice","code":"private"},{"type":"text","text":" enum, the generated witness uses "},{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":", matching the"},{"type":"text","text":" "},{"type":"text","text":"case-path macros’ same-file fallback. Do not declare "},{"type":"codeVoice","code":": DestinationRoute"},{"type":"text","text":" "},{"type":"text","text":"yourself; "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" supplies the conformance and warns when the direct"},{"type":"text","text":" "},{"type":"text","text":"conformance is redundant."}],"type":"paragraph"},{"type":"heading","text":"Compatibility for pre-OSS snapshots","anchor":"Compatibility-for-pre-OSS-snapshots","level":2},{"inlineContent":[{"type":"text","text":"Before the 4.0.0 OSS release, internal macro snapshots always emitted"},{"type":"text","text":" "},{"type":"text","text":"case-path members as "},{"type":"codeVoice","code":"public"},{"type":"text","text":". Teams that tested those snapshots should check"},{"type":"text","text":" "},{"type":"text","text":"three patterns:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"Enum and CasePath usage already match.","type":"text"}],"type":"strong"},{"text":" No action is needed. Generated","type":"text"},{"text":" ","type":"text"},{"text":"members tighten to match the enum, and same-module consumer code keeps","type":"text"},{"text":" ","type":"text"},{"text":"compiling.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"A sibling module reads generated members from a non-public enum.","type":"text"}],"type":"strong"},{"text":" Mark","type":"text"},{"text":" ","type":"text"},{"text":"the enum ","type":"text"},{"code":"public","type":"codeVoice"},{"text":"; the old expansion was widening the surface implicitly.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Enum cases are gated on ","type":"text"},{"type":"codeVoice","code":"@available(...)"},{"text":".","type":"text"}],"type":"strong"},{"text":" Generated ","type":"text"},{"code":"CasePath","type":"codeVoice"},{"text":" members","type":"text"},{"text":" ","type":"text"},{"text":"now carry the same availability. Narrow the enclosing function or branch on","type":"text"},{"text":" ","type":"text"},{"code":"if #available(...)","type":"codeVoice"},{"text":" at any downstream call site that used a wider window.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","text":"Why `private` maps to `fileprivate`","anchor":"Why-private-maps-to-fileprivate","level":2},{"inlineContent":[{"type":"text","text":"Generated declarations can originate from distinct macro expansion roles."},{"type":"text","text":" "},{"type":"text","text":"Using "},{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":" preserves same-file access between those declarations while"},{"type":"text","text":" "},{"type":"text","text":"remaining narrower than module-wide "},{"type":"codeVoice","code":"internal"},{"type":"text","text":" visibility."}],"type":"paragraph"},{"type":"heading","text":"Manual visibility control","anchor":"Manual-visibility-control","level":2},{"inlineContent":[{"type":"text","text":"The macros do not expose a visibility override. Mark the enclosing enum"},{"type":"text","text":" "},{"type":"codeVoice","code":"public"},{"type":"text","text":" when its generated members must be public; otherwise generated members"},{"type":"text","text":" "},{"type":"text","text":"follow the declaration’s effective access level. If a generated surface is not"},{"type":"text","text":" "},{"type":"text","text":"appropriate, remove the macro and write the conformance or case-path members"},{"type":"text","text":" "},{"type":"text","text":"explicitly."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/guide-macrovisibility"]}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"article","title":"Macro-generated access levels","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"article","abstract":[{"type":"text","text":"InnoRouter macros infer generated member visibility from the attached enum."},{"type":"text","text":" "},{"type":"text","text":"They do not widen an internal route into public API."}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","abstract":[{"type":"text","text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path"},{"type":"text","text":" "},{"type":"text","text":"available for advanced composition."}],"type":"topic","url":"\/documentation\/innoroutermacros\/innoroutermacros","role":"collectionGroup","title":"InnoRouterMacros"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"abstract":[],"identifier":"doc:\/\/com.