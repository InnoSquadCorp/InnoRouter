wDeepLinkPipeline"},{"text":" to cap absolute URL length, path segment count,","type":"text"},{"text":" ","type":"text"},{"text":"and query item count. Direct matcher calls still return ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" because"},{"type":"text","text":" "},{"type":"text","text":"their public contract is optional. Pipeline and effect-handler paths"},{"type":"text","text":" "},{"type":"text","text":"surface limit violations as typed"},{"type":"text","text":" "},{"code":"DeepLinkRejectionReason.inputLimitExceeded","type":"codeVoice"},{"type":"text","text":" rejections instead of"},{"type":"text","text":" "},{"type":"text","text":"“no match” outcomes when the pipeline receives the matcher through its"},{"type":"text","text":" "},{"code":"matcher:","type":"codeVoice"},{"type":"text","text":" initializer. The "},{"code":"customResolver:","type":"codeVoice"},{"text":" escape hatch can surface only","type":"text"},{"text":" ","type":"text"},{"text":"the pipeline’s own limits because an optional resolver result does not carry","type":"text"},{"type":"text","text":" "},{"type":"text","text":"matcher-specific rejection information."}]}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","kind":"article","title":"InnoRouterDeepLink","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","role":"collectionGroup","abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter."}],"type":"topic"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","role":"collection","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","abstract":[],"type":"top