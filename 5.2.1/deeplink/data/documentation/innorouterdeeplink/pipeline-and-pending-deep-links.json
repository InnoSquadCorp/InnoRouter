{"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Pipeline-and-Pending-Deep-Links","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Construction","text":"Construction","level":2,"type":"heading"},{"inlineContent":[{"text":"Pass a matcher directly so matcher-specific input limits remain typed","type":"text"},{"text":" ","type":"text"},{"text":"rejections and the pipeline can reuse its parsed URL:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/products\/:id\") { parameters in","        parameters.firstValue(forName: \"id\").map { .product(id: $0) }","    }","}","","let pipeline = DeepLinkPipeline(","    originPolicy: .allowlisted(","        schemes: [\"myapp\"],","        hosts: [\"app.example.com\"]","    ),","    matcher: matcher",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For routing rules that need the complete raw URL rather than pattern"},{"type":"text","text":" "},{"type":"text","text":"matching, use the explicit escape hatch:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let pipeline = DeepLinkPipeline<AppRoute>(","    originPolicy: .allowlisted(","        schemes: [\"myapp\"],","        hosts: [\"app.example.com\"]","    ),","    customResolver: { url in legacyRouter.route(for: url) }",")"]},{"type":"paragraph","inlineContent":[{"text":"A custom resolver’s ","type":"text"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" result is "},{"code":".unhandled","type":"codeVoice"},{"type":"text","text":". Pipeline-level input limits"},{"type":"text","text":" "},{"type":"text","text":"still apply, but only the "},{"code":"matcher:","type":"codeVoice"},{"text":" path can preserve matcher-specific limit","type":"text"},{"type":"text","text":" "},{"text":"violations.","type":"text"}]},{"anchor":"Always-declare-an-origin-policy","level":3,"text":"Always declare an origin policy","type":"heading"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"DeepLinkOriginPolicy.allowlisted(schemes:hosts:)","type":"codeVoice"},{"text":" for every pipeline","type":"text"},{"text":" ","type":"text"},{"text":"that receives attacker-controllable URLs — custom URL schemes, universal","type":"text"},{"type":"text","text":" "},{"text":"links, notifications, QR or NFC payloads. Choose ","type":"text"},{"code":".trustedInProcess","type":"codeVoice"},{"text":" only","type":"text"},{"text":" ","type":"text"},{"text":"when every incoming URL is constructed by your own process. The older","type":"text"},{"type":"text","text":" "},{"text":"optional-allowlist initializer remains source-compatible, but an omitted","type":"text"},{"type":"text","text":" "},{"type":"text","text":"allowlist disables that admission check. The "},{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" macro path enforces"},{"type":"text","text":" "},{"type":"text","text":"an allowlist at compile time ("},{"type":"codeVoice","code":"E020"},{"type":"text","text":")."}],"type":"paragraph"},{"text":"Pipeline stages","level":2,"type":"heading","anchor":"Pipeline-stages"},{"inlineContent":[{"type":"text","text":"A pipeline can:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"reject a URL when configured input limits are exceeded","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"reject a URL by scheme or host"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"leave it unhandled"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"resolve it into a route"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"require authentication"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"convert the route into a "},{"type":"codeVoice","code":"NavigationPlan"}]}]}],"type":"unorderedList"},{"text":"Pending deep links","level":2,"type":"heading","anchor":"Pending-deep-links"},{"inlineContent":[{"text":"When authentication is required but not currently satisfied, the pipeline returns ","type":"text"},{"code":"DeepLinkDecision.pending(_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This is deliberate:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the route that triggered authentication deferral is preserved","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the navigation plan is preserved","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"replay responsibility remains explicit at the app boundary","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"That keeps auth transitions and navigation transitions separate instead of blending them into one hidden side effect."}],"type":"paragraph"},{"text":"Planning","anchor":"Planning","level":2,"type":"heading"},{"inlineContent":[{"text":"The planner converts a route into the exact command list that should run after acceptance. This makes deep-link execution deterministic and testable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Authentication checks the routes referenced by the produced"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":", including nested sequences and fallback commands."},{"type":"text","text":" "},{"type":"text","text":"If a custom planner returns no route-bearing commands, the pipeline"},{"type":"text","text":" "},{"type":"text","text":"falls back to the originally resolved route."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Effect handlers and coordinator bridges validate a produced"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":" against the current "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" before executing it."},{"type":"text","text":" "},{"type":"text","text":"Plans that are obviously impossible, such as "},{"code":".pop","type":"codeVoice"},{"type":"text","text":" on an empty stack,"},{"type":"text","text":" "},{"type":"text","text":"surface as typed application rejections instead of partially running."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterdeeplink\/pipeline-and-pending-deep-links"]}],"metadata":{"title":"Pipeline and pending deep links","roleHeading":"Article","role":"article","modules":[{"name":"InnoRouterTesting"}]},"abstract":[{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":" is where URL acceptance and app policy meet."}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","role":"collection","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","abstract":[],"type":"topic","kind":"symbol"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","kind":"article","title":"InnoRouterDeepLink","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","role":"collectionGroup","abstract":[{"type":"text","text":"Pattern matching, pipel