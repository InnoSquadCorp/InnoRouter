{"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Event-Stream-Backpressure","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"FlowStore"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":" "},{"text":"publishes an ","type":"text"},{"code":"events: AsyncStream","type":"codeVoice"},{"text":" that fans every observation event","type":"text"},{"text":" ","type":"text"},{"text":"out to every subscriber. The fan-out is implemented as a per-subscriber","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncStream.Continuation"},{"text":", which means a slow or cancelled subscriber","type":"text"},{"text":" ","type":"text"},{"text":"that never drains its stream would otherwise retain every event","type":"text"},{"type":"text","text":" "},{"text":"indefinitely — behaving as an unbounded leak when the broadcaster","type":"text"},{"type":"text","text":" "},{"text":"outlives all consumers.","type":"text"}]},{"inlineContent":[{"type":"text","text":"To bound that growth, every store uses an "},{"type":"codeVoice","code":"EventBufferingPolicy"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":", "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":", and "},{"type":"codeVoice","code":"FlowStore"},{"text":" expose the policy through","type":"text"},{"type":"text","text":" "},{"text":"their configurations. ","type":"text"},{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":" currently uses the default policy."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Each access to a store’s ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" property creates and synchronously registers","type":"text"},{"text":" ","type":"text"},{"text":"a new subscriber. Capture that stream before starting its lifecycle-owned task;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise a route mutation performed immediately after task creation can occur","type":"text"},{"text":" ","type":"text"},{"text":"before the task first evaluates ","type":"text"},{"type":"codeVoice","code":"store.events"},{"text":". Request a fresh stream for each","type":"text"},{"text":" ","type":"text"},{"text":"independent consumer.","type":"text"}]},{"type":"heading","anchor":"Default-policy","text":"Default policy","level":2},{"type":"paragraph","inlineContent":[{"text":"The default is ","type":"text"},{"code":"EventBufferingPolicy.default","type":"codeVoice"},{"text":", which is","type":"text"},{"text":" ","type":"text"},{"code":".bufferingNewest(1024)","type":"codeVoice"},{"type":"text","text":". The number is sized for realistic navigation"},{"text":" ","type":"text"},{"type":"text","text":"bursts (a few hundred events for the longest deep-link replay we have"},{"type":"text","text":" "},{"type":"text","text":"measured) while keeping the retained working set bounded so a stuck"},{"type":"text","text":" "},{"type":"text","text":"subscriber cannot balloon memory in production."}]},{"type":"heading","anchor":"Choosing-a-policy","text":"Choosing a policy","level":2},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Policy"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Behaviour"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When to use"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".bufferingNewest(N)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Retain at most "},{"type":"codeVoice","code":"N"},{"type":"text","text":" most-recently-broadcast events per subscriber, dropping older events when the buffer fills."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Production code that prefers loss-of-history over memory growth under contention. The default."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".bufferingOldest(N)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Retain at most "},{"type":"codeVoice","code":"N"},{"type":"text","text":" oldest-broadcast events per subscriber, dropping newer events when the buffer fills."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Audit pipelines that care about the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"first"}]},{"type":"text","text":" burst more than the latest tail (rare)."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".unbounded"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Buffer every event until the subscriber drains it."}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Test harnesses or short-lived subscribers where you control lifetime and require deterministic, lossless ordering."}],"type":"paragraph"}]]]},{"type":"heading","anchor":"Configuring-supported-stores","text":"Configuring supported stores","level":2},{"type":"paragraph","inlineContent":[{"text":"For Navigation, Modal, and Flow stores, the policy is set at construction","type":"text"},{"text":" ","type":"text"},{"text":"time via the store’s configuration:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let store = try NavigationStore<HomeRoute>(","    initialPath: [.list],","    configuration: NavigationStoreConfiguration(","        eventBufferingPolicy: .bufferingNewest(2048)","    )",")"]},{"type":"paragraph","inlineContent":[{"text":"Modal and Flow stores expose the same knob, with one policy per","type":"text"},{"text":" ","type":"text"},{"text":"published stream:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStoreConfiguration.eventBufferingPolicy"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ModalStoreConfiguration.eventBufferingPolicy"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowStoreConfiguration.eventBufferingPolicy"},{"type":"text","text":" for the flow-level"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore.events"},{"type":"text","text":" fan-out"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowStoreConfiguration.navigation.eventBufferingPolicy"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStoreConfiguration.modal.eventBufferingPolicy"},{"type":"text","text":" for the wrapped"},{"type":"text","text":" "},{"type":"text","text":"inner store streams"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SceneStore"},{"text":" does not currently expose a buffering configuration. Its events","type":"text"},{"text":" ","type":"text"},{"text":"stream always uses ","type":"text"},{"type":"codeVoice","code":"EventBufferingPolicy.default"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Drop-semantics-under-load","text":"Drop semantics under load","level":2},{"type":"paragraph","inlineContent":[{"text":"Under sustained backpressure, the store keeps emitting events. Whether","type":"text"},{"text":" ","type":"text"},{"text":"the event reaches a slow subscriber depends on the policy chosen for","type":"text"},{"text":" ","type":"text"},{"text":"that subscriber’s store:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".bufferingNewest(N)"},{"type":"text","text":": oldest events are dropped silently. The"},{"type":"text","text":" "},{"type":"text","text":"subscriber sees a contiguous tail of the most recent N events the"},{"type":"text","text":" "},{"type":"text","text":"store emitted."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".bufferingOldest(N)"},{"type":"text","text":": newer events are dropped silently after the"},{"type":"text","text":" "},{"type":"text","text":"buffer fills. The subscriber sees the first N events emitted after"},{"type":"text","text":" "},{"type":"text","text":"it started subscribing."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unbounded"},{"type":"text","text":": nothing is dropped, but the per-subscriber queue can"},{"type":"text","text":" "},{"type":"text","text":"grow without bound while the subscriber falls behind."}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Drops are not surfaced as an event. If your analytics pipeline must","type":"text"},{"text":" ","type":"text"},{"text":"distinguish “no event happened” from “an event was buffered out”, use","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".unbounded"},{"text":" for that subscriber and rely on your own pacing rather","type":"text"},{"text":" ","type":"text"},{"text":"than the broadcaster.","type":"text"}]},{"type":"heading","anchor":"Lifetime-contract","text":"Lifetime contract","level":2},{"type":"paragraph","inlineContent":[{"text":"Each subscriber owns one ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":". When the subscriber’s","type":"text"},{"text":" ","type":"text"},{"text":"iterator goes out of scope, ","type":"text"},{"type":"codeVoice","code":"AsyncStream.Continuation.onTermination"},{"text":" ","type":"text"},{"text":"fires and the broadcaster removes that slot from its private","type":"text"},{"text":" ","type":"text"},{"text":"continuation storage. When a store releases its broadcaster, that","type":"text"},{"text":" ","type":"text"},{"text":"storage deinitializes, snapshots any outstanding continuations, and","type":"text"},{"text":" ","type":"text"},{"text":"finishes them outside the broadcaster’s actor-isolated deinitializer.","type":"text"},{"text":" ","type":"text"},{"text":"Cancelling the consumer task also terminates the subscription. Tie that task to","type":"text"},{"text":" ","type":"text"},{"text":"the owning feature or scene; ","type":"text"},{"type":"codeVoice","code":"for await"},{"text":" loops additionally terminate naturally","type":"text"},{"text":" ","type":"text"},{"text":"when their store is released.","type":"text"}]},{"type":"heading","anchor":"Related","text":"Related","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Rejection-Reasons"}]}]}]}],"kind":"content"}],"metadata":{"roleHeading":"Article","title":"Event Stream Backpressure","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/innoroutercore\/event-stream-backpressure"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"How the ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" stream of every store handles slow or stuck subscribers.","type":"text"}],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Middleware-and-Cancellation":{"title":"Middleware and cancellation","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","role":"article","url":"\/documentation\/innoroutercore\/middleware-and-cancellation","kind":"article","type":"topic","abstract":[{"type":"text","text":"Middleware is the cross-cutting policy layer for navigation execution."}]},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","role":"collectionGroup","url":"\/documentation\/innoroutercore\/innoroutercore","kind":"article","type":"topic","abstract":[{"type":"text","text":"State, command, result, and execution primitives for InnoRouter."}]},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","abstract":[],"title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","kind":"symbol","role":"collection","type":"topic"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Rejection-Reasons":{"title":"Rejection Reasons catalog","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Rejection-Reasons","role":"article","url":"\/documentation\/innoroutercore\/rejection-reasons","kind":"article","type":"topic","abstract":[{"type":"text","text":"One-stop reference for every rejection \/ cancellation \/ failure"},{"type":"text","text":" "},{"type":"text","text":"taxonomy in the InnoRouter stack — when each case fires, where it"},{"type":"text","text":" "},{"type":"text","text":"originates, and how to handle it."}]}}}