 "},{"type":"text","text":"cases arrive alongside successful transitions. A single analytics"},{"type":"text","text":" "},{"type":"text","text":"listener can cover the full surface. Capture each stream before starting its"},{"type":"text","text":" "},{"type":"text","text":"lifecycle-owned task so every subscriber is registered synchronously:"}]},{"code":["let navigationResult = navigationStore.execute(.push(.profile))","if case .cancelled(let reason) = navigationResult {","    analytics.record(\"nav-cancel\", reason: reason)","}","let modalEvents = modalStore.events","let modalObservationTask = Task { @MainActor in","    for await event in modalEvents {","        if case .commandIntercepted(_, .cancelled(let reason)) = event {","            analytics.record(\"modal-cancel\", reason: reason)","        }","    }","}","let flowEvents = flowStore.events","let flowObservationTask = Task { @MainActor in","    for await event in flowEvents {","        if case .intentRejected(_, let reason) = event {","            analytics.record(\"flow-reject\", reason: reason)","        }","    }","}","#if os(visionOS)","let sceneEvents = sceneStore.events","let sceneObservationTask = Task { @MainActor in","    for await event in sceneEvents {","        if case .rejected(let intent, let reason) = event {","            analytics.record(\"scene-reject-\\(intent)\", reason: reason)","        } else if case .hostRegistrationRejected(let reason) = event {","            analytics.record(\"scene-host-reject\", reason: reason)","        }","    }","}","#endif"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Deep-link outcomes surface through "},{"type":"codeVoice","code":"DeepLinkEffectHandler.handle(_:)"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"text","text":"return value rather than a stream, so wrap the call at the"},{"type":"text","text":" "},{"type":"text","text":"scene-phase boundary:"}]},{"code":["let outcome = deepLinkHandler.handle(url)","switch outcome {","case .executed, .pending, .noPendingDeepLink:","    break","case .executionFailed(_, let batch):","    analytics.record(\"deeplink-execution-failed\", results: batch.results)","case .applicationRejected(_, let failure):","    analytics.record(\"deeplink-application-rejected\", result: failure.result)","case .rejected(let reason):","    analytics.record(\"deeplink-reject\", reason: reason)","case .unhandled(let url):","    analytics.record(\"deeplink-unhandled\", url: url)","case .invalidURL(let input):","    analytics.record(\"deeplink-invalid-url\", input: input)","case .missingDeepLinkURL:","    analytics.record(\"deeplink-missing-url\")","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"text":"Related","type":"heading","anchor":"Related","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics","type":"reference","isActive":true}],"type":"paragraph"}]}]}],"kind":"content"}],"metadata":{"role":"article","roleHeading":"Article","title":"Rejection Reasons catalog","modules":[{"name":"InnoRouterTesting"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/innoroutercore\/rejection-reasons"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"One-stop reference for every rejection \/ cancellation \/ failure","type":"text"},{"text":" ","type":"text"},{"text":"taxonomy in the InnoRouter stack — when each case fires, where it","type":"text"},{"text":" ","type":"text"},{"text":"originates, and how to handle it.","type":"text"}],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","role":"collectionGroup","url":"\/documentation\/innoroutercore\/innoroutercore","kind":"article","type":"topic","abstract":[{"type":"text","text":"State, command, result, and execution primitives for InnoRouter."}]},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Command-Batch-and-Transaction-Semantics":{"url":"\/documentation\/innoroutercore\/command-batch-and-transaction-semantics","abstract":[{"text":"InnoRouter exposes three different execution semantics on purpose.","type":"text"}],"title":"Command, batch, and transaction semantics","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics","kind":"article","role":"article","type":"topic"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Middleware-and-Cancellation":{"title":"Middleware and cancellation","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","role":"article","url":"\/documentation\/innoroutercore\/middleware-and-cancellation","kind":"article","type":"topic","abstract":[{"type":"text","text":"Middleware is the cross-cutting policy layer for navigation execution."}]},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","abstract":[],"title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","kind":"symbol","role":"collection","type":"topic"}}}