{"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"primaryContentSections":[{"content":[{"text":"Single-command execution","type":"heading","anchor":"Single-command-execution","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationCommand"},{"type":"text","text":" models one navigation transition or a recursive command composition."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Important cases:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":".push","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".pushAll","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".pop","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".popCount","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".popToRoot","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".popTo","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".replace","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".sequence","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".whenCancelled","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationEngine"},{"type":"text","text":" executes these commands against a "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":"."}]},{"text":"Sequence semantics","type":"heading","anchor":"Sequence-semantics","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sequence"},{"type":"text","text":" is command algebra, not a transaction."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That means:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"commands execute left-to-right"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"earlier successful steps stay applied even if a later step fails"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"later steps still run unless the sequence itself has no more elements"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the final result is "},{"code":"NavigationResult.multiple(_:)","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".sequence"},{"type":"text","text":" when partial success is acceptable and the command stream itself is the point."}]},{"text":"Fallback semantics","type":"heading","anchor":"Fallback-semantics","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".whenCancelled(primary, fallback:)"},{"type":"text","text":" is choice composition with an internal"},{"type":"text","text":" "},{"type":"text","text":"savepoint."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That means:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"primary","type":"codeVoice"},{"type":"text","text":" runs first against a shadow copy of the starting state"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"if "},{"code":"primary","type":"codeVoice"},{"type":"text","text":" succeeds, only its final state commits"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"if "},{"code":"primary","type":"codeVoice"},{"type":"text","text":" reports anything other than success, its shadow is discarded and "},{"code":"fallback","type":"codeVoice"},{"type":"text","text":" starts from the same snapshot"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"if "},{"code":"fallback","type":"codeVoice"},{"type":"text","text":" succeeds, only its final state commits"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"if both legs fail, both shadows are discarded, the starting "},{"code":"RouteStack","type":"codeVoice"},{"type":"text","text":" remains unchanged, and the fallback failure is returned"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" routes each attempted leg recursively through middleware; direct "},{"code":"NavigationEngine","type":"codeVoice"},{"type":"text","text":" execution has no middleware"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"single-command execution only emits the successful leg’s committed state change"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"transaction execution keeps public middleware observation commit-only, while discarded preview legs run internal cleanup"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For direct and batch store execution, the folded "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" result decides"},{"type":"text","text":" "},{"type":"text","text":"whether a leg succeeded. Transaction execution must choose and commit from its"},{"type":"text","text":" "},{"type":"text","text":"preview result so "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" stays commit-only; a post-commit fold changes the"},{"type":"text","text":" "},{"type":"text","text":"reported result but cannot reopen fallback selection or undo the commit."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"executedCommands"},{"type":"text","text":" is an attempt log, not a commit log. It records effective"},{"type":"text","text":" "},{"type":"text","text":"commands passed to the engine, including attempts later discarded by either"},{"type":"text","text":" "},{"type":"text","text":"savepoint or transaction rollback; middleware interceptions cancelled before"},{"type":"text","text":" "},{"type":"text","text":"the engine are not included. The savepoint protects "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" authority, not"},{"type":"text","text":" "},{"type":"text","text":"arbitrary side effects performed by attempt-level middleware callbacks."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".whenCancelled"},{"type":"text","text":" when rollback-to-fallback semantics belong to one logical command."}]},{"text":"Batch semantics","type":"heading","anchor":"Batch-semantics","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationBatchExecutor.executeBatch(_:stopOnFailure:)"},{"type":"text","text":" is for observation batching."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Batch execution still runs commands one step at a time, but it lets higher layers coalesce observation:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"step middleware still runs"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"stopOnFailure: false","type":"codeVoice"},{"type":"text","text":" keeps later commands running after a failure"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"stopOnFailure: true","type":"codeVoice"},{"type":"text","text":" stops the batch after the first failed step"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the store emits aggregated "},{"code":".changed","type":"codeVoice"},{"type":"text","text":" and "},{"code":".batchExecuted","type":"codeVoice"},{"type":"text","text":" cases"},{"type":"text","text":" "},{"type":"text","text":"through "},{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" and "},{"code":"events","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the caller gets a structured "},{"code":"NavigationBatchResult","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use batch execution when the caller wants one “transition event” while still preserving per-step execution."}]},{"text":"Transaction semantics","type":"heading","anchor":"Transaction-semantics","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTransactionExecutor.executeTransaction(_:)"},{"type":"text","text":" is the atomic option."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transactions:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"reject an empty command list as uncommitted, with no failure index because no step ran"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"preview commands on a shadow stack"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"abort on the first failure or cancellation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"leave the real state unchanged on failure"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"commit the final state all at once on success"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"surface public "},{"code":"didExecute","type":"codeVoice"},{"type":"text","text":" \/ transaction observation only for committed leaves"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"run internal discard cleanup for previewed leaves that never commit"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use transactions when all-or-nothing semantics are required."}]},{"text":"Typed failures","type":"heading","anchor":"Typed-failures","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Core legality failures stay in typed results instead of exceptions:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"NavigationResult.emptyStack","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NavigationResult.invalidPopCount(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NavigationResult.insufficientStackDepth(requested:available:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NavigationResult.routeNotFound(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NavigationResult.cancelled(_:)","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps navigation failure in normal control flow and makes policy handling easy to pattern-match."}]}],"kind":"content"}],"metadata":{"role":"article","roleHeading":"Article","title":"Command, batch, and transaction semantics","modules":[{"name":"InnoRouterTesting"}]},"schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"kind":"article","variants":[{"paths":["\/documentation\/innoroutercore\/command-batch-and-transaction-semantics"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"InnoRouter exposes three different execution semantics on purpose.","type":"text"}],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","role":"collectionGroup","url":"\/documentation\/innoroutercore\/innoroutercore","kind":"article","type":"topic","abstract":[{"type":"text","text":"State, command, result, and execution primitives for InnoRouter."}]},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","abstract":[],"title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","kind":"symbol","role":"collection","type":"topic"}}}