 directly:"}]},{"type":"codeListing","syntax":"swift compile","code":["import SwiftUI","import InnoRouterSwiftUI","","enum ManualRoute: DestinationRoute {","    case settings","","    @MainActor","    @ViewBuilder","    static func destination(for route: Self) -> some View {","        switch route {","        case .settings:","            Text(\"Settings\")","        }","    }","}"]},{"inlineContent":[{"text":"This path keeps the same ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"EnvironmentRouter","type":"codeVoice"},{"text":" runtime","type":"text"},{"text":" ","type":"text"},{"text":"semantics; only the generated declaration work becomes explicit.","type":"text"}],"type":"paragraph"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First"},"metadata":{"roleHeading":"Article","title":"Macro-first routing with `@Router`","role":"article","modules":[{"name":"InnoRouterTesting"}]},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/router-macro-first"]}],"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Declare route data and destination views in one enum, then select the host that"},{"type":"text","text":" "},{"type":"text","text":"matches the surface. Stack, modal, split, tab, and single-route deep-link"},{"type":"text","text":" "},{"type":"text","text":"handling all keep the same "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" action API."}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","title":"InnoRouterMacros","url":"\/documentation\/innoroutermacros\/innoroutermacros","type":"topic","kind":"article","role":"co