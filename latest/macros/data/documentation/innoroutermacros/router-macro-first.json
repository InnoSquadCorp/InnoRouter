{"kind":"article","identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"Declare route data and destination views in one enum, then select the host that"},{"type":"text","text":" "},{"type":"text","text":"matches the surface. Stack, modal, split, tab, and single-route deep-link"},{"type":"text","text":" "},{"type":"text","text":"handling all keep the same "},{"code":"@EnvironmentRouter","type":"codeVoice"},{"type":"text","text":" action API."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/router-macro-first"]}],"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"title":"Macro-first routing with `@Router`","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"anchor":"Declare-a-router","type":"heading","level":2,"text":"Declare a router"},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" product and use the canonical imports:"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" to an enum with at least one route case and one get-only"},{"type":"text","text":" "},{"type":"text","text":"instance computed property whose exact declaration shape is"},{"type":"text","text":" "},{"type":"codeVoice","code":"var destination: some View"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","enum LibraryRoute {","    case book(id: String)","    case account","","    var destination: some View {","        switch self {","        case .book(let id):","            Text(\"Book \\(id)\")","        case .account:","            Text(\"Account\")","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Do not add "},{"type":"codeVoice","code":": Route"},{"type":"text","text":" or "},{"type":"codeVoice","code":": DestinationRoute"},{"type":"text","text":". "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" supplies"},{"type":"text","text":" "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":", which already refines "},{"type":"codeVoice","code":"Route"},{"type":"text","text":", "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"What-the-macro-generates","type":"heading","level":2,"text":"What the macro generates"},{"inlineContent":[{"type":"text","text":"When the "},{"type":"codeVoice","code":"destination"},{"type":"text","text":" property is valid, "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" adds "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" unless they are already present. It also emits the equivalent of:"}],"type":"paragraph"},{"syntax":"swift skip generated expansion","code":["extension LibraryRoute: InnoRouterSwiftUI.DestinationRoute {","    @Swift.MainActor","    @SwiftUI.ViewBuilder","    static func destination(for route: Self) -> some SwiftUI.View {","        route.destination","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The generated witness follows the enum’s effective access level. A public"},{"type":"text","text":" "},{"type":"text","text":"route can therefore keep its instance "},{"type":"codeVoice","code":"destination"},{"type":"text","text":" hook private while the"},{"type":"text","text":" "},{"type":"text","text":"protocol witness remains public."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" does not generate case paths. When a macro-first router also needs"},{"type":"text","text":" "},{"type":"text","text":"typed case extraction, compose it with "},{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","@CasePathable","enum SearchRoute {","    case result(id: String)","","    var destination: some View {","        Text(\"Result\")","    }","}","","let route = SearchRoute.result(id: \"42\")","route[case: SearchRoute.Cases.result]  \/\/ Optional(\"42\")"],"type":"codeListing"},{"anchor":"Choose-a-host","type":"heading","level":2,"text":"Choose a host"},{"inlineContent":[{"type":"text","text":"The host owns local state. Start with the narrowest host that covers the"},{"type":"text","text":" "},{"type":"text","text":"feature:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Surface","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Macro-first host","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Common actions from ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Stack plus modal","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"RouterHost","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"go","type":"codeVoice"},{"text":", ","type":"text"},{"code":"back","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":", ","type":"text"},{"code":"cover","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dismiss","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Modal only","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"RouterModalHost","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"sheet","type":"codeVoice"},{"text":", ","type":"text"},{"code":"cover","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dismiss","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Split detail stack plus modal","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"RouterSplitHost","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"go","type":"codeVoice"},{"text":", ","type":"text"},{"code":"back","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":", ","type":"text"},{"code":"cover","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dismiss","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Native tabs","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"RouterTabHost","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"select","type":"codeVoice"},{"text":", ","type":"text"},{"code":"setBadge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"clearBadge","type":"codeVoice"}]}]]]},{"inlineContent":[{"type":"text","text":"Promote state to a "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", or"},{"type":"text","text":" "},{"code":"TabCoordinator","type":"codeVoice"},{"text":" only when another application boundary must restore, observe,","type":"text"},{"text":" ","type":"text"},{"text":"or mutate that authority directly.","type":"text"}],"type":"paragraph"},{"anchor":"Stack-and-modal-routing","type":"heading","level":2,"text":"Stack and modal routing"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" for the common stack-plus-modal surface:"}],"type":"paragraph"},{"syntax":"swift skip surrounding view declaration","code":["RouterHost(LibraryRoute.self) {","    LibraryHomeView()","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Descendants read typed actions from "},{"type":"codeVoice","code":"EnvironmentRouter"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip surrounding view declaration","code":["@EnvironmentRouter(LibraryRoute.self) private var router","","Button(\"Account\") {","    router.go(.account)","}","","Button(\"Account sheet\") {","    router.sheet(.account)","}"]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":" when the feature must not expose stack actions:","type":"text"}]},{"type":"codeListing","syntax":"swift skip surrounding view declaration","code":["RouterModalHost(LibraryRoute.self) {","    LibraryHomeView()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Calling an action unsupported by the nearest host, such as "},{"code":"go","type":"codeVoice"},{"text":" below a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"modal-only host, follows "},{"type":"codeVoice","code":"EnvironmentMissingPolicy"},{"type":"text","text":" and fails loudly by"},{"type":"text","text":" "},{"type":"text","text":"default."}]},{"anchor":"Split-routing","type":"heading","text":"Split routing","level":2},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"text":" for a sidebar with a locally owned detail stack and modal","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"authority:"}],"type":"paragraph"},{"syntax":"swift skip surrounding view declaration","code":["RouterSplitHost(LibraryRoute.self) {","    LibrarySidebar()","} root: {","    ContentUnavailableView(\"Select a book\", systemImage: \"books.vertical\")","}"],"type":"codeListing"},{"inlineContent":[{"text":"Sidebar selection and column visibility remain application and system state;","type":"text"},{"type":"text","text":" "},{"type":"text","text":"routes pushed from descendants appear in the detail column. "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" "},{"type":"text","text":"is unavailable on watchOS, where the compiler directs callers to "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Native-tabs","type":"heading","level":2,"text":"Native tabs"},{"inlineContent":[{"type":"text","text":"Mark every parameterless case with "},{"type":"codeVoice","code":"@TabItem"},{"type":"text","text":". "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" then supplies"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTab"},{"type":"text","text":", "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":", and the metadata consumed by "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","enum AppTab {","    @TabItem(\"Home\", systemImage: \"house\")","    case home","","    @TabItem(\"Account\", systemImage: \"person\")","    case account","","    var destination: some View {","        switch self {","        case .home:","            Text(\"Home\")","        case .account:","            Text(\"Account\")","        }","    }","}","","struct AppTabs: View {","    var body: some View {","        RouterTabHost(AppTab.self, initial: .home)","    }","}","","struct AccountShortcut: View {","    @EnvironmentRouter(AppTab.self) private var router","","    var body: some View {","        Button(\"Account\") {","            router.select(.account)","            router.setBadge(1, for: .account)","        }","    }","}"],"type":"codeListing"},{"anchor":"Automatic-single-route-deep-links","type":"heading","level":2,"text":"Automatic single-route deep links"},{"inlineContent":[{"type":"text","text":"Give "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" literal origin allowlists and attach "},{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" to the cases"},{"type":"text","text":" "},{"type":"text","text":"that accept URLs:"}],"type":"paragraph"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router(","    deepLinkSchemes: [\"myapp\", \"https\"],","    deepLinkHosts: [\"app.example.com\"]",")","enum DeepLinkRoute {","    @DeepLink(\"\/books\/:id\")","    case book(id: String)","","    case account","","    var destination: some View {","        switch self {","        case .book(let id):","            Text(\"Book \\(id)\")","        case .account:","            Text(\"Account\")","        }","    }","}","","struct DeepLinkRoot: View {","    var body: some View {","        RouterHost(DeepLinkRoute.self) {","            Text(\"Library\")","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"onOpenURL"},{"type":"text","text":" or parser is needed for this single-route path:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" pushes the resolved route."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" pushes it into the detail stack."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":" selects the resolved tab."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Origin allowlists fail closed. Generated matching prefers literal paths, then"},{"type":"text","text":" "},{"type":"text","text":"typed parameters, then terminal wildcards. Authentication, pending replay,"},{"type":"text","text":" "},{"type":"text","text":"multi-step plans, modal presentation style, and multi-window scene selection"},{"type":"text","text":" "},{"type":"text","text":"remain application-boundary concerns; use the deep-link pipeline and an"},{"type":"text","text":" "},{"type":"text","text":"externally owned store for those advanced policies."}],"type":"paragraph"},{"anchor":"Diagnostics","type":"heading","level":2,"text":"Diagnostics"},{"inlineContent":[{"type":"text","text":"The macros reject invalid declaration shapes before emitting a partial"},{"type":"text","text":" "},{"type":"text","text":"conformance. Diagnostic codes are stable and grouped by surface:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"E001"},{"type":"text","text":"–"},{"type":"codeVoice","code":"E006"},{"type":"text","text":", "},{"type":"codeVoice","code":"W001"},{"type":"text","text":"–"},{"type":"codeVoice","code":"W003"},{"type":"text","text":": enum and destination declarations"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"E007"},{"type":"text","text":"–"},{"type":"codeVoice","code":"E016"},{"type":"text","text":", "},{"type":"codeVoice","code":"W004"},{"type":"text","text":"–"},{"type":"codeVoice","code":"W005"},{"type":"text","text":": tabs"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"E017"},{"type":"text","text":"–"},{"type":"codeVoice","code":"E029"},{"type":"text","text":", "},{"type":"codeVoice","code":"W006"},{"type":"text","text":"–"},{"type":"codeVoice","code":"W007"},{"type":"text","text":", "},{"type":"codeVoice","code":"W012"},{"type":"text","text":": deep links"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"E030"},{"type":"text","text":"–"},{"type":"codeVoice","code":"E049"},{"type":"text","text":", "},{"type":"codeVoice","code":"W008"},{"type":"text","text":"–"},{"type":"codeVoice","code":"W011"},{"type":"text","text":": opt-in spatial scenes"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"See "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","isActive":true,"type":"reference"},{"type":"text","text":" for the complete code-to-recovery catalog."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The Swift type checker remains responsible for view initializer arguments,"},{"type":"text","text":" "},{"type":"text","text":"exhaustive switching, and "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" payload requirements. A"},{"type":"text","text":" "},{"type":"text","text":"constrained generic router is supported when its payload meets those route"},{"type":"text","text":" "},{"type":"text","text":"requirements:"}],"type":"paragraph"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","enum DetailRoute<Value: Hashable & Sendable> {","    case detail(Value)","","    var destination: some View {","        Text(\"Detail\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The macro cannot prove that a view is mounted below a matching host or that the"},{"type":"text","text":" "},{"type":"text","text":"host publishes the action being invoked because SwiftUI’s environment"},{"type":"text","text":" "},{"type":"text","text":"hierarchy is built at runtime. "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" therefore diagnoses a"},{"type":"text","text":" "},{"type":"text","text":"missing host, mismatched route type, or unavailable capability at action time."}],"type":"paragraph"},{"anchor":"Manual-escape-hatch","type":"heading","level":2,"text":"Manual escape hatch"},{"inlineContent":[{"type":"text","text":"Advanced targets can keep the compiler-plugin target out of their build graph"},{"type":"text","text":" "},{"type":"text","text":"by depending on the granular "},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":" product and writing the"},{"type":"text","text":" "},{"type":"text","text":"conformance directly:"}],"type":"paragraph"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouterSwiftUI","","enum ManualRoute: DestinationRoute {","    case settings","","    @MainActor","    @ViewBuilder","    static func destination(for route: Self) -> some View {","        switch route {","        case .settings:","            Text(\"Settings\")","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"This path keeps the same "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" and "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" runtime"},{"type":"text","text":" "},{"type":"text","text":"semantics; only the generated declaration work becomes explicit."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"type":"topic","title":"Macro diagnostics","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","abstract":[{"type":"text","text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to"},{"type":"text","text":" "},{"type":"text","text":"find the recovery without depending on the compiler’s surrounding wording."},{"type":"text","text":" "},{"type":"text","text":"Errors prevent the macro from emitting an incomplete routing contract."},{"type":"text","text":" "},{"type":"text","text":"Warnings identify valid code whose generated behavior is likely surprising or"},{"type":"text","text":" "},{"type":"text","text":"whose explicit declarations are redundant."}],"url":"\/documentation\/innoroutermacros\/macro-diagnostics","kind":"article","role":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"kind":"s