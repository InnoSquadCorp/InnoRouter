aration","code":["RouterModalHost(LibraryRoute.self) {","    LibraryHomeView()","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Generated "},{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" routes present as sheets automatically in this host. Pass"},{"type":"text","text":" "},{"code":"deepLinkStyle: .fullScreenCover","type":"codeVoice"},{"type":"text","text":" when the entire modal-only feature uses cover"},{"type":"text","text":" "},{"text":"presentation for incoming URLs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Calling an action unsupported by the nearest host, such as "},{"type":"codeVoice","code":"go"},{"type":"text","text":" below a"},{"type":"text","text":" "},{"type":"text","text":"modal-only host, follows "},{"type":"codeVoice","code":"EnvironmentMissingPolicy"},{"type":"text","text":" and fails loudly by"},{"type":"text","text":" "},{"type":"text","text":"default."}],"type":"paragraph"},{"level":2,"text":"Split routing","type":"heading","anchor":"Split-routing"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"RouterSplitHost","type":"codeVoice"},{"type":"text","text":" for a sidebar with a locally owned detail stack and modal"},{"text":" ","type":"text"},{"text":"authority:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip surrounding view declaration","type":"codeListing","code":["RouterSplitHost(LibraryRoute.self) {","    LibrarySidebar()","} root: {","    ContentUnavailableView(\"Select a book\", systemImage: \"books.vertical\")","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Sidebar selection and column visibility remain application and system state;"},{"text":" ","type":"text"},{"text":"routes pushed from descendants appear in the detail column. ","type":"text"},{"type":"codeVoice","code":"RouterSplitHost"},{"text":" ","type":"text"},{"text":"is unavailable on watchOS, where the compiler directs callers to ","type":"text"},{"type":"codeVoice","