{"primaryContentSections":[{"kind":"content","content":[{"text":"Declare a router","anchor":"Declare-a-router","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" product and use the canonical imports:"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" to an enum with at least one route case and one get-only"},{"type":"text","text":" "},{"type":"text","text":"instance computed property whose exact declaration shape is"},{"type":"text","text":" "},{"type":"codeVoice","code":"var destination: some View"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import SwiftUI","import InnoRouter","","@Router","enum LibraryRoute {","    case book(id: String)","    case account","","    var destination: some View {","        switch self {","        case .book(let id):","            Text(\"Book \\(id)\")","        case .account:","            Text(\"Account\")","        }","    }","}"],"syntax":"swift compile","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Do not add "},{"type":"codeVoice","code":": Route"},{"type":"text","text":" or "},{"type":"codeVoice","code":": DestinationRoute"},{"type":"text","text":". "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" supplies"},{"type":"text","text":" "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":", which already refines "},{"type":"codeVoice","code":"Route"},{"type":"text","text":", "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":", and "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"What the macro generates","anchor":"What-the-macro-generates","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"When the "},{"type":"codeVoice","code":"destination"},{"type":"text","text":" property is valid, "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" adds "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" unless they are already present. It also emits the equivalent of:"}],"type":"paragraph"},{"code":["extension LibraryRoute: InnoRouterSwiftUI.DestinationRoute {","    @Swift.MainActor","    @SwiftUI.ViewBuilder","    static func destination(for route: Self) -> some SwiftUI.View {","        route.destination","    }","}"],"syntax":"swift skip generated expansion","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The generated witness follows the enum’s effective access level. A public"},{"type":"text","text":" "},{"type":"text","text":"route can therefore keep its instance "},{"type":"codeVoice","code":"destination"},{"type":"text","text":" hook private while the"},{"type":"text","text":" "},{"type":"text","text":"protocol witness remains public."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" does not generate case paths. When a macro-first router also needs"},{"type":"text","text":" "},{"type":"text","text":"typed case extraction, compose it with "},{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import SwiftUI","import InnoRouter","","@Router","@CasePathable","enum SearchRoute {","    case result(id: String)","","    var destination: some View {","        Text(\"Result\")","    }","}","","let route = SearchRoute.result(id: \"42\")","route[case: SearchRoute.Cases.result]  \/\/ Optional(\"42\")"],"syntax":"swift compile","type":"codeListing"},{"text":"Choose a host","anchor":"Choose-a-host","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The host owns local state. Start with the narrowest host that covers the"},{"type":"text","text":" "},{"type":"text","text":"feature:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Surface","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Macro-first host","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Common actions from ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Stack plus modal","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"RouterHost","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"go"},{"type":"text","text":", "},{"type":"codeVoice","code":"back"},{"type":"text","text":", "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":", "},{"type":"codeVoice","code":"cover"},{"type":"text","text":", "},{"type":"codeVoice","code":"dismiss"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Modal only"}]}],[{"type":"paragraph","inlineContent":[{"code":"RouterModalHost","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"sheet"},{"type":"text","text":", "},{"type":"codeVoice","code":"cover"},{"type":"text","text":", "},{"type":"codeVoice","code":"dismiss"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Split detail stack plus modal"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterSplitHost"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"go"},{"type":"text","text":", "},{"type":"codeVoice","code":"back"},{"type":"text","text":", "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":", "},{"type":"codeVoice","code":"cover"},{"type":"text","text":", "},{"type":"codeVoice","code":"dismiss"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Native tabs"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterTabHost"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"select"},{"type":"text","text":", "},{"type":"codeVoice","code":"setBadge"},{"type":"text","text":", "},{"type":"codeVoice","code":"clearBadge"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"Promote state to a "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"codeVoice","code":"TabCoordinator"},{"type":"text","text":" only when another application boundary must restore, observe,"},{"type":"text","text":" "},{"type":"text","text":"or mutate that authority directly."}],"type":"paragraph"},{"text":"Stack and modal routing","anchor":"Stack-and-modal-routing","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" for the common stack-plus-modal surface:"}],"type":"paragraph"},{"code":["RouterHost(LibraryRoute.self) {","    LibraryHomeView()","}"],"syntax":"swift skip surrounding view declaration","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Descendants read typed actions from "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@EnvironmentRouter(LibraryRoute.self) private var router","","Button(\"Account\") {","    router.go(.account)","}","","Button(\"Account sheet\") {","    router.sheet(.account)","}"],"syntax":"swift skip surrounding view declaration","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":" when the feature must not expose stack actions:"}],"type":"paragraph"},{"code":["RouterModalHost(LibraryRoute.self) {","    LibraryHomeView()","}"],"syntax":"swift skip surrounding view declaration","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Calling an action unsupported by the nearest host, such as "},{"type":"codeVoice","code":"go"},{"type":"text","text":" below a"},{"type":"text","text":" "},{"type":"text","text":"modal-only host, follows "},{"type":"codeVoice","code":"EnvironmentMissingPolicy"},{"type":"text","text":" and fails loudly by"},{"type":"text","text":" "},{"type":"text","text":"default."}],"type":"paragraph"},{"text":"Split routing","anchor":"Split-routing","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" for a sidebar with a locally owned detail stack and modal"},{"type":"text","text":" "},{"type":"text","text":"authority:"}],"type":"paragraph"},{"code":["RouterSplitHost(LibraryRoute.self) {","    LibrarySidebar()","} root: {","    ContentUnavailableView(\"Select a book\", systemImage: \"books.vertical\")","}"],"syntax":"swift skip surrounding view declaration","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Sidebar selection and column visibility remain application and system state;"},{"type":"text","text":" "},{"type":"text","text":"routes pushed from descendants appear in the detail column. "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" "},{"type":"text","text":"is unavailable on watchOS, where the compiler directs callers to "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Native tabs","anchor":"Native-tabs","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Mark every parameterless case with "},{"type":"codeVoice","code":"@TabItem"},{"type":"text","text":". "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" then supplies"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTab"},{"type":"text","text":", "},{"type":"codeVoice","code":"CaseIterable"},{"type":"text","text":", and the metadata consumed by "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["import SwiftUI","import InnoRouter","","@Router","enum AppTab {","    @TabItem(\"Home\", systemImage: \"house\")","    case home","","    @TabItem(\"Account\", systemImage: \"person\")","    case account","","    var destination: some View {","        switch self {","        case .home:","            Text(\"Home\")","        case .account:","            Text(\"Account\")","        }","    }","}","","struct AppTabs: View {","    var body: some View {","        RouterTabHost(AppTab.self, initial: .home)","    }","}","","struct AccountShortcut: View {","    @EnvironmentRouter(AppTab.self) private var router","","    var body: some View {","        Button(\"Account\") {","            router.select(.account)","            router.setBadge(1, for: .account)","        }","    }","}"],"syntax":"swift compile","type":"codeListing"},{"text":"Automatic single-route deep links","anchor":"Automatic-single-route-deep-links","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Give "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" literal origin allowlists and attach "},{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" to the cases"},{"type":"text","text":" "},{"type":"text","text":"that accept URLs:"}],"type":"paragraph"},{"code":["import SwiftUI","import InnoRouter","","@Router(","    deepLinkSchemes: [\"myapp\", \"https\"],","    deepLinkHosts: [\"app.example.com\"]",")","enum DeepLinkRoute {","    @DeepLink(\"\/books\/:id\")","    case book(id: String)","","    case account","","    var destination: some View {","        switch self {","        case .book(let id):","            Text(\"Book \\(id)\")","        case .account:","            Text(\"Account\")","        }","    }","}","","struct DeepLinkRoot: View {","    var body: some View {","        RouterHost(DeepLinkRoute.self) {","            Text(\"Library\")","        }","    }","}"],"syntax":"swift compile","type":"codeListing"},{"inlineContent":[{"type":"text","text":"No "},{"type":"codeVoice","code":"onOpenURL"},{"type":"text","text":" or parser is needed for this single-route path:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" pushes the resolved route."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"RouterSplitHost","type":"codeVoice"},{"text":" pushes it into the detail stack.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"RouterTabHost","type":"codeVoice"},{"type":"text","text":" selects the resolved tab."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Origin allowlists fail closed. Generated matching prefers literal paths, then"},{"type":"text","text":" "},{"type":"text","text":"typed parameters, then terminal wildcards. Authentication, pending replay,"},{"type":"text","text":" "},{"type":"text","text":"multi-step plans, modal presentation style, and multi-window scene selection"},{"type":"text","text":" "},{"type":"text","text":"remain application-boundary concerns; use the deep-link pipeline and an"},{"type":"text","text":" "},{"type":"text","text":"externally owned store for those advanced policies."}],"type":"paragraph"},{"text":"Diagnostics","anchor":"Diagnostics","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The macros reject invalid declaration shapes before emitting a partial"},{"type":"text","text":" "},{"type":"text","text":"conformance. Diagnostic codes are stable and grouped by surface:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"E001"},{"type":"text","text":"–"},{"type":"codeVoice","code":"E006"},{"type":"text","text":", "},{"type":"codeVoice","code":"W001"},{"type":"text","text":"–"},{"type":"codeVoice","code":"W003"},{"type":"text","text":": enum and destination declarations"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"E007"},{"type":"text","text":"–"},{"type":"codeVoice","code":"E016"},{"type":"text","text":", "},{"type":"codeVoice","code":"W004"},{"type":"text","text":"–"},{"type":"codeVoice","code":"W005"},{"type":"text","text":": tabs"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"E017"},{"type":"text","text":"–"},{"type":"codeVoice","code":"E029"},{"type":"text","text":", "},{"type":"codeVoice","code":"W006"},{"type":"text","text":"–"},{"type":"codeVoice","code":"W007"},{"type":"text","text":", "},{"type":"codeVoice","code":"W012"},{"text":": deep links","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"E030"},{"type":"text","text":"–"},{"type":"codeVoice","code":"E049"},{"type":"text","text":", "},{"type":"codeVoice","code":"W008"},{"type":"text","text":"–"},{"type":"codeVoice","code":"W011"},{"type":"text","text":": opt-in spatial scenes"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics"},{"type":"text","text":" for the complete code-to-recovery catalog."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The Swift type checker remains responsible for view initializer arguments,"},{"type":"text","text":" "},{"type":"text","text":"exhaustive switching, and "},{"type":"codeVoice","code":"Hashable"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"Sendable"},{"type":"text","text":" payload requirements. A"},{"type":"text","text":" "},{"type":"text","text":"constrained generic router is supported when its payload meets those route"},{"type":"text","text":" "},{"type":"text","text":"requirements:"}],"type":"paragraph"},{"code":["import SwiftUI","import InnoRouter","","@Router","enum DetailRoute<Value: Hashable & Sendable> {","    case detail(Value)","","    var destination: some View {","        Text(\"Detail\")","    }","}"],"type":"codeListing","syntax":"swift compile"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The macro cannot prove that a view is mounted below a matching host or that the"},{"type":"text","text":" "},{"type":"text","text":"host publishes the action being invoked because SwiftUI’s environment"},{"type":"text","text":" "},{"type":"text","text":"hierarchy is built at runtime. "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" therefore diagnoses a"},{"type":"text","text":" "},{"type":"text","text":"missing host, mismatched route type, or unavailable capability at action time."}]},{"type":"heading","text":"Manual escape hatch","level":2,"anchor":"Manual-escape-hatch"},{"inlineContent":[{"text":"Advanced targets can keep the compiler-plugin target out of their build graph","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"by depending on the granular "},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":" product and writing the"},{"type":"text","text":" "},{"type":"text","text":"conformance directly:"}],"type":"paragraph"},{"code":["import SwiftUI","import InnoRouterSwiftUI","","enum ManualRoute: DestinationRoute {","    case settings","","    @MainActor","    @ViewBuilder","    static func destination(for route: Self) -> some View {","        switch route {","        case .settings:","            Text(\"Settings\")","        }","    }","}"],"type":"codeListing","syntax":"swift compile"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This path keeps the same "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" and "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" runtime"},{"type":"text","text":" "},{"type":"text","text":"semantics; only the generated declaration work becomes explicit."}]}]}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"article","title":"Macro-first routing with `@Router`","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","interfaceLanguage":"swift"},"kind":"article","variants":[{"paths":["\/documentation\/innoroutermacros\/router-macro-first"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"abstract":[{"text":"Declare route data and destination views in one enum, then select the host that","type":"text"},{"text":" ","type":"text"},{"text":"matches the surface. Stack, modal, split, tab, and single-route deep-link","type":"text"},{"text":" ","type":"text"},{"text":"handling all keep the same ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":" action API.","type":"text"}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"abstract":[{"type":"text","text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to"},{"type":"text","text":" "},{"type":"text","text":"find the recovery without depending on the compiler’s surrounding wording."},{"type":"text","text":" "},{"type":"text","text":"Errors prevent the macro from emitting an incomplete routing contract."},{"type":"text","text":" "},{"type":"text","text":"Warnings identify valid code whose generated behavior is likely surprising or"},{"type":"text","text":" "},{"type":"text","text":"whose explicit declarations are redundant."}],"title":"Macro diagnostics","kind":"article","type":"topic","role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","url":"\/documentation\/innoroutermacros\/macro-diagnostics"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMa