sary acknowledgement."}]}]]],"header":"row","type":"table"},{"anchor":"Runtime-wiring-boundary","level":2,"text":"Runtime wiring boundary","type":"heading"},{"inlineContent":[{"type":"text","text":"Macros validate source declarations, but they cannot inspect the SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"environment graph. "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@EnvironmentSceneRouter"},{"type":"text","text":" "},{"type":"text","text":"therefore resolve their matching authority lazily and apply"},{"type":"text","text":" "},{"type":"codeVoice","code":"EnvironmentMissingPolicy"},{"type":"text","text":" only when an action is invoked. If a declaration"},{"type":"text","text":" "},{"type":"text","text":"compiles but an action reports missing authority, check that the view is below"},{"type":"text","text":" "},{"type":"text","text":"the matching generated host and uses the same route type."}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"kind":"symbol","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","title":"InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"type":"topic","title":"InnoRouterMacros","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","abstract":[{"type":"text","text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path"},{"type":"text","text":" "},{"type":"text","text":"available for advanced composition."}],"url":"\/documentation\/innoroutermacros\/innoroutermacros","kind":"article","role":"collectionGroup"}}}