{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility"},"kind":"article","abstract":[{"text":"Starting in 4.0.0 the ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@CasePathable","type":"codeVoice"},{"text":" macros","type":"text"},{"text":" ","type":"text"},{"text":"infer the access level of every generated member from the","type":"text"},{"text":" ","type":"text"},{"text":"enclosing enum. The previous behaviour emitted everything as","type":"text"},{"text":" ","type":"text"},{"code":"public","type":"codeVoice"},{"text":", which leaked CasePath surface for ","type":"text"},{"code":"internal","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"private","type":"codeVoice"},{"text":" enums that never intended that visibility.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"text":"What gets generated, and at what level","anchor":"What-gets-generated-and-at-what-level","type":"heading","level":2},{"inlineContent":[{"text":"For every ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"@CasePathable","type":"codeVoice"},{"text":") enum the macros emit:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"enum Cases { … }","type":"codeVoice"},{"text":" containing one ","type":"text"},{"code":"static let","type":"codeVoice"},{"text":" per case.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"func is(_ casePath:) -> Bool","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"subscript(case:) -> Value?","type":"codeVoice"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The access keyword applied to all four is inferred from the","type":"text"},{"text":" ","type":"text"},{"text":"enclosing enum:","type":"text"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Enum modifier"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Generated members"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"public enum Foo"}],"type":"paragraph"}],[{"inlineContent":[{"code":"public","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"package enum Foo"}],"type":"paragraph"}],[{"inlineContent":[{"code":"package","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"internal enum Foo","type":"codeVoice"},{"type":"text","text":" (or no modifier)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"internal"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"fileprivate enum Foo","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"fileprivate"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"private enum Foo","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"fileprivate","type":"codeVoice"},{"text":" (lowest level the macro can emit while still letting same-file ","type":"text"},{"code":"is(_:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"subscript(case:)","type":"codeVoice"},{"text":" callers reach the cases)","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"Each case "},{"type":"codeVoice","code":"static let"},{"type":"text","text":" also receives any "},{"type":"codeVoice","code":"@available(...)"},{"type":"text","text":" "},{"type":"text","text":"attribute attached to the enum case, so a case gated on an OS"},{"type":"text","text":" "},{"type":"text","text":"version no longer produces a CasePath member with a wider"},{"type":"text","text":" "},{"type":"text","text":"availability than the underlying case."}],"type":"paragraph"},{"text":"Compatibility for pre-OSS snapshots","anchor":"Compatibility-for-pre-OSS-snapshots","type":"heading","level":2},{"inlineContent":[{"text":"Before the 4.0.0 OSS release, internal macro snapshots always emitted","type":"text"},{"text":" ","type":"text"},{"code":"public","type":"codeVoice"},{"text":". Teams that tested those snapshots should check three","type":"text"},{"text":" ","type":"text"},{"text":"patterns:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Enum and CasePath usage already match."}],"type":"strong"},{"text":" No action — the","type":"text"},{"text":" ","type":"text"},{"text":"generated members tighten to ","type":"text"},{"code":"internal","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"fileprivate","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"fileprivate","type":"codeVoice"},{"text":" matching the enum and the consumer code keeps","type":"text"},{"text":" ","type":"text"},{"text":"compiling because it was within the same module already.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Enum is not "},{"code":"public","type":"codeVoice"},{"type":"text","text":" but a sibling module reads the"},{"type":"text","text":" "},{"type":"text","text":"generated CasePath members."}],"type":"strong"},{"type":"text","text":" Mark the enum "},{"type":"codeVoice","code":"public"},{"type":"text","text":". The"},{"type":"text","text":" "},{"type":"text","text":"pre-OSS behaviour was effectively widening the surface for you;"},{"type":"text","text":" "},{"type":"text","text":"4.0.0 makes the boundary explicit."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Enum cases are gated on ","type":"text"},{"code":"@available(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"strong"},{"text":" The generated","type":"text"},{"text":" ","type":"text"},{"text":"CasePath members now carry the same availability. If a","type":"text"},{"text":" ","type":"text"},{"text":"downstream call site compiled under a wider availability","type":"text"},{"text":" ","type":"text"},{"text":"window before, narrow the enclosing function or branch on","type":"text"},{"text":" ","type":"text"},{"code":"if #available(...)","type":"codeVoice"},{"text":" to match.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Why `private` enums emit `fileprivate`","anchor":"Why-private-enums-emit-fileprivate","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Swift does not let an extension method (the macro emits"},{"type":"text","text":" "},{"type":"codeVoice","code":"is(_:)"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"subscript(case:)"},{"type":"text","text":" as members on the enum itself,"},{"type":"text","text":" "},{"type":"text","text":"not on a generated extension) reference a "},{"type":"codeVoice","code":"private"},{"type":"text","text":" "},{"type":"text","text":"declaration in its own scope when that declaration came from"},{"type":"text","text":" "},{"type":"text","text":"a distinct macro plugin call. Falling back to "},{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":" "},{"type":"text","text":"gives the same effective scope for any caller in the same file"},{"type":"text","text":" "},{"type":"text","text":"without breaking the macro expansion."}],"type":"paragraph"},{"type":"heading","text":"Opt-out","level":2,"anchor":"Opt-out"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"@Routable(visibility: .public)"},{"text":" argument is on the v4.x","type":"text"},{"text":" ","type":"text"},{"text":"roadmap for consumers that intentionally want the wider surface","type":"text"},{"text":" ","type":"text"},{"text":"without making the enclosing enum public. Until then, mark the","type":"text"},{"text":" ","type":"text"},{"text":"enum ","type":"text"},{"type":"codeVoice","code":"public"},{"text":" to widen the generated members.","type":"text"}]}],"kind":"content"}],"metadata":{"title":"`@Routable` \/ `@CasePathable` access level inference","roleHeading":"Article","role":"article","modules":[{"name":"InnoRouterTesting"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/guide-macrovisibility"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"title":"InnoRouterMacros","kind":"article","role":"collectionGroup","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","abstract":[{"type":"text","text":"Route and case-path convenience macros for InnoRouter."}],"url":"\/documentation\/innoroutermacros\/innoroutermacros"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","abstract":[],"type":"topic","title":"InnoRouterTesting","role":"collection","kind":"symbol","url":"\/documentation\/innoroutertesting"}}}