{"abstract":[{"text":"InnoRouter macros infer generated member visibility from the attached enum.","type":"text"},{"text":" ","type":"text"},{"text":"They do not widen an internal route into public API.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/guide-macrovisibility"]}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article","title":"Macro-generated access levels"},"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"`@Routable` and `@CasePathable`","level":2,"anchor":"Routable-and-CasePathable"},{"inlineContent":[{"type":"text","text":"For every "},{"code":"@Routable","type":"codeVoice"},{"text":" (or ","type":"text"},{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":") enum the macros emit:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"enum Cases { … }","type":"codeVoice"},{"text":" containing one ","type":"text"},{"code":"static let","type":"codeVoice"},{"text":" per case.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"func is(_ casePath:) -> Bool"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"code":"subscript(case:) -> Value?","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"The access keyword applied to ","type":"text"},{"code":"Cases","type":"codeVoice"},{"text":", every case-path member, ","type":"text"},{"type":"codeVoice","code":"is(_:)"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"subscript(case:)"},{"type":"text","text":" is inferred from the enclosing enum:"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enum modifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated members"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"public enum Foo","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"public"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"package enum Foo","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"package","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"internal enum Foo"},{"type":"text","text":" (or no modifier)"}]}],[{"type":"paragraph","inlineContent":[{"code":"internal","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"fileprivate enum Foo"}]}],[{"type":"paragraph","inlineContent":[{"code":"fileprivate","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"private enum Foo"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"fileprivate"},{"text":" (the narrowest level that remains reachable across the macro expansion)","type":"text"}]}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"Each case "},{"code":"static let","type":"codeVoice"},{"type":"text","text":" also receives any "},{"code":"@available(...)","type":"codeVoice"},{"type":"text","text":" attribute attached"},{"type":"text","text":" "},{"type":"text","text":"to the enum case, so a case gated on an OS version does not produce a"},{"type":"text","text":" "},{"code":"CasePath","type":"codeVoice"},{"text":" member with wider availability than the underlying case.","type":"text"}],"type":"paragraph"},{"anchor":"Router","text":"`@Router`","level":2,"type":"heading"},{"inlineContent":[{"code":"@Router","type":"codeVoice"},{"type":"text","text":" adds "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@ViewBuilder","type":"codeVoice"},{"type":"text","text":" to the developer-declared"},{"type":"text","text":" "},{"type":"text","text":"instance "},{"type":"codeVoice","code":"destination"},{"type":"text","text":" property. It does not change that property’s declared"},{"type":"text","text":" "},{"type":"text","text":"access level."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The generated ","type":"text"},{"code":"static destination(for:)","type":"codeVoice"},{"text":" protocol witness follows the enum’s","type":"text"},{"text":" ","type":"text"},{"text":"effective access level. This means a public router can keep the instance hook","type":"text"},{"text":" ","type":"text"},{"text":"private while exposing only the witness required by ","type":"text"},{"code":"DestinationRoute","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","public enum PublicRoute {","    case settings","","    private var destination: some View {","        Text(\"Settings\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a "},{"type":"codeVoice","code":"private"},{"type":"text","text":" enum, the generated witness uses "},{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":", matching the"},{"type":"text","text":" "},{"type":"text","text":"case-path macros’ same-file fallback. Do not declare "},{"type":"codeVoice","code":": DestinationRoute"},{"type":"text","text":" "},{"type":"text","text":"yourself; "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" supplies the conformance and warns when the direct"},{"type":"text","text":" "},{"type":"text","text":"conformance is redundant."}]},{"type":"heading","text":"Compatibility for pre-OSS snapshots","anchor":"Compatibility-for-pre-OSS-snapshots","level":2},{"type":"paragraph","inlineContent":[{"text":"Before the 4.0.0 OSS release, internal macro snapshots always emitted","type":"text"},{"text":" ","type":"text"},{"text":"case-path members as ","type":"text"},{"type":"codeVoice","code":"public"},{"text":". Teams that tested those snapshots should check","type":"text"},{"text":" ","type":"text"},{"text":"three patterns:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Enum and CasePath usage already match."}],"type":"strong"},{"text":" No action is needed. Generated","type":"text"},{"type":"text","text":" "},{"type":"text","text":"members tighten to match the enum, and same-module consumer code keeps"},{"type":"text","text":" "},{"type":"text","text":"compiling."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"A sibling module reads generated members from a non-public enum."}],"type":"strong"},{"text":" Mark","type":"text"},{"text":" ","type":"text"},{"text":"the enum ","type":"text"},{"code":"public","type":"codeVoice"},{"text":"; the old expansion was widening the surface implicitly.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Enum cases are gated on "},{"code":"@available(...)","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"text","text":" Generated "},{"type":"codeVoice","code":"CasePath"},{"type":"text","text":" members"},{"type":"text","text":" "},{"text":"now carry the same availability. Narrow the enclosing function or branch on","type":"text"},{"type":"text","text":" "},{"code":"if #available(...)","type":"codeVoice"},{"type":"text","text":" at any downstream call site that used a wider window."}]}]}]},{"level":2,"text":"Why `private` maps to `fileprivate`","anchor":"Why-private-maps-to-fileprivate","type":"heading"},{"inlineContent":[{"text":"Generated declarations can originate from distinct macro expansion roles.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Using "},{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":" preserves same-file access between those declarations while"},{"type":"text","text":" "},{"type":"text","text":"remaining narrower than module-wide "},{"type":"codeVoice","code":"internal"},{"text":" visibility.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Manual visibility control","anchor":"Manual-visibility-control","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"The macros do not expose a visibility override. Mark the enclosing enum","type":"text"},{"text":" ","type":"text"},{"code":"public","type":"codeVoice"},{"text":" when its generated members must be public; otherwise generated members","type":"text"},{"text":" ","type":"text"},{"text":"follow the declaration’s effective access level. If a generated surface is not","type":"text"},{"text":" ","type":"text"},{"text":"appropriate, remove the macro and write the conformance or case-path members","type":"text"},{"text":" ","type":"text"},{"text":"explicitly.","type":"text"}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","kind":"article","role":"collectionGroup","title":"InnoRouterMacros","type":"topic","abstract":[{"type":"text","text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path"},{"type":"text","text":" "},{"type":"text","text":"available for advanced composition."}],"url":"\/documentation\/innoroutermacros\/innoroutermacros"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.inno