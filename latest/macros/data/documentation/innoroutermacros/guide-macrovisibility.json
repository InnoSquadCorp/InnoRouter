ext":" callers reach the cases)"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"Each case "},{"type":"codeVoice","code":"static let"},{"type":"text","text":" also receives any "},{"type":"codeVoice","code":"@available(...)"},{"type":"text","text":" "},{"type":"text","text":"attribute attached to the enum case, so a case gated on an OS"},{"type":"text","text":" "},{"type":"text","text":"version no longer produces a CasePath member with a wider"},{"type":"text","text":" "},{"type":"text","text":"availability than the underlying case."}],"type":"paragraph"},{"level":2,"anchor":"Compatibility-for-pre-OSS-snapshots","text":"Compatibility for pre-OSS snapshots","type":"heading"},{"inlineContent":[{"text":"Before the 4.0.0 OSS release, internal macro snapshots always emitted","type":"text"},{"text":" ","type":"text"},{"code":"public","type":"codeVoice"},{"text":". Teams that tested those snapshots should check three","type":"text"},{"text":" ","type":"text"},{"text":"patterns:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Enum and CasePath usage already match."}],"type":"strong"},{"text":" No action — the","type":"text"},{"text":" ","type":"text"},{"text":"generated members tighten to ","type":"text"},{"type":"codeVoice","code":"internal"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"fileprivate"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"fileprivate"},{"text":" matching the enum and the consumer code keeps","type":"text"},{"text":" ","type":"text"},{"text":"compiling because it was within the same module already.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Enum is not "},{"type":"codeVoice","code":"public"},{"type":"text","text":" but a sibling module reads the"},{"type":"text","text":" "},{"type":"text","text":"generated CasePath members."}],"type":"strong"},{"text":" Mark the enum ","type":"text"},{"type":"codeVoice","code":"public"},{"text":". The","type":"text"},{"text":" ","type":"text"},{"text":"pre-OSS behaviour was effectively widening the surface for you;","type":"text"},{"text":" ","type":"text"},{"text":"4.0.0 makes the boundary explicit.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Enum cases are gated on ","type":"text"},{"code":"@available(...)","type":"codeVoice"},{"text":".","type":"text"}],"type":"strong"},{"type":"text","text":" The generated"},{"type":"text","text":" "},{"type":"text","text":"CasePath members now carry the same availability. If a"},{"type":"text","text":" "},{"type":"text","text":"downstream call site compiled under a wider availability"},{"type":"text","text":" "},{"type":"text","text":"window before, narrow the enclosing function or branch on"},{"type":"text","text":" "},{"type":"codeVoice","code":"if #available(...)"},{"type":"text","text":" to match."}]}]}],"type":"orderedList"},{"level":2,"anchor":"Why-private-enums-emit-fileprivate","text":"Why `private` enums emit `fileprivate`","type":"heading"},{"inlineContent":[{"type":"text","text":"Swift does not let an extension method (the macro emits"},{"type":"text","text":" "},{"code":"is(_:)","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"subscript(case:)","type":"codeVoice"},{"type":"text","text":" as members on the enum itself,"},{"type":"text","text":" "},{"type":"text","text":"not on a generated extension) reference a "},{"code":"private","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"declaration in its own scope when that declaration came from"},{"type":"text","text":" "},{"type":"text","text":"a distinct macro plugin call. Falling back to "},{"code":"fileprivate","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"gives the same effective scope for any caller in the same file"},{"type":"text","text":" "},{"type":"text","text":"without breaking the macro expansion."}],"type":"paragraph"},{"level":2,"text":"Opt-out","anchor":"Opt-out","type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"@Routable(visibility: .public)"},{"text":" argument is on the v4.x","type":"text"},{"text":" ","type":"text"},{"text":"roadmap for consumers that intentionally want the wider surface","type":"text"},{"text":" ","type":"text"},{"text":"without making the enclosing enum public. Until then, mark the","type":"text"},{"text":" ","type":"text"},{"text":"enum ","type":"text"},{"type":"codeVoice","code":"public"},{"text":" to widen the generated members.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"abstract":[{"type":"text","text":"Route and case-path convenience macros for InnoRouter."}],"title":"InnoRouterMacros","type":"topic","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","url":"\/documentation\/innoroutermacros\/innoroutermacros","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"InnoRouterTesting"}}}