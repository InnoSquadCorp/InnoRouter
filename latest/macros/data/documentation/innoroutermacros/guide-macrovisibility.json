{"sections":[],"abstract":[{"text":"Starting in 4.0.0 the ","type":"text"},{"type":"codeVoice","code":"@Routable"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@CasePathable"},{"text":" macros","type":"text"},{"text":" ","type":"text"},{"text":"infer the access level of every generated member from the","type":"text"},{"text":" ","type":"text"},{"text":"enclosing enum. The previous behaviour emitted everything as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"public"},{"type":"text","text":", which leaked CasePath surface for "},{"code":"internal","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"private","type":"codeVoice"},{"type":"text","text":" enums that never intended that visibility."}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"metadata":{"role":"article","roleHeading":"Article","title":"`@Routable` \/ `@CasePathable` access level inference","modules":[{"name":"InnoRouterTesting"}]},"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/guide-macrovisibility"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"What-gets-generated-and-at-what-level","text":"What gets generated, and at what level","type":"heading"},{"inlineContent":[{"type":"text","text":"For every "},{"code":"@Routable","type":"codeVoice"},{"type":"text","text":" (or "},{"code":"@CasePathable","type":"codeVoice"},{"type":"text","text":") enum the macros emit:"}],"type":"paragraph"},{"items":[{"con