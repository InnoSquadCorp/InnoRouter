{"kind":"article","identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","interfaceLanguage":"swift"},"sections":[],"abstract":[{"type":"text","text":"InnoRouter macros infer generated member visibility from the attached enum."},{"type":"text","text":" "},{"type":"text","text":"They do not widen an internal route into public API."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/guide-macrovisibility"]}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article","title":"Macro-generated access levels"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"`@Routable` and `@CasePathable`","anchor":"Routable-and-CasePathable","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"For every ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" (or ","type":"text"},{"code":"@CasePathable","type":"codeVoice"},{"text":") enum the macros emit:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"enum Cases { … }"},{"text":" containing one ","type":"text"},{"code":"static let","type":"codeVoice"},{"text":" per case.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"func is(_ casePath:) -> Bool","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"subscript(case:) -> Value?","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The access keyword applied to "},{"type":"codeVoice","code":"Cases"},{"type":"text","text":", every case-path member, "},{"type":"codeVoice","code":"is(_:)"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"subscript(case:)"},{"type":"text","text":" is inferred from the enclosing enum:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Enum modifier"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated members"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"public enum Foo"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"public"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"package enum Foo"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"package"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"internal enum Foo"},{"type":"text","text":" (or no modifier)"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"internal"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"fileprivate enum Foo"}]}],[{"inlineContent":[{"type":"codeVoice","code":"fileprivate"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":"private enum Foo","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"fileprivate","type":"codeVoice"},{"text":" (the narrowest level that remains reachable across the macro expansion)","type":"text"}]}]]]},{"inlineContent":[{"type":"text","text":"Each case "},{"code":"static let","type":"codeVoice"},{"type":"text","text":" also receives any "},{"type":"codeVoice","code":"@available(...)"},{"type":"text","text":" attribute attached"},{"type":"text","text":" "},{"type":"text","text":"to the enum case, so a case gated on an OS version does not produce a"},{"type":"text","text":" "},{"type":"codeVoice","code":"CasePath"},{"type":"text","text":" member with wider availability than the underlying case."}],"type":"paragraph"},{"anchor":"Router","level":2,"text":"`@Router`","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"@Router","type":"codeVoice"},{"type":"text","text":" adds "},{"code":"@MainActor","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@ViewBuilder"},{"type":"text","text":" to the developer-declared"},{"type":"text","text":" "},{"type":"text","text":"instance "},{"type":"codeVoice","code":"destination"},{"text":" property. It does not change that property’s declared","type":"text"},{"type":"text","text":" "},{"text":"access level.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The generated "},{"type":"codeVoice","code":"static destination(for:)"},{"type":"text","text":" protocol witness follows the enum’s"},{"type":"text","text":" "},{"type":"text","text":"effective access level. This means a public router can keep the instance hook"},{"type":"text","text":" "},{"type":"text","text":"private while exposing only the witness required by "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","public enum PublicRoute {","    case settings","","    private var destination: some View {","        Text(\"Settings\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"For a ","type":"text"},{"type":"codeVoice","code":"private"},{"type":"text","text":" enum, the generated witness uses "},{"type":"codeVoice","code":"fileprivate"},{"type":"text","text":", matching the"},{"type":"text","text":" "},{"type":"text","text":"case-path macros’ same-file fallback. Do not declare "},{"type":"codeVoice","code":": DestinationRoute"},{"text":" ","type":"text"},{"text":"yourself; ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" supplies the conformance and warns when the direct","type":"text"},{"text":" ","type":"text"},{"text":"conformance is redundant.","type":"text"}]},{"type":"heading","anchor":"Compatibility-for-pre-OSS-snapshots","text":"Compatibility for pre-OSS snapshots","level":2},{"type":"paragraph","inlineContent":[{"text":"Before the 4.0.0 OSS release, internal macro snapshots always emitted","type":"text"},{"text":" ","type":"text"},{"text":"case-path members as ","type":"text"},{"code":"public","type":"codeVoice"},{"text":". Teams that tested those snapshots should check","type":"text"},{"text":" ","type":"text"},{"text":"three patterns:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Enum and CasePath usage already match."}]},{"type":"text","text":" No action is needed. Generated"},{"type":"text","text":" "},{"type":"text","text":"members tighten to match the enum, and same-module consumer code keeps"},{"type":"text","text":" "},{"type":"text","text":"compiling."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"A sibling module reads generated members from a non-public enum."}]},{"type":"text","text":" Mark"},{"type":"text","text":" "},{"type":"text","text":"the enum "},{"type":"codeVoice","code":"public"},{"type":"text","text":"; the old expansion was widening the surface implicitly."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Enum cases are gated on "},{"type":"codeVoice","code":"@available(...)"},{"type":"text","text":"."}]},{"type":"text","text":" Generated "},{"type":"codeVoice","code":"CasePath"},{"type":"text","text":" members"},{"type":"text","text":" "},{"type":"text","text":"now carry the same availability. Narrow the enclosing function or branch on"},{"type":"text","text":" "},{"type":"codeVoice","code":"if #available(...)"},{"type":"text","text":" at any downstream call site that used a wider window."}],"type":"paragraph"}]}]},{"level":2,"anchor":"Why-private-maps-to-fileprivate","text":"Why `private` maps to `fileprivate`","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Generated declarations can originate from distinct macro expansion roles.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Using "},{"type":"codeVoice","code":"fileprivate"},{"text":" preserves same-file access between those declarations while","type":"text"},{"type":"text","text":" "},{"text":"remaining narrower than module-wide ","type":"text"},{"type":"codeVoice","code":"internal"},{"text":" visibility.","type":"text"}]},{"anchor":"Manual-visibility-control","type":"heading","text":"Manual visibility control","level":2},{"type":"paragraph","inlineContent":[{"text":"The macros do not expose a visibility override. Mark the enclosing enum","type":"text"},{"type":"text","text":" "},{"code":"public","type":"codeVoice"},{"type":"text","text":" when its generated members must be public; otherwise generated members"},{"text":" ","type":"text"},{"text":"follow the declaration’s effective access level. If a generated surface is not","type":"text"},{"text":" ","type":"text"},{"text":"appropriate, remove the macro and write the conformance or case-path members","type":"text"},{"text":" ","type":"text"},{"text":"explicitly.","type":"text"}]}]}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"kind":"symbol","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","title":"InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"type":"topic","title":"InnoRouterMacros","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","abstract":[{"type":"text","text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path"},{"type":"text","text":" "},{"type":"text","text":"available for advanced composition."}],"url":"\/documentation\/innoroutermacros\/innoroutermacros","kind":"article","role":"collectionGroup"}}}