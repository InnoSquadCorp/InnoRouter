{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter 5 makes macros part of the canonical "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" product. Most"},{"type":"text","text":" "},{"type":"text","text":"applications add that one product and use one import:"}]},{"type":"codeListing","syntax":"swift compile","code":["import SwiftUI","import InnoRouter"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The module exposes five macros with separate responsibilities:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"@Router","type":"codeVoice"},{"text":" is the default macro-first path. It turns route cases and an","type":"text"},{"text":" ","type":"text"},{"text":"instance ","type":"text"},{"code":"destination","type":"codeVoice"},{"text":" view into a ","type":"text"},{"code":"DestinationRoute","type":"codeVoice"},{"text":" that works with","type":"text"},{"text":" ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":", and generates tab or deep-link capabilities when their marker","type":"text"},{"text":" ","type":"text"},{"text":"macros are present.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@TabItem","type":"codeVoice"},{"text":" marks parameterless router cases and generates the metadata used","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@DeepLink","type":"codeVoice"},{"text":" maps literal URL paths to typed router cases. ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" validates","type":"text"},{"text":" ","type":"text"},{"text":"literal scheme and host allowlists and generates the ","type":"text"},{"code":"DeepLinkRoute","type":"codeVoice"},{"text":" ","type":"text"},{"text":"resolver. Generated matching prefers literal paths, then typed parameters,","type":"text"},{"text":" ","type":"text"},{"text":"then terminal wildcards, regardless of case declaration order.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@Routable","type":"codeVoice"},{"text":" adds ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" conformance plus typed ","type":"text"},{"code":"Cases","type":"codeVoice"},{"text":", ","type":"text"},{"code":"is(_:)","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"subscript(case:)","type":"codeVoice"},{"text":" helpers. It does not build destination views.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@CasePathable","type":"codeVoice"},{"text":" adds the same case-path helpers without adding ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" ","type":"text"},{"text":"conformance.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every generated conformance has a plain Swift equivalent. Applications that"},{"type":"text","text":" "},{"type":"text","text":"need externally owned stores, coordinators, restoration, or custom dependency"},{"type":"text","text":" "},{"type":"text","text":"construction can continue to use the runtime APIs directly."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The opt-in "},{"type":"codeVoice","code":"InnoRouterSpatial"},{"type":"text","text":" product adds "},{"type":"codeVoice","code":"@SceneRouter"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@Scene"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"visionOS app scenes. Those macros generate the scene tree installed in"},{"type":"text","text":" "},{"type":"codeVoice","code":"App.body"},{"type":"text","text":"; they are intentionally not part of the default "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" "},{"type":"text","text":"umbrella."}]},{"level":2,"type":"heading","anchor":"Macro-first-quick-start","text":"Macro-first quick start"},{"type":"codeListing","syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","enum AppRoute {","    case detail(id: String)","    case settings","","    var destination: some View {","        switch self {","        case .detail(let id):","            Text(\"Detail \\(id)\")","        case .settings:","            Text(\"Settings\")","        }","    }","}","","struct AppRoot: View {","    var body: some View {","        RouterHost(AppRoute.self) {","            HomeView()","        }","    }","}","","struct HomeView: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    var body: some View {","        Button(\"Open settings\") {","            router.go(.settings)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" supplies "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" through "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":", so do not add either"},{"type":"text","text":" "},{"type":"text","text":"conformance to "},{"type":"codeVoice","code":"AppRoute"},{"type":"text","text":". The "},{"type":"codeVoice","code":"switch"},{"type":"text","text":" remains ordinary Swift and receives the"},{"type":"text","text":" "},{"type":"text","text":"compiler’s exhaustive-case checking."}]},{"level":2,"type":"heading","anchor":"Advanced-granular-imports","text":"Advanced granular imports"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import InnoRouter"},{"type":"text","text":" is the default application entry point. It re-exports the"},{"type":"text","text":" "},{"type":"text","text":"Core, SwiftUI, deep-link, and macro declarations together."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use granular products only when a target intentionally needs a narrower graph:"}]},{"rows":[[[{"inlineContent":[{"type":"text","text":"Product and import"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Advanced use case"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterCore"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Typed route state and command execution without SwiftUI or a compiler-plugin target in this target’s build graph."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterSwiftUI"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Manually conformed routes, externally owned stores, hosts, and coordinators without a compiler-plugin target in this target’s build graph."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterDeepLink"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Deep-link matching and planning without the SwiftUI authority layer."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterMacros"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A feature target that wants macro declarations plus their Core, SwiftUI, and deep-link runtime requirements without the full umbrella target."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterSpatial"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"visionOS windows, volumes, immersive spaces, and ornaments. This remains opt-in."}],"type":"paragraph"}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keeping the compiler-plugin target out of a consumer target’s build graph"},{"type":"text","text":" "},{"type":"text","text":"requires depending on granular runtime products instead of the "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" "},{"type":"text","text":"umbrella. SwiftPM still resolves this package’s package-level "},{"type":"codeVoice","code":"swift-syntax"},{"type":"text","text":" "},{"type":"text","text":"dependency. Merely omitting a macro attribute from a file does not remove the"},{"type":"text","text":" "},{"type":"text","text":"umbrella target’s macro dependency."}]}]}],"metadata":{"role":"collectionGroup","title":"InnoRouterMacros","modules":[{"name":"InnoRouterTesting"}]},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"},"kind":"article","topicSections":[{"identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable"],"anchor":"Essentials","title":"Essentials"},{"identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics"],"anchor":"Guides","title":"Guides"}],"variants":[{"paths":["\/documentation\/innoroutermacros\/innoroutermacros"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"text","text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path"},{"type":"text","text":" "},{"type":"text","text":"available for advanced composition."}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Guide-MacroVisibility":{"role":"article","title":"Macro-generated access levels","abstract":[{"type":"text","text":"InnoRouter macros infer generated member visibility from the attached enum."},{"type":"text","text":" "},{"type":"text","text":"They do not widen an internal route into public API."}],"url":"\/documentation\/innoroutermacros\/guide-macrovisibility","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","type":"topic","kind":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"role":"collection","title":"InnoRouterTesting","abstract":[],"url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","type":"topic","kind":"symbol"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Router-Macro-First":{"abstract":[{"type":"text","text":"Declare route data and destination views in one enum, then select the host that"},{"type":"text","text":" "},{"type":"text","text":"matches the surface. Stack, modal, split, tab, and single-route deep-link"},{"type":"text","text":" "},{"type":"text","text":"handling all keep the same "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" action API."}],"title":"Macro-first routing with `@Router`","kind":"article","type":"topic","role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","url":"\/documentation\/innoroutermacros\/router-macro-first"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Routable-and-CasePathable":{"abstract":[{"type":"text","text":"Use case-path macros when route code needs typed enum extraction in addition to"},{"type":"text","text":" "},{"type":"text","text":"InnoRouter’s macro-first destination routing."}],"title":"Routable and CasePathable","kind":"article","type":"topic","role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable","url":"\/documentation\/innoroutermacros\/routable-and-casepathable"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"abstract":[{"type":"text","text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to"},{"type":"text","text":" "},{"type":"text","text":"find the recovery without depending on the compiler’s surrounding wording."},{"type":"text","text":" "},{"type":"text","text":"Errors prevent the macro from emitting an incomplete routing contract."},{"type":"text","text":" "},{"type":"text","text":"Warnings identify valid code whose generated behavior is likely surprising or"},{"type":"text","text":" "},{"type":"text","text":"whose explicit declarations are redundant."}],"title":"Macro diagnostics","kind":"article","type":"topic","role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","url":"\/documentation\/innoroutermacros\/macro-diagnostics"}}}