{"primaryContentSections":[{"content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"InnoRouter 5 makes macros part of the canonical "},{"code":"InnoRouter","type":"codeVoice"},{"text":" product. Most","type":"text"},{"type":"text","text":" "},{"text":"applications add that one product and use one import:","type":"text"}],"type":"paragraph"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The module exposes five macros with separate responsibilities:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" is the default macro-first path. It turns route cases and an"},{"type":"text","text":" "},{"type":"text","text":"instance "},{"type":"codeVoice","code":"destination"},{"type":"text","text":" view into a "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":" that works with"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":", and generates tab or deep-link capabilities when their marker"},{"type":"text","text":" "},{"type":"text","text":"macros are present."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@TabItem"},{"type":"text","text":" marks parameterless router cases and generates the metadata used"},{"type":"text","text":" "},{"type":"text","text":"by "},{"code":"RouterTabHost","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" maps literal URL paths to typed router cases. "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" validates"},{"type":"text","text":" "},{"type":"text","text":"literal scheme and host allowlists and generates the "},{"type":"codeVoice","code":"DeepLinkRoute"},{"type":"text","text":" "},{"type":"text","text":"resolver. Generated matching prefers literal paths, then typed parameters,"},{"type":"text","text":" "},{"type":"text","text":"then terminal wildcards, regardless of case declaration order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" adds "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" conformance plus typed "},{"type":"codeVoice","code":"Cases"},{"type":"text","text":", "},{"type":"codeVoice","code":"is(_:)"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"subscript(case:)"},{"type":"text","text":" helpers. It does not build destination views."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@CasePathable","type":"codeVoice"},{"type":"text","text":" adds the same case-path helpers without adding "},{"code":"Route","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"conformance."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Every generated conformance has a plain Swift equivalent. Applications that"},{"type":"text","text":" "},{"type":"text","text":"need externally owned stores, coordinators, restoration, or custom dependency"},{"type":"text","text":" "},{"type":"text","text":"construction can continue to use the runtime APIs directly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The opt-in "},{"code":"InnoRouterSpatial","type":"codeVoice"},{"type":"text","text":" product adds "},{"code":"@SceneRouter","type":"codeVoice"},{"type":"text","text":" and "},{"code":"@Scene","type":"codeVoice"},{"type":"text","text":" for"},{"type":"text","text":" "},{"type":"text","text":"visionOS app scenes. Those macros generate the scene tree installed in"},{"type":"text","text":" "},{"code":"App.body","type":"codeVoice"},{"type":"text","text":"; they are intentionally not part of the default "},{"code":"InnoRouter","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"umbrella."}],"type":"paragraph"},{"level":2,"text":"Macro-first quick start","anchor":"Macro-first-quick-start","type":"heading"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","enum AppRoute {","    case detail(id: String)","    case settings","","    var destination: some View {","        switch self {","        case .detail(let id):","            Text(\"Detail \\(id)\")","        case .settings:","            Text(\"Settings\")","        }","    }","}","","struct AppRoot: View {","    var body: some View {","        RouterHost(AppRoute.self) {","            HomeView()","        }","    }","}","","struct HomeView: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    var body: some View {","        Button(\"Open settings\") {","            router.go(.settings)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"@Router","type":"codeVoice"},{"type":"text","text":" supplies "},{"code":"Route","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"DestinationRoute","type":"codeVoice"},{"text":", so do not add either","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"conformance to "},{"code":"AppRoute","type":"codeVoice"},{"type":"text","text":". The "},{"code":"switch","type":"codeVoice"},{"type":"text","text":" remains ordinary Swift and receives the"},{"text":" ","type":"text"},{"text":"compiler’s exhaustive-case checking.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Advanced granular imports","anchor":"Advanced-granular-imports","type":"heading"},{"inlineContent":[{"code":"import InnoRouter","type":"codeVoice"},{"type":"text","text":" is the default application entry point. It re-exports the"},{"text":" ","type":"text"},{"text":"Core, SwiftUI, deep-link, and macro declarations together.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use granular products only when a target intentionally needs a narrower graph:"}],"type":"paragraph"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Product and import","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Advanced use case","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"InnoRouterCore","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Typed route state and command execution without SwiftUI or a compiler-plugin target in this target’s build graph.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"InnoRouterSwiftUI","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Manually conformed routes, externally owned stores, hosts, and coordinators without a compiler-plugin target in this target’s build graph.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"InnoRouterDeepLink","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Deep-link matching and planning without the SwiftUI authority layer.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"InnoRouterMacros","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"A feature target that wants macro declarations plus their Core, SwiftUI, and deep-link runtime requirements without the full umbrella target.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"InnoRouterSpatial","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"visionOS windows, volumes, immersive spaces, and ornaments. This remains opt-in.","type":"text"}]}]]]},{"inlineContent":[{"type":"text","text":"Keeping the compiler-plugin target out of a consumer target’s build graph"},{"type":"text","text":" "},{"type":"text","text":"requires depending on granular runtime products instead of the "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" "},{"type":"text","text":"umbrella. SwiftPM still resolves this package’s package-level "},{"type":"codeVoice","code":"swift-syntax"},{"type":"text","text":" "},{"type":"text","text":"dependency. Merely omitting a macro attribute from a file does not remove the"},{"type":"text","text":" "},{"type":"text","text":"umbrella target’s macro dependency."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable"]},{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics"]}],"kind":"article","metadata":{"title":"InnoRouterMacros","modules":[{"name":"InnoRouterTesting"}],"role":"collectionGroup"},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path","type":"text"},{"type":"text","text":" "},{"text":"available for advanced composition.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"]]},"variants":[{"paths":["\/documentation\/innoroutermacros\/innoroutermacros"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","interfaceLanguage":"swift"},"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Guide-MacroVisibility":{"type":"topic","title":"Macro-generated access levels","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","abstract":[{"type":"text","text":"InnoRouter macros infer generated member visibility from the attached enum."},{"type":"text","text":" "},{"type":"text","text":"They do not widen an internal route into public API."}],"url":"\/documentation\/innoroutermacros\/guide-macrovisibility","kind":"article","role":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Routable-and-CasePathable":{"type":"topic","title":"Routable and CasePathable","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable","abstract":[{"text":"Use case-path macros when route code needs typed enum extraction in addition to","type":"text"},{"text":" ","type":"text"},{"text":"InnoRouter’s macro-first destination routing.","type":"text"}],"url":"\/documentation\/innoroutermacros\/routable-and-casepathable","kind":"article","role":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"type":"topic","title":"Macro diagnostics","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","abstract":[{"type":"text","text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to"},{"type":"text","text":" "},{"type":"text","text":"find the recovery without depending on the compiler’s surrounding wording."},{"type":"text","text":" "},{"type":"text","text":"Errors prevent the macro from emitting an incomplete routing contract."},{"type":"text","text":" "},{"type":"text","text":"Warnings identify valid code whose generated behavior is likely surprising or"},{"type":"text","text":" "},{"type":"text","text":"whose explicit declarations are redundant."}],"url":"\/documentation\/innoroutermacros\/macro-diagnostics","kind":"article","role":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"kind":"symbol","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","title":"InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Router-Macro-First":{"kind":"article","type":"topic","abstract":[{"text":"Declare route data and destination views in one enum, then select the host that","type":"text"},{"text":" ","type":"text"},{"text":"matches the surface. Stack, modal, split, tab, and single-route deep-link","type":"text"},{"text":" ","type":"text"},{"text":"handling all keep the same ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"type":"text","text":" action API."}],"role":"article","url":"\/documentation\/innoroutermacros\/router-macro-first","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","title":"Macro-first routing with `@Router`"}}}