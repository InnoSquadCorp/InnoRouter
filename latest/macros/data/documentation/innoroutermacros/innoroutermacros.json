{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterMacros"},{"text":" reduces route boilerplate without changing runtime semantics.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"It currently exposes:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"@Routable"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@CasePathable"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These macros are optional. Everything in InnoRouter can still be written manually with plain Swift types."}]},{"level":2,"type":"heading","anchor":"Imports","text":"Imports"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter intentionally ships the macros as a distinct product from"},{"type":"text","text":" "},{"type":"text","text":"the main umbrella so apps can opt into macro expansion per-file."},{"type":"text","text":" "},{"type":"text","text":"That means "},{"type":"strong","inlineContent":[{"text":"different imports pull different surfaces into scope","type":"text"}]},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import InnoRouterMacros"},{"type":"text","text":" is required to use "},{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":" on a declaration. The umbrella "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" does"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" re-export the macros — this is deliberate so non-macro"},{"type":"text","text":" "},{"type":"text","text":"files don’t pay the macro-plugin resolution cost."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"import InnoRouter","type":"codeVoice"},{"type":"text","text":" (or "},{"code":"import InnoRouterSwiftUI","type":"codeVoice"},{"type":"text","text":" directly) is"},{"type":"text","text":" "},{"type":"text","text":"enough for everything else — stores, hosts, intents, events,"},{"type":"text","text":" "},{"code":"@EnvironmentNavigationIntent","type":"codeVoice"},{"type":"text","text":", "},{"code":"@EnvironmentModalIntent","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"innoRouterSceneHost","type":"codeVoice"},{"type":"text","text":", "},{"code":"innoRouterOrnament","type":"codeVoice"},{"type":"text","text":", and the Core types."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A file that uses both macros and runtime symbols imports both:"}]},{"syntax":"swift skip doc-fragment","code":["import InnoRouter","import InnoRouterMacros","","@Routable","enum HomeRoute {","    case list","    case detail","}","","struct HomeListView: View {","    @EnvironmentNavigationIntent(HomeRoute.self) private var navigationIntent","    \/\/ ...","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A file that only consumes the routing runtime (for example a plain"},{"type":"text","text":" "},{"type":"text","text":"view that reads "},{"type":"codeVoice","code":"@EnvironmentNavigationIntent"},{"type":"text","text":" for an already-declared"},{"type":"text","text":" "},{"type":"text","text":"route) doesn’t need "},{"type":"codeVoice","code":"import InnoRouterMacros"},{"type":"text","text":" at all."}]}]}],"metadata":{"role":"collectionGroup","modules":[{"name":"InnoRouterTesting"}],"title":"InnoRouterMacros"},"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/innoroutermacros"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"topicSections":[{"identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable"],"anchor":"Essentials","title":"Essentials"},{"identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility"],"anchor":"Guides","title":"Guides"}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Route and case-path convenience macros for InnoRouter."}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Guide-MacroVisibility":{"type":"topic","kind":"article","title":"`@Routable` \/ `@CasePathable` access level inference","url":"\/documentation\/innoroutermacros\/guide-macrovisibility","abstract":[{"type":"text","text":"Starting in 4.0.0 the "},{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":" macros"},{"type":"text","text":" "},{"type":"text","text":"infer the access level of every generated member from the"},{"type":"text","text":" "},{"type":"text","text":"enclosing enum. The previous behaviour emitted everything as"},{"type":"text","text":" "},{"type":"codeVoice","code":"public"},{"type":"text","text":", which leaked CasePath surface for "},{"type":"codeVoice","code":"internal"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"private"},{"type":"text","text":" enums that never intended that visibility."}],"role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Routable-and-CasePathable":{"role":"article","abstract":[{"type":"text","text":"Use macros when you want concise route declarations in user-facing code and examples."}],"kind":"article","title":"Routable and CasePathable","url":"\/documentation\/innoroutermacros\/routable-and-casepathable","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable","type":"topic"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"InnoRouterTesting"}}}