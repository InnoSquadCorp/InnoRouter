:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import InnoRouterMacros"},{"type":"text","text":" is required to use "},{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":" on a declaration. The umbrella "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" does"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" re-export the macros — this is deliberate so non-macro"},{"type":"text","text":" "},{"type":"text","text":"files don’t pay the macro-plugin resolution cost."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"import InnoRouter"},{"type":"text","text":" (or "},{"type":"codeVoice","code":"import InnoRouterSwiftUI"},{"type":"text","text":" directly) is"},{"type":"text","text":" "},{"type":"text","text":"enough for everything else — stores, hosts, intents, events,"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentNavigationIntent"},{"type":"text","text":", "},{"type":"codeVoice","code":"@EnvironmentModalIntent"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"innoRouterSceneHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"innoRouterOrnament"},{"type":"text","text":", and the Core types."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"A file that uses both macros and runtime symbols imports both:"}],"type":"paragraph"},{"code":["import InnoRouter","import InnoRouterMacros","","@Routable","enum HomeRoute {","    case list","    case detail","}","","struct HomeListView: View {","    @EnvironmentNavigationIntent(HomeRoute.self) private var navigationIntent","    \/\/ ...","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"A file that only consumes the routing runtime (for example a plain","type":"text"},{"text":" ","type":"text"},{"text":"view that reads ","type":"text"},{"type":"codeVoice","code":"@EnvironmentNavigationIntent"},{"text":" for an already-declared","type":"text"},{"text":" ","type":"text"},{"text":"route) doesn’t need ","type":"text"},{"type":"codeVoice","code":"import InnoRouterMacros"},{"text":" at all.","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/innoroutermacros"]}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Guide-MacroVisibility":{"url":"\/documentation\/innoroutermacros\/guide-macrovisibility","kind":"article","title":"`@Routable` \/ `@CasePathable` access level inference","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","role":"article","type":"topic","abstract":[{"text":"Starting in 4.0.0 the ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@CasePathable","type":"codeVoice"},{"text":" macros","type":"text"},{"text":" ","type":"text"},{"text":"infer the access level of every generated member from the","type":"text"},{"text":" ","type":"text"},{"text":"enclosing enum. The previous behaviour emitted everything as","type":"text"},{"text":" ","type":"text"},{"code":"public","type":"codeVoice"},{"text":", which leaked CasePath surface for ","type":"text"},{"code":"internal","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"private","type":"codeVoice"},{"text":" enums that never intended that visibility.","type":"text"}]},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Routable-and-CasePathable":{"url":"\/documentation\/innoroutermacros\/routable-