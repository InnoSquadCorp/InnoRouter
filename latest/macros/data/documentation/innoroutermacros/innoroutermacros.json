{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"]]},"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"InnoRouter 5 makes macros part of the canonical ","type":"text"},{"code":"InnoRouter","type":"codeVoice"},{"text":" product. Most","type":"text"},{"text":" ","type":"text"},{"text":"applications add that one product and use one import:","type":"text"}]},{"type":"codeListing","code":["import SwiftUI","import InnoRouter"],"syntax":"swift compile"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The module exposes five macros with separate responsibilities:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"@Router","type":"codeVoice"},{"text":" is the default macro-first path. It turns route cases and an","type":"text"},{"text":" ","type":"text"},{"text":"instance ","type":"text"},{"code":"destination","type":"codeVoice"},{"text":" view into a ","type":"text"},{"code":"DestinationRoute","type":"codeVoice"},{"text":" that works with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":", and generates tab or deep-link capabilities when their marker"},{"type":"text","text":" "},{"type":"text","text":"macros are present."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@TabItem"},{"type":"text","text":" marks parameterless router cases and generates the metadata used"},{"type":"text","text":" "},{"type":"text","text":"by "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"code":"@DeepLink","type":"codeVoice"},{"type":"text","text":" maps literal URL paths to typed router cases. "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" validates"},{"type":"text","text":" "},{"type":"text","text":"literal scheme and host allowlists and generates the "},{"type":"codeVoice","code":"DeepLinkRoute"},{"type":"text","text":" "},{"type":"text","text":"resolver. Generated matching prefers literal paths, then typed parameters,"},{"type":"text","text":" "},{"type":"text","text":"then terminal wildcards, regardless of case declaration order."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"@Routable"},{"text":" adds ","type":"text"},{"type":"codeVoice","code":"Route"},{"text":" conformance plus typed ","type":"text"},{"type":"codeVoice","code":"Cases"},{"type":"text","text":", "},{"type":"codeVoice","code":"is(_:)"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"subscript(case:)"},{"type":"text","text":" helpers. It does not build destination views."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":" adds the same case-path helpers without adding "},{"type":"codeVoice","code":"Route"},{"text":" ","type":"text"},{"text":"conformance.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every generated conformance has a plain Swift equivalent. Applications that"},{"type":"text","text":" "},{"type":"text","text":"need externally owned stores, coordinators, restoration, or custom dependency"},{"type":"text","text":" "},{"type":"text","text":"construction can continue to use the runtime APIs directly."}]},{"type":"paragraph","inlineContent":[{"text":"The opt-in ","type":"text"},{"code":"InnoRouterSpatial","type":"codeVoice"},{"text":" product adds ","type":"text"},{"code":"@SceneRouter","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@Scene","type":"codeVoice"},{"text":" for","type":"text"},{"text":" ","type":"text"},{"text":"visionOS app scenes. Those macros generate the scene tree installed in","type":"text"},{"text":" ","type":"text"},{"code":"App.body","type":"codeVoice"},{"text":"; they are intentionally not part of the default ","type":"text"},{"code":"InnoRouter","type":"codeVoice"},{"text":" ","type":"text"},{"text":"umbrella.","type":"text"}]},{"anchor":"Macro-first-quick-start","text":"Macro-first quick start","type":"heading","level":2},{"type":"codeListing","code":["import SwiftUI","import InnoRouter","","@Router","enum AppRoute {","    case detail(id: String)","    case settings","","    var destination: some View {","        switch self {","        case .detail(let id):","            Text(\"Detail \\(id)\")","        case .settings:","            Text(\"Settings\")","        }","    }","}","","struct AppRoot: View {","    var body: some View {","        RouterHost(AppRoute.self) {","            HomeView()","        }","    }","}","","struct HomeView: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    var body: some View {","        Button(\"Open settings\") {","            router.go(.settings)","        }","    }","}"],"syntax":"swift compile"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" supplies "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" through "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":", so do not add either"},{"type":"text","text":" "},{"type":"text","text":"conformance to "},{"type":"codeVoice","code":"AppRoute"},{"type":"text","text":". The "},{"type":"codeVoice","code":"switch"},{"text":" remains ordinary Swift and receives the","type":"text"},{"text":" ","type":"text"},{"text":"compiler’s exhaustive-case checking.","type":"text"}]},{"anchor":"Advanced-granular-imports","text":"Advanced granular imports","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"import InnoRouter"},{"type":"text","text":" is the default application entry point. It re-exports the"},{"type":"text","text":" "},{"text":"Core, SwiftUI, deep-link, and macro declarations together.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Use granular products only when a target intentionally needs a narrower graph:"}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product and import"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Advanced use case"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"InnoRouterCore","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Typed route state and command execution without SwiftUI or a compiler-plugin target in this target’s build graph.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterSwiftUI"}]}],[{"type":"paragraph","inlineContent":[{"text":"Manually conformed routes, externally owned stores, hosts, and coordinators without a compiler-plugin target in this target’s build graph.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"InnoRouterDeepLink","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Deep-link matching and planning without the SwiftUI authority layer."}]}]],[[{"type":"paragraph","inlineContent":[{"code":"InnoRouterMacros","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A feature target that wants macro declarations plus their Core, SwiftUI, and deep-link runtime requirements without the full umbrella target."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterSpatial"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"visionOS windows, volumes, immersive spaces, and ornaments. This remains opt-in."}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"Keeping the compiler-plugin target out of a consumer target’s build graph"},{"type":"text","text":" "},{"type":"text","text":"requires depending on granular runtime products instead of the "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" "},{"type":"text","text":"umbrella. SwiftPM still resolves this package’s package-level "},{"type":"codeVoice","code":"swift-syntax"},{"text":" ","type":"text"},{"text":"dependency. Merely omitting a macro attribute from a file does not remove the","type":"text"},{"text":" ","type":"text"},{"text":"umbrella target’s macro dependency.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","interfaceLanguage":"swift"},"sections":[],"metadata":{"role":"collectionGroup","modules":[{"name":"InnoRouterTesting"}],"title":"InnoRouterMacros"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/innoroutermacros"]}],"topicSections":[{"title":"Essentials","anchor":"Essentials","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable"]},{"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics"]}],"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path"},{"type":"text","text":" "},{"type":"text","text":"available for advanced composition."}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Guide-MacroVisibility":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","url":"\/documentation\/innoroutermacros\/guide-macrovisibility","title":"Macro-generated access levels","role":"article","abstract":[{"type":"text","text":"InnoRouter macros infer generated member visibility from the attached enum."},{"type":"text","text":" "},{"type":"text","text":"They do not widen an internal route into public API."}],"kind":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","url":"\/documentation\/innoroutermacros\/macro-diagnostics","title":"Macro diagnostics","role":"article","abstract":[{"type":"text","text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to"},{"type":"text","text":" "},{"type":"text","text":"find the recovery without depending on the compiler’s surrounding wording."},{"type":"text","text":" "},{"type":"text","text":"Errors prevent the macro from emitting an incomplete routing contract."},{"type":"text","text":" "},{"type":"text","text":"Warnings identify valid code whose generated behavior is likely surprising or"},{"type":"text","text":" "},{"type":"text","text":"whose explicit declarations are redundant."}],"kind":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Router-Macro-First":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","title":"Macro-first routing with `@Router`","url":"\/documentation\/innoroutermacros\/router-macro-first","type":"topic","kind":"article","role":"article","abstract":[{"type":"text","text":"Declare route data and destination views in one enum, then select the host that"},{"type":"text","text":" "},{"type":"text","text":"matches the surface. Stack, modal, split, tab, and single-route deep-link"},{"type":"text","text":" "},{"type":"text","text":"handling all keep the same "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" action API."}]},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Routable-and-CasePathable":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable","url":"\/documentation\/innoroutermacros\/routable-and-casepathable","title":"Routable and CasePathable","role":"article","abstract":[{"type":"text","text":"Use case-path macros when route code needs typed enum extraction in addition to"},{"type":"text","text":" "},{"type":"text","text":"InnoRouter’s macro-first destination routing."}],"kind":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","type":"topic","kind":"symbol","title":"InnoRouterTesting","role":"collection","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","abstract":[]}}}