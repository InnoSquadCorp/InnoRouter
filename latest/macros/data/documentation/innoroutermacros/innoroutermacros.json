{"topicSections":[{"anchor":"Essentials","title":"Essentials","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable"]},{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics"]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter 5 makes macros part of the canonical "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" product. Most"},{"type":"text","text":" "},{"type":"text","text":"applications add that one product and use one import:"}]},{"type":"codeListing","code":["import SwiftUI","import InnoRouter"],"syntax":"swift compile"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The module exposes five macros with separate responsibilities:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"@Router","type":"codeVoice"},{"text":" is the default macro-first path. It turns route cases and an","type":"text"},{"text":" ","type":"text"},{"text":"instance ","type":"text"},{"code":"destination","type":"codeVoice"},{"text":" view into a ","type":"text"},{"code":"DestinationRoute","type":"codeVoice"},{"text":" that works with","type":"text"},{"text":" ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":", and generates tab or deep-link capabilities when their marker","type":"text"},{"text":" ","type":"text"},{"text":"macros are present.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@TabItem","type":"codeVoice"},{"text":" marks parameterless router cases and generates the metadata used","type":"text"},{"type":"text","text":" "},{"type":"text","text":"by "},{"type":"codeVoice","code":"RouterTabHost"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" maps literal URL paths to typed router cases. "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" validates"},{"type":"text","text":" "},{"type":"text","text":"literal scheme and host allowlists and generates the "},{"type":"codeVoice","code":"DeepLinkRoute"},{"type":"text","text":" "},{"type":"text","text":"resolver. Generated matching prefers literal paths, then typed parameters,"},{"type":"text","text":" "},{"type":"text","text":"then terminal wildcards, regardless of case declaration order."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Routable"},{"text":" adds ","type":"text"},{"type":"codeVoice","code":"Route"},{"text":" conformance plus typed ","type":"text"},{"type":"codeVoice","code":"Cases"},{"text":", ","type":"text"},{"type":"codeVoice","code":"is(_:)"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"subscript(case:)"},{"text":" helpers. It does not build destination views.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"@CasePathable","type":"codeVoice"},{"text":" adds the same case-path helpers without adding ","type":"text"},{"type":"codeVoice","code":"Route"},{"text":" ","type":"text"},{"text":"conformance.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Every generated conformance has a plain Swift equivalent. Applications that","type":"text"},{"text":" ","type":"text"},{"text":"need externally owned stores, coordinators, restoration, or custom dependency","type":"text"},{"text":" ","type":"text"},{"text":"construction can continue to use the runtime APIs directly.","type":"text"}]},{"inlineContent":[{"type":"text","text":"The opt-in "},{"type":"codeVoice","code":"InnoRouterSpatial"},{"text":" product adds ","type":"text"},{"type":"codeVoice","code":"@SceneRouter"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"@Scene"},{"type":"text","text":" for"},{"text":" ","type":"text"},{"type":"text","text":"visionOS app scenes. Those macros generate the scene tree installed in"},{"text":" ","type":"text"},{"type":"codeVoice","code":"App.body"},{"type":"text","text":"; they are intentionally not part of the default "},{"code":"InnoRouter","type":"codeVoice"},{"type":"text","text":" "},{"text":"umbrella.","type":"text"}],"type":"paragraph"},{"text":"Macro-first quick start","anchor":"Macro-first-quick-start","type":"heading","level":2},{"code":["import SwiftUI","import InnoRouter","","@Router","enum AppRoute {","    case detail(id: String)","    case settings","","    var destination: some View {","        switch self {","        case .detail(let id):","            Text(\"Detail \\(id)\")","        case .settings:","            Text(\"Settings\")","        }","    }","}","","struct AppRoot: View {","    var body: some View {","        RouterHost(AppRoute.self) {","            HomeView()","        }","    }","}","","struct HomeView: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    var body: some View {","        Button(\"Open settings\") {","            router.go(.settings)","        }","    }","}"],"syntax":"swift compile","type":"codeListing"},{"inlineContent":[{"code":"@Router","type":"codeVoice"},{"text":" supplies ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"DestinationRoute","type":"codeVoice"},{"text":", so do not add either","type":"text"},{"text":" ","type":"text"},{"text":"conformance to ","type":"text"},{"code":"AppRoute","type":"codeVoice"},{"text":". The ","type":"text"},{"code":"switch","type":"codeVoice"},{"text":" remains ordinary Swift and receives the","type":"text"},{"text":" ","type":"text"},{"text":"compiler’s exhaustive-case checking.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Advanced-granular-imports","level":2,"text":"Advanced granular imports"},{"inlineContent":[{"type":"codeVoice","code":"import InnoRouter"},{"text":" is the default application entry point. It re-exports the","type":"text"},{"type":"text","text":" "},{"text":"Core, SwiftUI, deep-link, and macro declarations together.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use granular products only when a target intentionally needs a narrower graph:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Product and import"}]}],[{"type":"paragraph","inlineContent":[{"text":"Advanced use case","type":"text"}]}]],[[{"inlineContent":[{"code":"InnoRouterCore","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Typed route state and command execution without SwiftUI or a compiler-plugin target in this target’s build graph."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"InnoRouterSwiftUI","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Manually conformed routes, externally owned stores, hosts, and coordinators without a compiler-plugin target in this target’s build graph."}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"InnoRouterDeepLink","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Deep-link matching and planning without the SwiftUI authority layer.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterMacros"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"A feature target that wants macro declarations plus their Core, SwiftUI, and deep-link runtime requirements without the full umbrella target.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"InnoRouterSpatial","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"visionOS windows, volumes, immersive spaces, and ornaments. This remains opt-in."}]}]]]},{"inlineContent":[{"text":"Keeping the compiler-plugin target out of a consumer target’s build graph","type":"text"},{"text":" ","type":"text"},{"text":"requires depending on granular runtime products instead of the ","type":"text"},{"type":"codeVoice","code":"InnoRouter"},{"text":" ","type":"text"},{"text":"umbrella. SwiftPM still resolves this package’s package-level ","type":"text"},{"type":"codeVoice","code":"swift-syntax"},{"text":" ","type":"text"},{"text":"dependency. Merely omitting a macro attribute from a file does not remove the","type":"text"},{"text":" ","type":"text"},{"text":"umbrella target’s macro dependency.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/innoroutermacros"]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"]]},"metadata":{"title":"InnoRouterMacros","role":"collectionGroup","modules":[{"name":"InnoRouterTesting"}]},"kind":"article","abstract":[{"type":"text","text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path"},{"type":"text","text":" "},{"type":"text","text":"available for advanced composition."}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"abstract":[{"type":"text","text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to"},{"type":"text","text":" "},{"type":"text","text":"find the recovery without depending on the compiler’s surrounding wording."},{"type":"text","text":" "},{"type":"text","text":"Errors prevent the macro from emitting an incomplete routing contract."},{"type":"text","text":" "},{"type":"text","text":"Warnings identify valid code whose generated behavior is likely surprising or"},{"type":"text","text":" "},{"type":"text","text":"whose explicit declarations are redundant."}],"type":"topic","kind":"article","role":"article","title":"Macro diagnostics","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","url":"\/documentation\/innoroutermacros\/macro-diagnostics"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Routable-and-CasePathable":{"abstract":[{"type":"text","text":"Use case-path macros when route code needs typed enum extraction in addition to"},{"type":"text","text":" "},{"type":"text","text":"InnoRouter’s macro-first destination routing."}],"url":"\/documentation\/innoroutermacros\/routable-and-casepathable","role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable","title":"Routable and CasePathable","type":"topic","kind":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Router-Macro-First":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Router-Macro-First","url":"\/documentation\/innoroutermacros\/router-macro-first","role":"article","abstract":[{"type":"text","text":"Declare route data and destination views in one enum, then select the host that"},{"type":"text","text":" "},{"type":"text","text":"matches the surface. Stack, modal, split, tab, and single-route deep-link"},{"type":"text","text":" "},{"type":"text","text":"handling all keep the same "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" action API."}],"title":"Macro-first routing with `@Router`","kind":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Guide-MacroVisibility":{"abstract":[{"text":"InnoRouter macros infer generated member visibility from the attached enum.","type":"text"},{"text":" ","type":"text"},{"text":"They do not widen an internal route into public API.","type":"text"}],"url":"\/documentation\/innoroutermacros\/guide-macrovisibility","role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Guide-MacroVisibility","title":"Macro-generated access levels","type":"topic","kind":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","kind":"symbol","title":"InnoRouterTesting","abstract":[],"role":"collection"}}}