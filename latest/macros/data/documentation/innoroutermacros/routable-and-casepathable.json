{"primaryContentSections":[{"content":[{"text":"Overview","anchor":"overview","type":"heading","level":2},{"inlineContent":[{"text":"For most SwiftUI routers, start with ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":". It combines route data and","type":"text"},{"text":" ","type":"text"},{"text":"destination views in one enum. Add one of the case-path macros only when a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"feature also needs to inspect or extract a particular enum case."}],"type":"paragraph"},{"text":"`@Routable`","level":2,"type":"heading","anchor":"Routable"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" generates "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" conformance plus typed "},{"type":"codeVoice","code":"Cases"},{"type":"text","text":", "},{"type":"codeVoice","code":"is(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"subscript(case:)"},{"type":"text","text":" helpers. It is useful for route models that do not own"},{"type":"text","text":" "},{"type":"text","text":"destination views, such as a domain route consumed by a coordinator or planner."}]},{"type":"paragraph","inlineContent":[{"text":"Do not repeat ","type":"text"},{"code":": Route","type":"codeVoice"},{"text":"; the macro supplies that conformance:","type":"text"}]},{"code":["import InnoRouter","","@Routable","enum AccountRoute {","    case overview","    case profile(userID: String)","}","","let route = AccountRoute.profile(userID: \"42\")","route[case: AccountRoute.Cases.profile]  \/\/ Optional(\"42\")","route.is(AccountRoute.Cases.overview)    \/\/ false"],"type":"codeListing","syntax":"swift compile"},{"text":"`@CasePathable`","level":2,"type":"heading","anchor":"CasePathable"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":" generates the same case-path members without adding"},{"type":"text","text":" "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" conformance. Compose it with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" when a destination-owning"},{"type":"text","text":" "},{"type":"text","text":"router also needs typed extraction:"}]},{"code":["import SwiftUI","import InnoRouter","","@Router","@CasePathable","enum SearchRoute {","    case result(id: String)","","    var destination: some View {","        Text(\"Search result\")","    }","}","","let route = SearchRoute.result(id: \"42\")","route[case: SearchRoute.Cases.result]  \/\/ Optional(\"42\")"],"type":"codeListing","syntax":"swift compile"},{"type":"paragraph","inlineContent":[{"text":"It is also useful on enums that are not routes at all but still need reusable","type":"text"},{"type":"text","text":" "},{"type":"text","text":"case extraction."}]},{"anchor":"Examples-vs-smoke-fixtures","level":2,"type":"heading","text":"Examples vs smoke fixtures"},{"inlineContent":[{"type":"text","text":"The repository intentionally builds both example layers:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"Examples\/","type":"codeVoice"},{"text":" covers macro-first entry points and explicitly advanced Store \/","type":"text"},{"text":" ","type":"text"},{"text":"Coordinator composition; every human-facing example has a SwiftPM build","type":"text"},{"text":" ","type":"text"},{"text":"target.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ExamplesSmoke\/"},{"text":" mirrors the public runtime surface with conservative","type":"text"},{"text":" ","type":"text"},{"text":"fixtures. Its dedicated ","type":"text"},{"type":"codeVoice","code":"MacrosSmoke.swift"},{"text":" target depends only on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"InnoRouter"},{"text":" and proves the one-product macro-first consumer contract.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Macro expansion itself is covered by ","type":"text"},{"code":"InnoRouterMacrosTests","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterMacrosBehaviorTests","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Limitations-generic-enums","level":2,"type":"heading","text":"Limitations: generic enums"},{"inlineContent":[{"text":"Both ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":" reject generic enum declarations with an"},{"type":"text","text":" "},{"type":"text","text":"explicit compiler error:"}],"type":"paragraph"},{"code":["@Routable","enum Generic<T> { case detail(T) } \/\/ error: @Routable does not support generic enum declarations"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The generated ","type":"text"},{"code":"enum Cases","type":"codeVoice"},{"text":" would need to materialise ","type":"text"},{"code":"CasePath<Self, T>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"members for each generic instantiation, but Swift does not propagate the","type":"text"},{"text":" ","type":"text"},{"text":"parent’s generic parameters into a nested type that way. Diagnostic ID","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterMacro.E003","type":"codeVoice"},{"text":" is emitted on the generic parameter clause. See","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","type":"reference","isActive":true},{"text":" for the complete diagnostic catalog.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This limitation does not apply to ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":". A constrained generic router is","type":"text"},{"text":" ","type":"text"},{"text":"supported as long as its payloads satisfy the ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" requirements:","type":"text"}]},{"code":["import SwiftUI","import InnoRouter","","@Router","enum DetailRoute<Value: Hashable & Sendable> {","    case detail(Value)","","    var destination: some View {","        Text(\"Detail\")","    }","}"],"syntax":"swift compile","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"If a case-path route needs a generic data shape, expose a concrete payload type","type":"text"},{"text":" ","type":"text"},{"text":"from the non-generic route enum:","type":"text"}]},{"code":["struct DetailPayload<Value: Hashable & Sendable>: Hashable, Sendable {","    let value: Value","}","","typealias StringDetailPayload = DetailPayload<String>","","@Routable","enum AppRoute {","    case home","    case detail(StringDetailPayload)","}"],"syntax":"swift skip doc-fragment","type":"codeListing"}],"kind":"content"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/routable-and-casepathable"]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"metadata":{"roleHeading":"Article","title":"Routable and CasePathable","role":"article","modules":[{"name":"InnoRouterTesting"}]},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"kind":"article","abstract":[{"type":"text","text":"Use case-path macros when route code needs typed enum extraction in addition to"},{"type":"text","text":" "},{"type":"text","text":"InnoRouter’s macro-first destination routing."}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"abstract":[{"type":"text","text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to"},{"type":"text","text":" "},{"type":"text","text":"find the recovery without depending on the compiler’s surrounding wording."},{"type":"text","text":" "},{"type":"text","text":"Errors prevent the macro from emitting an incomplete routing contract."},{"type":"text","text":" "},{"type":"text","text":"Warnings identify valid code whose generated behavior is likely surprising or"},{"type":"text","text":" "},{"type":"text","text":"whose explicit declarations are redundant."}],"type":"topic","kind":"article","role":"article","title":"Macro diagnostics","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","url":"\/documentation\/innoroutermacros\/macro-diagnostics"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","kind":"symbol","title":"InnoRouterTesting","abstract":[],"role":"collection"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","kind":"article","role":"collectionGroup","title":"InnoRouterMacros","type":"topic","abstract":[{"type":"text","text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path"},{"type":"text","text":" "},{"type":"text","text":"available for advanced composition."}],"url":"\/documentation\/innoroutermacros\/innoroutermacros"}}}