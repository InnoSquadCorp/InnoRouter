{"kind":"article","identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","title":"Routable and CasePathable","modules":[{"name":"InnoRouterTesting"}]},"variants":[{"paths":["\/documentation\/innoroutermacros\/routable-and-casepathable"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For most SwiftUI routers, start with "},{"code":"@Router","type":"codeVoice"},{"type":"text","text":". It combines route data and"},{"type":"text","text":" "},{"type":"text","text":"destination views in one enum. Add one of the case-path macros only when a"},{"type":"text","text":" "},{"type":"text","text":"feature also needs to inspect or extract a particular enum case."}]},{"type":"heading","level":2,"text":"`@Routable`","anchor":"Routable"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" generates "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" conformance plus typed "},{"type":"codeVoice","code":"Cases"},{"type":"text","text":", "},{"type":"codeVoice","code":"is(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"subscript(case:)"},{"type":"text","text":" helpers. It is useful for route models that do not own"},{"type":"text","text":" "},{"type":"text","text":"destination views, such as a domain route consumed by a coordinator or planner."}]},{"inlineContent":[{"type":"text","text":"Do not repeat "},{"type":"codeVoice","code":": Route"},{"type":"text","text":"; the macro supplies that conformance:"}],"type":"paragraph"},{"syntax":"swift compile","code":["import InnoRouter","","@Routable","enum AccountRoute {","    case overview","    case profile(userID: String)","}","","let route = AccountRoute.profile(userID: \"42\")","route[case: AccountRoute.Cases.profile]  \/\/ Optional(\"42\")","route.is(AccountRoute.Cases.overview)    \/\/ false"],"type":"codeListing"},{"anchor":"CasePathable","level":2,"text":"`@CasePathable`","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"@CasePathable"},{"text":" generates the same case-path members without adding","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Route"},{"text":" conformance. Compose it with ","type":"text"},{"type":"codeVoice","code":"@Router"},{"text":" when a destination-owning","type":"text"},{"type":"text","text":" "},{"type":"text","text":"router also needs typed extraction:"}],"type":"paragraph"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","@CasePathable","enum SearchRoute {","    case result(id: String)","","    var destination: some View {","        Text(\"Search result\")","    }","}","","let route = SearchRoute.result(id: \"42\")","route[case: SearchRoute.Cases.result]  \/\/ Optional(\"42\")"],"type":"codeListing"},{"inlineContent":[{"text":"It is also useful on enums that are not routes at all but still need reusable","type":"text"},{"text":" ","type":"text"},{"text":"case extraction.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Examples vs smoke fixtures","anchor":"Examples-vs-smoke-fixtures","type":"heading"},{"inlineContent":[{"type":"text","text":"The repository intentionally builds both example layers:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Examples\/","type":"codeVoice"},{"text":" covers macro-first entry points and explicitly advanced Store \/","type":"text"},{"text":" ","type":"text"},{"text":"Coordinator composition; every human-facing example has a SwiftPM build","type":"text"},{"text":" ","type":"text"},{"text":"target.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ExamplesSmoke\/"},{"text":" mirrors the public runtime surface with conservative","type":"text"},{"text":" ","type":"text"},{"text":"fixtures. Its dedicated ","type":"text"},{"type":"codeVoice","code":"MacrosSmoke.swift"},{"text":" target depends only on","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"InnoRouter"},{"text":" and proves the one-product macro-first consumer contract.","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Macro expansion itself is covered by "},{"code":"InnoRouterMacrosTests","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"InnoRouterMacrosBehaviorTests","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Limitations: generic enums","anchor":"Limitations-generic-enums","type":"heading"},{"inlineContent":[{"text":"Both ","type":"text"},{"code":"@Routable","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"@CasePathable","type":"codeVoice"},{"text":" reject generic enum declarations with an","type":"text"},{"text":" ","type":"text"},{"text":"explicit compiler error:","type":"text"}],"type":"paragraph"},{"code":["@Routable","enum Generic<T> { case detail(T) } \/\/ error: @Routable does not support generic enum declarations"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"The generated ","type":"text"},{"code":"enum Cases","type":"codeVoice"},{"text":" would need to materialise ","type":"text"},{"code":"CasePath<Self, T>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"members for each generic instantiation, but Swift does not propagate the","type":"text"},{"text":" ","type":"text"},{"text":"parent’s generic parameters into a nested type that way. Diagnostic ID","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterMacro.E003","type":"codeVoice"},{"text":" is emitted on the generic parameter clause. See","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","type":"reference"},{"text":" for the complete diagnostic catalog.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This limitation does not apply to "},{"code":"@Router","type":"codeVoice"},{"type":"text","text":". A constrained generic router is"},{"type":"text","text":" "},{"type":"text","text":"supported as long as its payloads satisfy the "},{"code":"Route","type":"codeVoice"},{"type":"text","text":" requirements:"}],"type":"paragraph"},{"code":["import SwiftUI","import InnoRouter","","@Router","enum DetailRoute<Value: Hashable & Sendable> {","    case detail(Value)","","    var destination: some View {","        Text(\"Detail\")","    }","}"],"type":"codeListing","syntax":"swift compile"},{"inlineContent":[{"type":"text","text":"If a case-path route needs a generic data shape, expose a concrete payload type"},{"type":"text","text":" "},{"type":"text","text":"from the non-generic route enum:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["struct DetailPayload<Value: Hashable & Sendable>: Hashable, Sendable {","    let value: Value","}","","typealias StringDetailPayload = DetailPayload<String>","","@Routable","enum AppRoute {","    case home","    case detail(StringDetailPayload)","}"]}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"Use case-path macros when route code needs typed enum extraction in addition to"},{"type":"text","text":" "},{"type":"text","text":"InnoRouter’s macro-first destination routing."}],"sections":[],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","title":"InnoRouterMacros","url":"\/documentation\/innoroutermacros\/innoroutermacros","type":"topic","kind":"article","role":"collectionGroup","abstract":[{"text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path","type":"text"},{"text":" ","type":"text"},{"text":"available for advanced composition.","type":"text"}]},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","url":"\/documentation\/innoroutermacros\/macro-diagnostics","title":"Macro diagnostics","role":"article","abstract":[{"type":"text","text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to"},{"type":"text","text":" "},{"type":"text","text":"find the recovery without depending on the compiler’s surrounding wording."},{"type":"text","text":" "},{"type":"text","text":"Errors prevent the macro from emitting an incomplete routing contract."},{"type":"text","text":" "},{"type":"text","text":"Warnings identify valid code whose generated behavior is likely surprising or"},{"type":"text","text":" "},{"type":"text","text":"whose explicit declarations are redundant."}],"kind":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","type":"topic","kind":"symbol","title":"InnoRouterTesting","role":"collection","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","abstract":[]}}}