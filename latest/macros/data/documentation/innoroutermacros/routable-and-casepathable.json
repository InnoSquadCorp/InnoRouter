{"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Routable-and-CasePathable","interfaceLanguage":"swift"},"kind":"article","sections":[],"abstract":[{"type":"text","text":"Use case-path macros when route code needs typed enum extraction in addition to"},{"type":"text","text":" "},{"type":"text","text":"InnoRouter’s macro-first destination routing."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutermacros\/routable-and-casepathable"]}],"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"title":"Routable and CasePathable","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"content":[{"anchor":"overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"For most SwiftUI routers, start with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":". It combines route data and"},{"type":"text","text":" "},{"type":"text","text":"destination views in one enum. Add one of the case-path macros only when a"},{"type":"text","text":" "},{"type":"text","text":"feature also needs to inspect or extract a particular enum case."}],"type":"paragraph"},{"anchor":"Routable","type":"heading","level":2,"text":"`@Routable`"},{"inlineContent":[{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" generates "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" conformance plus typed "},{"type":"codeVoice","code":"Cases"},{"type":"text","text":", "},{"type":"codeVoice","code":"is(_:)"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"subscript(case:)"},{"type":"text","text":" helpers. It is useful for route models that do not own"},{"type":"text","text":" "},{"type":"text","text":"destination views, such as a domain route consumed by a coordinator or planner."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Do not repeat "},{"type":"codeVoice","code":": Route"},{"type":"text","text":"; the macro supplies that conformance:"}],"type":"paragraph"},{"syntax":"swift compile","code":["import InnoRouter","","@Routable","enum AccountRoute {","    case overview","    case profile(userID: String)","}","","let route = AccountRoute.profile(userID: \"42\")","route[case: AccountRoute.Cases.profile]  \/\/ Optional(\"42\")","route.is(AccountRoute.Cases.overview)    \/\/ false"],"type":"codeListing"},{"anchor":"CasePathable","type":"heading","level":2,"text":"`@CasePathable`"},{"inlineContent":[{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":" generates the same case-path members without adding"},{"type":"text","text":" "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" conformance. Compose it with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" when a destination-owning"},{"type":"text","text":" "},{"type":"text","text":"router also needs typed extraction:"}],"type":"paragraph"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","@CasePathable","enum SearchRoute {","    case result(id: String)","","    var destination: some View {","        Text(\"Search result\")","    }","}","","let route = SearchRoute.result(id: \"42\")","route[case: SearchRoute.Cases.result]  \/\/ Optional(\"42\")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"It is also useful on enums that are not routes at all but still need reusable"},{"type":"text","text":" "},{"type":"text","text":"case extraction."}],"type":"paragraph"},{"anchor":"Examples-vs-smoke-fixtures","type":"heading","level":2,"text":"Examples vs smoke fixtures"},{"inlineContent":[{"type":"text","text":"The repository intentionally builds both example layers:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Examples\/"},{"type":"text","text":" covers macro-first entry points and explicitly advanced Store \/"},{"type":"text","text":" "},{"type":"text","text":"Coordinator composition; every human-facing example has a SwiftPM build"},{"type":"text","text":" "},{"type":"text","text":"target."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ExamplesSmoke\/"},{"type":"text","text":" mirrors the public runtime surface with conservative"},{"type":"text","text":" "},{"type":"text","text":"fixtures. Its dedicated "},{"type":"codeVoice","code":"MacrosSmoke.swift"},{"type":"text","text":" target depends only on"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" and proves the one-product macro-first consumer contract."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Macro expansion itself is covered by "},{"type":"codeVoice","code":"InnoRouterMacrosTests"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterMacrosBehaviorTests"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Limitations-generic-enums","type":"heading","level":2,"text":"Limitations: generic enums"},{"inlineContent":[{"type":"text","text":"Both "},{"type":"codeVoice","code":"@Routable"},{"type":"text","text":" and "},{"type":"codeVoice","code":"@CasePathable"},{"type":"text","text":" reject generic enum declarations with an"},{"type":"text","text":" "},{"type":"text","text":"explicit compiler error:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@Routable","enum Generic<T> { case detail(T) } \/\/ error: @Routable does not support generic enum declarations"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The generated "},{"type":"codeVoice","code":"enum Cases"},{"type":"text","text":" would need to materialise "},{"type":"codeVoice","code":"CasePath<Self, T>"},{"type":"text","text":" "},{"type":"text","text":"members for each generic instantiation, but Swift does not propagate the"},{"type":"text","text":" "},{"type":"text","text":"parent’s generic parameters into a nested type that way. Diagnostic ID"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterMacro.E003"},{"type":"text","text":" is emitted on the generic parameter clause. See"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","isActive":true},{"type":"text","text":" for the complete diagnostic catalog."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This limitation does not apply to "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":". A constrained generic router is"},{"type":"text","text":" "},{"type":"text","text":"supported as long as its payloads satisfy the "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" requirements:"}],"type":"paragraph"},{"syntax":"swift compile","code":["import SwiftUI","import InnoRouter","","@Router","enum DetailRoute<Value: Hashable & Sendable> {","    case detail(Value)","","    var destination: some View {","        Text(\"Detail\")","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"If a case-path route needs a generic data shape, expose a concrete payload type"},{"type":"text","text":" "},{"type":"text","text":"from the non-generic route enum:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["struct DetailPayload<Value: Hashable & Sendable>: Hashable, Sendable {","    let value: Value","}","","typealias StringDetailPayload = DetailPayload<String>","","@Routable","enum AppRoute {","    case home","    case detail(StringDetailPayload)","}"],"type":"codeListing"}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"kind":"symbol","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","title":"InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/Macro-Diagnostics":{"type":"topic","title":"Macro diagnostics","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/Macro-Diagnostics","abstract":[{"type":"text","text":"Use the stable code printed at the start of an InnoRouter macro diagnostic to"},{"type":"text","text":" "},{"type":"text","text":"find the recovery without depending on the compiler’s surrounding wording."},{"type":"text","text":" "},{"type":"text","text":"Errors prevent the macro from emitting an incomplete routing contract."},{"type":"text","text":" "},{"type":"text","text":"Warnings identify valid code whose generated behavior is likely surprising or"},{"type":"text","text":" "},{"type":"text","text":"whose explicit declarations are redundant."}],"url":"\/documentation\/innoroutermacros\/macro-diagnostics","kind":"article","role":"article"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterMacros/InnoRouterMacros":{"type":"topic","title":"InnoRouterMacros","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterMacros\/InnoRouterMacros","abstract":[{"type":"text","text":"Build a typed SwiftUI router from an enum while keeping a manual runtime path"},{"type":"text","text":" "},{"type":"text","text":"available for advanced composition."}],"url":"\/documentation\/innoroutermacros\/innoroutermacros","kind":"article","role":"collectionGroup"}}}