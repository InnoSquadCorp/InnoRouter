terTesting\/TestExhaustivity\/off","title":"TestExhaustivity.off","url":"\/documentation\/innoroutertesting\/testexhaustivity\/off","kind":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"off","kind":"identifier"}]},"doc://com.innosquad.innorouter.docs.macros/SQ":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/SQ","title":"Swift.Equatable"},"doc://com.innosquad.innorouter.docs.macros/SH":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/SH","title":"Swift.Hashable","type":"unresolvable"},"doc://com.innosquad.innorouter.docs.macros/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/s8SendableP"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting/TestExhaustivity":{"abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"type":"text","text":" "},{"type":"text","text":"finishes."}],"title":"TestExhaustivity","kind":"symbol","type":"topic","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TestExhaustivity"}],"fragments":[{"text":"enum","kind":"keyword"},{"kind":"text","text":" "},{"text":"TestExhaustivity","kind":"identifier"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity","url":"\/documentation\/innoroutertesting\/testexhaustivity"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting/TestExhaustivity/Equatable-Implementations":{"title":"Equatable Implementations","role":"collectionGroup","url":"\/documentation\/innoroutertesting\/testexhaustivity\/equatable-implementations","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations","abstract":[],"kind":"article","type":"topic"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting/TestExhaustivity/strict":{"role":"symbol","type":"topic","abstract":[{"type":"text","text":"Every observed event must be drained through "},{"code":"receive(...)","type":"codeVoice"},{"type":"text","text":" before"},{"text":" ","type":"text"},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" or deallocation. Pending events fail the test. This is the"},{"text":" ","type":"text"},{"text":"default and matches TCA’s ","type":"text"},{"code":"exhaustive","type":"codeVoice"},{"text":" semantics.","type":"text"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict","title":"TestExhaustivity.strict","kind":"symbol","url":"\/documentation\/innoroutertesting\/testexhaustivity\/strict","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"strict"}]},"doc://com.innosquad.innorouter.docs.macros/s16SendableMetatypeP":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/s16SendableMetatypeP","type":"unresolvable","title":"Swift.SendableMetatype"}}}