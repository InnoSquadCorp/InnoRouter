{"relationshipsSections":[{"title":"Conforms To","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/SQ","doc:\/\/com.innosquad.innorouter.docs.macros\/SH","doc:\/\/com.innosquad.innorouter.docs.macros\/s8SendableP","doc:\/\/com.innosquad.innorouter.docs.macros\/s16SendableMetatypeP"],"type":"conformsTo","kind":"relationships"}],"abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"type":"text","text":" "},{"type":"text","text":"finishes."}],"sections":[],"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict"],"generated":true,"anchor":"Enumeration-Cases"},{"title":"Default Implementations","identifiers":["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"metadata":{"symbolKind":"enum","remoteSource":{"fileName":"TestExhaustivity.swift","url":"https:\/\/github.com\/InnoSquadCorp\/InnoRouter\/blob\/5.2.0\/Sources\/InnoRouterTesting\/TestExhaustivity.swift#L25"},"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Enumeration","externalID":"s:17InnoRouterTesting16TestExhaustivityO","role":"symbol","title":"TestExhaustivity","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}],"navigatorTitle":[{"kind":"identifier","text":"TestExhaustivity"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity"},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"symbol","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutertesting\/testexhaustivity"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting"]]},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}],"platforms":["macOS"],"languages":["swift"]}]},{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"type":"codeVoice","code":"TestStore"},{"type":"text","text":" exhaustivity model:"},{"type":"text","text":" "},{"type":"text","text":"events collected from the underlying authority’s unified "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"type":"codeVoice","code":".strict"},{"type":"text","text":" mode, the store reports events left pending at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"inlineContent":[{"type":"text","text":"unknown test"}],"type":"emphasis"},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}]}],"style":"note","type":"aside"}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.macros/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","kind":"symbol","title":"InnoRouterTesting","abstract":[],"role":"collection"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting/TestExhaustivity/off":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","abstract":[{"text":"The test store still delivers events through ","type":"text"},{"code":"receive(...)","type":"codeVoice"},{"text":", but pending","type":"text"},{"text":" ","type":"text"},{"text":"events at ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" or deallocation are silently discarded. Explicit","type":"text"},{"text":" ","type":"text"},{"text":"assertions and events emitted after ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" still report issues.","type":"text"},{"text":" ","type":"text"},{"text":"Useful for incremental migrations of large legacy suites.","type":"text"}],"url":"\/documentation\/innoroutertesting\/testexhaustivity\/off","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"off","kind":"identifier"}],"kind":"symbol","title":"TestExhaustivity.off","role":"symbol"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting/TestExhaustivity":{"abstract":[{"text":"Controls how strictly a test store checks pending events when observation","type":"text"},{"text":" ","type":"text"},{"text":"finishes.","type":"text"}],"type":"topic","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TestExhaustivity","kind":"identifier"}],"navigatorTitle":[{"text":"TestExhaustivity","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"TestExhaustivity","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity","url":"\/documentation\/innoroutertesting\/testexhaustivity"},"doc://com.innosquad.innorouter.docs.macros/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/s8SendableP","title":"Swift.Sendable"},"doc://com.innosquad.innorouter.docs.macros/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/SH"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting/TestExhaustivity/strict":{"abstract":[{"text":"Every observed event must be drained through ","type":"text"},{"type":"codeVoice","code":"receive(...)"},{"text":" before","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"finish()"},{"text":" or deallocation. Pending events fail the test. This is the","type":"text"},{"text":" ","type":"text"},{"text":"default and matches TCA’s ","type":"text"},{"type":"codeVoice","code":"exhaustive"},{"text":" semantics.","type":"text"}],"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"strict","kind":"identifier"}],"kind":"symbol","role":"symbol","title":"TestExhaustivity.strict","identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict","url":"\/documentation\/innoroutertesting\/testexhaustivity\/strict"},"doc://com.innosquad.innorouter.docs.macros/documentation/InnoRouterTesting/TestExhaustivity/Equatable-Implementations":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations","url":"\/documentation\/innoroutertesting\/testexhaustivity\/equatable-implementations","title":"Equatable Implementations","kind":"article","type":"topic","abstract":[],"role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.macros/SQ":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.macros\/SQ","title":"Swift.Equatable","type":"unresolvable"}}}