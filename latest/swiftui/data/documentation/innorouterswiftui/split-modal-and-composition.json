{"primaryContentSections":[{"content":[{"anchor":"Split-navigation","level":2,"text":"Split navigation","type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RouterSplitHost"},{"text":" for a macro-first sidebar\/detail layout. It owns the","type":"text"},{"text":" ","type":"text"},{"text":"detail stack and modal authority locally, builds destinations from the","type":"text"},{"text":" ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" enum, and exposes both through ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["RouterSplitHost(AppRoute.self) {","    SidebarView()","} root: {","    ContentUnavailableView(\"Select an item\", systemImage: \"sidebar.left\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"All stack and modal actions pass through the same "},{"type":"codeVoice","code":"FlowStore"},{"text":", so a push is","type":"text"},{"text":" ","type":"text"},{"text":"still rejected while a modal route is the flow tail. Use","type":"text"},{"text":" ","type":"text"},{"code":"NavigationSplitHost","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"CoordinatorSplitHost","type":"codeVoice"},{"text":" when the application must own","type":"text"},{"text":" ","type":"text"},{"text":"an advanced stack-only authority directly.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Important scope boundary:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"RouterSplitHost","type":"codeVoice"},{"text":" owns the detail stack and modal authority","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"advanced split hosts own only the detail stack"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"sidebar selection remains app-owned"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"column visibility remains system-managed"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"compact adaptation remains system-managed"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This keeps shell state out of the stack authority.","type":"text"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NavigationSplitHost"},{"type":"text","text":" and "},{"code":"CoordinatorSplitHost","type":"codeVoice"},{"type":"text","text":" are "},{"type":"strong","inlineContent":[{"type":"text","text":"unavailable on watchOS"}]},{"type":"text","text":" "},{"type":"text","text":"because SwiftUI’s "},{"code":"NavigationSplitView","type":"codeVoice"},{"type":"text","text":" is unavailable there. watchOS apps should fall back"},{"type":"text","text":" "},{"type":"text","text":"to "},{"code":"NavigationHost","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"CoordinatorHost","type":"codeVoice"},{"type":"text","text":" in the "},{"code":"#else","type":"codeVoice"},{"type":"text","text":" branch of a"},{"type":"text","text":" "},{"code":"#if !os(watchOS)","type":"codeVoice"},{"type":"text","text":" check."}]},{"type":"paragraph","inlineContent":[{"code":"RouterSplitHost","type":"codeVoice"},{"text":" remains visible to watchOS callers as an explicitly","type":"text"},{"text":" ","type":"text"},{"text":"unavailable declaration, whose compiler diagnostic directs macro-first code","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":".","type":"text"}]}],"type":"aside","style":"note","name":"Platform"},{"type":"heading","anchor":"Modal-navigation","level":2,"text":"Modal navigation"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":" when a feature needs only sheet and cover presentation:","type":"text"}]},{"type":"codeListing","code":["RouterModalHost(AppRoute.self) {","    ModalLauncher()","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When "},{"type":"codeVoice","code":"AppRoute"},{"type":"text","text":" has generated "},{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" mappings, the modal host presents a"},{"type":"text","text":" "},{"type":"text","text":"resolved incoming URL as a sheet automatically. Configure a different"},{"type":"text","text":" "},{"type":"text","text":"host-wide style when needed:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["RouterModalHost(AppRoute.self, deepLinkStyle: .fullScreenCover) {","    ModalLauncher()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Descendants use the same typed environment router as every other macro-first"},{"type":"text","text":" "},{"type":"text","text":"surface:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@EnvironmentRouter(AppRoute.self) private var router","","Button(\"Edit\") {","    router.sheet(.editor)","}","","Button(\"Preview\") {","    router.cover(.preview)","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":" owns its "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" locally and publishes only modal"},{"type":"text","text":" "},{"type":"text","text":"capability. An accidental "},{"type":"codeVoice","code":"go"},{"type":"text","text":" call therefore reports a missing navigation"},{"type":"text","text":" "},{"type":"text","text":"capability instead of silently inventing a stack."}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" with ","type":"text"},{"code":"ModalHost","type":"codeVoice"},{"text":" when restoration, middleware management, or","type":"text"},{"text":" ","type":"text"},{"text":"direct observation requires the application to own the modal authority.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS and tvOS, "},{"code":"ModalHost","type":"codeVoice"},{"text":" uses native ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"fullScreenCover","type":"codeVoice"},{"text":" presentation.","type":"text"},{"text":" ","type":"text"},{"text":"On other supported platforms, ","type":"text"},{"code":"fullScreenCover","type":"codeVoice"},{"text":" requests degrade to ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The advanced modal authority intentionally stays separate from a stack-only"},{"type":"text","text":" "},{"type":"text","text":"authority:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"modal intent uses ","type":"text"},{"code":"ModalIntent","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"stack intent uses ","type":"text"},{"code":"NavigationIntent","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"modal queue state lives in "},{"type":"codeVoice","code":"ModalStore"}]}]},{"content":[{"inlineContent":[{"text":"stack state lives in ","type":"text"},{"code":"NavigationStore","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modal queue rules are intentionally small:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"present","type":"codeVoice"},{"text":" shows immediately when no modal is active.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"present"},{"text":" appends to ","type":"text"},{"type":"codeVoice","code":"queuedPresentations"},{"text":" when another modal is","type":"text"},{"text":" ","type":"text"},{"text":"active.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"dismissCurrent","type":"codeVoice"},{"type":"text","text":" dismisses the active modal and promotes the first"},{"type":"text","text":" "},{"type":"text","text":"queued presentation, if one exists."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"dismissAll","type":"codeVoice"},{"type":"text","text":" clears both the active modal and the queue."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"replaceCurrent"},{"type":"text","text":" swaps only the active presentation and leaves the"},{"type":"text","text":" "},{"text":"queue untouched; observers receive ","type":"text"},{"type":"codeVoice","code":".replaced"},{"text":" before the command","type":"text"},{"text":" ","type":"text"},{"text":"interception event.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"code":"dismissCurrent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"dismissAll","type":"codeVoice"},{"text":" attempts enter modal middleware even when","type":"text"},{"text":" ","type":"text"},{"text":"there is no active presentation or queue. The resulting command can remain a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"no-op, be cancelled, or be rewritten by middleware; this matches direct"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" execution instead of hiding empty-state attempts in "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every convenience mutator reports its effective outcome as a"},{"type":"text","text":" "},{"type":"codeVoice","code":"@discardableResult"},{"text":": ","type":"text"},{"type":"codeVoice","code":"present"},{"text":" returns ","type":"text"},{"type":"codeVoice","code":"ModalPresentResult"},{"type":"text","text":", while"},{"type":"text","text":" "},{"code":"replaceCurrent","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dismissCurrent","type":"codeVoice"},{"type":"text","text":", and "},{"code":"dismissAll","type":"codeVoice"},{"type":"text","text":" return the same"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalExecutionResult"},{"type":"text","text":" that "},{"type":"codeVoice","code":"execute(_:)"},{"type":"text","text":" produces. Callers can branch on a"},{"type":"text","text":" "},{"type":"text","text":"middleware cancellation or an empty-state "},{"type":"codeVoice","code":".noop"},{"type":"text","text":" directly at the call site"},{"type":"text","text":" "},{"type":"text","text":"instead of subscribing to the event stream; call sites that ignore the"},{"type":"text","text":" "},{"type":"text","text":"result compile unchanged."}]},{"type":"paragraph","inlineContent":[{"text":"When middleware cancels a FlowStore modal preview, the captured participants","type":"text"},{"type":"text","text":" "},{"type":"text","text":"still receive "},{"code":"didExecute","type":"codeVoice"},{"type":"text","text":", observers receive "},{"type":"codeVoice","code":".commandIntercepted"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ModalQueueCancellationPolicy"},{"text":" is applied to the preview state. If that policy","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"changes the live queue, "},{"type":"codeVoice","code":".queueChanged"},{"type":"text","text":" is delivered before the interception"},{"type":"text","text":" "},{"type":"text","text":"and flow-level rejection. During an atomic reset, a cancellation previewed from"},{"type":"text","text":" "},{"type":"text","text":"an intermediate shadow is finalized with the actual live state that survived"},{"type":"text","text":" "},{"type":"text","text":"rollback. Successful navigation and modal previews that preceded that"},{"type":"text","text":" "},{"type":"text","text":"cancellation stay off the public "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" path and run their package-owned"},{"type":"text","text":" "},{"type":"text","text":"discard cleanup instead."}]},{"inlineContent":[{"type":"codeVoice","code":"alert"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"confirmationDialog"},{"text":" stay outside this framework surface and should remain feature-owned state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"ModalStoreConfiguration"},{"type":"text","text":" uses one "},{"type":"codeVoice","code":"onEvent"},{"text":" callback for the complete","type":"text"},{"type":"text","text":" "},{"type":"text","text":"modal observation surface:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let configuration = ModalStoreConfiguration<AppRoute>(","    onEvent: { event in","        switch event {","        case .presented(let presentation):","            analytics.recordPresented(presentation)","        case .dismissed(let presentation, let reason):","            analytics.recordDismissed(presentation, reason: reason)","        case .replaced(let old, let new):","            analytics.recordReplacement(from: old, to: new)","        case .queueChanged(let old, let new):","            diagnostics.recordQueueChange(from: old, to: new)","        case .commandIntercepted(let command, let result):","            diagnostics.record(command, result: result)","        case .middlewareMutation(let mutation):","            diagnostics.record(mutation)","        }","    }",")"]},{"type":"paragraph","inlineContent":[{"text":"When migrating to 5.0, merge the former modal lifecycle closures into","type":"text"},{"text":" ","type":"text"},{"text":"this switch. ","type":"text"},{"code":"ModalStore.events","type":"codeVoice"},{"text":" emits the same cases asynchronously.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Automatic URL handling pushes through "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" \/ "},{"code":"RouterSplitHost","type":"codeVoice"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"text","text":"presents through "},{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":", or selects through "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":"."},{"type":"text","text":" "},{"code":"RouterModalHost","type":"codeVoice"},{"type":"text","text":" applies one host-wide deep-link style; per-route presentation"},{"type":"text","text":" "},{"text":"policy still belongs at an application-owned flow boundary.","type":"text"}]},{"level":2,"text":"Composition","type":"heading","anchor":"Composition"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recommended composition rules are:"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Choose exactly one local macro-first authority for a route type in a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"subtree: "},{"type":"codeVoice","code":"RouterHost"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RouterModalHost"},{"text":", ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Put shell state such as tabs or app mode outside feature-local routing."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use distinct route types for nested authorities that must remain"},{"type":"text","text":" "},{"text":"independent.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Promote to "},{"type":"codeVoice","code":"NavigationHost"},{"text":", ","type":"text"},{"code":"ModalHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":", or a coordinator host","type":"text"},{"type":"text","text":" "},{"type":"text","text":"only when the application owns that state."}]}]},{"content":[{"inlineContent":[{"text":"Keep feature-local routing inside the destination that owns it.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Do not wrap "},{"type":"codeVoice","code":"RouterHost"},{"text":" in ","type":"text"},{"type":"codeVoice","code":"RouterModalHost"},{"text":" for the same route type:","type":"text"},{"type":"text","text":" "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" already owns both capabilities, and a nested same-route host"},{"type":"text","text":" "},{"type":"text","text":"replaces the outer authority for its subtree. These rules keep each authority"},{"text":" ","type":"text"},{"type":"text","text":"narrow without creating one application-wide store."}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"Split, modal, and composition patterns","modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/split-modal-and-composition"]}],"kind":"article","identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Split-Modal-and-Composition","interfaceLanguage":"swift"},"abstract":[{"text":"Choose one macro-first host for the local surface. ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"text":" unify stack and modal actions, ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":" narrows a","type":"text"},{"text":" ","type":"text"},{"text":"feature to modal actions, and ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"text":" owns native tab state.","type":"text"},{"text":" ","type":"text"},{"text":"Externally owned stores and coordinator hosts remain advanced authorities.","type":"text"}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","abstract":[],"role":"collection"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","kind":"article","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"text":" ","type":"text"},{"text":"coordinators, and typed ","type":"text"},{"type":"codeVoice","code":"EnvironmentRouter"},{"text":" actions for InnoRouter.","type":"text"}]}}}