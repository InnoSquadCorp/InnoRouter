{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Split-Modal-and-Composition"},"abstract":[{"type":"text","text":"Stack navigation, split detail navigation, and modal presentation are intentionally separate authorities."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/split-modal-and-composition"]}],"metadata":{"role":"article","title":"Split, modal, and composition patterns","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}]},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Split navigation","level":2,"anchor":"Split-navigation"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"NavigationSplitHost","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"CoordinatorSplitHost","type":"codeVoice"},{"text":" when the app has a sidebar\/detail layout.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Important scope boundary:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"InnoRouter owns only the detail stack"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"sidebar selection remains app-owned","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"column visibility remains app-owned"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"compact adaptation remains app-owned"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This keeps