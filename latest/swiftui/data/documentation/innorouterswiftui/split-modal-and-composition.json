{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article","title":"Split, modal, and composition patterns"},"sections":[],"primaryContentSections":[{"content":[{"text":"Split navigation","type":"heading","level":2,"anchor":"Split-navigation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"RouterSplitHost"},{"text":" for a macro-first sidebar\/detail layout. It owns the","type":"text"},{"text":" ","type":"text"},{"text":"detail stack and modal authority locally, builds destinations from the","type":"text"},{"text":" ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" enum, and exposes both through ","type":"text"},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":":"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["RouterSplitHost(AppRoute.self) {","    SidebarView()","} root: {","    ContentUnavailableView(\"Select an item\", systemImage: \"sidebar.left\")","}"]},{"inlineContent":[{"type":"text","text":"All stack and modal actions pass through the same "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", so a push is"},{"type":"text","text":" "},{"type":"text","text":"still rejected while a modal route is the flow tail. Use"},{"type":"text","text":" "},{"code":"NavigationSplitHost","type":"codeVoice"},{"type":"text","text":" or "},{"code":"CoordinatorSplitHost","type":"codeVoice"},{"text":" when the application must own","type":"text"},{"type":"text","text":" "},{"type":"text","text":"an advanced stack-only authority directly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Important scope boundary:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"RouterSplitHost","type":"codeVoice"},{"text":" owns the detail stack and modal authority","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"advanced split hosts own only the detail stack"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"sidebar selection remains app-owned","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"column visibility remains system-managed"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"compact adaptation remains system-managed"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"This keeps shell state out of the stack authority.","type":"text"}]},{"name":"Platform","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":""},{"type":"codeVoice","code":"NavigationSplitHost"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CoordinatorSplitHost"},{"type":"text","text":" are "},{"inlineContent":[{"text":"unavailable on watchOS","type":"text"}],"type":"strong"},{"text":" ","type":"text"},{"text":"because SwiftUI’s ","type":"text"},{"code":"NavigationSplitView","type":"codeVoice"},{"text":" is unavailable there. watchOS apps should fall back","type":"text"},{"text":" ","type":"text"},{"text":"to ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"CoordinatorHost","type":"codeVoice"},{"text":" in the ","type":"text"},{"code":"#else","type":"codeVoice"},{"text":" branch of a","type":"text"},{"text":" ","type":"text"},{"code":"#if !os(watchOS)","type":"codeVoice"},{"text":" check.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" remains visible to watchOS callers as an explicitly"},{"type":"text","text":" "},{"type":"text","text":"unavailable declaration, whose compiler diagnostic directs macro-first code"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":"."}]}],"style":"note"},{"level":2,"type":"heading","text":"Modal navigation","anchor":"Modal-navigation"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"RouterModalHost"},{"text":" when a feature needs only sheet and cover presentation:","type":"text"}]},{"code":["RouterModalHost(AppRoute.self) {","    ModalLauncher()","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Descendants use the same typed environment router as every other macro-first"},{"type":"text","text":" "},{"type":"text","text":"surface:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@EnvironmentRouter(AppRoute.self) private var router","","Button(\"Edit\") {","    router.sheet(.editor)","}","","Button(\"Preview\") {","    router.cover(.preview)","}"]},{"inlineContent":[{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":" owns its "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" locally and publishes only modal"},{"type":"text","text":" "},{"type":"text","text":"capability. An accidental "},{"type":"codeVoice","code":"go"},{"type":"text","text":" call therefore reports a missing navigation"},{"type":"text","text":" "},{"type":"text","text":"capability instead of silently inventing a stack."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" with "},{"type":"codeVoice","code":"ModalHost"},{"text":" when restoration, middleware management, or","type":"text"},{"text":" ","type":"text"},{"text":"direct observation requires the application to own the modal authority.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS and tvOS, "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" uses native "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":" and "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" presentation."},{"type":"text","text":" "},{"type":"text","text":"On other supported platforms, "},{"type":"codeVoice","code":"fullScreenCover"},{"type":"text","text":" requests degrade to "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The advanced modal authority intentionally stays separate from a stack-only","type":"text"},{"text":" ","type":"text"},{"text":"authority:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"modal intent uses "},{"type":"codeVoice","code":"ModalIntent"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"stack intent uses ","type":"text"},{"type":"codeVoice","code":"NavigationIntent"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"modal queue state lives in "},{"type":"codeVoice","code":"ModalStore"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"stack state lives in "},{"type":"codeVoice","code":"NavigationStore"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Modal queue rules are intentionally small:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"code":"present","type":"codeVoice"},{"type":"text","text":" shows immediately when no modal is active."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"present","type":"codeVoice"},{"text":" appends to ","type":"text"},{"code":"queuedPresentations","type":"codeVoice"},{"text":" when another modal is","type":"text"},{"text":" ","type":"text"},{"text":"active.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"dismissCurrent","type":"codeVoice"},{"type":"text","text":" dismisses the active modal and promotes the first"},{"type":"text","text":" "},{"type":"text","text":"queued presentation, if one exists."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dismissAll"},{"type":"text","text":" clears both the active modal and the queue."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"replaceCurrent","type":"codeVoice"},{"type":"text","text":" swaps only the active presentation and leaves the"},{"type":"text","text":" "},{"type":"text","text":"queue untouched; observers receive "},{"code":".replaced","type":"codeVoice"},{"type":"text","text":" before the command"},{"type":"text","text":" "},{"type":"text","text":"interception event."}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dismissCurrent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"dismissAll"},{"type":"text","text":" attempts enter modal middleware even when"},{"type":"text","text":" "},{"type":"text","text":"there is no active presentation or queue. The resulting command can remain a"},{"text":" ","type":"text"},{"text":"no-op, be cancelled, or be rewritten by middleware; this matches direct","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" execution instead of hiding empty-state attempts in "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"text","text":"When middleware cancels a FlowStore modal preview, the captured participants"},{"type":"text","text":" "},{"type":"text","text":"still receive "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":", observers receive "},{"type":"codeVoice","code":".commandIntercepted"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalQueueCancellationPolicy"},{"type":"text","text":" is applied to the preview state. If that policy"},{"type":"text","text":" "},{"type":"text","text":"changes the live queue, "},{"type":"codeVoice","code":".queueChanged"},{"type":"text","text":" is delivered before the interception"},{"type":"text","text":" "},{"type":"text","text":"and flow-level rejection. During an atomic reset, a cancellation previewed from"},{"type":"text","text":" "},{"type":"text","text":"an intermediate shadow is finalized with the actual live state that survived"},{"type":"text","text":" "},{"type":"text","text":"rollback. Successful navigation and modal previews that preceded that"},{"type":"text","text":" "},{"type":"text","text":"cancellation stay off the public "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" path and run their package-owned"},{"type":"text","text":" "},{"type":"text","text":"discard cleanup instead."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"alert"},{"type":"text","text":" and "},{"type":"codeVoice","code":"confirmationDialog"},{"type":"text","text":" stay outside this framework surface and should remain feature-owned state."}],"type":"paragraph"},{"inlineContent":[{"code":"ModalStoreConfiguration","type":"codeVoice"},{"type":"text","text":" uses one "},{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" callback for the complete"},{"type":"text","text":" "},{"type":"text","text":"modal observation surface:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let configuration = ModalStoreConfiguration<AppRoute>(","    onEvent: { event in","        switch event {","        case .presented(let presentation):","            analytics.recordPresented(presentation)","        case .dismissed(let presentation, let reason):","            analytics.recordDismissed(presentation, reason: reason)","        case .replaced(let old, let new):","            analytics.recordReplacement(from: old, to: new)","        case .queueChanged(let old, let new):","            diagnostics.recordQueueChange(from: old, to: new)","        case .commandIntercepted(let command, let result):","            diagnostics.record(command, result: result)","        case .middlewareMutation(let mutation):","            diagnostics.record(mutation)","        }","    }",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"When migrating to 5.0, merge the former modal lifecycle closures into"},{"type":"text","text":" "},{"type":"text","text":"this switch. "},{"type":"codeVoice","code":"ModalStore.events"},{"type":"text","text":" emits the same cases asynchronously."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" does not choose a modal presentation style. Automatic URL handling"},{"type":"text","text":" "},{"type":"text","text":"pushes through "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" or selects through"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":"; an application that needs a URL to open a sheet or cover must"},{"type":"text","text":" "},{"type":"text","text":"apply that policy at its flow boundary."}],"type":"paragraph"},{"level":2,"anchor":"Composition","text":"Composition","type":"heading"},{"inlineContent":[{"text":"The recommended composition rules are:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Choose exactly one local macro-first authority for a route type in a"},{"type":"text","text":" "},{"type":"text","text":"subtree: "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Put shell state such as tabs or app mode outside feature-local routing.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Use distinct route types for nested authorities that must remain","type":"text"},{"text":" ","type":"text"},{"text":"independent.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Promote to ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ModalHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":", or a coordinator host","type":"text"},{"text":" ","type":"text"},{"text":"only when the application owns that state.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Keep feature-local routing inside the destination that owns it.","type":"text"}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Do not wrap "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" in "},{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":" for the same route type:"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" already owns both capabilities, and a nested same-route host"},{"type":"text","text":" "},{"type":"text","text":"replaces the outer authority for its subtree. These rules keep each authority"},{"type":"text","text":" "},{"type":"text","text":"narrow without creating one application-wide store."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","variants":[{"paths":["\/documentation\/innorouterswiftui\/split-modal-and-composition"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Choose one macro-first host for the local surface. ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"RouterSplitHost","type":"codeVoice"},{"type":"text","text":" unify stack and modal actions, "},{"code":"RouterModalHost","type":"codeVoice"},{"type":"text","text":" narrows a"},{"text":" ","type":"text"},{"text":"feature to modal actions, and ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"type":"text","text":" owns native tab state."},{"type":"text","text":" "},{"type":"text","text":"Externally owned stores and coordinator hosts remain advanced authorities."}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Split-Modal-and-Composition","interfaceLanguage":"swift"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","role":"collection","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","abstract":[],"type":"topic"}}}