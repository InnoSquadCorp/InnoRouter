ade to "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"Modal routing intentionally stays separate from stack routing:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"modal intent uses "},{"type":"codeVoice","code":"ModalIntent"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"stack intent uses "},{"type":"codeVoice","code":"NavigationIntent"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"modal queue state lives in ","type":"text"},{"code":"ModalStore","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"stack state lives in "},{"type":"codeVoice","code":"NavigationStore"}]}]}]},{"inlineContent":[{"text":"Modal queue rules are intentionally small:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"present","type":"codeVoice"},{"text":" shows immediately when no modal is active.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"present"},{"type":"text","text":" appends to "},{"type":"codeVoice","code":"queuedPresentations"},{"type":"text","text":" when another modal is"},{"type":"text","text":" "},{"type":"text","text":"active."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"dismissCurrent"},{"text":" dismisses the active modal and promotes the first","type":"text"},{"text":" ","type":"text"},{"text":"queued presentation, if one exists.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"dismissAll","type":"codeVoice"},{"text":" clears both the active modal and the queue.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"replaceCurrent"},{"type":"text","text":" swaps only the active presentation and leaves the"},{"type":"text","text":" "},{"type":"text","text":"queue untouched; observers receive "},{"type":"codeVoice","code":".replaced"},{"type":"text","text":" before the command"},{"type":"text","text":" "},{"type":"text","text":"interception event."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"code":"alert","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"confirmationDialog","type":"codeVoice"},{"text":" stay outside this framework surface and should remain feature-owned state.","type":"text"}],"type":"paragraph"},{"text":"Composition","type":"heading","level":2,"anchor":"Composition"},{"inlineContent":[{"type":"text","text":"The recommended composition order is:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"shell state such as tabs or app mode","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" if modal routing should be shared"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NavigationHost","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"CoordinatorHost","type":"codeVoice"},{"text":" for stack routing","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"feature-local flow state inside a destination"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"This keeps each authority narrow and avoids one giant store owning every kind of navigation.","type":"text"}],"type":"paragraph"}]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter.","type":"text"}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","kind":"article","type":"topic","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://c