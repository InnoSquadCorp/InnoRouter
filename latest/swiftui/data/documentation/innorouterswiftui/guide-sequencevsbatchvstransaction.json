{"abstract":[{"type":"text","text":"Three ways to apply more than one navigation command in a row."},{"type":"text","text":" "},{"type":"text","text":"They are not interchangeable — pick the one whose contract matches"},{"type":"text","text":" "},{"type":"text","text":"the call site."}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Decision-matrix","type":"heading","level":2,"text":"Decision matrix"},{"rows":[[[{"inlineContent":[{"type":"text","text":"You want…"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Reach for","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Why","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"One observable change for multiple commands, best-effort"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore.executeBatch(_:stopOnFailure:)"}]}],[{"inlineContent":[{"type":"text","text":"Per-step results, exactly one "},{"type":"codeVoice","code":"onChange"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"events"},{"type":"text","text":" notification, optional fail-fast"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"All-or-nothing atomic apply with rollback on failure"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NavigationStore.executeTransaction(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Shadow-state preview, journal-based discard, single ","type":"text"},{"code":"onTransactionExecuted","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Express the composite as one "},{"type":"emphasis","inlineContent":[{"type":"text","text":"command"}]},{"type":"text","text":" that the engine can validate, plan, or rebuild"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NavigationCommand.sequence([...])","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Pure value composition; flows through "},{"type":"codeVoice","code":"NavigationEngine"},{"type":"text","text":" as a single command unit"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Schedule a single command after a quiet window","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DebouncingNavigator","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Async wrapping navigator, ","type":"text"},{"code":"Clock","type":"codeVoice"},{"text":"-injectable","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Rate-limit per key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ThrottleNavigationMiddleware"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Synchronous interception, last-accept timestamp","type":"text"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"anchor":"Mental-model","type":"heading","level":2,"text":"Mental model"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sequence"},{"text":" is a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"value"}]},{"type":"text","text":". It is just another "},{"type":"codeVoice","code":"NavigationCommand"},{"type":"text","text":" "},{"type":"text","text":"case, so it has the same semantics as any single command:"},{"type":"text","text":" "},{"type":"text","text":"deep-link planners can produce it, middleware can match against"},{"type":"text","text":" "},{"type":"text","text":"it, the engine evaluates it left-to-right and reports the"},{"type":"text","text":" "},{"type":"text","text":"component results as "},{"type":"codeVoice","code":".multiple([...])"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"code":"executeBatch","type":"codeVoice"},{"text":" is an ","type":"text"},{"inlineContent":[{"type":"text","text":"execution mode"}],"type":"strong"},{"text":". The store iterates the","type":"text"},{"text":" ","type":"text"},{"text":"commands, accepts partial success unless ","type":"text"},{"code":"stopOnFailure: true","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and coalesces observation: the SwiftUI state stays correct after","type":"text"},{"text":" ","type":"text"},{"text":"each step but only one ","type":"text"},{"code":"onChange","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" event surfaces at the","type":"text"},{"text":" ","type":"text"},{"text":"end. Use it for analytics-clean compound actions (“complete","type":"text"},{"text":" ","type":"text"},{"text":"checkout: replace stack + dismiss modal”).","type":"text"}]},{"inlineContent":[{"code":"executeTransaction","type":"codeVoice"},{"text":" is an ","type":"text"},{"inlineContent":[{"text":"atomicity mode","type":"text"}],"type":"strong"},{"text":". The store applies","type":"text"},{"text":" ","type":"text"},{"text":"each command to a shadow stack, journals what middleware accepted","type":"text"},{"text":" ","type":"text"},{"text":"or rejected, and only commits if every step succeeds. On failure,","type":"text"},{"text":" ","type":"text"},{"text":"the journal walks back through the discarded acceptances so","type":"text"},{"text":" ","type":"text"},{"text":"middleware see consistent before\/after states. Use it for","type":"text"},{"text":" ","type":"text"},{"text":"correctness-critical compound actions (“if any step rejects, the","type":"text"},{"text":" ","type":"text"},{"text":"user sees no half-applied state”).","type":"text"}],"type":"paragraph"},{"anchor":"Worked-examples","text":"Worked examples","level":2,"type":"heading"},{"anchor":"Compose-a-single-command-that-drives-a-deep-link-plan","text":"Compose a single command that drives a deep link plan","level":3,"type":"heading"},{"code":["let plan = NavigationPlan<AppRoute>(commands: [","    .replace([.home]),","    .push(.detail(id))","])","\/\/ Pass the plan to a single .sequence — the engine evaluates each","\/\/ component and reports `.multiple([...])` results.","let result = store.execute(.sequence(plan.commands))"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use when the deep-link planner already represents the path as a"},{"type":"text","text":" "},{"type":"text","text":"sequence of "},{"type":"codeVoice","code":"NavigationCommand"},{"type":"text","text":"s and you want the planner output"},{"type":"text","text":" "},{"type":"text","text":"to flow through the same code path as a single command."}],"type":"paragraph"},{"anchor":"Apply-a-checkout-flow-as-one-observable-step","text":"Apply a checkout flow as one observable step","level":3,"type":"heading"},{"syntax":"swift skip doc-fragment","code":["let batch = store.executeBatch([","    .replace([.home]),","    .push(.orderConfirmation),","], stopOnFailure: false)","\/\/ Exactly one `events` emission of `.batchExecuted(batch)`.","analytics.track(batch.events) \/\/ snapshot, no per-step amplification"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use when partial success is acceptable but every step must show"},{"type":"text","text":" "},{"type":"text","text":"up in the same analytics event."}],"type":"paragraph"},{"anchor":"KYC-step-requiring-all-or-nothing","level":3,"type":"heading","text":"KYC step requiring all-or-nothing"},{"syntax":"swift skip doc-fragment","code":["let transaction = store.executeTransaction([","    .replace([.kycRoot]),","    .push(.kycDocumentUpload),","    .push(.kycReview),","])","guard transaction.isCommitted else {","    \/\/ Stack is back to its pre-transaction state; show error.","    return","}"],"type":"codeListing"},{"inlineContent":[{"text":"Use when leaving the user on a half-rolled-out screen would be","type":"text"},{"text":" ","type":"text"},{"text":"worse than showing a “please retry” message.","type":"text"}],"type":"paragraph"},{"anchor":"Async-debounce-on-a-search-field","level":3,"type":"heading","text":"Async debounce on a search field"},{"syntax":"swift skip doc-fragment","code":["let debouncing = DebouncingNavigator(","    wrapping: store,","    interval: .milliseconds(300)",")","\/\/ Each keystroke calls debouncedExecute; only the latest survives.","await debouncing.debouncedExecute(.replace([.searchResults(query: q)]))"],"type":"codeListing"},{"inlineContent":[{"text":"Use when the user is generating commands faster than the","type":"text"},{"text":" ","type":"text"},{"text":"navigation surface should react.","type":"text"}],"type":"paragraph"},{"anchor":"Anti-patterns","level":2,"type":"heading","text":"Anti-patterns"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Wrapping ","type":"text"},{"code":"executeBatch","type":"codeVoice"},{"text":" in another ","type":"text"},{"code":"executeBatch","type":"codeVoice"},{"text":" to “compose”","type":"text"},{"text":" ","type":"text"},{"text":"events.","type":"text"}]},{"text":" Use ","type":"text"},{"type":"codeVoice","code":".sequence"},{"text":" inside one batch instead.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Calling ","type":"text"},{"code":"executeTransaction","type":"codeVoice"},{"text":" for analytics-clean grouping.","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"The shadow-state cost is wasted; reach for "},{"type":"codeVoice","code":"executeBatch"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Driving a debounce window from a middleware.","type":"text"}],"type":"strong"},{"text":" Middleware","type":"text"},{"text":" ","type":"text"},{"text":"cannot reliably re-dispatch the deferred command; that is what","type":"text"},{"text":" ","type":"text"},{"code":"DebouncingNavigator","type":"codeVoice"},{"text":" exists for.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"See-also","level":2,"type":"heading","text":"See also"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore"}]}]},{"content":[{"inlineContent":[{"code":"NavigationCommand","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ThrottleNavigationMiddleware"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"DebouncingNavigator"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article","title":"Choosing Between `.sequence`, `executeBatch`, and `executeTransaction`"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/guide-sequencevsbatchvstransaction"]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Guide-SequenceVsBatchVsTransaction","interfaceLanguage":"swift"},"kind":"article","sections":[],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","kind":"symbol","type":"topic","role":"collection","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","abstract":[]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter.","type":"text"}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","kind":"article","type":"topic","title":"InnoRouterSwiftUI","identifier":