:"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Express the composite as one ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"command","type":"text"}]},{"text":" that the engine can validate, plan, or rebuild","type":"text"}]}],[{"inlineContent":[{"code":"NavigationCommand.sequence([...])","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Pure value composition; flows through ","type":"text"},{"type":"codeVoice","code":"NavigationEngine"},{"text":" as a single command unit","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Schedule a single command after a quiet window"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DebouncingNavigator"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Async wrapping navigator, ","type":"text"},{"code":"Clock","type":"codeVoice"},{"text":"-injectable","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Rate-limit per key"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"ThrottleNavigationMiddleware"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Synchronous interception, last-accept timestamp"}],"type":"paragraph"}]]]},{"type":"heading","text":"Mental model","level":2,"anchor":"Mental-model"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sequence"},{"type":"text","text":" is a "},{"type":"strong","inlineContent":[{"type":"text","text":"value"}]},{"type":"text","text":". It is just another "},{"code":"NavigationCommand","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"case, so it has the same semantics as any single command:"},{"type":"text","text":" "},{"type":"text","text":"deep-link planners can produce it, middleware can match against"},{"type":"text","text":" "},{"type":"text","text":"it, the engine evaluates it left-to-right and reports the"},{"type":"text","text":" "},{"type":"text","text":"component results as "},{"code":".multiple([...])","type":"codeVoice"},{"type":"text","text":"."}]},{"inlineContent":[{"type":"codeVoice","code":"executeBatch"},{"text":" is an ","type":"text"},{"inlineContent":[{"type":"text","text":"execution mode"}],"type":"strong"},{"text":". The store iterates the","type":"text"},{"text":" ","type":"text"},{"text":"commands, accepts partial success unless ","type":"text"},{"type":"codeVoice","code":"stopOnFailure: true"},{"text":",","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and coalesces observation: the SwiftUI state stays correct after"},{"type":"text","text":" "},{"text":"each step but only one ","type":"text"},{"code":".changed","type":"codeVoice"},{"text":" event surfaces at the end, followed","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":".batchExecuted","type":"codeVoice"},{"text":", through both ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"events","type":"codeVoice"},{"text":". Use it for","type":"text"},{"text":" ","type":"text"},{"text":"analytics-clean compound actions (“complete","type":"text"},{"text":" ","type":"text"},{"text":"checkout: replace stack + dismiss modal”).","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"executeTransaction","type":"codeVoice"},{"text":" is an ","type":"text"},{"inlineContent":[{"type":"text","text":"atomicity mode"}],"type":"strong"},{"text":". The store applies","type":"text"},{"text":" ","type":"text"},{"text":"each command to a shadow stack, journals what middleware accepted","type":"text"},{"text":" ","type":"text"},{"text":"or rejected, and only commits if every step succeeds. On failure,","type":"text"},{"text":" ","type":"text"},{"text":"the journal walks back through the discarded acceptances so","type":"text"},{"text":" ","type":"text"},{"text":"middleware see consistent before\/after states. Use it for","type":"text"},{"text":" ","type":"text"},{"text":"correctness-critical compound actions (“if any step rejects, the","type":"text"},{"text":" ","type":"text"},{"text":"user sees no half-applied state”). An empty command list is not a","type":"text"},{"text":" ","type":"text"},{"text":"transactional success: it returns an uncommitted result with no","type":"text"},{"text":" ","type":"text"},{"text":"failure index because no command ran.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":".whenCancelled","type":"codeVoice"},{"type":"text","text":" adds a smaller savepoint "},{"inlineContent":[{"type":"text","text":"inside one command"}],"type":"emphasis"},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"primary and fallback each start from the same local snapshot, and","type":"text"},{"text":" ","type":"text"},{"text":"only one successful leg can change the stack. It does not turn a","type":"text"},{"text":" ","type":"text"},{"text":"surrounding batch into a transaction; later batch commands still","type":"text"},{"text":" ","type":"text"},{"text":"follow the batch’s continuation policy.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Worked examples","anchor":"Worked-examples"},{"type":"heading","level":3,"text":"Compose a single command that drives a deep link plan","anchor":"Compose-a-single-command-that-drives-a-deep-link-plan"},{"code":["let plan = NavigationPlan<AppRoute>(commands: [","    .replace([.home]),","    .push(.detail(id))","])","\/\/ Pass the plan to a single .sequence — the engine evaluates each","\/\/ component and reports `.multiple([...])` results.","let result = store.execute(.sequence(plan.commands))"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"Use when the deep-link planner already represents the path as a"},{"type":"text","text":" "},{"type":"text","text":"sequence of "},{"code":"NavigationCommand","type":"codeVoice"},{"type":"text","text":"s and you want the planner output"},{"type":"text","text":" "},{"type":"text","t