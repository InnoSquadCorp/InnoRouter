{"sections":[],"abstract":[{"text":"Three ways to apply more than one navigation command in a row.","type":"text"},{"text":" ","type":"text"},{"text":"They are not interchangeable — pick the one whose contract matches","type":"text"},{"text":" ","type":"text"},{"text":"the call site.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Decision matrix","type":"heading","level":2,"anchor":"Decision-matrix"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"You want…"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Reach for","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Why","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"One observable change for multiple commands, best-effort"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NavigationStore.executeBatch(_:stopOnFailure:)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Per-step results, one ","type":"text"},{"code":".changed","type":"codeVoice"},{"text":" plus one ","type":"text"},{"code":".batchExecuted","type":"codeVoice"},{"text":" observation, optional fail-fast","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"All-or-nothing atomic apply with rollback on failure"}],"type":"paragraph"}],[{"inlineContent":[{"code":"NavigationStore.executeTransaction(_:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Shadow-state preview, journal-based discard, one "},{"code":".transactionExecuted","type":"codeVoice"},{"type":"text","text":" observation"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Express the composite as one "},{"type":"emphasis","inlineContent":[{"type":"text","text":"command"}]},{"type":"text","text":" that the engine can validate, plan, or rebuild"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"NavigationCommand.sequence([...])"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Pure value composition; flows through "},{"type":"codeVoice","code":"NavigationEngine"},{"type":"text","text":" as a single command unit"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Schedule a single command after a quiet window"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DebouncingNavigator","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Async wrapping navigator, "},{"type":"codeVoice","code":"Clock"},{"type":"text","text":"-injectable"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Rate-limit per key","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ThrottleNavigationMiddleware","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Synchronous interception, last-accept timestamp"}],"type":"paragraph"}]]],"header":"row"},{"type":"heading","level":2,"text":"Mental model","anchor":"Mental-model"},{"type":"paragraph","inlineContent":[{"code":".sequence","type":"codeVoice"},{"text":" is a ","type":"text"},{"inlineContent":[{"type":"text","text":"value"}],"type":"strong"},{"text":". It is just another ","type":"text"},{"code":"NavigationCommand","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"case, so it has the same semantics as any single command:"},{"type":"text","text":" "},{"type":"text","text":"deep-link planners can produce it, middleware can match against"},{"type":"text","text":" "},{"type":"text","text":"it, the engine evaluates it left-to-right and reports the"},{"type":"text","text":" "},{"type":"text","text":"component results as "},{"type":"codeVoice","code":".multiple([...])"},{"type":"text","text":"."}]},{"inlineContent":[{"code":"executeBatch","type":"codeVoice"},{"text":" is an ","type":"text"},{"inlineContent":[{"type":"text","text":"execution mode"}],"type":"strong"},{"text":". The store iterates the","type":"text"},{"text":" ","type":"text"},{"text":"commands, accepts partial success unless ","type":"text"},{"code":"stopOnFailure: true","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"and coalesces observation: the SwiftUI state stays correct after","type":"text"},{"text":" ","type":"text"},{"text":"each step but only one ","type":"text"},{"code":".changed","type":"codeVoice"},{"text":" event surfaces at the end, followed","type":"text"},{"text":" ","type":"text"},{"text":"by ","type":"text"},{"code":".batchExecuted","type":"codeVoice"},{"text":", through both ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"events","type":"codeVoice"},{"text":". Use it for","type":"text"},{"text":" ","type":"text"},{"text":"analytics-clean compound actions (“complete","type":"text"},{"text":" ","type":"text"},{"text":"checkout: replace stack + dismiss modal”).","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"executeTransaction"},{"type":"text","text":" is an "},{"type":"strong","inlineContent":[{"type":"text","text":"atomicity mode"}]},{"type":"text","text":". The store applies"},{"type":"text","text":" "},{"type":"text","text":"each command to a shadow stack, journals what middleware accepted"},{"type":"text","text":" "},{"type":"text","text":"or rejected, and only commits if every step succeeds. On failure,"},{"type":"text","text":" "},{"type":"text","text":"the journal walks back through the discarded acceptances so"},{"type":"text","text":" "},{"type":"text","text":"middleware see consistent before\/after states. Use it for"},{"type":"text","text":" "},{"type":"text","text":"correctness-critical compound actions (“if any step rejects, the"},{"type":"text","text":" "},{"type":"text","text":"user sees no half-applied state”). An empty command list is not a"},{"type":"text","text":" "},{"type":"text","text":"transactional success: it returns an uncommitted result with no"},{"type":"text","text":" "},{"type":"text","text":"failure index because no command ran."}]},{"type":"paragraph","inlineContent":[{"code":".whenCancelled","type":"codeVoice"},{"text":" adds a smaller savepoint ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"inside one command","type":"text"}]},{"text":":","type":"text"},{"text":" ","type":"text"},{"text":"primary and fallback each start from the same local snapshot, and","type":"text"},{"text":" ","type":"text"},{"text":"only one successful leg can change the stack. It does not turn a","type":"text"},{"text":" ","type":"text"},{"text":"surrounding batch into a transaction; later batch commands still","type":"text"},{"text":" ","type":"text"},{"text":"follow the batch’s continuation policy.","type":"text"}]},{"anchor":"Worked-examples","level":2,"type":"heading","text":"Worked examples"},{"anchor":"Compose-a-single-command-that-drives-a-deep-link-plan","level":3,"type":"heading","text":"Compose a single command that drives a deep link plan"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let plan = NavigationPlan<AppRoute>(commands: [","    .replace([.home]),","    .push(.detail(id))","])","\/\/ Pass the plan to a single .sequence — the engine evaluates each","\/\/ component and reports `.multiple([...])` results.","let result = store.execute(.sequence(plan.commands))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use when the deep-link planner already represents the path as a"},{"type":"text","text":" "},{"type":"text","text":"sequence of "},{"code":"NavigationCommand","type":"codeVoice"},{"type":"text","text":"s and you want the planner output"},{"type":"text","text":" "},{"type":"text","text":"to flow through the same code path as a single command."}]},{"anchor":"Apply-a-checkout-flow-as-one-observable-step","level":3,"type":"heading","text":"Apply a checkout flow as one observable step"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let batch = store.executeBatch([","    .replace([.home]),","    .push(.orderConfirmation),","], stopOnFailure: false)","\/\/ Exactly one `events` emission of `.batchExecuted(batch)`.","analytics.track(batch.events) \/\/ snapshot, no per-step amplification"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use when partial success is acceptable but every step must show"},{"type":"text","text":" "},{"type":"text","text":"up in the same analytics event."}]},{"anchor":"KYC-step-requiring-all-or-nothing","level":3,"type":"heading","text":"KYC step requiring all-or-nothing"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let transaction = store.executeTransaction([","    .replace([.kycRoot]),","    .push(.kycDocumentUpload),","    .push(.kycReview),","])","guard transaction.isCommitted else {","    \/\/ Stack is back to its pre-transaction state; show error.","    return","}"]},{"type":"paragraph","inlineContent":[{"text":"Use when leaving the user on a half-rolled-out screen would be","type":"text"},{"text":" ","type":"text"},{"text":"worse than showing a “please retry” message.","type":"text"}]},{"anchor":"Async-debounce-on-a-search-field","level":3,"type":"heading","text":"Async debounce on a search field"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let debouncing = DebouncingNavigator(","    wrapping: store,","    interval: .milliseconds(300)",")","\/\/ Each keystroke calls debouncedExecute; only the latest survives.","await debouncing.debouncedExecute(.replace([.searchResults(query: q)]))"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use when the user is generating commands faster than the"},{"type":"text","text":" "},{"type":"text","text":"navigation surface should react."}]},{"anchor":"Anti-patterns","level":2,"type":"heading","text":"Anti-patterns"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wrapping "},{"type":"codeVoice","code":"executeBatch"},{"type":"text","text":" in another "},{"type":"codeVoice","code":"executeBatch"},{"type":"text","text":" to “compose”"},{"type":"text","text":" "},{"type":"text","text":"events."}]},{"type":"text","text":" Use "},{"code":".sequence","type":"codeVoice"},{"type":"text","text":" inside one batch instead."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Calling "},{"type":"codeVoice","code":"executeTransaction"},{"type":"text","text":" for analytics-clean grouping."}]},{"type":"text","text":" "},{"type":"text","text":"The shadow-state cost is wasted; reach for "},{"type":"codeVoice","code":"executeBatch"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Driving a debounce window from a middleware.","type":"text"}]},{"type":"text","text":" Middleware"},{"type":"text","text":" "},{"type":"text","text":"cannot reliably re-dispatch the deferred command; that is what"},{"type":"text","text":" "},{"type":"codeVoice","code":"DebouncingNavigator"},{"type":"text","text":" exists for."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"See-also","level":2,"text":"See also"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NavigationCommand","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"ThrottleNavigationMiddleware","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"DebouncingNavigator","type":"codeVoice"}]}]}]}]}],"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Choosing Between `.sequence`, `executeBatch`, and `executeTransaction`"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/guide-sequencevsbatchvstransaction"]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swif