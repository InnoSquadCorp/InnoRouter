{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/guide-sequencevsbatchvstransaction"]}],"abstract":[{"type":"text","text":"Three ways to apply more than one navigation command in a row."},{"type":"text","text":" "},{"type":"text","text":"They are not interchangeable — pick the one whose contract matches"},{"type":"text","text":" "},{"type":"text","text":"the call site."}],"sections":[],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Guide-SequenceVsBatchVsTransaction","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"title":"Choosing Between `.sequence`, `executeBatch`, and `executeTransaction`","role":"article","roleHeading":"Article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"kind":"article","primaryContentSections":[{"content":[{"level":2,"anchor":"Decision-matrix","text":"Decision matrix","type":"heading"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"You want…"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Reach for","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Why"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"One observable change for multiple commands, best-effort"}]}],[{"inlineContent":[{"type":"codeVoice","code":"NavigationStore.executeBatch(_:stopOnFailure:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Per-step results, one ","type":"text"},{"code":".changed","type":"codeVoice"},{"text":" plus one ","type":"text"},{"code":".batchExecuted","type":"codeVoice"},{"text":" observation, optional fail-fast","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"All-or-nothing atomic apply with rollback on failure"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore.executeTransaction(_:)"}]}],[{"type":"paragraph","inlineContent":[{"text":"Shadow-state preview, journal-based discard, one ","type":"text"},{"code":".transactionExecuted","type":"codeVoice"},{"text":" observation","type":"text"}]}]],[[{"inlineContent":[{"type":"text","text":"Express the composite as one "},{"type":"emphasis","inlineContent":[{"text":"command","type":"text"}]},{"type":"text","text":" that the engine can validate, plan, or rebuild"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"NavigationCommand.sequence([...])","type":"codeVoice"}]}],[{"inlineContent":[{"text":"Pure value composition; flows through ","type":"text"},{"code":"NavigationEngine","type":"codeVoice"},{"type":"text","text":" as a single command unit"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Schedule a single command after a quiet window"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"DebouncingNavigator"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Async wrapping navigator, ","type":"text"},{"code":"Clock","type":"codeVoice"},{"text":"-injectable","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Rate-limit per key"}],"type":"paragraph"}],[{"inlineContent":[{"code":"ThrottleNavigationMiddleware","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Synchronous interception, last-accept timestamp"}],"type":"paragraph"}]]],"header":"row"},{"anchor":"Mental-model","type":"heading","level":2,"text":"Mental model"},{"type":"paragraph","inlineContent":[{"code":".sequence","type":"codeVoice"},{"text":" is a ","type":"text"},{"inlineContent":[{"type":"text","text":"value"}],"type":"strong"},{"text":". It is just another ","type":"text"},{"code":"NavigationCommand","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"case, so it has the same semantics as any single command:"},{"text":" ","type":"text"},{"type":"text","text":"deep-link planners can produce it, middleware can match against"},{"type":"text","text":" "},{"type":"text","text":"it, the engine evaluates it left-to-right and reports the"},{"type":"text","text":" "},{"type":"text","text":"component results as "},{"type":"codeVoice","code":".multiple([...])"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"code":"executeBatch","type":"codeVoice"},{"text":" is an ","type":"text"},{"inlineContent":[{"type":"text","text":"execution mode"}],"type":"strong"},{"text":". The store iterates the","type":"text"},{"text":" ","type":"text"},{"text":"commands, accepts partial success unless ","type":"text"},{"code":"stopOnFailure: true","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and coalesces observation: the SwiftUI state stays correct after"},{"type":"text","text":" "},{"type":"text","text":"each step but only one "},{"code":".changed","type":"codeVoice"},{"type":"text","text":" event surfaces at the end, followed"},{"type":"text","text":" "},{"type":"text","text":"by "},{"code":".batchExecuted","type":"codeVoice"},{"type":"text","text":", through both "},{"code":"onEvent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"events","type":"codeVoice"},{"text":". Use it for","type":"text"},{"text":" ","type":"text"},{"text":"analytics-clean compound actions (“complete","type":"text"},{"text":" ","type":"text"},{"text":"checkout: replace stack + dismiss modal”).","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"executeTransaction","type":"codeVoice"},{"text":" is an ","type":"text"},{"inlineContent":[{"type":"text","text":"atomicity mode"}],"type":"strong"},{"text":". The store applies","type":"text"},{"text":" ","type":"text"},{"text":"each command to a shadow stack, journals what middleware accepted","type":"text"},{"text":" ","type":"text"},{"text":"or rejected, and only commits if every step succeeds. On failure,","type":"text"},{"text":" ","type":"text"},{"text":"the journal walks back through the discarded acceptances so","type":"text"},{"text":" ","type":"text"},{"text":"middleware see consistent before\/after states. Use it for","type":"text"},{"text":" ","type":"text"},{"text":"correctness-critical compound actions (“if any step rejects, the","type":"text"},{"text":" ","type":"text"},{"text":"user sees no half-applied state”). An empty command list is not a","type":"text"},{"text":" ","type":"text"},{"text":"transactional success: it returns an uncommitted result with no","type":"text"},{"text":" ","type":"text"},{"text":"failure index because no command ran.","type":"text"}]},{"inlineContent":[{"code":".whenCancelled","type":"codeVoice"},{"type":"text","text":" adds a smaller savepoint "},{"inlineContent":[{"type":"text","text":"inside one command"}],"type":"emphasis"},{"type":"text","text":":"},{"type":"text","text":" "},{"type":"text","text":"primary and fallback each start from the same local snapshot, and"},{"type":"text","text":" "},{"type":"text","text":"only one successful leg can change the stack. It does not turn a"},{"type":"text","text":" "},{"type":"text","text":"surrounding batch into a transaction; later batch commands still"},{"type":"text","text":" "},{"type":"text","text":"follow the batch’s continuation policy."}],"type":"paragraph"},{"anchor":"Worked-examples","type":"heading","level":2,"text":"Worked examples"},{"anchor":"Compose-a-single-command-that-drives-a-deep-link-plan","type":"heading","level":3,"text":"Compose a single command that drives a deep link plan"},{"syntax":"swift skip doc-fragment","code":["let plan = NavigationPlan<AppRoute>(commands: [","    .replace([.home]),","    .push(.detail(id))","])","\/\/ Pass the plan to a single .sequence — the engine evaluates each","\/\/ component and reports `.multiple([...])` results.","let result = store.execute(.sequence(plan.commands))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use when the deep-link planner already represents the path as a"},{"type":"text","text":" "},{"type":"text","text":"sequence of "},{"type":"codeVoice","code":"NavigationCommand"},{"type":"text","text":"s and you want the planner output"},{"type":"text","text":" "},{"type":"text","text":"to flow through the same code path as a single command."}],"type":"paragraph"},{"level":3,"anchor":"Apply-a-checkout-flow-as-one-observable-step","text":"Apply a checkout flow as one observable step","type":"heading"},{"syntax":"swift skip doc-fragment","code":["let batch = store.executeBatch([","    .replace([.home]),","    .push(.orderConfirmation),","], stopOnFailure: false)","\/\/ Exactly one `events` emission of `.batchExecuted(batch)`.","analytics.track(batch.events) \/\/ snapshot, no per-step amplification"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use when partial success is acceptable but every step must show"},{"type":"text","text":" "},{"type":"text","text":"up in the same analytics event."}],"type":"paragraph"},{"level":3,"anchor":"KYC-step-requiring-all-or-nothing","text":"KYC step requiring all-or-nothing","type":"heading"},{"syntax":"swift skip doc-fragment","code":["let transaction = store.executeTransaction([","    .replace([.kycRoot]),","    .push(.kycDocumentUpload),","    .push(.kycReview),","])","guard transaction.isCommitted else {","    \/\/ Stack is back to its pre-transaction state; show error.","    return","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use when leaving the user on a half-rolled-out screen would be"},{"type":"text","text":" "},{"type":"text","text":"worse than showing a “please retry” message."}],"type":"paragraph"},{"level":3,"anchor":"Async-debounce-on-a-search-field","text":"Async debounce on a search field","type":"heading"},{"syntax":"swift skip doc-fragment","code":["let debouncing = DebouncingNavigator(","    wrapping: store,","    interval: .milliseconds(300)",")","\/\/ Each keystroke calls debouncedExecute; only the latest survives.","await debouncing.debouncedExecute(.replace([.searchResults(query: q)]))"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use when the user is generating commands faster than the"},{"type":"text","text":" "},{"type":"text","text":"navigation surface should react."}],"type":"paragraph"},{"level":2,"anchor":"Anti-patterns","text":"Anti-patterns","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Wrapping "},{"type":"codeVoice","code":"executeBatch"},{"type":"text","text":" in another "},{"code":"executeBatch","type":"codeVoice"},{"text":" to “compose”","type":"text"},{"text":" ","type":"text"},{"text":"events.","type":"text"}]},{"type":"text","text":" Use "},{"type":"codeVoice","code":".sequence"},{"type":"text","text":" inside one batch instead."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Calling ","type":"text"},{"code":"executeTransaction","type":"codeVoice"},{"text":" for analytics-clean grouping.","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"The shadow-state cost is wasted; reach for "},{"type":"codeVoice","code":"executeBatch"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Driving a debounce window from a middleware.","type":"text"}]},{"type":"text","text":" Middleware"},{"type":"text","text":" "},{"type":"text","text":"cannot reliably re-dispatch the deferred command; that is what"},{"type":"text","text":" "},{"type":"codeVoice","code":"DebouncingNavigator"},{"type":"text","text":" exists for."}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"See-also","level":2,"type":"heading","text":"See also"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"NavigationStore"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NavigationCommand"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ThrottleNavigationMiddleware"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"DebouncingNavigator"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"kind":"article","title":"InnoRouterSwiftUI","type":"topic"}}}