ext"},{"text":"navigation surface should react.","type":"text"}]},{"anchor":"Anti-patterns","type":"heading","text":"Anti-patterns","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Wrapping ","type":"text"},{"code":"executeBatch","type":"codeVoice"},{"text":" in another ","type":"text"},{"code":"executeBatch","type":"codeVoice"},{"text":" to “compose”","type":"text"},{"text":" ","type":"text"},{"text":"events.","type":"text"}]},{"type":"text","text":" Use "},{"code":".sequence","type":"codeVoice"},{"type":"text","text":" inside one batch instead."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Calling ","type":"text"},{"type":"codeVoice","code":"executeTransaction"},{"text":" for analytics-clean grouping.","type":"text"}]},{"type":"text","text":" "},{"type":"text","text":"The shadow-state cost is wasted; reach for "},{"type":"codeVoice","code":"executeBatch"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Driving a debounce window from a middleware.","type":"text"}]},{"type":"text","text":" Middleware"},{"type":"text","text":" "},{"type":"text","text":"cannot reliably re-dispatch the deferred command; that is what"},{"type":"text","text":" "},{"code":"DebouncingNavigator","type":"codeVoice"},{"text":" exists for.","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"See-also","type":"heading","text":"See also"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationCommand"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ThrottleNavigationMiddleware"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"DebouncingNavigator"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"abstract":[