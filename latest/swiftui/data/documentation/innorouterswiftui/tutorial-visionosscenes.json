{"metadata":{"title":"visionOS: windows, volumetric scenes, immersive spaces, and ornaments","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"abstract":[{"type":"text","text":"Coordinate visionOS spatial presentations through "},{"code":"SceneStore","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"SceneHost","type":"codeVoice"},{"type":"text","text":", and "},{"code":"innoRouterOrnament","type":"codeVoice"},{"type":"text","text":"."}],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"visionOS exposes three distinct “scene” primitives that are not"},{"type":"text","text":" "},{"type":"text","text":"modelled by "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a regular window, declared with "},{"code":"WindowGroup(id:for:)","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"a volumetric window, declared with ","type":"text"},{"code":"WindowGroup(id:for:).windowStyle(.volumetric)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"an immersive space, declared with "},{"code":"ImmersiveSpace(id:)","type":"codeVoice"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"SwiftUI’s openers for these ("},{"code":"@Environment(\\.openWindow)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"@Environment(\\.openImmersiveSpace)","type":"codeVoice"},{"type":"text","text":", "},{"code":"@Environment(\\.dismissImmersiveSpace)","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"@Environment(\\.dismissWindow)","type":"codeVoice"},{"type":"text","text":") are only reachable from a view’s"},{"type":"text","text":" "},{"code":"body","type":"codeVoice"},{"type":"text","text":". InnoRouter provides a thin "},{"code":"SceneStore","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"SceneHost","type":"codeVoice"},{"type":"text","text":" pair"},{"type":"text","text":" "},{"type":"text","text":"that mirrors the "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"NavigationHost","type":"codeVoice"},{"type":"text","text":" discipline:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"the store owns the desired scene state and publishes intents"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"the host sits in the view tree and translates intents into the"},{"type":"text","text":" "},{"type":"text","text":"matching environment action"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"subscribers observe outcomes through "},{"code":"SceneStore.events","type":"codeVoice"}],"type":"paragraph"}]}]},{"anchor":"Declaring-scenes-in-your-App","text":"Declaring scenes in your App","type":"heading","level":2},{"syntax":"swift skip doc-fragment","code":["import SwiftUI","","import InnoRouter","import InnoRouterMacros","","@Routable","enum SpatialRoute {","    case main","    case theatre","}","","private let spatialScenes = SceneRegistry<SpatialRoute>(","    .window(.main, id: \"main\"),","    .immersive(.theatre, id: \"theatre\", style: .mixed)",")","","@main","struct MyApp: App {","    @State private var sceneStore = SceneStore<SpatialRoute>()","","    var body: some Scene {","        \/\/ Host-owned scene: SceneHost only. Do NOT also attach a","        \/\/ SceneAnchor here — the host already reconciles its own","        \/\/ scene's lifecycle, and a redundant anchor registers a","        \/\/ fallback dispatcher on the scene the host already owns.","        WindowGroup(id: \"main\", for: UUID.self) { $sceneID in","            ContentView()","                .innoRouterSceneHost(","                    sceneStore,","                    scenes: spatialScenes,","                    attachedTo: .main,","                    instanceID: sceneID","                )","        } defaultValue: {","            UUID()","        }","","        \/\/ Non-host scene: SceneAnchor only. Keeps the store's","        \/\/ inventory in sync with system-driven appear\/disappear and","        \/\/ can temporarily serve dismissals if the host scene is gone;","        \/\/ fallback opens are still limited to the same scene.","        ImmersiveSpace(id: \"theatre\") {","            TheatreView()","                .innoRouterSceneAnchor(","                    sceneStore,","                    scenes: spatialScenes,","                    attachedTo: .theatre","                )","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The shared "},{"code":"SceneRegistry","type":"codeVoice"},{"type":"text","text":" keeps route-to-id mapping and declaration"},{"type":"text","text":" "},{"type":"text","text":"metadata in one place."}],"type":"paragraph"},{"anchor":"Which-modifier-goes-where","text":"Which modifier goes where?","type":"heading","level":3},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"Scene declaration","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"SceneHost"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Attach ","type":"text"},{"code":"SceneAnchor","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"The app’s primary "},{"type":"codeVoice","code":"WindowGroup"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅ exactly once","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌ redundant"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Secondary ","type":"text"},{"type":"codeVoice","code":"WindowGroup"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌"}],"type":"paragraph"}],[{"inlineContent":[{"text":"✅","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ImmersiveSpace"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Any scene that isn’t the host’s scene","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"❌"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"✅"}],"type":"paragraph"}]]]},{"inlineContent":[{"type":"text","text":"A mnemonic: "},{"type":"strong","inlineContent":[{"type":"text","text":"“one host per store, one anchor per non-host scene”"}]},{"type":"text","text":"."},{"type":"text","text":" "},{"code":"SceneHost","type":"codeVoice"},{"type":"text","text":" is the single primary dispatcher; "},{"code":"SceneAnchor","type":"codeVoice"},{"type":"text","text":" is a"},{"type":"text","text":" "},{"type":"text","text":"lifecycle reconciler that also serves as a restricted fallback"},{"type":"text","text":" "},{"type":"text","text":"dispatcher for its own scene. Fallback anchors are deliberately"},{"type":"text","text":" "},{"type":"text","text":"limited to same-scene opens and any dismissal — a cross-scene open"},{"type":"text","text":" "},{"type":"text","text":"arriving while the host is gone is rejected with"},{"type":"text","text":" "},{"code":"SceneRejectionReason.fallbackCannotDispatch","type":"codeVoice"},{"type":"text","text":" so the queue advances"},{"type":"text","text":" "},{"type":"text","text":"rather than silently succeeding on a scene the anchor can’t reach."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Window and volumetric host or anchor scenes use the "},{"code":"UUID","type":"codeVoice"},{"type":"text","text":" supplied by"},{"type":"text","text":" "},{"type":"text","text":"a value-based "},{"code":"WindowGroup","type":"codeVoice"},{"type":"text","text":"; immersive spaces keep the route-only"},{"type":"text","text":" "},{"type":"text","text":"overloads."}]},{"text":"Opening and dismissing scenes","level":2,"type":"heading","anchor":"Opening-and-dismissing-scenes"},{"type":"paragraph","inlineContent":[{"text":"From anywhere that holds a reference to the store:","type":"text"}]},{"code":["\/\/ In the main window:","let mainWindow = sceneStore.openWindow(.main)","sceneStore.openImmersive(.theatre, style: .mixed)","","\/\/ Somewhere else later:","sceneStore.dismissWindow(mainWindow)","sceneStore.dismissImmersive()"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"VolumetricSize"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"ImmersiveStyle"},{"text":" are declaration-backed metadata,","type":"text"},{"text":" ","type":"text"},{"text":"not dynamic environment parameters. If a request’s kind, size, or","type":"text"},{"text":" ","type":"text"},{"text":"style does not match the registry entry, the host emits","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"SceneEvent.rejected(.open(...), reason: .sceneDeclarationMismatch)"},{"text":" ","type":"text"},{"text":"and leaves the active scene inventory untouched.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"SceneHost","type":"codeVoice"},{"text":" modifier is the preferred primary dispatcher: it","type":"text"},{"text":" ","type":"text"},{"text":"observes pending request tokens, claims work, dispatches through the","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI environment, and reports success back into the store.","type":"text"},{"text":" ","type":"text"},{"code":"SceneAnchor","type":"codeVoice"},{"text":" mirrors that dispatch loop as a fallback only when no","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"explicit host is currently alive. If "},{"code":"openImmersiveSpace","type":"codeVoice"},{"type":"text","text":" returns"},{"type":"text","text":" "},{"code":".userCancelled","type":"codeVoice"},{"type":"text","text":" or "},{"code":".error","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"the host emits a"},{"type":"text","text":" "},{"code":"SceneEvent.rejected(.open(.immersive(...)), reason: .environmentReturnedFailure)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and leaves the active scene inventory untouched. "},{"code":"currentScene","type":"codeVoice"},{"type":"text","text":" remains"},{"type":"text","text":" "},{"type":"text","text":"a recency-ordered summary of that inventory, while "},{"code":"activeScenes","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"exposes the full inventory. Calling "},{"code":"dismissImmersive()","type":"codeVoice"},{"type":"text","text":" without an active"},{"type":"text","text":" "},{"type":"text","text":"immersive scene emits"},{"type":"text","text":" "},{"code":"SceneEvent.rejected(.dismissImmersive, reason: .nothingActive)","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"code":"SceneAnchor","type":"codeVoice"},{"type":"text","text":" still never emits public lifecycle events; it reconciles"},{"type":"text","text":" "},{"type":"text","text":"inventory when the system opens or closes a scene outside the store’s"},{"type":"text","text":" "},{"type":"text","text":"explicit command path and can temporarily forward commands while the"},{"type":"text","text":" "},{"type":"text","text":"preferred host scene is gone."}]},{"anchor":"Observing-lifecycle-through-events","type":"heading","level":2,"text":"Observing lifecycle through `events`"},{"type":"paragraph","inlineContent":[{"code":"SceneStore.events","type":"codeVoice"},{"text":" is an ","type":"text"},{"code":"AsyncStream<SceneEvent<R>>","type":"codeVoice"},{"text":" that mirrors","type":"text"},{"text":" ","type":"text"},{"text":"the ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" channel shipped by ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":":","type":"text"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["Task {","    for await event in sceneStore.events {","        analytics.record(event)","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The event taxonomy (","type":"text"},{"code":"presented","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dismissed","type":"codeVoice"},{"text":", ","type":"text"},{"code":"rejected","type":"codeVoice"},{"text":") is","type":"text"},{"text":" ","type":"text"},{"text":"deliberately minimal. Rejections carry the original ","type":"text"},{"code":"SceneIntent","type":"codeVoice"},{"text":" so","type":"text"},{"text":" ","type":"text"},{"text":"subscribers can distinguish undeclared routes, declaration mismatches,","type":"text"},{"text":" ","type":"text"},{"text":"stale window handles, and environment failures without synthesising","type":"text"},{"text":" ","type":"text"},{"text":"placeholder routes.","type":"text"}]},{"text":"Ornaments on any platform","level":2,"type":"heading","anchor":"Ornaments-on-any-platform"},{"inlineContent":[{"type":"codeVoice","code":"View.innoRouterOrnament(_:content:)"},{"type":"text","text":" attaches an ornament on"},{"type":"text","text":" "},{"type":"text","text":"visionOS (delegating to SwiftUI’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"ornament(attachmentAnchor:contentAlignment:ornament:)"},{"type":"text","text":") and"},{"type":"text","text":" "},{"type":"text","text":"degrades to a no-op on every other platform. That keeps call sites"},{"type":"text","text":" "},{"type":"text","text":"unconditional:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["ContentView()","    .innoRouterOrnament(OrnamentAnchor(anchor: .bottom, alignment: .center)) {","        ControlBar()","    }"]},{"inlineContent":[{"code":"OrnamentAnchor","type":"codeVoice"},{"text":" lives in ","type":"text"},{"code":"InnoRouterCore","type":"codeVoice"},{"text":" so ornament placement is","type":"text"},{"text":" ","type":"text"},{"text":"serialisable and testable on platforms that never materialise the","type":"text"},{"text":" ","type":"text"},{"text":"visual effect.","type":"text"}],"type":"paragraph"},{"text":"Composing with `FlowStore`","level":2,"type":"heading","anchor":"Composing-with-FlowStore"},{"inlineContent":[{"code":"SceneStore","type":"codeVoice"},{"type":"text","text":" is intentionally "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" composed into "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"code":"RouteStep","type":"codeVoice"},{"type":"text","text":" captures transitions inside a single scene (push \/ sheet"},{"type":"text","text":" "},{"type":"text","text":"\/ cover); spatial presentations are multi-scene events and would"},{"type":"text","text":" "},{"type":"text","text":"break the "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" contract. Apps that need both simply own a"},{"type":"text","text":" "},{"code":"FlowStore<R>","type":"codeVoice"},{"type":"text","text":" and a "},{"code":"SceneStore<R>","type":"codeVoice"},{"type":"text","text":" side-by-side — the "},{"code":"R","type":"codeVoice"},{"type":"text","text":" can be"},{"type":"text","text":" "},{"type":"text","text":"the same route enum or two distinct enums, depending on whether the"},{"type":"text","text":" "},{"type":"text","text":"spatial surface shares routes with the primary flow."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-visionosscenes"]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-VisionOSScenes","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter.","type":"text"}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","kind":"article","type":"topic","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","kind":"symbol","type":"topic","role":"collection","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","abstract":[]}}}