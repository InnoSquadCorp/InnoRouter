{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-throttling"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"kind":"article","abstract":[{"type":"text","text":"Rate-limit navigation commands without threading timestamps through"},{"type":"text","text":" "},{"type":"text","text":"every call site. "},{"type":"codeVoice","code":"ThrottleNavigationMiddleware"},{"type":"text","text":" cancels commands that"},{"type":"text","text":" "},{"type":"text","text":"arrive within a minimum interval of a previously accepted command"},{"type":"text","text":" "},{"type":"text","text":"sharing the same key."}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"text":"Scenario","type":"heading","level":2,"anchor":"Scenario"},{"type":"paragraph","inlineContent":[{"text":"Users double-tap a “Buy” button. The first tap pushes the purchase","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"screen; the second should be silently dropped. Rolling that logic"},{"type":"text","text":" "},{"type":"text","text":"into every button is noise — middleware is the right layer."}]},{"type":"heading","anchor":"Installation","text":"Installation","level":2},{"type":"codeListing","code":["let store = NavigationStore<AppRoute>(","    configuration: NavigationStoreConfiguration(","        middlewares: [","            .init(","                middleware: AnyNavigationMiddleware(","                    ThrottleNavigationMiddleware<AppRoute>(","                        interval: .milliseconds(300)","                    )","                ),","                debugName: \"throttle\"","            )","        ]","    )",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"The default initializer uses ","type":"text"},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":" and groups all"},{"type":"text","text":" "},{"type":"text","text":"commands under a single global window. Within 300 ms of a previous"},{"type":"text","text":" "},{"type":"text","text":"successfully executed command, the next one is cancelled. If the"},{"type":"text","text":" "},{"text":"middleware is registered with ","type":"text"},{"type":"codeVoice","code":"debugName: \"throttle\""},{"type":"text","text":", the surfaced"},{"text":" ","type":"text"},{"text":"reason becomes ","type":"text"},{"code":".cancelled(.middleware(debugName: \"throttle\", command: …))","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","text":"Per-command keys","level":2,"anchor":"Per-command-keys"},{"inlineContent":[{"text":"Group throttle windows by the command’s identity or shape:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["AnyNavigationMiddleware(","    ThrottleNavigationMiddleware<AppRoute>(interval: .milliseconds(300)) { command in","        if case .push(let route) = command {","            return \"push-\\(route)\"   \/\/ each push route gets its own window","        }","        return nil                    \/\/ other commands pass through","    }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to opt a command out of throttling entirely."}]},{"type":"heading","text":"Testing with an injected clock","level":2,"anchor":"Testing-with-an-injected-clock"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The middleware is generic over "},{"type":"codeVoice","code":"Clock"},{"type":"text","text":", so tests can drive time"},{"type":"text","text":" "},{"type":"text","text":"deterministically:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let clock = TestClock()","let throttle = ThrottleNavigationMiddleware<AppRoute, TestClock>(","    interval: .milliseconds(300),","    clock: clock,","    key: { _ in \"all\" }",")","store.addMiddleware(AnyNavigationMiddleware(throttle), debugName: \"throttle\")","","store.send(.go(.home))","clock.advance(by: .milliseconds(50))","store.send(.go(.detail))         \/\/ cancelled — within window","","clock.advance(by: .milliseconds(400))","store.send(.go(.settings))       \/\/ accepted — beyond window"]},{"anchor":"Composing-with-whenCancelled","level":2,"text":"Composing with `.whenCancelled`","type":"heading"},{"inlineContent":[{"type":"text","text":"A throttle cancel surfaces as "},{"code":".cancelled","type":"codeVoice"},{"type":"text","text":", so"},{"text":" ","type":"text"},{"type":"codeVoice","code":".whenCancelled(primary, fallback:)"},{"text":" treats a throttled command the","type":"text"},{"text":" ","type":"text"},{"text":"same as any other cancelled command:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["store.execute(","    .whenCancelled(","        .push(.detail),","        fallback: .push(.home)","    )",")"]},{"inlineContent":[{"type":"text","text":"If the throttle middleware cancels the "},{"code":".push(.detail)","type":"codeVoice"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"fallback "},{"code":".push(.home)","type":"codeVoice"},{"type":"text","text":" is attempted next. "},{"type":"codeVoice","code":"NavigationStore"},{"text":" ","type":"text"},{"type":"text","text":"routes that fallback back through the full middleware chain, so a"},{"type":"text","text":" "},{"type":"text","text":"global throttle key can cancel the fallback too if it still lands"},{"type":"text","text":" "},{"type":"text","text":"inside the same throttle window. Each leg runs behind an internal"},{"text":" ","type":"text"},{"text":"savepoint: if the fallback also fails or is cancelled, neither leg’s","type":"text"},{"type":"text","text":" "},{"type":"text","text":"partial state is committed."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Debounce?","anchor":"Debounce"},{"type":"paragraph","inlineContent":[{"text":"Debounce semantics — “wait N ms, then fire the latest” — live in","type":"text"},{"text":" ","type":"text"},{"code":"DebouncingNavigator","type":"codeVoice"},{"type":"text","text":", not in "},{"type":"codeVoice","code":"NavigationCommand"},{"type":"text","text":". That keeps the"},{"type":"text","text":" "},{"text":"engine synchronous while the async wrapper owns the timer,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"cancellation, and "},{"code":"Clock","type":"codeVoice"},{"type":"text","text":" injection needed for deterministic tests."},{"text":" ","type":"text"},{"type":"text","text":"Use throttle middleware for synchronous “reject too soon” behavior"},{"type":"text","text":" "},{"text":"and ","type":"text"},{"code":"DebouncingNavigator","type":"codeVoice"},{"type":"text","text":" for delayed “latest wins” behavior."}]},{"level":2,"text":"Next steps","anchor":"Next-steps","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/NavigationStore-and-Hosts","isActive":true},{"type":"text","text":" for the typed "},{"code":"onEvent","type":"codeVoice"},{"text":" callback and","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore.events"},{"type":"text","text":" stream that expose throttle cancellations."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/c