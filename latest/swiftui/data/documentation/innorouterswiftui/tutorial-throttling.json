{"primaryContentSections":[{"content":[{"type":"heading","text":"Scenario","level":2,"anchor":"Scenario"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Users double-tap a “Buy” button. The first tap pushes the purchase"},{"type":"text","text":" "},{"type":"text","text":"screen; the second should be silently dropped. Rolling that logic"},{"type":"text","text":" "},{"type":"text","text":"into every button is noise — middleware is the right layer."}]},{"type":"heading","text":"Installation","level":2,"anchor":"Installation"},{"type":"codeListing","code":["let store = NavigationStore<AppRoute>(","    configuration: NavigationStoreConfiguration(","        middlewares: [","            .init(","                middleware: AnyNavigationMiddleware(","                    ThrottleNavigationMiddleware<AppRoute>(","                        interval: .milliseconds(300)","                    )","                ),","                debugName: \"throttle\"","            )","        ]","    )",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default initializer uses "},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":" and groups all"},{"type":"text","text":" "},{"type":"text","text":"commands under a single global window. Within 300 ms of a previous"},{"type":"text","text":" "},{"type":"text","text":"successfully executed command, the next one is cancelled. If the"},{"type":"text","text":" "},{"type":"text","text":"middleware is registered with "},{"type":"codeVoice","code":"debugName: \"throttle\""},{"text":", the surfaced","type":"text"},{"text":" ","type":"text"},{"text":"reason becomes ","type":"text"},{"type":"codeVoice","code":".cancelled(.middleware(debugName: \"throttle\", command: …))"},{"text":".","type":"text"}]},{"text":"Per-command keys","type":"heading","anchor":"Per-command-keys","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Group throttle windows by the command’s identity or shape:"}]},{"code":["AnyNavigationMiddleware(","    ThrottleNavigationMiddleware<AppRoute>(interval: .milliseconds(300)) { command in","        if case .push(let route) = command {","            return \"push-\\(route)\"   \/\/ each push route gets its own window","        }","        return nil                    \/\/ other commands pass through","    }",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to opt a command out of throttling entirely."}]},{"text":"Testing with an injected clock","type":"heading","anchor":"Testing-with-an-injected-clock","level":2},{"type":"paragraph","inlineContent":[{"text":"The middleware is generic over ","type":"text"},{"code":"Clock","type":"codeVoice"},{"text":", so tests can drive time","type":"text"},{"text":" ","type":"text"},{"text":"deterministically:","type":"text"}]},{"code":["let clock = TestClock()","let throttle = ThrottleNavigationMiddleware<AppRoute, TestClock>(","    interval: .milliseconds(300),","    clock: clock,","    key: { _ in \"all\" }",")","store.addMiddleware(AnyNavigationMiddleware(throttle), debugName: \"throttle\")","","store.send(.go(.home))","clock.advance(by: .milliseconds(50))","store.send(.go(.detail))         \/\/ cancelled — within window","","clock.advance(by: .milliseconds(400))","store.send(.go(.settings))       \/\/ accepted — beyond window"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"text":"Composing with `.whenCancelled`","type":"heading","anchor":"Composing-with-whenCancelled","level":2},{"type":"paragraph","inlineContent":[{"text":"A throttle cancel surfaces as ","type":"text"},{"code":".cancelled","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"code":".whenCancelled(primary, fallback:)","type":"codeVoice"},{"text":" treats a throttled command the","type":"text"},{"text":" ","type":"text"},{"text":"same as any other cancelled command:","type":"text"}]},{"code":["store.execute(","    .whenCancelled(","        .push(.detail),","        fallback: .push(.home)","    )",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"If the throttle middleware cancels the ","type":"text"},{"code":".push(.detail)","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"fallback ","type":"text"},{"code":".push(.home)","type":"codeVoice"},{"text":" is attempted next. ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" ","type":"text"},{"text":"routes that fallback back through the full middleware chain, so a","type":"text"},{"text":" ","type":"text"},{"text":"global throttle key can cancel the fallback too if it still lands","type":"text"},{"text":" ","type":"text"},{"text":"inside the same throttle window. Each leg runs behind an internal","type":"text"},{"text":" ","type":"text"},{"text":"savepoint: if the fallback also fails or is cancelled, neither leg’s","type":"text"},{"text":" ","type":"text"},{"text":"partial state is committed.","type":"text"}]},{"anchor":"Debounce","type":"heading","level":2,"text":"Debounce?"},{"inlineContent":[{"text":"Debounce semantics — “wait N ms, then fire the latest” — live in","type":"text"},{"type":"text","text":" "},{"code":"DebouncingNavigator","type":"codeVoice"},{"type":"text","text":", not in "},{"code":"NavigationCommand","type":"codeVoice"},{"type":"text","text":". That keeps the"},{"text":" ","type":"text"},{"text":"engine synchronous while the async wrapper owns the timer,","type":"text"},{"text":" ","type":"text"},{"text":"cancellation, and ","type":"text"},{"code":"Clock","type":"codeVoice"},{"text":" injection needed for deterministic tests.","type":"text"},{"text":" ","type":"text"},{"text":"Use throttle middleware for synchronous “reject too soon” behavior","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and "},{"code":"DebouncingNavigator","type":"codeVoice"},{"text":" for delayed “latest wins” behavior.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Next-steps","text":"Next steps","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/NavigationStore-and-Hosts","isActive":true,"type":"reference"},{"type":"text","text":" for the typed "},{"code":"onEvent","type":"codeVoice"},{"text":" callback and","type":"text"},{"type":"text","text":" "},{"code":"NavigationStore.events","type":"codeVoice"},{"type":"text","text":" stream that expose throttle cancellations."}]}]},{"content":[{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","isActive":true,"type":"reference"},{"text":" for the broader","type":"text"},{"type":"text","text":" "},{"text":"middleware composition story (logging, entitlement gating,","type":"text"},{"text":" ","type":"text"},{"text":"analytics).","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Throttling Rapid Navigation Taps"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-throttling"]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling","interfaceLanguage":"swift"},"kind":"article","abstract":[{"type":"text","text":"Rate-limit navigation commands without threading timestamps through"},{"type":"text","text":" "},{"type":"text","text":"every call site. "},{"type":"codeVoice","code":"ThrottleNavigationMiddleware"},{"type":"text","text":" cancels commands that"},{"type":"text","text":" "},{"type":"text","text":"arrive within a minimum interval of a previously accepted command"},{"type":"text","text":" "},{"type":"text","text":"sharing the same key."}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/NavigationStore-and-Hosts":{"kind":"article","abstract":[{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" is the default self-contained stack-plus-modal surface."},{"type":"text","text":" "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" is the advanced stack-only authority to use when the"},{"type":"text","text":" "},{"type":"text","text":"application needs to own navigation state outside a host."}],"url":"\/documentation\/innorouterswiftui\/navigationstore-and-hosts","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/NavigationStore-and-Hosts","title":"NavigationStore and hosts","role":"article","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","abstract":[],"role":"collection"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","kind":"article","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","abstract":[{"type":"text