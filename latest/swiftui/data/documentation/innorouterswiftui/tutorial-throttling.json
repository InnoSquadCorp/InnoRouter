{"kind":"article","abstract":[{"type":"text","text":"Rate-limit navigation commands without threading timestamps through"},{"type":"text","text":" "},{"type":"text","text":"every call site. "},{"type":"codeVoice","code":"ThrottleNavigationMiddleware"},{"type":"text","text":" cancels commands that"},{"type":"text","text":" "},{"type":"text","text":"arrive within a minimum interval of a previously accepted command"},{"type":"text","text":" "},{"type":"text","text":"sharing the same key."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-throttling"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Scenario","type":"heading","text":"Scenario"},{"type":"paragraph","inlineContent":[{"text":"Users double-tap a “Buy” button. The first tap pushes the purchase","type":"text"},{"text":" ","type":"text"},{"text":"screen; the second should be silently dropped. Rolling that logic","type":"text"},{"text":" ","type":"text"},{"text":"into every button is noise — middleware is the right layer.","type":"text"}]},{"level":2,"anchor":"Installation","type":"heading","text":"Installation"},{"type":"codeListing","code":["let store = NavigationStore<AppRoute>(","    configuration: NavigationStoreConfiguration(","        middlewares: [","            .init(","                middleware: AnyNavigationMiddleware(","                    ThrottleNavigationMiddleware<AppRoute>(","                        interval: .milliseconds(300)","                    )","                ),","                debugName: \"throttle\"","            )","        ]","    )",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default initializer uses "},{"type":"codeVoice","code":"ContinuousClock"},{"type":"text","text":" and groups all"},{"type":"text","text":" "},{"type":"text","text":"commands under a single global window. Within 300 ms of a previous"},{"type":"text","text":" "},{"type":"text","text":"successfully executed command, the next one is cancelled. If the"},{"type":"text","text":" "},{"type":"text","text":"middleware is registered with "},{"type":"codeVoice","code":"debugName: \"throttle\""},{"type":"text","text":", the surfaced"},{"type":"text","text":" "},{"type":"text","text":"reason becomes "},{"type":"codeVoice","code":".cancelled(.middleware(debugName: \"throttle\", command: …))"},{"type":"text","text":"."}]},{"level":2,"anchor":"Per-command-keys","type":"heading","text":"Per-command keys"},{"type":"paragraph","inlineContent":[{"text":"Group throttle windows by the command’s identity or shape:","type":"text"}]},{"type":"codeListing","code":["AnyNavigationMiddleware(","    ThrottleNavigationMiddleware<AppRoute>(interval: .milliseconds(300)) { command in","        if case .push(let route) = command {","            return \"push-\\(route)\"   \/\/ each push route gets its own window","        }","        return nil                    \/\/ other commands pass through","    }",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" to opt a command out of throttling entirely."}]},{"level":2,"anchor":"Testing-with-an-injected-clock","type":"heading","text":"Testing with an injected clock"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The middleware is generic over "},{"type":"codeVoice","code":"Clock"},{"type":"text","text":", so tests can drive time"},{"type":"text","text":" "},{"type":"text","text":"deterministically:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let clock = TestClock()","let throttle = ThrottleNavigationMiddleware<AppRoute, TestClock>(","    interval: .milliseconds(300),","    clock: clock,","    key: { _ in \"all\" }",")","store.addMiddleware(AnyNavigationMiddleware(throttle), debugName: \"throttle\")","","store.send(.go(.home))","clock.advance(by: .milliseconds(50))","store.send(.go(.detail))         \/\/ cancelled — within window","","clock.advance(by: .milliseconds(400))","store.send(.go(.settings))       \/\/ accepted — beyond window"]},{"type":"heading","level":2,"text":"Composing with `.whenCancelled`","anchor":"Composing-with-whenCancelled"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A throttle cancel surfaces as "},{"code":".cancelled","type":"codeVoice"},{"type":"text","text":", so"},{"type":"text","text":" "},{"code":".whenCancelled(primary, fallback:)","type":"codeVoice"},{"type":"text","text":" treats a throttled command the"},{"type":"text","text":" "},{"type":"text","text":"same as any other cancelled command:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["store.execute(","    .whenCancelled(","        .push(.detail),","        fallback: .push(.home)","    )",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the throttle middleware cancels the "},{"type":"codeVoice","code":".push(.detail)"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"fallback "},{"type":"codeVoice","code":".push(.home)"},{"type":"text","text":" is attempted next. "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" "},{"type":"text","text":"routes that fallback back through the full middleware chain, so a"},{"type":"text","text":" "},{"type":"text","text":"global throttle key can cancel the fallback too if it still lands"},{"type":"text","text":" "},{"type":"text","text":"inside the same throttle window."}]},{"type":"heading","level":2,"text":"Debounce?","anchor":"Debounce"},{"type":"paragraph","inlineContent":[{"text":"Debounce semantics — “wait N ms, then fire the latest” — live in","type":"text"},{"text":" ","type":"text"},{"code":"DebouncingNavigator","type":"codeVoice"},{"text":", not in ","type":"text"},{"code":"NavigationCommand","type":"codeVoice"},{"text":". That keeps the","type":"text"},{"text":" ","type":"text"},{"text":"engine synchronous while the async wrapper owns the timer,","type":"text"},{"text":" ","type":"text"},{"text":"cancellation, and ","type":"text"},{"code":"Clock","type":"codeVoice"},{"text":" injection needed for deterministic tests.","type":"text"},{"text":" ","type":"text"},{"text":"Use throttle middleware for synchronous “reject too soon” behavior","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"DebouncingNavigator","type":"codeVoice"},{"text":" for delayed “latest wins” behavior.","type":"text"}]},{"type":"heading","level":2,"text":"Next steps","anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-StoreObserver","isActive":true,"type":"reference"},{"text":" for a protocol-style adapter","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that can observe throttle cancellations via"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore.events"},{"type":"text","text":" without threading callbacks."}]}]},{"content":[{"inlineContent":[{"text":"See ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},{"text":" for the broader","type":"text"},{"text":" ","type":"text"},{"text":"middleware composition story (logging, entitlement gating,","type":"text"},{"text":" ","type":"text"},{"text":"analytics).","type":"text"}],"type":"paragraph"}]}]}]}],"metadata":{"title":"Throttling Rapid Navigation Taps","modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MiddlewareComposition":{"abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that guarantees "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" only runs for middlewares"},{"type":"text","text":" "},{"type":"text","text":"that accepted the command."}],"type":"topic","role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition","title":"Composing Middleware Across Navigation and Modal","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","kind":"symbol","type":"topic","role":"collection","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","abstract":[]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter.","type":"text"}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","kind":"article","type":"topic","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-StoreObserver":{"url":"\/documentation\/innorouterswiftui\/tutorial-storeobserver","kind":"article","title":"Observing Stores via Protocol Adapters","abstract":[{"code":"StoreObserver","type":"codeVoice"},{"type":"text","text":" is a thin protocol adapter over the "},{"code":"events","type":"codeVoice"},{"type":"text","text":" "},{"code":"AsyncStream","type":"codeVoice"},{"type":"text","text":" that every InnoRouter store publishes. Use it when"},{"type":"text","text":" "},{"type":"text","text":"protocol dispatch reads clearer than a "},{"code":"for await","type":"codeVoice"},{"type":"text","text":" loop — typically"},{"type":"text","text":" "},{"type":"text","text":"in AppDelegate wiring, analytics adapters, or anywhere you want"},{"type":"text","text":" "},{"type":"text","text":"static methods instead of iterator plumbing."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-StoreObserver","role":"article","type":"topic"}}}