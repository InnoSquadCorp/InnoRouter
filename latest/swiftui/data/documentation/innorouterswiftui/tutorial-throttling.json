{"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-throttling"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"kind":"article","metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article","title":"Throttling Rapid Navigation Taps"},"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"text":"Scenario","level":2,"anchor":"Scenario","type":"heading"},{"inlineContent":[{"text":"Users double-tap a “Buy” button. The first tap pushes the purchase","type":"text"},{"text":" ","type":"text"},{"text":"screen; the second should be silently dropped. Rolling that logic","type":"text"},{"text":" ","type":"text"},{"text":"into every button is noise — middleware is the right layer.","type":"text"}],"type":"paragraph"},{"anchor":"Installation","type":"heading","level":2,"text":"Installation"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let store = NavigationStore<AppRoute>(","    configuration: NavigationStoreConfiguration(","        middlewares: [","            .init(","                middleware: AnyNavigationMiddleware(","                    ThrottleNavigationMiddleware<AppRoute>(","                        interval: .milliseconds(300)","                    )","                ),","                debugName: \"throttle\"","            )","        ]","    )",")"]},{"inlineContent":[{"type":"text","text":"The default initializer uses "},{"code":"ContinuousClock","type":"codeVoice"},{"type":"text","text":" and groups all"},{"type":"text","text":" "},{"type":"text","text":"commands under a single global window. Within 300 ms of a previous"},{"text":" ","type":"text"},{"text":"successfully executed command, the next one is cancelled. If the","type":"text"},{"text":" ","type":"text"},{"text":"middleware is registered with ","type":"text"},{"code":"debugName: \"throttle\"","type":"codeVoice"},{"text":", the surfaced","type":"text"},{"text":" ","type":"text"},{"text":"reason becomes ","type":"text"},{"code":".cancelled(.middleware(debugName: \"throttle\", command: …))","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Per-command keys","level":2,"anchor":"Per-command-keys","type":"heading"},{"inlineContent":[{"text":"Group throttle windows by the command’s identity or shape:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["AnyNavigationMiddleware(","    ThrottleNavigationMiddleware<AppRoute>(interval: .milliseconds(300)) { command in","        if case .push(let route) = command {","            return \"push-\\(route)\"   \/\/ each push route gets its own window","        }","        return nil                    \/\/ other commands pass through","    }",")"],"type":"codeListing"},{"inlineContent":[{"text":"Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to opt a command out of throttling entirely.","type":"text"}],"type":"paragraph"},{"anchor":"Testing-with-an-injected-clock","type":"heading","level":2,"text":"Testing with an injected clock"},{"inlineContent":[{"text":"The middleware is generic over ","type":"text"},{"type":"codeVoice","code":"Clock"},{"text":", so tests can drive time","type":"text"},{"text":" ","type":"text"},{"text":"deterministically:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let clock = TestClock()","let throttle = ThrottleNavigationMiddleware<AppRoute, TestClock>(","    interval: .milliseconds(300),","    clock: clock,","    key: { _ in \"all\" }",")","store.addMiddleware(AnyNavigationMiddleware(throttle), debugName: \"throttle\")","","store.send(.go(.home))","clock.advance(by: .milliseconds(50))","store.send(.go(.detail))         \/\/ cancelled — within window","","clock.advance(by: .milliseconds(400))","store.send(.go(.settings))       \/\/ accepted — beyond window"],"type":"codeListing"},{"anchor":"Composing-with-whenCancelled","type":"heading","level":2,"text":"Composing with `.whenCancelled`"},{"inlineContent":[{"text":"A throttle cancel surfaces as ","type":"text"},{"type":"codeVoice","code":".cancelled"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".whenCancelled(primary, fallback:)"},{"text":" treats a throttled command the","type":"text"},{"text":" ","type":"text"},{"text":"same as any other cancelled command:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["store.execute(","    .whenCancelled(","        .push(.detail),","        fallback: .push(.home)","    )",")"],"type":"codeListing"},{"inlineContent":[{"text":"If the throttle middleware cancels the ","type":"text"},{"type":"codeVoice","code":".push(.detail)"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"fallback ","type":"text"},{"type":"codeVoice","code":".push(.home)"},{"text":" is attempted next. ","type":"text"},{"type":"codeVoice","code":"NavigationStore"},{"text":" ","type":"text"},{"text":"routes that fallback back through the full middleware chain, so a","type":"text"},{"text":" ","type":"text"},{"text":"global throttle key can cancel the fallback too if it still lands","type":"text"},{"text":" ","type":"text"},{"text":"inside the same throttle window. Each leg runs behind an internal","type":"text"},{"text":" ","type":"text"},{"text":"savepoint: if the fallback also fails or is cancelled, neither leg’s","type":"text"},{"text":" ","type":"text"},{"text":"partial state is committed.","type":"text"}],"type":"paragraph"},{"anchor":"Debounce","type":"heading","level":2,"text":"Debounce?"},{"inlineContent":[{"text":"Debounce semantics — “wait N ms, then fire the latest” — live in","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DebouncingNavigator"},{"text":", not in ","type":"text"},{"type":"codeVoice","code":"NavigationCommand"},{"text":". That keeps the","type":"text"},{"text":" ","type":"text"},{"text":"engine synchronous while the async wrapper owns the timer,","type":"text"},{"text":" ","type":"text"},{"text":"cancellation, and ","type":"text"},{"type":"codeVoice","code":"Clock"},{"text":" injection needed for deterministic tests.","type":"text"},{"text":" ","type":"text"},{"text":"Use throttle middleware for synchronous “reject too soon” behavior","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"DebouncingNavigator"},{"text":" for delayed “latest wins” behavior.","type":"text"}],"type":"paragraph"},{"anchor":"Next-steps","type":"heading","level":2,"text":"Next steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/NavigationStore-and-Hosts","isActive":true,"type":"reference"},{"text":" for the typed ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" callback and","type":"text"},{"text":" ","type":"text"},{"code":"NavigationStore.events","type":"codeVoice"},{"text":" stream that expose throttle cancellations.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","isActive":true,"type":"reference"},{"text":" for the broader","type":"text"},{"text":" ","type":"text"},{"text":"middleware composition story (logging, entitlement gating,","type":"text"},{"text":" ","type":"text"},{"text":"analytics).","type":"text"}]}]}]}],"kind":"content"}],"sections":[],"abstract":[{"text":"Rate-limit navigation commands without threading timestamps through","type":"text"},{"text":" ","type":"text"},{"text":"every call site. ","type":"text"},{"code":"ThrottleNavigationMiddleware","type":"codeVoice"},{"text":" cancels commands that","type":"text"},{"text":" ","type":"text"},{"text":"arrive within a minimum interval of a previously accepted command","type":"text"},{"text":" ","type":"text"},{"text":"sharing the same key.","type":"text"}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","kind":"article","title":"InnoRouterSwiftUI","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","abstract":[{"text":"Macro-first SwiftUI routing, externally owned stores, modal routing,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MiddlewareComposition":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","kind":"article","title":"Composing Middleware Across Navigation and Modal","url":"\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition","role":"article","abstract":[{"text":"Install logging, entitlement gating, and analytics middleware on","type":"text"},{"text":" ","type":"text"},{"text":"both ","type":"text"},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" and "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":". Inspect the participant"},{"text":" ","type":"text"},{"text":"discipline that pairs completion callbacks with the middlewares","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"whose "},{"type":"codeVoice","code":"willExecute"},{"text":" hook actually ran.","type":"text"}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/NavigationStore-and-Hosts":{"type":"topic","abstract":[{"type":"codeVoice","code":"RouterHost"},{"text":" is the default self-contained stack-plus-modal surface.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationStore"},{"text":" is the advanced stack-only authority to use when the","type":"text"},{"text":" ","type":"text"},{"text":"application needs to own navigation state outside a host.","type":"text"}],"role":"article","url":"\/documentation\/innorouterswiftui\/navigationstore-and-hosts","title":"NavigationStore and hosts","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/NavigationStore-and-Hosts","kind":"article"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"abstract":[],"type":"topic","role":"collection","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","kind":"symbol"}}}