{"abstract":[{"type":"text","text":"Rate-limit navigation commands without threading timestamps through"},{"type":"text","text":" "},{"type":"text","text":"every call site. "},{"type":"codeVoice","code":"ThrottleNavigationMiddleware"},{"type":"text","text":" cancels commands that"},{"type":"text","text":" "},{"type":"text","text":"arrive within a minimum interval of a previously accepted command"},{"type":"text","text":" "},{"type":"text","text":"sharing the same key."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-throttling"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling"},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Scenario","type":"heading","level":2,"text":"Scenario"},{"inlineContent":[{"type":"text","text":"Users double-tap a “Buy” button. The first tap pushes the purchase"},{"type":"text","text":" "},{"type":"text","text":"screen; the second should be silently dropped. Rolling that logic"},{"type":"text","text":" "},{"type":"text","text":"into every button is noise — middleware is the right layer."}],"type":"paragraph"},{"anchor":"Installation","type":"heading","level":2,"text":"Installation"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let store = NavigationStore<AppRoute>(","    configuration: NavigationStoreConfiguration(","        middlewares: [","            .init(","                middleware: AnyNavigationMiddleware(","                    ThrottleNavigationMiddleware<AppRoute>(","                        interval: .milliseconds(300)","                    )","                ),","                debugName: \"throttle\"","            )","        ]","    )",")"]},{"inlineContent":[{"text":"The default initializer uses ","type":"text"},{"code":"ContinuousClock","type":"codeVoice"},{"text":" and groups all","type":"text"},{"text":" ","type":"text"},{"text":"commands under a single global window. Within 300 ms of a previous","type":"text"},{"text":" ","type":"text"},{"text":"successfully executed command, the next one is cancelled. If the","type":"text"},{"text":" ","type":"text"},{"text":"middleware is registered with ","type":"text"},{"code":"debugName: \"throttle\"","type":"codeVoice"},{"text":", the surfaced","type":"text"},{"text":" ","type":"text"},{"text":"reason becomes ","type":"text"},{"code":".cancelled(.middleware(debugName: \"throttle\", command: …))","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"Per-command-keys","type":"heading","level":2,"text":"Per-command keys"},{"inlineContent":[{"text":"Group throttle windows by the command’s identity or shape:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["AnyNavigationMiddleware(","    ThrottleNavigationMiddleware<AppRoute>(interval: .milliseconds(300)) { command in","        if case .push(let route) = command {","            return \"push-\\(route)\"   \/\/ each push route gets its own window","        }","        return nil                    \/\/ other commands pass through","    }",")"]},{"inlineContent":[{"text":"Return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" to opt a command out of throttling entirely.","type":"text"}],"type":"paragraph"},{"anchor":"Testing-with-an-injected-clock","type":"heading","level":2,"text":"Testing with an injected clock"},{"inlineContent":[{"type":"text","text":"The middleware is generic over "},{"type":"codeVoice","code":"Clock"},{"type":"text","text":", so tests can drive time"},{"type":"text","text":" "},{"type":"text","text":"deterministically:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let clock = TestClock()","let throttle = ThrottleNavigationMiddleware<AppRoute, TestClock>(","    interval: .milliseconds(300),","    clock: clock,","    key: { _ in \"all\" }",")","store.addMiddleware(AnyNavigationMiddleware(throttle), debugName: \"throttle\")","","store.send(.go(.home))","clock.advance(by: .milliseconds(50))","store.send(.go(.detail))         \/\/ cancelled — within window","","clock.advance(by: .milliseconds(400))","store.send(.go(.settings))       \/\/ accepted — beyond window"],"type":"codeListing"},{"text":"Composing with `.whenCancelled`","anchor":"Composing-with-whenCancelled","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"A throttle cancel surfaces as ","type":"text"},{"type":"codeVoice","code":".cancelled"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".whenCancelled(primary, fallback:)"},{"text":" treats a throttled command the","type":"text"},{"text":" ","type":"text"},{"text":"same as any other cancelled command:","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["store.execute(","    .whenCancelled(","        .push(.detail),","        fallback: .push(.home)","    )",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"If the throttle middleware cancels the ","type":"text"},{"code":".push(.detail)","type":"codeVoice"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"fallback ","type":"text"},{"code":".push(.home)","type":"codeVoice"},{"text":" is attempted next. ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" ","type":"text"},{"text":"routes that fallback back through the full middleware chain, so a","type":"text"},{"text":" ","type":"text"},{"text":"global throttle key can cancel the fallback too if it still lands","type":"text"},{"text":" ","type":"text"},{"text":"inside the same throttle window.","type":"text"}]},{"text":"Debounce?","anchor":"Debounce","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"Debounce semantics — “wait N ms, then fire the latest” — live in","type":"text"},{"text":" ","type":"text"},{"code":"DebouncingNavigator","type":"codeVoice"},{"text":", not in ","type":"text"},{"code":"NavigationCommand","type":"codeVoice"},{"text":". That keeps the","type":"text"},{"text":" ","type":"text"},{"text":"engine synchronous while the async wrapper owns the timer,","type":"text"},{"text":" ","type":"text"},{"text":"cancellation, and ","type":"text"},{"code":"Clock","type":"codeVoice"},{"text":" injection needed for deterministic tests.","type":"text"},{"text":" ","type":"text"},{"text":"Use throttle middleware for synchronous “reject too soon” behavior","type":"text"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"DebouncingNavigator","type":"codeVoice"},{"text":" for delayed “latest wins” behavior.","type":"text"}]},{"text":"Next steps","anchor":"Next-steps","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"See ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-StoreObserver"},{"text":" for a protocol-style adapter","type":"text"},{"text":" ","type":"text"},{"text":"that can observe throttle cancellations via","type":"text"},{"text":" ","type":"text"},{"code":"NavigationStore.events","type":"codeVoice"},{"text":" without threading callbacks.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},{"type":"text","text":" for the broader"},{"type":"text","text":" "},{"type":"text","text":"middleware composition story (logging, entitlement gating,"},{"type":"text","text":" "},{"type":"text","text":"analytics)."}]}]}]}]}],"metadata":{"title":"Throttling Rapid Navigation Taps","roleHeading":"Article","role":"article","modules":[{"name":"InnoRouterTesting"}]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","abstract":[],"type":"topic","url":"\/documentation\/innoroutertesting","role":"collection","kind":"symbol"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"type":"topic","abstract":[{"text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter.","type":"text"}],"title":"InnoRouterSwiftUI","kind":"article","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MiddlewareComposition":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that guarantees "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" only runs for middlewares"},{"type":"text","text":" "},{"type":"text","text":"that accepted the command."}],"type":"topic","url":"\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition","kind":"article","title":"Composing Middleware Across Navigation and Modal","role":"article"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-StoreObserver":{"kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-StoreObserver","role":"article","type":"topic","abstract":[{"code":"StoreObserver","type":"codeVoice"},{"type":"text","text":" is a thin protocol adapter over the "},{"code":"events","type":"codeVoice"},{"type":"text","text":" "},{"code":"AsyncStream","type":"codeVoice"},{"type":"text","text":" that every InnoRouter store publishes. Use it when"},{"type":"text","text":" "},{"type":"text","text":"protocol dispatch reads clearer than a "},{"code":"for await","type":"codeVoice"},{"type":"text","text":" loop — typically"},{"type":"text","text":" "},{"type":"text","text":"in AppDelegate wiring, analytics adapters, or anywhere you want"},{"type":"text","text":" "},{"type":"text","text":"static methods instead of iterator plumbing."}],"url":"\/documentation\/innorouterswiftui\/tutorial-storeobserver","title":"Observing Stores via Protocol Adapters"}}}