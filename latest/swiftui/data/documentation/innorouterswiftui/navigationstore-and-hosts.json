{"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Article","title":"NavigationStore and hosts","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"sections":[],"primaryContentSections":[{"content":[{"level":2,"text":"Start macro-first","type":"heading","anchor":"Start-macro-first"},{"type":"paragraph","inlineContent":[{"text":"For a local stack and modal flow, declare destinations on the route and let","type":"text"},{"text":" ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" own the unified store:","type":"text"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@Router","enum AppRoute {","    case detail(id: String)","    case settings","","    var destination: some View {","        switch self {","        case .detail(let id):","            DetailView(id: id)","        case .settings:","            SettingsView()","        }","    }","}","","struct AppRoot: View {","    var body: some View {","        RouterHost(AppRoute.self) {","            HomeView()","        }","    }","}","","struct HomeView: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    var body: some View {","        Button(\"Open settings\") {","            router.go(.settings)","        }","    }","}"]},{"inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" generates "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" and "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":" conformance. If the host"},{"type":"text","text":" "},{"type":"text","text":"is missing or the route type does not match the nearest host,"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"text":" follows ","type":"text"},{"code":"EnvironmentMissingPolicy","type":"codeVoice"},{"type":"text","text":" and fails loudly by"},{"type":"text","text":" "},{"type":"text","text":"default."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Add literal origin allowlists and "},{"code":"@DeepLink","type":"codeVoice"},{"type":"text","text":" markers when a URL resolves to"},{"type":"text","text":" "},{"type":"text","text":"one pushed route. "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" installs the incoming-URL handler automatically;"},{"type":"text","text":" "},{"type":"text","text":"no application "},{"code":"onOpenURL","type":"codeVoice"},{"type":"text","text":" bridge is needed for that path."}],"type":"paragraph"},{"level":2,"anchor":"Promote-the-store-when-another-boundary-needs-it","type":"heading","text":"Promote the store when another boundary needs it"},{"inlineContent":[{"type":"text","text":"Create the "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" outside the host when authentication or pending"},{"text":" ","type":"text"},{"text":"replay, multi-step deep-link reconciliation, state restoration, middleware","type":"text"},{"text":" ","type":"text"},{"text":"mutation, event observation, or another application boundary needs direct","type":"text"},{"text":" ","type":"text"},{"text":"access. The ","type":"text"},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":" generated by "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" keeps this advanced host"},{"type":"text","text":" "},{"type":"text","text":"concise:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@State private var navigation = NavigationStore<AppRoute>()","","NavigationHost(store: navigation) {","    HomeView()","}"]},{"anchor":"What-the-store-owns","type":"heading","level":2,"text":"What the store owns"},{"inlineContent":[{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" owns:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"the current "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" snapshot"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"command execution","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"batch execution","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"transactional execution","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"path reconciliation from ","type":"text"},{"type":"codeVoice","code":"NavigationStack(path:)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"middleware registry orchestration","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"typed observation events for analytics and diagnostics"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Configuration is centralized in "},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Its synchronous observation surface is one ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" callback that","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"switches over "},{"type":"codeVoice","code":"NavigationEvent"},{"text":"; ","type":"text"},{"code":"NavigationStore.events","type":"codeVoice"},{"type":"text","text":" provides the"},{"type":"text","text":" "},{"type":"text","text":"same cases as an "},{"type":"codeVoice","code":"AsyncStream"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let configuration = NavigationStoreConfiguration<AppRoute>(","    onEvent: { event in","        switch event {","        case .changed(_, let new):","            analytics.recordPath(new.path)","        case .batchExecuted(let result):","            analytics.recordBatch(result)","        case .transactionExecuted(let result):","            analytics.recordTransaction(result)","        case .middlewareMutation(let mutation):","            diagnostics.record(mutation)","        case .pathMismatch(let mismatch):","            diagnostics.record(mismatch)","        }","    }",")"]},{"type":"paragraph","inlineContent":[{"text":"For a 5.0 migration, move the bodies of the former per-event","type":"text"},{"text":" ","type":"text"},{"text":"configuration closures into these switch cases. No compatibility","type":"text"},{"text":" ","type":"text"},{"text":"closures remain.","type":"text"}]},{"type":"heading","anchor":"Host-responsibilities","text":"Host responsibilities","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" and "},{"type":"codeVoice","code":"CoordinatorHost"},{"type":"text","text":" connect SwiftUI navigation UI to the store or coordinator:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"render the root view","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"render destinations for pushed routes"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"publish one route-typed authority consumed through "},{"code":"@EnvironmentRouter","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"bridge system path changes back into router commands"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Views should not mutate a store directly. The default view-facing surface is","type":"text"},{"type":"text","text":" "},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":", whose ","type":"text"},{"code":"RouterActions","type":"codeVoice"},{"text":" methods emit typed","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationIntent"},{"text":" values. Use ","type":"text"},{"code":"go","type":"codeVoice"},{"text":", ","type":"text"},{"type":"codeVoice","code":"back"},{"text":", and the other focused conveniences","type":"text"},{"text":" ","type":"text"},{"text":"for common transitions, and ","type":"text"},{"code":"send(_:)","type":"codeVoice"},{"text":" as the explicit escape hatch for an","type":"text"},{"text":" ","type":"text"},{"text":"advanced intent. The same ","type":"text"},{"code":"@EnvironmentRouter(Route.self)","type":"codeVoice"},{"type":"text","text":" surface is used for"},{"type":"text","text":" "},{"type":"text","text":"navigation, modal, flow, and tab capabilities supplied by the matching host."}]},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" for synchronous analytics or diagnostics and "},{"type":"codeVoice","code":"events"},{"type":"text","text":" when an"},{"type":"text","text":" "},{"type":"text","text":"asynchronous consumer should own the observation task. Supplying "},{"type":"codeVoice","code":"logger"},{"type":"text","text":" "},{"type":"text","text":"also records private, structured summaries through the store’s internal OSLog"},{"type":"text","text":" "},{"type":"text","text":"integration; no separate telemetry adapter is required."}]},{"text":"Intent command shape","anchor":"Intent-command-shape","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore.send(_:)"},{"type":"text","text":" and the navigation adapter owned by "},{"type":"codeVoice","code":"FlowStore"},{"text":" ","type":"text"},{"text":"use the same middleware-visible command shape:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"empty ","type":"text"},{"code":"goMany","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"pushMany","type":"codeVoice"},{"text":" -> no command","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one route -> "},{"type":"codeVoice","code":".push"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"multiple routes -> one atomic ","type":"text"},{"code":".pushAll","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"backBy"},{"text":" \/ ","type":"text"},{"code":"popCount","type":"codeVoice"},{"text":" equal to the current stack depth -> ","type":"text"},{"code":".popToRoot","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"With no modal tail, pop attempts enter middleware even on an empty stack."},{"type":"text","text":" "},{"text":"The engine may still return a no-op or failure, but middleware can consistently","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"observe, cancel, or rewrite the attempt. A modal tail remains the flow boundary:"},{"type":"text","text":" "},{"type":"text","text":"stack-pop intents do not bypass it."}],"type":"paragraph"},{"type":"heading","anchor":"Path-reconciliation","text":"Path reconciliation","level":2},{"type":"paragraph","inlineContent":[{"text":"When SwiftUI changes the path, InnoRouter translates that change back into semantic commands:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"prefix shrink -> "},{"type":"codeVoice","code":".popCount"},{"type":"text","text":" or "},{"type":"codeVoice","code":".popToRoot"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"prefix expand -> per-step "},{"code":".push","type":"codeVoice"},{"type":"text","text":" batch"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"mismatch -> "},{"code":"NavigationPathMismatchPolicy","type":"codeVoice"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"This preserves command meaning instead of treating every path change as a blind replacement.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"NavigationStoreConfiguration"},{"type":"text","text":" defaults to "},{"type":"codeVoice","code":".replace"},{"type":"text","text":", which treats the"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI binding as the source of truth for a non-prefix rewrite and emits"},{"type":"text","text":" "},{"type":"text","text":"a "},{"type":"codeVoice","code":"NavigationPathMismatchEvent"},{"type":"text","text":". For debug or pre-release builds, use"},{"type":"text","text":" "},{"type":"codeVoice","code":".assertAndReplace"},{"type":"text","text":" to make unexpected rewrites loud while still"},{"type":"text","text":" "},{"type":"text","text":"recovering. Use "},{"type":"codeVoice","code":".ignore"},{"type":"text","text":" only when the store must remain the sole"},{"type":"text","text":" "},{"text":"authority, and ","type":"text"},{"code":".custom","type":"codeVoice"},{"text":" when a host has domain-specific repair rules.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"article","variants":[{"paths":["\/documentation\/innorouterswiftui\/navigationstore-and-hosts"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" is the default self-contained stack-plus-modal surface."},{"type":"text","text":" "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" is the advanced stack-only authority to use when the"},{"type":"text","text":" "},{"type":"text","text":"application needs to own navigation state outside a host."}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/NavigationStore-and-Hosts"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","te