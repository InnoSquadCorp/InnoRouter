{"metadata":{"title":"NavigationStore and hosts","modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article"},"abstract":[{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" is the default self-contained stack-plus-modal surface."},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" is the advanced stack-only authority to use when the"},{"type":"text","text":" "},{"type":"text","text":"application needs to own navigation state outside a host."}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/navigationstore-and-hosts"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/NavigationStore-and-Hosts"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Start macro-first","anchor":"Start-macro-first","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a local stack and modal flow, declare destinations on the route and let"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" own the unified store:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Router","enum AppRoute {","    case detail(id: String)","    case settings","","    var destination: some View {","        switch self {","        case .detail(let id):","            DetailView(id: id)","        case .settings:","            SettingsView()","        }","    }","}","","struct AppRoot: View {","    var body: some View {","        RouterHost(AppRoute.self) {","            HomeView()","        }","    }","}","","struct HomeView: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    var body: some View {","        Button(\"Open settings\") {","            router.go(.settings)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" generates "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" and "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":" conformance. If the host"},{"type":"text","text":" "},{"type":"text","text":"is missing or the route type does not match the nearest host,"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" follows "},{"type":"codeVoice","code":"EnvironmentMissingPolicy"},{"type":"text","text":" and fails loudly by"},{"type":"text","text":" "},{"type":"text","text":"default."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add literal origin allowlists and "},{"code":"@DeepLink","type":"codeVoice"},{"type":"text","text":" markers when a URL resolves to"},{"type":"text","text":" "},{"type":"text","text":"one pushed route. "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" installs the incoming-URL handler automatically;"},{"type":"text","text":" "},{"type":"text","text":"no application "},{"type":"codeVoice","code":"onOpenURL"},{"type":"text","text":" bridge is needed for that path."}]},{"type":"heading","text":"Promote the store when another boundary needs it","anchor":"Promote-the-store-when-another-boundary-needs-it","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create the "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" outside the host when authentication or pending"},{"type":"text","text":" "},{"type":"text","text":"replay, multi-step deep-link reconciliation, state restoration, middleware"},{"type":"text","text":" "},{"type":"text","text":"mutation, event observation, or another application boundary needs direct"},{"type":"text","text":" "},{"type":"text","text":"access. The "},{"type":"codeVoice","code":"DestinationRoute"},{"type":"text","text":" generated by "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" keeps this advanced host"},{"type":"text","text":" "},{"type":"text","text":"concise:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@State private var navigation = NavigationStore<AppRoute>()","","NavigationHost(store: navigation) {","    HomeView()","}"]},{"anchor":"What-the-store-owns","type":"heading","level":2,"text":"What the store owns"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" owns:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the current "},{"code":"RouteStack","type":"codeVoice"},{"type":"text","text":" snapshot"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"command execution"}]}]},{"content":[{"inlineContent":[{"text":"batch execution","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"transactional execution","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"path reconciliation from ","type":"text"},{"code":"NavigationStack(path:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"middleware registry orchestration"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"typed observation events for analytics and diagnostics"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Configuration is centralized in ","type":"text"},{"type":"codeVoice","code":"NavigationStoreConfiguration"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Its synchronous observation surface is one ","type":"text"},{"type":"codeVoice","code":"onEvent"},{"text":" callback that","type":"text"},{"text":" ","type":"text"},{"text":"switches over ","type":"text"},{"code":"NavigationEvent","type":"codeVoice"},{"text":"; ","type":"text"},{"type":"codeVoice","code":"NavigationStore.events"},{"text":" provides the","type":"text"},{"text":" ","type":"text"},{"text":"same cases as an ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":".","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let configuration = NavigationStoreConfiguration<AppRoute>(","    onEvent: { event in","        switch event {","        case .changed(_, let new):","            analytics.recordPath(new.path)","        case .batchExecuted(let result):","            analytics.recordBatch(result)","        case .transactionExecuted(let result):","            analytics.recordTransaction(result)","        case .middlewareMutation(let mutation):","            diagnostics.record(mutation)","        case .pathMismatch(let mismatch):","            diagnostics.record(mismatch)","        }","    }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a 5.0 migration, move the bodies of the former per-event"},{"type":"text","text":" "},{"type":"text","text":"configuration closures into these switch cases. No compatibility"},{"type":"text","text":" "},{"type":"text","text":"closures remain."}]},{"anchor":"Host-responsibilities","level":2,"type":"heading","text":"Host responsibilities"},{"inlineContent":[{"code":"NavigationHost","type":"codeVoice"},{"type":"text","text":" and "},{"code":"CoordinatorHost","type":"codeVoice"},{"type":"text","text":" connect SwiftUI navigation UI to the store or coordinator:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"render the root view"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"render destinations for pushed routes"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"publish one route-typed authority consumed through "},{"type":"codeVoice","code":"@EnvironmentRouter"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"bridge system path changes back into router commands"}]}]}]},{"inlineContent":[{"type":"text","text":"Views should not mutate a store directly. The default view-facing surface is"},{"type":"text","text":" "},{"code":"@EnvironmentRouter","type":"codeVoice"},{"type":"text","text":", whose "},{"code":"RouterActions","type":"codeVoice"},{"type":"text","text":" methods emit typed"},{"type":"text","text":" "},{"code":"NavigationIntent","type":"codeVoice"},{"type":"text","text":" values. Use "},{"code":"go","type":"codeVoice"},{"type":"text","text":", "},{"code":"back","type":"codeVoice"},{"type":"text","text":", and the other focused conveniences"},{"type":"text","text":" "},{"type":"text","text":"for common transitions, and "},{"code":"send(_:)","type":"codeVoice"},{"type":"text","text":" as the explicit escape hatch for an"},{"type":"text","text":" "},{"type":"text","text":"advanced intent. The same "},{"code":"@EnvironmentRouter(Route.self)","type":"codeVoice"},{"type":"text","text":" surface is used for"},{"type":"text","text":" "},{"type":"text","text":"navigation, modal, flow, and tab capabilities supplied by the matching host."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" for synchronous analytics or diagnostics and "},{"code":"events","type":"codeVoice"},{"type":"text","text":" when an"},{"type":"text","text":" "},{"type":"text","text":"asynchronous consumer should own the observation task. Supplying "},{"code":"logger","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"also records private, structured summaries through the store’s internal OSLog"},{"type":"text","text":" "},{"type":"text","text":"integration; no separate telemetry adapter is required."}],"type":"paragraph"},{"anchor":"Intent-command-shape","level":3,"type":"heading","text":"Intent command shape"},{"inlineContent":[{"code":"NavigationStore.send(_:)","type":"codeVoice"},{"type":"text","text":" and the navigation adapter owned by "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"use the same middleware-visible command shape:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"empty ","type":"text"},{"code":"goMany","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"pushMany","type":"codeVoice"},{"type":"text","text":" -> no command"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"one route -> ","type":"text"},{"type":"codeVoice","code":".push"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"multiple routes -> one atomic "},{"type":"codeVoice","code":".pushAll"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"backBy"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"popCount"},{"type":"text","text":" equal to the current stack depth -> "},{"code":".popToRoot","type":"codeVoice"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"With no modal tail, pop attempts enter middleware even on an empty stack."},{"type":"text","text":" "},{"type":"text","text":"The engine may still return a no-op or failure, but middleware can consistently"},{"text":" ","type":"text"},{"text":"observe, cancel, or rewrite the attempt. A modal tail remains the flow boundary:","type":"text"},{"type":"text","text":" "},{"type":"text","text":"stack-pop intents do not bypass it."}]},{"anchor":"Path-reconciliation","type":"heading","level":2,"text":"Path reconciliation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When SwiftUI changes the path, InnoRouter translates that change back into semantic commands:"}]},{"items":[{"content":[{"inlineContent":[{"text":"prefix shrink -> ","type":"text"},{"code":".popCount","type":"codeVoice"},{"text":" or ","type":"text"},{"type":"codeVoice","code":".popToRoot"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"prefix expand -> per-step ","type":"text"},{"code":".push","type":"codeVoice"},{"text":" batch","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"mismatch -> "},{"code":"NavigationPathMismatchPolicy","type":"codeVoice"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This preserves command meaning instead of treating every path change as a blind replacement."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStoreConfiguration"},{"type":"text","text":" defaults to "},{"type":"codeVoice","code":".replace"},{"type":"text","text":", which treats the"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI binding as the source of truth for a non-prefix rewrite and emits"},{"text":" ","type":"text"},{"text":"a ","type":"text"},{"type":"codeVoice","code":"NavigationPathMismatchEvent"},{"type":"text","text":". For debug or pre-release builds, use"},{"type":"text","text":" "},{"type":"codeVoice","code":".assertAndReplace"},{"type":"text","text":" to make unexpected rewrites loud while still"},{"type":"text","text":" "},{"type":"text","text":"recovering. Use "},{"type":"codeVoice","code":".ignore"},{"type":"text","text":" only when the store must remain the sole"},{"type":"text","text":" "},{"type":"text","text":"authority, and "},{"type":"codeVoice","code":".custom"},{"text":" when a host has domain-specific repair rules.","type":"text"}]}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"kind":"article","title":"InnoRouterSwiftUI","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting","type":"topic"}}}