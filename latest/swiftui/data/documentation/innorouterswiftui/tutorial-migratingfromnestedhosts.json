{"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Starting point","anchor":"Starting-point"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An app that shipped before "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" landed typically has:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@main","struct LegacyApp: App {","    @State private var nav = NavigationStore<AppRoute>()","    @State private var modal = ModalStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            ModalHost(store: modal, destination: destination) {","                NavigationHost(store: nav, destination: destination) {","                    RootView()","                }","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two stores. Two hosts. Path + modal state cannot be round-tripped"},{"type":"text","text":" "},{"type":"text","text":"as one value — the app can’t persist “user is 3 screens deep"},{"type":"text","text":" "},{"type":"text","text":"inside a presented sheet” without hand-serializing both halves."}]},{"type":"heading","level":2,"text":"Target shape","anchor":"Target-shape"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@main","struct MigratedApp: App {","    @State private var flow = FlowStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: flow,","                destination: destination,","                root: { RootView() }","            )","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"One store. One host. "},{"type":"codeVoice","code":"flow.path: [RouteStep<AppRoute>]"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"single source of truth; push + sheet + cover are three cases of"},{"type":"text","text":" "},{"type":"text","text":"the same enum."}]},{"type":