{"metadata":{"roleHeading":"Article","title":"Migrating from Nested Hosts to `FlowHost`","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"abstract":[{"type":"text","text":"Replace manually composed "},{"type":"codeVoice","code":"ModalHost { NavigationHost { ... } }"},{"type":"text","text":" "},{"type":"text","text":"surfaces with a single "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" backed by "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":". Preserve"},{"type":"text","text":" "},{"type":"text","text":"existing "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" configurations while"},{"type":"text","text":" "},{"type":"text","text":"unlocking a serializable "},{"type":"codeVoice","code":"[RouteStep<R>]"},{"type":"text","text":" path and"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore.apply(_:)"},{"type":"text","text":" for restoration + deep-link hydration."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-migratingfromnestedhosts"]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This is an advanced promotion path. A self-contained push-only feature should","type":"text"},{"text":" ","type":"text"},{"text":"stay on ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"text":"; introduce the externally owned stores below","type":"text"},{"text":" ","type":"text"},{"text":"only when push and modal state must be restored or deep-linked as one value.","type":"text"}]},{"type":"heading","anchor":"Starting-point","level":2,"text":"Starting point"},{"type":"paragraph","inlineContent":[{"text":"An app that shipped before ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" landed typically has:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@main","struct LegacyApp: App {","    @State private var nav = NavigationStore<AppRoute>()","    @State private var modal = ModalStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            ModalHost(store: modal, destination: destination) {","                NavigationHost(store: nav, destination: destination) {","                    RootView()","                }","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Two stores. Two hosts. Path + modal state cannot be round-tripped","type":"text"},{"text":" ","type":"text"},{"text":"as one value — the app can’t persist “user is 3 screens deep","type":"text"},{"text":" ","type":"text"},{"text":"inside a presented sheet” without hand-serializing both halves.","type":"text"}]},{"type":"heading","anchor":"Target-shape","level":2,"text":"Target shape"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@main","struct MigratedApp: App {","    @State private var flow = FlowStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: flow,","                destination: destination,","                root: { RootView() }","            )","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"One store. One host. ","type":"text"},{"code":"flow.path: [RouteStep<AppRoute>]","type":"codeVoice"},{"type":"text","text":" is the"},{"type":"text","text":" "},{"type":"text","text":"single source of truth; push + sheet + cover are three cases of"},{"type":"text","text":" "},{"type":"text","text":"the same enum."}]},{"type":"heading","anchor":"Migration-steps","level":2,"text":"Migration steps"},{"anchor":"1-Swap-the-host-layering","level":3,"type":"heading","text":"1. Swap the host layering"},{"inlineContent":[{"type":"text","text":"Replace the nested host pair with "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":". It renders environment-free"},{"type":"text","text":" "},{"type":"text","text":"navigation and modal surfaces around one "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then publishes one"},{"type":"text","text":" "},{"type":"text","text":"unified authority for "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"text":". External observable behavior stays","type":"text"},{"text":" ","type":"text"},{"text":"the same without exposing the inner stores as independent mutation surfaces.","type":"text"}],"type":"paragraph"},{"anchor":"2-Route-view-actions-through-EnvironmentRouter","level":3,"type":"heading","text":"2. Route view actions through `EnvironmentRouter`"},{"inlineContent":[{"text":"Old:","type":"text"}],"type":"paragraph"},{"code":["navigationStore.send(.go(.detail))","modalStore.present(.sheet, style: .sheet)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"New:","type":"text"}],"type":"paragraph"},{"code":["@EnvironmentRouter(AppRoute.self) private var router","\/\/ ...","router.go(.detail)","router.sheet(.sheet)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"router.send(flow:)"},{"text":" only for flow-specific operations such as resetting a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"complete "},{"type":"codeVoice","code":"RouteStep"},{"type":"text","text":" path."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"FlowStore.send"},{"text":" routes navigation and modal intents through the corresponding","type":"text"},{"type":"text","text":" "},{"type":"text","text":"configured middleware and reports their wrapped events through the unified"},{"type":"text","text":" "},{"type":"text","text":"flow observation stream."}],"type":"paragraph"},{"anchor":"3-Port-store-configuration-through-FlowStoreConfiguration","level":3,"type":"heading","text":"3. Port store configuration through `FlowStoreConfiguration`"},{"inlineContent":[{"type":"codeVoice","code":"FlowStoreConfiguration"},{"text":" composes ","type":"text"},{"type":"codeVoice","code":"NavigationStoreConfiguration"},{"type":"text","text":" +"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalStoreConfiguration"},{"text":", so existing configs port 1:1:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let flow = FlowStore<AppRoute>(","    configuration: .init(","        navigation: legacyNavigationConfiguration,","        modal: legacyModalConfiguration,","        onEvent: { event in","            switch event {","            case .pathChanged(let old, let new):","                Log.debug(\"flow path: \\(old) -> \\(new)\")","            case .intentRejected(let intent, let reason):","                Log.info(\"flow rejected \\(intent): \\(reason)\")","            case .navigation(let event):","                Log.debug(\"navigation event: \\(event)\")","            case .modal(let event):","                Log.debug(\"modal event: \\(event)\")","            }","        }","    )",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In 5.0, each store configuration has one typed "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" callback."},{"type":"text","text":" "},{"type":"text","text":"Remove the former per-case callback arguments and switch over the"},{"type":"text","text":" "},{"type":"text","text":"matching event enum instead. The flow-level callback also receives"},{"type":"text","text":" "},{"type":"text","text":"the inner navigation and modal events as wrapped cases; callbacks"},{"type":"text","text":" "},{"type":"text","text":"already installed on the two legacy configurations still receive"},{"type":"text","text":" "},{"type":"text","text":"their direct "},{"type":"codeVoice","code":"NavigationEvent"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalEvent"},{"type":"text","text":" values."}]},{"level":3,"text":"4. Handle the two new invariant-violation paths","type":"heading","anchor":"4-Handle-the-two-new-invariant-violation-paths"},{"type":"paragraph","inlineContent":[{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" rejects intents that would violate its invariants:"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Intent situation","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Reason emitted","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".push"},{"text":" while a modal tail is active","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pushBlockedByModalTail"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".reset([.sheet, .push])"},{"text":" (modal not at tail)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".invalidResetPath"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Any intent cancelled by middleware","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".middlewareRejected(debugName:)"}]}]]]},{"inlineContent":[{"type":"text","text":"Subscribe to "},{"type":"codeVoice","code":"flow.events"},{"type":"text","text":" or handle "},{"type":"codeVoice","code":".intentRejected"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"text","text":"configuration’s "},{"type":"codeVoice","code":"onEvent"},{"text":" closure. The legacy","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"stores never had this signal; before the migration, a push attempt"},{"type":"text","text":" "},{"type":"text","text":"during a sheet presentation silently no-opped or tripped up the"},{"text":" ","type":"text"},{"type":"text","text":"app in subtle ways."}],"type":"paragraph"},{"type":"heading","anchor":"5-Adopt-apply-for-deep-links-and-restoration","level":3,"text":"5. Adopt `apply(_:)` for deep links and restoration"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowPlan<R>.steps"},{"text":" is ","type":"text"},{"code":"[RouteStep<R>]","type":"codeVoice"},{"type":"text","text":", so once your routes opt"},{"type":"text","text":" "},{"type":"text","text":"into "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["extension AppRoute: Codable {}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StatePersistence<AppRoute>"},{"text":" round-trips the whole flow state:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let persistence = StatePersistence<AppRoute>()","","\/\/ On app background","try persistence.encode(FlowPlan(steps: flow.path)).write(to: url)","","\/\/ On launch","if let data = try? Data(contentsOf: url) {","    flow.apply(try persistence.decode(data))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Deep-link resolvers can emit a "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" directly and hand it to"},{"type":"text","text":" "},{"type":"codeVoice","code":"flow.apply(_:)"},{"type":"text","text":" to hydrate a push + sheet terminal URL in one"},{"type":"text","text":" "},{"type":"text","text":"atomic step."}]},{"type":"heading","anchor":"6-Migrate-tests-incrementally","level":3,"text":"6. Migrate tests incrementally"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTestStore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalTestStore"},{"type":"text","text":" remain available, so tests that"},{"type":"text","text":" "},{"type":"text","text":"infer their event types can keep the same test-store setup. Removed event"},{"type":"text","text":" "},{"type":"text","text":"typealiases do not preserve explicit annotations: migrate those annotations to"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationEvent<R>"},{"type":"text","text":" or "},{"type":"codeVoice","code":"ModalEvent<M>"},{"type":"text","text":", and use "},{"type":"codeVoice","code":"FlowEvent<R>"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":". Re-home the highest-value scenarios onto "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"you get a chance — a single "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" subscription asserts both"},{"type":"text","text":" "},{"type":"text","text":"navigation and modal emissions in the same FIFO queue, which usually"},{"type":"text","text":" "},{"type":"text","text":"compresses a 40-line legacy test into 15 lines."}]},{"type":"heading","anchor":"Rollback-story","level":2,"text":"Rollback story"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The migration is per-flow. Any screen tree that still uses the"},{"type":"text","text":" "},{"type":"text","text":"nested host pair continues to build. "},{"type":"codeVoice","code":"FlowHost"},{"text":" lives alongside","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":"; adopting one doesn’t remove the"},{"type":"text","text":" "},{"type":"text","text":"others. Incremental migration by flow (onboarding, settings,"},{"text":" ","type":"text"},{"text":"checkout, …) is supported.","type":"text"}]},{"type":"heading","anchor":"Next-steps","level":2,"text":"Next steps"},{"type":"unorder