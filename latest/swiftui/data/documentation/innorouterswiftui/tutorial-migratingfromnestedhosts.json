es continues to run."}],"type":"paragraph"},{"text":"3. Port store configuration through `FlowStoreConfiguration`","anchor":"3-Port-store-configuration-through-FlowStoreConfiguration","level":3,"type":"heading"},{"inlineContent":[{"code":"FlowStoreConfiguration","type":"codeVoice"},{"text":" composes ","type":"text"},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"text":" +","type":"text"},{"text":" ","type":"text"},{"code":"ModalStoreConfiguration","type":"codeVoice"},{"text":", so existing configs port 1:1:","type":"text"}],"type":"paragraph"},{"code":["let flow = FlowStore<AppRoute>(","    configuration: .init(","        navigation: legacyNavigationConfiguration,","        modal: legacyModalConfiguration,","        onPathChanged: { old, new in Log.debug(\"flow path: \\(old) -> \\(new)\") },","        onIntentRejected: { intent, reason in Log.info(\"flow rejected \\(intent): \\(reason)\") }","    )",")"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"text":"4. Handle the two new invariant-violation paths","anchor":"4-Handle-the-two-new-invariant-violation-paths","level":3,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"FlowStore"},{"text":" rejects intents that would violate its invariants:","type":"text"}],"type":"paragraph"},{"header":"row","rows":[[[{"inlineContent":[{"text":"Intent situation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Reason emitted"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".push","type":"codeVoice"},{"type":"text","text":" while a modal tail is active"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".pushBlockedByModalTail"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".reset([.sheet, .push])"},{"type":"text","text":" (modal not at tail)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".invalidResetPath"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Any intent cance