"type":"text","text":"stay on "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" + "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":"; introduce the externally owned stores below"},{"type":"text","text":" "},{"type":"text","text":"only when push and modal state must be restored or deep-linked as one value."}]},{"level":2,"type":"heading","anchor":"Starting-point","text":"Starting point"},{"type":"paragraph","inlineContent":[{"text":"An app that shipped before ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" landed typically has:","type":"text"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@main","struct LegacyApp: App {","    @State private var nav = NavigationStore<AppRoute>()","    @State private var modal = ModalStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            ModalHost(store: modal, destination: destination) {","                NavigationHost(store: nav, destination: destination) {","                    RootView()","                }","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two stores. Two hosts. Path + modal state cannot be round-tripped"},{"type":"text","text":" "},{"type":"text","text":"as one value — the app can’t persist “user is 3 screens deep"},{"type":"text","text":" "},{"type":"text","text":"inside a presented sheet” without hand-serializing both halves."}]},{"level":2,"type":"heading","anchor":"Target-shape","text":"Target shape"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@main","struct MigratedApp: App {","    @State private var flow = FlowStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: flow,","                destination: destination,","                root: { RootView() }","            )","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"One store. One host. ","type":"text"},{"code":"flow.path: [RouteStep<AppRoute>]","type":"codeVoice"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"single source of truth; push + sheet + cover are three cases of","type":"text"},{"text":" ","type":"text"},{"text":"the same enum.","type":"text"}]},{"anchor":"Migration-steps","type":"heading","text":"Migration steps","level":2},{"anchor":"1-Swap-the-host-layering","type":"heading","text":"1. Swap the host layering","level":3},{"inlineContent":[{"text":"Replace the nested host pair with ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":". It renders environment-free","type":"text"},{"text":" ","type":"text"},{"text":"navigation and modal surfaces around one ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", then publishes one","type":"text"},{"text":" ","type":"text"},{"text":"unified authority for ","type":"text"},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":". External observable behavior stays"},{"type":"text","text":" "},{"type":"text","text":"the same without exposing the inner stores as independent mutation surfaces."}],"type":"paragraph"},{"type":"heading","anchor":"2-Route-view-actions-through-EnvironmentRouter","level":3,"text":"2. Route view actions through `EnvironmentRouter`"},{"type":"paragraph","inlineContent":[{"text":"Old:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["navigationStore.send(.go(.detail))","modalStore.present(.sheet, style: .sheet)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"New:"}]},{"type":"codeListing","code":["@EnvironmentRouter(AppRoute.self) private var router","\/\/ ...","router.go(.detail)","router.sheet(.sheet)"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"router.send(flow:)"},{"type":"text","text":" only for flow-specific operations such as resetting a"},{"type":"text","text":" "},{"type":"text","text":"complete "},{"type":"codeVoice","code":"RouteStep"},{"type":"text","text":" path."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowStore.send"},{"type":"text","text":" routes navigation and modal intents through the corresponding"},{"type":"text","text":" "},{"type":"text","text":"configured middleware and reports their wrapped events through the unified"},{"type":"text","text":" "},{"type":"text","text":"flow observation stream."}]},{"text":"3. Port store configuration through `FlowStoreConfiguration`","level":3,"type":"heading","anchor":"3-Port-store-configuration-through-FlowStoreConfiguration"},{"type":"paragraph","inlineContent":[{"code":"FlowStoreConfiguration","type":"codeVoice"},{"text":" composes ","type":"text"},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"text":" +","type":"text"},{"text":" ","type":"text"},{"code":"ModalStoreConfiguration","type":"codeVoice"},{"text":", so existing configs port 1:1:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let flow = FlowStore<AppRoute>(","    configuration: .init(","        navigation: legacyNavigationConfiguration,","        modal: legacyModalConfiguration,","        onEvent: { event in","            switch event {","            case .pathChanged(let old, let new):","                Log.debug(\"flow path: \\(old) -> \\(new)\")","            case .intentRejected(let intent, let reason):","                Log.info(\"flow rejected \\(intent): \\(reason)\")","            case .navigation(let event):","                Log.debug(\"navigation event: \\(event)\")","            case .modal(let event):","                Log.debug(\"modal event: \\(event)\")","            }","        }","    )",")"]},{"inlineContent":[{"type":"text","text":"In 5.0, each store configuration has one typed "},{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" callback."},{"type":"text","text":" "},{"type":"text","text":"Remove the former per-case callback arguments and switch over the"},{"type":"text","text":" "},{"type":"text","text":"matching event enum instead. The flow-level callback also receives"},{"type":"text","text":" "},{"type":"text","text":"the inner navigation and modal events as wrapped cases; callbacks"},{"type":"text","text":" "},{"type":"text","text":"already installed on the two legacy configurations still receive"},{"type":"text","text":" "},{"type":"text","text":"their direct "},{"code":"NavigationEvent","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"ModalEvent","type":"codeVoice"},{"type":"text","text":" values."}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"4-Handle-the-two-new-invariant-violation-paths","text":"4. Handle the two new invariant-violation paths"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowStore"},{"text":" rejects intents that would violate its invariants:","type":"text"}]},{"header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Intent situation"}]}],[{"inlineContent":[{"type":"text","text":"Reason emitted"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".push"},{"type":"text","text":" while a modal tail is active"}]}],[{"inlineContent":[{"type":"codeVoice","code":".pushBlockedByModalTail"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".reset([.sheet, .push])"},{"type":"text","text":" (modal not at tail)"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".invalidResetPath"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Any intent cancelled by middleware"}],"type":"paragraph"}],[{"inlineContent":[{"code":".middlewareRejected(debugName:)","type":"codeVoice"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Subscribe to "},{"type":"codeVoice","code":"flow.events"},{"type":"text","text":" or handle "},{"type":"codeVoice","code":".intentRejected"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"text","text":"configuration’s "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" closure. The legacy"},{"type":"text","text":" "},{"text":"stores never had this signal; before the migration, a push attempt","type":"text"},{"type":"text","text":" "},{"type":"text","text":"during a sheet presentation silently no-opped or tripped up the"},{"text":" ","type":"text"},{"text":"app in subtle ways.","type":"text"}]},{"type":"heading","level":3,"text":"5. Adopt `apply(_:)` for deep links and restoration","anchor":"5-Adopt-apply-for-deep-links-and-restoration"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowPlan<R>.steps"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[RouteStep<R>]"},{"type":"text","text":", so once your routes opt"},{"type":"text","text":" "},{"type":"text","text":"into "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":":"}]},{"syntax":"swift skip doc-fragment","code":["extension AppRoute: Codable {}"],"type":"codeListing"},{"inlineContent":[{"code":"StatePersistence<AppRoute>","type":"codeVoice"},{"text":" round-trips the whole flow state:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let persistence = StatePersistence<AppRoute>()","","\/\/ On app background","try persistence.encode(FlowPlan(steps: flow.path)).write(to: url)","","\/\/ On launch","if let data = try? Data(contentsOf: url) {","    flow.apply(try persistence.decode(data))","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Deep-link resolvers can emit a ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" directly and hand it to","type":"text"},{"text":" ","type":"text"},{"code":"flow.apply(_:)","type":"codeVoice"},{"text":" to hydrate a push + sheet terminal URL in one","type":"text"},{"text":" ","type":"text"},{"text":"atomic step.","type":"text"}]},{"level":3,"text":"6. Migrate tests incrementally","type":"heading","anchor":"6-Migrate-tests-incrementally"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTestStore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalTestStore"},{"type":"text","text":" remain available, so tests that"},{"type":"text","text":" "},{"type":"text","text":"infer their event types can keep the same test-store setup. Removed event"},{"type":"text","text":" "},{"type":"text","text":"typealiases do not preserve explicit annotations: migrate those annotations to"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationEvent<R>"},{"type":"text","text":" or "},{"type":"codeVoice","code":"ModalEvent<M>"},{"type":"text","text":", and use "},{"type":"codeVoice","code":"FlowEvent<R>"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":". Re-home the highest-value scenarios onto "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" when"},{"type":"text","text":" "},{"type":"text","text":"you get a chance — a single "},{"code":"FlowTestStore","type":"codeVoice"},{"type":"text","text":" subscription asserts both"},{"type":"text","text":" "},{"type":"text","text":"navigation and modal emissions in the same FIFO queue, which usually"},{"type":"text","text":" "},{"type":"text","text":"compresses a 40-line legacy test into 15 lines."}]},{"anchor":"Rollback-story","text":"Rollback story","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The migration is per-flow. Any screen tree that still uses the"},{"type":"text","text":" "},{"type":"text","text":"nested host pair continues to build. "},{"code":"FlowHost","type":"codeVoice"},{"type":"text","text":" lives alongside"},{"type":"text","text":" "},{"code":"ModalHost","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"NavigationHost","type":"codeVoice"},{"type":"text","text":"; adopting one doesn’t remove the"},{"type":"text","text":" "},{"type":"text","text":"others. Incremental migration by flow (onboarding, settings,"},{"type":"text","text":" "},{"type":"text","text":"checkout, …) is supported."}]},{"text":"Next steps","type":"heading","anchor":"Next-steps","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","type":"reference","isActive":true},{"text":" to see a greenfield flow","type":"text"},{"type":"text","text":" "},{"text":"composed with ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Read the "},{"type":"codeVoice","code":"Tutorial-TestingFlows"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" documentation catalog for the full host-less"},{"text":" ","type":"text"},{"text":"test harness story.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"See the ","type":"text"},{"inlineContent":[{"type":"codeVoice","code":"send(_:)"},{"type":"text","text":" vs "},{"type":"codeVoice","code":"execute(_:)"},{"type":"text","text":" — picking the right entry"},{"text":" ","type":"text"},{"text":"point","type":"text"}],"type":"strong"},{"text":" section of the README for guidance on choosing among","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"send"},{"type":"text","text":", "},{"type":"codeVoice","code":"execute"},{"text":", ","type":"text"},{"type":"codeVoice","code":"executeBatch"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"executeTransaction"},{"type":"text","text":" once"},{"type":"text","text":" "},{"type":"text","text":"the flow is