{"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"This is an advanced promotion path. A self-contained push-only feature should","type":"text"},{"type":"text","text":" "},{"type":"text","text":"stay on "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" + "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":"; introduce the externally owned stores below"},{"type":"text","text":" "},{"type":"text","text":"only when push and modal state must be restored or deep-linked as one value."}]},{"type":"heading","level":2,"text":"Starting point","anchor":"Starting-point"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An app that shipped before "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" landed typically has:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@main","struct LegacyApp: App {","    @State private var nav = NavigationStore<AppRoute>()","    @State private var modal = ModalStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            ModalHost(store: modal, destination: destination) {","                NavigationHost(store: nav, destination: destination) {","                    RootView()","                }","            }","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"Two stores. Two hosts. Path + modal state cannot be round-tripped"},{"type":"text","text":" "},{"type":"text","text":"as one value — the app can’t persist “user is 3 screens deep"},{"type":"text","text":" "},{"type":"text","text":"inside a presented sheet” without hand-serializing both halves."}],"type":"paragraph"},{"anchor":"Target-shape","level":2,"text":"Target shape","type":"heading"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@main","struct MigratedApp: App {","    @State private var flow = FlowStore<AppRoute>()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: flow,","                destination: destination,","                root: { RootView() }","            )","        }","    }","}"]},{"inlineContent":[{"text":"One store. One host. ","type":"text"},{"type":"codeVoice","code":"flow.path: [RouteStep<AppRoute>]"},{"text":" is the","type":"text"},{"text":" ","type":"text"},{"text":"single source of truth; push + sheet + cover are three cases of","type":"text"},{"text":" ","type":"text"},{"text":"the same enum.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Migration steps","anchor":"Migration-steps"},{"type":"heading","text":"1. Swap the host layering","anchor":"1-Swap-the-host-layering","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace the nested host pair with "},{"code":"FlowHost","type":"codeVoice"},{"text":". It renders environment-free","type":"text"},{"type":"text","text":" "},{"type":"text","text":"navigation and modal surfaces around one "},{"type":"codeVoice","code":"FlowStore"},{"text":", then publishes one","type":"text"},{"type":"text","text":" "},{"type":"text","text":"unified authority for "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":". External observable behavior stays"},{"text":" ","type":"text"},{"text":"the same without exposing the inner stores as independent mutation surfaces.","type":"text"}]},{"type":"heading","level":3,"text":"2. Route view actions through `EnvironmentRouter`","anchor":"2-Route-view-actions-through-EnvironmentRouter"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Old:"}]},{"syntax":"swift skip doc-fragment","code":["navigationStore.send(.go(.detail))","modalStore.present(.sheet, style: .sheet)"],"type":"codeListing"},{"inlineContent":[{"text":"New:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@EnvironmentRouter(AppRoute.self) private var router","\/\/ ...","router.go(.detail)","router.sheet(.sheet)"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"router.send(flow:)","type":"codeVoice"},{"text":" only for flow-specific operations such as resetting a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"complete "},{"type":"codeVoice","code":"RouteStep"},{"text":" path.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"FlowStore.send","type":"codeVoice"},{"type":"text","text":" routes navigation and modal intents through the corresponding"},{"type":"text","text":" "},{"type":"text","text":"configured middleware and reports their wrapped events through the unified"},{"text":" ","type":"text"},{"text":"flow observation stream.","type":"text"}]},{"text":"3. Port store configuration through `FlowStoreConfiguration`","anchor":"3-Port-store-configuration-through-FlowStoreConfiguration","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowStoreConfiguration"},{"text":" composes ","type":"text"},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"text":" +","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ModalStoreConfiguration"},{"type":"text","text":", so existing configs port 1:1:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let flow = FlowStore<AppRoute>(","    configuration: .init(","        navigation: legacyNavigationConfiguration,","        modal: legacyModalConfiguration,","        onEvent: { event in","            switch event {","            case .pathChanged(let old, let new):","                Log.debug(\"flow path: \\(old) -> \\(new)\")","            case .intentRejected(let intent, let reason):","                Log.info(\"flow rejected \\(intent): \\(reason)\")","            case .navigation(let event):","                Log.debug(\"navigation event: \\(event)\")","            case .modal(let event):","                Log.debug(\"modal event: \\(event)\")","            }","        }","    )",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In 5.0, each store configuration has one typed "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" callback."},{"text":" ","type":"text"},{"text":"Remove the former per-case callback arguments and switch over the","type":"text"},{"text":" ","type":"text"},{"text":"matching event enum instead. The flow-level callback also receives","type":"text"},{"text":" ","type":"text"},{"text":"the inner navigation and modal events as wrapped cases; callbacks","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"already installed on the two legacy configurations still receive"},{"type":"text","text":" "},{"type":"text","text":"their direct "},{"type":"codeVoice","code":"NavigationEvent"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalEvent"},{"type":"text","text":" values."}]},{"level":3,"type":"heading","text":"4. Handle the two new invariant-violation paths","anchor":"4-Handle-the-two-new-invariant-violation-paths"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" rejects intents that would violate its invariants:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Intent situation"}]}],[{"type":"paragraph","inlineContent":[{"text":"Reason emitted","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".push"},{"text":" while a modal tail is active","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pushBlockedByModalTail"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".reset([.sheet, .push])","type":"codeVoice"},{"text":" (modal not at tail)","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":".invalidResetPath","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Any intent cancelled by middleware","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".middlewareRejected(debugName:)"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Subscribe to "},{"type":"codeVoice","code":"flow.events"},{"type":"text","text":" or handle "},{"type":"codeVoice","code":".intentRejected"},{"type":"text","text":" in the"},{"type":"text","text":" "},{"type":"text","text":"configuration’s "},{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" closure. The legacy"},{"type":"text","text":" "},{"type":"text","text":"stores never had this signal; before the migration, a push attempt"},{"type":"text","text":" "},{"type":"text","text":"during a sheet presentation silently no-opped or tripped up the"},{"type":"text","text":" "},{"type":"text","text":"app in subtle ways."}]},{"text":"5. Adopt `apply(_:)` for deep links and restoration","anchor":"5-Adopt-apply-for-deep-links-and-restoration","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowPlan<R>.steps"},{"type":"text","text":" is "},{"type":"codeVoice","code":"[RouteStep<R>]"},{"type":"text","text":", so once your routes opt"},{"type":"text","text":" "},{"type":"text","text":"into "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["extension AppRoute: Codable {}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StatePersistence<AppRoute>"},{"type":"text","text":" round-trips the whole flow state:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let persistence = StatePersistence<AppRoute>()","","\/\/ On app background","try persistence.encode(FlowPlan(steps: flow.path)).write(to: url)","","\/\/ On launch","if let data = try? Data(contentsOf: url) {","    flow.apply(try persistence.decode(data))","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Deep-link resolvers can emit a "},{"code":"FlowPlan","type":"codeVoice"},{"type":"text","text":" directly and hand it to"},{"type":"text","text":" "},{"code":"flow.apply(_:)","type":"codeVoice"},{"text":" to hydrate a push + sheet terminal URL in one","type":"text"},{"text":" ","type":"text"},{"text":"atomic step.","type":"text"}]},{"anchor":"6-Migrate-tests-incrementally","level":3,"text":"6. Migrate tests incrementally","type":"heading"},{"inlineContent":[{"code":"NavigationTestStore","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ModalTestStore","type":"codeVoice"},{"text":" remain available, so tests that","type":"text"},{"text":" ","type":"text"},{"text":"infer their event types can keep the same test-store setup. Removed event","type":"text"},{"text":" ","type":"text"},{"text":"typealiases do not preserve explicit annotations: migrate those annotations to","type":"text"},{"text":" ","type":"text"},{"code":"NavigationEvent<R>","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"ModalEvent<M>","type":"codeVoice"},{"type":"text","text":", and use "},{"type":"codeVoice","code":"FlowEvent<R>"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowTestStore"},{"text":". Re-home the highest-value scenarios onto ","type":"text"},{"type":"codeVoice","code":"FlowTestStore"},{"text":" when","type":"text"},{"text":" ","type":"text"},{"text":"you get a chance — a single ","type":"text"},{"type":"codeVoice","code":"FlowTestStore"},{"text":" subscription asserts both","type":"text"},{"text":" ","type":"text"},{"text":"navigation and modal emissions in the same FIFO queue, which usually","type":"text"},{"text":" ","type":"text"},{"text":"compresses a 40-line legacy test into 15 lines.","type":"text"}],"type":"paragraph"},{"anchor":"Rollback-story","level":2,"text":"Rollback story","type":"heading"},{"inlineContent":[{"type":"text","text":"The migration is per-flow. Any screen tree that still uses the"},{"type":"text","text":" "},{"type":"text","text":"nested host pair continues to build. "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" lives alongside"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":"; adopting one doesn’t remove the"},{"type":"text","text":" "},{"type":"text","text":"others. Incremental migration by flow (onboarding, settings,"},{"type":"text","text":" "},{"type":"text","text":"checkout, …) is supported."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Next steps","anchor":"Next-steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},{"text":" to see a greenfield flow","type":"text"},{"text":" ","type":"text"},{"text":"composed with ","type":"text"},{"type":"codeVoice","code":"FlowHost"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"ChildCoordinator"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read the ","type":"text"},{"code":"Tutorial-TestingFlows","type":"codeVoice"},{"text":" guide in the","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":" documentation catalog for the full host-less","type":"text"},{"text":" ","type":"text"},{"text":"test harness story.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"See the "},{"type":"strong","inlineContent":[{"type":"codeVoice","code":"send(_:)"},{"type":"text","text":" vs "},{"type":"codeVoice","code":"execute(_:)"},{"type":"text","text":" — picking the right entry"},{"type":"text","text":" "},{"type":"text","text":"point"}]},{"text":" section of the README for guidance on choosing among","type":"text"},{"text":" ","type":"text"},{"code":"send","type":"codeVoice"},{"text":", ","type":"text"},{"code":"execute","type":"codeVoice"},{"text":", ","type":"text"},{"code":"executeBatch","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"executeTransaction","type":"codeVoice"},{"text":" once","type":"text"},{"text":" ","type":"text"},{"text":"the flow is migrated.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"article","sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"title":"Migrating from Nested Hosts to `FlowHost`","role":"article","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}]},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-migratingfromnestedhosts"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts"},"abstract":[{"text":"Replace manually composed ","type":"text"},{"code":"ModalHost { NavigationHost { ... } }","type":"codeVoice"},{"text":" ","type":"text"},{"text":"surfaces with a single ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"type":"text","text":" backed by "},{"code":"FlowStore","type":"codeVoice"},{"text":". Preserve","type":"text"},{"text":" ","type":"text"},{"text":"existing ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" configurations while","type":"text"},{"text":" ","type":"text"},{"text":"unlocking a serializable ","type":"text"},{"code":"[RouteStep<R>]","type":"codeVoice"},{"text":" path and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStore.apply(_:)"},{"text":" for restoration + deep-link hydration.","type":"text"}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"kind":"article","abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then let the signup "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}],"url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","type":"topic","title":"Building a Login Onboarding Flow","role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","role":"collection","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","abstract":[],"type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"}}}