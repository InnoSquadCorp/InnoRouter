Content":[{"type":"codeVoice","code":"DeepLinkPipeline(matcher:)"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"Handle the new "},{"type":"codeVoice","code":"executionFailed(plan:batch:)"},{"type":"text","text":" outcome in exhaustive switches."},{"type":"text","text":" "},{"type":"text","text":"It distinguishes runtime command or middleware failure from preflight"},{"type":"text","text":" "},{"type":"codeVoice","code":"applicationRejected"},{"type":"text","text":" outcomes. Flow rejections now carry an exact"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowRejectionReason"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Update-advanced-navigation-code","level":2,"text":"Update advanced navigation code","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Removed or changed 4.x API"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"5.0 migration"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Custom "},{"type":"codeVoice","code":"NavigationPathReconciling"}]}],[{"type":"paragraph","inlineContent":[{"code":"NavigationPathMismatchPolicy.custom","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"NavigationStoreConfiguration.engine","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Remove the argument; stores own the stateless engine","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"validate(on:using:)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"canExecute(on:using:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"validate(on:)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"canExecute(on:)","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Public middleware handle initializers","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Retain the handle returned by registration","type":"text"}]}]],[[{"type":"