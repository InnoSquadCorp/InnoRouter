 and tests","type":"heading"},{"inlineContent":[{"type":"text","text":"Manual "},{"type":"codeVoice","code":"RouterTab"},{"type":"text","text":" conformances now return "},{"type":"codeVoice","code":"LocalizedStringResource"},{"type":"text","text":" from"},{"type":"text","text":" "},{"type":"codeVoice","code":"title"},{"type":"text","text":". A literal passed to "},{"type":"codeVoice","code":"@TabItem"},{"type":"text","text":" already generates the correct value."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For visionOS, add "},{"type":"codeVoice","code":"InnoRouterSpatial"},{"type":"text","text":", import it at scene call sites, declare"},{"type":"text","text":" "},{"type":"text","text":"scenes with "},{"type":"codeVoice","code":"@SceneRouter"},{"type":"text","text":", and interact through "},{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":", its "},{"type":"codeVoice","code":"events"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"and the public scene host or anchor modifiers. Do not construct"},{"type":"text","text":" "},{"type":"codeVoice","code":"SceneDeclaration"},{"type":"text","text":", inspect "},{"type":"codeVoice","code":"SceneRegistry"},{"type":"text","text":" storage, or drive host completion"},{"type":"text","text":" "},{"type":"text","text":"methods directly."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":", replace the legacy test-event aliases with"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationEvent"},{"type":"text","text":", "},{"type":"codeVoice","code":"ModalEvent"},{"type":"text","text":", and "},{"type":"codeVoice","code":"FlowEvent"},{"type":"text","text":". Use "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" as the terminal"},{"type":"text","text":" "},{"type":"text","text":"assertion and reserve "},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"type":"text","text":" for checkpoints between test"},{"type":"text","text":" "},{"type":"text","text":"phases."}],"type":"paragraph"},{"anchor":"Final-migration-checklist","level":2,"text":"Final migration checklist","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The app and every package target resolve with Swift 6.3."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Standard targets depend only on "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":"; opt-in targets explicitly add"},{"type":"text","text":" "},{"type":"text","text":"Effects or Spatial."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Local route surfaces use "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":", a generated host, and"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" unless an advanced ownership requirement is documented."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Observation uses "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" or "},{"type":"codeVoice","code":"events"},{"type":"text","text":", with no removed telemetry sinks or"},{"type":"text","text":" "},{"type":"text","text":"observer adapters."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect and deep-link result switches handle failure and rejection payloads."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"visionOS targets import "},{"type":"codeVoice","code":"InnoRouterSpatial"},{"type":"text","text":" directly."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tests call "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" and use canonical production event types."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every supported Apple platform builds, and incoming URLs, restoration,"},{"type":"text","text":" "},{"type":"text","text":"middleware cancellation, modal dismissal, and pending replay are exercised."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"For the exhaustive removed-symbol and behavior list, read the "},{"type":"codeVoice","code":"5.0.0"},{"type":"text","text":" section"},{"type":"text","text":" "},{"type":"text","text":"of the repository’s "},{"type":"codeVoice","code":"CHANGELOG.md"},{"type":"text","text":" alongside this task-oriented guide."}],"type":"paragraph"}]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"abstract":[],"type":"topic","role":"collection","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","kind":"symbol"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","kind":"article","title":"InnoRouterSwiftUI","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","abstract":[{"text":"Macro-first SwiftUI routing, externally owned stores, modal routing,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}]}}}