{"abstract":[{"text":"Move a 4.x application to the macro-first 5.0 surface in deliberate stages.","type":"text"},{"text":" ","type":"text"},{"text":"InnoRouter 5 removes compatibility shims and implementation-facing public API,","type":"text"},{"text":" ","type":"text"},{"text":"but keeps state-driven navigation, modal, flow, and deep-link behavior as the","type":"text"},{"text":" ","type":"text"},{"text":"advanced foundation beneath the generated hosts.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Migrating-To-InnoRouter-5","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/migrating-to-innorouter-5"]}],"kind":"article","metadata":{"role":"article","title":"Migrating from InnoRouter 4.x to 5.0","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Before-changing-source","level":2,"text":"Before changing source","type":"heading"},{"inlineContent":[{"type":"text","text":"Confirm the application can use the 5.0 toolchain and deployment floors:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Swift 6.3 or newer","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"iOS and iPadOS 18 or newer","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"macOS 15 or newer","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"tvOS 18 or newer","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"watchOS 11 or newer","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"visionOS 2 or newer","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Update the package requirement first, then resolve and build before editing"},{"type":"text","text":" "},{"type":"text","text":"call sites. This separates toolchain or dependency-resolution failures from"},{"type":"text","text":" "},{"type":"text","text":"source migration errors."}],"type":"paragraph"},{"code":[".package(","    url: \"https:\/\/github.com\/InnoSquadCorp\/InnoRouter.git\",","    from: \"5.0.0\"",")"],"syntax":"swift skip package-manifest-fragment","type":"codeListing"},{"anchor":"Choose-the-dependency-surface","level":2,"text":"Choose the dependency surface","type":"heading"},{"inlineContent":[{"type":"text","text":"Most application targets should depend on the "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" product and use one"},{"type":"text","text":" "},{"type":"text","text":"import. It now includes the macro declarations and the runtime needed by their"},{"type":"text","text":" "},{"type":"text","text":"generated conformances."}],"type":"paragraph"},{"code":["import SwiftUI","import InnoRouter"],"syntax":"swift skip import-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use granular products only for targets that intentionally avoid the macro"},{"type":"text","text":" "},{"type":"text","text":"plugin. Add "},{"type":"codeVoice","code":"InnoRouterEffects"},{"type":"text","text":" for reducer or app-boundary execution, and add"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterSpatial"},{"type":"text","text":" separately for visionOS scenes. The default umbrella does"},{"type":"text","text":" "},{"type":"text","text":"not re-export either opt-in product."}],"type":"paragraph"},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"4.x dependency or import"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"5.0 replacement"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" plus a separate macro product"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouter"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterNavigationEffects"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterEffects"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterDeepLinkEffects"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterEffects"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Spatial symbols from Core or SwiftUI"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterSpatial"}]}]]],"header":"row","type":"table"},{"anchor":"Adopt-the-macro-first-host-boundary","level":2,"text":"Adopt the macro-first host boundary","type":"heading"},{"inlineContent":[{"type":"text","text":"For a self-contained feature, declare destinations on one "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" enum,"},{"type":"text","text":" "},{"type":"text","text":"install the narrowest generated host, and route from descendants through"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":"."}],"type":"paragraph"},{"code":["@Router","enum AppRoute {","    case detail(id: String)","    case settings","","    var destination: some View {","        switch self {","        case .detail(let id):","            DetailView(id: id)","        case .settings:","            SettingsView()","        }","    }","}","","struct AppRoot: View {","    var body: some View {","        RouterHost(AppRoute.self) {","            HomeView()","        }","    }","}","","struct HomeView: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    va