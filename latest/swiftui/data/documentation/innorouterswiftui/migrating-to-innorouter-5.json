ners."}],"type":"paragraph"},{"anchor":"Consolidate-observation","level":2,"text":"Consolidate observation","type":"heading"},{"inlineContent":[{"type":"text","text":"Store-specific callbacks and telemetry sink protocols are replaced by one"},{"type":"text","text":" "},{"type":"text","text":"typed callback and one asynchronous stream per authority."}],"type":"paragraph"},{"code":["let configuration = NavigationStoreConfiguration<AppRoute>(","    onEvent: { event in","        switch event {","        case .changed(_, let newState):","            analytics.record(newState.path)","        case .batchExecuted(let result):","            analytics.record(result)","        default:","            break","        }","    }",")"],"syntax":"swift skip migration-example","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Replace "},{"type":"codeVoice","code":"onChange"},{"type":"text","text":", batch, transaction, middleware, path-mismatch, modal, and"},{"type":"text","text":" "},{"type":"text","text":"flow callbacks with the corresponding "},{"type":"codeVoice","code":"NavigationEvent"},{"type":"text","text":", "},{"type":"codeVoice","code":"ModalEvent"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowEvent"},{"type":"text","text":" case. Replace "},{"type":"codeVoice","code":"StoreObserver"},{"type":"text","text":" and "},{"type":"codeVoice","code":"observe(_:)"},{"type":"text","text":" with the store’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"events"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":". Capture the stream before starting its lifecycle-owned"},{"type":"text","text":" "},{"type":"text","text":"task so an immediate first event cannot race subscriber registration."}],"type":"paragraph"},{"anchor":"Update-effects-and-deep-links","level":2,"text":"Update effects and deep links","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"NavigationEffec