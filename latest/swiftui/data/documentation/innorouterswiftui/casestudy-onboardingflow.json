{"abstract":[{"text":"A representative composition of ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"NavigationMiddleware","type":"codeVoice"},{"text":" for a 12-screen","type":"text"},{"text":" ","type":"text"},{"text":"onboarding sequence with conditional branches, deep-link","type":"text"},{"text":" ","type":"text"},{"text":"resumption, and entitlement gating.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/CaseStudy-OnboardingFlow","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/casestudy-onboardingflow"]}],"metadata":{"role":"article","title":"Case study: shipping a 12-screen onboarding flow","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article"},"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"overview","level":2,"text":"Overview","type":"heading"},{"content":[{"inlineContent":[{"type":"text","text":"This is a synthesized case study against the public InnoRouter"},{"type":"text","text":" "},{"type":"text","text":"surface (v5.0). It does not represent a specific shipped app"},{"type":"text","text":" "},{"type":"text","text":"but is structured to match the shape of recurring requests"},{"type":"text","text":" "},{"type":"text","text":"from teams evaluating the framework."}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"anchor":"The-brief","level":2,"text":"The brief","type":"heading"},{"inlineContent":[{"text":"The flow:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Launch screen.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Welcome + region picker.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Phone-number entry.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"SMS verification (modal sheet).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Profile photo (skippable).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Display name.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Permission primer (one screen per permission requested).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Notification opt-in (system prompt, conditional next step).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Home location (skippable).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Work location (skippable).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Subscription pitch (modal sheet, conditional).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Welcome-home with feature tour.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"Constraints:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"Auth state is owned by an existing ","type":"text"},{"type":"codeVoice","code":"AuthClient"},{"text":". The flow","type":"text"},{"text":" ","type":"text"},{"text":"reads it but doesn’t own it.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Step ordering depends on user input (region → which","type":"text"},{"text":" ","type":"text"},{"text":"permissions to request, region → subscription eligibility).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The user can deep-link in via ","type":"text"},{"type":"codeVoice","code":"inno:\/\/onboarding\/profile"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"resume mid-flow with prior steps already validated.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Analytics fires on every step entry. A push from outside the","type":"text"},{"text":" ","type":"text"},{"text":"flow (e.g. a referral landing) shouldn’t double-fire entry","type":"text"},{"text":" ","type":"text"},{"text":"events.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"The-composition","level":2,"text":"The composition","type":"heading"},{"code":["@Routable","enum OnboardingRoute: Codable {","    case launch","    case welcome","    case phoneNumber","    case profilePhoto","    case displayName","    case permissionPrimer(Permission)","    case homeLocation","    case workLocation","    case smsVerification(phoneNumber: String)","    case subscription(plan: SubscriptionPlan)","    case welcomeHome","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"text":"One route type covers both push destinations and modal-only","type":"text"},{"text":" ","type":"text"},{"text":"destinations. ","type":"text"},{"type":"codeVoice","code":"FlowStore<OnboardingRoute>"},{"text":" exposes ","type":"text"},{"type":"codeVoice","code":"path: [RouteStep<OnboardingRoute>]"},{"text":": ","type":"text"},{"type":"codeVoice","code":".push(...)"},{"text":" steps drive the","type":"text"},{"text":" ","type":"text"},{"text":"navigation stack, while ","type":"text"},{"type":"codeVoice","code":".sheet(...)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".cover(...)"},{"text":" steps","type":"text"},{"text":" ","type":"text"},{"text":"drive modal presentation. Because the single route type is","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":", the entire flow state is serializable to a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":".","type":"text"}],"type":"paragraph"},{"code":["store.send(.presentSheet(.smsVerification(phoneNumber: phoneNumber)))","","let rehydrationPlan: FlowPlan<OnboardingRoute> = .init(steps: [","    .push(.launch),","    .push(.welcome),","    .sheet(.subscription(plan: subscriptionPlan)),","])"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"anchor":"The-driver","level":2,"text":"The driver","type":"heading"},{"code":["@MainActor","final class OnboardingDriver: ChildCoordinator {","    typealias Route = OnboardingRoute","    typealias Result = OnboardingResult","","    var onFinish: (@MainActor @Sendable (OnboardingResult) -> Void)?","    var onCancel: (@MainActor @Sendable () -> Void)?","","    let store: FlowStore<OnboardingRoute>","    private let auth: AuthClient","    private let analytics: AnalyticsClient","","    init(auth: AuthClient, analytics: AnalyticsClient) {","        self.auth = auth","        self.analytics = analytics","        self.store = FlowStore(","            configuration: FlowStoreConfiguration(","                navigation: NavigationStoreConfiguration(","                    middlewares: [","                        .init(middleware: AnalyticsMiddleware(analytics: analytics),","                              debugName: \"analytics\"),","                        .init(middleware: EntitlementGate(auth: auth),","                              debugName: \"entitlement\"),","                    ]","                ),","                onEvent: { [analytics] event in","                    switch event {","                    case .pathChanged(_, let new):","                        analytics.record(.flowPathChanged(new))","                    case .intentRejected(_, let reason):","                        analytics.record(.flowRejected(reason))","                    case .navigation, .modal:","                        break","                    }","                },","                queueCoalescePolicy: .dropQueued","            )","        )","    }","","    func start() {","        store.send(.replaceStack([.launch, .welcome]))","    }","","    func handleDeepLink(_ url: URL) async {","        guard let plan = OnboardingDeepLink.plan(from: url, auth: auth) else {","            store.send(.push(.welcome))","            return","        }","        _ = store.apply(plan)","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"ChildCoordinator"},{"text":" returns an ","type":"text"},{"type":"codeVoice","code":"OnboardingResult"},{"text":" to the parent","type":"text"},{"text":" ","type":"text"},{"text":"when the flow finishes:","type":"text"}],"type":"paragraph"},{"code":["enum OnboardingResult {","    case completed(profile: Profile)","    case abandoned(at: OnboardingRoute)","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"text":"The app-defined flow owner first stores ","type":"text"},{"type":"codeVoice","code":"onboardingDriver"},{"text":" in state that","type":"text"},{"text":" ","type":"text"},{"text":"presents the sheet, then directly awaits","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"onboardingDriver.waitForResult() async -> OnboardingResult?"},{"text":". The method waits","type":"text"},{"text":" ","type":"text"},{"text":"for the result but never presents the driver. Its structured call threads","type":"text"},{"text":" ","type":"text"},{"text":"caller-task cancellation back through ","type":"text"},{"type":"codeVoice","code":"parentDidCancel()"},{"text":" and returns ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" if","type":"text"},{"text":" ","type":"text"},{"text":"the sheet shell tears down its awaiting task. The owner clears its presentation","type":"text"},{"text":" ","type":"text"},{"text":"state after the call returns.","type":"text"}],"type":"paragraph"},{"anchor":"What-the-middlewares-earn","level":2,"text":"What the middlewares earn","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"AnalyticsMiddleware"},{"text":" records ","type":"text"},{"type":"codeVoice","code":".willExecute"},{"text":" and ","type":"text"},{"type":"codeVoice","code":".didExecute"},{"text":" ","type":"text"},{"text":"events for every navigation command, deduplicated against the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".pathChanged"},{"text":" case handled by ","type":"text"},{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Because middleware fires ","type":"text"},{"inlineContent":[{"type":"text","text":"before"}],"type":"strong"},{"text":" ","type":"text"},{"text":"state mutates, the analytics event always carries the intended","type":"text"},{"text":" ","type":"text"},{"text":"target route, not the post-cancellation snapshot.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"EntitlementGate"},{"text":" reads ","type":"text"},{"type":"codeVoice","code":"auth.isEligible(for: route)"},{"text":" for each","type":"text"},{"text":" ","type":"text"},{"text":"navigation prefix. If the user is not yet eligible for a","type":"text"},{"text":" ","type":"text"},{"text":"branch, navigation middleware cancels the ","type":"text"},{"type":"codeVoice","code":".replaceStack"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".reset"},{"text":" command with a typed reason; the flow falls back to","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".dropQueued"},{"text":" policy, dismissing any speculative modal state","type":"text"},{"text":" ","type":"text"},{"text":"that was queued behind the rejected navigation rewrite.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"type":"codeVoice","code":".intentRejected"},{"text":" case records a structured","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".middlewareRejected(debugName: \"entitlement\")"},{"text":" event so the","type":"text"},{"text":" ","type":"text"},{"text":"analytics layer can correlate with the same span ID.","type":"text"}],"type":"paragraph"},{"anchor":"What-FlowPlan-earns","level":2,"text":"What `FlowPlan` earns","type":"heading"},{"inlineContent":[{"text":"A deep link ","type":"text"},{"type":"codeVoice","code":"inno:\/\/onboarding\/profile"},{"text":" deserializes into:","type":"text"}],"type":"paragraph"},{"code":["let plan: FlowPlan<OnboardingRoute> = .init(","    steps: [","        .push(.launch),","        .push(.welcome),","        .push(.phoneNumber),","        .push(.profilePhoto),","    ]",")"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"store.apply(plan)"},{"text":" is atomic: every step previews against","type":"text"},{"text":" ","type":"text"},{"text":"middleware in order, and the entire plan rolls back if any","type":"text"},{"text":" ","type":"text"},{"text":"preview rejects. The user never sees a half-applied flow even","type":"text"},{"text":" ","type":"text"},{"text":"if the entitlement gate decides one of the intermediate steps","type":"text"},{"text":" ","type":"text"},{"text":"is currently unreachable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Because ","type":"text"},{"type":"codeVoice","code":"OnboardingRoute"},{"text":" is ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":", the same ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" can","type":"text"},{"text":" ","type":"text"},{"text":"be persisted to ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" on ","type":"text"},{"code":"scenePhase: .background","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and restored on the next cold launch via","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowPlan(validating:)"},{"text":" — the validating constructor rejects","type":"text"},{"text":" ","type":"text"},{"text":"invariant violations (e.g. two modal steps) before the","type":"text"},{"text":" ","type":"text"},{"text":"authority sees them.","type":"text"}],"type":"paragraph"},{"anchor":"What-InnoRouterTesting-earns","level":2,"text":"What `InnoRouterTesting` earns","type":"heading"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@Test","func onboardingResumesFromProfile() async throws {","    let auth = AuthClient.signedIn(region: .us)","    let analytics = RecordingAnalytics()","    let test = FlowTestStore<OnboardingRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: EntitlementGate(auth: auth)),","            ])","        )","    )","","    test.send(.push(.launch))","    test.expect(navigation: [.launch])","    try await test.apply(","        FlowPlan(steps: [","            .push(.launch),","            .push(.welcome),","            .push(.phoneNumber),","            .push(.profilePhoto),","        ])","    )","    test.expect(navigation: [.launch, .welcome, .phoneNumber, .profilePhoto])","    test.expect(modal: nil)","}"]},{"inlineContent":[{"text":"No SwiftUI host in scope. The exact same store configuration —","type":"text"},{"text":" ","type":"text"},{"text":"including production analytics middleware — is exercised in","type":"text"},{"text":" ","type":"text"},{"text":"the test and in production. ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"text":" reuses the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"text":", so the test can also verify","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"that "},{"code":"analytics.record(.flowPathChanged(...))","type":"codeVoice"},{"type":"text","text":" fired exactly"},{"text":" ","type":"text"},{"type":"text","text":"once per applied step."}],"type":"paragraph"},{"anchor":"Observed-wins","level":2,"text":"Observed wins","type":"heading"},{"inlineContent":[{"text":"In a comparable TCA-modeled flow before the swap, the same","type":"text"},{"text":" ","type":"text"},{"text":"feature carried:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"~340 lines of ","type":"text"},{"code":"Reducer","type":"codeVoice"},{"text":" boilerplate for navigation actions","type":"text"},{"text":" ","type":"text"},{"text":"alone (push \/ pop \/ present \/ dismiss \/ forward \/ hydrate).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Three custom test harnesses to assert state restoration,","type":"text"},{"text":" ","type":"text"},{"text":"deep-link replay, and entitlement gating in isolation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A bespoke “is the queue stale?” check after every cancelled","type":"text"},{"text":" ","type":"text"},{"text":"command because TCA’s ","type":"text"},{"code":"@Presents","type":"codeVoice"},{"text":" carry-over isn’t governed","type":"text"},{"text":" ","type":"text"},{"text":"by a policy at the framework level.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The InnoRouter version drops the navigation reducer","type":"text"},{"text":" ","type":"text"},{"text":"boilerplate entirely (the framework owns the state machine),","type":"text"},{"text":" ","type":"text"},{"text":"folds the three test harnesses into one ","type":"text"},{"type":"codeVoice","code":"FlowTestStore"},{"text":" ","type":"text"},{"text":"suite, and pushes the queue-coalesce decision into a single","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStoreConfiguration"},{"text":" setting that participates in the","type":"text"},{"text":" ","type":"text"},{"text":"analytics middleware’s span ID without extra wiring.","type":"text"}]},{"anchor":"When-this-composition-is-overkill","text":"When this composition is overkill","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"For a single-screen flow with no entitlement gating and no deep link, declare","type":"text"},{"text":" ","type":"text"},{"text":"the destinations with ","type":"text"},{"type":"codeVoice","code":"@Router"},{"text":" and use ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"text":". Promote to an externally","type":"text"},{"text":" ","type":"text"},{"text":"owned ","type":"text"},{"type":"codeVoice","code":"NavigationStore<R>"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"NavigationHost"},{"text":" only when another boundary needs","type":"text"},{"text":" ","type":"text"},{"text":"the store.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":" earns its surface specifically when:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Multiple steps need atomic deep-link rehydration.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The modal authority is genuinely concurrent with the","type":"text"},{"text":" ","type":"text"},{"text":"navigation stack (sheets, covers).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"A coordinator-level result (","type":"text"},{"code":"OnboardingResult","type":"codeVoice"},{"text":") needs to","type":"text"},{"text":" ","type":"text"},{"text":"bubble back to the parent.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Middleware needs to gate or telemeter the entire flow.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","kind":"article","title":"InnoRouterSwiftUI","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","abstract":[{"text":"Macro-first SwiftUI routing, externally owned stores, modal routing,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"abstract":[],"type":"topic","role":"collection","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","kind":"symbol"}}}