{"primaryContentSections":[{"content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"This is a synthesized case study against the public InnoRouter"},{"type":"text","text":" "},{"type":"text","text":"surface (v5.0). It does not represent a specific shipped app"},{"type":"text","text":" "},{"type":"text","text":"but is structured to match the shape of recurring requests"},{"type":"text","text":" "},{"type":"text","text":"from teams evaluating the framework."}]}],"type":"aside","style":"note","name":"Note"},{"level":2,"anchor":"The-brief","type":"heading","text":"The brief"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The flow:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Launch screen."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Welcome + region picker."}]}]},{"content":[{"inlineContent":[{"text":"Phone-number entry.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"SMS verification (modal sheet)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Profile photo (skippable)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Display name."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Permission primer (one screen per permission requested)."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Notification opt-in (system prompt, conditional next step)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Home location (skippable).","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Work location (skippable)."}]}]},{"content":[{"inlineContent":[{"text":"Subscription pitch (modal sheet, conditional).","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Welcome-home with feature tour.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"Constraints:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Auth state is owned by an existing "},{"type":"codeVoice","code":"AuthClient"},{"type":"text","text":". The flow"},{"type":"text","text":" "},{"type":"text","text":"reads it but doesn’t own it."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Step ordering depends on user input (region → which","type":"text"},{"type":"text","text":" "},{"text":"permissions to request, region → subscription eligibility).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The user can deep-link in via "},{"type":"codeVoice","code":"inno:\/\/onboarding\/profile"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"resume mid-flow with prior steps already validated."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Analytics fires on every step entry. A push from outside the"},{"type":"text","text":" "},{"type":"text","text":"flow (e.g. a referral landing) shouldn’t double-fire entry"},{"text":" ","type":"text"},{"type":"text","text":"events."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"The-composition","level":2,"text":"The composition"},{"syntax":"swift skip doc-fragment","code":["@Routable","enum OnboardingRoute: Codable {","    case launch","    case welcome","    case phoneNumber","    case profilePhoto","    case displayName","    case permissionPrimer(Permission)","    case homeLocation","    case workLocation","    case smsVerification(phoneNumber: String)","    case subscription(plan: SubscriptionPlan)","    case welcomeHome","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"One route type covers both push destinations and modal-only"},{"type":"text","text":" "},{"type":"text","text":"destinations. "},{"code":"FlowStore<OnboardingRoute>","type":"codeVoice"},{"type":"text","text":" exposes "},{"code":"path: [RouteStep<OnboardingRoute>]","type":"codeVoice"},{"type":"text","text":": "},{"code":".push(...)","type":"codeVoice"},{"type":"text","text":" steps drive the"},{"text":" ","type":"text"},{"type":"text","text":"navigation stack, while "},{"type":"codeVoice","code":".sheet(...)"},{"text":" and ","type":"text"},{"code":".cover(...)","type":"codeVoice"},{"text":" steps","type":"text"},{"type":"text","text":" "},{"text":"drive modal presentation. Because the single route type is","type":"text"},{"type":"text","text":" "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":", the entire flow state is serializable to a"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":"."}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["store.send(.presentSheet(.smsVerification(phoneNumber: phoneNumber)))","","let rehydrationPlan: FlowPlan<OnboardingRoute> = .init(steps: [","    .push(.launch),","    .push(.welcome),","    .sheet(.subscription(plan: subscriptionPlan)),","])"],"type":"codeListing"},{"level":2,"text":"The driver","type":"heading","anchor":"The-driver"},{"syntax":"swift skip doc-fragment","code":["@MainActor","final class OnboardingDriver: ChildCoordinator {","    typealias Route = OnboardingRoute","    typealias Result = OnboardingResult","","    var onFinish: (@MainActor @Sendable (OnboardingResult) -> Void)?","    var onCancel: (@MainActor @Sendable () -> Void)?","","    let store: FlowStore<OnboardingRoute>","    private let auth: AuthClient","    private let analytics: AnalyticsClient","","    init(auth: AuthClient, analytics: AnalyticsClient) {","        self.auth = auth","        self.analytics = analytics","        self.store = FlowStore(","            configuration: FlowStoreConfiguration(","                navigation: NavigationStoreConfiguration(","                    middlewares: [","                        .init(middleware: AnalyticsMiddleware(analytics: analytics),","                              debugName: \"analytics\"),","                        .init(middleware: EntitlementGate(auth: auth),","                              debugName: \"entitlement\"),","                    ]","                ),","                onEvent: { [analytics] event in","                    switch event {","                    case .pathChanged(_, let new):","                        analytics.record(.flowPathChanged(new))","                    case .intentRejected(_, let reason):","                        analytics.record(.flowRejected(reason))","                    case .navigation, .modal:","                        break","                    }","                },","                queueCoalescePolicy: .dropQueued","            )","        )","    }","","    func start() {","        store.send(.replaceStack([.launch, .welcome]))","    }","","    func handleDeepLink(_ url: URL) async {","        guard let plan = OnboardingDeepLink.plan(from: url, auth: auth) else {","            store.send(.push(.welcome))","            return","        }","        _ = store.apply(plan)","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" returns an "},{"type":"codeVoice","code":"OnboardingResult"},{"type":"text","text":" to the parent"},{"type":"text","text":" "},{"text":"when the flow finishes:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["enum OnboardingResult {","    case completed(profile: Profile)","    case abandoned(at: OnboardingRoute)","}"]},{"inlineContent":[{"type":"text","text":"The app-defined flow owner first stores "},{"type":"codeVoice","code":"onboardingDriver"},{"type":"text","text":" in state that"},{"text":" ","type":"text"},{"text":"presents the sheet, then directly awaits","type":"text"},{"type":"text","text":" "},{"code":"onboardingDriver.waitForResult() async -> OnboardingResult?","type":"codeVoice"},{"text":". The method waits","type":"text"},{"type":"text","text":" "},{"text":"for the result but never presents the driver. Its structured call threads","type":"text"},{"text":" ","type":"text"},{"text":"caller-task cancellation back through ","type":"text"},{"code":"parentDidCancel()","type":"codeVoice"},{"text":" and returns ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" if","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the sheet shell tears down its awaiting task. The owner clears its presentation"},{"text":" ","type":"text"},{"text":"state after the call returns.","type":"text"}],"type":"paragraph"},{"level":2,"text":"What the middlewares earn","anchor":"What-the-middlewares-earn","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"AnalyticsMiddleware"},{"type":"text","text":" records "},{"type":"codeVoice","code":".willExecute"},{"type":"text","text":" and "},{"type":"codeVoice","code":".didExecute"},{"type":"text","text":" "},{"type":"text","text":"events for every navigation command, deduplicated against the"},{"type":"text","text":" "},{"type":"codeVoice","code":".pathChanged"},{"type":"text","text":" case handled by "},{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Because middleware fires "},{"inlineContent":[{"type":"text","text":"before"}],"type":"strong"},{"type":"text","text":" "},{"type":"text","text":"state mutates, the analytics event always carries the intended"},{"type":"text","text":" "},{"type":"text","text":"target route, not the post-cancellation snapshot."}],"type":"paragraph"},{"inlineContent":[{"code":"EntitlementGate","type":"codeVoice"},{"type":"text","text":" reads "},{"code":"auth.isEligible(for: route)","type":"codeVoice"},{"type":"text","text":" for each"},{"type":"text","text":" "},{"type":"text","text":"navigation prefix. If the user is not yet eligible for a"},{"type":"text","text":" "},{"type":"text","text":"branch, navigation middleware cancels the "},{"code":".replaceStack","type":"codeVoice"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"code":".reset","type":"codeVoice"},{"type":"text","text":" command with a typed reason; the flow falls back to"},{"text":" ","type":"text"},{"code":".dropQueued","type":"codeVoice"},{"text":" policy, dismissing any speculative modal state","type":"text"},{"text":" ","type":"text"},{"text":"that was queued behind the rejected navigation rewrite.","type":"text"},{"text":" ","type":"text"},{"text":"The ","type":"text"},{"code":".intentRejected","type":"codeVoice"},{"text":" case records a structured","type":"text"},{"text":" ","type":"text"},{"code":".middlewareRejected(debugName: \"entitlement\")","type":"codeVoice"},{"text":" event so the","type":"text"},{"text":" ","type":"text"},{"text":"analytics layer can correlate with the same span ID.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"What-FlowPlan-earns","text":"What `FlowPlan` earns","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A deep link "},{"code":"inno:\/\/onboarding\/profile","type":"codeVoice"},{"type":"text","text":" deserializes into:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let plan: FlowPlan<OnboardingRoute> = .init(","    steps: [","        .push(.launch),","        .push(.welcome),","        .push(.phoneNumber),","        .push(.profilePhoto),","    ]",")"]},{"type":"paragraph","inlineContent":[{"code":"store.apply(plan)","type":"codeVoice"},{"type":"text","text":" is atomic: every step previews against"},{"type":"text","text":" "},{"type":"text","text":"middleware in order, and the entire plan rolls back if any"},{"type":"text","text":" "},{"type":"text","text":"preview rejects. The user never sees a half-applied flow even"},{"type":"text","text":" "},{"type":"text","text":"if the entitlement gate decides one of the intermediate steps"},{"text":" ","type":"text"},{"type":"text","text":"is currently unreachable."}]},{"inlineContent":[{"text":"Because ","type":"text"},{"code":"OnboardingRoute","type":"codeVoice"},{"type":"text","text":" is "},{"code":"Codable","type":"codeVoice"},{"type":"text","text":", the same "},{"code":"FlowPlan","type":"codeVoice"},{"type":"text","text":" can"},{"text":" ","type":"text"},{"text":"be persisted to ","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":" on ","type":"text"},{"type":"codeVoice","code":"scenePhase: .background"},{"type":"text","text":" "},{"type":"text","text":"and restored on the next cold launch via"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan(validating:)"},{"type":"text","text":" — the validating constructor rejects"},{"type":"text","text":" "},{"type":"text","text":"invariant violations (e.g. two modal steps) before the"},{"type":"text","text":" "},{"type":"text","text":"authority sees them."}],"type":"paragraph"},{"anchor":"What-InnoRouterTesting-earns","type":"heading","level":2,"text":"What `InnoRouterTesting` earns"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@Test","func onboardingResumesFromProfile() async throws {","    let auth = AuthClient.signedIn(region: .us)","    let analytics = RecordingAnalytics()","    let test = FlowTestStore<OnboardingRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: EntitlementGate(auth: auth)),","            ])","        )","    )","","    test.send(.push(.launch))","    test.expect(navigation: [.launch])","    try await test.apply(","        FlowPlan(steps: [","            .push(.launch),","            .push(.welcome),","            .push(.phoneNumber),","            .push(.profilePhoto),","        ])","    )","    test.expect(navigation: [.launch, .welcome, .phoneNumber, .profilePhoto])","    test.expect(modal: nil)","}"]},{"inlineContent":[{"text":"No SwiftUI host in scope. The exact same store configuration —","type":"text"},{"text":" ","type":"text"},{"text":"including production analytics middleware — is exercised in","type":"text"},{"type":"text","text":" "},{"text":"the test and in production. ","type":"text"},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" reuses the"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"type":"text","text":", so the test can also verify"},{"type":"text","text":" "},{"text":"that ","type":"text"},{"type":"codeVoice","code":"analytics.record(.flowPathChanged(...))"},{"text":" fired exactly","type":"text"},{"type":"text","text":" "},{"text":"once per applied step.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Observed wins","anchor":"Observed-wins"},{"inlineContent":[{"type":"text","text":"In a comparable TCA-modeled flow before the swap, the same"},{"type":"text","text":" "},{"type":"text","text":"feature carried:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"~340 lines of ","type":"text"},{"code":"Reducer","type":"codeVoice"},{"text":" boilerplate for navigation actions","type":"text"},{"text":" ","type":"text"},{"text":"alone (push \/ pop \/ present \/ dismiss \/ forward \/ hydrate).","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Three custom test harnesses to assert state restoration,","type":"text"},{"text":" ","type":"text"},{"text":"deep-link replay, and entitlement gating in isolation.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A bespoke “is the queue stale?” check after every cancelled","type":"text"},{"text":" ","type":"text"},{"text":"command because TCA’s ","type":"text"},{"type":"codeVoice","code":"@Presents"},{"text":" carry-over isn’t governed","type":"text"},{"text":" ","type":"text"},{"text":"by a policy at the framework level.","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"The InnoRouter version drops the navigation reducer","type":"text"},{"text":" ","type":"text"},{"text":"boilerplate entirely (the framework owns the state machine),","type":"text"},{"text":" ","type":"text"},{"text":"folds the three test harnesses into one ","type":"text"},{"code":"FlowTestStore","type":"codeVoice"},{"text":" ","type":"text"},{"text":"suite, and pushes the queue-coalesce decision into a single","type":"text"},{"text":" ","type":"text"},{"code":"FlowStoreConfiguration","type":"codeVoice"},{"text":" setting that participates in the","type":"text"},{"text":" ","type":"text"},{"text":"analytics middleware’s span ID without extra wiring.","type":"text"}]},{"text":"When this composition is overkill","anchor":"When-this-composition-is-overkill","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"For a single-screen flow with no entitlement gating and no deep link, declare","type":"text"},{"text":" ","type":"text"},{"text":"the destinations with ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" and use ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":". Promote to an externally"},{"text":" ","type":"text"},{"text":"owned ","type":"text"},{"type":"codeVoice","code":"NavigationStore<R>"},{"type":"text","text":" + "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" only when another boundary needs"},{"type":"text","text":" "},{"text":"the store.","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":" earns its surface specifically when:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Multiple steps need atomic deep-link rehydration."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The modal authority is genuinely concurrent with the"},{"type":"text","text":" "},{"type":"text","text":"navigation stack (sheets, covers)."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A coordinator-level result ("},{"type":"codeVoice","code":"OnboardingResult"},{"type":"text","text":") needs to"},{"type":"text","text":" "},{"type":"text","text":"bubble back to the parent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Middleware needs to gate or telemeter the entire flow.","type":"text"}]}]}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/CaseStudy-OnboardingFlow"},"abstract":[{"type":"text","text":"A representative composition of "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", "},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"FlowPlan","type":"codeVoice"},{"type":"text","text":", and "},{"code":"NavigationMiddleware","type":"codeVoice"},{"type":"text","text":" for a 12-screen"},{"type":"text","text":" "},{"text":"onboarding sequence with conditional branches, deep-link","type":"text"},{"text":" ","type":"text"},{"text":"resumption, and entitlement gating.","type":"text"}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/casestudy-onboardingflow"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"metadata":{"roleHeading":"Article","role":"article","title":"Case study: shipping a 12-screen onboarding flow","modules":[{"name":"InnoRouterTesting"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","role":"collection","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","abstract":[],"type":"topic"}}}