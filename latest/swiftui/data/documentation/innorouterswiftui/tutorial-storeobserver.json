{"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Observing Stores via Protocol Adapters"},"abstract":[{"code":"StoreObserver","type":"codeVoice"},{"text":" is a thin protocol adapter over the ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" that every InnoRouter store publishes. Use it when","type":"text"},{"text":" ","type":"text"},{"text":"protocol dispatch reads clearer than a ","type":"text"},{"code":"for await","type":"codeVoice"},{"text":" loop — typically","type":"text"},{"text":" ","type":"text"},{"text":"in AppDelegate wiring, analytics adapters, or anywhere you want","type":"text"},{"text":" ","type":"text"},{"text":"static methods instead of iterator plumbing.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-storeobserver"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-StoreObserver"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Scenario","level":2,"text":"Scenario","type":"heading"},{"inlineContent":[{"text":"An analytics adapter wants to react to every navigation change,","type":"text"},{"text":" ","type":"text"},{"text":"modal present, and flow path rewrite. Writing three ","type":"text"},{"code":"for await","type":"codeVoice"},{"text":" ","type":"text"},{"text":"loops, one per store, reads noisy. ","type":"text"},{"code":"StoreObserver","type":"codeVoice"},{"text":" lets the adapter","type":"text"},{"text":" ","type":"text"},{"text":"implement three typed ","type":"text"},{"code":"handle(_:)","type":"codeVoice"},{"text":" methods and subscribe once per","type":"text"},{"text":" ","type":"text"},{"text":"store.","type":"text"}],"type":"paragraph"},{"anchor":"Implementation","level":2,"text":"Implementation","type":"heading"},{"code":["@MainActor","final class AnalyticsObserver: StoreObserver {","    typealias RouteType = AppRoute","","    func handle(_ event: NavigationEvent<AppRoute>) {","        if case .changed(_, let to) = event {","            Analytics.track(\"nav_change\", [\"path\": to.path.description])","        }","    }","","    func handle(_ event: ModalEvent<AppRoute>) {","        if case .presented(let presentation) = event {","            Analytics.track(\"modal_open\", [\"route\": \"\\(presentation.route)\"])","        }","    }","","    func handle(_ event: FlowEvent<AppRoute>) {","        if case .intentRejected(_, let reason) = event {","            Analytics.track(\"flow_rejected\", [\"reason\": \"\\(reason)\"])","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"text":"Any subset of the three ","type":"text"},{"code":"handle(_:)","type":"codeVoice"},{"text":" methods is fine — the others","type":"text"},{"text":" ","type":"text"},{"text":"default to no-ops via a protocol extension.","type":"text"}],"type":"paragraph"},{"anchor":"Attaching","level":2,"text":"Attaching","type":"heading"},{"code":["let observer = AnalyticsObserver()","let navSubscription = navigationStore.observe(observer)","let modalSubscription = modalStore.observe(observer)","let flowSubscription = flowStore.observe(observer)"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"text":"Each ","type":"text"},{"code":"observe(_:)","type":"codeVoice"},{"text":" returns a ","type":"text"},{"code":"StoreObserverSubscription","type":"codeVoice"},{"text":". Keep it","type":"text"},{"text":" ","type":"text"},{"text":"around for the observer’s lifetime; when the","type":"text"},{"text":" ","type":"text"},{"code":"StoreObserverSubscription","type":"codeVoice"},{"text":" itself is deinitialized it auto-cancels","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"code":"isolated deinit","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To stop observing early:"}],"type":"paragraph"},{"code":["navSubscription.cancel()"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Subsequent store events are not delivered to the observer."}],"type":"paragraph"},{"level":2,"anchor":"FlowStore-routing","text":"FlowStore routing","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"FlowStore.observe(_:)","type":"codeVoice"},{"text":" is special: it iterates the flow’s","type":"text"},{"text":" ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" stream (which already wraps inner navigation \/ modal","type":"text"},{"text":" ","type":"text"},{"text":"emissions) and routes them through the observer’s matching typed","type":"text"},{"text":" ","type":"text"},{"code":"handle(_:)","type":"codeVoice"},{"text":" overload. One subscription covers all three authorities","type":"text"},{"text":" ","type":"text"},{"text":"on a flow surface.","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["let flowSubscription = flowStore.observe(observer)","\/\/ observer.handle(.navigation(.changed(…))) → observer.handle(_:NavigationEvent)","\/\/ observer.handle(.modal(.presented(…)))    → observer.handle(_:ModalEvent)","\/\/ observer.handle(.pathChanged(…))          → observer.handle(_:FlowEvent)"],"type":"codeListing"},{"level":2,"anchor":"When-to-reach-for-for-await-instead","text":"When to reach for `for await` instead","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use the raw "},{"type":"codeVoice","code":"events"},{"type":"text","text":" stream when:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"cancellation flow needs to compose with other async sequences"},{"type":"text","text":" "},{"type":"text","text":"(combine, merge, retry, …)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the handler body wants to "},{"type":"codeVoice","code":"await"},{"type":"text","text":" inside an event (e.g. log to"},{"type":"text","text":" "},{"type":"text","text":"a remote service and gate subsequent events on the response)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"events feed a structured concurrency pipeline with explicit task"},{"type":"text","text":" "},{"type":"text","text":"lifetimes"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"code":"StoreObserver","type":"codeVoice"},{"text":" when:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the adapter is a long-lived object (analytics, crash reporting)","type":"text"},{"text":" ","type":"text"},{"text":"and protocol methods read clearer than an iterator loop","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"multiple stores feed the same observer with typed dispatch"}]}]}],"type":"unorderedList"},{"level":2,"anchor":"Multiple-observers","text":"Multiple observers","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every "},{"code":"observe(_:)","type":"codeVoice"},{"type":"text","text":" call creates an independent subscription, so"},{"type":"text","text":" "},{"type":"text","text":"multiple observers on the same store all receive the same events."},{"type":"text","text":" "},{"type":"text","text":"Fan-out is free — the underlying "},{"code":"events","type":"codeVoice"},{"type":"text","text":" "},{"code":"AsyncStream","type":"codeVoice"},{"type":"text","text":" multicasts"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"codeVoice","code":"EventBroadcaster"},{"type":"text","text":"."}]},{"anchor":"Next-steps","text":"Next steps","level":2,"type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling"},{"type":"text","text":" for one more use case — observing"},{"type":"text","text":" "},{"type":"text","text":"throttle cancellations through the same protocol dispatch."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},{"type":"text","text":" for pre-execution hooks"},{"type":"text","text":" "},{"type":"text","text":"that complement post-execution observation."}]}]}],"type":"unorderedList"}]}],"kind":"article","references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MiddlewareComposition":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that guarantees "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" only runs for middlewares"},{"type":"text","text":" "},{"type":"text","text":"that accepted the command."}],"type":"topic","url":"\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition","kind":"article","title":"Composing Middleware Across Navigation and Modal","role":"article"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-Throttling":{"url":"\/documentation\/innorouterswiftui\/tutorial-throttling","title":"Throttling Rapid Navigation Taps","type":"topic","kind":"article","abstract":[{"text":"Rate-limit navigation commands without threading timestamps through","type":"text"},{"text":" ","type":"text"},{"text":"every call site. ","type":"text"},{"code":"ThrottleNavigationMiddleware","type":"codeVoice"},{"text":" cancels commands that","type":"text"},{"text":" ","type":"text"},{"text":"arrive within a minimum interval of a previously accepted command","type":"text"},{"text":" ","type":"text"},{"text":"sharing the same key.","type":"text"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling","role":"article"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"type":"topic","abstract":[{"text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter.","type":"text"}],"title":"InnoRouterSwiftUI","kind":"article","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","abstract":[],"type":"topic","url":"\/documentation\/innoroutertesting","role":"collection","kind":"symbol"}}}