{"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-StoreObserver"},"abstract":[{"type":"codeVoice","code":"StoreObserver"},{"text":" is a thin protocol adapter over the ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" that every InnoRouter store publishes. Use it when","type":"text"},{"text":" ","type":"text"},{"text":"protocol dispatch reads clearer than a ","type":"text"},{"code":"for await","type":"codeVoice"},{"text":" loop — typically","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"in AppDelegate wiring, analytics adapters, or anywhere you want"},{"type":"text","text":" "},{"type":"text","text":"static methods instead of iterator plumbing."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Scenario","anchor":"Scenario","type":"heading"},{"inlineContent":[{"text":"An analytics adapter wants to react to every navigation change,","type":"text"},{"text":" ","type":"text"},{"text":"modal present, and flow path rewrite. Writing three ","type":"text"},{"code":"for await","type":"codeVoice"},{"text":" ","type":"text"},{"text":"loops, one per store, reads noisy. ","type":"text"},{"code":"StoreObserver","type":"codeVoice"},{"text":" lets the adapter","type":"text"},{"text":" ","type":"text"},{"text":"implement three typed ","type":"text"},{"code":"handle(_:)","type":"codeVoice"},{"text":" methods and subscribe once per","type":"text"},{"text":" ","type":"text"},{"text":"store.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Implementation","anchor":"Implementation","type":"heading"},{"code":["@MainActor","final class AnalyticsObserver: StoreObserver {","    typealias RouteType = AppRoute","","    func handle(_ event: NavigationEvent<AppRoute>) {","        if case .changed(_, let to) = event {","            Analytics.track(\"nav_change\", [\"path\": to.path.description])","        }","    }","","    func handle(_ event: ModalEvent<AppRoute>) {","        if case .presented(let presentation) = event {","            Analytics.track(\"modal_open\", [\"route\": \"\\(presentation.route)\"])","        }","    }","","    func handle(_ event: FlowEvent<AppRoute>) {","        if case .intentRejected(_, let reason) = event {","            Analytics.track(\"flow_rejected\", [\"reason\": \"\\(reason)\"])","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Any subset of the three "},{"type":"codeVoice","code":"handle(_:)"},{"type":"text","text":" methods is fine — the others"},{"type":"text","text":" "},{"type":"text","text":"default to no-ops via a protocol extension."}],"type":"paragraph"},{"level":2,"text":"Attaching","anchor":"Attaching","type":"heading"},{"code":["let observer = AnalyticsObserver()","let navSubscription = navigationStore.observe(observer)","let modalSubscription = modalStore.observe(observer)","let flowSubscription = flowStore.observe(observer)"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"text":"Each ","type":"text"},{"type":"codeVoice","code":"observe(_:)"},{"text":" returns a ","type":"text"},{"type":"codeVoice","code":"StoreObserverSubscription"},{"text":". Keep it","type":"text"},{"text":" ","type":"text"},{"text":"around for the observer’s lifetime; when the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"StoreObserverSubscription"},{"text":" itself is deinitialized it auto-cancels","type":"text"},{"text":" ","type":"text"},{"text":"via ","type":"text"},{"type":"codeVoice","code":"isolated deinit"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"To stop observing early:","type":"text"}],"type":"paragraph"},{"code":["navSubscription.cancel()"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"text":"Subsequent store events are not delivered to the observer.","type":"text"}],"type":"paragraph"},{"level":2,"text":"FlowStore routing","anchor":"FlowStore-routing","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"FlowStore.observe(_:)"},{"text":" is special: it iterates the flow’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" stream (which already wraps inner navigation \/ modal","type":"text"},{"text":" ","type":"text"},{"text":"emissions) and routes them through the observer’s matching typed","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"handle(_:)"},{"text":" overload. One subscription covers all three authorities","type":"text"},{"text":" ","type":"text"},{"text":"on a flow surface.","type":"text"}],"type":"paragraph"},{"code":["let flowSubscription = flowStore.observe(observer)","\/\/ observer.handle(.navigation(.changed(…))) → observer.handle(_:NavigationEvent)","\/\/ observer.handle(.modal(.presented(…)))    → observer.handle(_:ModalEvent)","\/\/ observer.handle(.pathChanged(…))          → observer.handle(_:FlowEvent)"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"text":"When to reach for `for await` instead","anchor":"When-to-reach-for-for-await-instead","type":"heading"},{"inlineContent":[{"type":"text","text":"Use the raw "},{"type":"codeVoice","code":"events"},{"type":"text","text":" stream when:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"cancellation flow needs to compose with other async sequences"},{"type":"text","text":" "},{"type":"text","text":"(combine, merge, retry, …)"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the handler body wants to "},{"code":"await","type":"codeVoice"},{"type":"text","text":" inside an event (e.g. log to"},{"type":"text","text":" "},{"type":"text","text":"a remote service and gate subsequent events on the response)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"events feed a structured concurrency pipeline with explicit task"},{"type":"text","text":" "},{"type":"text","text":"lifetimes"}]}]}]},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"StoreObserver","type":"codeVoice"},{"text":" when:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the adapter is a long-lived object (analytics, crash reporting)"},{"type":"text","text":" "},{"type":"text","text":"and protocol methods read clearer than an iterator loop"}]}]},{"content":[{"inlineContent":[{"text":"multiple stores feed the same observer with typed dispatch","type":"text"}],"type":"paragraph"}]}]},{"level":2,"text":"Multiple observers","anchor":"Multiple-observers","type":"heading"},{"inlineContent":[{"text":"Every ","type":"text"},{"code":"observe(_:)","type":"codeVoice"},{"text":" call creates an independent subscription, so","type":"text"},{"text":" ","type":"text"},{"text":"multiple observers on the same store all receive the same events.","type":"text"},{"text":" ","type":"text"},{"text":"Fan-out is free — the underlying ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":" multicasts","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"code":"EventBroadcaster","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"text":"Next steps","anchor":"Next-steps","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling"},{"type":"text","text":" for one more use case — observing"},{"type":"text","text":" "},{"type":"text","text":"throttle cancellations through the same protocol dispatch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"See ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","isActive":true,"type":"reference"},{"text":" for pre-execution hooks","type":"text"},{"text":" ","type":"text"},{"text":"that complement post-execution observation.","type":"text"}],"type":"paragraph"}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-storeobserver"]}],"kind":"article","metadata":{"role":"article","roleHeading":"Article","title":"Observing Stores via Protocol Adapters","modules":[{"name":"InnoRouterTesting"}]},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter.","type":"text"}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","kind":"article","type":"topic","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-Throttling":{"title":"Throttling Rapid Navigation Taps","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-Throttling","type":"topic","abstract":[{"type":"text","text":"Rate-limit navigation commands without threading timestamps through"},{"type":"text","text":" "},{"type"