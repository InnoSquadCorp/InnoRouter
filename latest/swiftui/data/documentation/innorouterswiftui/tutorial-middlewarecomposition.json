{"sections":[],"abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that pairs completion callbacks with the middlewares"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" hook actually ran."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Scenario","text":"Scenario"},{"type":"paragraph","inlineContent":[{"text":"Every ","type":"text"},{"code":"NavigationCommand","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ModalCommand","type":"codeVoice"},{"type":"text","text":" should be logged"},{"type":"text","text":" "},{"type":"text","text":"before it executes. A feature-flagged screen must be gated behind"},{"type":"text","text":" "},{"type":"text","text":"an entitlement check. An analytics call must fire after an"},{"type":"text","text":" "},{"type":"text","text":"execution attempt finishes — but only for middlewares that actually"},{"type":"text","text":" "},{"type":"text","text":"participated in the "},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" decision."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This tutorial starts at the externally owned-store tier because middleware is"},{"type":"text","text":" "},{"type":"text","text":"installed when the authority is created. A self-contained stack without custom"},{"type":"text","text":" "},{"type":"text","text":"policy should use "},{"code":"@Router","type":"codeVoice"},{"type":"text","text":" + "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" instead."}]},{"text":"Modeling routes","level":2,"type":"heading","anchor":"Modeling-routes"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["enum AppRoute: Route {","    case home","    case premiumDetail","    case paywall","}"]},{"text":"Logging middleware","level":2,"type":"heading","anchor":"Logging-middleware"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reuse the "},{"type":"codeVoice","code":"AnyNavigationMiddleware"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"AnyModalMiddleware"},{"type":"text","text":" "},{"type":"text","text":"closure initializers so a minimal shared logger composes without"},{"type":"text","text":" "},{"type":"text","text":"boilerplate:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@MainActor","func loggingNavigationMiddleware() -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(","        willExecute: { command, _ in","            Log.debug(\"navigation command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, result, _ in","            Log.debug(\"navigation finished: \\(command) -> \\(result)\")","            return result","        }","    )","}","","@MainActor","func loggingModalMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(","        willExecute: { command, _, _ in","            Log.debug(\"modal command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, _, _ in","            Log.debug(\"modal finished: \\(command)\")","        }","    )","}"]},{"text":"Entitlement gating","level":2,"type":"heading","anchor":"Entitlement-gating"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The gate is itself a middleware; denying a command is just"},{"type":"text","text":" "},{"type":"text","text":"returning "},{"type":"codeVoice","code":".cancel(reason)"},{"type":"text","text":":"}]},{"code":["@MainActor","func entitlementGateNavigation(hasPremium: @escaping @MainActor () -> Bool) -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(willExecute: { command, _ in","        guard case .push(.premiumDetail) = command, !hasPremium() else {","            return .proceed(command)","        }","        return .cancel(.middleware(debugName: \"entitlement-gate\", command: command))","    })","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"text":"The cancellation surfaces through","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"ModalStoreConfiguration.onEvent"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".commandIntercepted(_, .cancelled(...))"},{"text":" and through","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowRejectionReason.middlewareRejected(debugName: \"entitlement-gate\")"},{"text":" ","type":"text"},{"text":"when used from ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Wiring-it-all","text":"Wiring it all","type":"heading"},{"code":["let navStore = NavigationStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingNavigationMiddleware(), debugName: \"logging\"),","            .init(middleware: entitlementGateNavigation(hasPremium: { EntitlementStore.shared.hasPremium }), debugName: \"entitlement-gate\"),","        ]","    )",")","","let modalStore = ModalStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingModalMiddleware(), debugName: \"logging\"),","        ]","    )",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"level":2,"anchor":"Participant-discipline","text":"Participant discipline","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"When a middleware cancels a command, every middleware whose","type":"text"},{"text":" ","type":"text"},{"code":"willExecute","type":"codeVoice"},{"text":" hook ran is a participant, including the cancelling","type":"text"},{"text":" ","type":"text"},{"text":"middleware itself. Middleware later in the chain did not run and","type":"text"},{"text":" ","type":"text"},{"text":"therefore receives no completion callback.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That guarantee is why the logger safely appears "},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"entitlement gate — the logger’s "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" fires even if the"},{"type":"text","text":" "},{"type":"text","text":"gate cancels, so the cancellation is still recorded. Reordering"},{"type":"text","text":" "},{"type":"text","text":"to "},{"code":"[entitlement-gate, logging]","type":"codeVoice"},{"text":" would skip the logger’s","type":"text"},{"text":" ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" on cancellation.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"For direct and batch ","type":"text"},{"code":".whenCancelled","type":"codeVoice"},{"text":" execution, ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"attempt-level: it can run for a leg whose ","type":"text"},{"code":"RouteStack","type":"codeVoice"},{"text":" change is","type":"text"},{"text":" ","type":"text"},{"text":"later discarded. Use the aggregate result and ","type":"text"},{"code":".changed","type":"codeVoice"},{"text":" event to","type":"text"},{"text":" ","type":"text"},{"text":"observe durable state. Transactions instead keep ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" ","type":"text"},{"text":"commit-only; its returned fold can change reporting after commit but","type":"text"},{"text":" ","type":"text"},{"text":"cannot roll back the transaction.","type":"text"}]},{"text":"Observing a cancellation end-to-end","anchor":"Observing-a-cancellation-end-to-end","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ModalStore.events"},{"text":" surfaces ","type":"text"},{"type":"codeVoice","code":".commandIntercepted(.cancelled(...))"},{"text":" ","type":"text"},{"text":"while a direct ","type":"text"},{"type":"codeVoice","code":"NavigationStore.execute(_:)"},{"type":"text","text":" cancellation is returned"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"NavigationResult.cancelled"},{"type":"text","text":"; a path-reconciliation policy may"},{"type":"text","text":" "},{"type":"text","text":"separately emit "},{"type":"codeVoice","code":".pathMismatch"},{"type":"text","text":". For a "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" in particular,"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore.events"},{"type":"text","text":" wraps both in "},{"type":"codeVoice","code":".navigation(...)"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".modal(...)"},{"type":"text","text":" "},{"type":"text","text":"cases so one subscriber sees the whole picture. Capture the stream before"},{"type":"text","text":" "},{"type":"text","text":"starting its lifecycle-owned task to register the subscriber synchronously."}]},{"code":["let events = flowStore.events","let observationTask = Task { @MainActor in","    for await event in events {","        if case .modal(.commandIntercepted(_, .cancelled(let reason))) = event {","            Log.info(\"modal cancelled: \\(reason)\")","        }","        if case .intentRejected(_, .middlewareRejected(let name)) = event {","            Log.info(\"flow intent rejected by: \\(name ?? \"nil\")\")","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"type":"heading","anchor":"Testing-middleware-with-FlowTestStore","text":"Testing middleware with FlowTestStore"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":") asserts the cancellation"},{"type":"text","text":" "},{"type":"text","text":"chain without mounting SwiftUI:"}]},{"code":["@Test","@MainActor","func entitlementGateBlocksPremiumPush() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: entitlementGateNavigation(hasPremium: { false }), debugName: \"gate\")","            ])","        )","    )","","    store.send(.push(.premiumDetail))","","    store.receiveIntentRejected(","        intent: .push(.premiumDetail),","        reason: .middlewareRejected(debugName: \"gate\")","    )","    store.finish()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"type":"heading","anchor":"Next-steps","text":"Next steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","isActive":true,"type":"reference"},{"text":" to see how middleware","type":"text"},{"text":" ","type":"text"},{"text":"interacts with a multi-step flow plus a child coordinator.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Read the ","type":"text"},{"type":"codeVoice","code":"Tutorial-TestingFlows"},{"text":" guide in the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"InnoRouterTesting"},{"text":" documentation catalog for the full host-less","type":"text"},{"text":" ","type":"text"},{"text":"test harness tour.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},"varia