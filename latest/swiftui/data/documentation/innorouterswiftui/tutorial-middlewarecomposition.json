{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition"]}],"sections":[],"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"title":"Composing Middleware Across Navigation and Modal"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Scenario","text":"Scenario"},{"inlineContent":[{"type":"text","text":"Every "},{"code":"NavigationCommand","type":"codeVoice"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalCommand"},{"type":"text","text":" should be logged"},{"text":" ","type":"text"},{"text":"before it executes. A feature-flagged screen must be gated behind","type":"text"},{"text":" ","type":"text"},{"text":"an entitlement check. An analytics call must fire after the","type":"text"},{"text":" ","type":"text"},{"text":"command commits — but only for middlewares that actually","type":"text"},{"text":" ","type":"text"},{"text":"participated in the ","type":"text"},{"code":"willExecute","type":"codeVoice"},{"text":" decision.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Modeling-routes","text":"Modeling routes"},{"syntax":"swift skip doc-fragment","code":["enum AppRoute: Route {","    case home","    case premiumDetail","    case paywall","}"],"type":"codeListing"},{"type":"heading","level":2,"anchor":"Logging-middleware","text":"Logging middleware"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reuse the "},{"code":"AnyNavigationMiddleware","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"AnyModalMiddleware","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"closure initializers so a minimal shared logger composes without"},{"type":"text","text":" "},{"type":"text","text":"boilerplate:"}]},{"syntax":"swift skip doc-fragment","code":["@MainActor","func loggingNavigationMiddleware() -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(","        willExecute: { command, _ in","            Log.debug(\"navigation command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, _, result in","            Log.debug(\"navigation committed: \\(command) -> \\(result)\")","            return result","        }","    )","}","","@MainActor","func loggingModalMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(","        willExecute: { command, _, _ in","            Log.debug(\"modal command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, _, _ in","            Log.debug(\"modal committed: \\(command)\")","        }","    )","}"],"type":"codeListing"},{"type":"heading","level":2,"anchor":"Entitlement-gating","text":"Entitlement gating"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The gate is itself a middleware; denying a command is just"},{"type":"text","text":" "},{"type":"text","text":"returning "},{"code":".cancel(reason)","type":"codeVoice"},{"type":"text","text":":"}]},{"syntax":"swift skip doc-fragment","code":["@MainActor","func entitlementGateNavigation(hasPremium: @escaping @MainActor () -> Bool) -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(willExecute: { command, _ in","        guard case .push(.premiumDetail) = command, !hasPremium() else {","            return .proceed(command)","        }","        return .cancel(.middleware(debugName: \"entitlement-gate\", command: command))","    })","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cancellation surfaces through"},{"type":"text","text":" "},{"type":"codeVoice","code":"onCommandIntercepted(.cancelled(...))"},{"type":"text","text":" on the store and through"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowRejectionReason.middlewareRejected(debugName: \"entitlement-gate\")"},{"type":"text","text":" "},{"type":"text","text":"when used from "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":"."}]},{"type":"heading","level":2,"anchor":"Wiring-it-all","text":"Wiring it all"},{"syntax":"swift skip doc-fragment","code":["let navStore = NavigationStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingNavigationMiddleware(), debugName: \"logging\"),","            .init(middleware: entitlementGateNavigation(hasPremium: { EntitlementStore.shared.hasPremium }), debugName: \"entitlement-gate\"),","        ]","    )",")","","let modalStore = ModalStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingModalMiddleware(), debugName: \"logging\"),","        ]","    )",")"],"type":"codeListing"},{"type":"heading","level":2,"anchor":"Participant-discipline","text":"Participant discipline"},{"type":"paragraph","inlineContent":[{"text":"When a middleware cancels a command, only the middlewares that","type":"text"},{"text":" ","type":"text"},{"text":"already returned ","type":"text"},{"type":"codeVoice","code":".proceed"},{"text":" observe ","type":"text"},{"type":"codeVoice","code":"didExecute"},{"text":". The ones that","type":"text"},{"text":" ","type":"text"},{"text":"either didn’t run yet (because a predecessor cancelled) or that","type":"text"},{"text":" ","type":"text"},{"text":"themselves cancelled are not consulted.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That guarantee is why the logger safely appears "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"entitlement gate — the logger’s "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" fires even if the"},{"type":"text","text":" "},{"type":"text","text":"gate cancels, so the cancellation is still recorded. Reordering"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"[entitlement-gate, logging]"},{"type":"text","text":" would skip the logger’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" on cancellation."}]},{"level":2,"text":"Observing a cancellation end-to-end","type":"heading","anchor":"Observing-a-cancellation-end-to-end"},{"type":"paragraph","inlineContent":[{"code":"ModalStore.events","type":"codeVoice"},{"type":"text","text":" surfaces "},{"code":".commandIntercepted(.cancelled(...))","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"NavigationStore.events","type":"codeVoice"},{"type":"text","text":" surfaces the same through"},{"type":"text","text":" "},{"code":".pathMismatch","type":"codeVoice"},{"type":"text","text":" (if the rewrite triggered a policy) plus the"},{"type":"text","text":" "},{"type":"text","text":"direct cancellation. For a "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" in particular,"},{"type":"text","text":" "},{"code":"FlowStore.events","type":"codeVoice"},{"type":"text","text":" wraps both in "},{"code":".navigation(...)","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":".modal(...)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"cases so one subscriber sees the whole picture."}]},{"type":"codeListing","code":["Task {","    for await event in flowStore.events {","        if case .modal(.commandIntercepted(_, .cancelled(let reason))) = event {","            Log.info(\"modal cancelled: \\(reason)\")","        }","        if case .intentRejected(_, .middlewareRejected(let name)) = event {","            Log.info(\"flow intent rejected by: \\(name ?? \"nil\")\")","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"level":2,"text":"Testing middleware with FlowTestStore","type":"heading","anchor":"Testing-middleware-with-FlowTestStore"},{"type":"paragraph","inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"text":" (in ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":") asserts the cancellation","type":"text"},{"text":" ","type":"text"},{"text":"chain without mounting SwiftUI:","type":"text"}]},{"type":"codeListing","code":["@Test","@MainActor","func entitlementGateBlocksPremiumPush() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: entitlementGateNavigation(hasPremium: { false }), debugName: \"gate\")","            ])","        )","    )","","    store.send(.push(.premiumDetail))","","    store.receiveIntentRejected(","        intent: .push(.premiumDetail),","        reason: .middlewareRejected(debugName: \"gate\")","    )","    store.expectNoMoreEvents()","}"],"syntax":"swift skip doc-fragment"},{"level":2,"text":"Next steps","type":"heading","anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Read "},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","type":"reference"},{"type":"text","text":" to see how middleware"},{"type":"text","text":" "},{"type":"text","text":"interacts with a multi-step flow plus a child coordinator."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Read the "},{"type":"codeVoice","code":"Tutorial-TestingFlows"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" documentation catalog for the full host-less"},{"type":"text","text":" "},{"type":"text","text":"test harness tour."}],"type":"paragraph"}]}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},"abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" and "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that guarantees "},{"code":"didExecute","type":"codeVoice"},{"type":"text","text":" only runs for middlewares"},{"type":"text","text":" "},{"type":"text","text":"that accepted the command."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"type":"topic","abstract":[{"text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter.","type":"text"}],"title":"InnoRouterSwiftUI","kind":"article","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","abstract":[{"text":"Compose push, sheet, and cover steps into a single serializable flow with ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":", then scope the signup sub-flow through a ","type":"text"},{"type":"codeVoice","code":"ChildCoordinator"},{"text":" and await its result inline.","type":"text"}],"url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","title":"Building a Login Onboarding Flow"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","abstract":[],"type":"topic","url":"\/documentation\/innoroutertesting","role":"collection","kind":"symbol"}}}