{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Scenario","anchor":"Scenario","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every "},{"code":"NavigationCommand","type":"codeVoice"},{"type":"text","text":" and "},{"code":"ModalCommand","type":"codeVoice"},{"type":"text","text":" should be logged"},{"type":"text","text":" "},{"type":"text","text":"before it executes. A feature-flagged screen must be gated behind"},{"type":"text","text":" "},{"type":"text","text":"an entitlement check. An analytics call must fire after an"},{"type":"text","text":" "},{"type":"text","text":"execution attempt finishes — but only for middlewares that actually"},{"type":"text","text":" "},{"type":"text","text":"participated in the "},{"code":"willExecute","type":"codeVoice"},{"type":"text","text":" decision."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This tutorial starts at the externally owned-store tier because middleware is"},{"type":"text","text":" "},{"type":"text","text":"installed when the authority is created. A self-contained stack without custom"},{"type":"text","text":" "},{"type":"text","text":"policy should use "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" + "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" instead."}]},{"type":"heading","text":"Modeling routes","anchor":"Modeling-routes","level":2},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["enum AppRoute: Route {","    case home","    case premiumDetail","    case paywall","}"]},{"type":"heading","text":"Logging middleware","anchor":"Logging-middleware","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reuse the "},{"type":"codeVoice","code":"AnyNavigationMiddleware"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"AnyModalMiddleware"},{"type":"text","text":" "},{"type":"text","text":"closure initializers so a minimal shared logger composes without"},{"type":"text","text":" "},{"type":"text","text":"boilerplate:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@MainActor","func loggingNavigationMiddleware() -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(","        willExecute: { command, _ in","            Log.debug(\"navigation command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, result, _ in","            Log.debug(\"navigation finished: \\(command) -> \\(result)\")","            return result","        }","    )","}","","@MainActor","func loggingModalMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(","        willExecute: { command, _, _ in","            Log.debug(\"modal command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, _, _ in","            Log.debug(\"modal finished: \\(command)\")","        }","    )","}"]},{"type":"heading","text":"Entitlement gating","anchor":"Entitlement-gating","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The gate is itself a middleware; denying a command is just"},{"type":"text","text":" "},{"type":"text","text":"returning "},{"type":"codeVoice","code":".cancel(reason)"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@MainActor","func entitlementGateNavigation(hasPremium: @escaping @MainActor () -> Bool) -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(willExecute: { command, _ in","        guard case .push(.premiumDetail) = command, !hasPremium() else {","            return .proceed(command)","        }","        return .cancel(.middleware(debugName: \"entitlement-gate\", command: command))","    })","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The cancellation surfaces through"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalStoreConfiguration.onEvent"},{"type":"text","text":" as"},{"type":"text","text":" "},{"type":"codeVoice","code":".commandIntercepted(_, .cancelled(...))"},{"type":"text","text":" and through"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowRejectionReason.middlewareRejected(debugName: \"entitlement-gate\")"},{"type":"text","text":" "},{"type":"text","text":"when used from "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":"."}]},{"type":"heading","text":"Wiring it all","anchor":"Wiring-it-all","level":2},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let navStore = NavigationStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingNavigationMiddleware(), debugName: \"logging\"),","            .init(middleware: entitlementGateNavigation(hasPremium: { EntitlementStore.shared.hasPremium }), debugName: \"entitlement-gate\"),","        ]","    )",")","","let modalStore = ModalStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingModalMiddleware(), debugName: \"logging\"),","        ]","    )",")"]},{"type":"heading","text":"Participant discipline","anchor":"Participant-discipline","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"When a middleware cancels a command, every middleware whose"},{"type":"text","text":" "},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" hook ran is a participant, including the cancelling"},{"type":"text","text":" "},{"type":"text","text":"middleware itself. Middleware later in the chain did not run and"},{"type":"text","text":" "},{"type":"text","text":"therefore receives no completion callback."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That guarantee is why the logger safely appears "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"entitlement gate — the logger’s "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" fires even if the"},{"type":"text","text":" "},{"type":"text","text":"gate cancels, so the cancellation is still recorded. Reordering"},{"type":"text","text":" "},{"type":"text","text":"to "},{"type":"codeVoice","code":"[entitlement-gate, logging]"},{"type":"text","text":" would skip the logger’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" on cancellation."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For direct and batch "},{"type":"codeVoice","code":".whenCancelled"},{"type":"text","text":" execution, "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"text","text":"attempt-level: it can run for a leg whose "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" change is"},{"type":"text","text":" "},{"type":"text","text":"later discarded. Use the aggregate result and "},{"type":"codeVoice","code":".changed"},{"type":"text","text":" event to"},{"type":"text","text":" "},{"type":"text","text":"observe durable state. Transactions instead keep "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" "},{"type":"text","text":"commit-only; its returned fold can change reporting after commit but"},{"type":"text","text":" "},{"type":"text","text":"cannot roll back the transaction."}]},{"type":"heading","text":"Observing a cancellation end-to-end","anchor":"Observing-a-cancellation-end-to-end","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ModalStore.events"},{"type":"text","text":" surfaces "},{"type":"codeVoice","code":".commandIntercepted(.cancelled(...))"},{"type":"text","text":" "},{"type":"text","text":"while a direct "},{"type":"codeVoice","code":"NavigationStore.execute(_:)"},{"type":"text","text":" cancellation is returned"},{"type":"text","text":" "},{"type":"text","text":"as "},{"type":"codeVoice","code":"NavigationResult.cancelled"},{"type":"text","text":"; a path-reconciliation policy may"},{"type":"text","text":" "},{"type":"text","text":"separately emit "},{"type":"codeVoice","code":".pathMismatch"},{"type":"text","text":". For a "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" in particular,"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore.events"},{"type":"text","text":" wraps both in "},{"type":"codeVoice","code":".navigation(...)"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".modal(...)"},{"type":"text","text":" "},{"type":"text","text":"cases so one subscriber sees the whole picture. Capture the stream before"},{"type":"text","text":" "},{"type":"text","text":"starting its lifecycle-owned task to register the subscriber synchronously."}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let events = flowStore.events","let observationTask = Task { @MainActor in","    for await event in events {","        if case .modal(.commandIntercepted(_, .cancelled(let reason))) = event {","            Log.info(\"modal cancelled: \\(reason)\")","        }","        if case .intentRejected(_, .middlewareRejected(let name)) = event {","            Log.info(\"flow intent rejected by: \\(name ?? \"nil\")\")","        }","    }","}"]},{"type":"heading","text":"Testing middleware with FlowTestStore","anchor":"Testing-middleware-with-FlowTestStore","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":") asserts the cancellation"},{"type":"text","text":" "},{"type":"text","text":"chain without mounting SwiftUI:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func entitlementGateBlocksPremiumPush() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: entitlementGateNavigation(hasPremium: { false }), debugName: \"gate\")","            ])","        )","    )","","    store.send(.push(.premiumDetail))","","    store.receiveIntentRejected(","        intent: .push(.premiumDetail),","        reason: .middlewareRejected(debugName: \"gate\")","    )","    store.finish()","}"]},{"type":"heading","text":"Next steps","anchor":"Next-steps","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Read "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","type":"reference","isActive":true},{"type":"text","text":" to see how middleware"},{"type":"text","text":" "},{"type":"text","text":"interacts with a multi-step flow plus a child coordinator."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Read the "},{"code":"Tutorial-TestingFlows","type":"codeVoice"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"code":"InnoRouterTesting","type":"codeVoice"},{"type":"text","text":" documentation catalog for the full host-less"},{"type":"text","text":" "},{"type":"text","text":"test harness tour."}],"type":"paragraph"}]}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition"]}],"abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"text":"discipline that pairs completion callbacks with the middlewares","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" hook actually ran."}],"kind":"article","metadata":{"modules":[{"name":"InnoRouterTesting"}],"title":"Composing Middleware Across Navigation and Modal","role":"article","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then let the signup "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}],"kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","title":"Building a Login Onboarding Flow","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"kind":"article","title":"InnoRouterSwiftUI","type":"topic"}}}