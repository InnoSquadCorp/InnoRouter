{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"title":"Composing Middleware Across Navigation and Modal","roleHeading":"Article"},"kind":"article","abstract":[{"text":"Install logging, entitlement gating, and analytics middleware on","type":"text"},{"text":" ","type":"text"},{"text":"both ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":". Inspect the participant","type":"text"},{"text":" ","type":"text"},{"text":"discipline that pairs completion callbacks with the middlewares","type":"text"},{"text":" ","type":"text"},{"text":"whose ","type":"text"},{"code":"willExecute","type":"codeVoice"},{"text":" hook actually ran.","type":"text"}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Scenario","anchor":"Scenario","type":"heading"},{"inlineContent":[{"text":"Every ","type":"text"},{"code":"NavigationCommand","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"ModalCommand","type":"codeVoice"},{"text":" should be logged","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"before it executes. A feature-flagged screen must be gated behind"},{"type":"text","text":" "},{"type":"text","text":"an entitlement check. An analytics call must fire after an"},{"type":"text","text":" "},{"type":"text","text":"execution attempt finishes — but only for middlewares that actually"},{"type":"text","text":" "},{"type":"text","text":"participated in the "},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" decision."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This tutorial starts at the externally owned-store tier because middleware is"},{"text":" ","type":"text"},{"type":"text","text":"installed when the authority is created. A self-contained stack without custom"},{"type":"text","text":" "},{"type":"text","text":"policy should use "},{"code":"@Router","type":"codeVoice"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" instead."}],"type":"paragraph"},{"type":"heading","text":"Modeling routes","level":2,"anchor":"Modeling-routes"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["enum AppRoute: Route {","    case home","    case premiumDetail","    case paywall","}"]},{"level":2,"type":"heading","anchor":"Logging-middleware","text":"Logging middleware"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reuse the "},{"type":"codeVoice","code":"AnyNavigationMiddleware"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"AnyModalMiddleware"},{"text":" ","type":"text"},{"text":"closure initializers so a minimal shared logger composes without","type":"text"},{"text":" ","type":"text"},{"text":"boilerplate:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@MainActor","func loggingNavigationMiddleware() -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(","        willExecute: { command, _ in","            Log.debug(\"navigation command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, result, _ in","            Log.debug(\"navigation finished: \\(command) -> \\(result)\")","            return result","        }","    )","}","","@MainActor","func loggingModalMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(","        willExecute: { command, _, _ in","            Log.debug(\"modal command: \\(command)\")","            return .proceed(command)","        },","        didExecute: { command, _, _ in","            Log.debug(\"modal finished: \\(command)\")","        }","    )","}"]},{"type":"heading","anchor":"Entitlement-gating","level":2,"text":"Entitlement gating"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The gate is itself a middleware; denying a command is just"},{"type":"text","text":" "},{"type":"text","text":"returning "},{"code":".cancel(reason)","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@MainActor","func entitlementGateNavigation(hasPremium: @escaping @MainActor () -> Bool) -> AnyNavigationMiddleware<AppRoute> {","    AnyNavigationMiddleware(willExecute: { command, _ in","        guard case .push(.premiumDetail) = command, !hasPremium() else {","            return .proceed(command)","        }","        return .cancel(.middleware(debugName: \"entitlement-gate\", command: command))","    })","}"]},{"inlineContent":[{"type":"text","text":"The cancellation surfaces through"},{"type":"text","text":" "},{"code":"ModalStoreConfiguration.onEvent","type":"codeVoice"},{"text":" as","type":"text"},{"text":" ","type":"text"},{"code":".commandIntercepted(_, .cancelled(...))","type":"codeVoice"},{"text":" and through","type":"text"},{"text":" ","type":"text"},{"code":"FlowRejectionReason.middlewareRejected(debugName: \"entitlement-gate\")","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"when used from "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Wiring-it-all","type":"heading","level":2,"text":"Wiring it all"},{"type":"codeListing","code":["let navStore = NavigationStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingNavigationMiddleware(), debugName: \"logging\"),","            .init(middleware: entitlementGateNavigation(hasPremium: { EntitlementStore.shared.hasPremium }), debugName: \"entitlement-gate\"),","        ]","    )",")","","let modalStore = ModalStore<AppRoute>(","    configuration: .init(","        middlewares: [","            .init(middleware: loggingModalMiddleware(), debugName: \"logging\"),","        ]","    )",")"],"syntax":"swift skip doc-fragment"},{"level":2,"type":"heading","text":"Participant discipline","anchor":"Participant-discipline"},{"inlineContent":[{"type":"text","text":"When a middleware cancels a command, every middleware whose"},{"type":"text","text":" "},{"code":"willExecute","type":"codeVoice"},{"type":"text","text":" hook ran is a participant, including the cancelling"},{"type":"text","text":" "},{"type":"text","text":"middleware itself. Middleware later in the chain did not run and"},{"text":" ","type":"text"},{"type":"text","text":"therefore receives no completion callback."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That guarantee is why the logger safely appears "},{"inlineContent":[{"type":"text","text":"before"}],"type":"emphasis"},{"text":" the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"entitlement gate — the logger’s "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" fires even if the"},{"type":"text","text":" "},{"type":"text","text":"gate cancels, so the cancellation is still recorded. Reordering"},{"type":"text","text":" "},{"text":"to ","type":"text"},{"code":"[entitlement-gate, logging]","type":"codeVoice"},{"type":"text","text":" would skip the logger’s"},{"text":" ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" on cancellation.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For direct and batch "},{"type":"codeVoice","code":".whenCancelled"},{"type":"text","text":" execution, "},{"type":"codeVoice","code":"didExecute"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"text":"attempt-level: it can run for a leg whose ","type":"text"},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" change is"},{"type":"text","text":" "},{"type":"text","text":"later discarded. Use the aggregate result and "},{"type":"codeVoice","code":".changed"},{"type":"text","text":" event to"},{"type":"text","text":" "},{"type":"text","text":"observe durable state. Transactions instead keep "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" "},{"type":"text","text":"commit-only; its returned fold can change reporting after commit but"},{"type":"text","text":" "},{"type":"text","text":"cannot roll back the transaction."}]},{"text":"Observing a cancellation end-to-end","type":"heading","level":2,"anchor":"Observing-a-cancellation-end-to-end"},{"inlineContent":[{"type":"codeVoice","code":"ModalStore.events"},{"type":"text","text":" surfaces "},{"type":"codeVoice","code":".commandIntercepted(.cancelled(...))"},{"type":"text","text":" "},{"type":"text","text":"while a direct "},{"code":"NavigationStore.execute(_:)","type":"codeVoice"},{"type":"text","text":" cancellation is returned"},{"type":"text","text":" "},{"type":"text","text":"as "},{"code":"NavigationResult.cancelled","type":"codeVoice"},{"type":"text","text":"; a path-reconciliation policy may"},{"type":"text","text":" "},{"type":"text","text":"separately emit "},{"code":".pathMismatch","type":"codeVoice"},{"type":"text","text":". For a "},{"code":"FlowStore","type":"codeVoice"},{"text":" in particular,","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore.events","type":"codeVoice"},{"text":" wraps both in ","type":"text"},{"code":".navigation(...)","type":"codeVoice"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":".modal(...)"},{"text":" ","type":"text"},{"type":"text","text":"cases so one subscriber sees the whole picture. Capture the stream before"},{"text":" ","type":"text"},{"text":"starting its lifecycle-owned task to register the subscriber synchronously.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let events = flowStore.events","let observationTask = Task { @MainActor in","    for await event in events {","        if case .modal(.commandIntercepted(_, .cancelled(let reason))) = event {","            Log.info(\"modal cancelled: \\(reason)\")","        }","        if case .intentRejected(_, .middlewareRejected(let name)) = event {","            Log.info(\"flow intent rejected by: \\(name ?? \"nil\")\")","        }","    }","}"]},{"type":"heading","text":"Testing middleware with FlowTestStore","level":2,"anchor":"Testing-middleware-with-FlowTestStore"},{"inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"InnoRouterTesting"},{"text":") asserts the cancellation","type":"text"},{"text":" ","type":"text"},{"text":"chain without mounting SwiftUI:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func entitlementGateBlocksPremiumPush() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            navigation: .init(middlewares: [","                .init(middleware: entitlementGateNavigation(hasPremium: { false }), debugName: \"gate\")","            ])","        )","    )","","    store.send(.push(.premiumDetail))","","    store.receiveIntentRejected(","        intent: .push(.premiumDetail),","        reason: .middlewareRejected(debugName: \"gate\")","    )","    store.finish()","}"]},{"anchor":"Next-steps","level":2,"type":"heading","text":"Next steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},{"text":" to see how middleware","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"interacts with a multi-step flow plus a child coordinator."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read the ","type":"text"},{"code":"Tutorial-TestingFlows","type":"codeVoice"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"code":"InnoRouterTesting","type":"codeVoice"},{"type":"text","text":" documentation catalog for the full host-less"},{"text":" ","type":"text"},{"type":"text","text":"test harness tour."}]}]}],"type":"unorderedList"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","interfaceLanguage":"swift"},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","role":"collection","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","abstract":[],"type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"kind":"article","abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then let the signup "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}],"url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","type":"topic","title":"Building a Login Onboarding Flow","role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"}}}