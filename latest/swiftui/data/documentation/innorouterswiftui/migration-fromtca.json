{"sections":[],"abstract":[{"type":"text","text":"This guide walks a TCA project through replacing its navigation"},{"type":"text","text":" "},{"type":"text","text":"layer with InnoRouter while keeping the rest of the architecture"},{"type":"text","text":" "},{"type":"text","text":"(reducers, effects, state) intact. InnoRouter is "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" a"},{"type":"text","text":" "},{"type":"text","text":"replacement for TCA’s reducer composition — it replaces the"},{"type":"text","text":" "},{"type":"text","text":"parts of TCA that own "},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation state"}]},{"type":"text","text":" and "},{"type":"emphasis","inlineContent":[{"type":"text","text":"modal authority"}]},{"type":"text","text":"."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Why-this-migration","text":"Why this migration"},{"type":"paragraph","inlineContent":[{"text":"TCA’s navigation surface (","type":"text"},{"code":"StackState<Element>","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@Presents","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationStackStore"},{"text":") bundles three responsibilities:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State authority"}]},{"text":" — what is on the stack, what modal is up.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Action plumbing","type":"text"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"Action.path(.push(...))"},{"type":"text","text":", "},{"type":"codeVoice","code":"delegate"},{"type":"text","text":" "},{"type":"text","text":"actions, "},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":" from the parent."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"View binding","type":"text"}]},{"type":"text","text":" — "},{"code":"NavigationStackStore","type":"codeVoice"},{"type":"text","text":" translates child"},{"type":"text","text":" "},{"type":"text","text":"stores into "},{"code":"NavigationLink","type":"codeVoice"},{"type":"text","text":"s."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"InnoRouter takes ownership of (1) and (3) and replaces (2)"},{"type":"text","text":" "},{"text":"with a typed ","type":"text"},{"code":"NavigationIntent","type":"codeVoice"},{"type":"text","text":" enum that flows through the"},{"type":"text","text":" "},{"type":"text","text":"SwiftUI environment. The reducer surface shrinks because the"},{"type":"text","text":" "},{"text":"parent reducer no longer needs to forward navigation actions","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"code":"StackState","type":"codeVoice"},{"text":" mutations.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"The minimal swap","anchor":"The-minimal-swap"},{"inlineContent":[{"type":"text","text":"A canonical TCA navigation feature looks like this:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable {","        var path = StackState<Path.State>()","    }","","    enum Action {","        case path(StackActionOf<Path>)","    }","","    @Reducer","    struct Path {","        enum State: Equatable { case detail(DetailFeature.State) }","        enum Action { case detail(DetailFeature.Action) }","        var body: some ReducerOf<Self> {","            Scope(state: \\.detail, action: \\.detail) { DetailFeature() }","        }","    }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","            .forEach(\\.path, action: \\.path) { Path() }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        NavigationStackStore(store.scope(state: \\.path, action: \\.path)) {","            RootView(store: store)","        } destination: { store in","            switch store.state {","            case .detail:","                if let detail = store.scope(state: \\.detail, action: \\.detail) {","                    DetailView(store: detail)","                }","            }","        }","    }","}"]},{"inlineContent":[{"text":"After migration:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Router","enum AppRoute {","    case detail(DetailFeature.State.ID)","","    var destination: some View {","        switch self {","        case .detail(let id):","            DetailView(\/* hydrate from id *\/)","        }","    }","}","","@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable { \/* business state only *\/ }","","    enum Action { \/* business actions only *\/ }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        RouterHost(AppRoute.self) {","            RootView(store: store)","        }","    }","}"]},{"inlineContent":[{"text":"Three things changed:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"The reducer’s "},{"type":"codeVoice","code":"path: StackState<Path.State>"},{"type":"text","text":" is gone — the"},{"type":"text","text":" "},{"type":"text","text":"parent reducer no longer carries navigation state."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The parent action enum no longer routes"},{"type":"text","text":" "},{"type":"codeVoice","code":"case path(StackActionOf<Path>)"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The view uses macro-generated destinations with "},{"code":"RouterHost","type":"codeVoice"},{"text":" in place of","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStackStore"},{"type":"text","text":" + "},{"code":"Path","type":"codeVoice"},{"type":"text","text":" reducer composition. No navigation store is"},{"text":" ","type":"text"},{"text":"exposed to the feature for this self-contained stack.","type":"text"}]}]}]},{"inlineContent":[{"type":"text","text":"If a TCA dependency, deep-link handler, or restoration boundary must access"},{"type":"text","text":" "},{"text":"the navigation authority, promote the store to the app boundary. ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" ","type":"text"},{"text":"still removes the destination closure, so the advanced form keeps the correct","type":"text"},{"text":" ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":" closure order:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@State private var navigationStore = NavigationStore<AppRoute>()","","NavigationHost(store: navigationStore) {","    RootView(store: store)","}"]},{"anchor":"Modal-presentation-Presents-%E2%86%92-ModalStore","type":"heading","level":2,"text":"Modal presentation (`@Presents` → `ModalStore`)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"TCA’s "},{"code":"@Presents","type":"codeVoice"},{"text":" is conceptually equivalent to a ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"slot. Replace:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@ObservableState","struct State {","    @Presents var sheet: SheetFeature.State?","}","","enum Action {","    case sheet(PresentationAction<SheetFeature.Action>)","}","","\/\/ View",".sheet(item: $store.scope(state: \\.sheet, action: \\.sheet)) { … }"]},{"type":"paragraph","inlineContent":[{"text":"with:","type":"text"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["\/\/ State + Action no longer carry the modal slot.","","\/\/ View","ModalHost(store: modalStore) { route in","    switch route { case .sheet: SheetView(…) }","} content: {","    RootView()","}"]},{"type":"paragraph","inlineContent":[{"text":"The reducer no longer fires ","type":"text"},{"code":"Action.sheet(.presented(…))","type":"codeVoice"},{"text":"; the view reads","type":"text"},{"text":" ","type":"text"},{"code":"@EnvironmentRouter(AppModalRoute.self)","type":"codeVoice"},{"text":" and calls ","type":"text"},{"code":"router.sheet(_:)","type":"codeVoice"},{"text":". Move to","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" only when stack and modal state must form one atomic timeline;","type":"text"},{"text":" ","type":"text"},{"text":"flow-specific intents use ","type":"text"},{"code":"router.send(flow:)","type":"codeVoice"},{"text":" through the same environment","type":"text"},{"text":" ","type":"text"},{"text":"router surface.","type":"text"}]},{"text":"Stack + modal as one value (`StackState` + `@Presents` → `FlowStore`)","level":2,"type":"heading","anchor":"Stack-+-modal-as-one-value-StackState-+-Presents-%E2%86%92-FlowStore"},{"type":"paragraph","inlineContent":[{"text":"If a feature uses both navigation and modal authority, replace","type":"text"},{"text":" ","type":"text"},{"text":"both with a single ","type":"text"},{"type":"codeVoice","code":"FlowStore<Route>"},{"text":" and observe ","type":"text"},{"type":"codeVoice","code":"path: [RouteStep<Route>]"},{"text":" as the single source of truth. The","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":" value type makes the entire flow state Codable for","type":"text"},{"text":" ","type":"text"},{"text":"deep-link rehydration and state restoration.","type":"text"}]},{"text":"Testing — `TestStore` → `NavigationTestStore` \/ `FlowTestStore`","level":2,"type":"heading","anchor":"Testing-TestStore-%E2%86%92-NavigationTestStore--FlowTestStore"},{"type":"paragraph","inlineContent":[{"code":"InnoRouterTesting","type":"codeVoice"},{"text":" ships host-less test stores that mirror","type":"text"},{"text":" ","type":"text"},{"text":"TCA’s strict-exhaustivity ergonomics. Swap:","type":"text"}]},{"type":"codeListing","code":["let testStore = TestStore(initialState: AppFeature.State()) { AppFeature() }","await testStore.send(.path(.push(id: 0, state: .detail(...))))"],"syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"with:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let test = NavigationTestStore<AppRoute>()","test.execute(.push(.detail(id)))","test.expect(state: [.detail(id)])"]},{"type":"paragraph","inlineContent":[{"text":"The test store keeps the analytics \/ diagnostic ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" callback the","type":"text"},{"text":" ","type":"text"},{"text":"production store wired through ","type":"text"},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so the test asserts production telemetry without","type":"text"},{"text":" ","type":"text"},{"code":"@testable import","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","anchor":"What-stays-in-TCA","level":2,"text":"What stays in TCA"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter explicitly does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" replace:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Business logic reducers (","type":"text"},{"type":"codeVoice","code":"Reduce { state, action in … }"},{"text":")","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Side effects ("},{"type":"codeVoice","code":"Effect.send"},{"type":"text","text":", "},{"type":"codeVoice","code":"Effect.run"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"text":"Dependency injection (","type":"text"},{"code":"@Dependency","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cross-feature coordination (parent ⇄ child reducer composition","type":"text"},{"text":" ","type":"text"},{"text":"for non-navigation concerns)","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"A typical migrated codebase keeps every reducer in place; the","type":"text"},{"text":" ","type":"text"},{"text":"delta is the state slots and actions removed because navigation","type":"text"},{"text":" ","type":"text"},{"text":"no longer needs reducer-level modeling.","type":"text"}]},{"level":2,"type":"heading","anchor":"Migration-sequence","text":"Migration sequence"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Start with a leaf feature whose navigation state lives only in the parent"},{"type":"text","text":" "},{"type":"text","text":"reducer’s "},{"type":"codeVoice","code":"StackState"},{"type":"text","text":". Declare its route with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" and replace the"},{"type":"text","text":" "},{"type":"text","text":"view-layer wiring with "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Strip the matching ","type":"text"},{"code":"path","type":"codeVoice"},{"text":" slot and ","type":"text"},{"type":"codeVoice","code":"Path"},{"text":" reducer from the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"parent reducer. Verify the existing tests still pass against"},{"type":"text","text":" "},{"type":"text","text":"the trimmed reducer state."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeat per feature. The blast radius per migration is contained because"},{"type":"text","text":" "},{"type":"text","text":"each "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" owns an independent local "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" behind"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Tackle modal authority feature-by-feature once the navigation","type":"text"},{"text":" ","type":"text"},{"text":"stacks are ported. ","type":"text"},{"code":"@Presents","type":"codeVoice"},{"text":" is the cheapest swap.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For features with both stack and modal authority, migrate"},{"type":"text","text":" "},{"type":"text","text":"them last by lifting the combined state into "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"capturing the deep-link flow through "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":"."}]}]}],"type":"orderedList"},{"type":"heading","anchor":"Common-pitfalls","text":"Common pitfalls","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Action forwarding instinct.","type":"text"}],"type":"strong"},{"text":" TCA users habitually plumb navigation","type":"text"},{"text":" ","type":"text"},{"text":"through actions even when the feature doesn’t need it. With","type":"text"},{"text":" ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":", the view calls ","type":"text"},{"code":"router.go(...)","type":"codeVoice"},{"text":" directly; the reducer","type":"text"},{"text":" ","type":"text"},{"text":"never sees a navigation action unless you explicitly want to gate one","type":"text"},{"text":" ","type":"text"},{"text":"through middleware.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Strict concurrency floor.","type":"text"}]},{"type":"text","text":" InnoRouter requires iOS 18 \/"},{"type":"text","text":" "},{"type":"text","text":"Swift 6.3. If the project still targets iOS 13–17, plan the"},{"type":"text","text":" "},{"type":"text","text":"platform bump as a separate PR before the navigation"},{"type":"text","text":" "},{"type":"text","text":"migration."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"@Bindable store","type":"codeVoice"},{"type":"text","text":" ergonomics."}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" and works with "},{"type":"codeVoice","code":"@Bindable"},{"type":"text","text":" directly — no"},{"type":"text","text":" "},{"type":"codeVoice","code":"bindable"},{"type":"text","text":" modifier or scoped binding helpers are needed."}]}]}]},{"type":"heading","level":2,"text":"Reference","anchor":"Reference"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"@Router","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"@EnvironmentRouter","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"NavigationHost"},{"text":" for externally owned authority","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"ModalHost","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code