{"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Migration-FromTCA","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Migrating navigation from TCA to InnoRouter","role":"article"},"sections":[],"kind":"article","abstract":[{"text":"This guide walks a TCA project through replacing its navigation","type":"text"},{"text":" ","type":"text"},{"text":"layer with InnoRouter while keeping the rest of the architecture","type":"text"},{"text":" ","type":"text"},{"text":"(reducers, effects, state) intact. InnoRouter is ","type":"text"},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"replacement for TCA’s reducer composition — it replaces the","type":"text"},{"text":" ","type":"text"},{"text":"parts of TCA that own ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"navigation state"}]},{"text":" and ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"modal authority","type":"text"}]},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/migration-fromtca"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Why this migration","anchor":"Why-this-migration","type":"heading"},{"inlineContent":[{"type":"text","text":"TCA’s navigation surface ("},{"type":"codeVoice","code":"StackState<Element>"},{"type":"text","text":", "},{"type":"codeVoice","code":"@Presents"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStackStore"},{"type":"text","text":") bundles three responsibilities:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"State authority","type":"text"}],"type":"strong"},{"type":"text","text":" — what is on the stack, what modal is up."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Action plumbing","type":"text"}],"type":"strong"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"Action.path(.push(...))"},{"text":", ","type":"text"},{"type":"codeVoice","code":"delegate"},{"text":" ","type":"text"},{"text":"actions, ","type":"text"},{"type":"codeVoice","code":".dismiss"},{"text":" from the parent.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"View binding","type":"text"}]},{"type":"text","text":" — "},{"code":"NavigationStackStore","type":"codeVoice"},{"type":"text","text":" translates child"},{"type":"text","text":" "},{"type":"text","text":"stores into "},{"code":"NavigationLink","type":"codeVoice"},{"type":"text","text":"s."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"InnoRouter takes ownership of (1) and (3) and replaces (2)","type":"text"},{"text":" ","type":"text"},{"text":"with a typed ","type":"text"},{"code":"NavigationIntent","type":"codeVoice"},{"text":" enum that flows through the","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI environment. The reducer surface shrinks because the","type":"text"},{"text":" ","type":"text"},{"text":"parent reducer no longer needs to forward navigation actions","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"code":"StackState","type":"codeVoice"},{"text":" mutations.","type":"text"}],"type":"paragraph"},{"level":2,"text":"The minimal swap","anchor":"The-minimal-swap","type":"heading"},{"inlineContent":[{"text":"A canonical TCA navigation feature looks like this:","type":"text"}],"type":"paragraph"},{"code":["@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable {","        var path = StackState<Path.State>()","    }","","    enum Action {","        case path(StackActionOf<Path>)","    }","","    @Reducer","    struct Path {","        enum State: Equatable { case detail(DetailFeature.State) }","        enum Action { case detail(DetailFeature.Action) }","        var body: some ReducerOf<Self> {","            Scope(state: \\.detail, action: \\.detail) { DetailFeature() }","        }","    }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","            .forEach(\\.path, action: \\.path) { Path() }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        NavigationStackStore(store.scope(state: \\.path, action: \\.path)) {","            RootView(store: store)","        } destination: { store in","            switch store.state {","            case .detail:","                if let detail = store.scope(state: \\.detail, action: \\.detail) {","                    DetailView(store: detail)","                }","            }","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"After migration:"}],"type":"paragraph"},{"code":["@Routable","enum AppRoute: Route {","    case detail(DetailFeature.State.ID)","}","","@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable { \/* business state only *\/ }","","    enum Action { \/* business actions only *\/ }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","    @State private var navigationStore = NavigationStore<AppRoute>()","","    var body: some View {","        NavigationHost(store: navigationStore) {","            RootView(store: store)","        } destination: { route in","            switch route {","            case .detail(let id):","                DetailView(\/* hydrate from id *\/)","            }","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"text":"Three things changed:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"The reducer’s "},{"type":"codeVoice","code":"path: StackState<Path.State>"},{"type":"text","text":" is gone — the"},{"type":"text","text":" "},{"type":"text","text":"parent reducer no longer carries navigation state."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The parent action enum no longer routes","type":"text"},{"text":" ","type":"text"},{"code":"case path(StackActionOf<Path>)","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The view uses "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" + "},{"type":"codeVoice","code":"NavigationStore<AppRoute>"},{"type":"text","text":" "},{"type":"text","text":"in place of "},{"type":"codeVoice","code":"NavigationStackStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"Path"},{"type":"text","text":" reducer"},{"type":"text","text":" "},{"type":"text","text":"composition."}],"type":"paragraph"}]}],"type":"orderedList"},{"text":"Modal presentation (`@Presents` → `ModalStore`)","level":2,"type":"heading","anchor":"Modal-presentation-Presents-%E2%86%92-ModalStore"},{"inlineContent":[{"text":"TCA’s ","type":"text"},{"type":"codeVoice","code":"@Presents"},{"text":" is conceptually equivalent to a ","type":"text"},{"type":"codeVoice","code":"ModalStore"},{"text":" ","type":"text"},{"text":"slot. Replace:","type":"text"}],"type":"paragraph"},{"code":["@ObservableState","struct State {","    @Presents var sheet: SheetFeature.State?","}","","enum Action {","    case sheet(PresentationAction<SheetFeature.Action>)","}","","\/\/ View",".sheet(item: $store.scope(state: \\.sheet, action: \\.sheet)) { … }"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"text":"with:","type":"text"}],"type":"paragraph"},{"code":["\/\/ State + Action no longer carry the modal slot.","","\/\/ View","ModalHost(store: modalStore) { route in","    switch route { case .sheet: SheetView(…) }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"text":"The reducer no longer fires ","type":"text"},{"code":"Action.sheet(.presented(…))","type":"codeVoice"},{"text":"; the","type":"text"},{"text":" ","type":"text"},{"text":"view dispatches ","type":"text"},{"code":"flowStore.send(.presentSheet(.sheet))","type":"codeVoice"},{"text":" directly","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"code":"@EnvironmentFlowIntent","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Stack + modal as one value (`StackState` + `@Presents` → `FlowStore`)","level":2,"type":"heading","anchor":"Stack-+-modal-as-one-value-StackState-+-Presents-%E2%86%92-FlowStore"},{"inlineContent":[{"type":"text","text":"If a feature uses both navigation and modal authority, replace"},{"type":"text","text":" "},{"type":"text","text":"both with a single "},{"type":"codeVoice","code":"FlowStore<Route>"},{"type":"text","text":" and observe "},{"type":"codeVoice","code":"path: [RouteStep<Route>]"},{"type":"text","text":" as the single source of truth. The"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" value type makes the entire flow state Codable for"},{"type":"text","text":" "},{"type":"text","text":"deep-link rehydration and state restoration."}],"type":"paragraph"},{"text":"Testing — `TestStore` → `NavigationTestStore` \/ `FlowTestStore`","level":2,"type":"heading","anchor":"Testing-TestStore-%E2%86%92-NavigationTestStore--FlowTestStore"},{"inlineContent":[{"code":"InnoRouterTesting","type":"codeVoice"},{"text":" ships host-less test stores that mirror","type":"text"},{"text":" ","type":"text"},{"text":"TCA’s strict-exhaustivity ergonomics. Swap:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let testStore = TestStore(initialState: AppFeature.State()) { AppFeature() }","await testStore.send(.path(.push(id: 0, state: .detail(...))))"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"with:","type":"text"}]},{"type":"codeListing","code":["let test = NavigationTestStore<AppRoute>()","test.execute(.push(.detail(id)))","test.expect(state: [.detail(id)])"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The test store keeps any analytics \/ diagnostic callbacks the"},{"type":"text","text":" "},{"type":"text","text":"production store wired through "},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so the test asserts production telemetry without"},{"type":"text","text":" "},{"code":"@testable import","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"What stays in TCA","anchor":"What-stays-in-TCA"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter explicitly does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" replace:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Business logic reducers (","type":"text"},{"code":"Reduce { state, action in … }","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Side effects (","type":"text"},{"type":"codeVoice","code":"Effect.send"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Effect.run"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Dependency injection (","type":"text"},{"code":"@Dependency","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Cross-feature coordination (parent ⇄ child reducer composition"},{"type":"text","text":" "},{"type":"text","text":"for non-navigation concerns)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"A typical migrated codebase keeps every reducer in place; the","type":"text"},{"text":" ","type":"text"},{"text":"delta is the state slots and actions removed because navigation","type":"text"},{"text":" ","type":"text"},{"text":"no longer needs reducer-level modeling.","type":"text"}]},{"type":"heading","level":2,"text":"Migration sequence","anchor":"Migration-sequence"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Start with a leaf feature whose navigation state lives only"},{"type":"text","text":" "},{"type":"text","text":"in the parent reducer’s "},{"type":"codeVoice","code":"StackState"},{"type":"text","text":". Replace its view-layer"},{"type":"text","text":" "},{"type":"text","text":"wiring with "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" + "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Strip the matching ","type":"text"},{"type":"codeVoice","code":"path"},{"text":" slot and ","type":"text"},{"type":"codeVoice","code":"Path"},{"text":" reducer from the","type":"text"},{"text":" ","type":"text"},{"text":"parent reducer. Verify the existing tests still pass against","type":"text"},{"text":" ","type":"text"},{"text":"the trimmed reducer state.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeat per feature. The blast radius per migration is"},{"type":"text","text":" "},{"type":"text","text":"contained because each "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" is independent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Tackle modal authority feature-by-feature once the navigation","type":"text"},{"text":" ","type":"text"},{"text":"stacks are ported. ","type":"text"},{"code":"@Presents","type":"codeVoice"},{"text":" is the cheapest swap.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For features with both stack and modal authority, migrate","type":"text"},{"text":" ","type":"text"},{"text":"them last by lifting the combined state into ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"capturing the deep-link flow through ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":".","type":"text"}]}]}],"type":"orderedList"},{"type":"heading","level":2,"text":"Common pitfalls","anchor":"Common-pitfalls"},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action forwarding instinct."}]},{"type":"text","text":" TCA users habitually plumb"},{"type":"text","text":" "},{"type":"text","text":"navigation through actions even when the feature doesn’t need"},{"type":"text","text":" "},{"type":"text","text":"it. With "},{"code":"@EnvironmentNavigationIntent","type":"codeVoice"},{"type":"text","text":", the view dispatches"},{"type":"text","text":" "},{"type":"text","text":"intents directly; the reducer never sees a navigation action"},{"type":"text","text":" "},{"type":"text","text":"unless you explicitly want to gate one through middleware."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Strict concurrency floor.","type":"text"}]},{"type":"text","text":" InnoRouter requires iOS 18 \/"},{"type":"text","text":" "},{"type":"text","text":"Swift 6.2. If the project still targets iOS 13–17, plan the"},{"type":"text","text":" "},{"type":"text","text":"platform bump as a separate PR before the navigation"},{"type":"text","text":" "},{"type":"text","text":"migration."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"@Bindable store","type":"codeVoice"},{"text":" ergonomics.","type":"text"}]},{"type":"text","text":" "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" is"},{"type":"text","text":" "},{"code":"@Observable","type":"codeVoice"},{"type":"text","text":" and works with "},{"code":"@Bindable","type":"codeVoice"},{"type":"text","text":" directly — no"},{"type":"text","text":" "},{"code":"bindable","type":"codeVoice"},{"type":"text","text":" modifier or scoped binding helpers are needed."}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Reference","anchor":"Reference"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NavigationHost"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"ModalHost","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FlowStore","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"FlowPlan","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"InnoRouterTesting","type":"codeVoice"},{"type":"text","text":" ("},{"code":"NavigationTestStore","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"ModalTestStore","type":"codeVoice"},{"type":"text","text":", "},{"code":"FlowTestStore","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","abstract":[],"type":"topic","url":"\/documentation\/