odalTestStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":")"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"kind":"article","metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Migrating navigation from TCA to InnoRouter","role":"article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/migration-fromtca"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"text":"This guide walks a TCA project through replacing its navigation","type":"text"},{"text":" ","type":"text"},{"text":"layer with InnoRouter while keeping the rest of the architecture","type":"text"},{"text":" ","type":"text"},{"text":"(reducers, effects, state) intact. InnoRouter is ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"replacement for TCA’s reducer composition — it replaces the","type":"text"},{"text":" ","type":"text"},{"text":"parts of TCA that own ","type":"text"},{"inlineContent":[{"text":"navigation state","type":"text"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"type":"text","text":"modal authority"}],"type":"emphasis"},{"type":"text","text":"."}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://c