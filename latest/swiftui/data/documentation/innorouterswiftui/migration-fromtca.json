{"primaryContentSections":[{"content":[{"anchor":"Why-this-migration","text":"Why this migration","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TCA’s navigation surface ("},{"type":"codeVoice","code":"StackState<Element>"},{"type":"text","text":", "},{"type":"codeVoice","code":"@Presents"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStackStore"},{"type":"text","text":") bundles three responsibilities:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"State authority"}],"type":"strong"},{"type":"text","text":" — what is on the stack, what modal is up."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Action plumbing","type":"text"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"Action.path(.push(...))"},{"type":"text","text":", "},{"type":"codeVoice","code":"delegate"},{"type":"text","text":" "},{"type":"text","text":"actions, "},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":" from the parent."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"View binding"}],"type":"strong"},{"type":"text","text":" — "},{"type":"codeVoice","code":"NavigationStackStore"},{"type":"text","text":" translates child"},{"type":"text","text":" "},{"type":"text","text":"stores into "},{"type":"codeVoice","code":"NavigationLink"},{"type":"text","text":"s."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"InnoRouter takes ownership of (1) and (3) and replaces (2)","type":"text"},{"text":" ","type":"text"},{"text":"with a typed ","type":"text"},{"code":"NavigationIntent","type":"codeVoice"},{"text":" enum that flows through the","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI environment. The reducer surface shrinks because the","type":"text"},{"text":" ","type":"text"},{"text":"parent reducer no longer needs to forward navigation actions","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"code":"StackState","type":"codeVoice"},{"text":" mutations.","type":"text"}]},{"anchor":"The-minimal-swap","text":"The minimal swap","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A canonical TCA navigation feature looks like this:"}]},{"syntax":"swift skip doc-fragment","code":["@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable {","        var path = StackState<Path.State>()","    }","","    enum Action {","        case path(StackActionOf<Path>)","    }","","    @Reducer","    struct Path {","        enum State: Equatable { case detail(DetailFeature.State) }","        enum Action { case detail(DetailFeature.Action) }","        var body: some ReducerOf<Self> {","            Scope(state: \\.detail, action: \\.detail) { DetailFeature() }","        }","    }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","            .forEach(\\.path, action: \\.path) { Path() }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        NavigationStackStore(store.scope(state: \\.path, action: \\.path)) {","            RootView(store: store)","        } destination: { store in","            switch store.state {","            case .detail:","                if let detail = store.scope(state: \\.detail, action: \\.detail) {","                    DetailView(store: detail)","                }","            }","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"After migration:","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["@Routable","enum AppRoute: Route {","    case detail(DetailFeature.State.ID)","}","","@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable { \/* business state only *\/ }","","    enum Action { \/* business actions only *\/ }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","    @State private var navigationStore = NavigationStore<AppRoute>()","","    var body: some View {","        NavigationHost(store: navigationStore) {","            RootView(store: store)","        } destination: { route in","            switch route {","            case .detail(let id):","                DetailView(\/* hydrate from id *\/)","            }","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Three things changed:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The reducer’s "},{"type":"codeVoice","code":"path: StackState<Path.State>"},{"type":"text","text":" is gone — the"},{"type":"text","text":" "},{"type":"text","text":"parent reducer no longer carries navigation state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The parent action enum no longer routes"},{"type":"text","text":" "},{"type":"codeVoice","code":"case path(StackActionOf<Path>)"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"The view uses ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"NavigationStore<AppRoute>","type":"codeVoice"},{"text":" ","type":"text"},{"text":"in place of ","type":"text"},{"code":"NavigationStackStore","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"Path","type":"codeVoice"},{"text":" reducer","type":"text"},{"text":" ","type":"text"},{"text":"composition.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","anchor":"Modal-presentation-Presents-%E2%86%92-ModalStore","level":2,"text":"Modal presentation (`@Presents` → `ModalStore`)"},{"type":"paragraph","inlineContent":[{"text":"TCA’s ","type":"text"},{"code":"@Presents","type":"codeVoice"},{"text":" is conceptually equivalent to a ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" ","type":"text"},{"text":"slot. Replace:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@ObservableState","struct State {","    @Presents var sheet: SheetFeature.State?","}","","enum Action {","    case sheet(PresentationAction<SheetFeature.Action>)","}","","\/\/ View",".sheet(item: $store.scope(state: \\.sheet, action: \\.sheet)) { … }"]},{"type":"paragraph","inlineContent":[{"text":"with:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["\/\/ State + Action no longer carry the modal slot.","","\/\/ View","ModalHost(store: modalStore) { route in","    switch route { case .sheet: SheetView(…) }","}"]},{"type":"paragraph","inlineContent":[{"text":"The reducer no longer fires ","type":"text"},{"code":"Action.sheet(.presented(…))","type":"codeVoice"},{"text":"; the","type":"text"},{"text":" ","type":"text"},{"text":"view dispatches ","type":"text"},{"code":"flowStore.send(.presentSheet(.sheet))","type":"codeVoice"},{"text":" directly","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"code":"@EnvironmentFlowIntent","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Stack-+-modal-as-one-value-StackState-+-Presents-%E2%86%92-FlowStore","level":2,"text":"Stack + modal as one value (`StackState` + `@Presents` → `FlowStore`)"},{"type":"paragraph","inlineContent":[{"text":"If a feature uses both navigation and modal authority, replace","type":"text"},{"text":" ","type":"text"},{"text":"both with a single ","type":"text"},{"code":"FlowStore<Route>","type":"codeVoice"},{"text":" and observe ","type":"text"},{"code":"path: [RouteStep<Route>]","type":"codeVoice"},{"text":" as the single source of truth. The","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" value type makes the entire flow state Codable for","type":"text"},{"text":" ","type":"text"},{"text":"deep-link rehydration and state restoration.","type":"text"}]},{"type":"heading","anchor":"Testing-TestStore-%E2%86%92-NavigationTestStore--FlowTestStore","level":2,"text":"Testing — `TestStore` → `NavigationTestStore` \/ `FlowTestStore`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" ships host-less test stores that mirror"},{"type":"text","text":" "},{"type":"text","text":"TCA’s strict-exhaustivity ergonomics. Swap:"}]},{"syntax":"swift skip doc-fragment","code":["let testStore = TestStore(initialState: AppFeature.State()) { AppFeature() }","await testStore.send(.path(.push(id: 0, state: .detail(...))))"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"with:","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["let test = NavigationTestStore<AppRoute>()","test.execute(.push(.detail(id)))","test.expect(state: [.detail(id)])"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The test store keeps any analytics \/ diagnostic callbacks the"},{"type":"text","text":" "},{"type":"text","text":"production store wired through "},{"type":"codeVoice","code":"NavigationStoreConfiguration"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so the test asserts production telemetry without"},{"type":"text","text":" "},{"type":"codeVoice","code":"@testable import"},{"type":"text","text":"."}]},{"anchor":"What-stays-in-TCA","text":"What stays in TCA","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter explicitly does "},{"type":"strong","inlineContent":[{"text":"not","type":"text"}]},{"type":"text","text":" replace:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Business logic reducers ("},{"code":"Reduce { state, action in … }","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"text":"Side effects (","type":"text"},{"code":"Effect.send","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Effect.run","type":"codeVoice"},{"text":")","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dependency injection ("},{"code":"@Dependency","type":"codeVoice"},{"type":"text","text":")"}]}]},{"content":[{"inlineContent":[{"text":"Cross-feature coordination (parent ⇄ child reducer composition","type":"text"},{"text":" ","type":"text"},{"text":"for non-navigation concerns)","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A typical migrated codebase keeps every reducer in place; the"},{"type":"text","text":" "},{"type":"text","text":"delta is the state slots and actions removed because navigation"},{"type":"text","text":" "},{"type":"text","text":"no longer needs reducer-level modeling."}]},{"anchor":"Migration-sequence","text":"Migration sequence","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Start with a leaf feature whose navigation state lives only"},{"type":"text","text":" "},{"type":"text","text":"in the parent reducer’s "},{"type":"codeVoice","code":"StackState"},{"type":"text","text":". Replace its view-layer"},{"type":"text","text":" "},{"type":"text","text":"wiring with "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" + "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Strip the matching "},{"type":"codeVoice","code":"path"},{"type":"text","text":" slot and "},{"type":"codeVoice","code":"Path"},{"type":"text","text":" reducer from the"},{"type":"text","text":" "},{"type":"text","text":"parent reducer. Verify the existing tests still pass against"},{"type":"text","text":" "},{"type":"text","text":"the trimmed reducer state."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeat per feature. The blast radius per migration is"},{"type":"text","text":" "},{"type":"text","text":"contained because each "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" is independent."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Tackle modal authority feature-by-feature once the navigation","type":"text"},{"text":" ","type":"text"},{"text":"stacks are ported. ","type":"text"},{"code":"@Presents","type":"codeVoice"},{"text":" is the cheapest swap.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"For features with both stack and modal authority, migrate","type":"text"},{"text":" ","type":"text"},{"text":"them last by lifting the combined state into ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"capturing the deep-link flow through ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":".","type":"text"}]}]}],"type":"orderedList"},{"anchor":"Common-pitfalls","text":"Common pitfalls","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action forwarding instinct."}]},{"text":" TCA users habitually plumb","type":"text"},{"text":" ","type":"text"},{"text":"navigation through actions even when the feature doesn’t need","type":"text"},{"text":" ","type":"text"},{"text":"it. With ","type":"text"},{"type":"codeVoice","code":"@EnvironmentNavigationIntent"},{"text":", the view dispatches","type":"text"},{"text":" ","type":"text"},{"text":"intents directly; the reducer never sees a navigation action","type":"text"},{"text":" ","type":"text"},{"text":"unless you explicitly want to gate one through middleware.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Strict concurrency floor."}]},{"text":" InnoRouter requires iOS 18 \/","type":"text"},{"text":" ","type":"text"},{"text":"Swift 6.2. If the project still targets iOS 13–17, plan the","type":"text"},{"text":" ","type":"text"},{"text":"platform bump as a separate PR before the navigation","type":"text"},{"text":" ","type":"text"},{"text":"migration.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"code":"@Bindable store","type":"codeVoice"},{"text":" ergonomics.","type":"text"}]},{"text":" ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" is","type":"text"},{"text":" ","type":"text"},{"code":"@Observable","type":"codeVoice"},{"text":" and works with ","type":"text"},{"code":"@Bindable","type":"codeVoice"},{"text":" directly — no","type":"text"},{"text":" ","type":"text"},{"code":"bindable","type":"codeVoice"},{"text":" modifier or scoped binding helpers are needed.","type":"text"}]}]}],"type":"unorderedList"},{"anchor":"Reference","text":"Reference","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"NavigationStore"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"NavigationHost"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalHost"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FlowStore"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"FlowHost"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"FlowPlan"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" ("},{"type":"codeVoice","code":"NavigationTestStore"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalTestStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":")"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"This guide walks a TCA project through replacing its navigation","type":"text"},{"text":" ","type":"text"},{"text":"layer with InnoRouter while keeping the rest of the architecture","type":"text"},{"text":" ","type":"text"},{"text":"(reducers, effects, state) intact. InnoRouter is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"replacement for TCA’s reducer composition — it replaces the","type":"text"},{"text":" ","type":"text"},{"text":"parts of TCA that own ","type":"text"},{"inlineContent":[{"type":"text","text":"navigation state"}],"type":"emphasis"},{"type":"text","text":" and "},{"inlineContent":[{"text":"modal authority","type":"text"}],"type":"emphasis"},{"type":"text","text":"."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/migration-fromtca"]}],"metadata":{"title":"Migrating navigation from TCA to InnoRouter","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"kind":"article","identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Migration-FromTCA","interfaceLanguage":"swift"},"sections":[],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter.","type":"text"}],"url":"\/documentati