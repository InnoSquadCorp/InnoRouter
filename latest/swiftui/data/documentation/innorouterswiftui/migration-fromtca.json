{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Migration-FromTCA"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Why-this-migration","type":"heading","text":"Why this migration"},{"inlineContent":[{"text":"TCA’s navigation surface (","type":"text"},{"type":"codeVoice","code":"StackState<Element>"},{"type":"text","text":", "},{"type":"codeVoice","code":"@Presents"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"NavigationStackStore","type":"codeVoice"},{"type":"text","text":") bundles three responsibilities:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"State authority"}]},{"type":"text","text":" — what is on the stack, what modal is up."}]}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Action plumbing"}],"type":"strong"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"Action.path(.push(...))"},{"text":", ","type":"text"},{"type":"codeVoice","code":"delegate"},{"text":" ","type":"text"},{"text":"actions, ","type":"text"},{"type":"codeVoice","code":".dismiss"},{"text":" from the parent.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"View binding","type":"text"}]},{"type":"text","text":" — "},{"type":"codeVoice","code":"NavigationStackStore"},{"type":"text","text":" translates child"},{"type":"text","text":" "},{"type":"text","text":"stores into "},{"type":"codeVoice","code":"NavigationLink"},{"type":"text","text":"s."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"InnoRouter takes ownership of (1) and (3) and replaces (2)"},{"type":"text","text":" "},{"type":"text","text":"with a typed "},{"type":"codeVoice","code":"NavigationIntent"},{"text":" enum that flows through the","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI environment. The reducer surface shrinks because the","type":"text"},{"text":" ","type":"text"},{"text":"parent reducer no longer needs to forward navigation actions","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"type":"codeVoice","code":"StackState"},{"text":" mutations.","type":"text"}],"type":"paragraph"},{"anchor":"The-minimal-swap","level":2,"type":"heading","text":"The minimal swap"},{"inlineContent":[{"text":"A canonical TCA navigation feature looks like this:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable {","        var path = StackState<Path.State>()","    }","","    enum Action {","        case path(StackActionOf<Path>)","    }","","    @Reducer","    struct Path {","        enum State: Equatable { case detail(DetailFeature.State) }","        enum Action { case detail(DetailFeature.Action) }","        var body: some ReducerOf<Self> {","            Scope(state: \\.detail, action: \\.detail) { DetailFeature() }","        }","    }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","            .forEach(\\.path, action: \\.path) { Path() }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        NavigationStackStore(store.scope(state: \\.path, action: \\.path)) {","            RootView(store: store)","        } destination: { store in","            switch store.state {","            case .detail:","                if let detail = store.scope(state: \\.detail, action: \\.detail) {","                    DetailView(store: detail)","                }","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"After migration:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Router","enum AppRoute {","    case detail(DetailFeature.State.ID)","","    var destination: some View {","        switch self {","        case .detail(let id):","            DetailView(\/* hydrate from id *\/)","        }","    }","}","","@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable { \/* business state only *\/ }","","    enum Action { \/* business actions only *\/ }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        RouterHost(AppRoute.self) {","            RootView(store: store)","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Three things changed:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The reducer’s "},{"code":"path: StackState<Path.State>","type":"codeVoice"},{"type":"text","text":" is gone — the"},{"type":"text","text":" "},{"type":"text","text":"parent reducer no longer carries navigation state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The parent action enum no longer routes"},{"type":"text","text":" "},{"code":"case path(StackActionOf<Path>)","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The view uses macro-generated destinations with "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" in place of"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStackStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"Path"},{"type":"text","text":" reducer composition. No navigation store is"},{"type":"text","text":" "},{"type":"text","text":"exposed to the feature for this self-contained stack."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If a TCA dependency, deep-link handler, or restoration boundary must access"},{"type":"text","text":" "},{"type":"text","text":"the navigation authority, promote the store to the app boundary. "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" "},{"type":"text","text":"still removes the destination closure, so the advanced form keeps the correct"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" closure order:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@State private var navigationStore = NavigationStore<AppRoute>()","","NavigationHost(store: navigationStore) {","    RootView(store: store)","}"]},{"text":"Modal presentation (`@Presents` → `ModalStore`)","anchor":"Modal-presentation-Presents-%E2%86%92-ModalStore","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"TCA’s "},{"type":"codeVoice","code":"@Presents"},{"type":"text","text":" is conceptually equivalent to a "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" "},{"type":"text","text":"slot. Replace:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@ObservableState","struct State {","    @Presents var sheet: SheetFeature.State?","}","","enum Action {","    case sheet(PresentationAction<SheetFeature.Action>)","}","","\/\/ View",".sheet(item: $store.scope(state: \\.sheet, action: \\.sheet)) { … }"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"with:"}]},{"syntax":"swift skip doc-fragment","code":["\/\/ State + Action no longer carry the modal slot.","","\/\/ View","ModalHost(store: modalStore) { route in","    switch route { case .sheet: SheetView(…) }","} content: {","    RootView()","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The reducer no longer fires ","type":"text"},{"code":"Action.sheet(.presented(…))","type":"codeVoice"},{"text":"; the view reads","type":"text"},{"text":" ","type":"text"},{"code":"@EnvironmentRouter(AppModalRoute.self)","type":"codeVoice"},{"text":" and calls ","type":"text"},{"code":"router.sheet(_:)","type":"codeVoice"},{"text":". Move to","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" only when stack and modal state must form one atomic timeline;","type":"text"},{"text":" ","type":"text"},{"text":"flow-specific intents use ","type":"text"},{"code":"router.send(flow:)","type":"codeVoice"},{"text":" through the same environment","type":"text"},{"text":" ","type":"text"},{"text":"router surface.","type":"text"}]},{"anchor":"Stack-+-modal-as-one-value-StackState-+-Presents-%E2%86%92-FlowStore","type":"heading","level":2,"text":"Stack + modal as one value (`StackState` + `@Presents` → `FlowStore`)"},{"type":"paragraph","inlineContent":[{"text":"If a feature uses both navigation and modal authority, replace","type":"text"},{"text":" ","type":"text"},{"text":"both with a single ","type":"text"},{"type":"codeVoice","code":"FlowStore<Route>"},{"text":" and observe ","type":"text"},{"type":"codeVoice","code":"path: [RouteStep<Route>]"},{"text":" as the single source of truth. The","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":" value type makes the entire flow state Codable for","type":"text"},{"text":" ","type":"text"},{"text":"deep-link rehydration and state restoration.","type":"text"}]},{"anchor":"Testing-TestStore-%E2%86%92-NavigationTestStore--FlowTestStore","type":"heading","level":2,"text":"Testing — `TestStore` → `NavigationTestStore` \/ `FlowTestStore`"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" ships host-less test stores that mirror"},{"type":"text","text":" "},{"type":"text","text":"TCA’s strict-exhaustivity ergonomics. Swap:"}]},{"syntax":"swift skip doc-fragment","code":["let testStore = TestStore(initialState: AppFeature.State()) { AppFeature() }","await testStore.send(.path(.push(id: 0, state: .detail(...))))"],"type":"codeListing"},{"inlineContent":[{"text":"with:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let test = NavigationTestStore<AppRoute>()","test.execute(.push(.detail(id)))","test.expect(state: [.detail(id)])"],"type":"codeListing"},{"inlineContent":[{"text":"The test store keeps the analytics \/ diagnostic ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" callback the","type":"text"},{"text":" ","type":"text"},{"text":"production store wired through ","type":"text"},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so the test asserts production telemetry without","type":"text"},{"text":" ","type":"text"},{"code":"@testable import","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"anchor":"What-stays-in-TCA","text":"What stays in TCA","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"InnoRouter explicitly does "},{"type":"strong","inlineContent":[{"type":"text","text":"not"}]},{"type":"text","text":" replace:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Business logic reducers ("},{"type":"codeVoice","code":"Reduce { state, action in … }"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Side effects ("},{"code":"Effect.send","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Effect.run","type":"codeVoice"},{"text":")","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Dependency injection ("},{"type":"codeVoice","code":"@Dependency"},{"type":"text","text":")"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cross-feature coordination (parent ⇄ child reducer composition","type":"text"},{"text":" ","type":"text"},{"text":"for non-navigation concerns)","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"A typical migrated codebase keeps every reducer in place; the"},{"type":"text","text":" "},{"type":"text","text":"delta is the state slots and actions removed because navigation"},{"type":"text","text":" "},{"type":"text","text":"no longer needs reducer-level modeling."}],"type":"paragraph"},{"level":2,"text":"Migration sequence","anchor":"Migration-sequence","type":"heading"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Start with a leaf feature whose navigation state lives only in the parent"},{"type":"text","text":" "},{"type":"text","text":"reducer’s "},{"code":"StackState","type":"codeVoice"},{"type":"text","text":". Declare its route with "},{"code":"@Router","type":"codeVoice"},{"type":"text","text":" and replace the"},{"type":"text","text":" "},{"type":"text","text":"view-layer wiring with "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Strip the matching "},{"type":"codeVoice","code":"path"},{"type":"text","text":" slot and "},{"type":"codeVoice","code":"Path"},{"type":"text","text":" reducer from the"},{"type":"text","text":" "},{"type":"text","text":"parent reducer. Verify the existing tests still pass against"},{"type":"text","text":" "},{"type":"text","text":"the trimmed reducer state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Repeat per feature. The blast radius per migration is contained because","type":"text"},{"text":" ","type":"text"},{"text":"each ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" owns an independent local ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" behind","type":"text"},{"text":" ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tackle modal authority feature-by-feature once the navigation"},{"type":"text","text":" "},{"type":"text","text":"stacks are ported. "},{"type":"codeVoice","code":"@Presents"},{"type":"text","text":" is the cheapest swap."}]}]},{"content":[{"inlineContent":[{"text":"For features with both stack and modal authority, migrate","type":"text"},{"text":" ","type":"text"},{"text":"them last by lifting the combined state into ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"capturing the deep-link flow through ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":".","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Common-pitfalls","level":2,"text":"Common pitfalls"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Action forwarding instinct."}]},{"type":"text","text":" TCA users habitually plumb navigation"},{"type":"text","text":" "},{"type":"text","text":"through actions even when the feature doesn’t need it. With"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":", the view calls "},{"type":"codeVoice","code":"router.go(...)"},{"type":"text","text":" directly; the reducer"},{"type":"text","text":" "},{"type":"text","text":"never sees a navigation action unless you explicitly want to gate one"},{"type":"text","text":" "},{"type":"text","text":"through middleware."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Strict concurrency floor.","type":"text"}]},{"type":"text","text":" InnoRouter requires iOS 18 \/"},{"type":"text","text":" "},{"type":"text","text":"Swift 6.3. If the project still targets iOS 1