{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Migration-FromTCA"},"variants":[{"paths":["\/documentation\/innorouterswiftui\/migration-fromtca"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"title":"Migrating navigation from TCA to InnoRouter","role":"article"},"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Why this migration","type":"heading","anchor":"Why-this-migration","level":2},{"inlineContent":[{"text":"TCA’s navigation surface (","type":"text"},{"code":"StackState<Element>","type":"codeVoice"},{"text":", ","type":"text"},{"code":"@Presents","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"NavigationStackStore","type":"codeVoice"},{"text":") bundles three responsibilities:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"State authority"}],"type":"strong"},{"text":" — what is on the stack, what modal is up.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"Action plumbing"}],"type":"strong"},{"text":" — ","type":"text"},{"type":"codeVoice","code":"Action.path(.push(...))"},{"text":", ","type":"text"},{"type":"codeVoice","code":"delegate"},{"text":" ","type":"text"},{"text":"actions, ","type":"text"},{"type":"codeVoice","code":".dismiss"},{"type":"text","text":" from the parent."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"View binding","type":"text"}],"type":"strong"},{"type":"text","text":" — "},{"code":"NavigationStackStore","type":"codeVoice"},{"type":"text","text":" translates child"},{"text":" ","type":"text"},{"type":"text","text":"stores into "},{"code":"NavigationLink","type":"codeVoice"},{"type":"text","text":"s."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"InnoRouter takes ownership of (1) and (3) and replaces (2)","type":"text"},{"type":"text","text":" "},{"type":"text","text":"with a typed "},{"type":"codeVoice","code":"NavigationIntent"},{"text":" enum that flows through the","type":"text"},{"text":" ","type":"text"},{"text":"SwiftUI environment. The reducer surface shrinks because the","type":"text"},{"text":" ","type":"text"},{"text":"parent reducer no longer needs to forward navigation actions","type":"text"},{"text":" ","type":"text"},{"text":"into ","type":"text"},{"code":"StackState","type":"codeVoice"},{"text":" mutations.","type":"text"}],"type":"paragraph"},{"anchor":"The-minimal-swap","type":"heading","level":2,"text":"The minimal swap"},{"inlineContent":[{"text":"A canonical TCA navigation feature looks like this:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable {","        var path = StackState<Path.State>()","    }","","    enum Action {","        case path(StackActionOf<Path>)","    }","","    @Reducer","    struct Path {","        enum State: Equatable { case detail(DetailFeature.State) }","        enum Action { case detail(DetailFeature.Action) }","        var body: some ReducerOf<Self> {","            Scope(state: \\.detail, action: \\.detail) { DetailFeature() }","        }","    }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","            .forEach(\\.path, action: \\.path) { Path() }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        NavigationStackStore(store.scope(state: \\.path, action: \\.path)) {","            RootView(store: store)","        } destination: { store in","            switch store.state {","            case .detail:","                if let detail = store.scope(state: \\.detail, action: \\.detail) {","                    DetailView(store: detail)","                }","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"After migration:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@Router","enum AppRoute {","    case detail(DetailFeature.State.ID)","","    var destination: some View {","        switch self {","        case .detail(let id):","            DetailView(\/* hydrate from id *\/)","        }","    }","}","","@Reducer","struct AppFeature {","    @ObservableState","    struct State: Equatable { \/* business state only *\/ }","","    enum Action { \/* business actions only *\/ }","","    var body: some ReducerOf<Self> {","        Reduce { state, action in \/* business logic *\/ }","    }","}","","struct AppView: View {","    @Bindable var store: StoreOf<AppFeature>","","    var body: some View {","        RouterHost(AppRoute.self) {","            RootView(store: store)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Three things changed:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"The reducer’s ","type":"text"},{"code":"path: StackState<Path.State>","type":"codeVoice"},{"type":"text","text":" is gone — the"},{"type":"text","text":" "},{"text":"parent reducer no longer carries navigation state.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The parent action enum no longer routes"},{"text":" ","type":"text"},{"code":"case path(StackActionOf<Path>)","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"The view uses macro-generated destinations with ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"text":" in place of","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationStackStore"},{"text":" + ","type":"text"},{"code":"Path","type":"codeVoice"},{"text":" reducer composition. No navigation store is","type":"text"},{"type":"text","text":" "},{"type":"text","text":"exposed to the feature for this self-contained stack."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"If a TCA dependency, deep-link handler, or restoration boundary must access","type":"text"},{"text":" ","type":"text"},{"text":"the navigation authority, promote the store to the app boundary. ","type":"text"},{"type":"codeVoice","code":"@Router"},{"text":" ","type":"text"},{"text":"still removes the destination closure, so the advanced form keeps the correct","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationHost"},{"text":" closure order:","type":"text"}],"type":"paragraph"},{"code":["@State private var navigationStore = NavigationStore<AppRoute>()","","NavigationHost(store: navigationStore) {","    RootView(store: store)","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"text":"Modal presentation (`@Presents` → `ModalStore`)","anchor":"Modal-presentation-Presents-%E2%86%92-ModalStore","type":"heading"},{"inlineContent":[{"text":"TCA’s ","type":"text"},{"code":"@Presents","type":"codeVoice"},{"text":" is conceptually equivalent to a ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" "},{"text":"slot. Replace:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@ObservableState","struct State {","    @Presents var sheet: SheetFeature.State?","}","","enum Action {","    case sheet(PresentationAction<SheetFeature.Action>)","}","","\/\/ View",".sheet(item: $store.scope(state: \\.sheet, action: \\.sheet)) { … }"]},{"inlineContent":[{"text":"with:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["\/\/ State + Action no longer carry the modal slot.","","\/\/ View","ModalHost(store: modalStore) { route in","    switch route { case .sheet: SheetView(…) }","} content: {","    RootView()","}"]},{"inlineContent":[{"text":"The reducer no longer fires ","type":"text"},{"code":"Action.sheet(.presented(…))","type":"codeVoice"},{"text":"; the view reads","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@EnvironmentRouter(AppModalRoute.self)"},{"text":" and calls ","type":"text"},{"type":"codeVoice","code":"router.sheet(_:)"},{"text":". Move to","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" only when stack and modal state must form one atomic timeline;"},{"text":" ","type":"text"},{"text":"flow-specific intents use ","type":"text"},{"type":"codeVoice","code":"router.send(flow:)"},{"text":" through the same environment","type":"text"},{"text":" ","type":"text"},{"text":"router surface.","type":"text"}],"type":"paragraph"},{"type":"heading","anchor":"Stack-+-modal-as-one-value-StackState-+-Presents-%E2%86%92-FlowStore","text":"Stack + modal as one value (`StackState` + `@Presents` → `FlowStore`)","level":2},{"inlineContent":[{"text":"If a feature uses both navigation and modal authority, replace","type":"text"},{"type":"text","text":" "},{"text":"both with a single ","type":"text"},{"code":"FlowStore<Route>","type":"codeVoice"},{"text":" and observe ","type":"text"},{"type":"codeVoice","code":"path: [RouteStep<Route>]"},{"text":" as the single source of truth. The","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" value type makes the entire flow state Codable for"},{"text":" ","type":"text"},{"text":"deep-link rehydration and state restoration.","type":"text"}],"type":"paragraph"},{"anchor":"Testing-TestStore-%E2%86%92-NavigationTestStore--FlowTestStore","level":2,"text":"Testing — `TestStore` → `NavigationTestStore` \/ `FlowTestStore`","type":"heading"},{"inlineContent":[{"code":"InnoRouterTesting","type":"codeVoice"},{"text":" ships host-less test stores that mirror","type":"text"},{"text":" ","type":"text"},{"text":"TCA’s strict-exhaustivity ergonomics. Swap:","type":"text"}],"type":"paragraph"},{"code":["let testStore = TestStore(initialState: AppFeature.State()) { AppFeature() }","await testStore.send(.path(.push(id: 0, state: .detail(...))))"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"with:"}],"type":"paragraph"},{"type":"codeListing","code":["let test = NavigationTestStore<AppRoute>()","test.execute(.push(.detail(id)))","test.expect(state: [.detail(id)])"],"syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"The test store keeps the analytics \/ diagnostic ","type":"text"},{"type":"codeVoice","code":"onEvent"},{"text":" callback the","type":"text"},{"text":" ","type":"text"},{"text":"production store wired through ","type":"text"},{"code":"NavigationStoreConfiguration","type":"codeVoice"},{"text":",","type":"text"},{"type":"text","text":" "},{"text":"so the test asserts production telemetry without","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"@testable import"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"What stays in TCA","anchor":"What-stays-in-TCA"},{"inlineContent":[{"text":"InnoRouter explicitly does ","type":"text"},{"inlineContent":[{"type":"text","text":"not"}],"type":"strong"},{"text":" replace:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Business logic reducers ("},{"type":"codeVoice","code":"Reduce { state, action in … }"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Side effects ("},{"type":"codeVoice","code":"Effect.send"},{"type":"text","text":", "},{"type":"codeVoice","code":"Effect.run"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dependency injection ("},{"type":"codeVoice","code":"@Dependency"},{"type":"text","text":")"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cross-feature coordination (parent ⇄ child reducer composition"},{"type":"text","text":" "},{"type":"text","text":"for non-navigation concerns)"}]}]}]},{"inlineContent":[{"text":"A typical migrated codebase keeps every reducer in place; the","type":"text"},{"text":" ","type":"text"},{"text":"delta is the state slots and actions removed because navigation","type":"text"},{"text":" ","type":"text"},{"text":"no longer needs reducer-level modeling.","type":"text"}],"type":"paragraph"},{"anchor":"Migration-sequence","type":"heading","level":2,"text":"Migration sequence"},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Start with a leaf feature whose navigation state lives only in the parent"},{"type":"text","text":" "},{"type":"text","text":"reducer’s "},{"type":"codeVoice","code":"StackState"},{"type":"text","text":". Declare its route with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" and replace the"},{"type":"text","text":" "},{"type":"text","text":"view-layer wiring with "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Strip the matching "},{"type":"codeVoice","code":"path"},{"type":"text","text":" slot and "},{"type":"codeVoice","code":"Path"},{"type":"text","text":" reducer from the"},{"type":"text","text":" "},{"type":"text","text":"parent reducer. Verify the existing tests still pass against"},{"type":"text","text":" "},{"type":"text","text":"the trimmed reducer state."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Repeat per feature. The blast radius per migration is contained because"},{"type":"text","text":" "},{"type":"text","text":"each "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" owns an independent local "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" behind"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Tackle modal authority feature-by-feature once the navigation"},{"type":"text","text":" "},{"type":"text","text":"stacks are ported. "},{"type":"codeVoice","code":"@Presents"},{"type":"text","text":" is the cheapest swap."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"For features with both stack and modal authority, migrate"},{"type":"text","text":" "},{"type":"text","text":"them last by lifting the combined state into "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"capturing the deep-link flow through "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":"."}]}]}]},{"anchor":"Common-pitfalls","type":"heading","level":2,"text":"Common pitfalls"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Action forwarding instinct.","type":"text"}],"type":"strong"},{"type":"text","text":" TCA users habitually plumb navigation"},{"type":"text","text":" "},{"type":"text","text":"through actions even when the feature doesn’t need it. With"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":", the view calls "},{"type":"codeVoice","code":"router.go(...)"},{"type":"text","text":" directly; the reducer"},{"type":"text","text":" "},{"type":"text","text":"never sees a navigation action unless you explicitly want to gate one"},{"type":"text","text":" "},{"type":"text","text":"through middleware."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"text":"Strict concurrency floor.","type":"text"}],"type":"strong"},{"type":"text","text":" InnoRouter requires iOS 18 \/"},{"type":"text","text":" "},{"type":"text","text":"Swift 6.3. If the project still targets iOS 13–17, plan the"},{"type":"text","text":" "},{"type":"text","text":"platform bump as a separate PR before the navigation"},{"type":"text","text":" "},{"type":"text","text":"migration."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"code":"@Bindable store","type":"codeVoice"},{"text":" ergonomics.","type":"text"}],"type":"strong"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" is"},{"type":"text","text":" "},{"type":"codeVoice","code":"@Observable"},{"type":"text","text":" and works with "},{"type":"codeVoice","code":"@Bindable"},{"type":"text","text":" directly — no"},{"type":"text","text":" "},{"type":"codeVoice","code":"bindable"},{"type":"text","text":" modifier or scoped binding helpers are needed."}]}]}]},{"anchor":"Reference","type":"heading","level":2,"text":"Reference"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"@Router"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"@EnvironmentRouter"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" for externally owned authority"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalHost"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"FlowPlan"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" ("},{"type":"codeVoice","code":"NavigationTestStore"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalTestStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":")"}]}]}]}],"kind":"content"}],"sections":[],"abstract":[{"text":"This guide walks a TCA project through replacing its navigation","type":"text"},{"text":" ","type":"text"},{"text":"layer with InnoRouter while keeping the rest of the architecture","type":"text"},{"text":" ","type":"text"},{"text":"(reducers, effects, state) intact. InnoRouter is ","type":"text"},{"inlineContent":[{"text":"not","type":"text"}],"type":"strong"},{"text":" a","type":"text"},{"text":" ","type":"text"},{"text":"replacement for TCA’s reducer composition — it replaces the","type":"text"},{"text":" ","type":"text"},{"text":"parts of TCA that own ","type":"text"},{"inlineContent":[{"text":"navigation state","type":"text"}],"type":"emphasis"},{"text":" and ","type":"text"},{"inlineContent":[{"text":"modal authority","type":"text"}],"type":"emphasis"},{"text":".","type":"text"}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","kind":"article","title":"InnoRouterSwiftUI","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","abstract":[{"text":"Macro-first SwiftUI routing, externally owned stores, modal routing,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}]},"doc://c