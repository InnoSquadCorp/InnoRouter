t"},{"text":" ","type":"text"},{"text":"different authority that registers against the same ","type":"text"},{"type":"codeVoice","code":"Route"},{"text":" type in","type":"text"},{"text":" ","type":"text"},{"text":"the same environment scope is treated as a wiring bug: in Debug","type":"text"},{"text":" ","type":"text"},{"text":"builds the storage setter traps with ","type":"text"},{"type":"codeVoice","code":"assertionFailure"},{"text":", and in","type":"text"},{"text":" ","type":"text"},{"text":"Release it logs an error through the ","type":"text"},{"type":"codeVoice","code":"duplicate-dispatcher"},{"text":" ","type":"text"},{"type":"codeVoice","code":"os_log"},{"text":" category before letting the overwrite proceed (preserving","type":"text"},{"text":" ","type":"text"},{"text":"prior behaviour for production cold-starts).","type":"text"}]},{"inlineContent":[{"text":"If two surfaces legitimately need different routing authorities,","type":"text"},{"text":" ","type":"text"},{"text":"either give them distinct ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" types or scope them with separate","type":"text"},{"text":" ","type":"text"},{"text":"environment subtrees so each host gets its own storage.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Low-level tests or custom integrations that write directly into an","type":"text"},{"text":" ","type":"text"},{"text":"environment storage should either assign a handler once per storage","type":"text"},{"text":" ","type":"text"},{"text":"instance, or call the explicit owner registration helper with a stable","type":"text"},{"text":" ","type":"text"},{"text":"store \/ coordinator identity. The host modifiers do this for normal","type":"text"},{"text":" ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ModalHost","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":" usage.","type":"text"}],"type":"paragra