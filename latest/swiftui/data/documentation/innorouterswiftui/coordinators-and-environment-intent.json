{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/coordinators-and-environment-intent"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"kind":"article","abstract":[{"type":"text","text":"Coordinators in InnoRouter are SwiftUI-adapted reference authorities, not UIKit-era imperative routers."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Coordinators-and-Environment-Intent"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Coordinator role","anchor":"Coordinator-role"},{"type":"paragraph","inlineContent":[{"code":"Coordinator","type":"codeVoice"},{"text":" exists for cases where view intent should flow through a policy object before it reaches the store.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A coordinator:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"receives ","type":"text"},{"code":"NavigationIntent","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"decides whether to forward, rewrite, or replace commands","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"maps routes to destinations"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"stays observable for SwiftUI"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" remains "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" by design because it is a shared authority object, not ephemeral view state."}]},{"type":"heading","level":2,"text":"Environment router actions","anchor":"Environment-router-actions"},{"type":"paragraph","inlineContent":[{"code":"EnvironmentRouter","type":"codeVoice"},{"text":" is the primary route-action API for views. It exposes","type":"text"},{"text":" ","type":"text"},{"text":"discoverable ","type":"text"},{"type":"codeVoice","code":"RouterActions"},{"text":" methods such as ","type":"text"},{"type":"codeVoice","code":"go"},{"text":", ","type":"text"},{"type":"codeVoice","code":"sheet"},{"text":", and, for a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouterTab"},{"text":", ","type":"text"},{"type":"codeVoice","code":"select"},{"text":" without revealing host-owned state. Advanced","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationIntent"},{"type":"text","text":" values remain available through the explicit "},{"code":"send(_:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"escape hatch:"}]},{"code":["struct ProductRow: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    let productID: String","","    var body: some View {","        Button(\"Open\") {","            router.go(.product(id: productID))","        }","","        Button(\"Replace stack\") {","            router.send(.replaceStack([.catalog, .product(id: productID)]))","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"router.send(_:)"},{"type":"text","text":" when code needs to construct a "},{"type":"codeVoice","code":"NavigationIntent"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalIntent"},{"type":"text","text":" directly, and "},{"code":"router.send(flow:)","type":"codeVoice"},{"type":"text","text":" for an explicit "},{"code":"FlowIntent","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"When stack and modal authorities use different route types, declare one"},{"type":"text","text":" "},{"code":"@EnvironmentRouter","type":"codeVoice"},{"type":"text","text":" property for each route type."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps view code declarative:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"child views do not need a direct store reference","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"macro diagnostics catch invalid ","type":"text"},{"type":"codeVoice","code":"@Router"},{"text":" declarations at compile time","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"fail-fast environment behavior catches host wiring mistakes at runtime"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"multi-host trees can keep separate routing authorities in the same hierarchy"}]}]}]},{"text":"Host scoping and authority replacement","type":"heading","level":3,"anchor":"Host-scoping-and-authority-replacement"},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RouterModalHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"advanced store-backed host publishes one route-typed authority to its own view"},{"type":"text","text":" "},{"type":"text","text":"subtree. SwiftUI environment value semantics keep sibling hosts independent."},{"type":"text","text":" "},{"type":"text","text":"When a nested host uses the same "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" type, it replaces the complete"},{"type":"text","text":" "},{"type":"text","text":"authority for that subtree instead of merging capabilities from two stores."}]},{"inlineContent":[{"type":"text","text":"This replacement prevents an inner stack-only host from accidentally driving"},{"type":"text","text":" "},{"type":"text","text":"an outer modal or flow authority. Different route types can coexist in one"},{"type":"text","text":" "},{"type":"text","text":"subtree; views declare one "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" property for each route type"},{"type":"text","text":" "},{"type":"text","text":"they use. The registration and storage types are implementation details, so"},{"type":"text","text":" "},{"type":"text","text":"custom view trees should compose the public hosts rather than write router"},{"type":"text","text":" "},{"type":"text","text":"environment state directly."}],"type":"paragraph"},{"anchor":"Flow-and-tab-coordinators","level":2,"text":"Flow and tab coordinators","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":" is the macro-first tab surface. It owns selection and badge"},{"type":"text","text":" "},{"type":"text","text":"state locally, renders every generated "},{"type":"codeVoice","code":"RouterTab"},{"type":"text","text":" case through native"},{"type":"text","text":" "},{"code":"TabView","type":"codeVoice"},{"text":", and exposes ","type":"text"},{"code":"select","type":"codeVoice"},{"text":", ","type":"text"},{"code":"setBadge","type":"codeVoice"},{"text":", ","type":"text"},{"code":"clearBadge","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"code":"clearAllBadges","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"EnvironmentRouter","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["struct InboxButton: View {","    @EnvironmentRouter(AppTab.self) private var router","","    var body: some View {","        Button(\"Inbox\") {","            router.select(.inbox)","            router.setBadge(3, for: .inbox)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"StepCoordinator","type":"codeVoice"},{"type":"text","text":" and "},{"code":"TabCoordinator","type":"codeVoice"},{"type":"text","text":" remain advanced composition tools and"},{"type":"text","text":" "},{"type":"text","text":"complement "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":"; they do not replace it."}],"type":"paragraph"},{"inlineContent":[{"text":"Recommended mental model:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"NavigationStore","type":"codeVoice"},{"text":" owns route-stack authority","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"RouterTabHost","type":"codeVoice"},{"text":" owns local macro-first shell tab state","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"TabCoordinator","type":"codeVoice"},{"text":" owns externally managed or custom-shell tab state","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"StepCoordinator","type":"codeVoice"},{"text":" owns local step state inside a destination","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Use composition rather than trying to collapse all three responsibilities into one type.","type":"text"}]}],"kind":"content"}],"metadata":{"role":"article","title":"Coordinators and environment router","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article"},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter.