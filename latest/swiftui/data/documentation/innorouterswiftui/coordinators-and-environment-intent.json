end(flow:)"},{"text":" for an explicit ","type":"text"},{"type":"codeVoice","code":"FlowIntent"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"When stack and modal authorities use different route types, declare one","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@EnvironmentRouter"},{"text":" property for each route type.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This keeps view code declarative:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"child views do not need a direct store reference","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"macro diagnostics catch invalid ","type":"text"},{"type":"codeVoice","code":"@Router"},{"text":" declarations at compile time","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"fail-fast environment behavior catches host wiring mistakes at runtime","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"multi-host trees can keep separate routing authorities in the same hierarchy"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":3,"anchor":"Host-scoping-and-authority-replacement","text":"Host scoping and authority replacement"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"RouterHost"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RouterModalHost"},{"text":", ","type":"text"},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"advanced store-backed host publishes one route-typed authority to its own view"},{"text":" ","type":"text"},{"type":"text","text":"subtree. SwiftUI environment value semantics keep sibling hosts independent."},{"text":" ","type":"text"},{"text":"When a nested host uses the same ","type":"text"