{"metadata":{"title":"Coordinators and environment intent","role":"article","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article"},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Coordinators-and-Environment-Intent","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"kind":"article","sections":[],"abstract":[{"text":"Coordinators in InnoRouter are SwiftUI-adapted reference authorities, not UIKit-era imperative routers.","type":"text"}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/coordinators-and-environment-intent"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Coordinator role","anchor":"Coordinator-role","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" exists for cases where view intent should flow through a policy object before it reaches the store."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A coordinator:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"receives ","type":"text"},{"type":"codeVoice","code":"NavigationIntent"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"decides whether to forward, rewrite, or replace commands","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"maps routes to destinations","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"stays observable for SwiftUI","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" remains "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" by design because it is a shared authority object, not ephemeral view state."}]},{"text":"Environment intent","anchor":"Environment-intent","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EnvironmentNavigationIntent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"EnvironmentModalIntent"},{"type":"text","text":" are the primary view-facing APIs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps view code declarative:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"child views do not need a direct store reference"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"fail-fast behavior catches host wiring mistakes early"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"multi-host trees can keep separate routing authorities in the same hierarchy"}],"type":"paragraph"}]}]},{"text":"Sibling hosts and duplicate registration","anchor":"Sibling-hosts-and-duplicate-registration","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"Each ","type":"text"},{"code":"NavigationHost","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"ModalHost","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"FlowHost","type":"codeVoice"},{"text":" owns its own","type":"text"},{"text":" ","type":"text"},{"code":"*EnvironmentStorage","type":"codeVoice"},{"text":" instance through ","type":"text"},{"code":"@State","type":"codeVoice"},{"text":", so SwiftUI scopes the","type":"text"},{"text":" ","type":"text"},{"text":"handler table to the host’s view subtree. Re-registering the","type":"text"},{"text":" ","type":"text"},{"text":"same routing authority is allowed across SwiftUI updates, even when","type":"text"},{"text":" ","type":"text"},{"text":"the forwarding closure is freshly allocated. A sibling host with a","type":"text"},{"text":" ","type":"text"},{"text":"different authority that registers against the same ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" type in","type":"text"},{"text":" ","type":"text"},{"text":"the same environment scope is treated as a wiring bug: in Debug","type":"text"},{"text":" ","type":"text"},{"text":"builds the storage setter traps with ","type":"text"},{"code":"assertionFailure","type":"codeVoice"},{"text":", and in","type":"text"},{"text":" ","type":"text"},{"text":"Release it logs an error through the ","type":"text"},{"code":"duplicate-dispatcher","type":"codeVoice"},{"text":" ","type":"text"},{"code":"os_log","type":"codeVoice"},{"text":" category before letting the overwrite proceed (preserving","type":"text"},{"text":" ","type":"text"},{"text":"prior behaviour for production cold-starts).","type":"text"}]},{"inlineContent":[{"text":"If two surfaces legitimately need different routing authorities,","type":"text"},{"text":" ","type":"text"},{"text":"either give them distinct ","type":"text"},{"code":"Route","type":"codeVoice"},{"text":" types or scope them with separate","type":"text"},{"text":" ","type":"text"},{"text":"environment subtrees so each host gets its own storage.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Low-level tests or custom integrations that write directly into an"},{"type":"text","text":" "},{"type":"text","text":"environment storage should either assign a handler once per storage"},{"type":"text","text":" "},{"type":"text","text":"instance, or call the explicit owner registration helper with a stable"},{"type":"text","text":" "},{"type":"text","text":"store \/ coordinator identity. The host modifiers do this for normal"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":", and "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" usage."}],"type":"paragraph"},{"text":"Flow and tab coordinators","type":"heading","anchor":"Flow-and-tab-coordinators","level":2},{"inlineContent":[{"code":"FlowCoordinator","type":"codeVoice"},{"type":"text","text":" and "},{"code":"TabCoordinator","type":"codeVoice"},{"type":"text","text":" complement "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":"; they do not replace it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Recommended mental model:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" owns route-stack authority"}]}]},{"content":[{"inlineContent":[{"code":"TabCoordinator","type":"codeVoice"},{"type":"text","text":" owns shell tab state"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"FlowCoordinator"},{"type":"text","text":" owns local step state inside a destination"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Use composition rather than trying to collapse all three responsibilities into one type.","type":"text"}],"type":"paragraph"}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter.","type":"text"}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","kind":"article","type":"topic","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","kind":"symbol","type":"topic","role":"collection","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","abstract":[]}}}