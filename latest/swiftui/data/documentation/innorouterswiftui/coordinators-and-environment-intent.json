"codeVoice"},{"text":" for an explicit ","type":"text"},{"code":"FlowIntent","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"When stack and modal authorities use different route types, declare one","type":"text"},{"text":" ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"type":"text","text":" property for each route type."}],"type":"paragraph"},{"inlineContent":[{"text":"This keeps view code declarative:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"child views do not need a direct store reference","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"macro diagnostics catch invalid ","type":"text"},{"type":"codeVoice","code":"@Router"},{"text":" declarations at compile time","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"fail-fast environment behavior catches host wiring mistakes at runtime","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"multi-host trees can keep separate routing authorities in the same hierarchy","type":"text"}],"type":"paragraph"}]}]},{"level":3,"text":"Host scoping and authority replacement","anchor":"Host-scoping-and-authority-replacement","type":"heading"},{"inlineContent":[{"text":"Each ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":", "},{"code":"RouterModalHost","type":"codeVoice"},{"type":"text","text":", "},{"code":"RouterSplitHost","type":"codeVoice"},{"type":"text","text":", "},{"code":"RouterTabHost","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"advanced store-backed host publishes one route-typed authority to its own view"},{"type":"text","text":" "},{"type":"text","text":"subtree. SwiftUI environment value semantics keep sibling hosts independent."},{"type":"text","text":" "},{"type":"text","text":"When a nested host uses the same "},{"code":"Route","