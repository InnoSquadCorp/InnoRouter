{"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Coordinators-and-Environment-Intent","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Coordinator-role","type":"heading","level":2,"text":"Coordinator role"},{"inlineContent":[{"code":"Coordinator","type":"codeVoice"},{"text":" exists for cases where view intent should flow through a policy object before it reaches the store.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A coordinator:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"receives "},{"code":"NavigationIntent","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"decides whether to forward, rewrite, or replace commands"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"maps routes to destinations"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"stays observable for SwiftUI"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" remains "},{"type":"codeVoice","code":"AnyObject"},{"type":"text","text":" by design because it is a shared authority object, not ephemeral view state."}],"type":"paragraph"},{"anchor":"Environment-router-actions","type":"heading","level":2,"text":"Environment router actions"},{"inlineContent":[{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" is the primary route-action API for views. It exposes"},{"type":"text","text":" "},{"type":"text","text":"discoverable "},{"type":"codeVoice","code":"RouterActions"},{"type":"text","text":" methods such as "},{"type":"codeVoice","code":"go"},{"type":"text","text":", "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":", and, for a"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTab"},{"type":"text","text":", "},{"type":"codeVoice","code":"select"},{"type":"text","text":" without revealing host-owned state. Advanced"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationIntent"},{"type":"text","text":" values remain available through the explicit "},{"type":"codeVoice","code":"send(_:)"},{"type":"text","text":" "},{"type":"text","text":"escape hatch:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["struct ProductRow: View {","    @EnvironmentRouter(AppRoute.self) private var router","","    let productID: String","","    var body: some View {","        Button(\"Open\") {","            router.go(.product(id: productID))","        }","","        Button(\"Replace stack\") {","            router.send(.replaceStack([.catalog, .product(id: productID)]))","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"router.send(_:)"},{"type":"text","text":" when code needs to construct a "},{"type":"codeVoice","code":"NavigationIntent"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"ModalIntent"},{"type":"text","text":" directly, and "},{"type":"codeVoice","code":"router.send(flow:)"},{"type":"text","text":" for an explicit "},{"type":"codeVoice","code":"FlowIntent"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"When stack and modal authorities use different route types, declare one"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" property for each route type."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This keeps view code declarative:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"child views do not need a direct store reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"macro diagnostics catch invalid "},{"code":"@Router","type":"codeVoice"},{"type":"text","text":" declarations at compile time"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"fail-fast environment behavior catches host wiring mistakes at runtime"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"multi-host trees can keep separate routing authorities in the same hierarchy"}]}]}],"type":"unorderedList"},{"anchor":"Host-scoping-and-authority-replacement","type":"heading","level":3,"text":"Host scoping and authority replacement"},{"inlineContent":[{"type":"text","text":"Each "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterModalHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"advanced store-backed host publishes one route-typed authority to its own view"},{"type":"text","text":" "},{"type":"text","text":"subtree. SwiftUI environment value semantics keep sibling hosts independent."},{"type":"text","text":" "},{"type":"text","text":"When a nested host uses the same "},{"type":"codeVoice","code":"Route"},{"type":"text","text":" type, it replaces the complete"},{"type":"text","text":" "},{"type":"text","text":"authority for that subtree instead of merging capabilities from two stores."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This replacement prevents an inner stack-only host from accidentally driving"},{"type":"text","text":" "},{"type":"text","text":"an outer modal or flow authority. Different route types can coexist in one"},{"type":"text","text":" "},{"type":"text","text":"subtree; views declare one "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" property for each route type"},{"type":"text","text":" "},{"type":"text","text":"they use. The registration and storage types are implementation details, so"},{"type":"text","text":" "},{"type":"text","text":"custom view trees should compose the public hosts rather than write router"},{"type":"text","text":" "},{"type":"text","text":"environment state directly."}],"type":"paragraph"},{"anchor":"Flow-and-tab-coordinators","type":"heading","level":2,"text":"Flow and tab coordinators"},{"inlineContent":[{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":" is the macro-first tab surface. It owns selection and badge"},{"type":"text","text":" "},{"type":"text","text":"state locally, renders every generated "},{"type":"codeVoice","code":"RouterTab"},{"type":"text","text":" case through native"},{"type":"text","text":" "},{"type":"codeVoice","code":"TabView"},{"type":"text","text":", and exposes "},{"type":"codeVoice","code":"select"},{"type":"text","text":", "},{"type":"codeVoice","code":"setBadge"},{"type":"text","text":", "},{"type":"codeVoice","code":"clearBadge"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"codeVoice","code":"clearAllBadges"},{"type":"text","text":" through "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["struct InboxButton: View {","    @EnvironmentRouter(AppTab.self) private var router","","    var body: some View {","        Button(\"Inbox\") {","            router.select(.inbox)","            router.setBadge(3, for: .inbox)","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"StepCoordinator"},{"type":"text","text":" and "},{"type":"codeVoice","code":"TabCoordinator"},{"type":"text","text":" remain advanced composition tools and"},{"type":"text","text":" "},{"type":"text","text":"complement "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":"; they do not replace it."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Recommended mental model:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" owns route-stack authority"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"RouterTabHost","type":"codeVoice"},{"type":"text","text":" owns local macro-first shell tab state"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"TabCoordinator","type":"codeVoice"},{"type":"text","text":" owns externally managed or custom-shell tab state"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"StepCoordinator","type":"codeVoice"},{"type":"text","text":" owns local step state inside a destination"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Use composition rather than trying to collapse all three responsibilities into one type."}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/coordinators-and-environment-intent"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Coordinators in InnoRouter are SwiftUI-adapted reference authorities, not UIKit-era imperative routers."}],"kind":"article","metadata":{"roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article","title":"Coordinators and environment router"},"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"kind":"article","title":"InnoRouterSwiftUI","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting","type":"topic"}}}