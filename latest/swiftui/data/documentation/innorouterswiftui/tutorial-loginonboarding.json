{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"metadata":{"title":"Building a Login Onboarding Flow","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", then scope the signup sub-flow through a "},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" and await its result inline."}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-loginonboarding"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"type":"heading","text":"Scenario","level":2,"anchor":"Scenario"},{"inlineContent":[{"text":"The app launches on a welcome screen. Tapping ","type":"text"},{"inlineContent":[{"text":"Continue","type":"text"}],"type":"emphasis"},{"text":" pushes a","type":"text"},{"text":" ","type":"text"},{"text":"pre-auth detail screen. Tapping ","type":"text"},{"inlineContent":[{"text":"Create account","type":"text"}],"type":"emphasis"},{"text":" presents a signup","type":"text"},{"text":" ","type":"text"},{"text":"sheet. When the signup finishes (or is cancelled) the parent flow","type":"text"},{"text":" ","type":"text"},{"text":"resumes — either navigating to ","type":"text"},{"code":".home(user)","type":"codeVoice"},{"text":" or staying put.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Modeling this with raw ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" means two","type":"text"},{"text":" ","type":"text"},{"text":"authority objects, two view-layer hosts, and hand-rolled","type":"text"},{"text":" ","type":"text"},{"text":"continuation plumbing to surface the sheet result back to the","type":"text"},{"text":" ","type":"text"},{"text":"parent. ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":" collapse this to a single","type":"text"},{"text":" ","type":"text"},{"text":"store and one ","type":"text"},{"code":"await","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Routes","level":2,"anchor":"Routes"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["enum AppRoute: Route {","    case welcome","    case preAuth","    case signup","    case home(UserID)","}"]},{"type":"heading","text":"Wiring the flow host","level":2,"anchor":"Wiring-the-flow-host"},{"inlineContent":[{"type":"codeVoice","code":"FlowHost"},{"text":" composes an inner ","type":"text"},{"type":"codeVoice","code":"ModalHost"},{"text":" over a ","type":"text"},{"type":"codeVoice","code":"NavigationHost"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"exposes both authorities through a single ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@main","struct DemoApp: App {","    @State private var flow = FlowStore<AppRoute>(initial: [.push(.welcome)])","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: flow,","                destination: destination,","                root: { WelcomeRootView() }","            )","        }","    }","","    @ViewBuilder","    private func destination(_ route: AppRoute) -> some View {","        switch route {","        case .welcome:","            WelcomeRootView()","        case .preAuth:","            PreAuthDetailView()","        case .signup:","            SignUpView()","        case .home(let id):","            HomeView(userID: id)","        }","    }","}"]},{"type":"heading","text":"Emitting intents from views","level":2,"anchor":"Emitting-intents-from-views"},{"inlineContent":[{"type":"text","text":"Views never mutate "},{"type":"codeVoice","code":"FlowStore.path"},{"type":"text","text":" directly; they emit"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowIntent"},{"type":"text","text":" values through the environment dispatcher so"},{"type":"text","text":" "},{"type":"text","text":"middleware and telemetry observe every step:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["struct WelcomeRootView: View {","    @EnvironmentFlowIntent<AppRoute> private var flow","","    var body: some View {","        VStack {","            Button(\"Continue\") {","                flow.send(.push(.preAuth))","            }","            Button(\"Create account\") {","                flow.send(.presentSheet(.signup))","            }","        }","    }","}"]},{"type":"heading","level":2,"anchor":"Awaiting-a-signup-sub-flow","text":"Awaiting a signup sub-flow"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The signup sheet opens its own "},{"code":"Coordinator","type":"codeVoice"},{"type":"text","text":" that owns the step"},{"type":"text","text":" "},{"type":"text","text":"progression (email → password → confirmation). The outer"},{"type":"text","text":" "},{"type":"text","text":"onboarding coordinator launches it via "},{"code":"push(child:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"await","type":"codeVoice"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"the final "},{"code":"UserID","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@MainActor","final class SignUpCoordinator: ChildCoordinator {","    typealias Result = UserID","    typealias RouteType = AppRoute","","    \/\/ ...step state + methods omitted","","    func userDidCreateAccount(_ userID: UserID) {","        onFinish(userID)   \/\/ emits the result back to the parent","    }","","    func userCancelled() {","        onCancel()          \/\/ parent sees nil","    }","}","","@MainActor","final class OnboardingCoordinator: Coordinator {","    typealias RouteType = AppRoute","    let navigationStore: NavigationStore<AppRoute>","","    func startSignUpFlow() async {","        let result = await push(child: SignUpCoordinator())","        if let userID = result {","            navigationStore.send(.go(.home(userID)))","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"push(child:)"},{"type":"text","text":" installs the child’s "},{"type":"codeVoice","code":"onFinish"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"onCancel"},{"type":"text","text":" "},{"type":"text","text":"callbacks synchronously, so the child can emit a result at any"},{"type":"text","text":" "},{"type":"text","text":"point — even before the parent’s "},{"type":"codeVoice","code":"await"},{"type":"text","text":" suspends — without a"},{"type":"text","text":" "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" re-entrancy deadlock. See"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"..\/..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md"},{"type":"text","text":" "},{"type":"text","text":"for the design rationale."}]},{"type":"heading","text":"Verifying the flow host-lessly","anchor":"Verifying-the-flow-host-lessly","level":2},{"type":"paragraph","inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"text":" (in ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":") exercises the full chain","type":"text"},{"text":" ","type":"text"},{"text":"in a unit test without mounting any SwiftUI host:","type":"text"}]},{"type":"codeListing","code":["@Test","@MainActor","func signUpCompletesOnboarding() {","    let store = FlowTestStore<AppRoute>(initial: [.push(.welcome)])","",