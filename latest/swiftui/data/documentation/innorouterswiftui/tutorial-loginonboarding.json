{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-loginonboarding"]}],"abstract":[{"text":"Compose push, sheet, and cover steps into a single serializable flow with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then let the signup "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}],"sections":[],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","interfaceLanguage":"swift"},"metadata":{"role":"article","roleHeading":"Article","title":"Building a Login Onboarding Flow","modules":[{"name":"InnoRouterTesting"}]},"schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"kind":"article","primaryContentSections":[{"content":[{"level":2,"text":"Scenario","type":"heading","anchor":"Scenario"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app launches on a welcome screen. Tapping "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Continue"}]},{"type":"text","text":" pushes a"},{"type":"text","text":" "},{"type":"text","text":"pre-auth detail screen. Tapping "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Create account"}]},{"type":"text","text":" presents a signup"},{"type":"text","text":" "},{"type":"text","text":"sheet. When the signup finishes (or is cancelled) the owning flow"},{"type":"text","text":" "},{"type":"text","text":"resumes — either navigating to "},{"type":"codeVoice","code":".home(user)"},{"type":"text","text":" or staying put."}]},{"type":"paragraph","inlineContent":[{"text":"Modeling this with raw ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" means two","type":"text"},{"text":" ","type":"text"},{"text":"authority objects, two view-layer hosts, and hand-rolled","type":"text"},{"text":" ","type":"text"},{"text":"continuation plumbing to surface the sheet result back to the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"owner. "},{"code":"FlowStore","type":"codeVoice"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"ChildCoordinator"},{"text":" collapse this to a single","type":"text"},{"text":" ","type":"text"},{"text":"store and one ","type":"text"},{"type":"codeVoice","code":"await"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This flow has crossed the macro-first local-stack boundary: push and modal"},{"type":"text","text":" "},{"type":"text","text":"state must share one externally owned, serializable authority. A push-only"},{"type":"text","text":" "},{"type":"text","text":"version should stay on "},{"code":"@Router","type":"codeVoice"},{"type":"text","text":" + "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":" instead."}]},{"level":2,"text":"Routes","type":"heading","anchor":"Routes"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["enum AppRoute: Route {","    case preAuth","    case signup","    case home(UserID)","}"]},{"anchor":"Wiring-the-flow-host","level":2,"type":"heading","text":"Wiring the flow host"},{"inlineContent":[{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" renders environment-free navigation and modal surfaces around one"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"text":", then publishes a unified router authority to its view subtree:","type":"text"}],"type":"paragraph"},{"code":["@main","struct DemoApp: App {","    @State private var onboarding = OnboardingCoordinator()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: onboarding.flowStore,","                destination: destination,","                root: {","                    WelcomeRootView {","                        Task { await onboarding.startSignUpFlow() }","                    }","                }","            )","        }","    }","","    @ViewBuilder","    private func destination(_ route: AppRoute) -> some View {","        switch route {","        case .preAuth:","            PreAuthDetailView()","        case .signup:","            if let signUp = onboarding.activeSignUp {","                SignUpView(coordinator: signUp)","            }","        case .home(let id):","            HomeView(userID: id)","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"anchor":"Emitting-intents-from-views","level":2,"type":"heading","text":"Emitting intents from views"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views never mutate "},{"code":"FlowStore.path","type":"codeVoice"},{"type":"text","text":" directly. They read typed actions from"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"text":"; the host projects those actions through ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"middleware and event observation see every step:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["struct WelcomeRootView: View {","    @EnvironmentRouter(AppRoute.self) private var router","    let startSignUp: @MainActor () -> Void","","    var body: some View {","        VStack {","            Button(\"Continue\") {","                router.go(.preAuth)","            }","            Button(\"Create account\") {","                startSignUp()","            }","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"router.send(flow:)"},{"type":"text","text":" only for flow-specific operations that do not have a"},{"type":"text","text":" "},{"type":"text","text":"focused action, such as resetting a complete "},{"type":"codeVoice","code":"RouteStep"},{"type":"text","text":" path."}]},{"anchor":"Awaiting-a-signup-sub-flow","type":"heading","level":2,"text":"Awaiting a signup sub-flow"},{"type":"paragraph","inlineContent":[{"text":"The signup sheet opens its own child coordinator that owns the step progression","type":"text"},{"text":" ","type":"text"},{"text":"(email → password → confirmation). The app-defined onboarding owner keeps that","type":"text"},{"text":" ","type":"text"},{"text":"child in presentation state, presents it through the same ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", then"},{"type":"text","text":" "},{"type":"codeVoice","code":"await"},{"type":"text","text":"s the final "},{"type":"codeVoice","code":"UserID"},{"text":" through ","type":"text"},{"code":"signUp.waitForResult()","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@MainActor","final class SignUpCoordinator: ChildCoordinator {","    typealias Result = UserID","","    var onFinish: (@MainActor @Sendable (UserID) -> Void)?","    var onCancel: (@MainActor @Sendable () -> Void)?","","    \/\/ ...step state + methods omitted","","    func userDidCreateAccount(_ userID: UserID) {","        onFinish?(userID)   \/\/ emits the result back to the owner","    }","","    func userCancelled() {","        onCancel?()          \/\/ the owner sees nil","    }","}","","@Observable","@MainActor","final class OnboardingCoordinator {","    let flowStore = FlowStore<AppRoute>()","","    \/\/ The sheet content observes this app-owned placement state.","    var activeSignUp: SignUpCoordinator?","","    func startSignUpFlow() async {","        guard activeSignUp == nil else { return }","","        let signUp = SignUpCoordinator()","        activeSignUp = signUp","        defer { activeSignUp = nil }","","        flowStore.send(.presentSheet(.signup))","        let result = await signUp.waitForResult()","        flowStore.send(.dismiss)","","        if let userID = result {","            flowStore.send(.push(.home(userID)))","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"activeSignUp"},{"type":"text","text":" determines which child the "},{"type":"codeVoice","code":".signup"},{"text":" destination renders;","type":"text"},{"text":" ","type":"text"},{"code":"flowStore","type":"codeVoice"},{"text":" remains the sole push-and-modal authority. ","type":"text"},{"code":"waitForResult()","type":"codeVoice"},{"text":" only","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"waits for a result and never presents the child. It installs the child’s "},{"type":"codeVoice","code":"onFinish"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"onCancel"},{"type":"text","text":" callbacks before its first suspension, so the child can emit a"},{"type":"text","text":" "},{"type":"text","text":"result at any point after the asynchronous call begins without a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"text","text":"re-entrancy deadlock. Cancelling the caller task that awaits "},{"type":"codeVoice","code":"waitForResult()"},{"type":"text","text":" "},{"type":"text","text":"resolves it with "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", invokes "},{"type":"codeVoice","code":"parentDidCancel()"},{"type":"text","text":", and runs the "},{"type":"codeVoice","code":"defer"},{"type":"text","text":" that"},{"type":"text","text":" "},{"type":"text","text":"clears the app-owned placement state. See"},{"type":"text","text":" "},{"type":"reference","identifier":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","isActive":true},{"type":"text","text":" "},{"type":"text","text":"for the design rationale."}]},{"type":"heading","anchor":"Verifying-the-flow-host-lessly","level":2,"text":"Verifying the flow host-lessly"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":") exercises the full chain"},{"type":"text","text":" "},{"type":"text","text":"in a unit test without mounting any SwiftUI host:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func signUpCompletesOnboarding() {","    let store = FlowTestStore<AppRoute>()","","    store.send(.presentSheet(.signup))","    store.receiveModal { if case .presented = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","","    store.send(.dismiss)","    store.receiveModal { if case .dismissed = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","}"]},{"anchor":"Next-steps","type":"heading","level":2,"text":"Next steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","type":"reference","isActive":true},{"type":"text","text":" to add analytics and"},{"type":"text","text":" "},{"text":"authentication gating to the same flow.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation"},{"type":"text","text":" to extend the host so a"},{"type":"text","text":" "},{"type":"text","text":"push-notification URL can drop the user directly into "},{"type":"codeVoice","code":".home"},{"type":"text","text":" "},{"type":"text","text":"state on launch."}]}]}]}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-DeepLinkReconciliation":{"title":"Reconciling Deep Links End-to-End","role":"article","abstract":[{"text":"Match a URL, apply an authentication policy, and produce a","type":"text"},{"text":" ","type":"text"},{"code":"NavigationPlan","type":"codeVoice"},{"text":" that ","type":"text"},{"code":"NavigationStore.executeBatch","type":"codeVoice"},{"text":" applies in one","type":"text"},{"text":" ","type":"text"},{"text":"observable step. Queue the deep link while the user is signed out,","type":"text"},{"text":" ","type":"text"},{"text":"replay it after sign-in, and surface cancellation reasons through","type":"text"},{"text":" ","type":"text"},{"text":"typed outcomes.","type":"text"}],"url":"\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","kind":"article","type":"topic"},"../../../../Docs/design-child-coordinator-handoff.md":{"titleInlineContent":[{"code":"Docs\/design-child-coordinator-handoff.md","type":"codeVoice"}],"identifier":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","url":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","type":"link","title":"Docs\/design-child-coordinator-handoff.md"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MiddlewareComposition":{"abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" and "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that pairs completion callbacks with the middlewares"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"code":"willExecute","type":"codeVoice"},{"type":"text","text":" hook actually ran."}],"kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition","title":"Composing Middleware Across Navigation and Modal","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"kind":"article","title":"InnoRouterSwiftUI","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting","type":"topic"}}}