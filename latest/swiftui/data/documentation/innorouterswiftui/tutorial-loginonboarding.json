{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Scenario","anchor":"Scenario","type":"heading"},{"inlineContent":[{"text":"The app launches on a welcome screen. Tapping ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Continue","type":"text"}]},{"text":" pushes a","type":"text"},{"text":" ","type":"text"},{"text":"pre-auth detail screen. Tapping ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"Create account","type":"text"}]},{"text":" presents a signup","type":"text"},{"text":" ","type":"text"},{"text":"sheet. When the signup finishes (or is cancelled) the owning flow","type":"text"},{"text":" ","type":"text"},{"text":"resumes — either navigating to ","type":"text"},{"code":".home(user)","type":"codeVoice"},{"text":" or staying put.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Modeling this with raw ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" means two","type":"text"},{"text":" ","type":"text"},{"text":"authority objects, two view-layer hosts, and hand-rolled","type":"text"},{"text":" ","type":"text"},{"text":"continuation plumbing to surface the sheet result back to the","type":"text"},{"text":" ","type":"text"},{"text":"owner. ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":" collapse this to a single","type":"text"},{"text":" ","type":"text"},{"text":"store and one ","type":"text"},{"code":"await","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"This flow has crossed the macro-first local-stack boundary: push and modal","type":"text"},{"text":" ","type":"text"},{"text":"state must share one externally owned, serializable authority. A push-only","type":"text"},{"text":" ","type":"text"},{"text":"version should stay on ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":" instead.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Routes","anchor":"Routes","type":"heading"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["enum AppRoute: Route {","    case preAuth","    case signup","    case home(UserID)","}"]},{"level":2,"text":"Wiring the flow host","anchor":"Wiring-the-flow-host","type":"heading"},{"inlineContent":[{"code":"FlowHost","type":"codeVoice"},{"text":" renders environment-free navigation and modal surfaces around one","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", then publishes a unified router authority to its view subtree:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@main","struct DemoApp: App {","    @State private var onboarding = OnboardingCoordinator()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: onboarding.flowStore,","                destination: destination,","                root: {","                    WelcomeRootView {","                        Task { await onboarding.startSignUpFlow() }","                    }","                }","            )","        }","    }","","    @ViewBuilder","    private func destination(_ route: AppRoute) -> some View {","        switch route {","        case .preAuth:","            PreAuthDetailView()","        case .signup:","            if let signUp = onboarding.activeSignUp {","                SignUpView(coordinator: signUp)","            }","        case .home(let id):","            HomeView(userID: id)","        }","    }","}"]},{"level":2,"text":"Emitting intents from views","anchor":"Emitting-intents-from-views","type":"heading"},{"inlineContent":[{"text":"Views never mutate ","type":"text"},{"code":"FlowStore.path","type":"codeVoice"},{"text":" directly. They read typed actions from","type":"text"},{"text":" ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":"; the host projects those actions through ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"text":"middleware and event observation see every step:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["struct WelcomeRootView: View {","    @EnvironmentRouter(AppRoute.self) private var router","    let startSignUp: @MainActor () -> Void","","    var body: some View {","        VStack {","            Button(\"Continue\") {","                router.go(.preAuth)","            }","            Button(\"Create account\") {","                startSignUp()","            }","        }","    }","}"]},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"router.send(flow:)","type":"codeVoice"},{"text":" only for flow-specific operations that do not have a","type":"text"},{"text":" ","type":"text"},{"text":"focused action, such as resetting a complete ","type":"text"},{"code":"RouteStep","type":"codeVoice"},{"text":" path.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Awaiting a signup sub-flow","anchor":"Awaiting-a-signup-sub-flow","type":"heading"},{"inlineContent":[{"text":"The signup sheet opens its own child coordinator that owns the step progression","type":"text"},{"text":" ","type":"text"},{"text":"(email → password → confirmation). The app-defined onboarding owner keeps that","type":"text"},{"text":" ","type":"text"},{"text":"child in presentation state, presents it through the same ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", then","type":"text"},{"text":" ","type":"text"},{"code":"await","type":"codeVoice"},{"text":"s the final ","type":"text"},{"code":"UserID","type":"codeVoice"},{"text":" through ","type":"text"},{"code":"signUp.waitForResult()","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@MainActor","final class SignUpCoordinator: ChildCoordinator {","    typealias Result = UserID","","    var onFinish: (@MainActor @Sendable (UserID) -> Void)?","    var onCancel: (@MainActor @Sendable () -> Void)?","","    \/\/ ...step state + methods omitted","","    func userDidCreateAccount(_ userID: UserID) {","        onFinish?(userID)   \/\/ emits the result back to the owner","    }","","    func userCancelled() {","        onCancel?()          \/\/ the owner sees nil","    }","}","","@Observable","@MainActor","final class OnboardingCoordinator {","    let flowStore = FlowStore<AppRoute>()","","    \/\/ The sheet content observes this app-owned placement state.","    var activeSignUp: SignUpCoordinator?","","    func startSignUpFlow() async {","        guard activeSignUp == nil else { return }","","        let signUp = SignUpCoordinator()","        activeSignUp = signUp","        defer { activeSignUp = nil }","","        flowStore.send(.presentSheet(.signup))","        let result = await signUp.waitForResult()","        flowStore.send(.dismiss)","","        if let userID = result {","            flowStore.send(.push(.home(userID)))","        }","    }","}"]},{"inlineContent":[{"code":"activeSignUp","type":"codeVoice"},{"text":" determines which child the ","type":"text"},{"code":".signup","type":"codeVoice"},{"text":" destination renders;","type":"text"},{"text":" ","type":"text"},{"code":"flowStore","type":"codeVoice"},{"text":" remains the sole push-and-modal authority. ","type":"text"},{"code":"waitForResult()","type":"codeVoice"},{"text":" only","type":"text"},{"text":" ","type":"text"},{"text":"waits for a result and never presents the child. It installs the child’s ","type":"text"},{"code":"onFinish","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"onCancel","type":"codeVoice"},{"text":" callbacks before its first suspension, so the child can emit a","type":"text"},{"text":" ","type":"text"},{"text":"result at any point after the asynchronous call begins without a ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" ","type":"text"},{"text":"re-entrancy deadlock. Cancelling the caller task that awaits ","type":"text"},{"code":"waitForResult()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"resolves it with ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", invokes ","type":"text"},{"code":"parentDidCancel()","type":"codeVoice"},{"text":", and runs the ","type":"text"},{"code":"defer","type":"codeVoice"},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"clears the app-owned placement state. See","type":"text"},{"text":" ","type":"text"},{"identifier":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"for the design rationale.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Verifying the flow host-lessly","anchor":"Verifying-the-flow-host-lessly","type":"heading"},{"inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"text":" (in ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":") exercises the full chain","type":"text"},{"text":" ","type":"text"},{"text":"in a unit test without mounting any SwiftUI host:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@Test","@MainActor","func signUpCompletesOnboarding() {","    let store = FlowTestStore<AppRoute>()","","    store.send(.presentSheet(.signup))","    store.receiveModal { if case .presented = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","","    store.send(.dismiss)","    store.receiveModal { if case .dismissed = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","}"]},{"level":2,"text":"Next steps","anchor":"Next-steps","type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","type":"reference","isActive":true},{"text":" to add analytics and","type":"text"},{"text":" ","type":"text"},{"text":"authentication gating to the same flow.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","type":"reference","isActive":true},{"text":" to extend the host so a","type":"text"},{"text":" ","type":"text"},{"text":"push-notification URL can drop the user directly into ","type":"text"},{"code":".home","type":"codeVoice"},{"text":" ","type":"text"},{"text":"state on launch.","type":"text"}],"type":"paragraph"}]}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},"metadata":{"role":"article","title":"Building a Login Onboarding Flow","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article"},"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-loginonboarding"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","sections":[],"abstract":[{"text":"Compose push, sheet, and cover steps into a single serializable flow with","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","cod