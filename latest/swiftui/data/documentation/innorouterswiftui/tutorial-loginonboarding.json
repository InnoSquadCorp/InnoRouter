{"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Scenario","anchor":"Scenario","type":"heading"},{"inlineContent":[{"text":"The app launches on a welcome screen. Tapping ","type":"text"},{"inlineContent":[{"type":"text","text":"Continue"}],"type":"emphasis"},{"text":" pushes a","type":"text"},{"text":" ","type":"text"},{"text":"pre-auth detail screen. Tapping ","type":"text"},{"inlineContent":[{"text":"Create account","type":"text"}],"type":"emphasis"},{"text":" presents a signup","type":"text"},{"text":" ","type":"text"},{"text":"sheet. When the signup finishes (or is cancelled) the owning flow","type":"text"},{"text":" ","type":"text"},{"text":"resumes — either navigating to ","type":"text"},{"type":"codeVoice","code":".home(user)"},{"text":" or staying put.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Modeling this with raw "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" means two"},{"type":"text","text":" "},{"type":"text","text":"authority objects, two view-layer hosts, and hand-rolled"},{"type":"text","text":" "},{"type":"text","text":"continuation plumbing to surface the sheet result back to the"},{"type":"text","text":" "},{"type":"text","text":"owner. "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" + "},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" collapse this to a single"},{"type":"text","text":" "},{"type":"text","text":"store and one "},{"code":"await","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This flow has crossed the macro-first local-stack boundary: push and modal"},{"type":"text","text":" "},{"type":"text","text":"state must share one externally owned, serializable authority. A push-only"},{"type":"text","text":" "},{"type":"text","text":"version should stay on "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" + "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":" instead."}]},{"level":2,"anchor":"Routes","text":"Routes","type":"heading"},{"type":"codeListing","code":["enum AppRoute: Route {","    case preAuth","    case signup","    case home(UserID)","}"],"syntax":"swift skip doc-fragment"},{"level":2,"anchor":"Wiring-the-flow-host","text":"Wiring the flow host","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" renders environment-free navigation and modal surfaces around one"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then publishes a unified router authority to its view subtree:"}]},{"code":["@main","struct DemoApp: App {","    @State private var onboarding = OnboardingCoordinator()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: onboarding.flowStore,","                destination: destination,","                root: {","                    WelcomeRootView {","                        Task { await onboarding.startSignUpFlow() }","                    }","                }","            )","        }","    }","","    @ViewBuilder","    private func destination(_ route: AppRoute) -> some View {","        switch route {","        case .preAuth:","            PreAuthDetailView()","        case .signup:","            if let signUp = onboarding.activeSignUp {","                SignUpView(coordinator: signUp)","            }","        case .home(let id):","            HomeView(userID: id)","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"anchor":"Emitting-intents-from-views","type":"heading","text":"Emitting intents from views","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Views never mutate "},{"type":"codeVoice","code":"FlowStore.path"},{"type":"text","text":" directly. They read typed actions from"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":"; the host projects those actions through "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", so"},{"type":"text","text":" "},{"type":"text","text":"middleware and event observation see every step:"}]},{"code":["struct WelcomeRootView: View {","    @EnvironmentRouter(AppRoute.self) private var router","    let startSignUp: @MainActor () -> Void","","    var body: some View {","        VStack {","            Button(\"Continue\") {","                router.go(.preAuth)","            }","            Button(\"Create account\") {","                startSignUp()","            }","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"router.send(flow:)"},{"text":" only for flow-specific operations that do not have a","type":"text"},{"text":" ","type":"text"},{"text":"focused action, such as resetting a complete ","type":"text"},{"type":"codeVoice","code":"RouteStep"},{"text":" path.","type":"text"}]},{"anchor":"Awaiting-a-signup-sub-flow","type":"heading","text":"Awaiting a signup sub-flow","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The signup sheet opens its own child coordinator that owns the step progression"},{"type":"text","text":" "},{"type":"text","text":"(email → password → confirmation). The app-defined onboarding owner keeps that"},{"type":"text","text":" "},{"type":"text","text":"child in presentation state, presents it through the same "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then"},{"type":"text","text":" "},{"type":"codeVoice","code":"await"},{"type":"text","text":"s the final "},{"type":"codeVoice","code":"UserID"},{"type":"text","text":" through "},{"type":"codeVoice","code":"signUp.waitForResult()"},{"type":"text","text":":"}]},{"code":["@MainActor","final class SignUpCoordinator: ChildCoordinator {","    typealias Result = UserID","","    var onFinish: (@MainActor @Sendable (UserID) -> Void)?","    var onCancel: (@MainActor @Sendable () -> Void)?","","    \/\/ ...step state + methods omitted","","    func userDidCreateAccount(_ userID: UserID) {","        onFinish?(userID)   \/\/ emits the result back to the owner","    }","","    func userCancelled() {","        onCancel?()          \/\/ the owner sees nil","    }","}","","@Observable","@MainActor","final class OnboardingCoordinator {","    let flowStore = FlowStore<AppRoute>()","","    \/\/ The sheet content observes this app-owned placement state.","    var activeSignUp: SignUpCoordinator?","","    func startSignUpFlow() async {","        guard activeSignUp == nil else { return }","","        let signUp = SignUpCoordinator()","        activeSignUp = signUp","        defer { activeSignUp = nil }","","        flowStore.send(.presentSheet(.signup))","        let result = await signUp.waitForResult()","        flowStore.send(.dismiss)","","        if let userID = result {","            flowStore.send(.push(.home(userID)))","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"activeSignUp"},{"type":"text","text":" determines which child the "},{"type":"codeVoice","code":".signup"},{"type":"text","text":" destination renders;"},{"type":"text","text":" "},{"type":"codeVoice","code":"flowStore"},{"type":"text","text":" remains the sole push-and-modal authority. "},{"type":"codeVoice","code":"waitForResult()"},{"type":"text","text":" only"},{"type":"text","text":" "},{"type":"text","text":"waits for a result and never presents the child. It installs the child’s "},{"type":"codeVoice","code":"onFinish"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"onCancel"},{"type":"text","text":" callbacks before its first suspension, so the child can emit a"},{"type":"text","text":" "},{"type":"text","text":"result at any point after the asynchronous call begins without a "},{"type":"codeVoice","code":"@MainActor"},{"type":"text","text":" "},{"type":"text","text":"re-entrancy deadlock. Cancelling the caller task that awaits "},{"type":"codeVoice","code":"waitForResult()"},{"text":" ","type":"text"},{"text":"resolves it with ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", invokes ","type":"text"},{"code":"parentDidCancel()","type":"codeVoice"},{"text":", and runs the ","type":"text"},{"code":"defer","type":"codeVoice"},{"text":" that","type":"text"},{"text":" ","type":"text"},{"text":"clears the app-owned placement state. See","type":"text"},{"text":" ","type":"text"},{"identifier":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","type":"reference","isActive":true},{"text":" ","type":"text"},{"text":"for the design rationale.","type":"text"}]},{"text":"Verifying the flow host-lessly","type":"heading","anchor":"Verifying-the-flow-host-lessly","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"InnoRouterTesting"},{"text":") exercises the full chain","type":"text"},{"text":" ","type":"text"},{"text":"in a unit test without mounting any SwiftUI host:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func signUpCompletesOnboarding() {","    let store = FlowTestStore<AppRoute>()","","    store.send(.presentSheet(.signup))","    store.receiveModal { if case .presented = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","","    store.send(.dismiss)","    store.receiveModal { if case .dismissed = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","}"]},{"text":"Next steps","type":"heading","anchor":"Next-steps","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},{"type":"text","text":" to add analytics and"},{"type":"text","text":" "},{"type":"text","text":"authentication gating to the same flow."}]}]},{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation"},{"text":" to extend the host so a","type":"text"},{"text":" ","type":"text"},{"text":"push-notification URL can drop the user directly into ","type":"text"},{"code":".home","type":"codeVoice"},{"text":" ","type":"text"},{"text":"state on launch.","type":"text"}],"type":"paragraph"}]}]}]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then let the signup "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" expose its result directly"},{"text":" ","type":"text"},{"text":"to the same app-defined flow owner.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-loginonboarding"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/doc