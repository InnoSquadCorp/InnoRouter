{"kind":"article","schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-loginonboarding"]}],"sections":[],"abstract":[{"text":"Compose push, sheet, and cover steps into a single serializable flow with ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":", then scope the signup sub-flow through a ","type":"text"},{"type":"codeVoice","code":"ChildCoordinator"},{"text":" and await its result inline.","type":"text"}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"InnoRouterTesting"}],"title":"Building a Login Onboarding Flow"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Scenario","anchor":"Scenario","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The app launches on a welcome screen. Tapping "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Continue"}]},{"type":"text","text":" pushes a"},{"type":"text","text":" "},{"type":"text","text":"pre-auth detail screen. Tapping "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Create account"}]},{"type":"text","text":" presents a signup"},{"type":"text","text":" "},{"type":"text","text":"sheet. When the signup finishes (or is cancelled) the parent flow"},{"type":"text","text":" "},{"type":"text","text":"resumes — either navigating to "},{"type":"codeVoice","code":".home(user)"},{"type":"text","text":" or staying put."}]},{"inlineContent":[{"type":"text","text":"Modeling this with raw "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" means two"},{"type":"text","text":" "},{"type":"text","text":"authority objects, two view-layer hosts, and hand-rolled"},{"type":"text","text":" "},{"type":"text","text":"continuation plumbing to surface the sheet result back to the"},{"type":"text","text":" "},{"type":"text","text":"parent. "},{"code":"FlowStore","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":" collapse this to a single","type":"text"},{"text":" ","type":"text"},{"text":"store and one ","type":"text"},{"code":"await","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Routes","type":"heading","text":"Routes"},{"syntax":"swift skip doc-fragment","code":["enum AppRoute: Route {","    case welcome","    case preAuth","    case signup","    case home(UserID)","}"],"type":"codeListing"},{"level":2,"anchor":"Wiring-the-flow-host","type":"heading","text":"Wiring the flow host"},{"inlineContent":[{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" composes an inner "},{"type":"codeVoice","code":"ModalHost"},{"type":"text","text":" over a "},{"type":"codeVoice","code":"NavigationHost"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"exposes both authorities through a single "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@main","struct DemoApp: App {","    @State private var flow = FlowStore<AppRoute>(initial: [.push(.welcome)])","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: flow,","                destination: destination,","                root: { WelcomeRootView() }","            )","        }","    }","","    @ViewBuilder","    private func destination(_ route: AppRoute) -> some View {","        switch route {","        case .welcome:","            WelcomeRootView()","        case .preAuth:","            PreAuthDetailView()","        case .signup:","            SignUpView()","        case .home(let id):","            HomeView(userID: id)","        }","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Emitting-intents-from-views","type":"heading","text":"Emitting intents from views"},{"inlineContent":[{"type":"text","text":"Views never mutate "},{"code":"FlowStore.path","type":"codeVoice"},{"type":"text","text":" directly; they emit"},{"type":"text","text":" "},{"code":"FlowIntent","type":"codeVoice"},{"type":"text","text":" values through the environment dispatcher so"},{"type":"text","text":" "},{"type":"text","text":"middleware and telemetry observe every step:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["struct WelcomeRootView: View {","    @EnvironmentFlowIntent<AppRoute> private var flow","","    var body: some View {","        VStack {","            Button(\"Continue\") {","                flow.send(.push(.preAuth))","            }","            Button(\"Create account\") {","                flow.send(.presentSheet(.signup))","            }","        }","    }","}"],"type":"codeListing"},{"level":2,"text":"Awaiting a signup sub-flow","type":"heading","anchor":"Awaiting-a-signup-sub-flow"},{"inlineContent":[{"type":"text","text":"The signup sheet opens its own "},{"type":"codeVoice","code":"Coordinator"},{"type":"text","text":" that owns the step"},{"type":"text","text":" "},{"type":"text","text":"progression (email → password → confirmation). The outer"},{"type":"text","text":" "},{"type":"text","text":"onboarding coordinator launches it via "},{"type":"codeVoice","code":"push(child:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"await"},{"type":"text","text":"s"},{"type":"text","text":" "},{"type":"text","text":"the final "},{"type":"codeVoice","code":"UserID"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["@MainActor","final class SignUpCoordinator: ChildCoordinator {","    typealias Result = UserID","    typealias RouteType = AppRoute","","    \/\/ ...step state + methods omitted","","    func userDidCreateAccount(_ userID: UserID) {","        onFinish(userID)   \/\/ emits the result back to the parent","    }","","    func userCancelled() {","        onCancel()          \/\/ parent sees nil","    }","}","","@MainActor","final class OnboardingCoordinator: Coordinator {","    typealias RouteType = AppRoute","    let navigationStore: NavigationStore<AppRoute>","","    func startSignUpFlow() async {","        let result = await push(child: SignUpCoordinator())","        if let userID = result {","            navigationStore.send(.go(.home(userID)))","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"code":"push(child:)","type":"codeVoice"},{"text":" installs the child’s ","type":"text"},{"code":"onFinish","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"onCancel","type":"codeVoice"},{"text":" ","type":"text"},{"text":"callbacks synchronously, so the child can emit a result at any","type":"text"},{"text":" ","type":"text"},{"text":"point — even before the parent’s ","type":"text"},{"code":"await","type":"codeVoice"},{"text":" suspends — without a","type":"text"},{"text":" ","type":"text"},{"code":"@MainActor","type":"codeVoice"},{"text":" re-entrancy deadlock. See","type":"text"},{"text":" ","type":"text"},{"identifier":"..\/..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","isActive":true,"type":"reference"},{"text":" ","type":"text"},{"text":"for the design rationale.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Verifying the flow host-lessly","type":"heading","anchor":"Verifying-the-flow-host-lessly"},{"inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"text":" (in ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":") exercises the full chain","type":"text"},{"text":" ","type":"text"},{"text":"in a unit test without mounting any SwiftUI host:","type":"text"}],"type":"paragraph"},{"code":["@Test","@MainActor","func signUpCompletesOnboarding() {","    let store = FlowTestStore<AppRoute>(initial: [.push(.welcome)])","","    store.send(.presentSheet(.signup))","    store.receiveModal { if case .presented = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","","    store.send(.dismiss)","    store.receiveModal { if case .dismissed = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"level":2,"text":"Next steps","type":"heading","anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition"},{"type":"text","text":" to add analytics and"},{"type":"text","text":" "},{"type":"text","text":"authentication gating to the same flow."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","isActive":true,"type":"reference"},{"type":"text","text":" to extend the host so a"},{"type":"text","text":" "},{"type":"text","text":"push-notification URL can drop the user directly into "},{"code":".home","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"state on launch."}]}]}]}]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"type":"topic","abstract":[{"text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter.","type":"text"}],"title":"InnoRouterSwiftUI","kind":"article","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"../../../../../Docs/design-child-coordinator-handoff.md":{"titleInlineContent":[{"type":"codeVoice","code":"Docs\/design-child-coordinator-handoff.md"}],"url":"..\/..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","type":"link","identifier":"..\/..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","title":"Docs\/design-child-coordinator-handoff.md"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","abstract":[],"type":"topic","url":"\/documentation\/innoroutertesting","role":"collection","kind":"symbol"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-DeepLinkReconciliation":{"url":"\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","title":"Reconciling Deep Links End-to-End","role":"article","kind":"article","type":"topic","abstract":[{"type":"text","text":"Match a URL, apply an authentication policy, and produce a"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":" that "},{"type":"codeVoice","code":"NavigationStore.executeBatch"},{"type":"text","text":" applies in one"},{"type":"text","text":" "},{"type":"text","text":"observable step. Queue the deep link while the user is signed out,"},{"type":"text","text":" "},{"type":"text","text":"replay it after sign-in, and surface cancellation reasons through"},{"type":"text","text":" "},{"type":"text","text":"typed outcomes."}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MiddlewareComposition":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that guarantees "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" only runs for middlewares"},{"type":"text","text":" "},{"type":"text","text":"that accepted the command."}],"type":"topic","url":"\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition","kind":"article","title":"Composing Middleware Across Navigation and Modal","role":"article"}}}