{"kind":"article","identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-loginonboarding"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article","title":"Building a Login Onboarding Flow"},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"text":"Scenario","level":2,"anchor":"Scenario","type":"heading"},{"inlineContent":[{"type":"text","text":"The app launches on a welcome screen. Tapping "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Continue"}]},{"type":"text","text":" pushes a"},{"type":"text","text":" "},{"type":"text","text":"pre-auth detail screen. Tapping "},{"type":"emphasis","inlineContent":[{"type":"text","text":"Create account"}]},{"type":"text","text":" presents a signup"},{"type":"text","text":" "},{"type":"text","text":"sheet. When the signup finishes (or is cancelled) the owning flow"},{"type":"text","text":" "},{"type":"text","text":"resumes — either navigating to "},{"type":"codeVoice","code":".home(user)"},{"type":"text","text":" or staying put."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Modeling this with raw "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" + "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" means two"},{"type":"text","text":" "},{"text":"authority objects, two view-layer hosts, and hand-rolled","type":"text"},{"text":" ","type":"text"},{"text":"continuation plumbing to surface the sheet result back to the","type":"text"},{"text":" ","type":"text"},{"text":"owner. ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":" collapse this to a single","type":"text"},{"text":" ","type":"text"},{"text":"store and one ","type":"text"},{"code":"await","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"This flow has crossed the macro-first local-stack boundary: push and modal","type":"text"},{"text":" ","type":"text"},{"text":"state must share one externally owned, serializable authority. A push-only","type":"text"},{"text":" ","type":"text"},{"text":"version should stay on ","type":"text"},{"type":"codeVoice","code":"@Router"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"text":" instead.","type":"text"}]},{"level":2,"type":"heading","text":"Routes","anchor":"Routes"},{"type":"codeListing","code":["enum AppRoute: Route {","    case preAuth","    case signup","    case home(UserID)","}"],"syntax":"swift skip doc-fragment"},{"text":"Wiring the flow host","type":"heading","level":2,"anchor":"Wiring-the-flow-host"},{"inlineContent":[{"code":"FlowHost","type":"codeVoice"},{"text":" renders environment-free navigation and modal surfaces around one","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", then publishes a unified router authority to its view subtree:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@main","struct DemoApp: App {","    @State private var onboarding = OnboardingCoordinator()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: onboarding.flowStore,","                destination: destination,","                root: {","                    WelcomeRootView {","                        Task { await onboarding.startSignUpFlow() }","                    }","                }","            )","        }","    }","","    @ViewBuilder","    private func destination(_ route: AppRoute) -> some View {","        switch route {","        case .preAuth:","            PreAuthDetailView()","        case .signup:","            if let signUp = onboarding.activeSignUp {","                SignUpView(coordinator: signUp)","            }","        case .home(let id):","            HomeView(userID: id)","        }","    }","}"]},{"anchor":"Emitting-intents-from-views","text":"Emitting intents from views","type":"heading","level":2},{"inlineContent":[{"text":"Views never mutate ","type":"text"},{"type":"codeVoice","code":"FlowStore.path"},{"text":" directly. They read typed actions from","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@EnvironmentRouter"},{"text":"; the host projects those actions through ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":", so","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"middleware and event observation see every step:"}],"type":"paragraph"},{"code":["struct WelcomeRootView: View {","    @EnvironmentRouter(AppRoute.self) private var router","    let startSignUp: @MainActor () -> Void","","    var body: some View {","        VStack {","            Button(\"Continue\") {","                router.go(.preAuth)","            }","            Button(\"Create account\") {","                startSignUp()","            }","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"router.send(flow:)"},{"type":"text","text":" only for flow-specific operations that do not have a"},{"type":"text","text":" "},{"type":"text","text":"focused action, such as resetting a complete "},{"type":"codeVoice","code":"RouteStep"},{"type":"text","text":" path."}]},{"type":"heading","text":"Awaiting a signup sub-flow","anchor":"Awaiting-a-signup-sub-flow","level":2},{"inlineContent":[{"type":"text","text":"The signup sheet opens its own child coordinator that owns the step progression"},{"type":"text","text":" "},{"text":"(email → password → confirmation). The app-defined onboarding owner keeps that","type":"text"},{"type":"text","text":" "},{"text":"child in presentation state, presents it through the same ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", then","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"await"},{"type":"text","text":"s the final "},{"type":"codeVoice","code":"UserID"},{"type":"text","text":" through "},{"code":"signUp.waitForResult()","type":"codeVoice"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["@MainActor","final class SignUpCoordinator: ChildCoordinator {","    typealias Result = UserID","","    var onFinish: (@MainActor @Sendable (UserID) -> Void)?","    var onCancel: (@MainActor @Sendable () -> Void)?","","    \/\/ ...step state + methods omitted","","    func userDidCreateAccount(_ userID: UserID) {","        onFinish?(userID)   \/\/ emits the result back to the owner","    }","","    func userCancelled() {","        onCancel?()          \/\/ the owner sees nil","    }","}","","@Observable","@MainActor","final class OnboardingCoordinator {","    let flowStore = FlowStore<AppRoute>()","","    \/\/ The sheet content observes this app-owned placement state.","    var activeSignUp: SignUpCoordinator?","","    func startSignUpFlow() async {","        guard activeSignUp == nil else { return }","","        let signUp = SignUpCoordinator()","        activeSignUp = signUp","        defer { activeSignUp = nil }","","        flowStore.send(.presentSheet(.signup))","        let result = await signUp.waitForResult()","        flowStore.send(.dismiss)","","        if let userID = result {","            flowStore.send(.push(.home(userID)))","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"activeSignUp"},{"text":" determines which child the ","type":"text"},{"type":"codeVoice","code":".signup"},{"text":" destination renders;","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"flowStore"},{"type":"text","text":" remains the sole push-and-modal authority. "},{"type":"codeVoice","code":"waitForResult()"},{"type":"text","text":" only"},{"text":" ","type":"text"},{"type":"text","text":"waits for a result and never presents the child. It installs the child’s "},{"type":"codeVoice","code":"onFinish"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"onCancel"},{"type":"text","text":" callbacks before its first suspension, so the child can emit a"},{"type":"text","text":" "},{"type":"text","text":"result at any point after the asynchronous call begins without a "},{"type":"codeVoice","code":"@MainActor"},{"text":" ","type":"text"},{"type":"text","text":"re-entrancy deadlock. Cancelling the caller task that awaits "},{"type":"codeVoice","code":"waitForResult()"},{"text":" ","type":"text"},{"type":"text","text":"resolves it with "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", invokes "},{"type":"codeVoice","code":"parentDidCancel()"},{"text":", and runs the ","type":"text"},{"code":"defer","type":"codeVoice"},{"type":"text","text":" that"},{"text":" ","type":"text"},{"type":"text","text":"clears the app-owned placement state. See"},{"type":"text","text":" "},{"identifier":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","type":"reference","isActive":true},{"type":"text","text":" "},{"type":"text","text":"for the design rationale."}]},{"anchor":"Verifying-the-flow-host-lessly","type":"heading","level":2,"text":"Verifying the flow host-lessly"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" (in "},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":") exercises the full chain","type":"text"},{"type":"text","text":" "},{"type":"text","text":"in a unit test without mounting any SwiftUI host:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@Test","@MainActor","func signUpCompletesOnboarding() {","    let store = FlowTestStore<AppRoute>()","","    store.send(.presentSheet(.signup))","    store.receiveModal { if case .presented = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","","    store.send(.dismiss)","    store.receiveModal { if case .dismissed = $0 { return true }; return false }","    store.receiveModal { if case .commandIntercepted = $0 { return true }; return false }","    store.receivePathChanged()","}"]},{"anchor":"Next-steps","level":2,"text":"Next steps","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","type":"reference"},{"type":"text","text":" to add analytics and"},{"text":" ","type":"text"},{"text":"authentication gating to the same flow.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","isActive":true,"type":"reference"},{"type":"text","text":" to extend the host so a"},{"type":"text","text":" "},{"type":"text","text":"push-notification URL can drop the user directly into "},{"type":"codeVoice","code":".home"},{"text":" ","type":"text"},{"text":"state on launch.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", then let the signup "},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-DeepLinkReconciliation":{"title":"Reconciling Deep Links End-to-End","abstract":[{"type":"text","text":"Match a URL, apply an authentication policy, and produce a"},{"type":"text","text":" "},{"code":"NavigationPlan","type":"codeVoice"},{"type":"text","text":" that "},{"code":"NavigationStore.executeBatch","type":"codeVoice"},{"type":"text","text":" applies in one"},{"type":"text","text":" "},{"type":"text","text":"observable step. Queue the deep link while the user is signed out,"},{"type":"text","text":" "},{"type":"text","text":"replay it after sign-in, and surface cancellation reasons through"},{"type":"text","text":" "},{"type":"text","text":"typed outcomes."}],"url":"\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation","kind":"article","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","role":"article"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","kind":"article","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"text":" ","type":"text"},{"text":"coordinators, and typed ","type":"text"},{"type":"codeVoice","code":"EnvironmentRouter"},{"text":" actions for InnoRouter.","type":"text"}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","abstract":[],"role":"collection"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MiddlewareComposition":{"kind":"article","abstract":[{"type":"text","text":"Install logging, entitlement gating, and analytics middleware on"},{"type":"text","text":" "},{"type":"text","text":"both "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" and "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":". Inspect the participant"},{"type":"text","text":" "},{"type":"text","text":"discipline that pairs completion callbacks with the middlewares"},{"type":"text","text":" "},{"type":"text","text":"whose "},{"type":"codeVoice","code":"willExecute"},{"type":"text","text":" hook actually ran."}],"url":"\/documentation\/innorouterswiftui\/tutorial-middlewarecomposition","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MiddlewareComposition","title":"Composing Middleware Across Navigation and Modal","role":"article","type":"topic"},"../../../../Docs/design-child-coordinator-handoff.md":{"type":"link","url":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md","title":"Docs\/design-child-coordinator-handoff.md","titleInlineContent":[{"code":"Docs\/design-child-coordinator-handoff.md","type":"codeVoice"}],"identifier":"..\/..\/..\/..\/Docs\/design-child-coordinator-handoff.md"}}}