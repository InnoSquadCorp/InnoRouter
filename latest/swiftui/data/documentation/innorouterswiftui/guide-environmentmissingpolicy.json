{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Guide-EnvironmentMissingPolicy"},"primaryContentSections":[{"content":[{"type":"heading","anchor":"The-three-policies","level":2,"text":"The three policies"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Policy","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Debug"}]}],[{"type":"paragraph","inlineContent":[{"text":"Release","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"When to use","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".crash","type":"codeVoice"}]}],[{"inlineContent":[{"type":"codeVoice","code":"preconditionFailure"}],"type":"paragraph"}],[{"inlineContent":[{"code":"preconditionFailure","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"App code where missing wiring is always a bug. Default."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".logAndDegrade"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Logger.error"},{"type":"text","text":" + skipped action"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Logger.error"},{"text":" + skipped action","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"SwiftUI Previews, host-less snapshot tests, and similar out-of-app rendering paths."}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".assertAndLog"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"Logger.error"},{"type":"text","text":" + "},{"type":"codeVoice","code":"assertionFailure"}],"type":"paragraph"}],[{"inlineContent":[{"code":"Logger.error","type":"codeVoice"},{"text":" + skipped action","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Pre-launch production builds where you want loud signal during development without paging users on a stray missing host."}],"type":"paragraph"}]]]},{"text":"Selecting one","level":2,"type":"heading","anchor":"Selecting-one"},{"inlineContent":[{"type":"text","text":"Pick the narrowest policy that still surfaces wiring bugs at the"},{"type":"text","text":" "},{"type":"text","text":"right time:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Default app code","type":"text"}]},{"type":"text","text":" stays on "},{"type":"codeVoice","code":".crash"},{"type":"text","text":". The first router action attempted"},{"type":"text","text":" "},{"type":"text","text":"without its matching host fails loudly — exactly the behaviour you want once"},{"type":"text","text":" "},{"type":"text","text":"a real user is running the build."}]}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"code":"#Preview","type":"codeVoice"},{"text":" blocks","type":"text"}]},{"type":"text","text":" use "},{"type":"codeVoice","code":".logAndDegrade"},{"type":"text","text":". Previews routinely"},{"type":"text","text":" "},{"type":"text","text":"render leaf views without their hosts; the unavailable action is skipped so"},{"type":"text","text":" "},{"type":"text","text":"the canvas stays alive, while the logged error still surfaces in the Xcode"},{"type":"text","text":" "},{"type":"text","text":"console."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"TestFlight \/ pre-launch builds"}]},{"type":"text","text":" can adopt "},{"type":"codeVoice","code":".assertAndLog"},{"type":"text","text":" "},{"type":"text","text":"from a single ship config. Engineers see "},{"type":"codeVoice","code":"assertionFailure"},{"type":"text","text":" "},{"type":"text","text":"traps locally, but a testflight tester does not get a crash"},{"type":"text","text":" "},{"type":"text","text":"dialog if a stray screen forgets its host."}]}]}],"type":"unorderedList"},{"level":2,"type":"heading","text":"How to apply it","anchor":"How-to-apply-it"},{"inlineContent":[{"type":"text","text":"Use the "},{"type":"codeVoice","code":"innoRouterEnvironmentMissingPolicy(_:)"},{"type":"text","text":" view modifier at"},{"type":"text","text":" "},{"type":"text","text":"the boundary where the policy applies — usually one level above"},{"type":"text","text":" "},{"type":"text","text":"the offending view tree."}],"type":"paragraph"},{"type":"codeListing","code":["#Preview {","    SettingsView()","        .innoRouterEnvironmentMissingPolicy(.logAndDegrade)","}"],"syntax":"swift skip doc-fragment"},{"type":"codeListing","code":["@main","struct AppEntry: App {","    var body: some Scene {","        WindowGroup {","            RootView()","                #if PRELAUNCH","                .innoRouterEnvironmentMissingPolicy(.assertAndLog)","                #endif","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"The setting flows through the environment, so a single modifier covers every"},{"type":"text","text":" "},{"type":"text","text":"nested "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" it contains, including navigation, modal, flow,"},{"type":"text","text":" "},{"type":"text","text":"and tab actions."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Why `.assertAndLog` is not the new default","anchor":"Why-assertAndLog-is-not-the-new-default"},{"inlineContent":[{"type":"text","text":"Switching the default to "},{"type":"codeVoice","code":".assertAndLog"},{"type":"text","text":" would silently soften"},{"type":"text","text":" "},{"type":"text","text":"production behaviour for every existing adopter. "},{"type":"codeVoice","code":".crash"},{"type":"text","text":" stays"},{"type":"text","text":" "},{"type":"text","text":"the default to preserve the loud-by-default contract; opt in to"},{"type":"text","text":" "},{"type":"text","text":"the gentler policies at the boundary where they actually fit."}],"type":"paragraph"}],"kind":"content"}],"kind":"article","metadata":{"title":"Choosing an `EnvironmentMissingPolicy`","role":"article","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/guide-environmentmissingpolicy"]}],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" resolves typed navigation, modal, flow, and tab authority"},{"type":"text","text":" "},{"type":"text","text":"through the SwiftUI environment. Focused methods cover common actions;"},{"type":"text","text":" "},{"type":"codeVoice","code":"router.send(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"router.send(flow:)"},{"type":"text","text":" cover explicit intent values. When"},{"type":"text","text":" "},{"type":"text","text":"the matching host is missing, "},{"type":"codeVoice","code":"EnvironmentMissingPolicy"},{"type":"text","text":" decides whether to"},{"type":"text","text":" "},{"type":"text","text":"crash, log, or both."}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","type":"topic","title":"InnoRou