{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"title":"Reconciling Deep Links End-to-End","role":"article"},"abstract":[{"text":"Match a URL, apply an authentication policy, and produce a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationPlan"},{"text":" that ","type":"text"},{"type":"codeVoice","code":"NavigationStore.executeBatch"},{"text":" applies in one","type":"text"},{"text":" ","type":"text"},{"text":"observable step. Queue the deep link while the user is signed out,","type":"text"},{"text":" ","type":"text"},{"text":"replay it after sign-in, and surface cancellation reasons through","type":"text"},{"text":" ","type":"text"},{"text":"typed outcomes.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","sections":[],"primaryContentSections":[{"content":[{"anchor":"Scenario","level":2,"text":"Scenario","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"myapp:\/\/app\/order\/42","type":"codeVoice"},{"text":" should land the user on the order detail for","type":"text"},{"text":" ","type":"text"},{"text":"order 42, but only when they’re signed in. If the link arrives","type":"text"},{"text":" ","type":"text"},{"text":"while signed out, the app must remember it, route through the","type":"text"},{"type":"text","text":" "},{"text":"sign-in flow, and then replay it — without dropping the original","type":"text"},{"type":"text","text":" "},{"type":"text","text":"URL context."}]},{"type":"paragraph","inlineContent":[{"text":"This tutorial intentionally uses an externally owned ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"deep-link effect handler must apply plans outside the SwiftUI host. A local","type":"text"},{"type":"text","text":" "},{"type":"text","text":"single-route feature should start with "},{"code":"@Router","type":"codeVoice"},{"type":"text","text":" + "},{"code":"@DeepLink","type":"codeVoice"},{"type":"text","text":" + "},{"code":"RouterHost","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which installs incoming-URL handling automatically. Promote to this shape when"},{"text":" ","type":"text"},{"type":"text","text":"authentication, pending replay, multi-step plans, restoration, or direct"},{"text":" ","type":"text"},{"text":"effect-handler ownership needs the authority.","type":"text"}]},{"type":"heading","text":"Modeling the routes","level":2,"anchor":"Modeling-the-routes"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["\/\/ This host-independent excerpt uses plain Route conformance. Add @Router and","\/\/ a destination property when this same enum also owns SwiftUI rendering.","enum AppRoute: Route {","    case home","    case signIn","    case order(id: String)","}"]},{"text":"Wiring the pipeline","anchor":"Wiring-the-pipeline","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"DeepLinkPipeline"},{"text":" owns the validate-then-match-then-authorize flow. Pass the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"matcher directly so matcher input-limit failures remain typed rejections:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["import Synchronization","","let authentication = Mutex(false)","let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/home\") { _ in .home }","    DeepLinkMapping(\"\/signin\") { _ in .signIn }","    DeepLinkMapping(\"\/order\/:id\") { parameters in","        guard let id = parameters.firstValue(forName: \"id\") else { return nil }","        return .order(id: id)","    }","}","","let policy = DeepLinkAuthenticationPolicy<AppRoute>.required(","    shouldRequireAuthentication: { route in","        if case .order = route { return true }","        return false","    },","    isAuthenticated: { authentication.withLock { $0 } }",")","","let pipeline = DeepLinkPipeline(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    matcher: matcher,","    authenticationPolicy: policy",")"],"type":"codeListing"},{"level":2,"anchor":"Handling-a-URL","type":"heading","text":"Handling a URL"},{"inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DeepLinkEffectHandler"},{"type":"text","text":" bridges the pipeline output into"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let store = NavigationStore<AppRoute>()","let effectHandler = DeepLinkEffectHandler(","    navigator: store,","    matcher: matcher,","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    authenticationPolicy: policy",")","","func handle(_ url: URL) {","    switch effectHandler.handle(url) {","    case .executed:","        break \/\/ The validated NavigationPlan has already been applied.","    case .executionFailed(_, let batch):","        Log.warning(\"deep-link batch failed after \\(batch.executedCommands.count) attempted commands\")","    case .pending:","        _ = store.execute(.push(.signIn))","    case .applicationRejected(_, let failure):","        Log.warning(\"deep-link plan rejected: \\(failure)\")","    case .rejected(let reason):","        Log.warning(\"deep link rejected: \\(reason)\")","    case .unhandled(let url):","        Log.warning(\"deep link unhandled: \\(url)\")","    case .invalidURL, .missingDeepLinkURL, .noPendingDeepLink:","        break","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"text":"Replaying after sign-in","type":"heading","anchor":"Replaying-after-sign-in","level":2},{"type":"paragraph","inlineContent":[{"text":"Once the user signs in, the handler resumes any queued deep link:","type":"text"}]},{"type":"codeListing","code":["func userDidSignIn() {","    authentication.withLock { $0 = true }","    _ = effectHandler.resumePendingDeepLink()","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"The handler consults the retained ","type":"text"},{"code":"PendingDeepLink","type":"codeVoice"},{"text":", re-evaluates","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the authentication policy, and only commits the batch if the new"},{"type":"text","text":" "},{"text":"state now permits the original URL. Any stale pending link (one","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the user cancelled or that no longer validates) is dropped."}]},{"text":"Observing the reconciliation","level":2,"type":"heading","anchor":"Observing-the-reconciliation"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore.events"},{"type":"text","text":" exposes the full sequence of batch +"},{"text":" ","type":"text"},{"type":"text","text":"path-mismatch events as a single stream, which is handy for"},{"type":"text","text":" "},{"type":"text","text":"diagnostics dashboards. Capture the stream before starting its lifecycle-owned"},{"type":"text","text":" "},{"type":"text","text":"task so the subscriber is registered before any immediate reconciliation"},{"text":" ","type":"text"},{"type":"text","text":"command:"}]},{"code":["let events = store.events","let observationTask = Task { @MainActor in","    for await event in events {","        switch event {","        case .batchExecuted(let result):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .pathMismatch(let event):","            analytics.track(\"deep_link_mismatch\", [","                \"policy\": event.policy.rawValue,","                \"old\": event.oldPath.map(String.init(describing:)),","                \"new\": event.newPath.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"text":"Testing the chain","type":"heading","level":2,"anchor":"Testing-the-chain"},{"inlineContent":[{"code":"NavigationTestStore","type":"codeVoice"},{"text":" (in ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":") asserts the batch +","type":"text"},{"text":" ","type":"text"},{"text":"side effects for each branch:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func signedOutDeepLinkDefersUntilSignIn() {","    let store = NavigationTestStore<AppRoute>()","    let handler = DeepLinkEffectHandler(","        navigator: store.store,","        matcher: matcher,","        authenticationPolicy: policy","    )","","    let result = handler.handle(URL(string: \"myapp:\/\/app\/order\/42\")!)","","    #expect(result == .pending(handler.pendingDeepLink!))","    #expect(store.state.path.isEmpty)","    store.finish()","}"],"type":"codeListing"},{"type":"heading","level":2,"text":"Next steps","anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Read "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","isActive":true,"type":"reference"},{"type":"text","text":" for how the sign-in flow that"},{"type":"text","text":" "},{"type":"text","text":"replays this deep link is modelled."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts","type":"reference"},{"text":" if the existing app","type":"text"},{"text":" ","type":"text"},{"text":"still uses ","type":"text"},{"code":"ModalHost { NavigationHost { ... } }","type":"codeVoice"},{"text":" pairs.","type":"text"}]}]}]}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","kind":"article","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"text":" ","type":"text"},{"text":"coordinators, and typed ","type":"text"},{"type":"codeVoice","code":"EnvironmentRouter"},{"text":" actions for InnoRouter.","type":"text"}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"type":"topic","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","abstract":[],"role":"collection"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"title":"Building a Login Onboarding Flow","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","kind":"article","abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", then let the signup "},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"text":"to the same app-defined flow owner.","type":"text"}],"role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MigratingFromNestedHosts":{"kind":"article","abstract":[{"type":"text","text":"Replace manually composed "},{"code":"ModalHost { NavigationHost { ... } }","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"surfaces with a single "},{"code":"FlowHost","type":"codeVoice"},{"type":"text","text":" backed by "},{"type":"codeVoice","code":"FlowStore"},{"text":". Preserve","type":"text"},{"text":" ","type":"text"},{"text":"existing ","type":"text"},{"type":"codeVoice","code":"NavigationStore"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"ModalStore"},{"text":" configurations while","type":"text"},{"type":"text","text":" "},{"type":"text","text":"unlocking a serializable "},{"type":"codeVoice","code":"[RouteStep<R>]"},{"type":"text","text":" path and"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore.apply(_:)"},{"type":"text","text":" for restoration + deep-link hydration."}],"url":"\/documentation\/innorouterswiftui\/tutorial-migratingfromnestedhosts","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts","title":"Migrating from Nested Hosts to `FlowHost`","role":"article","type":"topic"}}}