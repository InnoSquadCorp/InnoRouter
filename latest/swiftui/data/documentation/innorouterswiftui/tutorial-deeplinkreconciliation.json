{"kind":"article","variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"primaryContentSections":[{"content":[{"anchor":"Scenario","type":"heading","level":2,"text":"Scenario"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"myapp:\/\/app\/order\/42"},{"type":"text","text":" should land the user on the order detail for"},{"type":"text","text":" "},{"type":"text","text":"order 42, but only when they’re signed in. If the link arrives"},{"type":"text","text":" "},{"type":"text","text":"while signed out, the app must remember it, route through the"},{"type":"text","text":" "},{"type":"text","text":"sign-in flow, and then replay it — without dropping the original"},{"type":"text","text":" "},{"type":"text","text":"URL context."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This tutorial intentionally uses an externally owned "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"deep-link effect handler must apply plans outside the SwiftUI host. A local"},{"text":" ","type":"text"},{"text":"single-route feature should start with ","type":"text"},{"type":"codeVoice","code":"@Router"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"@DeepLink"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"RouterHost"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which installs incoming-URL handling automatically. Promote to this shape when","type":"text"},{"text":" ","type":"text"},{"text":"authentication, pending replay, multi-step plans, restoration, or direct","type":"text"},{"text":" ","type":"text"},{"text":"effect-handler ownership needs the authority.","type":"text"}]},{"anchor":"Modeling-the-routes","level":2,"type":"heading","text":"Modeling the routes"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["\/\/ This host-independent excerpt uses plain Route conformance. Add @Router and","\/\/ a destination property when this same enum also owns SwiftUI rendering.","enum AppRoute: Route {","    case home","    case signIn","    case order(id: String)","}"]},{"anchor":"Wiring-the-pipeline","level":2,"type":"heading","text":"Wiring the pipeline"},{"inlineContent":[{"type":"codeVoice","code":"DeepLinkPipeline"},{"text":" owns the validate-then-match-then-authorize flow. Pass the","type":"text"},{"text":" ","type":"text"},{"text":"matcher directly so matcher input-limit failures remain typed rejections:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["import Synchronization","","let authentication = Mutex(false)","let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/home\") { _ in .home }","    DeepLinkMapping(\"\/signin\") { _ in .signIn }","    DeepLinkMapping(\"\/order\/:id\") { parameters in","        guard let id = parameters.firstValue(forName: \"id\") else { return nil }","        return .order(id: id)","    }","}","","let policy = DeepLinkAuthenticationPolicy<AppRoute>.required(","    shouldRequireAuthentication: { route in","        if case .order = route { return true }","        return false","    },","    isAuthenticated: { authentication.withLock { $0 } }",")","","let pipeline = DeepLinkPipeline(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    matcher: matcher,","    authenticationPolicy: policy",")"]},{"anchor":"Handling-a-URL","type":"heading","level":2,"text":"Handling a URL"},{"inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"DeepLinkEffectHandler"},{"type":"text","text":" bridges the pipeline output into"},{"type":"text","text":" "},{"code":"NavigationStore","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let store = NavigationStore<AppRoute>()","let effectHandler = DeepLinkEffectHandler(","    navigator: store,","    matcher: matcher,","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    authenticationPolicy: policy",")","","func handle(_ url: URL) {","    switch effectHandler.handle(url) {","    case .executed:","        break \/\/ The validated NavigationPlan has already been applied.","    case .executionFailed(_, let batch):","        Log.warning(\"deep-link batch failed after \\(batch.executedCommands.count) attempted commands\")","    case .pending:","        _ = store.execute(.push(.signIn))","    case .applicationRejected(_, let failure):","        Log.warning(\"deep-link plan rejected: \\(failure)\")","    case .rejected(let reason):","        Log.warning(\"deep link rejected: \\(reason)\")","    case .unhandled(let url):","        Log.warning(\"deep link unhandled: \\(url)\")","    case .invalidURL, .missingDeepLinkURL, .noPendingDeepLink:","        break","    }","}"],"type":"codeListing"},{"text":"Replaying after sign-in","level":2,"type":"heading","anchor":"Replaying-after-sign-in"},{"type":"paragraph","inlineContent":[{"text":"Once the user signs in, the handler resumes any queued deep link:","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["func userDidSignIn() {","    authentication.withLock { $0 = true }","    _ = effectHandler.resumePendingDeepLink()","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The handler consults the retained "},{"type":"codeVoice","code":"PendingDeepLink"},{"type":"text","text":", re-evaluates"},{"type":"text","text":" "},{"type":"text","text":"the authentication policy, and only commits the batch if the new"},{"type":"text","text":" "},{"type":"text","text":"state now permits the original URL. Any stale pending link (one"},{"type":"text","text":" "},{"type":"text","text":"the user cancelled or that no longer validates) is dropped."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Observing-the-reconciliation","text":"Observing the reconciliation"},{"inlineContent":[{"code":"NavigationStore.events","type":"codeVoice"},{"text":" exposes the full sequence of batch +","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"path-mismatch events as a single stream, which is handy for"},{"type":"text","text":" "},{"text":"diagnostics dashboards. Capture the stream before starting its lifecycle-owned","type":"text"},{"type":"text","text":" "},{"type":"text","text":"task so the subscriber is registered before any immediate reconciliation"},{"type":"text","text":" "},{"type":"text","text":"command:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let events = store.events","let observationTask = Task { @MainActor in","    for await event in events {","        switch event {","        case .batchExecuted(let result):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .pathMismatch(let event):","            analytics.track(\"deep_link_mismatch\", [","                \"policy\": event.policy.rawValue,","                \"old\": event.oldPath.map(String.init(describing:)),","                \"new\": event.newPath.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"],"type":"codeListing"},{"text":"Testing the chain","anchor":"Testing-the-chain","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"NavigationTestStore","type":"codeVoice"},{"text":" (in ","type":"text"},{"type":"codeVoice","code":"InnoRouterTesting"},{"text":") asserts the batch +","type":"text"},{"text":" ","type":"text"},{"text":"side effects for each branch:","type":"text"}]},{"type":"codeListing","code":["@Test","@MainActor","func signedOutDeepLinkDefersUntilSignIn() {","    let store = NavigationTestStore<AppRoute>()","    let handler = DeepLinkEffectHandler(","        navigator: store.store,","        matcher: matcher,","        authenticationPolicy: policy","    )","","    let result = handler.handle(URL(string: \"myapp:\/\/app\/order\/42\")!)","","    #expect(result == .pending(handler.pendingDeepLink!))","    #expect(store.state.path.isEmpty)","    store.finish()","}"],"syntax":"swift skip doc-fragment"},{"type":"heading","anchor":"Next-steps","text":"Next steps","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","isActive":true},{"type":"text","text":" for how the sign-in flow that"},{"type":"text","text":" "},{"type":"text","text":"replays this deep link is modelled."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Read "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts","type":"reference","isActive":true},{"type":"text","text":" if the existing app"},{"type":"text","text":" "},{"type":"text","text":"still uses "},{"type":"codeVoice","code":"ModalHost { NavigationHost { ... } }"},{"type":"text","text":" pairs."}],"type":"paragraph"}]}]}],"kind":"content"}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article","title":"Reconciling Deep Links End-to-End"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation"},"sections":[],"abstract":[{"type":"text","text":"Match a URL, apply an authentication policy, and produce a"},{"type":"text","text":" "},{"code":"NavigationPlan","type":"codeVoice"},{"type":"text","text":" that "},{"code":"NavigationStore.executeBatch","type":"codeVoice"},{"type":"text","text":" applies in one"},{"type":"text","text":" "},{"type":"text","text":"observable step. Queue the deep link while the user is signed out,"},{"type":"text","text":" "},{"type":"text","text":"replay it after sign-in, and surface cancellation reasons through"},{"type":"text","text":" "},{"type":"text","text":"typed outcomes."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","role":"collection","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","abstract":[],"type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"kind":"article","abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then let the signup "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}],"url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","type":"topic","title":"Building a Login Onboarding Flow","role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"kind":"article","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","type":"topic","title":"InnoRouterSwiftUI","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MigratingFromNestedHosts":{"url":"\/documentation\/innorouterswiftui\/tutorial-migratingfromnestedhosts","kind":"article","type":"topic","abstract":[{"type":"text","text":"Replace manually composed "},{"type":"codeVoice","code":"ModalHost { NavigationHost { ... } }"},{"type":"text","text":" "},{"type":"text","text":"surfaces with a single "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" backed by "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":". Preserve"},{"type":"text","text":" "},{"type":"text","text":"existing "},{"type":"codeVoice","code":"NavigationStore"},{"text":" \/ ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" configurations while"},{"type":"text","text":" "},{"type":"text","text":"unlocking a serializable "},{"type":"codeVoice","code":"[RouteStep<R>]"},{"type":"text","text":" path and"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore.apply(_:)"},{"type":"text","text":" for restoration + deep-link hydration."}],"title":"Migrating from Nested Hosts to `FlowHost`","role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts"}}}