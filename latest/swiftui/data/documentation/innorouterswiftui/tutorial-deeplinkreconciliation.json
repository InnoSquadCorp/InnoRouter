{"abstract":[{"type":"text","text":"Match a URL, apply an authentication policy, and produce a"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":" that "},{"type":"codeVoice","code":"NavigationStore.executeBatch"},{"type":"text","text":" applies in one"},{"type":"text","text":" "},{"type":"text","text":"observable step. Queue the deep link while the user is signed out,"},{"type":"text","text":" "},{"type":"text","text":"replay it after sign-in, and surface cancellation reasons through"},{"type":"text","text":" "},{"type":"text","text":"typed outcomes."}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation"]}],"kind":"article","metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article","title":"Reconciling Deep Links End-to-End"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Scenario","anchor":"Scenario"},{"type":"paragraph","inlineContent":[{"code":"myapp:\/\/app\/order\/42","type":"codeVoice"},{"text":" should land the user on the order detail for","type":"text"},{"text":" ","type":"text"},{"text":"order 42, but only when they’re signed in. If the link arrives","type":"text"},{"text":" ","type":"text"},{"text":"while signed out, the app must remember it, route through the","type":"text"},{"text":" ","type":"text"},{"text":"sign-in flow, and then replay it — without dropping the original","type":"text"},{"text":" ","type":"text"},{"text":"URL context.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"This tutorial intentionally uses an externally owned ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":": the","type":"text"},{"text":" ","type":"text"},{"text":"deep-link effect handler must apply plans outside the SwiftUI host. A local","type":"text"},{"text":" ","type":"text"},{"text":"single-route feature should start with ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"@DeepLink","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"RouterHost","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which installs incoming-URL handling automatically. Promote to this shape when","type":"text"},{"text":" ","type":"text"},{"text":"authentication, pending replay, multi-step plans, restoration, or direct","type":"text"},{"text":" ","type":"text"},{"text":"effect-handler ownership needs the authority.","type":"text"}]},{"type":"heading","level":2,"text":"Modeling the routes","anchor":"Modeling-the-routes"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["\/\/ This host-independent excerpt uses plain Route conformance. Add @Router and","\/\/ a destination property when this same enum also owns SwiftUI rendering.","enum AppRoute: Route {","    case home","    case signIn","    case order(id: String)","}"]},{"type":"heading","level":2,"text":"Wiring the pipeline","anchor":"Wiring-the-pipeline"},{"type":"paragraph","inlineContent":[{"code":"DeepLinkPipeline","type":"codeVoice"},{"text":" owns the validate-then-match-then-authorize flow. Pass the","type":"text"},{"text":" ","type":"text"},{"text":"matcher directly so matcher input-limit failures remain typed rejections:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["import Synchronization","","let authentication = Mutex(false)","let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/home\") { _ in .home }","    DeepLinkMapping(\"\/signin\") { _ in .signIn }","    DeepLinkMapping(\"\/order\/:id\") { parameters in","        guard let id = parameters.firstValue(forName: \"id\") else { return nil }","        return .order(id: id)","    }","}","","let policy = DeepLinkAuthenticationPolicy<AppRoute>.required(","    shouldRequireAuthentication: { route in","        if case .order = route { return true }","        return false","    },","    isAuthenticated: { authentication.withLock { $0 } }",")","","let pipeline = DeepLinkPipeline(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    matcher: matcher,","    authenticationPolicy: policy",")"]},{"type":"heading","level":2,"text":"Handling a URL","anchor":"Handling-a-URL"},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"code":"DeepLinkEffectHandler","type":"codeVoice"},{"text":" bridges the pipeline output into","type":"text"},{"text":" ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let store = NavigationStore<AppRoute>()","let effectHandler = DeepLinkEffectHandler(","    navigator: store,","    matcher: matcher,","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    authenticationPolicy: policy",")","","func handle(_ url: URL) {","    switch effectHandler.handle(url) {","    case .executed:","        break \/\/ The validated NavigationPlan has already been applied.","    case .executionFailed(_, let batch):","        Log.warning(\"deep-link batch failed after \\(batch.executedCommands.count) attempted commands\")","    case .pending:","        _ = store.execute(.push(.signIn))","    case .applicationRejected(_, let failure):","        Log.warning(\"deep-link plan rejected: \\(failure)\")","    case .rejected(let reason):","        Log.warning(\"deep link rejected: \\(reason)\")","    case .unhandled(let url):","        Log.warning(\"deep link unhandled: \\(url)\")","    case .invalidURL, .missingDeepLinkURL, .noPendingDeepLink:","        break","    }","}"]},{"type":"heading","level":2,"text":"Replaying after sign-in","anchor":"Replaying-after-sign-in"},{"type":"paragraph","inlineContent":[{"text":"Once the user signs in, the handler resumes any queued deep link:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["func userDidSignIn() {","    authentication.withLock { $0 = true }","    _ = effectHandler.resumePendingDeepLink()","}"]},{"type":"paragraph","inlineContent":[{"text":"The handler consults the retained ","type":"text"},{"code":"PendingDeepLink","type":"codeVoice"},{"text":", re-evaluates","type":"text"},{"text":" ","type":"text"},{"text":"the authentication policy, and only commits the batch if the new","type":"text"},{"text":" ","type":"text"},{"text":"state now permits the original URL. Any stale pending link (one","type":"text"},{"text":" ","type":"text"},{"text":"the user cancelled or that no longer validates) is dropped.","type":"text"}]},{"type":"heading","level":2,"text":"Observing the reconciliation","anchor":"Observing-the-reconciliation"},{"type":"paragraph","inlineContent":[{"code":"NavigationStore.events","type":"codeVoice"},{"text":" exposes the full sequence of batch +","type":"text"},{"text":" ","type":"text"},{"text":"path-mismatch events as a single stream, which is handy for","type":"text"},{"text":" ","type":"text"},{"text":"diagnostics dashboards. Capture the stream before starting its lifecycle-owned","type":"text"},{"text":" ","type":"text"},{"text":"task so the subscriber is registered before any immediate reconciliation","type":"text"},{"text":" ","type":"text"},{"text":"command:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let events = store.events","let observationTask = Task { @MainActor in","    for await event in events {","        switch event {","        case .batchExecuted(let result):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .pathMismatch(let event):","            analytics.track(\"deep_link_mismatch\", [","                \"policy\": event.policy.rawValue,","                \"old\": event.oldPath.map(String.init(describing:)),","                \"new\": event.newPath.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"]},{"type":"heading","level":2,"text":"Testing the chain","anchor":"Testing-the-chain"},{"type":"paragraph","inlineContent":[{"code":"NavigationTestStore","type":"codeVoice"},{"text":" (in ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":") asserts the batch +","type":"text"},{"text":" ","type":"text"},{"text":"side effects for each branch:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func signedOutDeepLinkDefersUntilSignIn() {","    let store = NavigationTestStore<AppRoute>()","    let handler = DeepLinkEffectHandler(","        navigator: store.store,","        matcher: matcher,","        authenticationPolicy: policy","    )","","    let result = handler.handle(URL(string: \"myapp:\/\/app\/order\/42\")!)","","    #expect(result == .pending(handler.pendingDeepLink!))","    #expect(store.state.path.isEmpty)","    store.finish()","}"]},{"type":"heading","level":2,"text":"Next steps","anchor":"Next-steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},{"text":" for how the sign-in flow that","type":"text"},{"text":" ","type":"text"},{"text":"replays this deep link is modelled.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts"},{"text":" if the existing app","type":"text"},{"text":" ","type":"text"},{"text":"still uses ","type":"text"},{"code":"ModalHost { NavigationHost { ... } }","type":"codeVoice"},{"text":" pairs.","type":"text"}],"type":"paragraph"}]}]}]}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"abstract":[],"type":"topic","role":"collection","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","kind":"symbol"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","kind":"article","title":"InnoRouterSwiftUI","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","abstract":[{"text":"Macro-first SwiftUI routing, externally owned stores, modal routing,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","title":"Building a Login Onboarding Flow","kind":"article","role":"article","type":"topic","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","abstract":[{"text":"Compose push, sheet, and cover steps into a single serializable flow with","type":"text"},{"text":" ","type":"text"},{"code":"Fl