{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Scenario","anchor":"Scenario","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"myapp:\/\/order\/42"},{"type":"text","text":" should land the user on the order detail for"},{"type":"text","text":" "},{"type":"text","text":"order 42, but only when they’re signed in. If the link arrives"},{"type":"text","text":" "},{"type":"text","text":"while signed out, the app must remember it, route through the"},{"type":"text","text":" "},{"type":"text","text":"sign-in flow, and then replay it — without dropping the original"},{"type":"text","text":" "},{"type":"text","text":"URL context."}],"type":"paragraph"},{"level":2,"text":"Modeling the routes","anchor":"Modeling-the-routes","type":"heading"},{"code":["enum AppRoute: Route {","    case home","    case signIn","    case order(id: String)","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"text":"Wiring the pipeline","anchor":"Wiring-the-pipeline","type":"heading"},{"inlineContent":[{"code":"DeepLinkPipeline","type":"codeVoice"},{"text":" owns the match-then-validate-then-authorize flow:","type":"text"}],"type":"paragraph"},{"code":["let matcher = DeepLinkMatcher<AppRoute>(patterns: [","    .init(pattern: \"myapp:\/\/home\")                   { _ in .home },","    .init(pattern: \"myapp:\/\/signin\")                 { _ in .signIn },","    .init(pattern: \"myapp:\/\/order\/:id\")              { params in","        guard let id = params[\"id\"] else { return nil }","        return .order(id: id)","    },","])","","let policy: DeepLinkAuthenticationPolicy<AppRoute> = { route, isAuthenticated in","    switch route {","    case .home, .signIn:","        return .proceed","    case .order where !isAuthenticated:","        return .defer \/\/ the pipeline will queue a PendingDeepLink","    case .order:","        return .proceed","    }","}","","let pipeline = DeepLinkPipeline(matcher: matcher, policy: policy)"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"text":"Handling a URL","anchor":"Handling-a-URL","type":"heading"},{"inlineContent":[{"text":"The ","type":"text"},{"code":"DeepLinkEffectHandler","type":"codeVoice"},{"text":" bridges the pipeline output into","type":"text"},{"text":" ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["@MainActor","final class AppCoordinator {","    let store: NavigationStore<AppRoute>","    let pipeline: DeepLinkPipeline<AppRoute>","    let effectHandler: DeepLinkEffectHandler<AppRoute>","","    func handle(_ url: URL, isAuthenticated: Bool) {","        let outcome = pipeline.process(url: url, isAuthenticated: isAuthenticated)","","        switch outcome {","        case .plan(let plan):","            _ = store.executeBatch(plan.commands)","        case .pending(let pending):","            effectHandler.retain(pending)","            store.send(.go(.signIn))","        case .rejected(let reason):","            Log.warning(\"deep link rejected: \\(reason)\")","        case .unhandled(let url):","            Log.warning(\"deep link unhandled: \\(url)\")","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"text":"Replaying after sign-in","anchor":"Replaying-after-sign-in","type":"heading"},{"inlineContent":[{"text":"Once the user signs in, the handler resumes any queued deep link:","type":"text"}],"type":"paragraph"},{"code":["func userDidSignIn() {","    effectHandler.resumePendingDeepLinkIfAllowed(","        isAuthenticated: true,","        executor: { plan in","            _ = store.executeBatch(plan.commands)","        }","    )","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The handler consults the retained "},{"type":"codeVoice","code":"PendingDeepLink"},{"type":"text","text":", re-evaluates"},{"type":"text","text":" "},{"type":"text","text":"the authentication policy, and only commits the batch if the new"},{"type":"text","text":" "},{"type":"text","text":"state now permits the original URL. Any stale pending link (one"},{"type":"text","text":" "},{"type":"text","text":"the user cancelled or that no longer validates) is dropped."}],"type":"paragraph"},{"level":2,"text":"Observing the reconciliation","anchor":"Observing-the-reconciliation","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"NavigationStore.events"},{"type":"text","text":" exposes the full sequence of batch +"},{"type":"text","text":" "},{"type":"text","text":"path-mismatch events as a single stream, which is handy for"},{"type":"text","text":" "},{"type":"text","text":"diagnostics dashboards:"}],"type":"paragraph"},{"code":["Task {","    for await event in store.events {","        switch event {","        case .batchExecuted(let result):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .pathMismatch(let event):","            analytics.track(\"deep_link_mismatch\", [","                \"policy\": event.policy.rawValue,","                \"old\": event.oldPath.map(String.init(describing:)),","                \"new\": event.newPath.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"text":"Testing the chain","anchor":"Testing-the-chain","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"NavigationTestStore"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":") asserts the batch +"},{"type":"text","text":" "},{"type":"text","text":"side effects for each branch:"}],"type":"paragraph"},{"code":["@Test","@MainActor","func signedOutDeepLinkDefersUntilSignIn() {","    let store = NavigationTestStore<AppRoute>()","    \/\/ ...pipeline + handler wired to `store.store`","    pipeline.handle(URL(string: \"myapp:\/\/order\/42\")!, isAuthenticated: false)","","    store.receiveChange { _, new in new.path == [.signIn] }","    \/\/ Pending deep link remains queued; no .batchExecuted yet.","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"level":2,"text":"Next steps","anchor":"Next-steps","type":"heading"},{"items":[{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","type":"reference"},{"text":" for how the sign-in flow that","type":"text"},{"text":" ","type":"text"},{"text":"replays this deep link is modelled.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts","isActive":true},{"type":"text","text":" if the existing app"},{"type":"text","text":" "},{"type":"text","text":"still uses "},{"type":"codeVoice","code":"ModalHost { NavigationHost { ... } }"},{"type":"text","text":" pairs."}]}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article","title":"Reconciling Deep Links End-to-End"},"sections":[],"abstract":[{"type":"text","text":"Match a URL, apply an authentication policy, and produce a"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":" that "},{"type":"codeVoice","code":"NavigationStore.executeBatch"},{"type":"text","text":" applies in one"},{"type":"text","text":" "},{"type":"text","text":"observable step. Queue the deep link while the user is signed out,"},{"type":"text","text":" "},{"type":"text","text":"replay it after sign-in, and surface cancellation reasons through"},{"type":"text","text":" "},{"type":"text","text":"typed outcomes."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation"]}],"kind":"article","references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MigratingFromNestedHosts":{"kind":"article","type":"topic","role":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts","abstract":[{"text":"Replace manually composed ","type":"text"},{"type":"codeVoice","code":"ModalHost { NavigationHost { ... } }"},{"text":" ","type":"text"},{"text":"surfaces with a single ","type":"text"},{"type":"codeVoice","code":"FlowHost"},{"text":" backed by ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":". Preserve","type":"text"},{"text":" ","type":"text"},{"text":"existing ","type":"text"},{"type":"codeVoice","code":"NavigationStore"},{"text":" \/ ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" configurations while","type":"text"},{"text":" ","type":"text"},{"text":"unlocking a serializable ","type":"text"},{"code":"[RouteStep<R>]","type":"codeVoice"},{"text":" path and","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore.apply(_:)","type":"codeVoice"},{"text":" for restoration + deep-link hydration.","type":"text"}],"title":"Migrating from Nested Hosts to `FlowHost`","url":"\/documentation\/innorouterswiftui\/tutorial-migratingfromnestedhos