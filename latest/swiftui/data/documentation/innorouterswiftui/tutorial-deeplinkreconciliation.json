{"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Reconciling Deep Links End-to-End"},"abstract":[{"type":"text","text":"Match a URL, apply an authentication policy, and produce a"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":" that "},{"type":"codeVoice","code":"NavigationStore.executeBatch"},{"type":"text","text":" applies in one"},{"type":"text","text":" "},{"type":"text","text":"observable step. Queue the deep link while the user is signed out,"},{"type":"text","text":" "},{"type":"text","text":"replay it after sign-in, and surface cancellation reasons through"},{"type":"text","text":" "},{"type":"text","text":"typed outcomes."}],"variants":[{"paths":["\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation","interfaceLanguage":"swift"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"anchor":"Scenario","type":"heading","level":2,"text":"Scenario"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"myapp:\/\/app\/order\/42"},{"type":"text","text":" should land the user on the order detail for"},{"type":"text","text":" "},{"type":"text","text":"order 42, but only when they’re signed in. If the link arrives"},{"type":"text","text":" "},{"type":"text","text":"while signed out, the app must remember it, route through the"},{"type":"text","text":" "},{"type":"text","text":"sign-in flow, and then replay it — without dropping the original"},{"type":"text","text":" "},{"type":"text","text":"URL context."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This tutorial intentionally uses an externally owned "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":": the"},{"type":"text","text":" "},{"type":"text","text":"deep-link effect handler must apply plans outside the SwiftUI host. A local"},{"type":"text","text":" "},{"type":"text","text":"single-route feature should start with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" + "},{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" + "},{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"which installs incoming-URL handling automatically. Promote to this shape when"},{"type":"text","text":" "},{"type":"text","text":"authentication, pending replay, multi-step plans, restoration, or direct"},{"type":"text","text":" "},{"type":"text","text":"effect-handler ownership needs the authority."}]},{"anchor":"Modeling-the-routes","type":"heading","level":2,"text":"Modeling the routes"},{"type":"codeListing","code":["\/\/ This host-independent excerpt uses plain Route conformance. Add @Router and","\/\/ a destination property when this same enum also owns SwiftUI rendering.","enum AppRoute: Route {","    case home","    case signIn","    case order(id: String)","}"],"syntax":"swift skip doc-fragment"},{"anchor":"Wiring-the-pipeline","type":"heading","level":2,"text":"Wiring the pipeline"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":" owns the validate-then-match-then-authorize flow. Pass the"},{"type":"text","text":" "},{"type":"text","text":"matcher directly so matcher input-limit failures remain typed rejections:"}]},{"type":"codeListing","code":["import Synchronization","","let authentication = Mutex(false)","let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/home\") { _ in .home }","    DeepLinkMapping(\"\/signin\") { _ in .signIn }","    DeepLinkMapping(\"\/order\/:id\") { parameters in","        guard let id = parameters.firstValue(forName: \"id\") else { return nil }","        return .order(id: id)","    }","}","","let policy = DeepLinkAuthenticationPolicy<AppRoute>.required(","    shouldRequireAuthentication: { route in","        if case .order = route { return true }","        return false","    },","    isAuthenticated: { authentication.withLock { $0 } }",")","","let pipeline = DeepLinkPipeline(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    matcher: matcher,","    authenticationPolicy: policy",")"],"syntax":"swift skip doc-fragment"},{"anchor":"Handling-a-URL","type":"heading","level":2,"text":"Handling a URL"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The "},{"type":"codeVoice","code":"DeepLinkEffectHandler"},{"type":"text","text":" bridges the pipeline output into"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":":"}]},{"type":"codeListing","code":["let store = NavigationStore<AppRoute>()","let effectHandler = DeepLinkEffectHandler(","    navigator: store,","    matcher: matcher,","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    authenticationPolicy: policy",")","","func handle(_ url: URL) {","    switch effectHandler.handle(url) {","    case .executed:","        break \/\/ The validated NavigationPlan has already been applied.","    case .executionFailed(_, let batch):","        Log.warning(\"deep-link batch failed after \\(batch.executedCommands.count) attempted commands\")","    case .pending:","        _ = store.execute(.push(.signIn))","    case .applicationRejected(_, let failure):","        Log.warning(\"deep-link plan rejected: \\(failure)\")","    case .rejected(let reason):","        Log.warning(\"deep link rejected: \\(reason)\")","    case .unhandled(let url):","        Log.warning(\"deep link unhandled: \\(url)\")","    case .invalidURL, .missingDeepLinkURL, .noPendingDeepLink:","        break","    }","}"],"syntax":"swift skip doc-fragment"},{"anchor":"Replaying-after-sign-in","type":"heading","level":2,"text":"Replaying after sign-in"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once the user signs in, the handler resumes any queued deep link:"}]},{"type":"codeListing","code":["func userDidSignIn() {","    authentication.withLock { $0 = true }","    _ = effectHandler.resumePendingDeepLink()","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The handler consults the retained "},{"type":"codeVoice","code":"PendingDeepLink"},{"type":"text","text":", re-evaluates"},{"type":"text","text":" "},{"type":"text","text":"the authentication policy, and only commits the batch if the new"},{"type":"text","text":" "},{"type":"text","text":"state now permits the original URL. Any stale pending link (one"},{"type":"text","text":" "},{"type":"text","text":"the user cancelled or that no longer validates) is dropped."}]},{"anchor":"Observing-the-reconciliation","type":"heading","level":2,"text":"Observing the reconciliation"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore.events"},{"type":"text","text":" exposes the full sequence of batch +"},{"type":"text","text":" "},{"type":"text","text":"path-mismatch events as a single stream, which is handy for"},{"type":"text","text":" "},{"type":"text","text":"diagnostics dashboards. Capture the stream before starting its lifecycle-owned"},{"type":"text","text":" "},{"type":"text","text":"task so the subscriber is registered before any immediate reconciliation"},{"type":"text","text":" "},{"type":"text","text":"command:"}]},{"type":"codeListing","code":["let events = store.events","let observationTask = Task { @MainActor in","    for await event in events {","        switch event {","        case .batchExecuted(let result):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .pathMismatch(let event):","            analytics.track(\"deep_link_mismatch\", [","                \"policy\": event.policy.rawValue,","                \"old\": event.oldPath.map(String.init(describing:)),","                \"new\": event.newPath.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"anchor":"Testing-the-chain","type":"heading","level":2,"text":"Testing the chain"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTestStore"},{"type":"text","text":" (in "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":") asserts the batch +"},{"type":"text","text":" "},{"type":"text","text":"side effects for each branch:"}]},{"type":"codeListing","code":["@Test","@MainActor","func signedOutDeepLinkDefersUntilSignIn() {","    let store = NavigationTestStore<AppRoute>()","    let handler = DeepLinkEffectHandler(","        navigator: store.store,","        matcher: matcher,","        authenticationPolicy: policy","    )","","    let result = handler.handle(URL(string: \"myapp:\/\/app\/order\/42\")!)","","    #expect(result == .pending(handler.pendingDeepLink!))","    #expect(store.state.path.isEmpty)","    store.finish()","}"],"syntax":"swift skip doc-fragment"},{"anchor":"Next-steps","type":"heading","level":2,"text":"Next steps"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Read "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding"},{"type":"text","text":" for how the sign-in flow that"},{"type":"text","text":" "},{"type":"text","text":"replays this deep link is modelled."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Read "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts"},{"type":"text","text":" if the existing app"},{"type":"text","text":" "},{"type":"text","text":"still uses "},{"type":"codeVoice","code":"ModalHost { NavigationHost { ... } }"},{"type":"text","text":" pairs."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"abstract":[],"kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", then let the signup "},{"type":"codeVoice","code":"ChildCoordinator"},{"type":"text","text":" expose its result directly"},{"type":"text","text":" "},{"type":"text","text":"to the same app-defined flow owner."}],"kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","role":"article","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","title":"Building a Login Onboarding Flow","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI","url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","abstract":[{"type":"text","text":"Macro-first SwiftUI routing, externally owned stores, modal routing,"},{"type":"text","text":" "},{"type":"text","text":"coordinators, and typed "},{"type":"codeVoice","code":"EnvironmentRouter"},{"type":"text","text":" actions for InnoRouter."}],"kind":"article","title":"InnoRouterSwiftUI","type":"topic"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MigratingFromNestedHosts":{"title":"Migrating from Nested Hosts to `FlowHost`","role":"article","abstract":[{"type":"text","text":"Replace manually composed "},{"type":"codeVoice","code":"ModalHost { NavigationHost { ... } }"},{"type":"text","text":" "},{"type":"text","text":"surfaces with a single "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" backed by "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":". Preserve"},{"type":"text","text":" "},{"type":"text","text":"existing "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" configurations while"},{"type":"text","text":" "},{"type":"text","text":"unlocking a serializable "},{"type":"codeVoice","code":"[RouteStep<R>]"},{"type":"text","text":" path and"},{"type":"text","text":" "},{"code":"FlowStore.apply(_:)","type":"codeVoice"},{"type":"text","text":" for restoration + deep-link hydration."}],"url":"\/documentation\/innorouterswiftui\/tutorial-migratingfromnestedhosts","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts","kind":"article","type":"topic"}}}