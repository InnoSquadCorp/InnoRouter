{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-DeepLinkReconciliation"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Scenario","text":"Scenario","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"myapp:\/\/order\/42"},{"type":"text","text":" should land the user on the order detail for"},{"type":"text","text":" "},{"type":"text","text":"order 42, but only when they’re signed in. If the link arrives"},{"type":"text","text":" "},{"type":"text","text":"while signed out, the app must remember it, route through the"},{"type":"text","text":" "},{"type":"text","text":"sign-in flow, and then replay it — without dropping the original"},{"type":"text","text":" "},{"type":"text","text":"URL context."}]},{"anchor":"Modeling-the-routes","text":"Modeling the routes","type":"heading","level":2},{"syntax":"swift skip doc-fragment","code":["enum AppRoute: Route {","    case home","    case signIn","    case order(id: String)","}"],"type":"codeListing"},{"anchor":"Wiring-the-pipeline","text":"Wiring the pipeline","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":" owns the match-then-validate-then-authorize flow:"}]},{"syntax":"swift skip doc-fragment","code":["let matcher = DeepLinkMatcher<AppRoute>(patterns: [","    .init(pattern: \"myapp:\/\/home\")                   { _ in .home },","    .init(pattern: \"myapp:\/\/signin\")                 { _ in .signIn },","    .init(pattern: \"myapp:\/\/order\/:id\")              { params in","        guard let id = params[\"id\"] else { return nil }","        return .order(id: id)","    },","])","","let policy: DeepLinkAuthenticationPolicy<AppRoute> = { route, isAuthenticated in","    switch route {","    case .home, .signIn:","        return .proceed","    case .order where !isAuthenticated:","        return .defer \/\/ the pipeline will queue a PendingDeepLink","    case .order:","        return .proceed","    }","}","","let pipeline = DeepLinkPipeline(matcher: matcher, policy: policy)"],"type":"codeListing"},{"anchor":"Handling-a-URL","text":"Handling a URL","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The ","type":"text"},{"type":"codeVoice","code":"DeepLinkEffectHandler"},{"text":" bridges the pipeline output into","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationStore"},{"text":":","type":"text"}]},{"syntax":"swift skip doc-fragment","code":["@MainActor","final class AppCoordinator {","    let store: NavigationStore<AppRoute>","    let pipeline: DeepLinkPipeline<AppRoute>","    let effectHandler: DeepLinkEffectHandler<AppRoute>","","    func handle(_ url: URL, isAuthenticated: Bool) {","        let outcome = pipeline.process(url: url, isAuthenticated: isAuthenticated)","","        switch outcome {","        case .plan(let plan):","            _ = store.executeBatch(plan.commands)","        case .pending(let pending):","            effectHandler.retain(pending)","            store.send(.go(.signIn))","        case .rejected(let reason):","            Log.warning(\"deep link rejected: \\(reason)\")","        case .unhandled(let url):","            Log.warning(\"deep link unhandled: \\(url)\")","        }","    }","}"],"type":"codeListing"},{"anchor":"Replaying-after-sign-in","text":"Replaying after sign-in","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Once the user signs in, the handler resumes any queued deep link:"}],"type":"paragraph"},{"code":["func userDidSignIn() {","    effectHandler.resumePendingDeepLinkIfAllowed(","        isAuthenticated: true,","        executor: { plan in","            _ = store.executeBatch(plan.commands)","        }","    )","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"The handler consults the retained "},{"type":"codeVoice","code":"PendingDeepLink"},{"type":"text","text":", re-evaluates"},{"type":"text","text":" "},{"type":"text","text":"the authentication policy, and only commits the batch if the new"},{"type":"text","text":" "},{"type":"text","text":"state now permits the original URL. Any stale pending link (one"},{"type":"text","text":" "},{"type":"text","text":"the user cancelled or that no longer validates) is dropped."}],"type":"paragraph"},{"level":2,"text":"Observing the reconciliation","type":"heading","anchor":"Observing-the-reconciliation"},{"inlineContent":[{"code":"NavigationStore.events","type":"codeVoice"},{"text":" exposes the full sequence of batch +","type":"text"},{"text":" ","type":"text"},{"text":"path-mismatch events as a single stream, which is handy for","type":"text"},{"text":" ","type":"text"},{"text":"diagnostics dashboards:","type":"text"}],"type":"paragraph"},{"code":["Task {","    for await event in store.events {","        switch event {","        case .batchExecuted(let result):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .pathMismatch(let event):","            analytics.track(\"deep_link_mismatch\", [","                \"policy\": event.policy.rawValue,","                \"old\": event.oldPath.map(String.init(describing:)),","                \"new\": event.newPath.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"level":2,"text":"Testing the chain","type":"heading","anchor":"Testing-the-chain"},{"inlineContent":[{"code":"NavigationTestStore","type":"codeVoice"},{"text":" (in ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":") asserts the batch +","type":"text"},{"text":" ","type":"text"},{"text":"side effects for each branch:","type":"text"}],"type":"paragraph"},{"code":["@Test","@MainActor","func signedOutDeepLinkDefersUntilSignIn() {","    let store = NavigationTestStore<AppRoute>()","    \/\/ ...pipeline + handler wired to `store.store`","    pipeline.handle(URL(string: \"myapp:\/\/order\/42\")!, isAuthenticated: false)","","    store.receiveChange { _, new in new.path == [.signIn] }","    \/\/ Pending deep link remains queued; no .batchExecuted yet.","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"level":2,"text":"Next steps","type":"heading","anchor":"Next-steps"},{"items":[{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","isActive":true,"type":"reference"},{"text":" for how the sign-in flow that","type":"text"},{"text":" ","type":"text"},{"text":"replays this deep link is modelled.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Read ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts"},{"text":" if the existing app","type":"text"},{"text":" ","type":"text"},{"text":"still uses ","type":"text"},{"type":"codeVoice","code":"ModalHost { NavigationHost { ... } }"},{"text":" pairs.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"metadata":{"roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article","title":"Reconciling Deep Links End-to-End"},"sections":[],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterswiftui\/tutorial-deeplinkreconciliation"]}],"abstract":[{"text":"Match a URL, apply an authentication policy, and produce a","type":"text"},{"text":" ","type":"text"},{"code":"NavigationPlan","type":"codeVoice"},{"text":" that ","type":"text"},{"code":"NavigationStore.executeBatch","type":"codeVoice"},{"text":" applies in one","type":"text"},{"text":" ","type":"text"},{"text":"observable step. Queue the deep link while the user is signed out,","type":"text"},{"text":" ","type":"text"},{"text":"replay it after sign-in, and surface cancellation reasons through","type":"text"},{"text":" ","type":"text"},{"text":"typed outcomes.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"references":{"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"url":"\/documentation\/innoroutertesting","kind":"symbol","type":"topic","role":"collection","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","abstract":[]},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/InnoRouterSwiftUI":{"abstract":[{"text":"SwiftUI hosts, stores, modal routing, coordinators, and environment intent dispatch for InnoRouter.","type":"text"}],"url":"\/documentation\/innorouterswiftui\/innorouterswiftui","role":"collectionGroup","kind":"article","type":"topic","title":"InnoRouterSwiftUI","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/InnoRouterSwiftUI"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-MigratingFromNestedHosts":{"role":"article","type":"topic","abstract":[{"type":"text","text":"Replace manually composed "},{"type":"codeVoice","code":"ModalHost { NavigationHost { ... } }"},{"type":"text","text":" "},{"type":"text","text":"surfaces with a single "},{"type":"codeVoice","code":"FlowHost"},{"type":"text","text":" backed by "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":". Preserve"},{"type":"text","text":" "},{"type":"text","text":"existing "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":" configurations while"},{"type":"text","text":" "},{"type":"text","text":"unlocking a serializable "},{"type":"codeVoice","code":"[RouteStep<R>]"},{"type":"text","text":" path and"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore.apply(_:)"},{"type":"text","text":" for restoration + deep-link hydration."}],"kind":"article","title":"Migrating from Nested Hosts to `FlowHost`","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-MigratingFromNestedHosts","url":"\/documentation\/innorouterswiftui\/tutorial-migratingfromnestedhosts"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterSwiftUI/Tutorial-LoginOnboarding":{"type":"topic","title":"Building a Login Onboarding Flow","role":"article","abstract":[{"type":"text","text":"Compose push, sheet, and cover steps into a single serializable flow with "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", then scope the signup sub-flow through a "},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" and await its result inline."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterSwiftUI\/Tutorial-LoginOnboarding","url":"\/documentation\/innorouterswiftui\/tutorial-loginonboarding","kind":"article"}}}