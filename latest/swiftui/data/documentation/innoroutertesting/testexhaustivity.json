}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"text":"InnoRouter’s test stores follow TCA’s ","type":"text"},{"code":"TestStore","type":"codeVoice"},{"text":" exhaustivity model:","type":"text"},{"text":" ","type":"text"},{"text":"events collected from the underlying authority’s unified ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" ","type":"text"},{"text":"callback accumulate in an internal queue. Each","type":"text"},{"text":" ","type":"text"},{"code":"receive(...)","type":"codeVoice"},{"text":" call dequeues the next event and asserts a predicate. In","type":"text"},{"text":" ","type":"text"},{"text":"In ","type":"text"},{"code":".strict","type":"codeVoice"},{"text":" mode, the store reports events left pending at ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"deallocation.","type":"text"},{"text":" ","type":"text"},{"code":"assertNoPendingEvents()","type":"codeVoice"},{"text":" is a non-terminal checkpoint: it reports and","type":"text"},{"text":" ","type":"text"},{"text":"consumes the current pending snapshot, then continues observing. ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"closes the queue, consumes its final snapshot, and reports the first event","type":"text"},{"text":" ","type":"text"},{"text":"emitted after that boundary in both exhaustivity modes.","type":"text"}]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Swift Testing currently attributes issues recorded inside an","type":"text"},{"text":" ","type":"text"},{"text":"isolated ","type":"text"},{"code":"deinit","type":"codeVoice"},{"text":" to an ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"unknown test","type":"text"}]},{"text":" rather than to the test that","type":"text"},{"text":" ","type":"text"},{"text":"owned the store, which makes a deinit-time leftover-event failure","type":"text"},{"text":" ","type":"text"},{"text":"hard to locate. Until that is resolved upstream, await all work and end","type":"text"},{"text":" ","type":"text"},{"text":"each test with an explicit ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":". It runs the strict check with the","type":"text"},{"text":" ","type":"text"},{"text":"caller’s source location and disarms the deinit-time fallback.","type":"text"}]}],"style":"note"}]}],"kind":"symbol","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutertesting\/testexhaustivity"]}],"abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"type":"text","text":" "},{"type":"text","text":"finishes."}],"references":{"doc://com.innosquad.innorouter.docs.swiftui/s8SendableP":{"type":"unresolvable","title":"Swift.Sendable","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/s8SendableP"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting":{"abstract":[],"type":"topic","role":"collection","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting","kind":"symbol"},"doc://com.innosquad.innorouter.docs.swiftui/SH":{"type":"unresolvable","title":"Swift.Hashable","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/SH"},"doc://com.innosquad.innorouter.docs.swiftui/documentation/InnoRouterTesting/TestExhaustivity":{"abstract":[{"text":"Controls how strictly a test store checks pending events when observation","type":"text"},{"text":" ","type":"text"},{"text":"finishes.","type":"text"}],"type":"topic","role":"symbol","url":"\/documentation\/innoroutertesting\/testexhaustivity","title":"TestExhaustivity","identifier":"doc:\/\/com.innosquad.innorouter.docs.swiftui\/documentation\/InnoRouterTesting\/T