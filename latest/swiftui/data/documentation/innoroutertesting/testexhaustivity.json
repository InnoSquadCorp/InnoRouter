 "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"code":"assertNoPendingEvents()","type":"codeVoice"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"code":"finish()","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"unknown test"}]},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}],"type":"paragraph"}],"name":"Note","style":"note"}]}],"kind":"symbol","metadata":{"externalID":"s:17InnoRouterTesting16TestExhaustivityO","remoteSource":{"url":"https:\/\/github.com\/InnoSquadCorp\/InnoRouter\/blob\/5.0.0\/Sources\/InnoRouterTesting\/TestExhaustivity.swift#L25","fileName":"TestExhaustivity.swift"},"roleHeading":"Enumeration","role":"symbol","title":"TestExhaustivity","modules":[{"name":"InnoRouterTesting"}],"symbolKind":"enum","fragments":[{"kind":"keyword",