{"relationshipsSections":[{"identifiers":["doc:\/\/com.innosquad.innorouter.docs.deeplink\/SQ","doc:\/\/com.innosquad.innorouter.docs.deeplink\/SH","doc:\/\/com.innosquad.innorouter.docs.deeplink\/s8SendableP","doc:\/\/com.innosquad.innorouter.docs.deeplink\/s16SendableMetatypeP"],"type":"conformsTo","title":"Conforms To","kind":"relationships"}],"sections":[],"kind":"symbol","topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict"],"generated":true,"anchor":"Enumeration-Cases"},{"title":"Default Implementations","identifiers":["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations"],"generated":true,"anchor":"Default-Implementations"}],"variants":[{"paths":["\/documentation\/innoroutertesting\/testexhaustivity"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"]]},"metadata":{"navigatorTitle":[{"text":"TestExhaustivity","kind":"identifier"}],"modules":[{"name":"InnoRouterTesting"}],"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TestExhaustivity","kind":"identifier"}],"externalID":"s:17InnoRouterTesting16TestExhaustivityO","role":"symbol","roleHeading":"Enumeration","remoteSource":{"fileName":"TestExhaustivity.swift","url":"https:\/\/github.com\/InnoSquadCorp\/InnoRouter\/blob\/5.0.0\/Sources\/InnoRouterTesting\/TestExhaustivity.swift#L25"},"symbolKind":"enum","title":"TestExhaustivity"},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity"},"abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"type":"text","text":" "},{"type":"text","text":"finishes."}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TestExhaustivity","kind":"identifier"}],"languages":["swift"],"platforms":["macOS"]}],"kind":"declarations"},{"content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"type":"codeVoice","code":"TestStore"},{"type":"text","text":" exhaustivity model:"},{"type":"text","text":" "},{"type":"text","text":"events collected from the underlying authority’s unified "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"code":".strict","type":"codeVoice"},{"type":"text","text":" mode, the store reports events left pending at "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"code":"assertNoPendingEvents()","type":"codeVoice"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}]},{"content":[{"inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"unknown test"}]},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting/TestExhaustivity":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"TestExhaustivity"}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}],"role":"symbol","abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"type":"text","text":" "},{"type":"text","text":"finishes."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity","kind":"symbol","url":"\/documentation\/innoroutertesting\/testexhaustivity","title":"TestExhaustivity"},"doc://com.innosquad.innorouter.docs.deeplink/SH":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/SH","title":"Swift.Hashable"},"doc://com.innosquad.innorouter.docs.deeplink/s8SendableP":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/s8SendableP","title":"Swift.Sendable"},"doc://com.innosquad.innorouter.docs.deeplink/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/s16SendableMetatypeP","title":"Swift.SendableMetatype"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting/TestExhaustivity/Equatable-Implementations":{"type":"topic","role":"collectionGroup","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations","url":"\/documentation\/innoroutertesting\/testexhaustivity\/equatable-implementations","kind":"article","title":"Equatable Implementations"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"kind":"symbol","type":"topic","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","role":"collection","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting/TestExhaustivity/strict":{"type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"strict"}],"role":"symbol","abstract":[{"type":"text","text":"Every observed event must be drained through "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation. Pending events fail the test. This is the"},{"type":"text","text":" "},{"type":"text","text":"default and matches TCA’s "},{"type":"codeVoice","code":"exhaustive"},{"type":"text","text":" semantics."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict","kind":"symbol","url":"\/documentation\/innoroutertesting\/testexhaustivity\/strict","title":"TestExhaustivity.strict"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting/TestExhaustivity/off":{"type":"topic","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"off","kind":"identifier"}],"role":"symbol","abstract":[{"type":"text","text":"The test store still delivers events through "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":", but pending"},{"type":"text","text":" "},{"type":"text","text":"events at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation are silently discarded. Explicit"},{"type":"text","text":" "},{"type":"text","text":"assertions and events emitted after "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" still report issues."},{"type":"text","text":" "},{"type":"text","text":"Useful for incremental migrations of large legacy suites."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","url":"\/documentation\/innoroutertesting\/testexhaustivity\/off","kind":"symbol","title":"TestExhaustivity.off"},"doc://com.innosquad.innorouter.docs.deeplink/SQ":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/SQ","title":"Swift.Equatable"}}}