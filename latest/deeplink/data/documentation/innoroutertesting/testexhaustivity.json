ity\/off"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting/TestExhaustivity/strict":{"kind":"symbol","url":"\/documentation\/innoroutertesting\/testexhaustivity\/strict","title":"TestExhaustivity.strict","role":"symbol","type":"topic","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"strict"}],"abstract":[{"type":"text","text":"Every observed event must be drained through "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation. Pending events fail the test. This is the"},{"type":"text","text":" "},{"type":"text","text":"default and matches TCA’s "},{"type":"codeVoice","code":"exhaustive"},{"type":"text","text":" semantics."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict"},"doc://com.innosquad.innorouter.docs.deeplink/SQ":{"title":"Swift.Equatable","type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/SQ"}}}