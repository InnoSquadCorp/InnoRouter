{"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"text":"TestExhaustivity","kind":"identifier"}]}]},{"kind":"content","content":[{"text":"Overview","level":2,"anchor":"overview","type":"heading"},{"inlineContent":[{"text":"InnoRouter’s test stores follow TCA’s ","type":"text"},{"code":"TestStore","type":"codeVoice"},{"text":" exhaustivity model:","type":"text"},{"text":" ","type":"text"},{"text":"events collected from the underlying authority’s unified ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" ","type":"text"},{"text":"callback accumulate in an internal queue. Each","type":"text"},{"text":" ","type":"text"},{"code":"receive(...)","type":"codeVoice"},{"text":" call dequeues the next event and asserts a predicate. In","type":"text"},{"text":" ","type":"text"},{"text":"In ","type":"text"},{"code":".strict","type":"codeVoice"},{"text":" mode, the store reports events left pending at ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"deallocation.","type":"text"},{"text":" ","type":"text"},{"code":"assertNoPendingEvents()","type":"codeVoice"},{"text":" is a non-terminal checkpoint: it reports and","type":"text"},{"text":" ","type":"text"},{"text":"consumes the current pending snapshot, then continues observing. ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"closes the queue, consumes its final snapshot, and reports the first event","type":"text"},{"text":" ","type":"text"},{"text":"emitted after that boundary in both exhaustivity modes.","type":"text"}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"text":"Swift Testing currently attributes issues recorded inside an","type":"text"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"type":"codeV