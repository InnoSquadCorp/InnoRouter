{"abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"text":" ","type":"text"},{"type":"text","text":"finishes."}],"topicSections":[{"title":"Enumeration Cases","identifiers":["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict"],"generated":true,"anchor":"Enumeration-Cases"},{"identifiers":["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations"],"title":"Default Implementations","anchor":"Default-Implementations","generated":true}],"relationshipsSections":[{"identifiers":["doc:\/\/com.innosquad.innorouter.docs.deeplink\/SQ","doc:\/\/com.innosquad.innorouter.docs.deeplink\/SH","doc:\/\/com.innosquad.innorouter.docs.deeplink\/s8SendableP","doc:\/\/com.innosquad.innorouter.docs.deeplink\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"kind":"keyword","text":"enum"},{"text":" ","kind":"text"},{"kind":"identifier","text":"TestExhaustivity"}],"languages":["swift"],"platforms":["macOS"]}]},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"code":"TestStore","type":"codeVoice"},{"type":"text","text":" exhaustivity model:"},{"text":" ","type":"text"},{"text":"events collected from the underlying authority’s unified ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" ","type":"text"},{"text":"callback accumulate in an internal queue. Each","type":"text"},{"text":" ","type":"text"},{"code":"receive(...)","type":"codeVoice"},{"text":" call dequeues the next event and asserts a predicate. In","type":"text"},{"text":" ","type":"text"},{"text":"In ","type":"text"},{"code":".strict","type":"codeVoice"},{"text":" mode, the store reports events left pending at ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"deallocation.","type":"text"},{"text":" ","type":"text"},{"code":"assertNoPendingEvents()","type":"codeVoice"},{"text":" is a non-terminal checkpoint: it reports and","type":"text"},{"text":" ","type":"text"},{"text":"consumes the current pending snapshot, then continues observing. ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}]},{"style":"note","name":"Note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"type":"emphasis","inlineContent":[{"text":"unknown test","type":"text"}]},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}]}]}],"kind":"content"}],"variants":[{"paths":["\/documentation\/innoroutertesting\/testexhaustivity"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"TestExhaustivity","navigatorT