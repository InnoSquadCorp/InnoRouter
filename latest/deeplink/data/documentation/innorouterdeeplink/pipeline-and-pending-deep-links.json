{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Construction","anchor":"Construction"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Pass a matcher directly so matcher-specific input limits remain typed"},{"type":"text","text":" "},{"type":"text","text":"rejections and the pipeline can reuse its parsed URL:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/products\/:id\") { parameters in","        parameters.firstValue(forName: \"id\").map { .product(id: $0) }","    }","}","","let pipeline = DeepLinkPipeline(","    originPolicy: .allowlisted(","        schemes: [\"myapp\"],","        hosts: [\"app.example.com\"]","    ),","    matcher: matcher",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For routing rules that need the complete raw URL rather than pattern"},{"type":"text","text":" "},{"type":"text","text":"matching, use the explicit escape hatch:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let pipeline = DeepLinkPipeline<AppRoute>(","    originPolicy: .allowlisted(","        schemes: [\"myapp\"],","        hosts: [\"app.example.com\"]","    ),","    customResolver: { url in legacyRouter.route(for: url) }",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A custom resolver’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" result is "},{"type":"codeVoice","code":".unhandled"},{"type":"text","text":". Pipeline-level input limits"},{"type":"text","text":" "},{"type":"text","text":"still apply, but only the "},{"type":"codeVoice","code":"matcher:"},{"type":"text","text":" path can preserve matcher-specific limit"},{"type":"text","text":" "},{"type":"text","text":"violations."}]},{"text":"Always declare an origin policy","anchor":"Always-declare-an-origin-policy","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"Use "},{"code":"DeepLinkOriginPolicy.allowlisted(schemes:hosts:)","type":"codeVoice"},{"type":"text","text":" for every pipeline"},{"type":"text","text":" "},{"type":"text","text":"that receives attacker-controllable URLs — custom URL schemes, universal"},{"type":"text","text":" "},{"type":"text","text":"links, notifications, QR or NFC payloads. Choose "},{"code":".trustedInProcess","type":"codeVoice"},{"type":"text","text":" only"},{"type":"text","text":" "},{"type":"text","text":"when every incoming URL is constructed by your own process. The older"},{"type":"text","text":" "},{"type":"text","text":"optional-allowlist initializer remains source-compatible, but an omitted"},{"type":"text","text":" "},{"type":"text","text":"allowlist disables that admission check. The "},{"code":"@DeepLink","type":"codeVoice"},{"type":"text","text":" macro path enforces"},{"type":"text","text":" "},{"type":"text","text":"an allowlist at compile time ("},{"code":"E020","type":"codeVoice"},{"type":"text","text":")."}],"type":"paragraph"},{"type":"heading","text":"Pipeline stages","level":2,"anchor":"Pipeline-stages"},{"inlineContent":[{"type":"text","text":"A pipeline can:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"reject a URL when configured input limits are exceeded","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reject a URL by scheme or host"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"leave it unhandled"}]}]},{"content":[{"inlineContent":[{"text":"resolve it into a route","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"require authentication"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"convert the route into a "},{"type":"codeVoice","code":"NavigationPlan"}],"type":"paragraph"}]}]},{"level":2,"text":"Pending deep links","anchor":"Pending-deep-links","type":"heading"},{"inlineContent":[{"type":"text","text":"When authentication is required but not currently satisfied, the pipeline returns "},{"type":"codeVoice","code":"DeepLinkDecision.pending(_:)"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This is deliberate:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"the route that triggered authentication deferral is preserved","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the navigation plan is preserved"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"replay responsibility remains explicit at the app boundary"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"That keeps auth transitions and navigation transitions separate instead of blending them into one hidden side effect.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Planning","anchor":"Planning","type":"heading"},{"inlineContent":[{"type":"text","text":"The planner converts a route into the exact command list that should run after acceptance. This makes deep-link execution deterministic and testable."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Authentication checks the routes referenced by the produced"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":", including nested sequences and fallback commands."},{"type":"text","text":" "},{"type":"text","text":"If a custom planner returns no route-bearing commands, the pipeline"},{"type":"text","text":" "},{"type":"text","text":"falls back to the originally resolved route."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect handlers and coordinator bridges validate a produced"},{"type":"text","text":" "},{"code":"NavigationPlan","type":"codeVoice"},{"type":"text","text":" against the current "},{"code":"RouteStack","type":"codeVoice"},{"type":"text","text":" before executing it."},{"type":"text","text":" "},{"type":"text","text":"Plans that are obviously impossible, such as "},{"code":".pop","type":"codeVoice"},{"type":"text","text":" on an empty stack,"},{"type":"text","text":" "},{"type":"text","text":"surface as typed application rejections instead of partially running."}]}]}],"variants":[{"paths":["\/documentation\/innorouterdeeplink\/pipeline-and-pending-deep-links"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"title":"Pipeline and pending deep links","role":"article","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}]},"abstract":[{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":" is where URL acceptance and app policy meet."}],"kind":"article","sections":[],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Pipeline-and-Pending-Deep-Links","interfaceLanguage":"swift"},"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"type":"topic","role":"collection","abstract":[],"title":"InnoRouterTesting","kind":"symbol","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"title":"InnoRouterDeepLink","abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter."}],"type":"topic","role":"collectionGroup","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"}}}