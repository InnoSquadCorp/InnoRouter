{"sections":[],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Construction","level":2,"text":"Construction"},{"inlineContent":[{"type":"text","text":"Pass a matcher directly so matcher-specific input limits remain typed"},{"type":"text","text":" "},{"type":"text","text":"rejections and the pipeline can reuse its parsed URL:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/products\/:id\") { parameters in","        parameters.firstValue(forName: \"id\").map { .product(id: $0) }","    }","}","","let pipeline = DeepLinkPipeline(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app.example.com\"],","    matcher: matcher",")"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"For routing rules that need the complete raw URL rather than pattern"},{"type":"text","text":" "},{"type":"text","text":"matching, use the explicit escape hatch:"}],"type":"paragraph"},{"type":"codeListing","code":["let pipeline = DeepLinkPipeline<AppRoute>(","    customResolver: { url in legacyRouter.route(for: url) }",")"],"syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"A custom resolver’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" result is "},{"type":"codeVoice","code":".unhandled"},{"type":"text","text":". Pipeline-level input limits"},{"type":"text","text":" "},{"type":"text","text":"still apply, but only the "},{"type":"codeVoice","code":"matcher:"},{"type":"text","text":" path can preserve matcher-specific limit"},{"type":"text","text":" "},{"type":"text","text":"violations."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Pipeline-stages","text":"Pipeline stages"},{"inlineContent":[{"type":"text","text":"A pipeline can:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reject a URL when configured input limits are exceeded"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reject a URL by scheme or host"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"leave it unhandled"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"resolve it into a route"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"require authentication"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"convert the route into a "},{"type":"codeVoice","code":"NavigationPlan"}]}]}]},{"level":2,"type":"heading","anchor":"Pending-deep-links","text":"Pending deep links"},{"type":"paragraph","inlineContent":[{"type":"text","text":"When authentication is required but not currently satisfied, the pipeline returns "},{"code":"DeepLinkDecision.pending(_:)","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is deliberate:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the route that triggered authentication deferral is preserved"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the navigation plan is preserved"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"replay responsibility remains explicit at the app boundary"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That keeps auth transitions and navigation transitions separate instead of blending them into one hidden side effect."}]},{"type":"heading","level":2,"anchor":"Planning","text":"Planning"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The planner converts a route into the exact command list that should run after acceptance. This makes deep-link execution deterministic and testable."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Authentication checks the routes referenced by the produced"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":", including nested sequences and fallback commands."},{"type":"text","text":" "},{"type":"text","text":"If a custom planner returns no route-bearing commands, the pipeline"},{"type":"text","text":" "},{"text":"falls back to the originally resolved route.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Effect handlers and coordinator bridges validate a produced","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":" against the current "},{"code":"RouteStack","type":"codeVoice"},{"type":"text","text":" before executing it."},{"type":"text","text":" "},{"type":"text","text":"Plans that are obviously impossible, such as "},{"code":".pop","type":"codeVoice"},{"type":"text","text":" on an empty stack,"},{"type":"text","text":" "},{"type":"text","text":"surface as typed application rejections instead of partially running."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterdeeplink\/pipeline-and-pending-deep-links"]}],"abstract":[{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":" is where URL acceptance and app policy meet."}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Pipeline-and-Pending-Deep-Links"},"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"article","title":"Pipeline and pending deep links","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article"},"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"kind":"symbol","type":"topic","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","role":"collection","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"type":"topic","role":"collectionGroup","abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","kind":"article","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","title":"InnoRouterDeepLink"}}}