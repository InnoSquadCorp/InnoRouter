{"abstract":[{"code":"DeepLinkPipeline","type":"codeVoice"},{"text":" is where URL acceptance and app policy meet.","type":"text"}],"sections":[],"kind":"article","schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"paths":["\/documentation\/innorouterdeeplink\/pipeline-and-pending-deep-links"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"article","title":"Pipeline and pending deep links","roleHeading":"Article"},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Pipeline-and-Pending-Deep-Links","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Construction","type":"heading","anchor":"Construction"},{"inlineContent":[{"type":"text","text":"Pass a matcher directly so matcher-specific input limits remain typed"},{"type":"text","text":" "},{"type":"text","text":"rejections and the pipeline can reuse its parsed URL:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let matcher = DeepLinkMatcher<AppRoute> {","    DeepLinkMapping(\"\/products\/:id\") { parameters in","        parameters.firstValue(forName: \"id\").map { .product(id: $0) }","    }","}","","let pipeline = DeepLinkPipeline(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app.example.com\"],","    matcher: matcher",")"],"type":"codeListing"},{"inlineContent":[{"text":"For routing rules that need the complete raw URL rather than pattern","type":"text"},{"text":" ","type":"text"},{"text":"matching, use the explicit escape hatch:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let pipeline = DeepLinkPipeline<AppRoute>(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app.example.com\"],","    customResolver: { url in legacyRouter.route(for: url) }",")"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A custom resolver’s "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" result is "},{"type":"codeVoice","code":".unhandled"},{"type":"text","text":". Pipeline-level input limits"},{"type":"text","text":" "},{"type":"text","text":"still apply, but only the "},{"type":"codeVoice","code":"matcher:"},{"type":"text","text":" path can preserve matcher-specific limit"},{"type":"text","text":" "},{"type":"text","text":"violations."}]},{"type":"heading","level":3,"text":"Always pass allowlists for untrusted URLs","anchor":"Always-pass-allowlists-for-untrusted-URLs"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"allowedSchemes"},{"type":"text","text":" and "},{"type":"codeVoice","code":"allowedHosts"},{"type":"text","text":" default to "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", and "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" disables"},{"type":"text","text":" "},{"type":"text","text":"that admission check entirely. Any pipeline that receives"},{"type":"text","text":" "},{"type":"text","text":"attacker-controllable URLs — custom URL schemes, universal links, QR or"},{"type":"text","text":" "},{"type":"text","text":"NFC payloads — should pass both allowlists so the decision stays"},{"type":"text","text":" "},{"type":"text","text":"fail-closed. The "},{"type":"codeVoice","code":"@DeepLink"},{"type":"text","text":" macro path enforces an allowlist at compile"},{"type":"text","text":" "},{"type":"text","text":"time ("},{"type":"codeVoice","code":"E020"},{"type":"text","text":"); hand-rolled pipelines are expected to match that posture."},{"text":" ","type":"text"},{"text":"Omit the allowlists only when every incoming URL is constructed by your","type":"text"},{"text":" ","type":"text"},{"text":"own process.","type":"text"}]},{"type":"heading","anchor":"Pipeline-stages","text":"Pipeline stages","level":2},{"type":"paragraph","inlineContent":[{"text":"A pipeline can:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reject a URL when configured input limits are exceeded"}]}]},{"content":[{"inlineContent":[{"text":"reject a URL by scheme or host","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"leave it unhandled"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"resolve it into a route"}]}]},{"content":[{"inlineContent":[{"text":"require authentication","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"convert the route into a "},{"type":"codeVoice","code":"NavigationPlan"}],"type":"paragraph"}]}]},{"text":"Pending deep links","level":2,"anchor":"Pending-deep-links","type":"heading"},{"inlineContent":[{"text":"When authentication is required but not currently satisfied, the pipeline returns ","type":"text"},{"code":"DeepLinkDecision.pending(_:)","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"inlineContent":[{"text":"This is deliberate:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the route that triggered authentication deferral is preserved"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the navigation plan is preserved","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"replay responsibility remains explicit at the app boundary"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"That keeps auth transitions and navigation transitions separate instead of blending them into one hidden side effect."}]},{"level":2,"anchor":"Planning","type":"heading","text":"Planning"},{"type":"paragraph","inlineContent":[{"text":"The planner converts a route into the exact command list that should run after acceptance. This makes deep-link execution deterministic and testable.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Authentication checks the routes referenced by the produced","type":"text"},{"text":" ","type":"text"},{"code":"NavigationPlan","type":"codeVoice"},{"text":", including nested sequences and fallback commands.","type":"text"},{"text":" ","type":"text"},{"text":"If a custom planner returns no route-bearing commands, the pipeline","type":"text"},{"text":" ","type":"text"},{"text":"falls back to the originally resolved route.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Effect handlers and coordinator bridges validate a produced"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationPlan"},{"type":"text","text":" against the current "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" before executing it."},{"text":" ","type":"text"},{"text":"Plans that are obviously impossible, such as ","type":"text"},{"type":"codeVoice","code":".pop"},{"type":"text","text":" on an empty stack,"},{"type":"text","text":" "},{"type":"text","text":"surface as typed application rejections instead of partially running."}]}]}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter."}],"type":"topic","role":"collectionGroup","title":"InnoRouterDeepLink","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","kind":"article","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","abstract":[],"url":"\