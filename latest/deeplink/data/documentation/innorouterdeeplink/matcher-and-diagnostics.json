t","text":"Captured values stay available as strings through "},{"code":"firstValue(forName:)","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"values(forName:)","type":"codeVoice"},{"type":"text","text":". For common scalar types, use the typed overloads:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let id = parameters.firstValue(forName: \"id\", as: UUID.self)","let page = parameters.firstValue(forName: \"page\", as: Int.self)","let selectedTags = parameters.values(forName: \"tag\", as: String.self)"],"type":"codeListing"},{"text":"Match precedence","anchor":"Match-precedence","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Match precedence remains declaration-order based."}],"type":"paragraph"},{"inlineContent":[{"text":"That means:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"earlier patterns win"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"diagnostics do not change runtime behavior"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"ordering is still part of the matcher contract","type":"text"}]}]}],"type":"unorderedList"},{"level":2,"text":"Diagnostics","anchor":"Diagnostics","type":"heading"},{"inlineContent":[{"code":"DeepLinkMatcherConfiguration","type":"codeVoice"},{"text":" can surface diagnostics for common authoring mistakes:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"duplicate patterns","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"wildcard shadowing"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"non-terminal wildcards"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"invalid parameter names; parameter names must match","type":"text"},{"text":" ","type":"text"},{"code":"^[A-Za-z_][A-Za-z0-9_]*$","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"parameter-heavy patterns that subsume more specific later patterns"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Diagnostics are available for every matcher output. They are intended"},{"type":"text","text":" "},{"type":"text","text":"to catch ambiguous authoring early without changing the matcher’s"},{"type":"text","text":" "},{"type":"text","text":"runtime semantics."}],"type":"paragraph"},{"inlineContent":[{"text":"For release-readiness gates, use ","type":"text"},{"code":"DeepLinkMatcher(strict:)","type":"codeVoice"},{"text":" with either","type":"text"},{"text":" ","type":"text"},{"text":"a route or ","type":"text"},{"code":"FlowPlan<R>","type":"codeVoice"},{"text":" output. Strict initializers throw","type":"text"},{"text":" ","type":"text"},{"code":"DeepLinkMatcherStrictError","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"text":"the full diagnostic list instead of only logging warnings, and accept","type":"text"},{"text":" ","type":"text"},{"text":"the same ","type":"text"},{"code":"DeepLinkInputLimits","type":"codeVoice"},{"text":" guardrails used by non-strict matchers.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Input limits","anchor":"Input-limits","type":"heading"},{"type":"paragraph","inlineContent":[{"code":"DeepLinkInputLimits","type":"codeVoice"},{"text":" guards runtime URLs before matching. Configure it","type":"text"},{"text":" ","type":"text"},{"text":"on ","type":"text"},{"code":"DeepLinkMatcherConfiguration","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DeepLinkPipeline","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"code":"FlowDeepLinkPipeline","type":"codeVoice"},{"text":" to cap absolute URL length, path segment count,","type":"text"},{"text":" ","type":"text"},{"text":"and query item count. Direct matcher calls still return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" because","type":"text"},{"text":" ","type":"text"},{"text":"their public contract is optional. Pipeline and effect-handler paths","type":"text"},{"text":" ","type":"text"},{"text":"surface limit violations as typed","type":"text"},{"text":" ","type":"text"},{"code":"DeepLinkRejectionReason.inputLimitExceeded","type":"codeVoice"},{"text":" rejections instead of","type":"text"},{"text":" ","type":"text"},{"text":"“no match” outcomes when the pipeline receives the matcher through its","type":"text"},{"text":" ","type":"text"},{"code":"matcher:","type":"codeVoice"},{"text":" initializer. The ","type":"text"},{"code":"customResolver:","type":"codeVoice"},{"text":" escape hatch can surface only","type":"text"},{"text":" ","type":"text"},{"text":"the pipeline’s own limits because an optional resolver result does not carry","type":"text"},{"text":" ","type":"text"},{"text":"matcher-specific rejection information.","type":"text"}]}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Matcher-and-Diagnostics"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"title":"InnoRouterDeepLink","abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter."}],"type":"topic","role":"collectionGroup","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"type":"topic","role":"collection","abstract":[],"title":"InnoRouterTesting","kind":"symbol","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\