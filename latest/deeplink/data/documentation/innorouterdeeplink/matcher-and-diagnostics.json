{"abstract":[{"code":"DeepLinkMatcher","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"FlowDeepLinkMatcher","type":"codeVoice"},{"text":" are the URL-pattern front doors for deep-link routing.","type":"text"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Matcher and diagnostics","role":"article"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"variants":[{"paths":["\/documentation\/innorouterdeeplink\/matcher-and-diagnostics"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Pattern-model","level":2,"text":"Pattern model","type":"heading"},{"inlineContent":[{"type":"text","text":"Patterns support:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"literal segments","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"named parameters such as "},{"type":"codeVoice","code":":id"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"terminal wildcard ","type":"text"},{"code":"*","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This keeps matching simple and predictable for app routing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Wildcards are terminal-only. A pattern like ","type":"text"},{"type":"codeVoice","code":"\/api\/*\/users"},{"text":" is invalid:","type":"text"},{"text":" ","type":"text"},{"text":"it produces a ","type":"text"},{"type":"codeVoice","code":".nonTerminalWildcard(pattern:index:)"},{"text":" diagnostic and does","type":"text"},{"text":" ","type":"text"},{"text":"not match runtime paths.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Captured values stay available as strings through "},{"type":"codeVoice","code":"firstValue(forName:)"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"values(forName:)"},{"type":"text","text":". For common scalar types, use the typed overloads:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let id = parameters.firstValue(forName: \"id\", as: UUID.self)","let page = parameters.firstValue(forName: \"page\", as: Int.self)","let selectedTags = parameters.values(forName: \"tag\", as: String.self)"],"type":"codeListing"},{"anchor":"Match-precedence","level":2,"text":"Match precedence","type":"heading"},{"inlineContent":[{"text":"Match precedence remains declaration-order based.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That means:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"earlier patterns win"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"diagnostics do not change runtime behavior"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"ordering is still part of the matcher contract","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"anchor":"Diagnostics","level":2,"text":"Diagnostics","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"DeepLinkMatcherConfiguration"},{"type":"text","text":" can surface diagnostics for common authoring mistakes:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"duplicate patterns"}]}]},{"content":[{"inlineContent":[{"text":"wildcard shadowing","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"non-terminal wildcards"}]}]},{"content":[{"inlineContent":[{"text":"invalid parameter names; parameter names must match","type":"text"},{"text":" ","type":"text"},{"code":"^[A-Za-z_][A-Za-z0-9_]*$","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"parameter-heavy patterns that subsume more specific later patterns"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Diagnostics are available on both push-only and flow matchers. They"},{"type":"text","text":" "},{"type":"text","text":"are intended to catch ambiguous authoring early without changing the"},{"type":"text","text":" "},{"type":"text","text":"matcher’s runtime semantics."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For release-readiness gates, use the throwing strict initializers:"},{"type":"text","text":" "},{"type":"codeVoice","code":"DeepLinkMatcher(strict:)"},{"type":"text","text":" for push-only mappings and"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowDeepLinkMatcher(strict:)"},{"type":"text","text":" for mappings that expand into a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":". Strict initializers throw "},{"type":"codeVoice","code":"DeepLinkMatcherStrictError"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"the full diagnostic list instead of only logging warnings, and accept"},{"type":"text","text":" "},{"type":"text","text":"the same "},{"type":"codeVoice","code":"DeepLinkInputLimits"},{"type":"text","text":" guardrails used by non-strict matchers."}],"type":"paragraph"},{"anchor":"Input-limits","level":2,"text":"Input limits","type":"heading"},{"inlineContent":[{"code":"DeepLinkInputLimits","type":"codeVoice"},{"text":" guards runtime URLs before matching. Configure it","type":"text"},{"text":" ","type":"text"},{"text":"on ","type":"text"},{"code":"DeepLinkMatcherConfiguration","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DeepLinkPipeline","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"code":"FlowDeepLinkPipeline","type":"codeVoice"},{"text":" to cap absolute URL length, path segment count,","type":"text"},{"text":" ","type":"text"},{"text":"and query item count. Direct matcher calls still return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" because","type":"text"},{"text":" ","type":"text"},{"text":"their public contract is optional. Pipeline and effect-handler paths","type":"text"},{"text":" ","type":"text"},{"text":"surface limit violations as typed","type":"text"},{"text":" ","type":"text"},{"code":"DeepLinkRejectionReason.inputLimitExceeded","type":"codeVoice"},{"text":" rejections instead of","type":"text"},{"text":" ","type":"text"},{"text":"“no match” outcomes.","type":"text"}],"type":"paragraph"}]}],"kind":"article","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Matcher-and-Diagnostics"},"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"abstract":[],"role":"collection","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting","kind":"symbol"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"type":"topic","title":"InnoRouterDeepLink","kind":"article","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","abstract":[{"text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter.","type":"text"}],"role":"collectionGroup"}}}