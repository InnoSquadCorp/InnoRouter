"},{"text":"and ","type":"text"},{"code":"values(forName:)","type":"codeVoice"},{"text":". For common scalar types, use the typed overloads:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let id = parameters.firstValue(forName: \"id\", as: UUID.self)","let page = parameters.firstValue(forName: \"page\", as: Int.self)","let selectedTags = parameters.values(forName: \"tag\", as: String.self)"]},{"level":2,"text":"Match precedence","type":"heading","anchor":"Match-precedence"},{"inlineContent":[{"type":"text","text":"Match precedence remains declaration-order based."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That means:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"earlier patterns win","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"diagnostics do not change runtime behavior","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"ordering is still part of the matcher contract","type":"text"}]}]}]},{"level":2,"text":"Diagnostics","type":"heading","anchor":"Diagnostics"},{"inlineContent":[{"type":"codeVoice","code":"DeepLinkMatcherConfiguration"},{"text":" can surface diagnostics for common authoring mistakes:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"duplicate patterns","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"wildcard shadowing"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"non-terminal wildcards"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"invalid parameter names; parameter names must match"},{"type":"text","text":" "},{"code":"^[A-Za-z_][A-Za-z0-9_]*$","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"parameter-heavy patterns that subsume more specific later patterns","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Diagnostics are available on both push-only and flow matchers. They"},{"type":"text","text":" "},{"type":"text","text":"are intended to catch ambiguous authoring early without changing the"},{"type":"text","text":" "},{"type":"text","text":"matcher’s runtime semantics."}],"type":"paragraph"},{"inlineContent":[{"text":"For release-readiness gates, use the throwing strict initializers:","type":"text"},{"text":" ","type":"text"},{"code":"DeepLinkMatcher(strict:)","type":"codeVoice"},{"text":" for push-only mappings and","type":"text"},{"text":" ","type":"text"},{"code":"FlowDeepLinkMatcher(strict:)","type":"codeVoice"},{"text":" for mappings that expand into a","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":". Strict initializers throw ","type":"text"},{"code":"DeepLinkMatcherStrictError","type":"codeVoice"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"text":"the full diagnostic list instead of only logging warnings, and accept","type":"text"},{"text":" ","type":"text"},{"text":"the same ","type":"text"},{"code":"DeepLinkInputLimits","type":"codeVoice"},{"text":" guardrails used by non-strict matchers.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Input limits","type":"heading","anchor":"Input-limits"},{"inlineContent":[{"code":"DeepLinkInputLimits","type":"codeVoice"},{"text":" guards runtime URLs before matching. Configure it","type":"text"},{"text":" ","type":"text"},{"text":"on ","type":"text"},{"code":"DeepLinkMatcherConfiguration","type":"codeVoice"},{"text":", ","type":"text"},{"code":"DeepLinkPipeline","type":"codeVoice"},{"text":", or","type":"text"},{"text":" ","type":"text"},{"code":"FlowDeepLinkPipeline","type":"codeVoice"},{"text":" to cap absolute URL length, path segment count,","type":"text"},{"text":" ","type":"text"},{"text":"and query item count. Direct matcher calls still return ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" because","type":"text"},{"text":" ","type":"text"},{"text":"their public contract is optional. Pipeline and effect-handler paths","type":"text"},{"text":" ","type":"text"},{"text":"surface limit violations as typed","type":"text"},{"text":" ","type":"text"},{"code":"DeepLinkRejectionReason.inputLimitExceeded","type":"codeVoice"},{"text":" rejections instead of","type":"text"},{"text":" ","type":"text"},{"text":"“no match” outcomes.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"kind":"article","variants":[{"paths":["\/documentation\/innorouterdeeplink\/matcher-and-diagnostics"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Matcher-and-Diagnostics","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"kind":"symbol","role":"collection","title":"InnoRouterTesting","abstract":[],"type":"topic","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"abstract":[{"text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter.","type":"text"}],"role":"collectionGroup","title":"InnoRouterDeepLink","type":"topic","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","kind":"article"}}}