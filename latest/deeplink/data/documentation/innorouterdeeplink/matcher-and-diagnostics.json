{"schemaVersion":{"patch":0,"major":0,"minor":3},"sections":[],"abstract":[{"code":"DeepLinkMatcher","type":"codeVoice"},{"text":" is the URL-pattern front door for route and ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" deep-link outputs.","type":"text"}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Matcher-and-Diagnostics"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"metadata":{"title":"Matcher and diagnostics","roleHeading":"Article","role":"article","modules":[{"name":"InnoRouterTesting"}]},"variants":[{"paths":["\/documentation\/innorouterdeeplink\/matcher-and-diagnostics"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"content":[{"level":2,"text":"Pattern model","anchor":"Pattern-model","type":"heading"},{"inlineContent":[{"text":"Patterns support:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"literal segments"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"named parameters such as ","type":"text"},{"code":":id","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"terminal wildcard ","type":"text"},{"type":"codeVoice","code":"*"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"This keeps matching simple and predictable for app routing.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Wildcards are terminal-only. A pattern like "},{"type":"codeVoice","code":"\/api\/*\/users"},{"type":"text","text":" is invalid:"},{"type":"text","text":" "},{"type":"text","text":"it produces a "},{"type":"codeVoice","code":".nonTerminalWildcard(pattern:index:)"},{"type":"text","text":" diagnostic and does"},{"type":"text","text":" "},{"type":"text","text":"not match runtime paths."}],"type":"paragraph"},{"inlineContent":[{"text":"Captured values stay available as strings through ","type":"text"},{"code":"firstValue(forName:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"values(forName:)","type":"codeVoice"},{"text":". For common scalar types, use the typed overloads:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let id = parameters.firstValue(forName: \"id\", as: UUID.self)","let page = parameters.firstValue(forName: \"page\", as: Int.self)","let selectedTags = parameters.values(forName: \"tag\", as: String.self)"],"type":"codeListing"},{"level":2,"text":"Match precedence","type":"heading","anchor":"Match-precedence"},{"inlineContent":[{"text":"Match precedence remains declaration-order based.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That means:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"earlier patterns win","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"diagnostics do not change runtime behavior"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"ordering is still part of the matcher contract"}]}]}]},{"text":"Diagnostics","type":"heading","level":2,"anchor":"Diagnostics"},{"type":"paragraph","inlineContent":[{"code":"DeepLinkMatcherConfiguration","type":"codeVoice"},{"text":" can surface diagnostics for common authoring mistakes:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"duplicate patterns"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"wildcard shadowing"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"non-terminal wildcards"}]}]},{"content":[{"inlineContent":[{"text":"invalid parameter names; parameter names must match","type":"text"},{"text":" ","type":"text"},{"code":"^[A-Za-z_][A-Za-z0-9_]*$","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"parameter-heavy patterns that subsume more specific later patterns","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Diagnostics are available for every matcher output. They are intended"},{"type":"text","text":" "},{"type":"text","text":"to catch ambiguous authoring early without changing the matcher’s"},{"type":"text","text":" "},{"type":"text","text":"runtime semantics."}]},{"type":"paragraph","inlineContent":[{"text":"For release-readiness gates, use ","type":"text"},{"code":"DeepLinkMatcher(strict:)","type":"codeVoice"},{"type":"text","text":" with either"},{"type":"text","text":" "},{"type":"text","text":"a route or "},{"type":"codeVoice","code":"FlowPlan<R>"},{"type":"text","text":" output. Strict initializers throw"},{"type":"text","text":" "},{"type":"codeVoice","code":"DeepLinkMatcherStrictError"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"the full diagnostic list instead of only logging warnings, and accept"},{"type":"text","text":" "},{"type":"text","text":"the same "},{"type":"codeVoice","code":"DeepLinkInputLimits"},{"type":"text","text":" guardrails used by non-strict matchers."}]},{"text":"Input limits","type":"heading","level":2,"anchor":"Input-limits"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeepLinkInputLimits"},{"type":"text","text":" guards runtime URLs before matching. Configure it"},{"type":"text","text":" "},{"type":"text","text":"on "},{"type":"codeVoice","code":"DeepLinkMatcherConfiguration"},{"type":"text","text":", "},{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowDeepLinkPipeline"},{"type":"text","text":" to cap absolute URL length, path segment count,"},{"type":"text","text":" "},{"type":"text","text":"and query item count. Direct matcher calls still return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" because"},{"type":"text","text":" "},{"type":"text","text":"their public contract is optional. Pipeline and effect-handler paths"},{"type":"text","text":" "},{"type":"text","text":"surface limit violations as typed"},{"type":"text","text":" "},{"type":"codeVoice","code":"DeepLinkRejectionReason.inputLimitExceeded"},{"text":" rejections instead of","type":"text"},{"text":" ","type":"text"},{"text":"“no match” outcomes when the pipeline receives the matcher through its","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"matcher:"},{"text":" initializer. The ","type":"text"},{"type":"codeVoice","code":"customResolver:"},{"text":" escape hatch can surface only","type":"text"},{"text":" ","type":"text"},{"text":"the pipeline’s own limits because an optional resolver result does not carry","type":"text"},{"text":" ","type":"text"},{"text":"matcher-specific rejection information.","type":"text"}]}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter."}],"type":"topic","role":"collectionGroup","title":"InnoRouterDeepLink","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","kind":"article","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","abstract":[],"url":"\/documentation\/innoroutertesting","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\