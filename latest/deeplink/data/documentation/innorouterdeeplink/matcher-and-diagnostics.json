{"sections":[],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterdeeplink\/matcher-and-diagnostics"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"metadata":{"roleHeading":"Article","role":"article","title":"Matcher and diagnostics","modules":[{"name":"InnoRouterTesting"}]},"schemaVersion":{"minor":3,"major":0,"patch":0},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Matcher-and-Diagnostics","interfaceLanguage":"swift"},"abstract":[{"type":"codeVoice","code":"DeepLinkMatcher"},{"type":"text","text":" is the URL-pattern front door for route and "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" deep-link outputs."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Pattern-model","type":"heading","text":"Pattern model","level":2},{"inlineContent":[{"text":"Patterns support:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"literal segments"}]}]},{"content":[{"inlineContent":[{"text":"named parameters such as ","type":"text"},{"type":"codeVoice","code":":id"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"terminal wildcard ","type":"text"},{"type":"codeVoice","code":"*"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps matching simple and predictable for app routing."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wildcards are terminal-only. A pattern like "},{"type":"codeVoice","code":"\/api\/*\/users"},{"type":"text","text":" is invalid:"},{"type":"text","text":" "},{"type":"text","text":"it produces a "},{"type":"codeVoice","code":".nonTerminalWildcard(pattern:index:)"},{"type":"text","text":" diagnostic and does"},{"type":"text","text":" "},{"type":"text","text":"not match runtime paths."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Captured values stay available as strings through "},{"type":"codeVoice","code":"firstValue(forName:)"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"values(forName:)"},{"type":"text","text":". For common scalar types, use the typed overloads:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let id = parameters.firstValue(forName: \"id\", as: UUID.self)","let page = parameters.firstValue(forName: \"page\", as: Int.self)","let selectedTags = parameters.values(forName: \"tag\", as: String.self)"]},{"anchor":"Match-precedence","text":"Match precedence","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Match precedence remains declaration-order based."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That means:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"earlier patterns win"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"diagnostics do not change runtime behavior"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"ordering is still part of the matcher contract"}]}]}]},{"anchor":"Diagnostics","text":"Diagnostics","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"DeepLinkMatcherConfiguration"},{"type":"text","text":" can surface diagnostics for common authoring mistakes:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"duplicate patterns"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"wildcard shadowing"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"non-terminal wildcards"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"invalid parameter names; parameter names must match"},{"type":"text","text":" "},{"type":"codeVoice","code":"^[A-Za-z_][A-Za-z0-9_]*$"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"parameter-heavy patterns that subsume more specific later patterns"}]}]}]},{"inlineContent":[{"type":"text","text":"Diagnostics are available for every matcher output. They are intended"},{"type":"text","text":" "},{"type":"text","text":"to catch ambiguous authoring early without changing the matcher’s"},{"type":"text","text":" "},{"type":"text","text":"runtime semantics."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For release-readiness gates, use "},{"type":"codeVoice","code":"DeepLinkMatcher(strict:)"},{"type":"text","text":" with either"},{"type":"text","text":" "},{"type":"text","text":"a route or "},{"type":"codeVoice","code":"FlowPlan<R>"},{"type":"text","text":" output. Strict initializers throw"},{"type":"text","text":" "},{"type":"codeVoice","code":"DeepLinkMatcherStrictError"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"text","text":"the full diagnostic list instead of only logging warnings, and accept"},{"type":"text","text":" "},{"type":"text","text":"the same "},{"type":"codeVoice","code":"DeepLinkInputLimits"},{"type":"text","text":" guardrails used by non-strict matchers."}],"type":"paragraph"},{"anchor":"Input-limits","text":"Input limits","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"DeepLinkInputLimits"},{"type":"text","text":" guards runtime URLs before matching. Configure it"},{"type":"text","text":" "},{"type":"text","text":"on "},{"type":"codeVoice","code":"DeepLinkMatcherConfiguration"},{"type":"text","text":", "},{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":", or"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowDeepLinkPipeline"},{"type":"text","text":" to cap absolute URL length, path segment count,"},{"type":"text","text":" "},{"type":"text","text":"and query item count. Direct matcher calls still return "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" because"},{"type":"text","text":" "},{"type":"text","text":"their public contract is optional. Pipeline and effect-handler paths"},{"type":"text","text":" "},{"type":"text","text":"surface limit violations as typed"},{"type":"text","text":" "},{"type":"codeVoice","code":"DeepLinkRejectionReason.inputLimitExceeded"},{"type":"text","text":" rejections instead of"},{"type":"text","text":" "},{"type":"text","text":"“no match” outcomes when the pipeline receives the matcher through its"},{"type":"text","text":" "},{"type":"codeVoice","code":"matcher:"},{"type":"text","text":" initializer. The "},{"type":"codeVoice","code":"customResolver:"},{"type":"text","text":" escape hatch can surface only"},{"type":"text","text":" "},{"type":"text","text":"the pipeline’s own limits because an optional resolver result does not carry"},{"type":"text","text":" "},{"type":"text","text":"matcher-specific rejection information."}],"type":"paragraph"}]}],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"kind":"symbol","type":"topic","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","role":"collection","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"type":"topic","role":"collectionGroup","abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","kind":"article","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","title":"