{"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterdeeplink\/tutorial-flowdeeplinkpipeline"]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Tutorial-FlowDeepLinkPipeline","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Scenario","text":"Scenario"},{"inlineContent":[{"type":"codeVoice","code":"myapp:\/\/app\/home\/detail\/42"},{"text":" should land the user on the order detail","type":"text"},{"text":" ","type":"text"},{"text":"for order 42. ","type":"text"},{"type":"codeVoice","code":"myapp:\/\/app\/onboarding\/privacy"},{"text":" should open a privacy","type":"text"},{"text":" ","type":"text"},{"text":"sheet over the current screen. Authenticated routes like","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"myapp:\/\/app\/secure"},{"text":" defer until sign-in completes, then replay.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Push-only pipelines ("},{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":" → "},{"type":"codeVoice","code":"NavigationPlan<R>"},{"type":"text","text":") can’t"},{"type":"text","text":" "},{"type":"text","text":"express a URL that terminates on a modal. "},{"type":"codeVoice","code":"FlowDeepLinkPipeline"},{"type":"text","text":" "},{"type":"text","text":"solves that by emitting "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" — a single value holding both"},{"type":"text","text":" "},{"type":"text","text":"the navigation prefix and the tail sheet\/cover."}],"type":"paragraph"},{"anchor":"Routes","text":"Routes","type":"heading","level":2},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["enum AppRoute: Route {","    case home","    case detail(id: String)","    case comments(id: String)","    case privacyPolicy","    case secure","}"]},{"anchor":"Defining-the-matcher","text":"Defining the matcher","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"DeepLinkMapping"},{"type":"text","text":" handlers return a "},{"type":"strong","inlineContent":[{"text":"complete","type":"text"}]},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" so"},{"type":"text","text":" "},{"type":"text","text":"multi-segment URLs expand atomically. The shared pattern syntax uses"},{"type":"text","text":" "},{"type":"codeVoice","code":":parameter"},{"type":"text","text":" for captures, terminal "},{"type":"codeVoice","code":"*"},{"type":"text","text":" wildcard,"},{"type":"text","text":" "},{"type":"text","text":"path-only (host and scheme are filtered separately by the pipeline)."},{"type":"text","text":" "},{"type":"text","text":"Non-terminal wildcards such as "},{"type":"codeVoice","code":"\/store\/*\/receipt"},{"type":"text","text":" are invalid and"},{"type":"text","text":" "},{"type":"text","text":"surface diagnostics instead of matching."}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let matcher = DeepLinkMatcher<FlowPlan<AppRoute>> {","    DeepLinkMapping(\"\/home\") { _ in","        FlowPlan(steps: [.push(.home)])","    }","    DeepLinkMapping(\"\/home\/detail\/:id\") { params in","        guard let id = params.firstValue(forName: \"id\") else { return nil }","        return FlowPlan(steps: [.push(.home), .push(.detail(id: id))])","    }","    DeepLinkMapping(\"\/home\/detail\/:id\/comments\/:cid\") { params in","        guard let id = params.firstValue(forName: \"id\"),","              let cid = params.firstValue(forName: \"cid\") else { return nil }","        return FlowPlan(steps: [","            .push(.home),","            .push(.detail(id: id)),","            .push(.comments(id: cid))","        ])","    }","    DeepLinkMapping(\"\/onboarding\/privacy\") { _ in","        FlowPlan(steps: [.sheet(.privacyPolicy)])","    }","    DeepLinkMapping(\"\/secure\") { _ in","        FlowPlan(steps: [.push(.secure)])","    }","}"]},{"anchor":"Wiring-the-pipeline","type":"heading","level":2,"text":"Wiring the pipeline"},{"type":"paragraph","inlineContent":[{"code":"FlowDeepLinkPipeline","type":"codeVoice"},{"text":" composes scheme\/host validation,","type":"text"},{"text":" ","type":"text"},{"code":"DeepLinkAuthenticationPolicy","type":"codeVoice"},{"text":" (reused from the push-only surface),","type":"text"},{"text":" ","type":"text"},{"text":"and the matcher:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let pipeline = FlowDeepLinkPipeline<AppRoute>(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    matcher: matcher,","    authenticationPolicy: .required(","        shouldRequireAuthentication: { route in","            if case .secure = route { return true }","            return false","        },","        isAuthenticated: { SessionStore.shared.isAuthenticated }","    )",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For unguarded apps pass "},{"type":"codeVoice","code":".notRequired"},{"type":"text","text":" (the default) and skip the"},{"type":"text","text":" "},{"type":"text","text":"policy closure entirely."}]},{"anchor":"Applying-through-FlowStore","type":"heading","level":2,"text":"Applying through FlowStore"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowDeepLinkEffectHandler"},{"type":"text","text":" bridges the pipeline output into any"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlanApplier"},{"type":"text","text":". It also owns the pending slot, so keep the handler"},{"type":"text","text":" "},{"type":"text","text":"in a stable owner rather than rebuilding it inside a SwiftUI body."},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" already conforms:"}]},{"syntax":"swift skip doc-fragment","code":["import Foundation","import SwiftUI","import InnoRouter","import InnoRouterEffects","","private final class SessionStore {","    static let shared = SessionStore()","","    private let lock = NSLock()","    private var signedIn = false","","    var isAuthenticated: Bool {","        lock.withLock { signedIn }","    }","","    func markAuthenticated() {","        lock.withLock { signedIn = true }","    }","}","","@MainActor","private final class DeepLinkCoordinator {","    let flow: FlowStore<AppRoute>","    let handler: FlowDeepLinkEffectHandler<AppRoute>","    private let session: SessionStore","","    init(session: SessionStore = .shared) {","        self.session = session","        let flow = FlowStore<AppRoute>()","        self.flow = flow","","        let matcher = DeepLinkMatcher<FlowPlan<AppRoute>> {","            DeepLinkMapping(\"\/home\") { _ in","                FlowPlan(steps: [.push(.home)])","            }","            DeepLinkMapping(\"\/onboarding\/privacy\") { _ in","                FlowPlan(steps: [.sheet(.privacyPolicy)])","            }","            DeepLinkMapping(\"\/secure\") { _ in","                FlowPlan(steps: [.push(.secure)])","            }","        }","        let pipeline = FlowDeepLinkPipeline(","            allowedSchemes: [\"myapp\"],","            allowedHosts: [\"app\"],","            matcher: matcher,","            authenticationPolicy: .required(","                shouldRequireAuthentication: { route in","                    if case .secure = route { return true }","                    return false","                },","                isAuthenticated: { session.isAuthenticated }","            )","        )","        self.handler = FlowDeepLinkEffectHandler(","            pipeline: pipeline,","            applier: flow","        )","    }","","    func userDidSignIn() {","        session.markAuthenticated()","        _ = handler.resumePendingDeepLink()","    }","}","","@main","struct DemoApp: App {","    @State private var coordinator = DeepLinkCoordinator()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: coordinator.flow,","                destination: { route in","                    switch route {","                    case .home:","                        Text(\"Home\")","                    case .detail(let id):","                        Text(\"Detail \\(id)\")","                    case .comments(let id):","                        Text(\"Comments \\(id)\")","                    case .privacyPolicy:","                        Text(\"Privacy\")","                    case .secure:","                        Text(\"Secure\")","                    }","                },","                root: { Text(\"Root\") }","            )","            .onOpenURL { url in","                _ = coordinator.handler.handle(url)","            }","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"A single ","type":"text"},{"code":"handler.handle(url)","type":"codeVoice"},{"text":" call:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Runs scheme\/host validation."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Walks the matcher for a "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"Runs the authentication policy across the plan until it finds the","type":"text"},{"text":" ","type":"text"},{"text":"first protected route.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Either applies the plan through ","type":"text"},{"code":"flow.apply(_:)","type":"codeVoice"},{"text":" or stores it as","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"a "},{"type":"codeVoice","code":"FlowPendingDeepLink"},{"type":"text","text":"."}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Replaying-after-sign-in","level":2,"text":"Replaying after sign-in"},{"type":"paragraph","inlineContent":[{"text":"Once the user signs in, resume the pending deep link:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["func userDidSignIn() {","    coordinator.userDidSignIn()","}"]},{"type":"paragraph","inlineContent":[{"text":"The handler re-consults the authentication policy (now returning","type":"text"},{"text":" ","type":"text"},{"code":"true","type":"codeVoice"},{"text":"), drops the pending reference, and applies the plan atomically.","type":"text"},{"text":" ","type":"text"},{"text":"For an async gate (e.g. token refresh), use:","type":"text"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["await coordinator.handler.resumePendingDeepLinkIfAllowed { pending in","    \/\/ Return true once the refresh has produced a live session.","    await AuthService.shared.refreshTokenIfNeeded()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The handler keeps a single pending slot:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"a newly deferred URL replaces the older pending link","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"clearPendingDeepLink()"},{"text":" drops the slot explicitly","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"stale pending links (ones the user replaced by opening a different"},{"type":"text","text":" "},{"type":"text","text":"URL) are therefore dropped automatically"}],"type":"paragraph"}]}]},{"type":"heading","anchor":"Observing-the-chain","level":2,"text":"Observing the chain"},{"type":"paragraph","inlineContent":[{"text":"All three authorities surface on ","type":"text"},{"code":"FlowStore.events","type":"codeVoice"},{"text":" as one","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":". A single subscriber sees the batch execution on the"},{"type":"text","text":" "},{"type":"text","text":"navigation store, the modal presentation (if any), and the"},{"type":"text","text":" "},{"type":"text","text":"settled FlowStore-level event as one chain. "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" wraps inner"},{"type":"text","text":" "},{"type":"text","text":"navigation \/ modal events synchronously before emitting the"},{"type":"text","text":" "},{"type":"text","text":"flow-level event, so one subscriber can assert the same ordering that"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"type":"text","text":" observes. Capture the stream before starting"},{"type":"text","text":" "},{"type":"text","text":"its lifecycle-owned task so the subscriber exists before applying the link."}]},{"syntax":"swift skip doc-fragment","code":["let events = flow.events","let observationTask = Task { @MainActor in","    for await event in events {","        switch event {","        case .navigation(.batchExecuted(let result)):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .modal(.presented(let presentation)):","            analytics.track(\"deep_link_opened_modal\", [","                \"route\": String(describing: presentation.route)","            ])","        case .pathChanged(_, let new):","            analytics.track(\"flow_path\", [","                \"steps\": new.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Host-less-testing","text":"Host-less testing","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"type":"text","text":" wraps the same "},{"type":"codeVoice","code":"flowStore.apply"},{"type":"text","text":" path:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func multiSegmentURLRehydrates() {","    let store = FlowTestStore<AppRoute>()","    let handler = FlowDeepLinkEffectHandler(pipeline: pipeline, applier: store.store)","","    _ = handler.handle(URL(string: \"myapp:\/\/app\/home\/detail\/42\")!)","","    store.receiveNavigation { event in","        if case .batchExecuted = event { return true }","        return false","    }","    store.receivePathChanged { _, new in","        new == [.push(.home), .push(.detail(id: \"42\"))]","    }","}"],"type":"codeListing"},{"level":2,"anchor":"Next-steps","text":"Next steps","type":"heading"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"See the push-only ","type":"text"},{"code":"Tutorial-DeepLinkReconciliation","type":"codeVoice"},{"text":" ","type":"text"},{"text":"walk-through in the ","type":"text"},{"code":"InnoRouterSwiftUI","type":"codeVoice"},{"text":" catalog for apps that","type":"text"},{"text":" ","type":"text"},{"text":"don’t yet need modal-terminal URLs.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read the ","type":"text"},{"code":"Tutorial-LoginOnboarding","type":"codeVoice"},{"text":" guide in the","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterSwiftUI","type":"codeVoice"},{"text":" documentation catalog to see how the","type":"text"},{"text":" ","type":"text"},{"text":"authenticated-replay loop fits a greenfield flow that uses","type":"text"},{"text":" ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":" for a sign-up sheet.","type":"text"}]}]}],"type":"unorderedList"}]}],"abstract":[{"text":"Map a URL to a ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" with push prefix and optional modal"},{"type":"text","text":" "},{"type":"text","text":"terminal step, run it through authentication gating, and replay the"},{"type":"text","text":" "},{"text":"deferred link through ","type":"text"},{"type":"codeVoice","code":"FlowDeepLinkEffectHandler"},{"text":" — all in one","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"atomic "},{"code":"FlowStore.apply(_:)","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article","title":"Rehydrating Composite Flows from a URL"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"sections":[],"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter."}],"type":"topic","role":"collectionGroup","title":"InnoRouterDeepLink","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","kind":"article","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","abstract":[],"url":"\/documentation\/innoroutertesting","role":"collection","kind":"symbol","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"}}}