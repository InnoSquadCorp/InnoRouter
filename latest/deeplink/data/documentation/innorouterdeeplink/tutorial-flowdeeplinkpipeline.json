{"abstract":[{"text":"Map a URL to a ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":" with push prefix and optional modal","type":"text"},{"text":" ","type":"text"},{"text":"terminal step, run it through authentication gating, and replay the","type":"text"},{"text":" ","type":"text"},{"text":"deferred link through ","type":"text"},{"type":"codeVoice","code":"FlowDeepLinkEffectHandler"},{"text":" — all in one","type":"text"},{"text":" ","type":"text"},{"text":"atomic ","type":"text"},{"type":"codeVoice","code":"FlowStore.apply(_:)"},{"text":".","type":"text"}],"variants":[{"paths":["\/documentation\/innorouterdeeplink\/tutorial-flowdeeplinkpipeline"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Scenario","level":2,"type":"heading","anchor":"Scenario"},{"inlineContent":[{"code":"myapp:\/\/app\/home\/detail\/42","type":"codeVoice"},{"text":" should land the user on the order detail","type":"text"},{"text":" ","type":"text"},{"text":"for order 42. ","type":"text"},{"code":"myapp:\/\/app\/onboarding\/privacy","type":"codeVoice"},{"text":" should open a privacy","type":"text"},{"text":" ","type":"text"},{"text":"sheet over the current screen. Authenticated routes like","type":"text"},{"text":" ","type":"text"},{"code":"myapp:\/\/app\/secure","type":"codeVoice"},{"text":" defer until sign-in completes, then replay.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Push-only pipelines (","type":"text"},{"code":"DeepLinkPipeline","type":"codeVoice"},{"text":" → ","type":"text"},{"code":"NavigationPlan<R>","type":"codeVoice"},{"text":") can’t","type":"text"},{"text":" ","type":"text"},{"text":"express a URL that terminates on a modal. ","type":"text"},{"code":"FlowDeepLinkPipeline","type":"codeVoice"},{"text":" ","type":"text"},{"text":"solves that by emitting ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" — a single value holding both","type":"text"},{"text":" ","type":"text"},{"text":"the navigation prefix and the tail sheet\/cover.","type":"text"}],"type":"paragraph"},{"text":"Routes","level":2,"type":"heading","anchor":"Routes"},{"type":"codeListing","code":["enum AppRoute: Route {","    case home","    case detail(id: String)","    case comments(id: String)","    case privacyPolicy","    case secure","}"],"syntax":"swift skip doc-fragment"},{"text":"Defining the matcher","level":2,"type":"heading","anchor":"Defining-the-matcher"},{"inlineContent":[{"code":"DeepLinkMapping","type":"codeVoice"},{"text":" handlers return a ","type":"text"},{"inlineContent":[{"type":"text","text":"complete"}],"type":"strong"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" so","type":"text"},{"text":" ","type":"text"},{"text":"multi-segment URLs expand atomically. The shared pattern syntax uses","type":"text"},{"text":" ","type":"text"},{"code":":parameter","type":"codeVoice"},{"text":" for captures, terminal ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" wildcard,","type":"text"},{"text":" ","type":"text"},{"text":"path-only (host and scheme are filtered separately by the pipeline).","type":"text"},{"text":" ","type":"text"},{"text":"Non-terminal wildcards such as ","type":"text"},{"code":"\/store\/*\/receipt","type":"codeVoice"},{"text":" are invalid and","type":"text"},{"text":" ","type":"text"},{"text":"surface diagnostics instead of matching.","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let matcher = DeepLinkMatcher<FlowPlan<AppRoute>> {","    DeepLinkMapping(\"\/home\") { _ in","        FlowPlan(steps: [.push(.home)])","    }","    DeepLinkMapping(\"\/home\/detail\/:id\") { params in","        guard let id = params.firstValue(forName: \"id\") else { return nil }","        return FlowPlan(steps: [.push(.home), .push(.detail(id: id))])","    }","    DeepLinkMapping(\"\/home\/detail\/:id\/comments\/:cid\") { params in","        guard let id = params.firstValue(forName: \"id\"),","              let cid = params.firstValue(forName: \"cid\") else { return nil }","        return FlowPlan(steps: [","            .push(.home),","            .push(.detail(id: id)),","            .push(.comments(id: cid))","        ])","    }","    DeepLinkMapping(\"\/onboarding\/privacy\") { _ in","        FlowPlan(steps: [.sheet(.privacyPolicy)])","    }","    DeepLinkMapping(\"\/secure\") { _ in","        FlowPlan(steps: [.push(.secure)])","    }","}"],"syntax":"swift skip doc-fragment"},{"text":"Wiring the pipeline","level":2,"type":"heading","anchor":"Wiring-the-pipeline"},{"inlineContent":[{"code":"FlowDeepLinkPipeline","type":"codeVoice"},{"text":" composes scheme\/host validation,","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"DeepLinkAuthenticationPolicy"},{"type":"text","text":" (reused from the push-only surface),"},{"type":"text","text":" "},{"type":"text","text":"and the matcher:"}],"type":"paragraph"},{"type":"codeListing","code":["let pipeline = FlowDeepLinkPipeline<AppRoute>(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    matcher: matcher,","    authenticationPolicy: .required(","        shouldRequireAuthentication: { route in","            if case .secure = route { return true }","            return false","        },","        isAuthenticated: { SessionStore.shared.isAuthenticated }","    )",")"],"syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"For unguarded apps pass "},{"type":"codeVoice","code":".notRequired"},{"type":"text","text":" (the default) and skip the"},{"type":"text","text":" "},{"type":"text","text":"policy closure entirely."}],"type":"paragraph"},{"text":"Applying through FlowStore","level":2,"type":"heading","anchor":"Applying-through-FlowStore"},{"inlineContent":[{"type":"codeVoice","code":"FlowDeepLinkEffectHandler"},{"type":"text","text":" bridges the pipeline output into any"},{"type":"text","text":" "},{"code":"FlowPlanApplier","type":"codeVoice"},{"type":"text","text":". It also owns the pending slot, so keep the handler"},{"type":"text","text":" "},{"type":"text","text":"in a stable owner rather than rebuilding it inside a SwiftUI body."},{"type":"text","text":" "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" already conforms:"}],"type":"paragraph"},{"type":"codeListing","code":["import Foundation","import SwiftUI","import InnoRouter","import InnoRouterEffects","","private final class SessionStore {","    static let shared = SessionStore()","","    private let lock = NSLock()","    private var signedIn = false","","    var isAuthenticated: Bool {","        lock.withLock { signedIn }","    }","","    func markAuthenticated() {","        lock.withLock { signedIn = true }","    }","}","","@MainActor","private final class DeepLinkCoordinator {","    let flow: FlowStore<AppRoute>","    let handler: FlowDeepLinkEffectHandler<AppRoute>","    private let session: SessionStore","","    init(session: SessionStore = .shared) {","        self.session = session","        let flow = FlowStore<AppRoute>()","        self.flow = flow","","        let matcher = DeepLinkMatcher<FlowPlan<AppRoute>> {","            DeepLinkMapping(\"\/home\") { _ in","                FlowPlan(steps: [.push(.home)])","            }","            DeepLinkMapping(\"\/onboarding\/privacy\") { _ in","                FlowPlan(steps: [.sheet(.privacyPolicy)])","            }","            DeepLinkMapping(\"\/secure\") { _ in","                FlowPlan(steps: [.push(.secure)])","            }","        }","        let pipeline = FlowDeepLinkPipeline(","            originPolicy: .allowlisted(","                schemes: [\"myapp\"],","                hosts: [\"app\"]","            ),","            matcher: matcher,","            authenticationPolicy: .required(","                shouldRequireAuthentication: { route in","                    if case .secure = route { return true }","                    return false","                },","                isAuthenticated: { session.isAuthenticated }","            )","        )","        self.handler = FlowDeepLinkEffectHandler(","            pipeline: pipeline,","            applier: flow","        )","    }","","    func userDidSignIn() {","        session.markAuthenticated()","        _ = handler.resumePendingDeepLink()","    }","}","","@main","struct DemoApp: App {","    @State private var coordinator = DeepLinkCoordinator()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: coordinator.flow,","                destination: { route in","                    switch route {","                    case .home:","                        Text(\"Home\")","                    case .detail(let id):","                        Text(\"Detail \\(id)\")","                    case .comments(let id):","                        Text(\"Comments \\(id)\")","                    case .privacyPolicy:","                        Text(\"Privacy\")","                    case .secure:","                        Text(\"Secure\")","                    }","                },","                root: { Text(\"Root\") }","            )","            .onOpenURL { url in","                _ = coordinator.handler.handle(url)","            }","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"A single ","type":"text"},{"type":"codeVoice","code":"handler.handle(url)"},{"text":" call:","type":"text"}]},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Runs scheme\/host validation.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Walks the matcher for a ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Runs the authentication policy across the plan until it finds the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"first protected route."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Either applies the plan through "},{"code":"flow.apply(_:)","type":"codeVoice"},{"type":"text","text":" or stores it as"},{"type":"text","text":" "},{"type":"text","text":"a "},{"code":"FlowPendingDeepLink","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"type":"heading","level":2,"anchor":"Replaying-after-sign-in","text":"Replaying after sign-in"},{"inlineContent":[{"text":"Once the user signs in, resume the pending deep link:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["func userDidSignIn() {","    coordinator.userDidSignIn()","}"]},{"inlineContent":[{"text":"The handler re-consults the authentication policy (now returning","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"true"},{"text":"), drops the pending reference, and applies the plan atomically.","type":"text"},{"text":" ","type":"text"},{"text":"For an async gate (e.g. token refresh), use:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["await coordinator.handler.resumePendingDeepLinkIfAllowed { pending in","    \/\/ Return true once the refresh has produced a live session.","    await AuthService.shared.refreshTokenIfNeeded()","}"]},{"inlineContent":[{"text":"The handler keeps a single pending slot:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a newly deferred URL replaces the older pending link"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"clearPendingDeepLink()","type":"codeVoice"},{"type":"text","text":" drops the slot explicitly"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"stale pending links (ones the user replaced by opening a different"},{"type":"text","text":" "},{"type":"text","text":"URL) are therefore dropped automatically"}]}]}]},{"type":"heading","level":2,"anchor":"Observing-the-chain","text":"Observing the chain"},{"inlineContent":[{"text":"All three authorities surface on ","type":"text"},{"type":"codeVoice","code":"FlowStore.events"},{"text":" as one","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":". A single subscriber sees the batch execution on the","type":"text"},{"text":" ","type":"text"},{"text":"navigation store, the modal presentation (if any), and the","type":"text"},{"text":" ","type":"text"},{"text":"settled FlowStore-level event as one chain. ","type":"text"},{"type":"codeVoice","code":"FlowStore"},{"text":" wraps inner","type":"text"},{"text":" ","type":"text"},{"text":"navigation \/ modal events synchronously before emitting the","type":"text"},{"text":" ","type":"text"},{"text":"flow-level event, so one subscriber can assert the same ordering that","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"text":" observes. Capture the stream before starting","type":"text"},{"text":" ","type":"text"},{"text":"its lifecycle-owned task so the subscriber exists before applying the link.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let events = flow.events","let observationTask = Task { @MainActor in","    for await event in events {","        switch event {","        case .navigation(.batchExecuted(let result)):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .modal(.presented(let presentation)):","            analytics.track(\"deep_link_opened_modal\", [","                \"route\": String(describing: presentation.route)","            ])","        case .pathChanged(_, let new):","            analytics.track(\"flow_path\", [","                \"steps\": new.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"]},{"type":"heading","level":2,"anchor":"Host-less-testing","text":"Host-less testing"},{"inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"text":" wraps the same ","type":"text"},{"type":"codeVoice","code":"flowStore.apply"},{"text":" path:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["@Test","@MainActor","func multiSegmentURLRehydrates() {","    let store = FlowTestStore<AppRoute>()","    let handler = FlowDeepLinkEffectHandler(pipeline: pipeline, applier: store.store)","","    _ = handler.handle(URL(string: \"myapp:\/\/app\/home\/detail\/42\")!)","","    store.receiveNavigation { event in","        if case .batchExecuted = event { return true }","        return false","    }","    store.receivePathChanged { _, new in","        new == [.push(.home), .push(.detail(id: \"42\"))]","    }","}"]},{"type":"heading","level":2,"anchor":"Next-steps","text":"Next steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"See the push-only "},{"code":"Tutorial-DeepLinkReconciliation","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"walk-through in the "},{"code":"InnoRouterSwiftUI","type":"codeVoice"},{"type":"text","text":" catalog for apps that"},{"type":"text","text":" "},{"type":"text","text":"don’t yet need modal-terminal URLs."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read the "},{"code":"Tutorial-LoginOnboarding","type":"codeVoice"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"code":"InnoRouterSwiftUI","type":"codeVoice"},{"type":"text","text":" documentation catalog to see how the"},{"type":"text","text":" "},{"type":"text","text":"authenticated-replay loop fits a greenfield flow that uses"},{"type":"text","text":" "},{"code":"ChildCoordinator","type":"codeVoice"},{"type":"text","text":" for a sign-up sheet."}]}]}]}]}],"sections":[],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Tutorial-FlowDeepLinkPipeline","interfaceLanguage":"swift"},"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"Rehydrating Composite Flows from a URL","modules":[{"name":"InnoRouterTesting"}]},"schemaVersion":{"patch":0,"major":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"role":"collectionGroup","type":"topic","title":"InnoRouterDeepLink","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","kind":"article","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","abstract":[{"type":"text","text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter."}]},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"role":"collection","type":"topic","title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","kind":"symbol","url":"\/documentation\/innoroutertesting","abstract":[]}}}