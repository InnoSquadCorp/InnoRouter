{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/Tutorial-FlowDeepLinkPipeline"},"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterdeeplink\/tutorial-flowdeeplinkpipeline"]}],"sections":[],"primaryContentSections":[{"content":[{"text":"Scenario","type":"heading","anchor":"Scenario","level":2},{"type":"paragraph","inlineContent":[{"code":"myapp:\/\/app\/home\/detail\/42","type":"codeVoice"},{"text":" should land the user on the order detail","type":"text"},{"text":" ","type":"text"},{"text":"for order 42. ","type":"text"},{"code":"myapp:\/\/app\/onboarding\/privacy","type":"codeVoice"},{"text":" should open a privacy","type":"text"},{"text":" ","type":"text"},{"text":"sheet over the current screen. Authenticated routes like","type":"text"},{"text":" ","type":"text"},{"code":"myapp:\/\/app\/secure","type":"codeVoice"},{"text":" defer until sign-in completes, then replay.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Push-only pipelines ("},{"type":"codeVoice","code":"DeepLinkPipeline"},{"type":"text","text":" → "},{"type":"codeVoice","code":"NavigationPlan<R>"},{"type":"text","text":") can’t"},{"type":"text","text":" "},{"type":"text","text":"express a URL that terminates on a modal. "},{"type":"codeVoice","code":"FlowDeepLinkPipeline"},{"type":"text","text":" "},{"type":"text","text":"solves that by emitting "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" — a single value holding both"},{"type":"text","text":" "},{"type":"text","text":"the navigation prefix and the tail sheet\/cover."}]},{"level":2,"type":"heading","anchor":"Routes","text":"Routes"},{"type":"codeListing","code":["enum AppRoute: Route {","    case home","    case detail(id: String)","    case comments(id: String)","    case privacyPolicy","    case secure","}"],"syntax":"swift skip doc-fragment"},{"type":"heading","anchor":"Defining-the-matcher","level":2,"text":"Defining the matcher"},{"type":"paragraph","inlineContent":[{"code":"FlowDeepLinkMapping","type":"codeVoice"},{"text":" handlers return a ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"complete"}]},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" so","type":"text"},{"text":" ","type":"text"},{"text":"multi-segment URLs expand atomically. Pattern syntax matches","type":"text"},{"text":" ","type":"text"},{"code":"DeepLinkMapping","type":"codeVoice"},{"text":": ","type":"text"},{"code":":parameter","type":"codeVoice"},{"text":" for captures, terminal ","type":"text"},{"code":"*","type":"codeVoice"},{"text":" wildcard,","type":"text"},{"text":" ","type":"text"},{"text":"path-only (host and scheme are filtered separately by the pipeline).","type":"text"},{"text":" ","type":"text"},{"text":"Non-terminal wildcards such as ","type":"text"},{"code":"\/store\/*\/receipt","type":"codeVoice"},{"text":" are invalid and","type":"text"},{"text":" ","type":"text"},{"text":"surface diagnostics instead of matching.","type":"text"}]},{"type":"codeListing","code":["let matcher = FlowDeepLinkMatcher<AppRoute> {","    FlowDeepLinkMapping(\"\/home\") { _ in","        FlowPlan(steps: [.push(.home)])","    }","    FlowDeepLinkMapping(\"\/home\/detail\/:id\") { params in","        guard let id = params.firstValue(forName: \"id\") else { return nil }","        return FlowPlan(steps: [.push(.home), .push(.detail(id: id))])","    }","    FlowDeepLinkMapping(\"\/home\/detail\/:id\/comments\/:cid\") { params in","        guard let id = params.firstValue(forName: \"id\"),","              let cid = params.firstValue(forName: \"cid\") else { return nil }","        return FlowPlan(steps: [","            .push(.home),","            .push(.detail(id: id)),","            .push(.comments(id: cid))","        ])","    }","    FlowDeepLinkMapping(\"\/onboarding\/privacy\") { _ in","        FlowPlan(steps: [.sheet(.privacyPolicy)])","    }","    FlowDeepLinkMapping(\"\/secure\") { _ in","        FlowPlan(steps: [.push(.secure)])","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"heading","anchor":"Wiring-the-pipeline","level":2,"text":"Wiring the pipeline"},{"type":"paragraph","inlineContent":[{"code":"FlowDeepLinkPipeline","type":"codeVoice"},{"text":" composes scheme\/host validation,","type":"text"},{"text":" ","type":"text"},{"code":"DeepLinkAuthenticationPolicy","type":"codeVoice"},{"text":" (reused from the push-only surface),","type":"text"},{"text":" ","type":"text"},{"text":"and the matcher:","type":"text"}]},{"type":"codeListing","code":["let pipeline = FlowDeepLinkPipeline<AppRoute>(","    allowedSchemes: [\"myapp\"],","    allowedHosts: [\"app\"],","    matcher: matcher,","    authenticationPolicy: .required(","        shouldRequireAuthentication: { route in","            if case .secure = route { return true }","            return false","        },","        isAuthenticated: { SessionStore.shared.isAuthenticated }","    )",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"For unguarded apps pass ","type":"text"},{"code":".notRequired","type":"codeVoice"},{"text":" (the default) and skip the","type":"text"},{"text":" ","type":"text"},{"text":"policy closure entirely.","type":"text"}]},{"type":"heading","anchor":"Applying-through-FlowStore","level":2,"text":"Applying through FlowStore"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowDeepLinkEffectHandler"},{"type":"text","text":" bridges the pipeline output into any"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlanApplier"},{"type":"text","text":". It also owns the pending slot, so keep the handler"},{"type":"text","text":" "},{"type":"text","text":"in a stable owner rather than rebuilding it inside a SwiftUI body."},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" already conforms:"}]},{"type":"codeListing","code":["import Foundation","import SwiftUI","import InnoRouter","import InnoRouterDeepLinkEffects","","private final class SessionStore {","    static let shared = SessionStore()","","    private let lock = NSLock()","    private var signedIn = false","","    var isAuthenticated: Bool {","        lock.withLock { signedIn }","    }","","    func markAuthenticated() {","        lock.withLock { signedIn = true }","    }","}","","@MainActor","private final class DeepLinkCoordinator {","    let flow: FlowStore<AppRoute>","    let handler: FlowDeepLinkEffectHandler<AppRoute>","    private let session: SessionStore","","    init(session: SessionStore = .shared) {","        self.session = session","        let flow = FlowStore<AppRoute>()","        self.flow = flow","","        let matcher = FlowDeepLinkMatcher<AppRoute> {","            FlowDeepLinkMapping(\"\/home\") { _ in","                FlowPlan(steps: [.push(.home)])","            }","            FlowDeepLinkMapping(\"\/onboarding\/privacy\") { _ in","                FlowPlan(steps: [.sheet(.privacyPolicy)])","            }","            FlowDeepLinkMapping(\"\/secure\") { _ in","                FlowPlan(steps: [.push(.secure)])","            }","        }","        let pipeline = FlowDeepLinkPipeline(","            allowedSchemes: [\"myapp\"],","            allowedHosts: [\"app\"],","            matcher: matcher,","            authenticationPolicy: .required(","                shouldRequireAuthentication: { route in","                    if case .secure = route { return true }","                    return false","                },","                isAuthenticated: { session.isAuthenticated }","            )","        )","        self.handler = FlowDeepLinkEffectHandler(","            pipeline: pipeline,","            applier: flow","        )","    }","","    func userDidSignIn() {","        session.markAuthenticated()","        _ = handler.resumePendingDeepLink()","    }","}","","@main","struct DemoApp: App {","    @State private var coordinator = DeepLinkCoordinator()","","    var body: some Scene {","        WindowGroup {","            FlowHost(","                store: coordinator.flow,","                destination: { route in","                    switch route {","                    case .home:","                        Text(\"Home\")","                    case .detail(let id):","                        Text(\"Detail \\(id)\")","                    case .comments(let id):","                        Text(\"Comments \\(id)\")","                    case .privacyPolicy:","                        Text(\"Privacy\")","                    case .secure:","                        Text(\"Secure\")","                    }","                },","                root: { Text(\"Root\") }","            )","            .onOpenURL { url in","                _ = coordinator.handler.handle(url)","            }","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"A single ","type":"text"},{"code":"handler.handle(url)","type":"codeVoice"},{"text":" call:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Runs scheme\/host validation.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Walks the matcher for a ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Runs the authentication policy across the plan until it finds the","type":"text"},{"text":" ","type":"text"},{"text":"first protected route.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Either applies the plan through "},{"code":"flow.apply(_:)","type":"codeVoice"},{"type":"text","text":" or stores it as"},{"type":"text","text":" "},{"type":"text","text":"a "},{"code":"FlowPendingDeepLink","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"heading","anchor":"Replaying-after-sign-in","level":2,"text":"Replaying after sign-in"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once the user signs in, resume the pending deep link:"}]},{"type":"codeListing","code":["func userDidSignIn() {","    coordinator.userDidSignIn()","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The handler re-consults the authentication policy (now returning"},{"type":"text","text":" "},{"type":"codeVoice","code":"true"},{"type":"text","text":"), drops the pending reference, and applies the plan atomically."},{"type":"text","text":" "},{"type":"text","text":"For an async gate (e.g. token refresh), use:"}]},{"type":"codeListing","code":["await coordinator.handler.resumePendingDeepLinkIfAllowed { pending in","    \/\/ Return true once the refresh has produced a live session.","    await AuthService.shared.refreshTokenIfNeeded()","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The handler keeps a single pending slot:"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"a newly deferred URL replaces the older pending link"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"clearPendingDeepLink()"},{"text":" drops the slot explicitly","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"stale pending links (ones the user replaced by opening a different","type":"text"},{"text":" ","type":"text"},{"text":"URL) are therefore dropped automatically","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","anchor":"Observing-the-chain","level":2,"text":"Observing the chain"},{"type":"paragraph","inlineContent":[{"type":"text","text":"All three authorities surface on "},{"type":"codeVoice","code":"FlowStore.events"},{"type":"text","text":" as one"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncStream"},{"type":"text","text":". A single subscriber sees the batch execution on the"},{"type":"text","text":" "},{"type":"text","text":"navigation store, the modal presentation (if any), and the"},{"type":"text","text":" "},{"type":"text","text":"settled FlowStore-level event as one chain. "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":" wraps inner"},{"type":"text","text":" "},{"type":"text","text":"navigation \/ modal callbacks synchronously before emitting the"},{"type":"text","text":" "},{"type":"text","text":"flow-level event, so one subscriber can assert the same ordering the"},{"type":"text","text":" "},{"type":"text","text":"matching configuration callbacks observe."}]},{"type":"codeListing","code":["Task {","    for await event in flow.events {","        switch event {","        case .navigation(.batchExecuted(let result)):","            analytics.track(\"deep_link_applied\", [","                \"routes\": result.stateAfter.path.map(String.init(describing:))","            ])","        case .modal(.presented(let presentation)):","            analytics.track(\"deep_link_opened_modal\", [","                \"route\": String(describing: presentation.route)","            ])","        case .pathChanged(_, let new):","            analytics.track(\"flow_path\", [","                \"steps\": new.map(String.init(describing:))","            ])","        default:","            continue","        }","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"heading","anchor":"Host-less-testing","level":2,"text":"Host-less testing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"text":" wraps the same ","type":"text"},{"type":"codeVoice","code":"flowStore.apply"},{"text":" path:","type":"text"}]},{"type":"codeListing","code":["@Test","@MainActor","func multiSegmentURLRehydrates() {","    let store = FlowTestStore<AppRoute>()","    let handler = FlowDeepLinkEffectHandler(pipeline: pipeline, applier: store.store)","","    _ = handler.handle(URL(string: \"myapp:\/\/app\/home\/detail\/42\")!)","","    store.receiveNavigation { event in","        if case .batchExecuted = event { return true }","        return false","    }","    store.receivePathChanged { _, new in","        new == [.push(.home), .push(.detail(id: \"42\"))]","    }","}"],"syntax":"swift skip doc-fragment"},{"type":"heading","anchor":"Next-steps","level":2,"text":"Next steps"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"See the push-only ","type":"text"},{"code":"Tutorial-DeepLinkReconciliation","type":"codeVoice"},{"text":" ","type":"text"},{"text":"walk-through in the ","type":"text"},{"code":"InnoRouterSwiftUI","type":"codeVoice"},{"text":" catalog for apps that","type":"text"},{"text":" ","type":"text"},{"text":"don’t yet need modal-terminal URLs.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read the ","type":"text"},{"code":"Tutorial-LoginOnboarding","type":"codeVoice"},{"text":" guide in the","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterSwiftUI","type":"codeVoice"},{"text":" documentation catalog to see how the","type":"text"},{"text":" ","type":"text"},{"text":"authenticated-replay loop fits a greenfield flow that uses","type":"text"},{"text":" ","type":"text"},{"code":"ChildCoordinator","type":"codeVoice"},{"text":" for a sign-up sheet.","type":"text"}]}]}],"type":"unorderedList"}],"kind":"content"}],"abstract":[{"type":"text","text":"Map a URL to a "},{"code":"FlowPlan","type":"codeVoice"},{"type":"text","text":" with push prefix and optional modal"},{"type":"text","text":" "},{"type":"text","text":"terminal step, run it through authentication gating, and replay the"},{"type":"text","text":" "},{"type":"text","text":"deferred link through "},{"code":"FlowDeepLinkEffectHandler","type":"codeVoice"},{"type":"text","text":" — all in one"},{"type":"text","text":" "},{"type":"text","text":"atomic "},{"code":"FlowStore.apply(_:)","type":"codeVoice"},{"type":"text","text":"."}],"metadata":{"title":"Rehydrating Composite Flows from a URL","modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article"},"references":{"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterDeepLink/InnoRouterDeepLink":{"abstract":[{"text":"Pattern matching, pipeline planning, and pending deep-link handling for InnoRouter.","type":"text"}],"role":"collectionGroup","title":"InnoRouterDeepLink","type":"topic","url":"\/documentation\/innorouterdeeplink\/innorouterdeeplink","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterDeepLink\/InnoRouterDeepLink","kind":"article"},"doc://com.innosquad.innorouter.docs.deeplink/documentation/InnoRouterTesting":{"kind":"symbol","role":"collection","title":"InnoRouterTesting","abstract":[],"type":"topic","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.deeplink\/documentation\/InnoRouterTesting"}}}