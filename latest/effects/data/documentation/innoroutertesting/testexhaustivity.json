{"variants":[{"paths":["\/documentation\/innoroutertesting\/testexhaustivity"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.effects\/documentation\/InnoRouterTesting"]]},"sections":[],"kind":"symbol","schemaVersion":{"minor":3,"patch":0,"major":0},"abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"type":"text","text":" "},{"type":"text","text":"finishes."}],"topicSections":[{"identifiers":["doc:\/\/com.innosquad.innorouter.docs.effects\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","doc:\/\/com.innosquad.innorouter.docs.effects\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict"],"title":"Enumeration Cases","generated":true,"anchor":"Enumeration-Cases"},{"identifiers":["doc:\/\/com.innosquad.innorouter.docs.effects\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations"],"title":"Default Implementations","generated":true,"anchor":"Default-Implementations"}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.effects\/documentation\/InnoRouterTesting\/TestExhaustivity","interfaceLanguage":"swift"},"metadata":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TestExhaustivity","kind":"identifier"}],"symbolKind":"enum","roleHeading":"Enumeration","title":"TestExhaustivity","role":"symbol","remoteSource":{"url":"https:\/\/github.com\/InnoSquadCorp\/InnoRouter\/blob\/5.2.1\/Sources\/InnoRouterTesting\/TestExhaustivity.swift#L25","fileName":"TestExhaustivity.swift"},"navigatorTitle":[{"kind":"identifier","text":"TestExhaustivity"}],"modules":[{"name":"InnoRouterTesting"}],"externalID":"s:17InnoRouterTesting16TestExhaustivityO"},"relationshipsSections":[{"identifiers":["doc:\/\/com.innosquad.innorouter.docs.effects\/SQ","doc:\/\/com.innosquad.innorouter.docs.effects\/SH","doc:\/\/com.innosquad.innorouter.docs.effects\/s8SendableP","doc:\/\/com.innosquad.innorouter.docs.effects\/s16SendableMetatypeP"],"title":"Conforms To","type":"conformsTo","kind":"relationships"}],"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TestExhaustivity","kind":"identifier"}]}]},{"content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"type":"codeVoice","code":"TestStore"},{"type":"text","text":" exhaustivity model:"},{"type":"text","text":" "},{"type":"text","text":"events collected from the underlying authority’s unified "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"type":"codeVoice","code":".strict"},{"type":"text","text":" mode, the store reports events left pending at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}]},{"name":"Note","content":[{"inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"inlineContent":[{"text":"unknown test","type":"text"}],"type":"emphasis"},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}],"type":"paragraph"}],"style":"note","type":"aside"}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.effects/documentation/InnoRouterTesting/TestExhaustivity/strict":{"abstract":[{"type":"text","text":"Every observed event must be drained through "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation. Pending events fail the test. This is the"},{"type":"text","text":" "},{"type":"text","text":"default and matches TCA’s "},{"type":"codeVoice","code":"exhaustive"},{"type":"text","text":" semantics."}],"type":"topic","kind":"symbol","title":"TestExhaustivity.strict","url":"\/documentation\/innoroutertesting\/testexhaustivity\/strict","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"strict"}],"role":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.effects\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict"},"doc://com.innosquad.innorouter.docs.effects/s16SendableMetatypeP":{"type":"unresolvable","title":"Swift.SendableMetatype","identifier":"doc:\/\/com.innosquad.innorouter.docs.effects\/s