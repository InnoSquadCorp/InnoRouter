:"text"}]},"doc://com.innosquad.innorouter.docs.effects/SH":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.effects\/SH","type":"unresolvable","title":"Swift.Hashable"},"doc://com.innosquad.innorouter.docs.effects/documentation/InnoRouterTesting":{"type":"topic","title":"InnoRouterTesting","kind":"symbol","abstract":[],"url":"\/documentation\/innoroutertesting","role":"collection","identifier":"doc:\/\/com.innosquad.innorouter.docs.effects\/documentation\/InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.effects/SQ":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.effects\/SQ","title":"Swift.Equatable"},"doc://com.innosquad.innorouter.docs.effects/documentation/InnoRouterTesting/TestExhaustivity/Equatable-Implementations":{"abstract":[],"type":"topic","kind":"article","title":"Equatable Implementations","url":"\/documentation\/innoroutertesting\/testexhaustivity\/equatable-implementations","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.effects\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations"}}}