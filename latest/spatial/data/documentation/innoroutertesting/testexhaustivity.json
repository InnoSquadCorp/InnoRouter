de":"TestStore","type":"codeVoice"},{"text":" exhaustivity model:","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"events collected from the underlying authority’s unified "},{"type":"codeVoice","code":"onEvent"},{"text":" ","type":"text"},{"text":"callback accumulate in an internal queue. Each","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"receive(...)"},{"text":" call dequeues the next event and asserts a predicate. In","type":"text"},{"text":" ","type":"text"},{"text":"In ","type":"text"},{"type":"codeVoice","code":".strict"},{"text":" mode, the store reports events left pending at ","type":"text"},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}]},{"name":"Note","content":[{"inlineContent":[{"text":"Swift Testing currently attributes issues recorded inside an","type":"text"},{"text":" ","type":"text"},{"text":"isolated ","type":"text"},{"type":"codeVoice","code":"deinit"},{"text":" to an ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"unknown test"}]},{"text":" rather than to the test that","type":"text"},{"text":" ","type":"text"},{"text":"owned the store, which makes a deinit-time leftover-event failure","type":"text"},{"text":" ","type":"text"},{"text":"hard to locate. Until that is resolved upstream, await all work and end","type":"text"},{"text":" ","type":"text"},{"text":