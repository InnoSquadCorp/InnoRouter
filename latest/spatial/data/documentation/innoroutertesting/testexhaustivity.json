"},{"text":"isolated ","type":"text"},{"type":"codeVoice","code":"deinit"},{"text":" to an ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"unknown test","type":"text"}]},{"type":"text","text":" rather than to the test that"},{"text":" ","type":"text"},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"text":" ","type":"text"},{"text":"hard to locate. Until that is resolved upstream, await all work and end","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"text":". It runs the strict check with the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}],"type":"paragraph"}],"style":"note","type":"aside","name":"Note"}]}],"references":{"doc://com.innosquad.innorouter.docs.spatial/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","kind":"symbol","type":"topic","url":"\/documentation\/innoroutertesting","abstract":[],"role":"collection"},"doc://com.innosquad.innorouter.docs.spatial/documentation/InnoRouterTesting/TestExhaustivity/strict":{"url":"\/documentation\/innoroutertesting\/testexhaustivity\/strict","identifier":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict","title":"TestExhaustivity.strict","abstract":[{"type":"text","text":"Every observed event must be drained through "},{"code":"receive(...)","type":"codeVoice"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation. Pending events fail the test. This is the"},{"type":"text","text":" "},{"type":"text","text":"default and matches TCA’s "},{"code":"exhaustive","type":"codeVoice"},{"type":"text","text":" semantics."}],"kind":"symbol","fragments":[{"tex