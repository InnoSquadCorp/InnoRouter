{"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterSpatial\/Tutorial-VisionOSScenes","interfaceLanguage":"swift"},"metadata":{"title":"visionOS: macro-first app scenes","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","abstract":[{"type":"text","text":"Declare windows, volumetric windows, and immersive spaces in one route enum."},{"type":"text","text":" "},{"type":"text","text":"Install the generated scene tree once, then use route-typed environment actions"},{"type":"text","text":" "},{"type":"text","text":"from the views rendered by that tree."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterspatial\/tutorial-visionosscenes"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterSpatial\/InnoRouterSpatial"]]},"sections":[],"primaryContentSections":[{"content":[{"level":2,"anchor":"Why-scenes-use-a-separate-router","type":"heading","text":"Why scenes use a separate router"},{"inlineContent":[{"type":"text","text":"visionOS app scenes are not stack or modal destinations:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"a regular window uses ","type":"text"},{"type":"codeVoice","code":"WindowGroup(id:for:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"a volumetric window adds "},{"type":"codeVoice","code":"windowStyle(.volumetric)"},{"type":"text","text":" and a physical size"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"an immersive space uses ","type":"text"},{"type":"codeVoice","code":"ImmersiveSpace(id:)"},{"text":" and an immersion style","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Their SwiftUI open and dismiss actions are available only inside a scene’s","type":"text"},{"text":" ","type":"text"},{"text":"view hierarchy. ","type":"text"},{"type":"codeVoice","code":"@SceneRouter"},{"text":" generates that scene hierarchy and publishes one","type":"text"},{"text":" ","type":"text"},{"text":"route-typed authority, while ","type":"text"},{"type":"codeVoice","code":"@EnvironmentSceneRouter"},{"text":" keeps feature views","type":"text"},{"text":" ","type":"text"},{"text":"independent of the underlying SwiftUI action chosen for each route.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"1-Declare-the-scene-inventory","type":"heading","text":"1. Declare the scene inventory"},{"inlineContent":[{"type":"text","text":"Add the "},{"type":"codeVoice","code":"InnoRouterSpatial"},{"type":"text","text":" product to the visionOS app target and import it"},{"type":"text","text":" "},{"type":"text","text":"explicitly:"}],"type":"paragraph"},{"code":[".product(name: \"InnoRouterSpatial\", package: \"InnoRouter\")"],"syntax":"swift skip package-manifest-fragment","type":"codeListing"},{"code":["import SwiftUI","import InnoRouterSpatial","","@SceneRouter","enum AppScene {","    @Scene(.window)","    case main","","    @Scene(","        .volumetric(width: 0.6, height: 0.4, depth: 0.4),","        id: \"model\"","    )","    case model","","    @Scene(.immersive(style: .mixed))","    case theatre","","    var destination: some View {","        switch self {","        case .main:","            MainView()","        case .model:","            ModelView()","        case .theatre:","            TheatreView()","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every case is parameterless and has exactly one "},{"type":"codeVoice","code":"@Scene"},{"type":"text","text":". The style carries"},{"type":"text","text":" "},{"type":"text","text":"declaration metadata rather than request-time options:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".window"},{"text":" creates a regular value-based window","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".volumetric(width:height:depth:)"},{"type":"text","text":" creates a volumetric window whose positive"},{"type":"text","text":" "},{"type":"text","text":"finite dimensions are measured in metres"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".immersive(style:)"},{"text":" creates an immersive space","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"An explicit ","type":"text"},{"type":"codeVoice","code":"id"},{"text":" is optional and defaults to the case name. Supply one only","type":"text"},{"text":" ","type":"text"},{"text":"when the Swift case may be renamed while the system scene identifier must stay","type":"text"},{"text":" ","type":"text"},{"text":"stable.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The first case is the launch-preferred scene, so put a window or volume first"},{"type":"text","text":" "},{"type":"text","text":"for the normal launch path. Every live generated scene participates in host"},{"type":"text","text":" "},{"type":"text","text":"election. If the launch scene closes while another generated scene remains,"},{"type":"text","text":" "},{"type":"text","text":"that survivor is promoted and can still open any declared scene. The macro"},{"type":"text","text":" "},{"type":"text","text":"diagnoses missing annotations, associated values, duplicate IDs, conditional"},{"type":"text","text":" "},{"type":"text","text":"inventories, invalid sizes, and conflicting generated members at compile time."}],"type":"paragraph"},{"level":2,"anchor":"2-Install-the-generated-scene-tree","type":"heading","text":"2. Install the generated scene tree"},{"inlineContent":[{"type":"text","text":"Use the generated static "},{"type":"codeVoice","code":"scenes"},{"type":"text","text":" property as the app’s scene body:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    var body: some Scene {","        AppScene.scenes","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"That single line owns the common composition:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"one ","type":"text"},{"type":"codeVoice","code":"SceneStore<AppScene>"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one "},{"type":"codeVoice","code":"SceneRegistry<AppScene>"},{"type":"text","text":" built from the annotations"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"cooperative ","type":"text"},{"type":"codeVoice","code":"innoRouterSceneHost"},{"text":" wiring on every generated scene root","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"automatic dispatcher promotion when the elected scene disappears"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the matching ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"text":", volumetric style and size, or ","type":"text"},{"type":"codeVoice","code":"ImmersiveSpace"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Do not add a second store, host, or anchor around generated destinations. The","type":"text"},{"text":" ","type":"text"},{"text":"generated tree is the routing authority for that route type.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Immersive-first-launch","type":"heading","text":"Immersive-first launch"},{"inlineContent":[{"type":"text","text":"An immersive scene cannot normally dispatch until the system opens it. If the"},{"type":"text","text":" "},{"type":"text","text":"product truly launches directly into immersion, configure the app scene"},{"type":"text","text":" "},{"type":"text","text":"manifest with"},{"type":"text","text":" "},{"type":"codeVoice","code":"UIApplicationPreferredDefaultSceneSessionRole"},{"type":"text","text":" set to"},{"type":"text","text":" "},{"type":"codeVoice","code":"UISceneSessionRoleImmersiveSpaceApplication"},{"type":"text","text":", configure"},{"type":"text","text":" "},{"type":"codeVoice","code":"UISceneInitialImmersionStyle"},{"type":"text","text":" when needed, and acknowledge that external"},{"type":"text","text":" "},{"type":"text","text":"contract in source:"}],"type":"paragraph"},{"code":["@SceneRouter(immersiveLaunch: true)","enum ImmersiveAppScene {","    @Scene(.immersive(style: .full))","    case experience","","    var destination: some View {","        ExperienceView()","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The macro cannot inspect "},{"type":"codeVoice","code":"Info.plist"},{"type":"text","text":"; the argument only suppresses the"},{"type":"text","text":" "},{"type":"text","text":"immersive-primary warning after the application has configured that launch"},{"type":"text","text":" "},{"type":"text","text":"contract. It warns when the acknowledgement is unnecessary for a window- or"},{"type":"text","text":" "},{"type":"text","text":"volume-first router."}],"type":"paragraph"},{"level":2,"anchor":"3-Open-and-dismiss-scenes-from-views","type":"heading","text":"3. Open and dismiss scenes from views"},{"inlineContent":[{"type":"text","text":"Read the nearest matching scene router just as stack and modal views read"},{"type":"text","text":" "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":":"}],"type":"paragraph"},{"code":["struct SceneControls: View {","    @EnvironmentSceneRouter(AppScene.self) private var scenes","    @State private var modelWindow: ScenePresentation<AppScene>?","","    var body: some View {","        VStack {","            Button(\"Open model\") {","                modelWindow = scenes.open(.model)","            }","","            Button(\"Close model\") {","                if let modelWindow {","                    scenes.dismissWindow(modelWindow)","                }","            }","","            Button(\"Enter theatre\") {","                scenes.open(.theatre)","            }","","            Button(\"Leave theatre\") {","                scenes.dismissImmersive()","            }","        }","    }","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"open(_:)"},{"type":"text","text":" reads the route’s kind, ID, volumetric size, and immersive style"},{"type":"text","text":" "},{"type":"text","text":"from the generated registry. It returns a request handle for a window or"},{"type":"text","text":" "},{"type":"text","text":"volume, or an immersive presentation value; it is not a promise that the"},{"type":"text","text":" "},{"type":"text","text":"system completed the presentation. Use "},{"type":"codeVoice","code":"dismissWindow(_:)"},{"type":"text","text":" with a retained"},{"type":"text","text":" "},{"type":"text","text":"window or volume handle and "},{"type":"codeVoice","code":"dismissImmersive()"},{"type":"text","text":" for the active immersive"},{"type":"text","text":" "},{"type":"text","text":"space."}],"type":"paragraph"},{"inlineContent":[{"text":"Environment resolution is lazy. Merely rendering a view outside the generated","type":"text"},{"text":" ","type":"text"},{"text":"tree does not report an error; invoking an action without the matching route","type":"text"},{"text":" ","type":"text"},{"text":"authority applies ","type":"text"},{"type":"codeVoice","code":"EnvironmentMissingPolicy"},{"text":". The default fails loudly and","type":"text"},{"text":" ","type":"text"},{"text":"points back to installing ","type":"text"},{"type":"codeVoice","code":"AppScene.scenes"},{"text":". A deliberately degradable preview","type":"text"},{"text":" ","type":"text"},{"text":"or shared cross-platform view can opt into ","type":"text"},{"type":"codeVoice","code":".logAndDegrade"},{"text":" at its boundary.","type":"text"}],"type":"paragraph"},{"text":"Advanced: own the store and registry manually","type":"heading","level":2,"anchor":"Advanced-own-the-store-and-registry-manually"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use manual composition when the application must retain the store, observe"},{"type":"text","text":" "},{"type":"text","text":"scene events, inject a registry from another boundary, or control host and"},{"type":"text","text":" "},{"type":"text","text":"anchor placement directly. This is the plain Swift equivalent of the generated"},{"type":"text","text":" "},{"type":"text","text":"tree:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["import SwiftUI","import InnoRouterSpatial","","enum SpatialRoute: Route {","    case main","    case theatre","}","","private let spatialScenes = SceneRegistry<SpatialRoute>(","    .window(.main, id: \"main\"),","    .immersive(.theatre, id: \"theatre\", style: .mixed)",")","","@main","struct ManualSpatialApp: App {","    @State private var sceneStore = SceneStore<SpatialRoute>()","","    var body: some Scene {","        WindowGroup(id: \"main\", for: UUID.self) { $sceneID in","            ContentView()","                .innoRouterSceneHost(","                    sceneStore,","                    scenes: spatialScenes,","                    attachedTo: .main,","                    instanceID: sceneID","                )","        } defaultValue: {","            UUID()","        }","","        ImmersiveSpace(id: \"theatre\") {","            TheatreView()","                .innoRouterSceneAnchor(","                    sceneStore,","                    scenes: spatialScenes,","                    attachedTo: .theatre","                )","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Attach exactly one host per store and one anchor to every non-host scene:"}]},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Scene declaration","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"innoRouterSceneHost"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"innoRouterSceneAnchor"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Primary ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"text":" or volume","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Exactly once","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Never on the same scene","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Secondary ","type":"text"},{"type":"codeVoice","code":"WindowGroup"},{"text":" or volume","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"No","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Exactly once","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"ImmersiveSpace"}]}],[{"type":"paragraph","inlineContent":[{"text":"No, unless it is the configured immersive-first host","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Exactly once otherwise","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The host is the preferred dispatcher. Anchors reconcile system-driven"},{"type":"text","text":" "},{"type":"text","text":"appear\/disappear lifecycle and can temporarily dispatch for their own"},{"type":"text","text":" "},{"type":"text","text":"declaration if the host is gone. They reject cross-scene opens they cannot"},{"type":"text","text":" "},{"type":"text","text":"perform instead of pretending success. Value-based windows use the "},{"type":"codeVoice","code":"UUID"},{"type":"text","text":" "},{"type":"text","text":"provided by "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":"; immersive spaces use route-only host or anchor"},{"type":"text","text":" "},{"type":"text","text":"overloads."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"These fallback-anchor and duplicate-host recovery rules apply only to manual"},{"type":"text","text":" "},{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":" composition. A generated "},{"type":"codeVoice","code":"@SceneRouter"},{"type":"text","text":" tree attaches cooperative"},{"type":"text","text":" "},{"type":"text","text":"full-authority hosts to every live scene root; when the elected host disappears,"},{"type":"text","text":" "},{"type":"text","text":"a surviving generated host is promoted automatically."}]},{"text":"Observe manual scene lifecycle","type":"heading","level":3,"anchor":"Observe-manual-scene-lifecycle"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Manual ownership exposes "},{"type":"codeVoice","code":"SceneStore.events"},{"type":"text","text":". Capture the stream before"},{"type":"text","text":" "},{"type":"text","text":"starting its lifecycle task so observation is registered before the next"},{"type":"text","text":" "},{"type":"text","text":"request:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let events = sceneStore.events","let observationTask = Task { @MainActor in","    for await event in events {","        analytics.record(event)","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Scene lifecycle events are "},{"type":"codeVoice","code":"presented"},{"type":"text","text":", "},{"type":"codeVoice","code":"dismissed"},{"type":"text","text":", and "},{"type":"codeVoice","code":"rejected"},{"type":"text","text":"; a duplicate"},{"type":"text","text":" "},{"type":"text","text":"primary host additionally emits "},{"type":"codeVoice","code":"hostRegistrationRejected"},{"type":"text","text":". Rejections retain"},{"type":"text","text":" "},{"type":"text","text":"the original "},{"type":"codeVoice","code":"SceneIntent"},{"type":"text","text":" and distinguish undeclared routes, declaration"},{"type":"text","text":" "},{"type":"text","text":"mismatches, stale window handles, fallback-dispatch limits, and"},{"type":"text","text":" "},{"type":"text","text":"environment-returned failures such as user cancellation. The generated macro"},{"type":"text","text":" "},{"type":"text","text":"keeps its store private; promote to this manual shape when direct event"},{"type":"text","text":" "},{"type":"text","text":"observation is a requirement."}]},{"text":"Ornaments on any platform","type":"heading","level":2,"anchor":"Ornaments-on-any-platform"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"View.innoRouterOrnament(_:content:)"},{"type":"text","text":" attaches a SwiftUI ornament on visionOS"},{"type":"text","text":" "},{"type":"text","text":"and is a no-op on every other supported platform, so a shared call site can"},{"type":"text","text":" "},{"type":"text","text":"remain unconditional:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["ContentView()","    .innoRouterOrnament(","        OrnamentAnchor(anchor: .bottom, alignment: .center)","    ) {","        ControlBar()","    }"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"OrnamentAnchor"},{"type":"text","text":" remains serializable and testable even where the visual effect"},{"type":"text","text":" "},{"type":"text","text":"does not materialize."}]},{"text":"Compose beside in-scene routing","type":"heading","level":2,"anchor":"Compose-beside-in-scene-routing"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":" is intentionally not part of "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":". "},{"type":"codeVoice","code":"RouteStep"},{"type":"text","text":" describes"},{"type":"text","text":" "},{"type":"text","text":"push, sheet, and cover transitions inside one scene, while spatial routing"},{"type":"text","text":" "},{"type":"text","text":"opens or dismisses app-level scenes. An app can use "},{"type":"codeVoice","code":"@SceneRouter"},{"type":"text","text":" for its app"},{"type":"text","text":" "},{"type":"text","text":"scene inventory and a separate "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" host inside any generated scene. In"},{"type":"text","text":" "},{"type":"text","text":"the manual path it can own "},{"type":"codeVoice","code":"SceneStore<R>"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FlowStore<R>"},{"type":"text","text":" side by side; the"},{"type":"text","text":" "},{"type":"text","text":"route types may be shared or distinct according to the product boundary."}]}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.spatial/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","kind":"symbol","type":"topic","url":"\/documentation\/innoroutertesting","abstract":[],"role":"collection"},"doc://com.innosquad.innorouter.docs.spatial/documentation/InnoRouterSpatial/InnoRouterSpatial":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterSpatial\/InnoRouterSpatial","title":"InnoRouterSpatial","kind":"article","type":"topic","url":"\/documentation\/innorouterspatial\/innorouterspatial","abstract":[{"type":"text","text":"Macro-first scene routing for visionOS windows, volumes, immersive spaces, and"},{"type":"text","text":" "},{"type":"text","text":"ornaments."}],"role":"collectionGroup"}}}