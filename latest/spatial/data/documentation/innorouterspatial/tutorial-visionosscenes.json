{"schemaVersion":{"patch":0,"minor":3,"major":0},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Why-scenes-use-a-separate-router","text":"Why scenes use a separate router","type":"heading","level":2},{"inlineContent":[{"text":"visionOS app scenes are not stack or modal destinations:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"a regular window uses "},{"code":"WindowGroup(id:for:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"a volumetric window adds "},{"code":"windowStyle(.volumetric)","type":"codeVoice"},{"type":"text","text":" and a physical size"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"an immersive space uses "},{"code":"ImmersiveSpace(id:)","type":"codeVoice"},{"type":"text","text":" and an immersion style"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Their SwiftUI open and dismiss actions are available only inside a scene’s","type":"text"},{"text":" ","type":"text"},{"text":"view hierarchy. ","type":"text"},{"code":"@SceneRouter","type":"codeVoice"},{"text":" generates that scene hierarchy and publishes one","type":"text"},{"text":" ","type":"text"},{"text":"route-typed authority, while ","type":"text"},{"code":"@EnvironmentSceneRouter","type":"codeVoice"},{"text":" keeps feature views","type":"text"},{"text":" ","type":"text"},{"text":"independent of the underlying SwiftUI action chosen for each route.","type":"text"}],"type":"paragraph"},{"anchor":"1-Declare-the-scene-inventory","text":"1. Declare the scene inventory","type":"heading","level":2},{"inlineContent":[{"text":"Add the ","type":"text"},{"code":"InnoRouterSpatial","type":"codeVoice"},{"text":" product to the visionOS app target and import it","type":"text"},{"text":" ","type":"text"},{"text":"explicitly:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip package-manifest-fragment","code":[".product(name: \"InnoRouterSpatial\", package: \"InnoRouter\")"]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["import SwiftUI","import InnoRouterSpatial","","@SceneRouter","enum AppScene {","    @Scene(.window)","    case main","","    @Scene(","        .volumetric(width: 0.6, height: 0.4, depth: 0.4),","        id: \"model\"","    )","    case model","","    @Scene(.immersive(style: .mixed))","    case theatre","","    var destination: some View {","        switch self {","        case .main:","            MainView()","        case .model:","            ModelView()","        case .theatre:","            TheatreView()","        }","    }","}"]},{"inlineContent":[{"text":"Every case is parameterless and has exactly one ","type":"text"},{"code":"@Scene","type":"codeVoice"},{"text":". The style carries","type":"text"},{"text":" ","type":"text"},{"text":"declaration metadata rather than request-time options:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":".window","type":"codeVoice"},{"type":"text","text":" creates a regular value-based window"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".volumetric(width:height:depth:)","type":"codeVoice"},{"type":"text","text":" creates a volumetric window whose positive"},{"type":"text","text":" "},{"type":"text","text":"finite dimensions are measured in metres"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".immersive(style:)","type":"codeVoice"},{"type":"text","text":" creates an immersive space"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"An explicit ","type":"text"},{"code":"id","type":"codeVoice"},{"text":" is optional and defaults to the case name. Supply one only","type":"text"},{"text":" ","type":"text"},{"text":"when the Swift case may be renamed while the system scene identifier must stay","type":"text"},{"text":" ","type":"text"},{"text":"stable.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The first case is the launch-preferred scene, so put a window or volume first","type":"text"},{"text":" ","type":"text"},{"text":"for the normal launch path. Every live generated scene participates in host","type":"text"},{"text":" ","type":"text"},{"text":"election. If the launch scene closes while another generated scene remains,","type":"text"},{"text":" ","type":"text"},{"text":"that survivor is promoted and can still open any declared scene. The macro","type":"text"},{"text":" ","type":"text"},{"text":"diagnoses missing annotations, associated values, duplicate IDs, conditional","type":"text"},{"text":" ","type":"text"},{"text":"inventories, invalid sizes, and conflicting generated members at compile time.","type":"text"}]},{"text":"2. Install the generated scene tree","type":"heading","level":2,"anchor":"2-Install-the-generated-scene-tree"},{"type":"paragraph","inlineContent":[{"text":"Use the generated static ","type":"text"},{"code":"scenes","type":"codeVoice"},{"type":"text","text":" property as the app’s scene body:"}]},{"code":["@main","struct MyApp: App {","    var body: some Scene {","        AppScene.scenes","    }","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"That single line owns the common composition:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one "},{"code":"SceneStore<AppScene>","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"one "},{"code":"SceneRegistry<AppScene>","type":"codeVoice"},{"type":"text","text":" built from the annotations"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"cooperative "},{"code":"innoRouterSceneHost","type":"codeVoice"},{"type":"text","text":" wiring on every generated scene root"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"automatic dispatcher promotion when the elected scene disappears"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the matching "},{"code":"WindowGroup","type":"codeVoice"},{"type":"text","text":", volumetric style and size, or "},{"code":"ImmersiveSpace","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Do not add a second store, host, or anchor around generated destinations. The","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"generated tree is the routing authority for that route type."}],"type":"paragraph"},{"text":"Immersive-first launch","anchor":"Immersive-first-launch","level":3,"type":"heading"},{"inlineContent":[{"type":"text","text":"An immersive scene cannot normally dispatch until the system opens it. If the"},{"text":" ","type":"text"},{"type":"text","text":"product truly launches directly into immersion, configure the app scene"},{"text":" ","type":"text"},{"text":"manifest with","type":"text"},{"text":" ","type":"text"},{"code":"UIApplicationPreferredDefaultSceneSessionRole","type":"codeVoice"},{"text":" set to","type":"text"},{"text":" ","type":"text"},{"code":"UISceneSessionRoleImmersiveSpaceApplication","type":"codeVoice"},{"text":", configure","type":"text"},{"text":" ","type":"text"},{"code":"UISceneInitialImmersionStyle","type":"codeVoice"},{"text":" when needed, and acknowledge that external","type":"text"},{"text":" ","type":"text"},{"text":"contract in source:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["@SceneRouter(immersiveLaunch: true)","enum ImmersiveAppScene {","    @Scene(.immersive(style: .full))","    case experience","","    var destination: some View {","        ExperienceView()","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"The macro cannot inspect ","type":"text"},{"code":"Info.plist","type":"codeVoice"},{"text":"; the argument only suppresses the","type":"text"},{"text":" ","type":"text"},{"text":"immersive-primary warning after the application has configured that launch","type":"text"},{"text":" ","type":"text"},{"text":"contract. It warns when the acknowledgement is unnecessary for a window- or","type":"text"},{"text":" ","type":"text"},{"text":"volume-first router.","type":"text"}],"type":"paragraph"},{"level":2,"text":"3. Open and dismiss scenes from views","anchor":"3-Open-and-dismiss-scenes-from-views","type":"heading"},{"inlineContent":[{"text":"Read the nearest matching scene router just as stack and modal views read","type":"text"},{"text":" ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["struct SceneControls: View {","    @EnvironmentSceneRouter(AppScene.self) private var scenes","    @State private var modelWindow: ScenePresentation<AppScene>?","","    var body: some View {","        VStack {","            Button(\"Open model\") {","                modelWindow = scenes.open(.model)","            }","","            Button(\"Close model\") {","                if let modelWindow {","                    scenes.dismissWindow(modelWindow)","                }","            }","","            Button(\"Enter theatre\") {","                scenes.open(.theatre)","            }","","            Button(\"Leave theatre\") {","                scenes.dismissImmersive()","            }","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"code":"open(_:)","type":"codeVoice"},{"text":" reads the route’s kind, ID, volumetric size, and immersive style","type":"text"},{"text":" ","type":"text"},{"text":"from the generated registry. It returns a request handle for a window or","type":"text"},{"text":" ","type":"text"},{"text":"volume, or an immersive presentation value; it is not a promise that the","type":"text"},{"text":" ","type":"text"},{"text":"system completed the presentation. Use ","type":"text"},{"code":"dismissWindow(_:)","type":"codeVoice"},{"text":" with a retained","type":"text"},{"text":" ","type":"text"},{"text":"window or volume handle and ","type":"text"},{"code":"dismissImmersive()","type":"codeVoice"},{"text":" for the active immersive","type":"text"},{"text":" ","type":"text"},{"text":"space.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Environment resolution is lazy. Merely rendering a view outside the generated","type":"text"},{"text":" ","type":"text"},{"text":"tree does not report an error; invoking an action without the matching route","type":"text"},{"text":" ","type":"text"},{"text":"authority applies ","type":"text"},{"code":"EnvironmentMissingPolicy","type":"codeVoice"},{"text":". On visionOS the default fails","type":"text"},{"text":" ","type":"text"},{"text":"loudly and points back to installing ","type":"text"},{"code":"AppScene.scenes","type":"codeVoice"},{"text":"; a deliberately","type":"text"},{"text":" ","type":"text"},{"text":"degradable preview can opt into ","type":"text"},{"code":".logAndDegrade","type":"codeVoice"},{"text":" at its boundary. Off","type":"text"},{"text":" ","type":"text"},{"text":"visionOS no authority can exist, so shared cross-platform view code always","type":"text"},{"text":" ","type":"text"},{"text":"logs and degrades to a no-op without any opt-in.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Advanced: own the store and registry manually","anchor":"Advanced-own-the-store-and-registry-manually","type":"heading"},{"inlineContent":[{"text":"Use manual composition when the application must retain the store, observe","type":"text"},{"text":" ","type":"text"},{"text":"scene events, inject a registry from another boundary, or control host and","type":"text"},{"text":" ","type":"text"},{"text":"anchor placement directly. This is the plain Swift equivalent of the generated","type":"text"},{"text":" ","type":"text"},{"text":"tree:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["import SwiftUI","import InnoRouterSpatial","","enum SpatialRoute: Route {","    case main","    case theatre","}","","private let spatialScenes = SceneRegistry<SpatialRoute>(","    .window(.main, id: \"main\"),","    .immersive(.theatre, id: \"theatre\", style: .mixed)",")","","@main","struct ManualSpatialApp: App {","    @State private var sceneStore = SceneStore<SpatialRoute>()","","    var body: some Scene {","        WindowGroup(id: \"main\", for: UUID.self) { $sceneID in","            ContentView()","                .innoRouterSceneHost(","                    sceneStore,","                    scenes: spatialScenes,","                    attachedTo: .main,","                    instanceID: sceneID","                )","        } defaultValue: {","            UUID()","        }","","        ImmersiveSpace(id: \"theatre\") {","            TheatreView()","                .innoRouterSceneAnchor(","                    sceneStore,","                    scenes: spatialScenes,","                    attachedTo: .theatre","                )","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Attach exactly one host per store and one anchor to every non-host scene:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Scene declaration"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"innoRouterSceneHost"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"innoRouterSceneAnchor"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Primary "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" or volume"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Exactly once"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Never on the same scene"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Secondary "},{"type":"codeVoice","code":"WindowGroup"},{"type":"text","text":" or volume"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Exactly once"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"ImmersiveSpace"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No, unless it is the configured immersive-first host"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Exactly once otherwise"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"inlineContent":[{"text":"The host is the preferred dispatcher. Anchors reconcile system-driven","type":"text"},{"text":" ","type":"text"},{"text":"appear\/disappear lifecycle and can temporarily dispatch for their own","type":"text"},{"text":" ","type":"text"},{"text":"declaration if the host is gone. They reject cross-scene opens they cannot","type":"text"},{"text":" ","type":"text"},{"text":"perform instead of pretending success. Value-based windows use the ","type":"text"},{"code":"UUID","type":"codeVoice"},{"text":" ","type":"text"},{"text":"provided by ","type":"text"},{"code":"WindowGroup","type":"codeVoice"},{"text":"; immersive spaces use route-only host or anchor","type":"text"},{"text":" ","type":"text"},{"text":"overloads.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"These fallback-anchor and duplicate-host recovery rules apply only to manual","type":"text"},{"text":" ","type":"text"},{"code":"SceneStore","type":"codeVoice"},{"text":" composition. A generated ","type":"text"},{"code":"@SceneRouter","type":"codeVoice"},{"text":" tree attaches cooperative","type":"text"},{"text":" ","type":"text"},{"text":"full-authority hosts to every live scene root; when the elected host disappears,","type":"text"},{"text":" ","type":"text"},{"text":"a surviving generated host is promoted automatically.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Observe manual scene lifecycle","anchor":"Observe-manual-scene-lifecycle","type":"heading"},{"inlineContent":[{"text":"Manual ownership exposes ","type":"text"},{"code":"SceneStore.events","type":"codeVoice"},{"text":". Capture the stream before","type":"text"},{"text":" ","type":"text"},{"text":"starting its lifecycle task so observation is registered before the next","type":"text"},{"text":" ","type":"text"},{"text":"request:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let events = sceneStore.events","let observationTask = Task { @MainActor in","    for await event in events {","        analytics.record(event)","    }","}"],"type":"codeListing"},{"inlineContent":[{"text":"Scene lifecycle events are ","type":"text"},{"code":"presented","type":"codeVoice"},{"text":", ","type":"text"},{"code":"dismissed","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"rejected","type":"codeVoice"},{"text":"; a duplicate","type":"text"},{"text":" ","type":"text"},{"text":"primary host additionally emits ","type":"text"},{"code":"hostRegistrationRejected","type":"codeVoice"},{"text":". Rejections retain","type":"text"},{"text":" ","type":"text"},{"text":"the original ","type":"text"},{"code":"SceneIntent","type":"codeVoice"},{"text":" and distinguish undeclared routes, declaration","type":"text"},{"text":" ","type":"text"},{"text":"mismatches, stale window handles, fallback-dispatch limits, and","type":"text"},{"text":" ","type":"text"},{"text":"environment-returned failures such as user cancellation. The generated macro","type":"text"},{"text":" ","type":"text"},{"text":"keeps its store private; promote to this manual shape when direct event","type":"text"},{"text":" ","type":"text"},{"text":"observation is a requirement.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Ornaments on any platform","anchor":"Ornaments-on-any-platform","type":"heading"},{"inlineContent":[{"code":"View.innoRouterOrnament(_:content:)","type":"codeVoice"},{"text":" attaches a SwiftUI ornament on visionOS","type":"text"},{"text":" ","type":"text"},{"text":"and is a no-op on every other supported platform, so a shared call site can","type":"text"},{"text":" ","type":"text"},{"text":"remain unconditional:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["ContentView()","    .innoRouterOrnament(","        OrnamentAnchor(anchor: .bottom, alignment: .center)","    ) {","        ControlBar()","    }"],"type":"codeListing"},{"inlineContent":[{"code":"OrnamentAnchor","type":"codeVoice"},{"text":" remains serializable and testable even where the visual effect","type":"text"},{"text":" ","type":"text"},{"text":"does not materialize.","type":"text"}],"type":"paragraph"},{"anchor":"Compose-beside-in-scene-routing","level":2,"type":"heading","text":"Compose beside in-scene routing"},{"inlineContent":[{"code":"SceneStore","type":"codeVoice"},{"text":" is intentionally not part of ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":". ","type":"text"},{"code":"RouteStep","type":"codeVoice"},{"text":" describes","type":"text"},{"text":" ","type":"text"},{"text":"push, sheet, and cover transitions inside one scene, while spatial routing","type":"text"},{"text":" ","type":"text"},{"text":"opens or dismisses app-level scenes. An app can use ","type":"text"},{"code":"@SceneRouter","type":"codeVoice"},{"text":" for its app","type":"text"},{"text":" ","type":"text"},{"text":"scene inventory and a separate ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" host inside any generated scene. In","type":"text"},{"text":" ","type":"text"},{"text":"the manual path it can own ","type":"text"},{"code":"SceneStore<R>","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"FlowStore<R>","type":"codeVoice"},{"type":"text","text":" side by side; the"},{"type":"text","text":" "},{"type":"text","text":"route types may be shared or distinct according to the product boundary."}],"type":"paragraph"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterSpatial\/InnoRouterSpatial"]]},"variants":[{"paths":["\/documentation\/innorouterspatial\/tutorial-visionosscenes"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Declare windows, volumetric windows, and immersive spaces in one route enum.","type":"text"},{"text":" ","type":"text"},{"text":"Install the generated scene tree once, then use route-typed environment actions","type":"text"},{"text":" ","type":"text"},{"text":"from the views rendered by that tree.","type":"text"}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterSpatial\/Tutorial-VisionOSScenes","interfaceLanguage":"swift"},"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"visionOS: macro-first app scenes"},"kind":"article","references":{"doc://com.innosquad.innorouter.docs.spatial/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","abstract":[],"identifier":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterTesting","role":"collection","kind":"symbol"},"doc://com.innosquad.innorouter.docs.spatial/documentation/InnoRouterSpatial/InnoRouterSpatial":{"abstract":[{"text":"Macro-first scene routing for visionOS windows, volumes, immersive spaces, and","type":"text"},{"text":" ","type":"text"},{"text":"ornaments.","type":"text"}],"kind":"article","type":"topic","url":"\/documentation\/innorouterspatial\/innorouterspatial","identifier":"doc:\/\/com.innosquad.innorouter.docs.spatial\/documentation\/InnoRouterSpatial\/InnoRouterSpatial","role":"collectionGroup","title":"InnoRouterSpatial"}}}