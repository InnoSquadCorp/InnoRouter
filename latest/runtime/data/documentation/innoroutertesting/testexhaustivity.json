outertesting\/testexhaustivity"]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"declarations":[{"platforms":["macOS"],"tokens":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TestExhaustivity","kind":"identifier"}],"languages":["swift"]}],"kind":"declarations"},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"type":"codeVoice","code":"TestStore"},{"type":"text","text":" exhaustivity model:"},{"type":"text","text":" "},{"type":"text","text":"events collected from the underlying authority’s unified "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"text":"In ","type":"text"},{"type":"codeVoice","code":".strict"},{"type":"text","text":" mode, the store reports events left pending at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"type":"emphasis","inlineContent":[{"text":"unknown test","type":"text"}]},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}]}]}]}],"references":{"doc://com.innosquad.innorouter.docs.runtime/SQ":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/SQ","title":"Swift.Equatable"},"doc://com.innosquad.innorouter.docs.runtime/documentation/InnoRouterTesting/TestExhaustivity/Equatable-Implementations":{"kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations","type":"topic","role":"collectionGroup","abstract":[],"url":"\/documentation\/innoroutertesting\/testexhaustivity\/equatable-implementations","title":"Equatable Implementations"},"doc://com.innosquad.innorouter.docs.runtime/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","kind":"symbol","abstract":[],"role":"collection","type":"topic"},"doc://com.innosquad.innorouter.docs.runtime/documentation/InnoRouterTesting/TestExhaustivity/off":{"kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","type":"topic","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"off","kind":"identifier"}],"abstract":[{"type":"text","text":"The test store still delivers events through "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":", but pending"},{"type":"text","text":" "},{"type":"text","text":"events at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation are silently discarded. Explicit"},{"type":"text","text":" "},{"type":"text","text":"assertions and events emitted after "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" still report issues."},{"type":"text","text":" "},{"type":"text","text":"Useful for incremental migrations of large legacy suites."}],"url":"\/documentation\/innoroutertesting\/testexhaustivity\/off","title":"TestExhaustivity.off"},"doc://com.innosquad.innorouter.docs.runtime/documentation/InnoRouterTesting/TestExhaustivity/strict":{"kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict","type":"topic","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"strict","kind":"identifier"}],"abstract":[{"type":"text","text":"Every observed event must be drained through "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" before"},{"type":"text","text":" "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deallocation. Pending events fail the test. This is the"},{"type":"text","text":" "},{"type":"text","text":"default and matches TCA’s "},{"type":"codeVoice","code":"exhaustive"},{"type":"text","text":" semantics."}],"url":"\/documentation\/innoroutertesting\/testexhaustivity\/strict","title":"TestExhaustivity.strict"},"doc://com.innosquad.innorouter.docs.runtime/s16SendableMetatypeP":{"type":"unresolvable","identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/s