{"abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"type":"text","text":" "},{"type":"text","text":"finishes."}],"metadata":{"roleHeading":"Enumeration","role":"symbol","navigatorTitle":[{"kind":"identifier","text":"TestExhaustivity"}],"title":"TestExhaustivity","remoteSource":{"fileName":"TestExhaustivity.swift","url":"https:\/\/github.com\/InnoSquadCorp\/InnoRouter\/blob\/7.0.0\/Sources\/InnoRouterTesting\/TestExhaustivity.swift#L25"},"externalID":"s:17InnoRouterTesting16TestExhaustivityO","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TestExhaustivity","kind":"identifier"}],"symbolKind":"enum","modules":[{"name":"InnoRouterTesting"}]},"primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}],"languages":["swift"]}]},{"kind":"content","content":[{"level":2,"type":"heading","anchor":"overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"type":"codeVoice","code":"TestStore"},{"type":"text","text":" exhaustivity model:"},{"type":"text","text":" "},{"type":"text","text":"events collected from the underlying authority’s unified "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"type":"codeVoice","code":".strict"},{"type":"text","text":" mode, the store reports events left pending at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" "},{"text":"closes the queue, consumes its final snapshot, and reports the first event","type":"text"},{"type":"text","text":" "},{"text":"emitted after that boundary in both exhaustivity modes.","type":"text"}]},{"type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"Swift Testing currently attributes issues recorded inside an","type":"text"},{"text":" ","type":"text"},{"text":"isolated ","type":"text"},{"code":"deinit","type":"codeVoice"},{"text":" to an ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"unknown test"}]},{"text":" rather than to the test that","type":"text"},{"text":" ","type":"text"},{"text":"owned the store, which makes a deinit-time leftover-event failure","type":"text"},{"text":" ","type":"text"},{"text":"hard to locate. Until that is resolved upstream, await all work and end","type":"text"},{"text":" ","type":"text"},{"text":"each test with an explicit ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":". It runs the strict check with the","type":"text"},{"text":" ","type":"text"},{"text":"caller’s source location and disarms the deinit-time fallback.","type":"text"}]}],"style":"note"}]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/com.innosquad.innorouter.docs.runtime\/SQ","doc:\/\/com.innosquad.innorouter.docs.runtime\/SH","doc:\/\/com.innosquad.innorouter.docs.runtime\/s8SendableP","doc:\/\/com.innosquad.innorouter.docs.runtime\/s16SendableMetatypeP"]}],"variants":[{"paths":["\/documentation\/innoroutertesting\/testexhaustivity"],"traits":[{"interfaceLan