{"abstract":[{"type":"text","text":"InnoRouter 6 deliberately replaces the parallel 5.x routing authorities with"},{"type":"text","text":" "},{"type":"text","text":"one macro-first state\/store model. This is a breaking migration, not a set of"},{"type":"text","text":" "},{"type":"text","text":"deprecated aliases."}],"metadata":{"title":"Migrating to InnoRouter 6","modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Dependency","anchor":"Dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace granular runtime products with the umbrella product:"}]},{"type":"codeListing","code":[".product(name: \"InnoRouter\", package: \"InnoRouter\")"],"syntax":"swift skip package-manifest-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" and "},{"type":"codeVoice","code":"InnoRouterInspector"},{"type":"text","text":" only to targets that use them."}]},{"type":"heading","text":"Route declaration and host","level":2,"anchor":"Route-declaration-and-host"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before, an application could manually compose separate stack and modal stores."},{"type":"text","text":" "},{"type":"text","text":"In 6.0, declare destinations once and choose a native host:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["import InnoRouter","import SwiftUI","","@Router","enum AppRoute {","    case home","    case detail(id: String)","","    var destination: some View { \/* exhaustive switch *\/ }","}","","RouterHost(AppRoute.self) {","    AppRoute.destination(for: .home)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"AppRoute.makeRouterStore()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"RouterHost(store:)"},{"type":"text","text":" only when an app"},{"type":"text","text":" "},{"type":"text","text":"boundary must retain the authority."}]},{"text":"Feature metadata namespace","type":"heading","anchor":"Feature-metadata-namespace","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature mappings stay under "},{"type":"codeVoice","code":"AppRoute.Feature"},{"type":"text","text":", such as"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AppRoute.Feature.account"},{"text":". The generated structural metadata array is now","type":"text"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRoute.routerFeatureCatalog"},{"type":"text","text":". Replace any pre-release 6.0 source that read"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRoute.Feature.catalog"},{"type":"text","text":"; no compatibility alias is provided because it would"},{"type":"text","text":" "},{"type":"text","text":"again collide with a valid "},{"type":"codeVoice","code":"@FeatureRoute case catalog(ChildRoute)"},{"type":"text","text":" mapping."}]},{"type":"heading","anchor":"Request-vocabulary","text":"Request vocabulary","level":2},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"5.x","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"6.0","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"independent stack\/modal\/flow stores","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterStore<Route>"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"navigation, modal, and flow intents","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterAction<Route>"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"navigation and flow plans","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterPlan<Route>"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"direct inner-store mutation"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"await store.perform(action)"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"separate store event types","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"code":"RouterEvent<Route>","type":"codeVoice"},{"text":" with one transition ID","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"Named environment helpers such as ","type":"text"},{"type":"codeVoice","code":"go"},{"text":", ","type":"text"},{"type":"codeVoice","code":"back"},{"text":", ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"cover","type":"codeVoice"},{"text":" remain","type":"text"},{"text":" ","type":"text"},{"text":"convenient projections of ","type":"text"},{"code":"RouterAction","type":"codeVoice"},{"text":"; they do not form another public","type":"text"},{"text":" ","type":"text"},{"text":"request language.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The repository’s ","type":"text"},{"code":"MigrationSmoke","type":"codeVoice"},{"type":"text","text":" fixture compiles the exact published 5.2.1"},{"text":" ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" scenario and this 6.0 replacement as separate downstream","type":"text"},{"text":" ","type":"text"},{"text":"packages, then compares their encoded final path. It intentionally proves a","type":"text"},{"text":" ","type":"text"},{"text":"migration rather than preserving the removed type names.","type":"text"}]},{"level":2,"text":"Tabs and split layouts","anchor":"Tabs-and-split-layouts","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Replace per-tab stores with branches in one ","type":"text"},{"type":"codeVoice","code":"RouterState"},{"text":" tree. Apply","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"@TabItem"},{"type":"text","text":" only to parameterless tab roots; ordinary detail routes can remain"},{"type":"text","text":" "},{"type":"text","text":"unmarked in the same "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" enum. "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":" creates and scopes the"},{"type":"text","text":" "},{"type":"text","text":"branches. The macro-generated scope ID is based on the case name and is safe to"},{"type":"text","text":" "},{"type":"text","text":"persist across localization and reordering."}]},{"type":"paragraph","inlineContent":[{"text":"For an app-retained split tree, construct ","type":"text"},{"type":"codeVoice","code":"RouterContainerState(style: .split, ...)"},{"text":", create one ","type":"text"},{"type":"codeVoice","code":"RouterStore"},{"text":", and pass it to ","type":"text"},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterThreeColumnSplitHost"},{"type":"text","text":". "},{"type":"codeVoice","code":"RouterSplitState"},{"text":" persists native visibility and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"preferred compact column alongside the two- or three-column scope topology."}]},{"type":"heading","level":2,"text":"Async policy","anchor":"Async-policy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace middleware executors with ordered "},{"type":"codeVoice","code":"RouterPolicy"},{"type":"text","text":" values:"}]},{"code":["let policy = RouterPolicy<AppRoute>(name: \"session\") { transition in","    session.isAuthenticated ? .allow : .reject(\"authentication-required\")","}","","let store = try AppRoute.makeRouterStore(","    configuration: .init(policies: [policy])",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Policies inspect an immutable candidate. Do not mutate navigation or business"},{"type":"text","text":" "},{"type":"text","text":"state from a policy closure."}]},{"type":"paragraph","inlineContent":[{"text":"When approval must arrive later, return ","type":"text"},{"code":".deferRequest(id)","type":"codeVoice"},{"text":". The store releases","type":"text"},{"text":" ","type":"text"},{"text":"its execution lane and exposes payload-safe metadata in ","type":"text"},{"code":"deferredTransitions","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Resolve the request explicitly; unchanged-state resume is the default, and","type":"text"},{"text":" ","type":"text"},{"text":"rebasing on current state must be selected deliberately.","type":"text"}]},{"text":"Deep links","type":"heading","anchor":"Deep-links","level":2},{"type":"paragraph","inlineContent":[{"text":"Replace push-only or flow-only pipelines with ","type":"text"},{"code":"RouterLinkPipeline","type":"codeVoice"},{"text":". A route","type":"text"},{"text":" ","type":"text"},{"text":"matcher is promoted to an exact root-stack plan by default; pass a plan matcher","type":"text"},{"text":" ","type":"text"},{"text":"or planner closure for tabs, presentations, windows, or immersive state.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Authentication evaluates every route in the target tree. A pending decision","type":"text"},{"text":" ","type":"text"},{"text":"retains the complete plan, so replay does not reconstruct intent chains. Put","type":"text"},{"text":" ","type":"text"},{"text":"that value in ","type":"text"},{"code":"RouterPendingLinkSlot","type":"codeVoice"},{"text":", then call ","type":"text"},{"code":"resume(on:)","type":"codeVoice"},{"text":" after login;","type":"text"},{"text":" ","type":"text"},{"text":"replacement, cancellation, and rejection retention are explicit.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Authentication state may be isolated to any actor. Its closure and the final","type":"text"},{"text":" ","type":"text"},{"text":"decision are therefore asynchronous:","type":"text"}]},{"type":"codeListing","code":["let pipeline = RouterLinkPipeline<AppRoute>(","    originPolicy: originPolicy,","    matcher: matcher,","    authenticationPolicy: .required(","        shouldRequireAuthentication: { $0.requiresSession },","        isAuthenticated: { await session.isAuthenticated }","    )",")","","let decision = await pipeline.decide(for: url)"],"syntax":"swift skip doc-fragment"},{"text":"Persistence","type":"heading","anchor":"Persistence","level":2},{"type":"paragraph","inlineContent":[{"text":"Replace raw stack\/flow encoding with ","type":"text"},{"code":"RouterSnapshotCodec<Route>","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let codec = try RouterSnapshotCodec<AppRoute>(currentVersion: 2, migrations: [v1ToV2])","let data = try await store.snapshot(using: codec)","let result = try await store.restore(from: data, using: codec, recovery: .fail)"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"Migrations must be adjacent and deterministic. Choose ","type":"text"},{"code":".fail","type":"codeVoice"},{"text":" or an explicit","type":"text"},{"text":" ","type":"text"},{"text":"app fallback; 6.0 never silently restores an empty router.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Prefer ","type":"text"},{"code":"RouterSnapshotMigration.codable(from:to:decoding:transform:)","type":"codeVoice"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"text":"legacy payload has a known shape. It decodes an app-owned legacy DTO and","type":"text"},{"text":" ","type":"text"},{"text":"encodes the next payload with stable key ordering, avoiding fragile raw JSON","type":"text"},{"text":" ","type":"text"},{"text":"string rewrites.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Snapshot encoding and decoding execute away from the main actor. Restoration","type":"text"},{"text":" ","type":"text"},{"text":"also captures the current revision before loading and rejects the decoded plan","type":"text"},{"text":" ","type":"text"},{"text":"as stale if the live router commits while storage is being read.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When the app wants lifecycle-driven persistence, retain a","type":"text"},{"text":" ","type":"text"},{"code":"RouterRestorationDriver","type":"codeVoice"},{"text":" with an app-selected ","type":"text"},{"code":"RouterSnapshotStorage","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"attach ","type":"text"},{"code":"routerStateRestoration(_:)","type":"codeVoice"},{"text":" at the root. The driver still restores","type":"text"},{"text":" ","type":"text"},{"text":"through the canonical policy pipeline and does not select a cloud service or","type":"text"},{"text":" ","type":"text"},{"text":"storage location.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Persist an authentication continuation separately with","type":"text"},{"text":" ","type":"text"},{"code":"RouterPendingLinkPersistenceDriver","type":"codeVoice"},{"text":" and app-selected","type":"text"},{"text":" ","type":"text"},{"code":"RouterPendingLinkStorage","type":"codeVoice"},{"text":". It stores the exact pending plan, not the source URL","type":"text"},{"text":" ","type":"text"},{"text":"alone, and refuses to overwrite a newer in-memory submission after a slow load.","type":"text"}]},{"text":"Macro-first state reads","type":"heading","anchor":"Macro-first-state-reads","level":2},{"type":"paragraph","inlineContent":[{"text":"Keep ordinary destinations on ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":" for actions. Replace direct","type":"text"},{"text":" ","type":"text"},{"text":"store injection used only for UI state with ","type":"text"},{"code":"@EnvironmentRouterState","type":"codeVoice"},{"text":"; its","type":"text"},{"text":" ","type":"text"},{"code":"RouterStateReader","type":"codeVoice"},{"text":" exposes read-only stack, presentation, tab, badge, window,","type":"text"},{"text":" ","type":"text"},{"text":"and immersive projections from the same nearest scope.","type":"text"}]},{"text":"Result-bearing presentation","type":"heading","anchor":"Result-bearing-presentation","level":2},{"type":"paragraph","inlineContent":[{"text":"Replace child-coordinator callbacks with one exact presentation lifetime:","type":"text"}]},{"type":"codeListing","code":["let outcome: RouterPresentationOutcome<Profile> = await router.present(","    .profileEditor,","    expecting: Profile.self",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"The destination calls ","type":"text"},{"code":"finishPresentation(returning:)","type":"codeVoice"},{"text":". Treat ","type":"text"},{"code":".dismissed","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":".cancelled","type":"codeVoice"},{"text":", and ","type":"text"},{"code":".rejected","type":"codeVoice"},{"text":" as separate terminal states.","type":"text"}]},{"text":"Tests and inspection","type":"heading","anchor":"Tests-and-inspection","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace per-store test harnesses with "},{"type":"codeVoice","code":"RouterTestStore"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"RouterInspectorRecorder"},{"type":"text","text":" to the canonical "},{"type":"codeVoice","code":"RouterStore"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expect "},{"type":"codeVoice","code":"started"},{"type":"text","text":", one event per prepared policy, and one terminal event with"},{"type":"text","text":" "},{"type":"text","text":"the same transition identifier."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read source, animation, and metadata from the "},{"type":"codeVoice","code":"context"},{"type":"text","text":" carried by every"},{"type":"text","text":" "},{"type":"text","text":"terminal event; terminal diagnostics no longer infer "},{"type":"codeVoice","code":".programmatic"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Default inspector metadata is structural and redacted. Supply a formatter"},{"type":"text","text":" "},{"type":"text","text":"only when the app explicitly accepts payload exposure."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import exported sessions into the recorder or use "},{"type":"codeVoice","code":"RouterInspectorPlayback"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"RouterInspectorComparison"},{"type":"text","text":" for offline step-through diagnosis."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use bookmarks, correlated elapsed\/duration metadata, arbitrary state"},{"type":"text","text":" "},{"type":"text","text":"comparison, and pause-on-rejection to isolate a failing transition. JSON file"},{"type":"text","text":" "},{"type":"text","text":"import remains a developer-only, non-mutating workflow."}]}]}],"type":"unorderedList"},{"text":"Removed without an automatic adapter","type":"heading","anchor":"Removed-without-an-automatic-adapter","level":2},{"type":"paragraph","inlineContent":[{"text":"The 5.x coordinator callback lifecycle, modal queues, effect handlers, and","type":"text"},{"text":" ","type":"text"},{"text":"automatic scene ownership cannot be translated safely into aliases: they have","type":"text"},{"text":" ","type":"text"},{"text":"different lifetime and atomicity semantics. Move business effects outside the","type":"text"},{"text":" ","type":"text"},{"text":"router, model the visible target as ","type":"text"},{"code":"RouterState","type":"codeVoice"},{"text":", and invoke native window or","type":"text"},{"text":" ","type":"text"},{"text":"immersive APIs through a macro-generated ","type":"text"},{"code":"RouterSceneRoute","type":"codeVoice"},{"text":" catalog when","type":"text"},{"text":" ","type":"text"},{"text":"committed state changes. Scene actions on unconstrained route types are no","type":"text"},{"text":" ","type":"text"},{"text":"longer part of the public surface. Native open failures are repaired through","type":"text"},{"text":" ","type":"text"},{"text":"the normal reducer and event path, but that corrective removal cannot be","type":"text"},{"text":" ","type":"text"},{"text":"rejected by an application policy because the failed scene does not exist to","type":"text"},{"text":" ","type":"text"},{"text":"preserve.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Each native scene now owns a recursive ","type":"text"},{"code":"RouterNode","type":"codeVoice"},{"text":" within that same state.","type":"text"},{"text":" ","type":"text"},{"text":"Use the macro-generated typed ","type":"text"},{"code":"Route.Scene","type":"codeVoice"},{"text":" request and render the matching","type":"text"},{"text":" ","type":"text"},{"code":"RouterWindowHost","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"RouterImmersiveSpaceHost","type":"codeVoice"},{"text":"; do not host a second store in","type":"text"},{"text":" ","type":"text"},{"text":"the scene.","type":"text"}]}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouter\/migrating-to-innorouter-6"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouter\/Migrating-To-InnoRouter-6","interfaceLanguage":"swift"},"references":{"doc://com.innosquad.innorouter.docs.runtime/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","type":"topic","abstract":[],"url":"\/documentation\/innoroutertesting","kind":"symbol","role":"collection"}}}