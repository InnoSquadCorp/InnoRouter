{"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouter\/Migrating-To-InnoRouter-6","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"title":"Migrating to InnoRouter 6","roleHeading":"Article","role":"article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouter\/migrating-to-innorouter-6"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting"]]},"schemaVersion":{"patch":0,"minor":3,"major":0},"sections":[],"abstract":[{"type":"text","text":"InnoRouter 6 deliberately replaces the parallel 5.x routing authorities with"},{"type":"text","text":" "},{"type":"text","text":"one macro-first state\/store model. This is a breaking migration, not a set of"},{"type":"text","text":" "},{"type":"text","text":"deprecated aliases."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"anchor":"Dependency","type":"heading","text":"Dependency"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace granular runtime products with the umbrella product:"}]},{"syntax":"swift skip package-manifest-fragment","type":"codeListing","code":[".product(name: \"InnoRouter\", package: \"InnoRouter\")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" and "},{"type":"codeVoice","code":"InnoRouterInspector"},{"type":"text","text":" only to targets that use them."}]},{"level":2,"anchor":"Route-declaration-and-host","type":"heading","text":"Route declaration and host"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before, an application could manually compose separate stack and modal stores."},{"type":"text","text":" "},{"type":"text","text":"In 6.0, declare destinations once and choose a native host:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["import InnoRouter","import SwiftUI","","@Router","enum AppRoute {","    case home","    case detail(id: String)","","    var destination: some View { \/* exhaustive switch *\/ }","}","","RouterHost(AppRoute.self) {","    AppRoute.destination(for: .home)","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"AppRoute.makeRouterStore()"},{"type":"text","text":" and "},{"type":"codeVoice","code":"RouterHost(store:)"},{"type":"text","text":" only when an app"},{"type":"text","text":" "},{"type":"text","text":"boundary must retain the authority."}]},{"level":2,"anchor":"Feature-metadata-namespace","type":"heading","text":"Feature metadata namespace"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Feature mappings stay under "},{"type":"codeVoice","code":"AppRoute.Feature"},{"type":"text","text":", such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRoute.Feature.account"},{"type":"text","text":". The generated structural metadata array is now"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRoute.routerFeatureCatalog"},{"type":"text","text":". Replace any pre-release 6.0 source that read"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRoute.Feature.catalog"},{"type":"text","text":"; no compatibility alias is provided because it would"},{"type":"text","text":" "},{"type":"text","text":"again collide with a valid "},{"type":"codeVoice","code":"@FeatureRoute case catalog(ChildRoute)"},{"type":"text","text":" mapping."}]},{"level":2,"anchor":"Request-vocabulary","type":"heading","text":"Request vocabulary"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"5.x"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"6.0"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"independent stack\/modal\/flow stores"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterStore<Route>"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"navigation, modal, and flow intents"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterAction<Route>"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"navigation and flow plans"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterPlan<Route>"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"direct inner-store mutation"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"await store.perform(action)"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"separate store event types"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterEvent<Route>"},{"type":"text","text":" with one transition ID"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Named environment helpers such as "},{"type":"codeVoice","code":"go"},{"type":"text","text":", "},{"type":"codeVoice","code":"back"},{"type":"text","text":", "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":", and "},{"type":"codeVoice","code":"cover"},{"type":"text","text":" remain"},{"type":"text","text":" "},{"type":"text","text":"convenient projections of "},{"type":"codeVoice","code":"RouterAction"},{"type":"text","text":"; they do not form another public"},{"type":"text","text":" "},{"type":"text","text":"request language."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The repository’s "},{"type":"codeVoice","code":"MigrationSmoke"},{"type":"text","text":" fixture compiles the exact published 5.2.1"},{"type":"text","text":" "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" scenario and this 6.0 replacement as separate downstream"},{"type":"text","text":" "},{"type":"text","text":"packages, then compares their encoded final path. It intentionally proves a"},{"type":"text","text":" "},{"type":"text","text":"migration rather than preserving the removed type names."}]},{"level":2,"anchor":"Tabs-and-split-layouts","type":"heading","text":"Tabs and split layouts"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace per-tab stores with branches in one "},{"type":"codeVoice","code":"RouterState"},{"type":"text","text":" tree. Apply"},{"type":"text","text":" "},{"type":"codeVoice","code":"@TabItem"},{"type":"text","text":" only to parameterless tab roots; ordinary detail routes can remain"},{"type":"text","text":" "},{"type":"text","text":"unmarked in the same "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":" enum. "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":" creates and scopes the"},{"type":"text","text":" "},{"type":"text","text":"branches. The macro-generated scope ID is based on the case name and is safe to"},{"type":"text","text":" "},{"type":"text","text":"persist across localization and reordering."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an app-retained split tree, construct "},{"type":"codeVoice","code":"RouterContainerState(style: .split, ...)"},{"type":"text","text":", create one "},{"type":"codeVoice","code":"RouterStore"},{"type":"text","text":", and pass it to "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterThreeColumnSplitHost"},{"type":"text","text":". "},{"type":"codeVoice","code":"RouterSplitState"},{"type":"text","text":" persists native visibility and"},{"type":"text","text":" "},{"type":"text","text":"preferred compact column alongside the two- or three-column scope topology."}]},{"level":2,"anchor":"Async-policy","type":"heading","text":"Async policy"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace middleware executors with ordered "},{"type":"codeVoice","code":"RouterPolicy"},{"type":"text","text":" values:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let policy = RouterPolicy<AppRoute>(name: \"session\") { transition in","    session.isAuthenticated ? .allow : .reject(\"authentication-required\")","}","","let store = try AppRoute.makeRouterStore(","    configuration: .init(policies: [policy])",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Policies inspect an immutable candidate. Do not mutate navigation or business"},{"type":"text","text":" "},{"type":"text","text":"state from a policy closure."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When approval must arrive later, return "},{"type":"codeVoice","code":".deferRequest(id)"},{"type":"text","text":". The store releases"},{"type":"text","text":" "},{"type":"text","text":"its execution lane and exposes payload-safe metadata in "},{"type":"codeVoice","code":"deferredTransitions"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Resolve the request explicitly; unchanged-state resume is the default, and"},{"type":"text","text":" "},{"type":"text","text":"rebasing on current state must be selected deliberately."}]},{"level":2,"anchor":"Deep-links","type":"heading","text":"Deep links"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace push-only or flow-only pipelines with "},{"type":"codeVoice","code":"RouterLinkPipeline"},{"type":"text","text":". A route"},{"type":"text","text":" "},{"type":"text","text":"matcher is promoted to an exact root-stack plan by default; pass a plan matcher"},{"type":"text","text":" "},{"type":"text","text":"or planner closure for tabs, presentations, windows, or immersive state."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Authentication evaluates every route in the target tree. A pending decision"},{"type":"text","text":" "},{"type":"text","text":"retains the complete plan, so replay does not reconstruct intent chains. Put"},{"type":"text","text":" "},{"type":"text","text":"that value in "},{"type":"codeVoice","code":"RouterPendingLinkSlot"},{"type":"text","text":", then call "},{"type":"codeVoice","code":"resume(on:)"},{"type":"text","text":" after login;"},{"type":"text","text":" "},{"type":"text","text":"replacement, cancellation, and rejection retention are explicit."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Authentication state may be isolated to any actor. Its closure and the final"},{"type":"text","text":" "},{"type":"text","text":"decision are therefore asynchronous:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let pipeline = RouterLinkPipeline<AppRoute>(","    originPolicy: originPolicy,","    matcher: matcher,","    authenticationPolicy: .required(","        shouldRequireAuthentication: { $0.requiresSession },","        isAuthenticated: { await session.isAuthenticated }","    )",")","","let decision = await pipeline.decide(for: url)"]},{"level":2,"anchor":"Persistence","type":"heading","text":"Persistence"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace raw stack\/flow encoding with "},{"type":"codeVoice","code":"RouterSnapshotCodec<Route>"},{"type":"text","text":":"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let codec = try RouterSnapshotCodec<AppRoute>(currentVersion: 2, migrations: [v1ToV2])","let data = try await store.snapshot(using: codec)","let result = try await store.restore(from: data, using: codec, recovery: .fail)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Migrations must be adjacent and deterministic. Choose "},{"type":"codeVoice","code":".fail"},{"type":"text","text":" or an explicit"},{"type":"text","text":" "},{"type":"text","text":"app fallback; 6.0 never silently restores an empty router."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer "},{"type":"codeVoice","code":"RouterSnapshotMigration.codable(from:to:decoding:transform:)"},{"type":"text","text":" when the"},{"type":"text","text":" "},{"type":"text","text":"legacy payload has a known shape. It decodes an app-owned legacy DTO and"},{"type":"text","text":" "},{"type":"text","text":"encodes the next payload with stable key ordering, avoiding fragile raw JSON"},{"type":"text","text":" "},{"type":"text","text":"string rewrites."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Snapshot encoding and decoding execute away from the main actor. Restoration"},{"type":"text","text":" "},{"type":"text","text":"also captures the current revision before loading and rejects the decoded plan"},{"type":"text","text":" "},{"type":"text","text":"as stale if the live router commits while storage is being read."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the app wants lifecycle-driven persistence, retain a"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterRestorationDriver"},{"type":"text","text":" with an app-selected "},{"type":"codeVoice","code":"RouterSnapshotStorage"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"attach "},{"type":"codeVoice","code":"routerStateRestoration(_:)"},{"type":"text","text":" at the root. The driver still restores"},{"type":"text","text":" "},{"type":"text","text":"through the canonical policy pipeline and does not select a cloud service or"},{"type":"text","text":" "},{"type":"text","text":"storage location."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Persist an authentication continuation separately with"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterPendingLinkPersistenceDriver"},{"type":"text","text":" and app-selected"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterPendingLinkStorage"},{"type":"text","text":". It stores the exact pending plan, not the source URL"},{"type":"text","text":" "},{"type":"text","text":"alone, and refuses to overwrite a newer in-memory submission after a slow load."}]},{"level":2,"anchor":"Macro-first-state-reads","type":"heading","text":"Macro-first state reads"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep ordinary destinations on "},{"type":"codeVoice","code":"@EnvironmentRouter"},{"type":"text","text":" for actions. Replace direct"},{"type":"text","text":" "},{"type":"text","text":"store injection used only for UI state with "},{"type":"codeVoice","code":"@EnvironmentRouterState"},{"type":"text","text":"; its"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterStateReader"},{"type":"text","text":" exposes read-only stack, presentation, tab, badge, window,"},{"type":"text","text":" "},{"type":"text","text":"and immersive projections from the same nearest scope."}]},{"level":2,"anchor":"Result-bearing-presentation","type":"heading","text":"Result-bearing presentation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace child-coordinator callbacks with one exact presentation lifetime:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let outcome: RouterPresentationOutcome<Profile> = await router.present(","    .profileEditor,","    expecting: Profile.self",")"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The destination calls "},{"type":"codeVoice","code":"finishPresentation(returning:)"},{"type":"text","text":". Treat "},{"type":"codeVoice","code":".dismissed"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":".cancelled"},{"type":"text","text":", and "},{"type":"codeVoice","code":".rejected"},{"type":"text","text":" as separate terminal states."}]},{"level":2,"anchor":"Tests-and-inspection","type":"heading","text":"Tests and inspection"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Replace per-store test harnesses with ","type":"text"},{"code":"RouterTestStore","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Attach ","type":"text"},{"code":"RouterInspectorRecorder","type":"codeVoice"},{"text":" to the canonical ","type":"text"},{"code":"RouterStore","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Expect ","type":"text"},{"code":"started","type":"codeVoice"},{"text":", one event per prepared policy, and one terminal event with","type":"text"},{"text":" ","type":"text"},{"text":"the same transition identifier.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read source, animation, and metadata from the ","type":"text"},{"code":"context","type":"codeVoice"},{"text":" carried by every","type":"text"},{"text":" ","type":"text"},{"text":"terminal event; terminal diagnostics no longer infer ","type":"text"},{"code":".programmatic","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Default inspector metadata is structural and redacted. Supply a formatter"},{"type":"text","text":" "},{"type":"text","text":"only when the app explicitly accepts payload exposure."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Import exported sessions into the recorder or use "},{"type":"codeVoice","code":"RouterInspectorPlayback"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"RouterInspectorComparison"},{"type":"text","text":" for offline step-through diagnosis."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Use bookmarks, correlated elapsed\/duration metadata, arbitrary state"},{"type":"text","text":" "},{"type":"text","text":"comparison, and pause-on-rejection to isolate a failing transition. JSON file"},{"type":"text","text":" "},{"type":"text","text":"import remains a developer-only, non-mutating workflow."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Removed-without-an-automatic-adapter","type":"heading","text":"Removed without an automatic adapter"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The 5.x coordinator callback lifecycle, modal queues, effect handlers, and"},{"type":"text","text":" "},{"type":"text","text":"automatic scene ownership cannot be translated safely into aliases: they have"},{"type":"text","text":" "},{"type":"text","text":"different lifetime and atomicity semantics. Move business effects outside the"},{"type":"text","text":" "},{"type":"text","text":"router, model the visible target as "},{"type":"codeVoice","code":"RouterState"},{"type":"text","text":", and invoke native window or"},{"type":"text","text":" "},{"type":"text","text":"immersive APIs through a macro-generated "},{"type":"codeVoice","code":"RouterSceneRoute"},{"type":"text","text":" catalog when"},{"type":"text","text":" "},{"type":"text","text":"committed state changes. Scene actions on unconstrained route types are no"},{"type":"text","text":" "},{"type":"text","text":"longer part of the public surface. Native open failures are repaired through"},{"type":"text","text":" "},{"type":"text","text":"the normal reducer and event path, but that corrective removal cannot be"},{"type":"text","text":" "},{"type":"text","text":"rejected by an application policy because the failed scene does not exist to"},{"type":"text","text":" "},{"type":"text","text":"preserve."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Each native scene now owns a recursive "},{"type":"codeVoice","code":"RouterNode"},{"type":"text","text":" within that same state."},{"type":"text","text":" "},{"type":"text","text":"Use the macro-generated typed "},{"type":"codeVoice","code":"Route.Scene"},{"type":"text","text":" request and render the matching"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterWindowHost"},{"type":"text","text":" or "},{"type":"codeVoice","code":"RouterImmersiveSpaceHost"},{"type":"text","text":"; do not host a second store in"},{"type":"text","text":" "},{"type":"text","text":"the scene."}]}]}],"references":{"doc://com.innosquad.innorouter.docs.runtime/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","kind":"symbol","abstract":[],"role":"collection","type":"topic"}}}