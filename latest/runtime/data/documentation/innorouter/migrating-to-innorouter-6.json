{"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouter\/Migrating-To-InnoRouter-6","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Dependency","anchor":"Dependency","type":"heading"},{"inlineContent":[{"text":"Replace granular runtime products with the umbrella product:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip package-manifest-fragment","code":[".product(name: \"InnoRouter\", package: \"InnoRouter\")"],"type":"codeListing"},{"inlineContent":[{"text":"Add ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"InnoRouterInspector","type":"codeVoice"},{"text":" only to targets that use them.","type":"text"}],"type":"paragraph"},{"text":"Route declaration and host","type":"heading","level":2,"anchor":"Route-declaration-and-host"},{"inlineContent":[{"text":"Before, an application could manually compose separate stack and modal stores.","type":"text"},{"text":" ","type":"text"},{"text":"In 6.0, declare destinations once and choose a native host:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["import InnoRouter","import SwiftUI","","@Router","enum AppRoute {","    case home","    case detail(id: String)","","    var destination: some View { \/* exhaustive switch *\/ }","}","","RouterHost(AppRoute.self) {","    AppRoute.destination(for: .home)","}"],"type":"codeListing"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"AppRoute.makeRouterStore()","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"RouterHost(store:)","type":"codeVoice"},{"text":" only when an app","type":"text"},{"text":" ","type":"text"},{"text":"boundary must retain the authority.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Feature metadata namespace","anchor":"Feature-metadata-namespace","type":"heading"},{"inlineContent":[{"text":"Feature mappings stay under ","type":"text"},{"code":"AppRoute.Feature","type":"codeVoice"},{"text":", such as","type":"text"},{"text":" ","type":"text"},{"code":"AppRoute.Feature.account","type":"codeVoice"},{"text":". The generated structural metadata array is now","type":"text"},{"text":" ","type":"text"},{"code":"AppRoute.routerFeatureCatalog","type":"codeVoice"},{"text":". Replace any pre-release 6.0 source that read","type":"text"},{"text":" ","type":"text"},{"code":"AppRoute.Feature.catalog","type":"codeVoice"},{"text":"; no compatibility alias is provided because it would","type":"text"},{"text":" ","type":"text"},{"text":"again collide with a valid ","type":"text"},{"code":"@FeatureRoute case catalog(ChildRoute)","type":"codeVoice"},{"text":" mapping.","type":"text"}],"type":"paragraph"},{"text":"Request vocabulary","level":2,"type":"heading","anchor":"Request-vocabulary"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"text":"5.x","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"6.0","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"independent stack\/modal\/flow stores","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RouterStore<Route>","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"navigation, modal, and flow intents","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RouterAction<Route>","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"navigation and flow plans","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RouterPlan<Route>","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"direct inner-store mutation","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"await store.perform(action)"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"separate store event types","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RouterEvent<Route>","type":"codeVoice"},{"text":" with one transition ID","type":"text"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"Named environment helpers such as ","type":"text"},{"code":"go","type":"codeVoice"},{"text":", ","type":"text"},{"code":"back","type":"codeVoice"},{"text":", ","type":"text"},{"code":"sheet","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"cover","type":"codeVoice"},{"text":" remain","type":"text"},{"text":" ","type":"text"},{"text":"convenient projections of ","type":"text"},{"code":"RouterAction","type":"codeVoice"},{"text":"; they do not form another public","type":"text"},{"text":" ","type":"text"},{"text":"request language.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The repository’s ","type":"text"},{"code":"MigrationSmoke","type":"codeVoice"},{"text":" fixture compiles the exact published 5.2.1","type":"text"},{"text":" ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" scenario and this 6.0 replacement as separate downstream","type":"text"},{"text":" ","type":"text"},{"text":"packages, then compares their encoded final path. It intentionally proves a","type":"text"},{"text":" ","type":"text"},{"text":"migration rather than preserving the removed type names.","type":"text"}],"type":"paragraph"},{"text":"Tabs and split layouts","type":"heading","level":2,"anchor":"Tabs-and-split-layouts"},{"inlineContent":[{"text":"Replace per-tab stores with branches in one ","type":"text"},{"code":"RouterState","type":"codeVoice"},{"text":" tree. Apply","type":"text"},{"text":" ","type":"text"},{"code":"@TabItem","type":"codeVoice"},{"text":" only to parameterless tab roots; ordinary detail routes can remain","type":"text"},{"text":" ","type":"text"},{"text":"unmarked in the same ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" enum. ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"text":" creates and scopes the","type":"text"},{"text":" ","type":"text"},{"text":"branches. The macro-generated scope ID is based on the case name and is safe to","type":"text"},{"text":" ","type":"text"},{"text":"persist across localization and reordering.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For an app-retained split tree, construct ","type":"text"},{"code":"RouterContainerState(style: .split, ...)","type":"codeVoice"},{"text":", create one ","type":"text"},{"code":"RouterStore","type":"codeVoice"},{"text":", and pass it to ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"code":"RouterThreeColumnSplitHost","type":"codeVoice"},{"text":". ","type":"text"},{"code":"RouterSplitState","type":"codeVoice"},{"text":" persists native visibility and","type":"text"},{"text":" ","type":"text"},{"text":"preferred compact column alongside the two- or three-column scope topology.","type":"text"}],"type":"paragraph"},{"text":"Async policy","type":"heading","level":2,"anchor":"Async-policy"},{"inlineContent":[{"text":"Replace middleware executors with ordered ","type":"text"},{"code":"RouterPolicy","type":"codeVoice"},{"text":" values:","type":"text"}],"type":"paragraph"},{"code":["let policy = RouterPolicy<AppRoute>(name: \"session\") { transition in","    session.isAuthenticated ? .allow : .reject(\"authentication-required\")","}","","let store = AppRoute.makeRouterStore(","    configuration: .init(policies: [policy])",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"Policies inspect an immutable candidate. Do not mutate navigation or business","type":"text"},{"text":" ","type":"text"},{"text":"state from a policy closure.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When approval must arrive later, return ","type":"text"},{"code":".deferRequest(id)","type":"codeVoice"},{"text":". The store releases","type":"text"},{"text":" ","type":"text"},{"text":"its execution lane and exposes payload-safe metadata in ","type":"text"},{"code":"deferredTransitions","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"Resolve the request explicitly; unchanged-state resume is the default, and","type":"text"},{"text":" ","type":"text"},{"text":"rebasing on current state must be selected deliberately.","type":"text"}],"type":"paragraph"},{"text":"Deep links","type":"heading","level":2,"anchor":"Deep-links"},{"inlineContent":[{"text":"Replace push-only or flow-only pipelines with ","type":"text"},{"code":"RouterLinkPipeline","type":"codeVoice"},{"text":". A route","type":"text"},{"text":" ","type":"text"},{"text":"matcher is promoted to an exact root-stack plan by default; pass a plan matcher","type":"text"},{"text":" ","type":"text"},{"text":"or planner closure for tabs, presentations, windows, or immersive state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Authentication evaluates every route in the target tree. A pending decision","type":"text"},{"text":" ","type":"text"},{"text":"retains the complete plan, so replay does not reconstruct intent chains. Put","type":"text"},{"text":" ","type":"text"},{"text":"that value in ","type":"text"},{"code":"RouterPendingLinkSlot","type":"codeVoice"},{"text":", then call ","type":"text"},{"code":"resume(on:)","type":"codeVoice"},{"text":" after login;","type":"text"},{"text":" ","type":"text"},{"text":"replacement, cancellation, and rejection retention are explicit.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Authentication state may be isolated to any actor. Its closure and the final","type":"text"},{"text":" ","type":"text"},{"text":"decision are therefore asynchronous:","type":"text"}],"type":"paragraph"},{"code":["let pipeline = RouterLinkPipeline<AppRoute>(","    originPolicy: originPolicy,","    matcher: matcher,","    authenticationPolicy: .required(","        shouldRequireAuthentication: { $0.requiresSession },","        isAuthenticated: { await session.isAuthenticated }","    )",")","","let decision = await pipeline.decide(for: url)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"text":"Persistence","type":"heading","level":2,"anchor":"Persistence"},{"inlineContent":[{"text":"Replace raw stack\/flow encoding with ","type":"text"},{"code":"RouterSnapshotCodec<Route>","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let codec = try RouterSnapshotCodec<AppRoute>(currentVersion: 2, migrations: [v1ToV2])","let data = try await store.snapshot(using: codec)","let result = try await store.restore(from: data, using: codec, recovery: .fail)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"Migrations must be adjacent and deterministic. Choose ","type":"text"},{"code":".fail","type":"codeVoice"},{"text":" or an explicit","type":"text"},{"text":" ","type":"text"},{"text":"app fallback; 6.0 never silently restores an empty router.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Prefer ","type":"text"},{"code":"RouterSnapshotMigration.codable(from:to:decoding:transform:)","type":"codeVoice"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"text":"legacy payload has a known shape. It decodes an app-owned legacy DTO and","type":"text"},{"text":" ","type":"text"},{"text":"encodes the next payload with stable key ordering, avoiding fragile raw JSON","type":"text"},{"text":" ","type":"text"},{"text":"string rewrites.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Snapshot encoding and decoding execute away from the main actor. Restoration","type":"text"},{"text":" ","type":"text"},{"text":"also captures the current revision before loading and rejects the decoded plan","type":"text"},{"text":" ","type":"text"},{"text":"as stale if the live router commits while storage is being read.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the app wants lifecycle-driven persistence, retain a","type":"text"},{"text":" ","type":"text"},{"code":"RouterRestorationDriver","type":"codeVoice"},{"text":" with an app-selected ","type":"text"},{"code":"RouterSnapshotStorage","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"text":"attach ","type":"text"},{"code":"routerStateRestoration(_:)","type":"codeVoice"},{"text":" at the root. The driver still restores","type":"text"},{"text":" ","type":"text"},{"text":"through the canonical policy pipeline and does not select a cloud service or","type":"text"},{"text":" ","type":"text"},{"text":"storage location.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Persist an authentication continuation separately with","type":"text"},{"text":" ","type":"text"},{"code":"RouterPendingLinkPersistenceDriver","type":"codeVoice"},{"text":" and app-selected","type":"text"},{"text":" ","type":"text"},{"code":"RouterPendingLinkStorage","type":"codeVoice"},{"text":". It stores the exact pending plan, not the source URL","type":"text"},{"text":" ","type":"text"},{"text":"alone, and refuses to overwrite a newer in-memory submission after a slow load.","type":"text"}],"type":"paragraph"},{"text":"Macro-first state reads","type":"heading","level":2,"anchor":"Macro-first-state-reads"},{"inlineContent":[{"text":"Keep ordinary destinations on ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":" for actions. Replace direct","type":"text"},{"text":" ","type":"text"},{"text":"store injection used only for UI state with ","type":"text"},{"code":"@EnvironmentRouterState","type":"codeVoice"},{"text":"; its","type":"text"},{"text":" ","type":"text"},{"code":"RouterStateReader","type":"codeVoice"},{"text":" exposes read-only stack, presentation, tab, badge, window,","type":"text"},{"text":" ","type":"text"},{"text":"and immersive projections from the same nearest scope.","type":"text"}],"type":"paragraph"},{"text":"Result-bearing presentation","type":"heading","level":2,"anchor":"Result-bearing-presentation"},{"inlineContent":[{"text":"Replace child-coordinator callbacks with one exact presentation lifetime:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let outcome: RouterPresentationOutcome<Profile> = await router.present(","    .profileEditor,","    expecting: Profile.self",")"],"type":"codeListing"},{"inlineContent":[{"text":"The destination calls ","type":"text"},{"code":"finishPresentation(returning:)","type":"codeVoice"},{"text":". Treat ","type":"text"},{"type":"codeVoice","code":".dismissed"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":".cancelled"},{"text":", and ","type":"text"},{"type":"codeVoice","code":".rejected"},{"text":" as separate terminal states.","type":"text"}],"type":"paragraph"},{"text":"Tests and inspection","type":"heading","level":2,"anchor":"Tests-and-inspection"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"Replace per-store test harnesses with ","type":"text"},{"code":"RouterTestStore","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Attach ","type":"text"},{"code":"RouterInspectorRecorder","type":"codeVoice"},{"text":" to the canonical ","type":"text"},{"code":"RouterStore","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Expect ","type":"text"},{"code":"started","type":"codeVoice"},{"text":", one event per prepared policy, and one terminal event with","type":"text"},{"text":" ","type":"text"},{"text":"the same transition identifier.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Read source, animation, and metadata from the ","type":"text"},{"code":"context","type":"codeVoice"},{"text":" carried by every","type":"text"},{"text":" ","type":"text"},{"text":"terminal event; terminal diagnostics no longer infer ","type":"text"},{"code":".programmatic","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Default inspector metadata is structural and redacted. Supply a formatter","type":"text"},{"text":" ","type":"text"},{"text":"only when the app explicitly accepts payload exposure.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"Import exported sessions into the recorder or use ","type":"text"},{"code":"RouterInspectorPlayback","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"code":"RouterInspectorComparison","type":"codeVoice"},{"text":" for offline step-through diagnosis.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Use bookmarks, correlated elapsed\/duration metadata, arbitrary state","type":"text"},{"text":" ","type":"text"},{"text":"comparison, and pause-on-rejection to isolate a failing transition. JSON file","type":"text"},{"text":" ","type":"text"},{"text":"import remains a developer-only, non-mutating workflow.","type":"text"}],"type":"paragraph"}]}]},{"text":"Removed without an automatic adapter","level":2,"type":"heading","anchor":"Removed-without-an-automatic-adapter"},{"inlineContent":[{"text":"The 5.x coordinator callback lifecycle, modal queues, effect handlers, and","type":"text"},{"text":" ","type":"text"},{"text":"automatic scene ownership cannot be translated safely into aliases: they have","type":"text"},{"text":" ","type":"text"},{"text":"different lifetime and atomicity semantics. Move business effects outside the","type":"text"},{"text":" ","type":"text"},{"text":"router, model the visible target as ","type":"text"},{"type":"codeVoice","code":"RouterState"},{"text":", and invoke native window or","type":"text"},{"text":" ","type":"text"},{"text":"immersive APIs through a macro-generated ","type":"text"},{"type":"codeVoice","code":"RouterSceneRoute"},{"text":" catalog when","type":"text"},{"text":" ","type":"text"},{"text":"committed state changes. Scene actions on unconstrained route types are no","type":"text"},{"text":" ","type":"text"},{"text":"longer part of the public surface. Native open failures are repaired through","type":"text"},{"text":" ","type":"text"},{"text":"the normal reducer and event path, but that corrective removal cannot be","type":"text"},{"text":" ","type":"text"},{"text":"rejected by an application policy because the failed scene does not exist to","type":"text"},{"text":" ","type":"text"},{"text":"preserve.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Each native scene now owns a recursive ","type":"text"},{"type":"codeVoice","code":"RouterNode"},{"text":" within that same state.","type":"text"},{"text":" ","type":"text"},{"text":"Use the macro-generated typed ","type":"text"},{"type":"codeVoice","code":"Route.Scene"},{"text":" request and render the matching","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouterWindowHost"},{"text":" or ","type":"text"},{"type":"codeVoice","code":"RouterImmersiveSpaceHost"},{"text":"; do not host a second store in","type":"text"},{"text":" ","type":"text"},{"text":"the scene.","type":"text"}],"type":"paragraph"}]}],"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Migrating to InnoRouter 6"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting"]]},"kind":"article","sections":[],"abstract":[{"text":"InnoRouter 6 deliberately replaces the parallel 5.x routing authorities with","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"one macro-first state\/store model. This is a breaking migration, not a set of"},{"type":"text","text":" "},{"type":"text","text":"deprecated aliases."}],"variants":[{"paths":["\/documentation\/innorouter\/migrating-to-innorouter-6"],"traits":[{"interfaceLanguage":"swift"}]}],"schemaVersion":{"minor":3,"major":0,"patch":0},"references":{"doc://com.innosquad.innorouter.docs.runtime/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting","role":"collection","url":"\/documentation\/innoroutertesting","abstract":[],"kind":"symbol","title":"InnoRouterTesting","type":"topic"}}}