{"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"text":"Declare one route enum with ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":". The generated conformance unlocks one","type":"text"},{"type":"text","text":" "},{"code":"RouterStore<Route>","type":"codeVoice"},{"type":"text","text":", one recursive "},{"type":"codeVoice","code":"RouterState<Route>"},{"type":"text","text":", and one"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouterAction<Route>"},{"text":" request vocabulary.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":", and "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" render native SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"containers over that authority. "},{"type":"codeVoice","code":"RouterPlan<Route>"},{"type":"text","text":" represents an exact target"},{"text":" ","type":"text"},{"type":"text","text":"shared by deep links, restoration, and transactions."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"InnoRouter supports typed presentations and scenes, native tab","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and split hosts, deep-link admission, snapshot restoration, bounded scheduling,"},{"type":"text","text":" "},{"text":"and optional testing and Inspector tools. Applications choose their storage,","type":"text"},{"text":" ","type":"text"},{"text":"recovery, and policy behavior explicitly while the store remains the single","type":"text"},{"text":" ","type":"text"},{"text":"navigation authority.","type":"text"}]},{"level":3,"text":"Added in 6.1.0","anchor":"Added-in-610","type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Version 6.1.0 adds explicit tab-topology restoration for apps whose tab","type":"text"},{"t