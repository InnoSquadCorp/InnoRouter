{"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting"]]},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouter\/InnoRouter"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouter\/innorouter"]}],"metadata":{"role":"article","title":"InnoRouter","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}]},"abstract":[{"type":"text","text":"Macro-first typed navigation for SwiftUI."}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Release and requirements","anchor":"Release-and-requirements"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This catalog describes stable InnoRouter "},{"type":"strong","inlineContent":[{"type":"text","text":"7.0.0"}]},{"type":"text","text":". Use Swift 6.3+ with"},{"type":"text","text":" "},{"type":"text","text":"iOS\/iPadOS\/Mac Catalyst 18+, macOS 15+, tvOS 18+, watchOS 11+, or visionOS 2+."},{"type":"text","text":" "},{"type":"text","text":"Apps import the "},{"type":"codeVoice","code":"InnoRouter"},{"type":"text","text":" product; "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterInspector"},{"type":"text","text":" are optional. Platform-specific scenes and presentations"},{"type":"text","text":" "},{"type":"text","text":"retain their availability constraints. Read "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouter\/Migrating-To-InnoRouter-7"},{"type":"text","text":" "},{"type":"text","text":"when moving from 6.x; older release notes remain historical evidence."}]},{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Declare one route enum with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":". The generated conformance unlocks one"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterStore<Route>"},{"type":"text","text":", one recursive "},{"type":"codeVoice","code":"RouterState<Route>"},{"type":"text","text":", and one"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterAction<Route>"},{"type":"text","text":" request vocabulary."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":", and "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" render native SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"containers over that authority. "},{"type":"codeVoice","code":"RouterPlan<Route>"},{"type":"text","text":" represents an exact target"},{"type":"text","text":" "},{"type":"text","text":"shared by deep links, restoration, and transactions."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter supports typed presentations and scenes, native tab"},{"type":"text","text":" "},{"type":"text","text":"and split hosts, deep-link admission, snapshot restoration, bounded scheduling,"},{"type":"text","text":" "},{"type":"text","text":"and optional testing and Inspector tools. Applications choose their storage,"},{"type":"text","text":" "},{"type":"text","text":"recovery, and policy behavior explicitly while the store remains the single"},{"type":"text","text":" "},{"type":"text","text":"navigation authority."}]},{"type":"heading","level":3,"text":"Added in 6.1.0","anchor":"Added-in-610"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Version 6.1.0 adds explicit tab-topology restoration for apps whose tab"},{"type":"text","text":" "},{"type":"text","text":"catalog changes between launches. "},{"type":"codeVoice","code":"RouterTabRestorationTopology"},{"type":"text","text":" adds missing"},{"type":"text","text":" "},{"type":"text","text":"current scopes while preserving saved paths and orphaned branches. Partial"},{"type":"text","text":" "},{"type":"text","text":"restoration reports describe structural changes through "},{"type":"codeVoice","code":"topologyChanges"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"It also added opt-in snapshot byte limits, automatic partial validation,"},{"type":"text","text":" "},{"type":"text","text":"and explicit "},{"type":"codeVoice","code":"@TabItem"},{"type":"text","text":" identifiers while preserving the 6.0 defaults at that"},{"type":"text","text":" "},{"type":"text","text":"time. In 7.0, legacy snapshot codecs and file storage have finite provisional"},{"type":"text","text":" "},{"type":"text","text":"defaults. Codec JSON depth, token and duplicate-key preflight also runs before"},{"type":"text","text":" "},{"type":"text","text":"typed decoding and after every migration. Use measured finite overrides when"},{"type":"text","text":" "},{"type":"text","text":"needed; an explicit nil opt-out is excluded from the bounded-decoding guarantee."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Read "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouter\/Restoring-Tab-Navigation"},{"type":"text","text":" for catalog ownership, outcome handling,"},{"type":"text","text":" "},{"type":"text","text":"and a complete, compiled example with file persistence."}]},{"type":"codeListing","code":["import SwiftUI","import InnoRouter","","@Router","enum AppRoute {","    case detail(id: String)","","    var destination: some View {","        switch self {","        case .detail(let id):","            Text(\"Detail \\(id)\")","        }","    }","}","","struct AppRoot: View {","    var body: some View {","        RouterHost(AppRoute.self) {","            Text(\"Home\")","        }","    }","}"],"syntax":"swift compile"},{"type":"heading","level":2,"text":"API overview","anchor":"API-overview"},{"type":"heading","level":3,"text":"Runtime","anchor":"Runtime"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterStore"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterState"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterAction"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"RouterPlan"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"RouterPlanBuilder"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"RouterSnapshotCodec"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"RouterSnapshotMigration"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"InnoRouterVersion"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"EnvironmentRouter"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"EnvironmentRouterState"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterStateReader"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"RouterHost","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterTabHost"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterSplitHost"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"RouterThreeColumnSplitHost"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"RouterWindowHost","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"RouterImmersiveSpaceHost","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"RouterPendingLinkSlot","type":