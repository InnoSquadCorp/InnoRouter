{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"roleHeading":"Article","role":"article","title":"Middleware and cancellation","modules":[{"name":"InnoRouterTesting"}]},"variants":[{"paths":["\/documentation\/innoroutercore\/middleware-and-cancellation"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation"},"abstract":[{"text":"Middleware is the cross-cutting policy layer for navigation execution.","type":"text"}],"primaryContentSections":[{"content":[{"level":2,"text":"Interception phase","anchor":"Interception-phase","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationMiddleware.willExecute(_:state:)"},{"text":" runs before the engine applies a command.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It returns "},{"type":"codeVoice","code":"NavigationInterception"},{"type":"text","text":":"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".proceed(updatedCommand)"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".cancel(reason)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This allows middleware to:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"rewrite commands"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"block execution","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"attach a typed cancellation reason","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Cancellation reasons live in "},{"type":"codeVoice","code":"NavigationCancellationReason"},{"type":"text","text":" and stay visible in the final "},{"type":"codeVoice","code":"NavigationResult"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"anchor":"Post-execution-phase","text":"Post-execution phase","type":"heading"},{"inlineContent":[{"code":"NavigationMiddleware.didExecute(_:result:state:)","type":"codeVoice"},{"text":" folds the execution result after the engine runs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method can:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"inspect the final ","type":"text"},{"code":"RouteStack","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"transform the "},{"type":"codeVoice","code":"NavigationResult"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"attach analytics or logging side effects"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"It cannot mutate router state directly. State mutation authority stays in the executor."}],"type":"paragraph"},{"level":2,"anchor":"Why-middleware-is-synchronous","text":"Why middleware is synchronous","type":"heading"},{"inlineContent":[{"type":"text","text":"Core middleware is intentionally synchronous. Async policy checks belong at the app boundary rather than inside the core execution pipeline."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If an app needs async authorization, use the effect-layer guarded execution helpers instead of making core middleware re-entrant and actor-heavy.","type":"text"}]}],"kind":"content"}],"kind":"article","sections":[],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.