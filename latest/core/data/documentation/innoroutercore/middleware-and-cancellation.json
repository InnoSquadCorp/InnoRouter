{"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","interfaceLanguage":"swift"},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"paths":["\/documentation\/innoroutercore\/middleware-and-cancellation"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"text":"Middleware is the cross-cutting policy layer for navigation execution.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Interception phase","level":2,"anchor":"Interception-phase","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"NavigationMiddleware.willExecute(_:state:)"},{"type":"text","text":" runs before the engine applies a command."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It returns "},{"type":"codeVoice","code":"NavigationInterception"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".proceed(updatedCommand)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".cancel(reason)"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This allows middleware to:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"rewrite commands","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"block execution","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"attach a typed cancellation reason","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Cancellation reasons live in "},{"type":"codeVoice","code":"NavigationCancellationReason"},{"type":"text","text":" and stay visible in the final "},{"type":"codeVoice","code":"NavigationResult"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Post-execution phase","level":2,"anchor":"Post-execution-phase","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"NavigationMiddleware.didExecute(_:result:state:)"},{"type":"text","text":" folds the execution result after the engine runs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method can:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"inspect the final ","type":"text"},{"type":"codeVoice","code":"RouteStack"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"transform the ","type":"text"},{"type":"codeVoice","code":"NavigationResult"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"attach analytics or logging side effects","type":"text"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"It cannot mutate router state directly. State mutation authority stays in the executor."}],"type":"paragraph"},{"text":"Why middleware is synchronous","level":2,"anchor":"Why-middleware-is-synchronous","type":"heading"},{"inlineContent":[{"type":"text","text":"Core middleware is intentionally synchronous. Async policy checks belong at the app boundary rather than inside the core execution pipeline."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If an app needs async authorization, use the effect-layer guarded execution helpers instead of making core middleware re-entrant and actor-heavy."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"role":"article","title":"Middleware and cancellation","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article"},"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/com.innosquad.inno