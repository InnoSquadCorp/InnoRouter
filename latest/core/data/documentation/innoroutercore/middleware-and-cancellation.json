{"abstract":[{"type":"text","text":"Middleware is the cross-cutting policy layer for navigation execution."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Interception phase","level":2,"anchor":"Interception-phase"},{"type":"paragraph","inlineContent":[{"code":"NavigationMiddleware.willExecute(_:state:)","type":"codeVoice"},{"text":" runs before the engine applies a command.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It returns "},{"type":"codeVoice","code":"NavigationInterception"},{"type":"text","text":":"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":".proceed(updatedCommand)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".cancel(reason)","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This allows middleware to:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"rewrite commands"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"block execution","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"attach a typed cancellation reason"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Cancellation reasons live in "},{"code":"NavigationCancellationReason","type":"codeVoice"},{"type":"text","text":" and stay visible in the final "},{"code":"NavigationResult","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","text":"Post-execution phase","level":2,"anchor":"Post-execution-phase"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationMiddleware.didExecute(_:result:state:)"},{"type":"text","text":" folds the execution result after the engine runs."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This method can:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"inspect the final ","type":"text"},{"type":"codeVoice","code":"RouteStack"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"transform the "},{"code":"NavigationResult","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"text":"attach analytics or logging side effects","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"It cannot mutate router state directly. State mutation authority stays in the executor."}]},{"type":"heading","text":"Why middleware is synchronous","level":2,"anchor":"Why-middleware-is-synchronous"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Core middleware is intentionally synchronous. Async policy checks belong at the app boundary rather than inside the core execution pipeline."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If an app needs async authorization, use the effect-layer guarded execution helpers instead of making core middleware re-entrant and actor-heavy."}]}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/middleware-and-cancellation"]}],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article","title":"Middleware and cancellation"},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","interfaceLanguage":"swift"},"kind":"article","references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","role":"collection","identifier"