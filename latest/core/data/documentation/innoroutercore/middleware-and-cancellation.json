{"metadata":{"roleHeading":"Article","title":"Middleware and cancellation","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"sections":[],"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"text":"Middleware is the cross-cutting policy layer for navigation execution.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/middleware-and-cancellation"]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Interception phase","anchor":"Interception-phase","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"NavigationMiddleware.willExecute(_:state:)"},{"type":"text","text":" runs before the engine applies a command."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"It returns "},{"type":"codeVoice","code":"NavigationInterception"},{"type":"text","text":":"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".proceed(updatedCommand)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".cancel(reason)","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"This allows middleware to:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"rewrite commands"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"block execution"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"attach a typed cancellation reason"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Cancellation reasons live in "},{"type":"codeVoice","code":"NavigationCancellationReason"},{"type":"text","text":" and stay visible in the final "},{"type":"codeVoice","code":"NavigationResult"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Post-execution phase","anchor":"Post-execution-phase","level":2,"type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"NavigationMiddleware.didExecute(_:result:state:)"},{"type":"text","text":" folds the execution result after the engine runs."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method can:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"inspect the final "},{"code":"RouteStack","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"transform the "},{"code":"NavigationResult","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"attach analytics or logging side effects"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"It cannot mutate router state directly. State mutation authority stays in the executor."}],"type":"paragraph"},{"text":"Why middleware is synchronous","anchor":"Why-middleware-is-synchronous","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Core middleware is intentionally synchronous. Async policy checks belong at the app boundary rather than inside the core execution pipeline."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If an app needs async authorization, use the effect-layer guarded execution helpers instead of making core middleware re-entrant and actor-heavy."}],"type":"paragraph"}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRout