{"abstract":[{"text":"Middleware is the cross-cutting policy layer for navigation execution.","type":"text"}],"sections":[],"primaryContentSections":[{"content":[{"type":"heading","text":"Interception phase","anchor":"Interception-phase","level":2},{"inlineContent":[{"type":"codeVoice","code":"NavigationMiddleware.willExecute(_:state:)"},{"text":" runs before the engine applies a command.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"It returns ","type":"text"},{"type":"codeVoice","code":"NavigationInterception"},{"text":":","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".proceed(updatedCommand)"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".cancel(reason)"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"text":"This allows middleware to:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"rewrite commands"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"block execution"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"attach a typed cancellation reason","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Cancellation reasons live in "},{"code":"NavigationCancellationReason","type":"codeVoice"},{"type":"text","text":" and stay visible in the final "},{"code":"NavigationResult","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"type":"heading","text":"Post-execution phase","anchor":"Post-execution-phase","level":2},{"inlineContent":[{"code":"NavigationMiddleware.didExecute(_:result:state:)","type":"codeVoice"},{"text":" folds the execution result after the engine runs.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"This method can:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"inspect the final "},{"type":"codeVoice","code":"RouteStack"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"transform the "},{"type":"codeVoice","code":"NavigationResult"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"attach analytics or logging side effects"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"It cannot mutate router state directly. State mutation authority stays in the executor."}],"type":"paragraph"},{"type":"heading","text":"Why middleware is synchronous","anchor":"Why-middleware-is-synchronous","level":2},{"inlineContent":[{"type":"text","text":"Core middleware is intentionally synchronous. Async policy checks belong at the app boundary rather than inside the core execution pipeline."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If an app needs async authorization, use the effect-layer guarded execution helpers instead of making core middleware re-entrant and actor-heavy."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/innoroutercore\/middleware-and-cancellation"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"role":"article","roleHeading":"Article","title":"Middleware and cancellation","modules":[{"name":"InnoRouterTesting"}]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","role":"collection","type"