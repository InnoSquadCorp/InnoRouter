{"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","metadata":{"roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}],"title":"Command, batch, and transaction semantics","role":"article"},"sections":[],"primaryContentSections":[{"content":[{"type":"heading","anchor":"Single-command-execution","text":"Single-command execution","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationCommand"},{"type":"text","text":" models one navigation transition or a recursive command composition."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Important cases:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".push"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pushAll"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pop"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".popCount"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".popToRoot"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".popTo"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".replace"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sequence"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".whenCancelled"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationEngine"},{"type":"text","text":" executes these commands against a "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Sequence-semantics","text":"Sequence semantics","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sequence"},{"type":"text","text":" is command algebra, not a transaction."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That means:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"commands execute left-to-right"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"earlier successful steps stay applied even if a later step fails"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"later steps still run unless the sequence itself has no more elements"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the final result is "},{"type":"codeVoice","code":"NavigationResult.multiple(_:)"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".sequence"},{"type":"text","text":" when partial success is acceptable and the command stream itself is the point."}]},{"type":"heading","anchor":"Fallback-semantics","text":"Fallback semantics","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".whenCancelled(primary, fallback:)"},{"type":"text","text":" is choice composition with an internal"},{"type":"text","text":" "},{"type":"text","text":"savepoint."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That means:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"primary"},{"type":"text","text":" runs first against a shadow copy of the starting state"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if "},{"type":"codeVoice","code":"primary"},{"type":"text","text":" succeeds, only its final state commits"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if "},{"type":"codeVoice","code":"primary"},{"type":"text","text":" reports anything other than success, its shadow is discarded and "},{"type":"codeVoice","code":"fallback"},{"type":"text","text":" starts from the same snapshot"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if "},{"type":"codeVoice","code":"fallback"},{"type":"text","text":" succeeds, only its final state commits"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if both legs fail, both shadows are discarded, the starting "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" remains unchanged, and the fallback failure is returned"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" routes each attempted leg recursively through middleware; direct "},{"type":"codeVoice","code":"NavigationEngine"},{"type":"text","text":" execution has no middleware"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"single-command execution only emits the successful leg’s committed state change"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"transaction execution keeps public middleware observation commit-only, while discarded preview legs run internal cleanup"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For direct and batch store execution, the folded "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" result decides"},{"type":"text","text":" "},{"type":"text","text":"whether a leg succeeded. Transaction execution must choose and commit from its"},{"type":"text","text":" "},{"type":"text","text":"preview result so "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" stays commit-only; a post-commit fold changes the"},{"type":"text","text":" "},{"type":"text","text":"reported result but cannot reopen fallback selection or undo the commit."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"executedCommands"},{"type":"text","text":" is an attempt log, not a commit log. It records effective"},{"type":"text","text":" "},{"type":"text","text":"commands passed to the engine, including attempts later discarded by either"},{"type":"text","text":" "},{"type":"text","text":"savepoint or transaction rollback; middleware interceptions cancelled before"},{"type":"text","text":" "},{"type":"text","text":"the engine are not included. The savepoint protects "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" authority, not"},{"type":"text","text":" "},{"type":"text","text":"arbitrary side effects performed by attempt-level middleware callbacks."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".whenCancelled"},{"type":"text","text":" when rollback-to-fallback semantics belong to one logical command."}]},{"type":"heading","anchor":"Batch-semantics","text":"Batch semantics","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationBatchExecutor.executeBatch(_:stopOnFailure:)"},{"type":"text","text":" is for observation batching."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Batch execution still runs commands one step at a time, but it lets higher layers coalesce observation:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"step middleware still runs"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stopOnFailure: false"},{"type":"text","text":" keeps later commands running after a failure"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stopOnFailure: true"},{"type":"text","text":" stops the batch after the first failed step"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the store emits aggregated "},{"type":"codeVoice","code":".changed"},{"type":"text","text":" and "},{"type":"codeVoice","code":".batchExecuted"},{"type":"text","text":" cases"},{"type":"text","text":" "},{"type":"text","text":"through "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" and "},{"type":"codeVoice","code":"events"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the caller gets a structured "},{"type":"codeVoice","code":"NavigationBatchResult"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use batch execution when the caller wants one “transition event” while still preserving per-step execution."}]},{"type":"heading","anchor":"Transaction-semantics","text":"Transaction semantics","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTransactionExecutor.executeTransaction(_:)"},{"type":"text","text":" is the atomic option."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transactions:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reject an empty command list as uncommitted, with no failure index because no step ran"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"preview commands on a shadow stack"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"abort on the first failure or cancellation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"leave the real state unchanged on failure"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"commit the final state all at once on success"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"surface public "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" \/ transaction observation only for committed leaves"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"run internal discard cleanup for previewed leaves that never commit"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use transactions when all-or-nothing semantics are required."}]},{"type":"heading","anchor":"Typed-failures","text":"Typed failures","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Core legality failures stay in typed results instead of exceptions:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.emptyStack"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.invalidPopCount(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.insufficientStackDepth(requested:available:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.routeNotFound(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.cancelled(_:)"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps navigation failure in normal control flow and makes policy handling easy to pattern-match."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"abstract":[{"type":"text","text":"InnoRouter exposes three different execution semantics on purpose."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/command-batch-and-transaction-semantics"]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics","interfaceLanguage":"swift"},"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","type":"topic","kind":"article","title":"InnoRouterCore","url":"\/documentation\/innoroutercore\/innoroutercore","role":"collectionGroup","abstract":[{"text":"State, command, result, and execution primitives for InnoRouter.","type":"text"}]}}}