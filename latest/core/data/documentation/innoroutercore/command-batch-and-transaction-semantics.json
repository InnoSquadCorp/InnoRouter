{"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Single-command execution","anchor":"Single-command-execution"},{"inlineContent":[{"code":"NavigationCommand","type":"codeVoice"},{"text":" models one navigation transition or a recursive command composition.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Important cases:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":".push","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pushAll"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".pop","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".popCount"}]}]},{"content":[{"inlineContent":[{"code":".popToRoot","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".popTo","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".replace"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sequence"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".whenCancelled"}]}]}]},{"inlineContent":[{"code":"NavigationEngine","type":"codeVoice"},{"type":"text","text":" executes these commands against a "},{"code":"RouteStack","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Sequence semantics","anchor":"Sequence-semantics"},{"inlineContent":[{"code":".sequence","type":"codeVoice"},{"text":" is command algebra, not a transaction.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That means:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"commands execute left-to-right","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"typ