ype":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Batch semantics","anchor":"Batch-semantics"},{"inlineContent":[{"code":"NavigationBatchExecutor.executeBatch(_:stopOnFailure:)","type":"codeVoice"},{"text":" is for observation batching.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Batch execution still runs commands one step at a time, but it lets higher layers coalesce observation:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"step middleware still runs"}]}]},{"content":[{"inlineContent":[{"code":"stopOnFailure: false","type":"codeVoice"},{"text":" keeps later commands running after a failure","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stopOnFailure: true"},{"type":"text","text":" stops the batch after the first failed step"}]}]},{"content":[{"inlineContent":[{"text":"the store can emit one aggregated callback","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the caller gets a structured "},{"code":"NavigationBatchResult","type":"codeVoice"}]}]}]},{"inlineContent":[{"type":"text","text":"Use batch execution when the caller wants one “transition event” while still preserving per-step execution."}],"type":"paragraph"},{"level":2,"type":"heading","text":"Transaction semantics","anchor":"Transaction-semantics"},{"inlineContent":[{"type":"codeVoice","code":"NavigationTransactionExecutor.executeTransaction(_:)"},{"type":"text","text":" is the atomic option."}],"type":"paragraph"},{"inlineContent":[{"text":"Transactions:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"preview commands on a shadow stack"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"abort on the first failure or cancellation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"leave the real state unchanged on failure"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"commit the final state all at once on success","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"surface public "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" \/ transaction observation only for committed leaves"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"run internal discard cleanup for previewed leaves that never commit"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Use transactions when all-or-nothing semantics are required.","type":"text"}],"type":"paragraph"},{"level":2,"type":"heading","text":"Typed failures","anchor":"Typed-failures"},{"inlineContent":[{"type":"text","text":"Core legality failures stay in typed results instead of exceptions:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.emptyStack"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NavigationResult.invalidPopCount(_:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NavigationResult.insufficientStackDepth(requested:available:)","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NavigationResult.routeNotFound(_:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.cancelled(_:)"}]}]}]},{"inlineContent":[{"type":"text","text":"This keeps navigation failure in normal control flow and makes policy handling easy to pattern-match."}],"type":"paragraph"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documen