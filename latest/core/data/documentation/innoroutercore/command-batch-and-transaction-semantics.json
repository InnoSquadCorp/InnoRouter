{"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"text":"Single-command execution","level":2,"type":"heading","anchor":"Single-command-execution"},{"inlineContent":[{"code":"NavigationCommand","type":"codeVoice"},{"type":"text","text":" models one navigation transition or a recursive command composition."}],"type":"paragraph"},{"inlineContent":[{"text":"Important cases:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".push"}]}]},{"content":[{"inlineContent":[{"code":".pushAll","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pop"}]}]},{"content":[{"inlineContent":[{"code":".popCount","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".popToRoot"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".popTo"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".replace"}]}]},{"content":[{"inlineContent":[{"code":".sequence","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".whenCancelled","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"code":"NavigationEngine","type":"codeVoice"},{"text":" executes these commands against a ","type":"text"},{"code":"RouteStack","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Sequence semantics","level":2,"type":"heading","anchor":"Sequence-semantics"},{"inlineContent":[{"type":"codeVoice","code":".sequence"},{"type":"text","text":" is command algebra, not a transaction."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That means:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"commands execute left-to-right","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"earlier successful steps stay applied even if a later step fails"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"later steps still run unless the sequence itself has no more elements"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the final result is "},{"code":"NavigationResult.multiple(_:)","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".sequence"},{"type":"text","text":" when partial success is acceptable and the command stream itself is the point."}],"type":"paragraph"},{"text":"Fallback semantics","level":2,"type":"heading","anchor":"Fallback-semantics"},{"inlineContent":[{"type":"codeVoice","code":".whenCancelled(primary, fallback:)"},{"type":"text","text":" is also command algebra."}],"type":"paragraph"},{"inlineContent":[{"text":"That means:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"primary","type":"codeVoice"},{"type":"text","text":" runs first"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if "},{"type":"codeVoice","code":"primary"},{"type":"text","text":" reports anything other than success, the store restores the snapshot and runs "},{"type":"codeVoice","code":"fallback"}]}]},{"content":[{"inlineContent":[{"text":"both legs still pass through middleware recursively","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"single-command execution only emits the committed state change","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"transaction execution keeps public middleware observation commit-only, while discarded preview legs run internal cleanup"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".whenCancelled"},{"type":"text","text":" when rollback-to-fallback semantics belong to one logical command."}],"type":"paragraph"},{"text":"Batch semantics","level":2,"type":"heading","anchor":"Batch-semantics"},{"inlineContent":[{"code":"NavigationBatchExecutor.executeBatch(_:stopOnFailure:)","type":"codeVoice"},{"text":" is for observation batching.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Batch execution still runs commands one step at a time, but it lets higher layers coalesce observation:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"step middleware still runs","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"stopOnFailure: false"},{"type":"text","text":" keeps later commands running after a failure"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"stopOnFailure: true"},{"text":" stops the batch after the first failed step","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the store can emit one aggregated callback","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"the caller gets a structured ","type":"text"},{"type":"codeVoice","code":"NavigationBatchResult"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Use batch execution when the caller wants one “transition event” while still preserving per-step execution."}],"type":"paragraph"},{"text":"Transaction semantics","level":2,"type":"heading","anchor":"Transaction-semantics"},{"inlineContent":[{"code":"NavigationTransactionExecutor.executeTransaction(_:)","type":"codeVoice"},{"text":" is the atomic option.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Transactions:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph",