,"type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".whenCancelled","type":"codeVoice"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"code":"NavigationEngine","type":"codeVoice"},{"type":"text","text":" executes these commands against a "},{"type":"codeVoice","code":"RouteStack"},{"text":".","type":"text"}]},{"anchor":"Sequence-semantics","text":"Sequence semantics","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":".sequence","type":"codeVoice"},{"text":" is command algebra, not a transaction.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"That means:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"commands execute left-to-right"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"earlier successful steps stay applied even if a later step fails"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"later steps still run unless the sequence itself has no more elements"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the final result is "},{"type":"codeVoice","code":"NavigationResult.multiple(_:)"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":".sequence"},{"text":" when partial success is acceptable and the command stream itself is the point.","type":"text"}]},{"type":"heading","anchor":"Fallback-semantics","level":2,"text":"Fallback semantics"},{"type":"paragraph","inlineContent":[{"code":".whenCancelled(primary, fallback:)","type":"codeVoice"},{"text":" is choice composition with an internal","type":"text"},{"text":" ","type":"text"},{"text":"savepoint.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That means:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"primary"},{"type":"text","text":" runs first against a shadow copy of the starting state"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if "},{"type":"codeVoice","code":"primary"},{"type":"text","text":" succeeds, only its final state commits"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if "},{"code":"primary","type":"codeVoice"},{"type":"text","text":" reports anything other than success, its shadow is discarded and "},{"code":"fallback","type":"codeVoice"},{"type":"text","text":" starts from the same snapshot"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if ","type":"text"},{"code":"fallback","type":"codeVoice"},{"text":" succeeds, only its final state commits","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"if both legs fail, both shadows are discarded, the starting ","type":"text"},{"type":"codeVoice","code":"RouteStack"},{"text":" remains unchanged, and the fallback failure is returned","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":" routes each attempted leg recursively through middleware; direct "},{"type":"codeVoice","code":"NavigationEngine"},{"type":"text","text":" execution has no middleware"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"single-command execution only emits the successful leg’s committed state change"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"transaction execution keeps public middleware observation commit-only, while discarded preview legs run internal cleanup"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For direct and batch store execution, the folded "},{"code":"didExecute","type":"codeVoice"},{"type":"text","text":" result decides"},{"type":"text","text":" "},{"type":"text","text":"whether a leg succeeded. Transaction execution must choose and commit from its"},{"type":"text","text":" "},{"type":"text","text":"preview result so "},{"code":"didExecute","type":"codeVoice"},{"type":"text","text":" stays commit-only; a post-commit fold changes the"},{"type":"text","text":" "},{"type":"text","text":"reported result but cannot reopen fallback selection or undo the commit."}]},{"type":"paragraph","inlineContent":[{"code":"executedCommands","type":"codeVoice"},{"type":"text","text":" is an attempt log, not a commit log. It records effective"},{"type":"text","text":" "},{"type":"text","text":"commands passed to the engine, including attempts later discarded by either"},{"type":"text","text":" "},{"type":"text","text":"savepoint or transaction rollback; middleware interceptions cancelled before"},{"type":"text","text":" "},{"type":"text","text":"the engine are not included. The savepoint protects "},{"code":"RouteStack","type":"codeVoice"},{"type":"text","text":" authority, not"},{"type":"text","text":" "},{"type":"text","text":"arbitrary side effects performed by attempt-level middleware callbacks."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"code":".whenCancelled","type":"codeVoice"},{"type":"text","text":" when rollback-to-fallback semantics belong to one logical command."}]},{"anchor":"Batch-semantics","text":"Batch semantics","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"NavigationBatchExecutor.executeBatch(_:stopOnFailure:)","type":"codeVoice"},{"type":"text","text":" is for observation batching."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Batch execution still runs commands one step at a time, but it lets higher layers coalesce observation:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"step middleware still runs"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"stopOnFailure: false","type":"codeVoice"},{"type":"text","text":" keeps later commands running after a failure"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"stopOnFailure: true","type":"codeVoice"},{"type":"text","text":" stops the batch after the first failed step"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the store emits aggregated "},{"code":".changed","type":"codeVoice"},{"type":"text","text":" and "},{"code":".batchExecuted","type":"codeVoice"},{"type":"text","text":" cases"},{"type":"text","text":" "},{"type":"text","text":"through "},{"code":"onEvent","type":"codeVoice"},{"type":"text","text":" and "},{"code":"events","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"the caller gets a structured "},{"code":"NavigationBatchResult","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use batch execution when the caller wants one “transition event” while still preserving per-step execution."}]},{"anchor":"Transaction-semantics","text":"Transaction semantics","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"code":"NavigationTransactionExecutor.executeTransaction(_:)","type":"codeVoice"},{"type":"text","text":" is the atomic option."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transactions:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"reject an empty command list as uncommitted, with no failure index because no step ran"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"preview commands on a shadow stack"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"abort on the first failure or cancellation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"leave the real state unchanged on failure"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"commit the final state all at once on success"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"surface public "},{"code":"didExecute","type":"codeVoice"},{"type":"text","text":" \/ transaction observation only for committed leaves"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"run internal discard cleanup for previewed leaves that never commit"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use transactions when all-or-nothing semantics are required."}]},{"anchor":"Typed-failures","text":"Typed failures","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Core legality failures stay in typed results instead of exceptions:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"NavigationResult.emptyStack","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NavigationResult.invalidPopCount(_:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NavigationResult.insufficientStackDepth(requested:available:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NavigationResult.routeNotFound(_:)","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NavigationResult.cancelled(_:)","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps navigation failure in normal control flow and makes policy handling easy to pattern-match."}]}],"kind":"content"}],"sections":[],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"abstract":[{"type":"text","text":"State, command, result, and execution primitives for InnoRouter."}],"type":"topic","url":"\/documentation\/innoroutercore\/innoroutercore","kind":"article","title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.core/documentat