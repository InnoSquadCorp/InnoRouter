{"variants":[{"paths":["\/documentation\/innoroutercore\/command-batch-and-transaction-semantics"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"InnoRouter exposes three different execution semantics on purpose.","type":"text"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics"},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"role":"article","roleHeading":"Article","title":"Command, batch, and transaction semantics"},"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Single-command execution","anchor":"Single-command-execution"},{"inlineContent":[{"type":"codeVoice","code":"NavigationCommand"},{"text":" models one navigation transition or a recursive command composition.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Important cases:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".push"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pushAll"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".pop","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".popCount"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".popToRoot"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".popTo"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".replace","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".sequence","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".whenCancelled"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"codeVoice","code":"NavigationEngine"},{"text":" executes these commands against a ","type":"text"},{"type":"codeVoice","code":"RouteStack"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Sequence semantics","level":2,"type":"heading","anchor":"Sequence-semantics"},{"inlineContent":[{"code":".sequence","type":"codeVoice"},{"type":"text","text":" is command algebra, not a transaction."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That means:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"text":"commands execute left-to-right","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"earlier successful steps stay applied even if a later step fails","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"later steps still run unless the sequence itself has no more elements","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the final result is ","type":"text"},{"code":"NavigationResult.multiple(_:)","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".sequence"},{"type":"text","text":" when partial success is acceptable and the command stream itself is the point."}]},{"type":"heading","anchor":"Fallback-semantics","level":2,"text":"Fallback semantics"},{"inlineContent":[{"type":"codeVoice","code":".whenCancelled(primary, fallback:)"},{"type":"text","text":" is choice composition with an internal"},{"type":"text","text":" "},{"text":"savepoint.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"That means:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"primary"},{"type":"text","text":" runs first against a shadow copy of the starting state"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"if ","type":"text"},{"type":"codeVoice","code":"primary"},{"type":"text","text":" succeeds, only its final state commits"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"if ","type":"text"},{"code":"primary","type":"codeVoice"},{"type":"text","text":" reports anything other than success, its shadow is discarded and "},{"code":"fallback","type":"codeVoice"},{"type":"text","text":" starts from the same snapshot"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"if "},{"code":"fallback","type":"codeVoice"},{"type":"text","text":" succeeds, only its final state commits"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"if both legs fail, both shadows are discarded, the starting ","type":"text"},{"type":"codeVoice","code":"RouteStack"},{"text":" remains unchanged, and the fallback failure is returned","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"NavigationStore","type":"codeVoice"},{"text":" routes each attempted leg recursively through middleware; direct ","type":"text"},{"type":"codeVoice","code":"NavigationEngine"},{"type":"text","text":" execution has no middleware"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"single-command execution only emits the successful leg’s committed state change"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"transaction execution keeps public middleware observation commit-only, while discarded preview legs run internal cleanup","type":"text"}]}]}]},{"inlineContent":[{"text":"For direct and batch store execution, the folded ","type":"text"},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" result decides"},{"type":"text","text":" "},{"type":"text","text":"whether a leg succeeded. Transaction execution must choose and commit from its"},{"type":"text","text":" "},{"text":"preview result so ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"type":"text","text":" stays commit-only; a post-commit fold changes the"},{"type":"text","text":" "},{"type":"text","text":"reported result but cannot reopen fallback selection or undo the commit."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"executedCommands"},{"text":" is an attempt log, not a commit log. It records effective","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"commands passed to the engine, including attempts later discarded by either"},{"type":"text","text":" "},{"type":"text","text":"savepoint or transaction rollback; middleware interceptions cancelled before"},{"type":"text","text":" "},{"type":"text","text":"the engine are not included. The savepoint protects "},{"code":"RouteStack","type":"codeVoice"},{"text":" authority, not","type":"text"},{"text":" ","type":"text"},{"text":"arbitrary side effects performed by attempt-level middleware callbacks.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":".whenCancelled","type":"codeVoice"},{"text":" when rollback-to-fallback semantics belong to one logical command.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Batch semantics","type":"heading","anchor":"Batch-semantics"},{"inlineContent":[{"type":"codeVoice","code":"NavigationBatchExecutor.executeBatch(_:stopOnFailure:)"},{"type":"text","text":" is for observation batching."}],"type":"paragraph"},{"inlineContent":[{"text":"Batch execution still runs commands one step at a time, but it lets higher layers coalesce observation:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"step middleware still runs"}]}]},{"content":[{"inlineContent":[{"code":"stopOnFailure: false","type":"codeVoice"},{"text":" keeps later commands running after a failure","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"stopOnFailure: true","type":"codeVoice"},{"text":" stops the batch after the first failed step","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"the store emits aggregated ","type":"text"},{"code":".changed","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".batchExecuted","type":"codeVoice"},{"text":" cases","type":"text"},{"type":"text","text":" "},{"text":"through ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"events","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"the caller gets a structured "},{"type":"codeVoice","code":"NavigationBatchResult"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Use batch execution when the caller wants one “transition event” while still preserving per-step execution.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Transaction semantics","anchor":"Transaction-semantics","type":"heading"},{"inlineContent":[{"type":"codeVoice","code":"NavigationTransactionExecutor.executeTransaction(_:)"},{"text":" is the atomic option.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Transactions:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"reject an empty command list as uncommitted, with no failure index because no step ran"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"preview commands on a shadow stack"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"abort on the first failure or cancellation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"leave the real state unchanged on failure","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"commit the final state all at once on success","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"surface public ","type":"text"},{"type":"codeVoice","code":"didExecute"},{"text":" \/ transaction observation only for committed leaves","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"run internal discard cleanup for previewed leaves that never commit","type":"text"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use transactions when all-or-nothing semantics are required."}]},{"type":"heading","level":2,"anchor":"Typed-failures","text":"Typed failures"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Core legality failures stay in typed results instead of exceptions:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.emptyStack"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"NavigationResult.invalidPopCount(_:)"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.insufficientStackDepth(requested:available:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.routeNotFound(_:)"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationResult.cancelled(_:)"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps navigation failure in normal control flow and makes policy handling easy to pattern-match."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"type":"topic","abstract":[{"type":"text","text":"State, command, result, and execution primitives for InnoRouter."}],"kind":"article","title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","url":"\/documentation\/innoroutercore\/innoroutercore","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.core/documentat