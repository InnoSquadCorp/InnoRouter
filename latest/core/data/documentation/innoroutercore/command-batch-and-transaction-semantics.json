{"metadata":{"roleHeading":"Article","role":"article","title":"Command, batch, and transaction semantics","modules":[{"name":"InnoRouterTesting"}]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"type":"text","text":"InnoRouter exposes three different execution semantics on purpose."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/command-batch-and-transaction-semantics"]}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Single-command-execution","text":"Single-command execution","level":2},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationCommand"},{"type":"text","text":" models one navigation transition or a recursive command composition."}]},{"inlineContent":[{"type":"text","text":"Important cases:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".push"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".pushAll"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".pop"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":".popCount","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".popToRoot"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".popTo"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".replace"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sequence"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".whenCancelled"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationEngine"},{"type":"text","text":" executes these commands against a "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":"."}]},{"level":2,"text":"Sequence semantics","anchor":"Sequence-semantics","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".sequence"},{"type":"text","text":" is command algebra, not a transaction."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That means:"}]},{"items":[{"content":[{"inlineContent":[{"text":"commands execute left-to-right","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"earlier successful steps stay applied even if a later step fails","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"later steps still run unless the sequence itself has no more elements","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"the final result is ","type":"text"},{"code":"NavigationResult.multiple(_:)","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".sequence"},{"type":"text","text":" when partial success is acceptable and the command stream itself is the point."}]},{"level":2,"text":"Fallback semantics","anchor":"Fallback-semantics","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".whenCancelled(primary, fallback:)"},{"type":"text","text":" is choice composition with an internal"},{"type":"text","text":" "},{"type":"text","text":"savepoint."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That means:"}]},{"items":[{"content":[{"inlineContent":[{"code":"primary","type":"codeVoice"},{"text":" runs first against a shadow copy of the starting state","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"if ","type":"text"},{"code":"primary","type":"codeVoice"},{"text":" succeeds, only its final state commits","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"if ","type":"text"},{"code":"primary","type":"codeVoice"},{"text":" reports anything other than success, its shadow is discarded and ","type":"text"},{"code":"fallback","type":"codeVoice"},{"text":" starts from the same snapshot","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"if ","type":"text"},{"code":"fallback","type":"codeVoice"},{"text":" succeeds, only its final state commits","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"if both legs fail, both shadows are discarded, the starting ","type":"text"},{"code":"RouteStack","type":"codeVoice"},{"text":" remains unchanged, and the fallback failure is returned","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NavigationStore","type":"codeVoice"},{"text":" routes each attempted leg recursively through middleware; direct ","type":"text"},{"code":"NavigationEngine","type":"codeVoice"},{"text":" execution has no middleware","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"single-command execution only emits the successful leg’s committed state change","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"transaction execution keeps public middleware observation commit-only, while discarded preview legs run internal cleanup","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For direct and batch store execution, the folded "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" result decides"},{"type":"text","text":" "},{"type":"text","text":"whether a leg succeeded. Transaction execution must choose and commit from its"},{"type":"text","text":" "},{"type":"text","text":"preview result so "},{"type":"codeVoice","code":"didExecute"},{"type":"text","text":" stays commit-only; a post-commit fold changes the"},{"type":"text","text":" "},{"type":"text","text":"reported result but cannot reopen fallback selection or undo the commit."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"executedCommands"},{"type":"text","text":" is an attempt log, not a commit log. It records effective"},{"type":"text","text":" "},{"type":"text","text":"commands passed to the engine, including attempts later discarded by either"},{"type":"text","text":" "},{"type":"text","text":"savepoint or transaction rollback; middleware interceptions cancelled before"},{"type":"text","text":" "},{"type":"text","text":"the engine are not included. The savepoint protects "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" authority, not"},{"type":"text","text":" "},{"type":"text","text":"arbitrary side effects performed by attempt-level middleware callbacks."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":".whenCancelled"},{"type":"text","text":" when rollback-to-fallback semantics belong to one logical command."}]},{"level":2,"text":"Batch semantics","anchor":"Batch-semantics","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationBatchExecutor.executeBatch(_:stopOnFailure:)"},{"type":"text","text":" is for observation batching."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Batch execution still runs commands one step at a time, but it lets higher layers coalesce observation:"}]},{"items":[{"content":[{"inlineContent":[{"text":"step middleware still runs","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"stopOnFailure: false","type":"codeVoice"},{"text":" keeps later commands running after a failure","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"stopOnFailure: true","type":"codeVoice"},{"text":" stops the batch after the first failed step","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"the store emits aggregated ","type":"text"},{"code":".changed","type":"codeVoice"},{"text":" and ","type":"text"},{"code":".batchExecuted","type":"codeVoice"},{"text":" cases","type":"text"},{"text":" ","type":"text"},{"text":"through ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"events","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"the caller gets a structured ","type":"text"},{"code":"NavigationBatchResult","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use batch execution when the caller wants one “transition event” while still preserving per-step execution."}]},{"level":2,"text":"Transaction semantics","anchor":"Transaction-semantics","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationTransactionExecutor.executeTransaction(_:)"},{"type":"text","text":" is the atomic option."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Transactions:"}]},{"items":[{"content":[{"inlineContent":[{"text":"reject an empty command list as uncommitted, with no failure index because no step ran","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"preview commands on a shadow stack","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"abort on the first failure or cancellation","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"leave the real state unchanged on failure","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"commit the final state all at once on success","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"surface public ","type":"text"},{"code":"didExecute","type":"codeVoice"},{"text":" \/ transaction observation only for committed leaves","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"run internal discard cleanup for previewed leaves that never commit","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use transactions when all-or-nothing semantics are required."}]},{"level":2,"text":"Typed failures","anchor":"Typed-failures","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Core legality failures stay in typed results instead of exceptions:"}]},{"items":[{"content":[{"inlineContent":[{"code":"NavigationResult.emptyStack","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NavigationResult.invalidPopCount(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NavigationResult.insufficientStackDepth(requested:available:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NavigationResult.routeNotFound(_:)","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"NavigationResult.cancelled(_:)","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This keeps navigation failure in normal control flow and makes policy handling easy to pattern-match."}]}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","role":"collectionGroup","url":"\/documentation\/innoroutercore\/innoroutercore","abstract":[{"type":"text","text":"State, command, result, and execution primitives for InnoRouter."}],"kind":"article","type":"topic"},"doc://com.innosquad.innorouter.docs.core/documentat