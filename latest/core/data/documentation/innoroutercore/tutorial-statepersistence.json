e"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"text":"violation. Codable decode runs the same validator and converts a","type":"text"},{"text":" ","type":"text"},{"text":"violation into ","type":"text"},{"code":"DecodingError.dataCorruptedError","type":"codeVoice"},{"text":", so a","type":"text"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" round-tripped through disk or network can no longer","type":"text"},{"text":" ","type":"text"},{"text":"silently produce a value that ","type":"text"},{"code":"apply(_:)","type":"codeVoice"},{"text":" will reject later. If","type":"text"},{"text":" ","type":"text"},{"text":"the snapshot format on disk drifts (older builds, hand-edited","type":"text"},{"text":" ","type":"text"},{"text":"JSON, schema migration mid-flight), the decode call surfaces the","type":"text"},{"text":" ","type":"text"},{"text":"error at restoration time — not at the next user action.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The permissive ","type":"text"},{"code":"FlowPlan(steps:)","type":"codeVoice"},{"text":" initializer remains available","type":"text"},{"text":" ","type":"text"},{"text":"for internal builders that already trust the origin of ","type":"text"},{"code":"steps","type":"codeVoice"},{"text":".","type":"text"}]},{"type":"heading","anchor":"Scope","text":"Scope","level":2},{"type":"paragraph","inlineContent":[{"text":"The helper intentionally covers only the typed ","type":"text"},{"code":"Data ↔ value","type":"codeVoice"},{"text":" bridge.","type":"text"},{"text":" ","type":"text"},{"text":"Out of scope, by design:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Where the encoded bytes live ("},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":", a file URL, iCloud,"},{"type":"text","text":" "},{"type":"text","text":"a database) — that is app policy."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{