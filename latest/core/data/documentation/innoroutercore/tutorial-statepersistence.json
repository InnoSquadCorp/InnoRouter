},{"code":".push","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"code":"FlowPlan(validating:)","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"FlowPlan.validate(_:)","type":"codeVoice"},{"text":" enforce these","type":"text"},{"type":"text","text":" "},{"type":"text","text":"invariants up front and throw "},{"code":"FlowPlanValidationError","type":"codeVoice"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"text","text":"violation. Codable decode runs the same validator and converts a"},{"type":"text","text":" "},{"type":"text","text":"violation into "},{"code":"DecodingError.dataCorruptedError","type":"codeVoice"},{"type":"text","text":", so a"},{"type":"text","text":" "},{"code":"FlowPlan","type":"codeVoice"},{"type":"text","text":" round-tripped through disk or network can no longer"},{"type":"text","text":" "},{"type":"text","text":"silently produce a value that "},{"code":"apply(_:)","type":"codeVoice"},{"type":"text","text":" will reject later. If"},{"type":"text","text":" "},{"type":"text","text":"the snapshot format on disk drifts (older builds, hand-edited"},{"type":"text","text":" "},{"type":"text","text":"JSON, schema migration mid-flight), the decode call surfaces the"},{"type":"text","text":" "},{"type":"text","text":"error at restoration time — not at the next user action."}]},{"inlineContent":[{"text":"The permissive ","type":"text"},{"code":"FlowPlan(steps:)","type":"codeVoice"},{"text":" initializer remains available","type":"text"},{"text":" ","type":"text"},{"text":"for internal builders that already trust the origin of ","type":"text"},{"code":"steps","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Scope","type":"heading","level":2,"anchor":"Scope"},{"inlineContent":[{"type":"text","text":"The helper intentionally covers only the typed "},{"type":"codeVoice","code":"Data ↔ value"},{"text":" bridge.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Out of scope, by design:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Where the encoded bytes live (","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":", a file URL, iCloud,","type":"text"},{"text":" ","type":"text"},{"text":"a database) — that is app policy.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"When snapshots are taken — tie the call into ","type":"text"},{"type":"codeVoice","code":"ScenePhase"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"codeVoice","code":"UIScene"},{"type":"text","text":" lifecycle, or a custom trigger."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Version-aware migration from older snapshot formats — add a"},{"type":"text","text":" "},{"type":"text","text":"wrapper struct around "},{"code":"FlowPlan","type":"codeVoice"},{"type":"text","text":" if the underlying routes evolve."}]}]},{"content":[{"inlineContent":[{"text":"Selective field redaction — encode only the fragments the app is","type":"text"},{"text":" ","type":"text"},{"text":"willing to persist.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"text":"Customising the encoder","level":2,"type":"heading","anchor":"Customising-the-encoder"},{"type":"paragraph","inlineContent":[{"text":"Any ","type":"text"},{"type":"codeVoice","code":"JSONEncoder"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"JSONDecoder"},{"text":" are acceptable inputs. Pass a","type":"text"},{"text":" ","type":"text"},{"text":"preconfigured pair to the initializer for deterministic output, date","type":"text"},{"text":" ","type":"text"},{"text":"strategies, or custom key coding:","type":"text"}]},{"code":["let encoder = JSONEncoder()","encoder.outputFormatting = [.sortedKeys, .prettyPrinted]","","let decoder = JSONDecoder()","decoder.dateDecodingStrategy = .iso8601","","let persistence = StatePersistence<AppRoute>(encode