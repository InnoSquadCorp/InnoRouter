{"metadata":{"roleHeading":"Article","title":"State Persistence and Restoration","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"sections":[],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"code":"StatePersistence","type":"codeVoice"},{"type":"text","text":" is a thin helper that serializes "},{"code":"FlowPlan","type":"codeVoice"},{"type":"text","text":" and"},{"type":"text","text":" "},{"code":"RouteStack","type":"codeVoice"},{"type":"text","text":" values to "},{"code":"Data","type":"codeVoice"},{"type":"text","text":" for launch-time restoration. It deliberately"},{"type":"text","text":" "},{"type":"text","text":"stops at the value boundary so apps keep full control over where — and"},{"type":"text","text":" "},{"type":"text","text":"when — snapshots are written."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/tutorial-statepersistence"]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Tutorial-StatePersistence"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"inlineContent":[{"text":"InnoRouter models a running flow as a single value (","type":"text"},{"code":"FlowPlan<R>","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"RouteStack<R>","type":"codeVoice"},{"text":"). When both the routes (","type":"text"},{"code":"R","type":"codeVoice"},{"text":") and the containing types","type":"text"},{"text":" ","type":"text"},{"text":"are ","type":"text"},{"code":"Codable","type":"codeVoice"},{"text":", the entire state can round-trip through JSON. That is","type":"text"},{"text":" ","type":"text"},{"text":"enough for state restoration, deep-link payloads, and offline replay.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"StatePersistence<R>","type":"codeVoice"},{"text":" bundles a ","type":"text"},{"code":"JSONEncoder","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"JSONDecoder","type":"codeVoice"},{"text":" so","type":"text"},{"text":" ","type":"text"},{"text":"call sites don’t have to redeclare them:","type":"text"}],"type":"paragraph"},{"code":["let persistence = StatePersistence<AppRoute>()","","\/\/ At checkpoint time (e.g. scene will deactivate):","let plan = try FlowPlan(validating: flowStore.path)","let data = try persistence.encode(plan)","try data.write(to: restorationURL, options: .atomic)","","\/\/ At launch time:","if let data = try? Data(contentsOf: restorationURL) {","    let restored = try persistence.decode(data)","    flowStore.apply(restored)","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"SwiftUI apps can wrap the value-level helper with","type":"text"},{"text":" ","type":"text"},{"code":"StateRestorationAdapter","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"InnoRouterSwiftUI","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let adapter = StateRestorationAdapter<AppRoute> { failure in","    diagnostics.record(failure)","}","","try adapter.snapshotNavigationStack(from: navigationStore)","_ = adapter.restoreFlowPlan(from: data, into: flowStore)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"text":"The adapter supports navigation-stack and flow-plan snapshots. Decode","type":"text"},{"text":" ","type":"text"},{"text":"or apply failures are reported through the restoration failure callback","type":"text"},{"text":" ","type":"text"},{"text":"and leave the existing store state untouched instead of falling back to","type":"text"},{"text":" ","type":"text"},{"text":"an empty path.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Validation-on-decode","text":"Validation on decode"},{"inlineContent":[{"text":"A ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" always satisfies the FlowStore invariants:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"At most one modal step."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A modal step only at the tail of "},{"type":"codeVoice","code":"steps"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other steps are "},{"type":"codeVoice","code":".push"},{"type":"text","text":"."}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"codeVoice","code":"FlowPlan(validating:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FlowPlan.validate(_:)"},{"type":"text","text":" enforce these"},{"type":"text","text":" "},{"type":"text","text":"invariants up front and throw "},{"type":"codeVoice","code":"FlowPlanValidationError"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"text","text":"violation. Codable decode runs the same validator and converts a"},{"type":"text","text":" "},{"type":"text","text":"violation into "},{"type":"codeVoice","code":"DecodingError.dataCorruptedError"},{"type":"text","text":", so a"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"text":" round-tripped through disk or network can no longer","type":"text"},{"type":"text","text":" "},{"type":"text","text":"silently produce a value that "},{"type":"codeVoice","code":"apply(_:)"},{"type":"text","text":" will reject later. If"},{"type":"text","text":" "},{"text":"the snapshot format on disk drifts (older builds, hand-edited","type":"text"},{"text":" ","type":"text"},{"text":"JSON, schema migration mid-flight), the decode call surfaces the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"error at restoration time — not at the next user action."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The permissive ","type":"text"},{"code":"FlowPlan(steps:)","type":"codeVoice"},{"type":"text","text":" initializer remains available"},{"type":"text","text":" "},{"text":"for internal builders that already trust the origin of ","type":"text"},{"code":"steps","type":"codeVoice"},{"type":"text","text":"."}]},{"type":"heading","anchor":"Scope","level":2,"text":"Scope"},{"type":"paragraph","inlineContent":[{"text":"The helper intentionally covers only the typed ","type":"text"},{"code":"Data ↔ value","type":"codeVoice"},{"text":" bridge.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Out of scope, by design:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the encoded bytes live ("},{"code":"UserDefaults","type":"codeVoice"},{"text":", a file URL, iCloud,","type":"text"},{"text":" ","type":"text"},{"text":"a database) — that is app policy.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"When snapshots are taken — tie the call into "},{"code":"ScenePhase","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"UIScene","type":"codeVoice"},{"type":"text","text":" lifecycle, or a custom trigger."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Version-aware migration from older snapshot formats — add a","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"wrapper struct around "},{"code":"FlowPlan","type":"codeVoice"},{"text":" if the underlying routes evolve.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Selective field redaction — encode only the fragments the app is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"willing to persist."}]}]}]},{"type":"heading","anchor":"Customising-the-encoder","level":2,"text":"Customising the encoder"},{"type":"paragraph","inlineContent":[{"text":"Any ","type":"text"},{"type":"codeVoice","code":"JSONEncoder"},{"type":"text","text":" and "},{"code":"JSONDecoder","type":"codeVoice"},{"type":"text","text":" are acceptable inputs. Pass a"},{"type":"text","text":" "},{"type":"text","text":"preconfigured pair to the initializer for deterministic output, date"},{"type":"text","text":" "},{"type":"text","text":"strategies, or custom key coding:"}]},{"type":"codeListing","code":["let encoder = JSONEncoder()","encoder.outputFormatting = [.sortedKeys, .prettyPrinted]","","let decoder = JSONDecoder()","decoder.dateDecodingStrategy = .iso8601","","let persistence = StatePersistence<AppRoute>(encoder: encoder, decoder: decoder)"],"syntax":"swift skip doc-fragment"},{"type":"heading","anchor":"Error-surface","level":2,"text":"Error surface"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both "},{"type":"codeVoice","code":"encode(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"decode(_:)"},{"type":"text","text":" re-throw the underlying"},{"type":"text","text":" "},{"type":"codeVoice","code":"EncodingError"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"DecodingError"},{"type":"text","text":" so call sites keep the diagnostic"},{"type":"text","text":" "},{"type":"text","text":"context needed to distinguish schema drift from I\/O failures."}]}]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/innoroutertesting","type":"topic"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouter