{"abstract":[{"code":"StatePersistence","type":"codeVoice"},{"text":" is a thin helper that serializes ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":" and","type":"text"},{"type":"text","text":" "},{"code":"RouteStack","type":"codeVoice"},{"text":" values to ","type":"text"},{"code":"Data","type":"codeVoice"},{"text":" for launch-time restoration. It deliberately","type":"text"},{"text":" ","type":"text"},{"text":"stops at the value boundary so apps keep full control over where — and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"when — snapshots are written."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"sections":[],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article","title":"State Persistence and Restoration"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Tutorial-StatePersistence"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/tutorial-statepersistence"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","text":"Overview","type":"heading","level":2},{"inlineContent":[{"text":"InnoRouter models a running flow as a single value (","type":"text"},{"type":"codeVoice","code":"FlowPlan<R>"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouteStack<R>"},{"text":"). When both the routes (","type":"text"},{"type":"codeVoice","code":"R"},{"text":") and the containing types","type":"text"},{"text":" ","type":"text"},{"text":"are ","type":"text"},{"type":"codeVoice","code":"Codable"},{"text":", the entire state can round-trip through JSON. That is","type":"text"},{"text":" ","type":"text"},{"text":"enough for state restoration, deep-link payloads, and offline replay.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"code":"StatePersistence<R>","type":"codeVoice"},{"type":"text","text":" bundles a "},{"code":"JSONEncoder","type":"codeVoice"},{"type":"text","text":" and "},{"code":"JSONDecoder","type":"codeVoice"},{"type":"text","text":" so"},{"type":"text","text":" "},{"type":"text","text":"call sites don’t have to redeclare them:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let persistence = StatePersistence<AppRoute>()","","\/\/ At checkpoint time (e.g. scene will deactivate):","let plan = try FlowPlan(validating: flowStore.path)","let data = try persistence.encode(plan)","try data.write(to: restorationURL, options: .atomic)","","\/\/ At launch time:","if let data = try? Data(contentsOf: restorationURL) {","    let restored = try persistence.decode(data)","    flowStore.apply(restored)","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"SwiftUI apps can wrap the value-level helper with"},{"type":"text","text":" "},{"code":"StateRestorationAdapter","type":"codeVoice"},{"text":" from ","type":"text"},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"text":":","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let adapter = StateRestorationAdapter<AppRoute> { failure in","    diagnostics.record(failure)","}","","try adapter.snapshotNavigationStack(from: navigationStore)","_ = adapter.restoreFlowPlan(from: data, into: flowStore)"],"type":"codeListing"},{"inlineContent":[{"text":"The adapter supports navigation-stack and flow-plan snapshots. Decode","type":"text"},{"text":" ","type":"text"},{"text":"or apply failures are reported through the restoration failure callback","type":"text"},{"text":" ","type":"text"},{"text":"and leave the existing store state untouched instead of falling back to","type":"text"},{"text":" ","type":"text"},{"text":"an empty path.","type":"text"}],"type":"paragraph"},{"text":"Validation on decode","anchor":"Validation-on-decode","level":2,"type":"heading"},{"inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":" always satisfies the FlowStore invariants:","type":"text"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"At most one modal step."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A modal step only at the tail of "},{"type":"codeVoice","code":"steps"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other steps are "},{"code":".push","type":"codeVoice"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"code":"FlowPlan(validating:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"FlowPlan.validate(_:)","type":"codeVoice"},{"text":" enforce these","type":"text"},{"type":"text","text":" "},{"type":"text","text":"invariants up front and throw "},{"code":"FlowPlanValidationError","type":"codeVoice"},{"text":" on","type":"text"},{"text":" ","type":"text"},{"text":"violation. Codable decode runs the same validator and converts a","type":"text"},{"type":"text","text":" "},{"type":"text","text":"violation into "},{"code":"DecodingError.dataCorruptedError","type":"codeVoice"},{"type":"text","text":", so a"},{"text":" ","type":"text"},{"code":"FlowPlan","type":"codeVoice"},{"type":"text","text":" round-tripped through disk or network can no longer"},{"text":" ","type":"text"},{"type":"text","text":"silently produce a value that "},{"code":"apply(_:)","type":"codeVoice"},{"type":"text","text":" will reject later. If"},{"type":"text","text":" "},{"type":"text","text":"the snapshot format on disk drifts (older builds, hand-edited"},{"type":"text","text":" "},{"text":"JSON, schema migration mid-flight), the decode call surfaces the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"error at restoration time — not at the next user action."}]},{"inlineContent":[{"text":"The permissive ","type":"text"},{"type":"codeVoice","code":"FlowPlan(steps:)"},{"type":"text","text":" initializer remains available"},{"type":"text","text":" "},{"type":"text","text":"for internal builders that already trust the origin of "},{"code":"steps","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Scope","anchor":"Scope","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The helper intentionally covers only the typed "},{"type":"codeVoice","code":"Data ↔ value"},{"type":"text","text":" bridge."},{"type":"text","text":" "},{"type":"text","text":"Out of scope, by design:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Where the encoded bytes live ("},{"type":"codeVoice","code":"UserDefaults"},{"text":", a file URL, iCloud,","type":"text"},{"text":" ","type":"text"},{"text":"a database) — that is app policy.","type":"text"}]}]},{"content":[{"inlineContent":[{"text":"When snapshots are taken — tie the call into ","type":"text"},{"code":"ScenePhase","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"UIScene","type":"codeVoice"},{"text":" lifecycle, or a custom trigger.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Version-aware migration from older snapshot formats — add a","type":"text"},{"text":" ","type":"text"},{"text":"wrapper struct around ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":" if the underlying routes evolve.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Selective field redaction — encode only the fragments the app is","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"willing to persist."}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"heading","level":2,"anchor":"Customising-the-encoder","text":"Customising the encoder"},{"inlineContent":[{"type":"text","text":"Any "},{"code":"JSONEncoder","type":"codeVoice"},{"type":"text","text":" and "},{"code":"JSONDecoder","type":"codeVoice"},{"text":" are acceptable inputs. Pass a","type":"text"},{"text":" ","type":"text"},{"text":"preconfigured pair to the initializer for deterministic output, date","type":"text"},{"text":" ","type":"text"},{"text":"strategies, or custom key coding:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let encoder = JSONEncoder()","encoder.outputFormatting = [.sortedKeys, .prettyPrinted]","","let decoder = JSONDecoder()","decoder.dateDecodingStrategy = .iso8601","","let persistence = StatePersistence<AppRoute>(encoder: encoder, decoder: decoder)"],"type":"codeListing"},{"text":"Error surface","anchor":"Error-surface","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Both "},{"type":"codeVoice","code":"encode(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"decode(_:)"},{"type":"text","text":" re-throw the underlying"},{"type":"text","text":" "},{"type":"codeVoice","code":"EncodingError"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"DecodingError"},{"type":"text","text":" so call sites keep the diagnostic"},{"text":" ","type":"text"},{"type":"text","text":"context needed to distinguish schema drift from I\/O failures."}],"type":"paragraph"}]}],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","kind":"symbol","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"abstract":[{"type":"text","text":"State, command, result, and execution primitives for InnoRouter."}],"type