{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter models a running flow as a single value ("},{"type":"codeVoice","code":"FlowPlan<R>"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouteStack<R>"},{"type":"text","text":"). When both the routes ("},{"type":"codeVoice","code":"R"},{"type":"text","text":") and the containing types"},{"type":"text","text":" "},{"type":"text","text":"are "},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", the entire state can round-trip through JSON. That is"},{"type":"text","text":" "},{"type":"text","text":"enough for state restoration, deep-link payloads, and offline replay."}]},{"type":"paragraph","inlineContent":[{"code":"StatePersistence<R>","type":"codeVoice"},{"text":" bundles a ","type":"text"},{"code":"JSONEncoder","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"JSONDecoder","type":"codeVoice"},{"text":" so","type":"text"},{"text":" ","type":"text"},{"text":"call sites don’t have to redeclare them:","type":"text"}]},{"type":"codeListing","code":["let persistence = StatePersistence<AppRoute>()","","\/\/ At checkpoint time (e.g. scene will deactivate):","let plan = try FlowPlan(validating: flowStore.path)","let data = try persistence.encode(plan)","try data.write(to: restorationURL, options: .atomic)","","\/\/ At launch time:","if let data = try? Data(contentsOf: restorationURL) {","    let restored = try persistence.decode(data)","    flowStore.apply(restored)","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"SwiftUI apps can wrap the value-level helper with","type":"text"},{"text":" ","type":"text"},{"code":"StateRestorationAdapter","type":"codeVoice"},{"text":" from ","type":"text"},{"code":"InnoRouterSwiftUI","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","code":["let adapter = StateRestorationAdapter<AppRoute> { failure in","    diagnostics.record(failure)","}","","try adapter.snapshotNavigationStack(from: navigationStore)","_ = adapter.restoreFlowPlan(from: data, into: flowStore)"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"The adapter supports navigation-stack and flow-plan snapshots. Decode","type":"text"},{"text":" ","type":"text"},{"text":"or apply failures are reported through the restoration failure callback","type":"text"},{"text":" ","type":"text"},{"text":"and leave the existing store state untouched instead of falling back to","type":"text"},{"text":" ","type":"text"},{"text":"an empty path.","type":"text"}]},{"anchor":"Validation-on-decode","type":"heading","text":"Validation on decode","level":2},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":"FlowPlan"},{"text":" always satisfies the FlowStore invariants:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"At most one modal step."}]}]},{"content":[{"inlineContent":[{"text":"A modal step only at the tail of ","type":"text"},{"type":"codeVoice","code":"steps"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"All other steps are ","type":"text"},{"code":".push","type":"codeVoice"},{"text":".","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowPlan(validating:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FlowPlan.validate(_:)"},{"type":"text","text":" enforce these"},{"type":"text","text":" "},{"type":"text","text":"invariants up front and throw "},{"type":"codeVoice","code":"FlowPlanValidationError"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"text","text":"violation. Codable decode runs the same validator and converts a"},{"type":"text","text":" "},{"type":"text","text":"violation into "},{"type":"codeVoice","code":"DecodingError.dataCorruptedError"},{"type":"text","text":", so a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" round-tripped through disk or network can no longer"},{"type":"text","text":" "},{"type":"text","text":"silently produce a value that "},{"type":"codeVoice","code":"apply(_:)"},{"type":"text","text":" will reject later. If"},{"type":"text","text":" "},{"type":"text","text":"the snapshot format on disk drifts (older builds, hand-edited"},{"type":"text","text":" "},{"type":"text","text":"JSON, schema migration mid-flight), the decode call surfaces the"},{"type":"text","text":" "},{"type":"text","text":"error at restoration time — not at the next user action."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The permissive "},{"type":"codeVoice","code":"FlowPlan(steps:)"},{"type":"text","text":" initializer remains available"},{"type":"text","text":" "},{"type":"text","text":"for internal builders that already trust the origin of "},{"type":"codeVoice","code":"steps"},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Scope","anchor":"Scope"},{"type":"paragraph","inlineContent":[{"text":"The helper intentionally covers only the typed ","type":"text"},{"code":"Data ↔ value","type":"codeVoice"},{"text":" bridge.","type":"text"},{"text":" ","type":"text"},{"text":"Out of scope, by design:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"text":"Where the encoded bytes live (","type":"text"},{"code":"UserDefaults","type":"codeVoice"},{"text":", a file URL, iCloud,","type":"text"},{"text":" ","type":"text"},{"text":"a database) — that is app policy.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"When snapshots are taken — tie the call into "},{"code":"ScenePhase","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"code":"UIScene","type":"codeVoice"},{"type":"text","text":" lifecycle, or a custom trigger."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Version-aware migration from older snapshot formats — add a"},{"type":"text","text":" "},{"type":"text","text":"wrapper struct around "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" if the underlying routes evolve."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Selective field redaction — encode only the fragments the app is"},{"type":"text","text":" "},{"type":"text","text":"willing to persist."}]}]}],"type":"unorderedList"},{"type":"heading","level":2,"text":"Customising the encoder","anchor":"Customising-the-encoder"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Any "},{"type":"codeVoice","code":"JSONEncoder"},{"type":"text","text":" and "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":" are acceptable inputs. Pass a"},{"type":"text","text":" "},{"type":"text","text":"preconfigured pair to the initializer for deterministic output, date"},{"type":"text","text":" "},{"type":"text","text":"strategies, or custom key coding:"}]},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let encoder = JSONEncoder()","encoder.outputFormatting = [.sortedKeys, .prettyPrinted]","","let decoder = JSONDecoder()","decoder.dateDecodingStrategy = .iso8601","","let persistence = StatePersistence<AppRoute>(encoder: encoder, decoder: decoder)"]},{"type":"heading","text":"Error surface","anchor":"Error-surface","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both "},{"type":"codeVoice","code":"encode(_:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"decode(_:)"},{"type":"text","text":" re-throw the underlying"},{"type":"text","text":" "},{"type":"codeVoice","code":"EncodingError"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"DecodingError"},{"type":"text","text":" so call sites keep the diagnostic"},{"type":"text","text":" "},{"type":"text","text":"context needed to distinguish schema drift from I\/O failures."}]}]}],"kind":"article","schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Tutorial-StatePersistence","interfaceLanguage":"swift"},"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"InnoRouterTesting"}],"title":"State Persistence and Restoration"},"abstract":[{"type":"codeVoice","code":"StatePersistence"},{"type":"text","text":" is a thin helper that serializes "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" values to "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" for launch-time restoration. It deliberately"},{"type":"text","text":" "},{"type":"text","text":"stops at the value boundary so apps keep full control over where — and"},{"type":"text","text":" "},{"type":"text","text":"when — snapshots are written."}],"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/tutorial-statepersistence"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"url":"\/documentation\/innoroutercore\/innoroutercore","type":"topic","kind":"article","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","title":"InnoRouterCore","abstract":[{"text":"State, command, result, and execution primitives for InnoRouter.","type":"text"}]},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouter