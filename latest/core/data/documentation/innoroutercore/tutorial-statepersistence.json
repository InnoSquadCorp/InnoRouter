{"metadata":{"role":"article","modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"State Persistence and Restoration"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/tutorial-statepersistence"]}],"schemaVersion":{"major":0,"minor":3,"patch":0},"abstract":[{"type":"codeVoice","code":"StatePersistence"},{"type":"text","text":" is a thin helper that serializes "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouteStack"},{"type":"text","text":" values to "},{"type":"codeVoice","code":"Data"},{"type":"text","text":" for launch-time restoration. It deliberately"},{"type":"text","text":" "},{"type":"text","text":"stops at the value boundary so apps keep full control over where — and"},{"type":"text","text":" "},{"type":"text","text":"when — snapshots are written."}],"kind":"article","sections":[],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Tutorial-StatePersistence","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"InnoRouter models a running flow as a single value (","type":"text"},{"type":"codeVoice","code":"FlowPlan<R>"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouteStack<R>"},{"text":"). When both the routes (","type":"text"},{"type":"codeVoice","code":"R"},{"text":") and the containing types","type":"text"},{"text":" ","type":"text"},{"text":"are ","type":"text"},{"type":"codeVoice","code":"Codable"},{"type":"text","text":", the entire state can round-trip through JSON. That is"},{"type":"text","text":" "},{"type":"text","text":"enough for state restoration, deep-link payloads, and offline replay."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"StatePersistence<R>"},{"type":"text","text":" bundles a "},{"type":"codeVoice","code":"JSONEncoder"},{"type":"text","text":" and "},{"type":"codeVoice","code":"JSONDecoder"},{"type":"text","text":" so"},{"type":"text","text":" "},{"type":"text","text":"call sites don’t have to redeclare them:"}]},{"code":["let persistence = StatePersistence<AppRoute>()","","\/\/ At checkpoint time (e.g. scene will deactivate):","let plan = try FlowPlan(validating: flowStore.path)","let data = try persistence.encode(plan)","try data.write(to: restorationURL, options: .atomic)","","\/\/ At launch time:","if let data = try? Data(contentsOf: restorationURL) {","    let restored = try persistence.decode(data)","    flowStore.apply(restored)","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"SwiftUI apps can wrap the value-level helper with"},{"type":"text","text":" "},{"type":"codeVoice","code":"StateRestorationAdapter"},{"type":"text","text":" from "},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":":"}]},{"code":["let adapter = StateRestorationAdapter<AppRoute> { failure in","    diagnostics.record(failure)","}","","try adapter.snapshotNavigationStack(from: navigationStore)","_ = adapter.restoreFlowPlan(from: data, into: flowStore)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"The adapter supports navigation-stack and flow-plan snapshots. Decode","type":"text"},{"text":" ","type":"text"},{"text":"or apply failures are reported through the restoration failure callback","type":"text"},{"text":" ","type":"text"},{"text":"and leave the existing store state untouched instead of falling back to","type":"text"},{"text":" ","type":"text"},{"text":"an empty path.","type":"text"}]},{"text":"Validation on decode","type":"heading","anchor":"Validation-on-decode","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" always satisfies the FlowStore invariants:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"At most one modal step."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"A modal step only at the tail of ","type":"text"},{"code":"steps","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"All other steps are "},{"type":"codeVoice","code":".push"},{"type":"text","text":"."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowPlan(validating:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"FlowPlan.validate(_:)"},{"type":"text","text":" enforce these"},{"type":"text","text":" "},{"type":"text","text":"invariants up front and throw "},{"type":"codeVoice","code":"FlowPlanValidationError"},{"type":"text","text":" on"},{"type":"text","text":" "},{"type":"text","text":"violation. Codable decode runs the same validator and converts a"},{"type":"text","text":" "},{"type":"text","text":"violation into "},{"type":"codeVoice","code":"DecodingError.dataCorruptedError"},{"type":"text","text":", so a"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" round-tripped through disk or network can no longer"},{"type":"text","text":" "},{"type":"text","text":"silently produce a value that "},{"type":"codeVoice","code":"apply(_:)"},{"type":"text","text":" will reject later. If"},{"type":"text","text":" "},{"type":"text","text":"the snapshot format on disk drifts (older builds, hand-edited"},{"type":"text","text":" "},{"type":"text","text":"JSON, schema migration mid-flight), the decode call surfaces the"},{"type":"text","text":" "},{"type":"text","text":"error at restoration time — not at the next user action."}]},{"type":"paragraph","inlineContent":[{"text":"The permissive ","type":"text"},{"code":"FlowPlan(steps:)","type":"codeVoice"},{"text":" initializer remains available","type":"text"},{"text":" ","type":"text"},{"text":"for internal builders that already trust the origin of ","type":"text"},{"code":"steps","type":"codeVoice"},{"text":".","type":"text"}]},{"text":"Scope","type":"heading","anchor":"Scope","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The helper intentionally covers only the typed "},{"type":"codeVoice","code":"Data ↔ value"},{"type":"text","text":" bridge."},{"type":"text","text":" "},{"type":"text","text":"Out of scope, by design:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Where the encoded bytes live ("},{"type":"codeVoice","code":"UserDefaults"},{"type":"text","text":", a file URL, iCloud,"},{"type":"text","text":" "},{"type":"text","text":"a database) — that is app policy."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"When snapshots are taken — tie the call into ","type":"text"},{"code":"ScenePhase","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":"UIScene","type":"codeVoice"},{"text":" lifecycle, or a custom trigger.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Version-aware migration from older snapshot formats — add a"},{"type":"text","text":" "},{"type":"text","text":"wrapper struct around "},{"type":"codeVoice","code":"FlowPlan"},{"type":"text","text":" if the underlying routes evolve."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Selective field redaction — encode only the fragments the app is","type":"text"},{"text":" ","type":"text"},{"text":"willing to persist.","type":"text"}]}]}]},{"text":"Customising the encoder","type":"heading","anchor":"Customising-the-encoder","level":2},{"type":"paragraph","inlineContent":[{"text":"Any ","type":"text"},{"code":"JSONEncoder","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"JSONDecoder","type":"codeVoice"},{"text":" are acceptable inputs. Pass a","type":"text"},{"text":" ","type":"text"},{"text":"preconfigured pair to the initializer for deterministic output, date","type":"text"},{"text":" ","type":"text"},{"text":"strategies, or custom key coding:","type":"text"}]},{"code":["let encoder = JSONEncoder()","encoder.outputFormatting = [.sortedKeys, .prettyPrinted]","","let decoder = JSONDecoder()","decoder.dateDecodingStrategy = .iso8601","","let persistence = StatePersistence<AppRoute>(encoder: encoder, decoder: decoder)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"text":"Error surface","type":"heading","anchor":"Error-surface","level":2},{"type":"paragraph","inlineContent":[{"text":"Both ","type":"text"},{"type":"codeVoice","code":"encode(_:)"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"decode(_:)"},{"text":" re-throw the underlying","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"EncodingError"},{"text":" \/ ","type":"text"},{"type":"codeVoice","code":"DecodingError"},{"text":" so call sites keep the diagnostic","type":"text"},{"text":" ","type":"text"},{"text":"context needed to distinguish schema drift from I\/O failures.","type":"text"}]}]}],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","role":"collection","type":"topic","kind":"symbol","abstract":[],"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"role":"collectionGroup","title":"InnoRouterCore","abstract":[{"text":"State, command, result, and execution primitives for InnoRouter.","type":"text"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","type":"topic","kind":"article","url":"\/documentation\/innoroutercore\/innoroutercore"}}}