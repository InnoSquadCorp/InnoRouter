ped outcome from "},{"type":"codeVoice","code":"DeepLinkEffectHandler"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"FlowDeepLinkEffectHandler"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Case"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Meaning"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".executed(plan:batch:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Every command in the plan succeeded; per-command results remain available in "},{"code":"batch","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".executionFailed(plan:batch:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Batch execution was attempted, but at least one command failed or was cancelled; inspect "},{"code":"batch.stateAfter","type":"codeVoice"},{"type":"text","text":" for partial changes"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".applicationRejected(plan:failure:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The push-only handler’s preflight rejected the plan before batch execution, so navigation state is unchanged"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".applicationRejected(plan:path:reason:)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The flow authority rejected an atomic plan; "},{"code":"path","type":"codeVoice"},{"type":"text","text":" is its snapshot at the rejection point and "},{"code":"reason","type":"codeVoice"},{"type":"text","text":" preserves the exact "},{"code":"FlowRejectionReason","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".pending(_)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Authorisation deferred; plan stored as "},{"code":"pendingDeepLink","type":"codeVoice"},