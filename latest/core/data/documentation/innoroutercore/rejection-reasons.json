.push(.profile))","if case .cancelled(let reason) = navigationResult {","    analytics.record(\"nav-cancel\", reason: reason)","}","let modalEvents = modalStore.events","let modalObservationTask = Task { @MainActor in","    for await event in modalEvents {","        if case .commandIntercepted(_, .cancelled(let reason)) = event {","            analytics.record(\"modal-cancel\", reason: reason)","        }","    }","}","let flowEvents = flowStore.events","let flowObservationTask = Task { @MainActor in","    for await event in flowEvents {","        if case .intentRejected(_, let reason) = event {","            analytics.record(\"flow-reject\", reason: reason)","        }","    }","}","#if os(visionOS)","let sceneEvents = sceneStore.events","let sceneObservationTask = Task { @MainActor in","    for await event in sceneEvents {","        if case .rejected(let intent, let reason) = event {","            analytics.record(\"scene-reject-\\(intent)\", reason: reason)","        } else if case .hostRegistrationRejected(let reason) = event {","            analytics.record(\"scene-host-reject\", reason: reason)","        }","    }","}","#endif"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"Deep-link outcomes surface through "},{"code":"DeepLinkEffectHandler.handle(_:)","type":"codeVoice"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"text","text":"return value rather than a stream, so wrap the call at the"},{"type":"text","text":" "},{"type":"text","text":"scene-phase boundary:"}],"type":"paragraph"},{"code":["let outcome = deepLinkHandler.handle(url)","switch outcome {","case .executed, .pending, .noPendingDeepLink:","    break","case .executionFailed(_, let batch):","    analytics.record(\"deeplink-execution-failed\", results: batch.results)","case .applicationRejected(_, let failure):","    analytics.record(\"deeplink-application-rejected\", result: failure.result)","case .rejected(let reason):","    analytics.record(\"deeplink-reject\", reason: reason)","case .unhandled(let url):","    analytics.record(\"deeplink-unhandled\", url: url)","case .invalidURL(let input):","    analytics.record(\"deeplink-invalid-url\", input: input)","case .missingDeepLinkURL:","    analytics.record(\"deeplink-missing-url\")","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"heading","level":2,"anchor":"Related","text":"Related"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics"}]}]}],"type":"unorderedList"}]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Rejection-Reasons"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/rejection-reasons"]}],"kind":"article","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"roleHeading":"Article","title":"Rejection Reasons catalog","modules":[{"name":"InnoRouterTesting"}],"role":"article"},"abstract":[{"type":"text","text":"One-stop reference for every rejection \/ cancellation \/ failure"},{"type":"text","text":" "},{"type":"text","text":"taxonomy in the InnoRouter stack — when each case fires, where it"},{"type":"text","text":" "},{"type":"text","text":"originates, and how to handle it."}],"references":{"doc://com.innosquad.innor