}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".noPendingDeepLink"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"resumePendingDeepLink()"},{"type":"text","text":" called with nothing stored"}]}]]],"type":"table"},{"type":"heading","level":2,"text":"How to observe every rejection in one place","anchor":"How-to-observe-every-rejection-in-one-place"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every store exposes an "},{"type":"codeVoice","code":"events: AsyncStream<Event>"},{"type":"text","text":" where rejection"},{"type":"text","text":" "},{"type":"text","text":"cases arrive alongside successful transitions. A single analytics"},{"type":"text","text":" "},{"type":"text","text":"listener can cover the full surface. Capture each stream before starting its"},{"text":" ","type":"text"},{"type":"text","text":"lifecycle-owned task so every subscriber is registered synchronously:"}]},{"type":"codeListing","code":["let navigationResult = navigationStore.execute(.push(.profile))","if case .cancelled(let reason) = navigationResult {","    analytics.record(\"nav-cancel\", reason: reason)","}","let modalEvents = modalStore.events","let modalObservationTask = Task { @MainActor in","    for await event in modalEvents {","        if case .commandIntercepted(_, .cancelled(let reason)) = event {","            analytics.record(\"modal-cancel\", reason: reason)","        }","    }","}","let flowEvents = flowStore.events","let flowObservationTask = Task { @MainActor in","    for await event in flowEvents {","        if case .intentRejected(_, let reason) = event {","            analytics.record(\"flow-reject\", reason: reason)","        }","    }","}","#if os(visionOS)","let sceneEvents = sceneStore.events","let sceneObservationTask = Task { @MainActor in","    for await event in sceneEvents {","        if case .rejected(let intent, let reason) = event {","            analytics.record(\"scene-reject-\\(intent)\", reason: reason)","        } else if case .hostRegistrationRejected(let reason) = event {","            analytics.record(\"scene-host-reject\", reason: reason)","        }","    }","}","#endif"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"Deep-link outcomes surface through ","type":"text"},{"type":"codeVoice","code":"DeepLinkEffectHandler.handle(_:)"},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"text":"return value rather than a stream, so wrap the call at the","type":"text"},{"text":" ","type":"text"},{"text":"scene-phase boundary:","type":"text"}]},{"type":"codeListing","code":["let outcome = deepLinkHandler.handle(url)","switch outcome {","case .executed, .pending, .noPendingDeepLink:","    break","case .executionFailed(_, let batch):","    analytics.record(\"deeplink-execution-failed\", results: batch.results)","case .applicationRejected(_, let failure):","    analytics.record(\"deeplink-application-rejected\", result: failure.result)","case .rejected(let reason):","    analytics.record(\"deeplink-reject\", reason: reason)","case .unhandled(let url):","    analytics.record(\"deeplink-unhandled\", url: url)","case .invalidURL(let input):","    analytics.record(\"deeplink-invalid-url\", input: input)","case .missingDeepLinkURL:","    analytics.record(\"deeplink-missing-url\")","}"],"syntax":"swift skip doc-fragment"},{"level":2,"type":"heading","anchor":"Related","text":"Related"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","isActive":true,"type":"reference"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics"}]}]}]}],"kind":"content"}],"kind":"article","sections":[],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Middleware-and-Cancellation":{"title":"Middleware and cancellation","url":"\/documentation\/innoroutercore\/middleware-and-cancellation","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","type":"topic","role":"article","abstract":[{"text":"Middleware is the cross-cutting policy layer for navigation execution.","type":"text"}],"kind":"article"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Command-Batch-and-Transaction-Semantics":{"title":"Command, batch, and transaction semantics","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics","url":"\/documentation\/innoroutercore\/command-batch-and-transaction-semantics","type":"topic","role":"article","abstract":[{"text":"InnoRouter exposes three different execution semantics on purpose.","type":"text"}],"kind":"article"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"type":"topic","abstract":[{"type":"text","text":"State, command, result, and execution primitives for InnoRouter."}],"kind":"article","title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","url":"\/documentation\/innoroutercore\/innoroutercore","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","type":"topic","role":"collection","abstract":[],"kind":"symbol"}}}