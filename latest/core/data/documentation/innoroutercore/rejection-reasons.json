ve alongside successful transitions. A single analytics","type":"text"},{"text":" ","type":"text"},{"text":"listener can cover the full surface. Capture each stream before starting its","type":"text"},{"text":" ","type":"text"},{"text":"lifecycle-owned task so every subscriber is registered synchronously:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let navigationResult = navigationStore.execute(.push(.profile))","if case .cancelled(let reason) = navigationResult {","    analytics.record(\"nav-cancel\", reason: reason)","}","let modalEvents = modalStore.events","let modalObservationTask = Task { @MainActor in","    for await event in modalEvents {","        if case .commandIntercepted(_, .cancelled(let reason)) = event {","            analytics.record(\"modal-cancel\", reason: reason)","        }","    }","}","let flowEvents = flowStore.events","let flowObservationTask = Task { @MainActor in","    for await event in flowEvents {","        if case .intentRejected(_, let reason) = event {","            analytics.record(\"flow-reject\", reason: reason)","        }","    }","}","#if os(visionOS)","let sceneEvents = sceneStore.events","let sceneObservationTask = Task { @MainActor in","    for await event in sceneEvents {","        if case .rejected(let intent, let reason) = event {","            analytics.record(\"scene-reject-\\(intent)\", reason: reason)","        } else if case .hostRegistrationRejected(let reason) = event {","            analytics.record(\"scene-host-reject\", reason: reason)","        }","    }","}","#endif"]},{"inlineContent":[{"text":"Deep-link outcomes surface through ","type":"text"},{"code":"DeepLinkEffectHandler.handle(_:)","type":"codeVoice"},{"text":"’s","type":"text"},{"text":" ","type":"text"},{"text":"return value rather than a stream, so wrap the call at the","type":"text"},{"text":" ","type":"text"},{"text":"scene-phase boundary:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let outcome = deepLinkHandler.handle(url)","switch outcome {","case .executed, .pending, .noPendingDeepLink:","    break","case .executionFailed(_, let batch):","    analytics.record(\"deeplink-execution-failed\", results: batch.results)","case .applicationRejected(_, let failure):","    analytics.record(\"deeplink-application-rejected\", result: failure.result)","case .rejected(let reason):","    analytics.record(\"deeplink-reject\", reason: reason)","case .unhandled(let url):","    analytics.record(\"deeplink-unhandled\", url: url)","case .invalidURL(let input):","    analytics.record(\"deeplink-invalid-url\", input: input)","case .missingDeepLinkURL:","    analytics.record(\"deeplink-missing-url\")","}"]},{"anchor":"Related","type":"heading","text":"Related","level":2},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","type":"reference","isActive":true}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics","type":"reference","isActive":true}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"metadata":{"role":"article","title":"Rejection Reasons catalog","roleHeading":"Article","modules":[{"name":"InnoRouterTesting"}]},"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","type":"topic","kind":"article","title":"InnoRouterCore","url":"\/documentation\/innoroutercore\/innoroutercore","role":"collectionGroup","abstract":[{"text":"State, command, result, and execution primitives for InnoRouter.","type":"text"}]},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","abstract":[],"kind":"symbol","role":"collection","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Middleware-and-Cancellation":{"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","kind":"article","title":"Middleware and cancellation","url":"\/documentation\/innoroutercore\/middleware-and-cancellation","role":"article","abstract":[{"text":"Middleware is the cross-cutting policy layer for navigation execution.","type":"text"}]},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Command-Batch-and-Transaction-Semantics":{"kind":"article","abstract":[{"text":"InnoRouter exposes three different execution semantics on purpose.","type":"text"}],"type":"topic","url":"\/documentation\/innoroutercore\/command-batch-and-transaction-semantics","role":"article","title":"Command, batch, and transaction semantics","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics"}}}