nly: a fallback "},{"code":"innoRouterSceneAnchor","type":"codeVoice"},{"type":"text","text":" cannot serve a cross-scene open while the elected host is not live"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Re-attach the manual "},{"code":"innoRouterSceneHost","type":"codeVoice"},{"type":"text","text":", or surface UI asking the user to focus the target scene"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".duplicateHostRegistration","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"A cooperative generated host lost election, or a manual second "},{"code":"innoRouterSceneHost","type":"codeVoice"},{"type":"text","text":" tried to register with the same store"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated: no action; a surviving dormant host retries after the elected host disappears. Manual: enforce one host per store"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".hostTornDownDuringDispatch","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The dispatcher’s "},{"code":"Task","type":"codeVoice"},{"type":"text","text":" was cancelled while a claimed intent was mid-flight"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Re-issue the intent once a host is live again"}]}]]]},{"type":"heading","level":2,"anchor":"Deep-links","text":"Deep links"},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Source"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symbol"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Emits through"}]}]],[[{"type":"paragraph","inlineContent":[{"code":"DeepLinkPipeline.decide(for:)","type":"codeVoice"},{"type":"text","text":" URL policy"}]}],[{"type":"paragraph","inlineContent":[{"code":"DeepLinkRejectionReason","type":"codeVoice"},{"type":"text","text":" (wrapped in "},{"code":"DeepLinkDecision.rejected","type":"codeVoice"},