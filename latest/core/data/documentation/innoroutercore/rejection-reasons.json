":"Interception returned ","type":"text"},{"type":"codeVoice","code":".cancel(.conditionFailed)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".custom(String)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Middleware surfaced a custom string","type":"text"}],"type":"paragraph"}]]],"header":"row"},{"text":"Flow","type":"heading","anchor":"Flow","level":2},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Source"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Symbol"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Emits through"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"FlowStore.send(_ intent:)"},{"type":"text","text":" refusal"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"FlowRejectionReason"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"FlowStoreConfiguration.onEvent"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"FlowStore.events"},{"type":"text","text":" as "},{"type":"codeVoice","code":"FlowEvent.intentRejected"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":"FlowStore.apply(_ plan:)"},{"type":"text","text":" rejection"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"FlowPlanApplyResult.rejected(currentPath:reason:)"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Synchronous return value with the exact "},{"code":"FlowRejectionReason","type":"codeVoice"}]}]]],"header":"row"},{"text":"`FlowRejectionReason`","type":"heading","anchor":"FlowRejectionReason","level":3},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Case"}]}],[{"inlineContent":[{"type":"text","text":"When it fires"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Typical handling"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".pushBlockedByModalTail"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":".push(_)"},{"type":"text","text":" requested while the flow tail is a "},{"type":"codeVoice","code":".sheet"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":".cover"},{"type":"text","text":" step"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Dismiss first, or use "},{"type":"codeVoice","code":".reset(_:)"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".invalidResetPath"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"type":"codeVoice","code":".reset([_])"},{"type":"text","text":" path violates FlowStore invariants (e.g. multiple modal steps, or a modal not at the tail)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Fix the path before sending"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".middlewareRejected(debugName:)"}]}],[{"inlineContent":[{"type":"text","text":"A navigation or modal middleware inside the flow cancelled the underlying command; "},{"type":"codeVoice","code":"FlowStore.path"},{"type":"text","text":" was rolled back"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Observe which middleware; surface telemetry"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":".reentrantApply","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"code":"FlowStore.apply(_:)","type":"codeVoice"},{"text":" was called synchronously while the store was already delivering a mutation event","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Schedule "},{"code":"send(.reset(_))","type":"codeVoice"},{"type":"text","text":" from the callback so the mutation is deferred"}]}]]],"header":"row"},{"text":"Scene (visionOS)","type":"heading","anchor":"Scene-visionOS","level":2},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Source"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Symbol"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Emits through"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"SceneStore","type":"codeVoice"},{"type":"text","text":" intent validation"}],"type":"paragraph"}],[{"inlineContent":[{"code":"SceneRejectionReason","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"SceneEvent.rejected(_:reason:)","type":"codeVoice"},{"type":"text","text":" + "},{"code":"SceneEvent.hostRegistrationRejected(reason:)","type":"codeVoice"}],"type":"paragraph"}]]]},{"text":"`SceneRejectionReason`","level":3,"type":"heading","anchor":"SceneRejectionReason"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Generated "},{"type":"codeVoice","code":"@SceneRouter"},{"type":"text","text":" trees attach cooperative full-authority hosts to every"},{"type":"text","text":" "},{"type":"text","text":"live scene root. If the elected host disappears, a surviving generated host is"},{"type":"text","text":" "},{"type":"text","text":"promoted automatically. The fallback-anchor and duplicate-host recovery steps"},{"type":"text","text":" "},{"type":"text","text":"below are therefore manual "},{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":" composition guidance; do not replace a"},{"type":"text","text":" "},{"type":"text","text":"generated host with a manual host or anchor."}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Case"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When it fires"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Typical handling"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".environmentReturnedFailure","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"OpenImmersiveSpaceAction.Result","type":"codeVoice"},{"type":"text","text":" was "},{"code":".userCancelled","type":"codeVoice"},{"type":"text","text":" or "},{"code":".error","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"User intent; surface a retry affordance if appropriate"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".nothingActive","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"dismissImmersive()","type":"codeVoice"},{"type":"text","text":" called while the entire scene inventory is empty"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Gate upstream; or ignore as idempotent"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".activeSceneMismatch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"dismissImmersive()","type":"codeVoice"},{"type":"text","text":" called with no active immersive space while another window or volume remains active"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Inspect "},{"code":"store.activeScenes","type":"codeVoice"},{"type":"text","text":"; dismiss the intended scene type instead"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".sceneNotDeclared","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Requested route missing from the shared "},{"code":"SceneRegistry","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Add the declaration, or fix the route"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".sceneDeclarationMismatch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Presentation kind \/ size \/ style does not match the registry entry"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Use the registry’s declaration unchanged"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".sceneInstanceNotActive","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"dismissWindow(_:)","type":"codeVoice"},{"type":"text","text":" received a window or volume presentation UUID that is not active in the inventory"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Keep the exact presentation returned by "},{"code":"openWindow","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"openVolumetric","type":"codeVoice"},{"type":"text","text":", and avoid stale handles"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".supersededByNewerIntent","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A newer intent replaced the pending one before the host committed it"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Expected during rapid intent bursts; no action"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".fallbackCannotDispatch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Manual composition only: a fallback "},{"code":"innoRouterSceneAnchor","type":"codeVoice"},{"type":"text","text":" cannot serve a cross-scene open while the elected host is not live"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Re-attach the manual "},{"code":"innoRouterSceneHost","type":"codeVoice"},{"type":"text","text":", or surface UI asking the user to focus the target scene"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".duplicateHostRegistration","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A cooperative generated host lost election, or a manual second "},{"code":"innoRouterSceneHost","type":"codeVoice"},{"type":"text","text":" tried to register with the same store"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Generated: no action; a surviving dormant host retries after the elected host disappears. Manual: enforce one host per store"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".hostTornDownDuringDispatch","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The dispatcher’s "},{"code":"Task","type":"codeVoice"},{"type":"text","text":" was cancelled while a claimed intent was mid-flight"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Re-issue the intent once a host is live again"}],"type":"paragraph"}]]]},{"text":"Deep links","level":2,"type":"heading","anchor":"Deep-links"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Source"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Symbol"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Emits through"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":"DeepLinkPipeline.decide(for:)","type":"codeVoice"},{"type":"text","text":" URL policy"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeepLinkRejectionReason","type":"codeVoice"},{"type":"text","text":" (wrapped in "},{"code":"DeepLinkDecision.rejected","type":"codeVoice"},{"type":"text","text":")"}],"type":"paragraph"}],[{"inlineContent":[{"code":"DeepLinkEffectHandler.Result.rejected","type":"codeVoice"}],"type":"paragraph"}]]]},{"text":"`DeepLinkRejectionReason`","level":3,"type":"heading","anchor":"DeepLinkRejectionReason"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Case"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"When it fires"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Typical handling"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".schemeNotAllowed(actualScheme:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"URL scheme not in "},{"code":"allowedSchemes","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Log, drop the URL silently, or surface a diagnostic"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".hostNotAllowed(actualHost:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"URL host not in "},{"code":"allowedHosts","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Same"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".inputLimitExceeded(violation)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Raw URL length, path segment count, query item count, or decoded component size exceeds "},{"code":"DeepLinkInputLimits","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Reject the input without retrying; adjust limits only when the app intentionally accepts a larger contract"}],"type":"paragraph"}]]]},{"text":"Deep-link effect results","level":3,"type":"heading","anchor":"Deep-link-effect-results"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The typed outcome from "},{"type":"codeVoice","code":"DeepLinkEffectHandler"},{"type":"text","text":" \/ "},{"type":"codeVoice","code":"FlowDeepLinkEffectHandler"},{"type":"text","text":":"}]},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Case"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Meaning"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".executed(plan:batch:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Every command in the plan succeeded; per-command results remain available in "},{"code":"batch","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".executionFailed(plan:batch:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Batch execution was attempted, but at least one command failed or was cancelled; inspect "},{"code":"batch.stateAfter","type":"codeVoice"},{"type":"text","text":" for partial changes"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".applicationRejected(plan:failure:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The push-only handler’s preflight rejected the plan before batch execution, so navigation state is unchanged"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".applicationRejected(plan:path:reason:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The flow authority rejected an atomic plan; "},{"code":"path","type":"codeVoice"},{"type":"text","text":" is its snapshot at the rejection point and "},{"code":"reason","type":"codeVoice"},{"type":"text","text":" preserves the exact "},{"code":"FlowRejectionReason","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".pending(_)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Authorisation deferred; plan stored as "},{"code":"pendingDeepLink","type":"codeVoice"},{"type":"text","text":" for later replay"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".rejected(reason:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"URL rejected by scheme, host, or input-limit policy — see "},{"code":"DeepLinkRejectionReason","type":"codeVoice"},{"type":"text","text":" above"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".unhandled(url:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"URL did not resolve to any route"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".invalidURL(input:)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A string input could not be parsed as a URL"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".missingDeepLinkURL","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"A "},{"code":"DeepLinkEffect","type":"codeVoice"},{"type":"text","text":" carried no URL"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".noPendingDeepLink","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"code":"resumePendingDeepLink()","type":"codeVoice"},{"type":"text","text":" called with nothing stored"}],"type":"paragraph"}]]]},{"text":"How to observe every rejection in one place","level":2,"type":"heading","anchor":"How-to-observe-every-rejection-in-one-place"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every store exposes an "},{"type":"codeVoice","code":"events: AsyncStream<Event>"},{"type":"text","text":" where rejection"},{"type":"text","text":" "},{"type":"text","text":"cases arrive alongside successful transitions. A single analytics"},{"type":"text","text":" "},{"type":"text","text":"listener can cover the full surface. Capture each stream before starting its"},{"type":"text","text":" "},{"type":"text","text":"lifecycle-owned task so every subscriber is registered synchronously:"}]},{"type":"codeListing","code":["let navigationResult = navigationStore.execute(.push(.profile))","if case .cancelled(let reason) = navigationResult {","    analytics.record(\"nav-cancel\", reason: reason)","}","let modalEvents = modalStore.events","let modalObservationTask = Task { @MainActor in","    for await event in modalEvents {","        if case .commandIntercepted(_, .cancelled(let reason)) = event {","            analytics.record(\"modal-cancel\", reason: reason)","        }","    }","}","let flowEvents = flowStore.events","let flowObservationTask = Task { @MainActor in","    for await event in flowEvents {","        if case .intentRejected(_, let reason) = event {","            analytics.record(\"flow-reject\", reason: reason)","        }","    }","}","#if os(visionOS)","let sceneEvents = sceneStore.events","let sceneObservationTask = Task { @MainActor in","    for await event in sceneEvents {","        if case .rejected(let intent, let reason) = event {","            analytics.record(\"scene-reject-\\(intent)\", reason: reason)","        } else if case .hostRegistrationRejected(let reason) = event {","            analytics.record(\"scene-host-reject\", reason: reason)","        }","    }","}","#endif"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Deep-link outcomes surface through "},{"type":"codeVoice","code":"DeepLinkEffectHandler.handle(_:)"},{"type":"text","text":"’s"},{"type":"text","text":" "},{"type":"text","text":"return value rather than a stream, so wrap the call at the"},{"type":"text","text":" "},{"type":"text","text":"scene-phase boundary:"}]},{"type":"codeListing","code":["let outcome = deepLinkHandler.handle(url)","switch outcome {","case .executed, .pending, .noPendingDeepLink:","    break","case .executionFailed(_, let batch):","    analytics.record(\"deeplink-execution-failed\", results: batch.results)","case .applicationRejected(_, let failure):","    analytics.record(\"deeplink-application-rejected\", result: failure.result)","case .rejected(let reason):","    analytics.record(\"deeplink-reject\", reason: reason)","case .unhandled(let url):","    analytics.record(\"deeplink-unhandled\", url: url)","case .invalidURL(let input):","    analytics.record(\"deeplink-invalid-url\", input: input)","case .missingDeepLinkURL:","    analytics.record(\"deeplink-missing-url\")","}"],"syntax":"swift skip doc-fragment"},{"text":"Related","level":2,"type":"heading","anchor":"Related"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics"}]}]}],"type":"unorderedList"}],"kind":"content"}],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"abstract":[{"type":"text","text":"State, command, result, and execution primitives for InnoRouter."}],"type":"topic","url":"\/documentation\/innoroutercore\/innoroutercore","kind":"article","title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","kind":"symbol","type":"topic","abstract":[],"role":"collection","url":"\/documentation\/innoroutertesting","title":"InnoRouterTesting"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Command-Batch-and-Transaction-Semantics":{"abstract":[{"type":"text","text":"InnoRouter exposes three different execution semantics on purpose."}],"type":"topic","url":"\/documentation\/innoroutercore\/command-batch-and-transaction-semantics","kind":"article","title":"Command, batch, and transaction semantics","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Command-Batch-and-Transaction-Semantics","role":"article"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Middleware-and-Cancellation":{"abstract":[{"type":"text","text":"Middleware is the cross-cutting policy layer for navigation execution."}],"type":"topic","url":"\/documentation\/innoroutercore\/middleware-and-cancellation","kind":"article","title":"Middleware and cancellation","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","role":"article"}}}