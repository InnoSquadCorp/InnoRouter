{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/event-stream-backpressure"]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"metadata":{"roleHeading":"Article","title":"Event Stream Backpressure","role":"article","modules":[{"name":"InnoRouterTesting"}]},"abstract":[{"text":"How the ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" stream of every store handles slow or stuck subscribers.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"kind":"article","primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Every ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"SceneStore","type":"codeVoice"},{"text":" ","type":"text"},{"text":"publishes an ","type":"text"},{"code":"events: AsyncStream","type":"codeVoice"},{"type":"text","text":" that fans every observation event"},{"type":"text","text":" "},{"type":"text","text":"out to every subscriber. The fan-out is implemented as a per-subscriber"},{"type":"text","text":" "},{"type":"codeVoice","code":"AsyncStream.Continuation"},{"type":"text","text":", which means a slow or cancelled subscriber"},{"type":"text","text":" "},{"type":"text","text":"that never drains its stream would otherwise retain every event"},{"type":"text","text":" "},{"type":"text","text":"indefinitely — behaving as an unbounded leak when the broadcaster"},{"type":"text","text":" "},{"type":"text","text":"outlives all consumers."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To bound that growth, every store accepts an"},{"type":"text","text":" "},{"code":"EventBufferingPolicy","type":"codeVoice"},{"type":"text","text":" in its configuration."}]},{"level":2,"type":"heading","text":"Default policy","anchor":"Default-policy"},{"type":"paragraph","inlineContent":[{"text":"The default is ","type":"text"},{"code":"EventBufferingPolicy.default","type":"codeVoice"},{"text":", which is","type":"text"},{"text":" ","type":"text"},{"code":".bufferingNewest(1024)","type":"codeVoice"},{"text":". The number is sized for realistic navigation","type":"text"},{"text":" ","type":"text"},{"text":"bursts (a few hundred events for the longest deep-link replay we have","type":"text"},{"text":" ","type":"text"},{"text":"measured) while keeping the retained working set bounded so a stuck","type":"text"},{"text":" ","type":"text"},{"text":"subscriber cannot balloon memory in production.","type":"text"}]},{"level":2,"type":"heading","text":"Choosing a policy","anchor":"Choosing-a-policy"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Policy","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Behaviour"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When to use","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".bufferingNewest(N)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Retain at most "},{"type":"codeVoice","code":"N"},{"type":"text","text":" most-recently-broadcast events per subscriber, dropping older events when the buffer fills."}],"type":"paragraph"}],[{"inlineContent":[{"text":"Production code that prefers loss-of-history over memory growth under contention. The default.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".bufferingOldest(N)","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Retain at most ","type":"text"},{"type":"codeVoice","code":"N"},{"text":" oldest-broadcast events per subscriber, dropping newer events when the buffer fills.","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Audit pipelines that care about the "},{"type":"emphasis","inlineContent":[{"text":"first","type":"text"}]},{"type":"text","text":" burst more than the latest tail (rare)."}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".unbounded"}]}],[{"type":"paragraph","inlineContent":[{"text":"Buffer every event until the subscriber drains it.","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Test harnesses or short-lived subscribers where you control lifetime and require deterministic, lossless ordering."}]}]]]},{"level":2,"type":"heading","text":"Configuring per store","anchor":"Configuring-per-store"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The policy is set per store at construction time via its configuration:"}]},{"code":["let store = try NavigationStore<HomeRoute>(","    initialPath: [.list],","    configuration: NavigationStoreConfiguration(","        eventBufferingPolicy: .bufferingNewest(2048)","    )",")"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Modal and Flow stores expose the same knob, with one policy per"},{"type":"text","text":" "},{"type":"text","text":"published stream:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"NavigationStoreConfiguration.eventBufferingPolicy"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"ModalStoreConfiguration.eventBufferingPolicy","type":"codeVoice"}]}]},{"content":[{"inlineContent":[{"code":"FlowStoreConfiguration.eventBufferingPolicy","type":"codeVoice"},{"text":" for the flow-level","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore.events","type":"codeVoice"},{"text":" fan-out","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FlowStoreConfiguration.navigation.eventBufferingPolicy","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"FlowStoreConfiguration.modal.eventBufferingPolicy","type":"codeVoice"},{"text":" for the wrapped","type":"text"},{"text":" ","type":"text"},{"text":"inner store streams","type":"text"}]}]}]},{"level":2,"type":"heading","text":"Drop semantics under load","anchor":"Drop-semantics-under-load"},{"type":"paragraph","inlineContent":[{"text":"Under sustained backpressure, the store keeps emitting events. Whether","type":"text"},{"text":" ","type":"text"},{"text":"the event reaches a slow subscriber depends on the policy chosen for","type":"text"},{"text":" ","type":"text"},{"text":"that subscriber’s store:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":".bufferingNewest(N)","type":"codeVoice"},{"text":": oldest events are dropped silently. The","type":"text"},{"text":" ","type":"text"},{"text":"subscriber sees a contiguous tail of the most recent N events the","type":"text"},{"text":" ","type":"text"},{"text":"store emitted.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".bufferingOldest(N)"},{"type":"text","text":": newer events are dropped silently after the"},{"type":"text","text":" "},{"type":"text","text":"buffer fills. The subscriber sees the first N events emitted after"},{"type":"text","text":" "},{"type":"text","text":"it started subscribing."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".unbounded"},{"type":"text","text":": nothing is dropped, but the per-subscriber queue can"},{"type":"text","text":" "},{"type":"text","text":"grow without bound while the subscriber falls behind."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Drops are not surfaced as an event. If your analytics pipeline must"},{"type":"text","text":" "},{"type":"text","text":"distinguish “no event happened” from “an event was buffered out”, use"},{"type":"text","text":" "},{"type":"codeVoice","code":".unbounded"},{"type":"text","text":" for that subscriber and rely on your own pacing rather"},{"type":"text","text":" "},{"type":"text","text":"than the broadcaster."}]},{"level":2,"type":"heading","text":"Lifetime contract","anchor":"Lifetime-contract"},{"type":"paragraph","inlineContent":[{"text":"Each subscriber owns one ","type":"text"},{"type":"codeVoice","code":"AsyncStream"},{"text":". When the subscriber’s","type":"text"},{"text":" ","type":"text"},{"text":"iterator goes out of scope, ","type":"text"},{"type":"codeVoice","code":"AsyncStream.Continuation.onTermination"},{"text":" ","type":"text"},{"text":"fires and the broadcaster releases its slot. Stores also finish all","type":"text"},{"text":" ","type":"text"},{"text":"outstanding continuations on ","type":"text"},{"type":"codeVoice","code":"isolated deinit"},{"text":", so ","type":"text"},{"type":"codeVoice","code":"for await"},{"text":" loops","type":"text"},{"text":" ","type":"text"},{"text":"terminate naturally when their store is released — no manual cleanup","type":"text"},{"text":" ","type":"text"},{"text":"required.","type":"text"}]},{"level":2,"type":"heading","text":"Related","anchor":"Related"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Rejection-Reasons","type":"reference"}]}]}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Event-Stream-Backpressure","interfaceLanguage":"swift"},"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"url":"\/documentation\/innoroutercore\/innoroutercore","type":"topic","kind":"article","role":"collectionGroup","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","title":"InnoRouterCore","abstract":[{"text":"State, command, result, and execution primitives for InnoRouter.","type":"text"}]},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic","role":"collection","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","abstract":[],"kind":"symbol"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Middleware-and-Cancellation":{"title":"Middleware and cancellation","abstract":[{"type":"text","text":"Middleware is the cross-cutting policy layer for navigation execution."}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","url":"\/documentation\/innoroutercore\/middleware-and-cancellation","kind":"article","role":"article","type":"topic"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Rejection-Reasons":{"type":"topic","url":"\/documentation\/innoroutercore\/rejection-reasons","kind":"article","role":"article","title":"Rejection Reasons catalog","abstract":[{"text":"One-stop reference for every rejection \/ cancellation \/ failure","type":"text"},{"text":" ","type":"text"},{"text":"taxonomy in the InnoRouter stack — when each case fires, where it","type":"text"},{"text":" ","type":"text"},{"text":"originates, and how to handle it.","type":"text"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Rejection-Reasons"}}}