{"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/event-stream-backpressure"]}],"kind":"article","abstract":[{"text":"How the ","type":"text"},{"type":"codeVoice","code":"events"},{"text":" stream of every store handles slow or stuck subscribers.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"Every "},{"type":"codeVoice","code":"NavigationStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"ModalStore"},{"type":"text","text":", "},{"type":"codeVoice","code":"FlowStore"},{"type":"text","text":", and "},{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":" "},{"type":"text","text":"publishes an "},{"type":"codeVoice","code":"events: AsyncStream"},{"text":" that fans every observation event","type":"text"},{"text":" ","type":"text"},{"text":"out to every subscriber. The fan-out is implemented as a per-subscriber","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AsyncStream.Continuation"},{"text":", which means a slow or cancelled subscriber","type":"text"},{"text":" ","type":"text"},{"text":"that never drains its stream would otherwise retain every event","type":"text"},{"text":" ","type":"text"},{"text":"indefinitely — behaving as an unbounded leak when the broadcaster","type":"text"},{"type":"text","text":" "},{"type":"text","text":"outlives all consumers."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To bound that growth, every store accepts an"},{"type":"text","text":" "},{"code":"EventBufferingPolicy","type":"codeVoice"},{"type":"text","text":" in its configuration."}],"type":"paragraph"},{"level":2,"text":"Default policy","type":"heading","anchor":"Default-policy"},{"inlineContent":[{"type":"text","text":"The default is "},{"code":"EventBufferingPolicy.default","type":"codeVoice"},{"type":"text","text":", which is"},{"type":"text","text":" "},{"code":".bufferingNewest(1024)","type":"codeVoice"},{"type":"text","text":". The number is sized for realistic navigation"},{"type":"text","text":" "},{"type":"text","text":"bursts (a few hundred events for the longest deep-link replay we have"},{"type":"text","text":" "},{"type":"text","text":"measured) while keeping the retained working set bounded so a stuck"},{"type":"text","text":" "},{"type":"text","text":"subscriber cannot balloon memory in production."}],"type":"paragraph"},{"level":2,"text":"Choosing a policy","type":"heading","anchor":"Choosing-a-policy"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Policy","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Behaviour","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"When to use","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":".bufferingNewest(N)"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Retain at most "},{"type":"codeVoice","code":"N"},{"type":"text","text":" most-recently-broadcast events per subscriber, dropping older events when the buffer fills."}]}],[{"type":"paragraph","inlineContent":[{"text":"Production code that prefers loss-of-history over memory growth under contention. The default.","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".bufferingOldest(N)","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Retain at most ","type":"text"},{"code":"N","type":"codeVoice"},{"text":" oldest-broadcast events per subscriber, dropping newer events when the buffer fills.","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Audit pipelines that care about the ","type":"text"},{"inlineContent":[{"text":"first","type":"text"}],"type":"emphasis"},{"text":" burst more than the latest tail (rare).","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"code":".unbounded","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Buffer every event until the subscriber drains it."}]}],[{"type":"paragraph","inlineContent":[{"text":"Test harnesses or short-lived subscribers where you control lifetime and require deterministic, lossless ordering.","type":"text"}]}]]]},{"level":2,"text":"Configuring per store","type":"heading","anchor":"Configuring-per-store"},{"inlineContent":[{"type":"text","text":"The policy is set per store at construction time via its configuration:"}],"type":"paragraph"},{"code":["let store = try NavigationStore<HomeRoute>(","    initialPath: [.list],","    configuration: NavigationStoreConfiguration(","        eventBufferingPolicy: .bufferingNewest(2048)","    )",")"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"Modal and Flow stores expose the same knob, with one policy per"},{"type":"text","text":" "},{"type":"text","text":"published stream:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"NavigationStoreConfiguration.eventBufferingPolicy"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"ModalStoreConfiguration.eventBufferingPolicy"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"FlowStoreConfiguration.eventBufferingPolicy","type":"codeVoice"},{"text":" for the flow-level","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore.events","type":"codeVoice"},{"text":" fan-out","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"FlowStoreConfiguration.navigation.eventBufferingPolicy","type":"codeVoice"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"code":"FlowStoreConfiguration.modal.eventBufferingPolicy","type":"codeVoice"},{"text":" for the wrapped","type":"text"},{"text":" ","type":"text"},{"text":"inner store streams","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Drop semantics under load","type":"heading","anchor":"Drop-semantics-under-load"},{"inlineContent":[{"type":"text","text":"Under sustained backpressure, the store keeps emitting events. Whether"},{"type":"text","text":" "},{"type":"text","text":"the event reaches a slow subscriber depends on the policy chosen for"},{"type":"text","text":" "},{"type":"text","text":"that subscriber’s store:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":".bufferingNewest(N)","type":"codeVoice"},{"text":": oldest events are dropped silently. The","type":"text"},{"text":" ","type":"text"},{"text":"subscriber sees a contiguous tail of the most recent N events the","type":"text"},{"text":" ","type":"text"},{"text":"store emitted.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":".bufferingOldest(N)","type":"codeVoice"},{"text":": newer events are dropped silently after the","type":"text"},{"text":" ","type":"text"},{"text":"buffer fills. The subscriber sees the first N events emitted after","type":"text"},{"text":" ","type":"text"},{"text":"it started subscribing.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":".unbounded","type":"codeVoice"},{"type":"text","text":": nothing is dropped, but the per-subscriber queue can"},{"type":"text","text":" "},{"type":"text","text":"grow without bound while the subscriber falls behind."}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Drops are not surfaced as an event. If your analytics pipeline must"},{"type":"text","text":" "},{"type":"text","text":"distinguish “no event happened” from “an event was buffered out”, use"},{"type":"text","text":" "},{"type":"codeVoice","code":".unbounded"},{"type":"text","text":" for that subscriber and rely on your own pacing rather"},{"type":"text","text":" "},{"type":"text","text":"than the broadcaster."}],"type":"paragraph"},{"level":2,"text":"Lifetime contract","type":"heading","anchor":"Lifetime-contract"},{"inlineContent":[{"text":"Each subscriber owns one ","type":"text"},{"code":"AsyncStream","type":"codeVoice"},{"text":". When the subscriber’s","type":"text"},{"text":" ","type":"text"},{"text":"iterator goes out of scope, ","type":"text"},{"code":"AsyncStream.Continuation.onTermination","type":"codeVoice"},{"text":" ","type":"text"},{"text":"fires and the broadcaster removes that slot from its private","type":"text"},{"text":" ","type":"text"},{"text":"continuation storage. When a store releases its broadcaster, that","type":"text"},{"text":" ","type":"text"},{"text":"storage deinitializes, snapshots any outstanding continuations, and","type":"text"},{"text":" ","type":"text"},{"text":"finishes them outside the broadcaster’s actor-isolated deinitializer.","type":"text"},{"text":" ","type":"text"},{"text":"As a result, ","type":"text"},{"code":"for await","type":"codeVoice"},{"text":" loops terminate naturally when their store is","type":"text"},{"text":" ","type":"text"},{"text":"released - no manual cleanup required.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Related","type":"heading","anchor":"Related"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","isActive":true,"type":"reference"}]}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Rejection-Reasons","isActive":true,"type":"reference"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Event-Stream-Backpressure","interfaceLanguage":"swift"},"schemaVersion":{