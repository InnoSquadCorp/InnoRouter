{"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","title":"Event Stream Backpressure","role":"article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutercore\/event-stream-backpressure"]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"],["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Event-Stream-Backpressure"},"abstract":[{"text":"How the ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" stream of every store handles slow or stuck subscribers.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"text","text":"Every "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":", "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":", "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":", and "},{"code":"SceneStore","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"publishes an "},{"code":"events: AsyncStream","type":"codeVoice"},{"type":"text","text":" that fans every observation event"},{"type":"text","text":" "},{"type":"text","text":"out to every subscriber. The fan-out is implemented as a per-subscriber"},{"type":"text","text":" "},{"code":"AsyncStream.Continuation","type":"codeVoice"},{"type":"text","text":", which means a slow or cancelled subscriber"},{"type":"text","text":" "},{"type":"text","text":"that never drains its stream would otherwise retain every event"},{"type":"text","text":" "},{"type":"text","text":"indefinitely — behaving as an unbounded leak when the broadcaster"},{"type":"text","text":" "},{"type":"text","text":"outlives all consumers."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To bound that growth, every store uses an "},{"code":"EventBufferingPolicy","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":", ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" expose the policy through","type":"text"},{"text":" ","type":"text"},{"text":"their configurations. ","type":"text"},{"code":"SceneStore","type":"codeVoice"},{"text":" currently uses the default policy.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Each access to a store’s ","type":"text"},{"code":"events","type":"codeVoice"},{"text":" property creates and synchronously registers","type":"text"},{"text":" ","type":"text"},{"text":"a new subscriber. Capture that stream before starting its lifecycle-owned task;","type":"text"},{"text":" ","type":"text"},{"text":"otherwise a route mutation performed immediately after task creation can occur","type":"text"},{"text":" ","type":"text"},{"text":"before the task first evaluates ","type":"text"},{"code":"store.events","type":"codeVoice"},{"text":". Request a fresh stream for each","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"independent consumer."}]},{"text":"Default policy","type":"heading","anchor":"Default-policy","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default is "},{"type":"codeVoice","code":"EventBufferingPolicy.default"},{"type":"text","text":", which is"},{"type":"text","text":" "},{"type":"codeVoice","code":".bufferingNewest(1024)"},{"type":"text","text":". The number is sized for realistic navigation"},{"type":"text","text":" "},{"type":"text","text":"bursts (a few hundred events for the longest deep-link replay we have"},{"type":"text","text":" "},{"type":"text","text":"measured) while keeping the retained working set bounded so a stuck"},{"type":"text","text":" "},{"type":"text","text":"subscriber cannot balloon memory in production."}]},{"anchor":"Choosing-a-policy","text":"Choosing a policy","type":"heading","level":2},{"rows":[[[{"inlineContent":[{"type":"text","text":"Policy"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Behaviour","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"When to use","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"codeVoice","code":".bufferingNewest(N)"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Retain at most ","type":"text"},{"code":"N","type":"codeVoice"},{"text":" most-recently-broadcast events per subscriber, dropping older events when the buffer fills.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Production code that prefers loss-of-history over memory growth under contention. The default.","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"code":".bufferingOldest(N)","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Retain at most ","type":"text"},{"code":"N","type":"codeVoice"},{"text":" oldest-broadcast events per subscriber, dropping newer events when the buffer fills.","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Audit pipelines that care about the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"first"}]},{"type":"text","text":" burst more than the latest tail (rare)."}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"code":".unbounded","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Buffer every event until the subscriber drains it."}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Test harnesses or short-lived subscribers where you control lifetime and require deterministic, lossless ordering."}]}]]],"type":"table","header":"row"},{"level":2,"anchor":"Configuring-supported-stores","type":"heading","text":"Configuring supported stores"},{"inlineContent":[{"text":"For Navigation, Modal, and Flow stores, the policy is set at construction","type":"text"},{"text":" ","type":"text"},{"text":"time via the store’s configuration:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let store = try NavigationStore<HomeRoute>(","    initialPath: [.list],","    configuration: NavigationStoreConfiguration(","        eventBufferingPolicy: .bufferingNewest(2048)","    )",")"]},{"inlineContent":[{"type":"text","text":"Modal and Flow stores expose the same knob, with one policy per"},{"type":"text","text":" "},{"type":"text","text":"published stream:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"NavigationStoreConfiguration.eventBufferingPolicy"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"ModalStoreConfiguration.eventBufferingPolicy","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowStoreConfiguration.eventBufferingPolicy"},{"type":"text","text":" for the flow-level"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStore.events"},{"type":"text","text":" fan-out"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"FlowStoreConfiguration.navigation.eventBufferingPolicy"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"FlowStoreConfiguration.modal.eventBufferingPolicy"},{"type":"text","text":" for the wrapped"},{"type":"text","text":" "},{"type":"text","text":"inner store streams"}]}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"SceneStore"},{"type":"text","text":" does not currently expose a buffering configuration. Its events"},{"type":"text","text":" "},{"type":"text","text":"stream always uses "},{"type":"codeVoice","code":"EventBufferingPolicy.default"},{"type":"text","text":"."}]},{"type":"heading","text":"Drop semantics under load","anchor":"Drop-semantics-under-load","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Under sustained backpressure, the store keeps emitting events. Whether"},{"type":"text","text":" "},{"type":"text","text":"the event reaches a slow subscriber depends on the policy chosen for"},{"type":"text","text":" "},{"type":"text","text":"that subscriber’s store:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":".bufferingNewest(N)"},{"type":"text","text":": oldest events are dropped silently. The"},{"type":"text","text":" "},{"type":"text","text":"subscriber sees a contiguous tail of the most recent N events the"},{"type":"text","text":" "},{"type":"text","text":"store emitted."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".bufferingOldest(N)"},{"text":": newer events are dropped silently after the","type":"text"},{"text":" ","type":"text"},{"text":"buffer fills. The subscriber sees the first N events emitted after","type":"text"},{"type":"text","text":" "},{"type":"text","text":"it started subscribing."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":".unbounded"},{"type":"text","text":": nothing is dropped, but the per-subscriber queue can"},{"type":"text","text":" "},{"type":"text","text":"grow without bound while the subscriber falls behind."}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Drops are not surfaced as an event. If your analytics pipeline must","type":"text"},{"text":" ","type":"text"},{"text":"distinguish “no event happened” from “an event was buffered out”, use","type":"text"},{"text":" ","type":"text"},{"code":".unbounded","type":"codeVoice"},{"text":" for that subscriber and rely on your own pacing rather","type":"text"},{"text":" ","type":"text"},{"text":"than the broadcaster.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Lifetime contract","anchor":"Lifetime-contract"},{"inlineContent":[{"type":"text","text":"Each subscriber owns one "},{"code":"AsyncStream","type":"codeVoice"},{"type":"text","text":". When the subscriber’s"},{"type":"text","text":" "},{"type":"text","text":"iterator goes out of scope, "},{"code":"AsyncStream.Continuation.onTermination","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"fires and the broadcaster removes that slot from its private"},{"type":"text","text":" "},{"type":"text","text":"continuation storage. When a store releases its broadcaster, that"},{"type":"text","text":" "},{"type":"text","text":"storage deinitializes, snapshots any outstanding continuations, and"},{"type":"text","text":" "},{"text":"finishes them outside the broadcaster’s actor-isolated deinitializer.","type":"text"},{"text":" ","type":"text"},{"text":"Cancelling the consumer task also terminates the subscription. Tie that task to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the owning feature or scene; "},{"code":"for await","type":"codeVoice"},{"type":"text","text":" loops additionally terminate naturally"},{"type":"text","text":" "},{"type":"text","text":"when their store is released."}],"type":"paragraph"},{"type":"heading","level":2,"anchor":"Related","text":"Related"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Rejection-Reasons"}],"type":"paragraph"}]}]}],"kind":"content"}],"kind":"article","sections":[],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Middleware-and-Cancellation":{"title":"Middleware and cancellation","url":"\/documentation\/innoroutercore\/middleware-and-cancellation","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Middleware-and-Cancellation","type":"topic","role":"article","abstract":[{"text":"Middleware is the cross-cutting policy layer for navigation execution.","type":"text"}],"kind":"article"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/InnoRouterCore":{"type":"topic","abstract":[{"type":"text","text":"State, command, result, and execution primitives for InnoRouter."}],"kind":"article","title":"InnoRouterCore","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/InnoRouterCore","url":"\/documentation\/innoroutercore\/innoroutercore","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterCore/Rejection-Reasons":{"title":"Rejection Reasons catalog","url":"\/documentation\/innoroutercore\/rejection-reasons","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterCore\/Rejection-Reasons","type":"topic","role":"article","abstract":[{"type":"text","text":"One-stop reference for every rejection \/ cancellation \/ failure"},{"type":"text","text":" "},{"type":"text","text":"taxonomy in the InnoRouter stack — when each case fires, where it"},{"type":"text","text":" "},{"type":"text","text":"originates, and how to handle it."}],"kind":"article"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","type":"topic","role":"collection","abstract":[],"kind":"symbol"}}}