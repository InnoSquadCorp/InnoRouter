eclarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}]}]},{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"type":"codeVoice","code":"TestStore"},{"type":"text","text":" exhaustivity model:"},{"type":"text","text":" "},{"type":"text","text":"events collected from the underlying authority’s unified "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"type":"codeVoice","code":".strict"},{"type":"text","text":" mode, the store reports events left pending at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}]},{"type":"aside","style":"note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"code":"deinit","type":"codeVoice"},{"text":" to an ","type":"text"},{"inlineContent":[{"type":"text","text":"unknown test"}],"type":"emphasis"},{"text":" rather than to the test that","type":"text"},{"text":" ","type":"text"},{"text":"owned the store, which makes a deinit-time leftover-event failure","type":"text"},{"text":" ","type":"text"},{"text":"hard to locate. Until that is resolved upstream, await all work and end","type":"text"},{"text":" ","type":"text"},{"text":"each test with an explicit ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":". It runs the strict check with the","type":"text"},{"text":" ","type":"text"},{"text":"caller’s source location and disarms the deinit-time fallback.","type":"text"}]}],"name":"Note"}]}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting"]]},"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting/TestExhaustivity/Equatable-Implementations":{"title":"Equatable Implementations","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations","role":"collectionGroup","url":"\/documentation\/innoroutertesting\/testexhaustivity\/equatable-implementations","abstract":[],"kind":"article","type":"topic"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","role":"collection","abstract":[],"kind":"symbol","url":"\/documentation\/innoroutertesting","type":"topic"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting/TestExhaustivity/strict":{"title":"TestExhaustivity.strict","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"strict","kind":"identifier"}],"url":"\/documentation\/innoroutertesting\/testexhaustivity\/strict","abstract":[{"type":"text","text":"Every observed event must be drained through "},{"code":"receive(...)","type":"codeVoice"},{"type":"text","text":" before"},{"type":"text","text":" "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" or deallocation. Pending events fail the test. This is the"},{"type":"text","text":" "},{"type":"text","text":"default and matches TCA’s "},{"code":"exhaustive","type":"codeVoice"},{"type":"text","text":" semantics."}],"kind":"symbol","type":"topic"},"doc://com.innosquad.innorouter.docs.core/s16SendableMetatypeP":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/s16SendableMetatypeP","title":"Swift.SendableMetatype","type":"unresolvable"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting/TestExhaustivity":{"title":"TestExhaustivity","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting\/TestExhaustivity","role":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TestExhaustivity","kind":"identifier"}],"url":"\/documentation\/innoroutertesting\/testexhaustivity","abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"type":"text","text":" "},{"type":"text","text":"finishes."}],"kind":"symbol","navigatorTitle":[{"text":"TestExhaustivity","kind":"identifier"}],"type":"topic"},"doc://com.innosquad.innorouter.docs.core/SQ":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/SQ","title":"Swift.Equatable","type":"unresolvable"},"doc://com.innosquad.innorouter.docs.core/s8SendableP":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/s8SendableP","title":"Swift.Sendable","type":"unresolvable"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting/TestExhaustivity/off":{"title":"TestExhaustivity.off","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"off","kind":"identifier"}],"url":"\/documentation\/innoroutertesting\/testexhaustivity\/off","abstract":[{"type":"text","text":"The test store still delivers events through "},{"code":"receive(...)","type":"codeVoice"},{"type":"text","text":", but pending"},{"type":"text","text":" "},{"type":"text","text":"events at "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" or deallocation are silently discarded. Explicit"},{"type":"text","text":" "},{"type":"text","text":"assertions and events emitted after "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" still report issues."},{"type":"text","text":" "},{"type":"text","text":"Useful for incremental migrations of large legacy suites."}],"kind":"symbol","type":"topic"},"doc://com.innosquad.innorouter.docs.core/SH":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/SH","title":"Swift.Hashable","type":"unresolvable"}}}