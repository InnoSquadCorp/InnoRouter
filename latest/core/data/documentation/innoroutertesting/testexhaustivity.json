olated "},{"type":"codeVoice","code":"deinit"},{"text":" to an ","type":"text"},{"inlineContent":[{"text":"unknown test","type":"text"}],"type":"emphasis"},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"text":"hard to locate. Until that is resolved upstream, await all work and end","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"each test with an explicit "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}],"type":"paragraph"}],"style":"note"}]}],"kind":"symbol","sections":[],"references":{"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting":{"title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting","type":"topic","role":"collection","abstract":[],"kind":"symbol"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting/TestExhaustivity/Equatable-Implementations":{"type":"topic","abstract":[],"kind":"article","title":"Equatable Implementations","url":"\/documentation\/innoroutertesting\/testexhaustivity\/equatable-implementations","identifier":"doc:\/\/com.innosquad.innorouter.docs.core\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.core/documentation/InnoRouterTesting/TestExhaustivity/off":{"abstract":[{"text":"The test store still delivers events through ","type":"text"},{"code":"receive(...)","type":"codeVoice"},{"text":", but pending","type":"text"},{"text":" ","type":"text"},{"text":"events at ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" or deallocation are silently discard