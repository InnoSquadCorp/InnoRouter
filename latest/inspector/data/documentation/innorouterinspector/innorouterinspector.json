rtPolicy","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorStateTree","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorStateDiff"],"anchor":"Timeline-values"},{"title":"User interface","identifiers":["doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorView","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorDeepLinkView","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorDeepLinkAnalyzer","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorScenarioController","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorScenarioStatus","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorScenarioFailure"],"anchor":"User-interface"}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouterinspector\/innorouterinspector"]}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"InnoRouterInspector"},{"type":"text","text":" is an opt-in product that observes the canonical"},{"type":"text","text":" "},{"code":"RouterStore","type":"codeVoice"},{"type":"text","text":" event stream. Timeline capture and pure-reducer previews do not"},{"type":"text","text":" "},{"type":"text","text":"intercept or mutate routing operations. The optional deep-link workbench has"},{"type":"text","text":" "},{"type":"text","text":"a separate, explicit execution action that submits through the live store."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Create a "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorRecorder","isActive":true},{"type":"text","text":", attach the store that"},{"type":"text","text":" "},{"type":"text","text":"should be observed, and retain each"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorSubscription","isActive":true},{"type":"text","text":" for the desired capture"},{"type":"text","text":" "},{"type":"text","text":"lifetime. Default formatters retain operation names, outcomes, styles, and"},{"type":"text","text":" "},{"type":"text","text":"counts while excluding route payload descriptions. A custom"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorFormatter","isActive":true},{"type":"text","text":" is the explicit opt-in point"},{"type":"text","text":" "},{"type":"text","text":"for app-specific details."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorView","type":"reference"},{"text":" presents the bounded timeline with","type":"text"},{"text":" ","type":"text"},{"text":"domain filters, pause\/resume, rejection breakpoints, bookmarks, arbitrary A\/B","type":"text"},{"text":" ","type":"text"},{"text":"comparison, native JSON snapshot\/bundle import, bundle export, step controls,","type":"text"},{"text":" ","type":"text"},{"text":"clear, and entry detail.","type":"text"},{"text":" ","type":"text"},{"text":"When the app also imports ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":", pass a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorScenarioController","type":"reference"},{"text":" created by its","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"standard "},{"type":"codeVoice","code":"routerScenario(store:)"},{"type":"text","text":" adapter. This adds explicit start, progress,"},{"type":"text","text":" "},{"type":"text","text":"stop, completeness, and raw fixture import\/export. Raw fixture controls are"},{"type":"text","text":" "},{"type":"text","text":"visibly separate because route payloads may be present."},{"type":"text","text":" "},{"type":"text","text":"Start, stop, and import failures use"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorScenarioFailure"},{"type":"text","text":" and localized generic"},{"type":"text","text":" "},{"type":"text","text":"summaries. Arbitrary decoder or application error descriptions are not shown,"},{"type":"text","text":" "},{"type":"text","text":"and a failed import clears any stale raw fixture that could otherwise be shared."},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorSnapshot"},{"type":"text","text":" is a value-only, Codable export"},{"type":"text","text":" "},{"type":"text","text":"suitable for attaching to a bug report after the app has applied its own"},{"type":"text","text":" "},{"type":"text","text":"retention and disclosure policy."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorDiagnosticBundle","isActive":true,"type":"reference"},{"text":" wraps that redacted","type":"text"},{"text":" ","type":"text"},{"text":"snapshot with its InnoRouter release and Apple platform identity. The recorder","type":"text"},{"text":" ","type":"text"},{"text":"encodes bundles with stable JSON key and bookmark ordering. Default formatters","type":"text"},{"text":" ","type":"text"},{"text":"remain payload-safe; applications that install custom formatters must review","type":"text"},{"text":" ","type":"text"},{"text":"the app-owned metadata before sharing a bundle. ","type":"text"},{"code":"importDiagnosticBundle(from:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"reopens the session and returns its original environment metadata. Unsupported","type":"text"},{"text":" ","type":"text"},{"text":"format versions fail before decoding entries, and failed imports preserve the","type":"text"},{"text":" ","type":"text"},{"text":"current timeline and bookmarks.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The recorder can import that export with an explicit replace or append policy."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorPlayback","isActive":true},{"type":"text","text":" steps through an imported"},{"type":"text","text":" "},{"type":"text","text":"session without a live store, while"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorComparison","isActive":true},{"type":"text","text":" compares final states across"},{"type":"text","text":" "},{"type":"text","text":"sessions or any two captured states in one session. Entries include correlated"},{"type":"text","text":" "},{"type":"text","text":"elapsed and transition-duration metadata. All comparisons operate on"},{"type":"text","text":" "},{"type":"text","text":"payload-redacted trees, and older snapshots without bookmarks remain decodable."},{"type":"text","text":" "},{"type":"text","text":"Byte and entry limits apply to both snapshot and bundle imports before entry"},{"type":"text","text":" "},{"type":"text","text":"decoding. Duplicate envelope keys are rejected, escaped keys are recognized,"},{"type":"text","text":" "},{"type":"text","text":"and orphan bookmarks are discarded. Replacing a timeline clears live timing"},{"type":"text","text":" "},{"type":"text","text":"correlation so imported sessions cannot inherit durations from earlier work."}]},{"type":"paragraph","inlineContent":[{"text":"For a macro router declared with ","type":"text"},{"code":"inspectorCatalog: true","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorDeepLinkView","isActive":true,"type":"reference"},{"text":" is an opt-in URL workbench.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorDeepLinkAnalyzer","isActive":true,"type":"reference"},{"text":" projects the generated","type":"text"},{"text":" ","type":"text"},{"text":"catalog, ordered attempts, and terminal failure without route payload values or","type":"text"},{"text":" ","type":"text"},{"text":"navigation side effects. Its preview API uses the pure reducer for a redacted","type":"text"},{"type":"text","text":" "},{"type":"text","text":"target diff. The "},{"type":"codeVoice","code":"store:"},{"type":"text","text":" view initializer exposes execution separately; only"},{"type":"text","text":" "},{"type":"text","text":"that explicit action resolves the URL and submits through normal policies."},{"text":" ","type":"text"},{"text":"The default share action uses only the structural decision and declared route","type":"text"},{"text":" ","type":"text"},{"text":"patterns, never the entered URL. Execution status is structured and localized,","type":"text"},{"text":" ","type":"text"},{"text":"and leaving the workbench cancels only its owned execution task.","type":"text"}]},{"anchor":"Localization","level":2,"text":"Localization","type":"heading"},{"inlineContent":[{"text":"Inspector-owned controls, accessibility labels, recording\/execution statuses,","type":"text"},{"type":"text","text":" "},{"text":"and generic failure messages support English, Korean, Japanese, Simplified and","type":"text"},{"type":"text","text":" "},{"text":"Traditional Chinese, Spanish, French, German, Italian, Brazilian Portuguese,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Russian, Arabic, Hindi, Indonesian, Vietnamese, and Thai."},{"text":" ","type":"text"},{"text":"Views resolve strings from the package resource bundle using the SwiftUI","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"locale"},{"text":" environment, including changes while the same view remains mounted.","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"Unsupported languages fall back to English. Timeline timestamps use that"},{"type":"text","text":" "},{"text":"locale’s time formatting.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To select a language for one Inspector subtree, apply"},{"type":"text","text":" "},{"type":"codeVoice","code":".environment(\\.locale, Locale(identifier: \"ko\"))"},{"type":"text","text":" to its view. Locale and layout"},{"type":"text","text":" "},{"text":"direction are independent SwiftUI environment values: when forcing an Arabic","type":"text"},{"text":" ","type":"text"},{"text":"preview in a left-to-right app, also apply","type":"text"},{"text":" ","type":"text"},{"code":".environment(\\.layoutDirection, .rightToLeft)","type":"codeVoice"},{"text":". Normal host-app language and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"layout configuration remains the application’s responsibility."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Locale-only changes preserve the native containers. A layout-direction change"},{"type":"text","text":" "},{"type":"text","text":"recreates the workbench’s native Form and the timeline’s native split\/list"},{"type":"text","text":" "},{"type":"text","text":"boundary on split-view platforms to clear stale mirrored geometry. Stable"},{"type":"text","text":" "},{"type":"text","text":"outer containers retain tab identity, recorder, scenario, filter, selection,"},{"type":"text","text":" "},{"type":"text","text":"comparison, URL input, and execution ownership. Native focus or scroll position"},{"type":"text","text":" "},{"text":"may reset, but a direction change does not cancel an in-flight execution.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Event names, domain\/outcome identifiers, metadata keys, route patterns,"},{"type":"text","text":" "},{"type":"text","text":"structural dumps, and exported JSON remain stable diagnostic values. Custom"},{"type":"text","text":" "},{"text":"formatter content and successful scenario summaries belong to the app and","type":"text"},{"text":" ","type":"text"},{"text":"are shown verbatim. Native file\/share panels use the host application’s and","type":"text"},{"text":" ","type":"text"},{"text":"system’s localization, not the package’s catalog.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Scenario recording means capturing navigation events, not screen or audio","type":"text"},{"text":" ","type":"text"},{"text":"recording. Stopping retains the captured fixture; cancelling discards it","type":"text"},{"text":" ","type":"text"},{"text":"without undoing navigation. An incomplete capture is distinct from a capture","type":"text"},{"text":" ","type":"text"},{"text":"operation that failed. Raw fixture warnings refer to potentially sensitive","type":"text"},{"text":" ","type":"text"},{"text":"route data and must not be removed when translating.","type":"text"}]}]}],"references":{"doc://com.innosquad.innorouter.docs.inspector/documentation/InnoRouterInspector/RouterInspectorSnapshot":{"abstract":[{"type":"text","text":"A s