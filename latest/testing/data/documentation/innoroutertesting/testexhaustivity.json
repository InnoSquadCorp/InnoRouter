 current pending snapshot, then continues observing. "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Swift Testing currently attributes issues recorded inside an","type":"text"},{"text":" ","type":"text"},{"text":"isolated ","type":"text"},{"type":"codeVoice","code":"deinit"},{"text":" to an ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"unknown test"}]},{"text":" rather than to the test that","type":"text"},{"text":" ","type":"text"},{"text":"owned the store, which makes a deinit-time leftover-event failure","type":"text"},{"text":" ","type":"text"},{"text":"hard to locate. Until that is resolved upstream, await all work and end","type":"text"},{"text":" ","type":"text"},{"text":"each test with an explicit ","type":"text"},{"type":"codeVoice","code":"finish()"},{"text":". It runs the strict check with the","type":"text"},{"text":" ","type":"text"},{"text":"caller’s source location and disarms the deinit-time fallback.","type":"text"}]}],"style":"note","type":"aside","name":"Note"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/TestExhaustivity"},"sections":[],"variants":[{"paths":["\/documentation\/innoroutertesting\/testexhaustivity"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting"]]},"metadata":{"navigatorTitle":[{"text":"TestExhaustivity","kind":"identifier"}],"symbolKind":"enum","externalID":"s:17InnoRouterTesting16TestExhaustivityO","title":"TestExhaustivity","role":"symbol","remoteSource":{"fileName