},{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"type":"codeVoice","code":"TestStore"},{"type":"text","text":" exhaustivity model:"},{"type":"text","text":" "},{"type":"text","text":"events collected from the underlying authority’s unified "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"type":"codeVoice","code":".strict"},{"type":"text","text":" mode, the store reports events left pending at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Swift Testing currently attributes issues recorded inside an","type":"text"},{"text":" ","type":"text"},{"text":"isolated ","type":"text"},{"type":"codeVoice","code":"deinit"},{"text":" to an ","type":"text"},{"inlineContent":[{"type":"text","text":"unknown test"}],"type":"emphasis"},{"text":" rather than to the test that","type":"text"},{"text":" ","type":"text"},{"text":"owned the store, which makes a deinit-time leftover-event failure","type":"text"},{"text":" ","type":"text"},{"text":"hard to locate. Until that is resolved upstream, await all work and end","type":"text"},{"text":" ","type":"text"},{"text":"each test with an explicit ","type":"text"},{"type":"codeVoice","code":"finish()"},{"text":". It runs the strict check with the","type":"text"},{"text":" ","type":"text"},{"text":"caller’s source location and disarms the deinit-time fallback.","type":"text"}]}],"type":"aside","style":"note","name":"Note"}]}],"references":{"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterScenarioRunner":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouterScenarioRunner","kind":"identifier"}],"title":"RouterScenarioRunner","type":"topic","role":"symbol","navigatorTitle":[{"text":"RouterScenarioRunner","kind":"identifier"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRunner","abstract":[{"type":"text","text":"Replays explicit scheduling controls through production routing while"},{"type":"text","text":" "},{"type":"text","text":"comparing developer-authored expectations relative to the store’s revision"},{"type":"text","text":" "},{"type":"text","text":"at replay start."}],"url":"\/documentation\/innoroutertesting\/routerscenariorunner","kind":"symbol"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/TestExhaustivity":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TestExhaustivity","kind":"identifier"}],"title":"TestExhaustivity","type":"topic","role":"symbol","navigatorTitle":[{"text":"TestExhaustivity","kind":"identifier"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/TestExhaustivity","abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"type":"text","text":" "},{"type":"te