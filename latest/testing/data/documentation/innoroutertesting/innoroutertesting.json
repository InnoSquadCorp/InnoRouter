{"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"code":"RouterTestStore<Route>","type":"codeVoice"},{"text":" wraps the production ","type":"text"},{"code":"RouterStore","type":"codeVoice"},{"text":", reducer, and","type":"text"},{"text":" ","type":"text"},{"text":"policies. It buffers events synchronously, allowing a test to assert the exact","type":"text"},{"text":" ","type":"text"},{"code":"started → policyPrepared → committed\/rejected","type":"codeVoice"},{"text":" lifecycle without sleeps.","type":"text"}],"type":"paragraph"},{"code":["import InnoRouter","import InnoRouterTesting","import Testing","","@Test @MainActor","func opensDetail() async {","    let store = RouterTestStore<AppRoute>()","","    await store.send(.push(.detail(id: \"42\")))","    store.receiveStarted()","    store.receiveCommitted { state, revision in","        state == .rootStack(path: [.detail(id: \"42\")]) && revision == 1","    }","    store.finish()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"TestExhaustivity.strict"},{"type":"text","text":" mode records a Swift Testing issue when"},{"type":"text","text":" "},{"type":"text","text":"events remain at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deinitialization. Use "},{"type":"codeVoice","code":".off"},{"type":"text","text":" only while"},{"type":"text","text":" "},{"type":"text","text":"incrementally migrating a large suite. Production "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" callbacks are"},{"type":"text","text":" "},{"text":"preserved and run before an event enters the assertion queue.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use predicates when a transition identifier is generated at runtime, or compare"},{"type":"text","text":" "},{"type":"text","text":"an exact "},{"code":"RouterEvent","type":"codeVoice"},{"type":"text","text":" when the fixture owns every value."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"send(_:context:)"},{"type":"text","text":" accepts production transition provenance and animation;"},{"type":"text","text":" "},{"type":"text","text":"passing a "},{"type":"codeVoice","code":"RouterPlan"},{"type":"text","text":" applies one exact target. Codable routes can use"},{"type":"text","text":" "},{"type":"codeVoice","code":"snapshot(using:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"restore(from:using:recovery:)"},{"type":"text","text":" to verify the same codec,"},{"type":"text","text":" "},{"type":"text","text":"migration, policy, and provenance path used by an application. "},{"type":"codeVoice","code":"assertState"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"receiveUnchanged"},{"type":"text","text":" complete the value-level assertion surface."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For timeout, expiry, cancellation, and overlapping-request tests, install a"},{"type":"text","text":" "},{"code":"RouterTestRuntime","type":"codeVoice"},{"type":"text","text":" and start requests without awaiting them:"}]},{"code":["let runtime = RouterTestRuntime(transitionIDSeed: 1)","let store = RouterTestStore<AppRoute>(","    configuration: .init(policyTimeout: .seconds(30)),","    runtime: runtime",")","let request = store.start(.push(.checkout))","","await request.waitUntilStarted()","await runtime.clock.waitUntilScheduled()","runtime.clock.advance(by: .seconds(30))","let outcome = await request.result"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The start and timer-registration barriers are production lifecycle signals,"},{"type":"text","text":" "},{"type":"text","text":"not scheduler guesses. "},{"type":"codeVoice","code":"RouterTestRequest.cancel()"},{"type":"text","text":" targets one request, while"},{"type":"text","text":" "},{"code":"waitForEvent(where:)","type":"codeVoice"},{"type":"text","text":" waits for an exact later lifecycle condition. Strict"},{"type":"text","text":" "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":" reports outstanding requests, policy deferrals, and virtual timers,"},{"type":"text","text":" "},{"type":"text","text":"then cancels only work created by this test harness. Existing test-store"},{"type":"text","text":" "},{"type":"text","text":"initializers retain live time unless a runtime is explicitly supplied."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterActionSequence<Route>"},{"type":"text","text":" stores Codable production actions and each step’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTransitionContext"},{"type":"text","text":" as a versioned, deterministically encoded fixture."},{"type":"text","text":" "},{"type":"text","text":"Construct "},{"type":"codeVoice","code":"RouterActionStep"},{"type":"text","text":" values when provenance, animation, request keys,"},{"type":"text","text":" "},{"type":"text","text":"coalescing, or resumed-deferral metadata differ between steps. The convenience"},{"type":"text","text":" "},{"type":"codeVoice","code":"init(actions:context:)"},{"type":"text","text":" applies one context to every action. "},{"type":"codeVoice","code":"replay(on:)"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"each step through "},{"type":"codeVoice","code":"RouterTestStore"},{"type":"text","text":", including production policy rejection."}]},{"type":"paragraph","inlineContent":[{"text":"Supply the original initial state, policies, and runtime dependencies when","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"constructing the test store. Replay is sequential and does not reproduce"},{"type":"text","text":" "},{"type":"text","text":"concurrent request timing. Fixtures contain route payloads and request keys;"},{"type":"text","text":" "},{"type":"text","text":"review them before sharing. Use Inspector bundles for redacted support exports."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterScenarioRecorder"},{"type":"text","text":" is the explicit bridge from a reproduced bug to a"},{"type":"text","text":" "},{"type":"text","text":"regression fixture. It observes request, start, cancellation, and terminal"},{"type":"text","text":" "},{"type":"text","text":"boundaries synchronously, bounds retained route payloads, and reports"},{"type":"text","text":" "},{"type":"text","text":"unfinished, dropped, or control-incomplete requests. Format v5 records"},{"type":"text","text":" "},{"type":"text","text":"route-schema, environment, dependency\/effect capabilities, the initial"},{"type":"text","text":" "},{"type":"text","text":"revision, every request’s relative "},{"type":"codeVoice","code":"expectedRevision"},{"type":"text","text":", its"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioCancellationOrigin"},{"type":"text","text":", serializable"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRequestSemantics"},{"type":"text","text":", and logical submit, wait, cancel,"},{"type":"text","text":" "},{"type":"text","text":"virtual-time, deferral-resolution, and terminal controls. This preserves"},{"type":"text","text":" "},{"type":"text","text":"history navigation-only rebasing and stale-state checks through queued and"},{"type":"text","text":" "},{"type":"text","text":"repeatedly deferred requests. Format v8 records the complete feature mapping"},{"type":"text","text":" "},{"type":"text","text":"path for ordinary feature actions, presentation mutations, completions, and"},{"type":"text","text":" "},{"type":"text","text":"feature plans. Scene-local requests bind ownership to the logical Scene"},{"type":"text","text":" "},{"type":"text","text":"lifetime created by the replay sequence rather than serializing process-local"},{"type":"text","text":" "},{"type":"text","text":"UUID tokens. Replay requires a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureResolver","isActive":true},{"type":"text","text":" built from the same macro-generated mapping;"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureProjection","isActive":true},{"type":"text","text":" to compose nested mappings. Missing,"},{"type":"text","text":" "},{"type":"text","text":"duplicate, or tampered resolver paths fail before the first production request."},{"type":"text","text":" "},{"type":"text","text":"Format v7 and earlier, plus unknown future versions, are rejected"},{"type":"text","text":" "},{"type":"text","text":"instead of guessing execution conditions. Use the recorder’s "},{"type":"codeVoice","code":"resolveDeferred"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"advanceTime"},{"type":"text","text":" operations when"},{"type":"text","text":" "},{"type":"text","text":"capturing those decisions so replay never invents unavailable scheduling data."},{"type":"text","text":" "},{"type":"text","text":"Preflight validates the exact action provenance stored by each deferral while"},{"type":"text","text":" "},{"type":"text","text":"allowing a history target to differ from the merged state that preserves"},{"type":"text","text":" "},{"type":"text","text":"already-open scenes, badges, and non-conflicting presentations. A resumed"},{"type":"text","text":" "},{"type":"text","text":"history request with an explicit request-cancellation control is portable. A"},{"type":"text","text":" "},{"type":"text","text":"request cancelled by an unrecorded history stop or reset is rejected as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioReplayError\/unsupportedHistoryLifetime(step:)","isActive":true},{"type":"text","text":" (and by the"},{"type":"text","text":" "},{"type":"text","text":"matching source-generation error) before replay mutates a store; reproduce and"},{"type":"text","text":" "},{"type":"text","text":"record that lifecycle explicitly before generating a portable fixture."},{"type":"text","text":" "},{"type":"text","text":"A raw recording is intentionally incomplete:"},{"type":"text","text":" "},{"code":"RouterScenarioFixture.settingExpectations(_:)","type":"codeVoice"},{"type":"text","text":" must provide a developer-owned"},{"type":"text","text":" "},{"code":"RouterScenarioExpectation","type":"codeVoice"},{"type":"text","text":" for every observation before"},{"type":"text","text":" "},{"code":"RouterScenarioSourceGenerator","type":"codeVoice"},{"type":"text","text":" emits Swift Testing source. Generated tests use"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRunner","type":"reference"},{"type":"text","text":" to preserve overlaps, cancellation, timeout, and"},{"type":"text","text":" "},{"type":"text","text":"approval controls, map fresh deferral identities, and compare each request’s"},{"type":"text","text":" "},{"type":"text","text":"own terminal snapshot and revision delta on the production test store. Replay"},{"type":"text","text":" "},{"type":"text","text":"preflights a caller-declared "},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioReplayEnvironment","type":"reference"},{"type":"text","text":" before the"},{"type":"text","text":" "},{"type":"text","text":"first request and requires the test store’s complete state to equal the"},{"type":"text","text":" "},{"type":"text","text":"fixture’s initial state. If replay fails or its task is cancelled, it cancels"},{"type":"text","text":" "},{"type":"text","text":"and drains its own request and deferral handles before returning while leaving"},{"type":"text","text":" "},{"type":"text","text":"unrelated store work untouched."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioSourceGenerator\/generateFiles(_:routeTypeName:fixtureFileName:testName:storeFactory:environmentFactory:featureResolversFactory:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"returns separate Swift Testing and JSON fixture artifacts. Use"},{"type":"text","text":" "},{"code":"RouterScenarioFixture.decode(from:maximumByteCount:maximumStepCount:)","type":"codeVoice"},{"type":"text","text":" at an"},{"text":" ","type":"text"},{"text":"import boundary.","type":"text"}]}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/InnoRouterTesting"},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"A host-less assertion harness for the canonical InnoRouter 6 transition","type":"text"},{"text":" ","type":"text"},{"text":"pipeline.","type":"text"}],"topicSections":[{"title":"Harness","abstract":[{"text":"Format v9 adds inert alert and confirmation-dialog descriptors. Export with","type":"text"},{"text":" ","type":"text"},{"code":"try fixture.encode(resourceBudget: .provisional)","type":"codeVoice"},{"text":" and import with","type":"text"},{"text":" ","type":"text"},{"code":"RouterScenarioFixture.decode(from:)","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"decode(from:resourceBudget:)","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The dedicated encoder admits complete original states and actions before","type":"text"},{"text":" ","type":"text"},{"text":"application route encoding, then checks scenario byte\/depth\/token\/step and","type":"text"},{"text":" ","type":"text"},{"text":"logical-work limits. Import screens syntax, descriptor kinds, action IDs and","type":"text"},{"text":" ","type":"text"},{"text":"state identities before application route decoding. Bare ","type":"text"},{"code":"JSONEncoder","type":"codeVoice"},{"text":" remains","type":"text"},{"text":" ","type":"text"},{"text":"navigation-only; scenario descriptor bytes are never valid restoration input.","type":"text"},{"text":" ","type":"text"},{"text":"Navigation-only v8 fixtures remain readable and are upgraded to v9 on export.","type":"text"},{"text":" ","type":"text"},{"text":"A v8 document carrying new transient descriptors is rejected. Other fixture","type":"text"},{"text":" ","type":"text"},{"text":"versions require recapture rather than an inferred migration.","type":"text"}],"identifiers":["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestStore","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/TestExhaustivity","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterActionSequence","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterActionStep","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestRuntime","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestClock","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestRequest","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTes