oc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureProjection","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureResolver","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioGeneratedFiles","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioSourceGenerator","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRunner"],"anchor":"Harness"}],"abstract":[{"type":"text","text":"A host-less assertion harness for the canonical InnoRouter 6 transition"},{"type":"text","text":" "},{"type":"text","text":"pipeline."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innoroutertesting\/innoroutertesting"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","primaryContentSections":[{"content":[{"type":"heading","anchor":"Overview","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"RouterTestStore<Route>","type":"codeVoice"},{"text":" wraps the production ","type":"text"},{"code":"RouterStore","type":"codeVoice"},{"text":", reducer, and","type":"text"},{"type":"text","text":" "},{"type":"text","text":"policies. It buffers events synchronously, allowing a test to assert the exact"},{"type":"text","text":" "},{"type":"codeVoice","code":"started → policyPrepared → committed\/rejected"},{"type":"text","text":" lifecycle without sleeps."}]},{"syntax":"swift skip doc-fragment","code":["import InnoRouter","import InnoRouterTesting","import Testing","","@Test @MainActor","func opensDetail() async {","    let store = RouterTestStore<AppRoute>()","","    await store.send(.push(.detail(id: \"42\")))","    store.receiveStarted()","    store.receiveCommitted { state, revision in","        state == .rootStack(path: [.detail(id: \"42\")]) && revision == 1","    }","    store.finish()","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The default ","type":"text"},{"code":"TestExhaustivity.strict","type":"codeVoice"},{"text":" mode records a Swift Testing issue when","type":"text"},{"text":" ","type":"text"},{"text":"events remain at ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" or deinitialization. Use ","type":"text"},{"code":".off","type":"codeVoice"},{"text":" only while","type":"text"},{"text":" ","type":"text"},{"text":"incrementally migrating a large suite. Production ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" callbacks are","type":"text"},{"text":" ","type":"text"},{"text":"preserved and run before an event enters the assertion queue.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use predicates when a transition identifier is generated at runtime, or compare"},{"type":"text","text":" "},{"type":"text","text":"an exact "},{"type":"codeVoice","code":"RouterEvent"},{"type":"text","text":" when the fixture owns every value."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"send(_:context:)"},{"type":"text","text":" accepts production transition provenance and animation;"},{"type":"text","text":" "},{"type":"text","text":"passing a "},{"type":"codeVoice","code":"RouterPlan"},{"type":"text","text":" applies one exact target. Codable routes can use"},{"type":"text","text":" "},{"type":"codeVoice","code":"snapshot(using:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"restore(from:using:recovery:)"},{"type":"text","text":" to verify the same codec,"},{"type":"text","text":" "},{"type":"text","text":"migration, policy, and provenance path used by an application. "},{"type":"codeVoice","code":"assertState"},{"type":"text","text":" "},{"text":"and ","type":"text"},{"type":"codeVoice","code":"receiveUnchanged"},{"text":" complete the value-level assertion surface.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For timeout, expiry, cancellation, and overlapping-request tests, install a"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTestRuntime"},{"type":"text","text":" and start requests without awaiting them:"}]},{"syntax":"swift skip doc-fragment","code":["let runtime = RouterTestRuntime(transitionIDSeed: 1)","let store = RouterTestStore<AppRoute>(","    configuration: .init(policyTimeout: .seconds(30)),","    runtime: runtime",")","let request = store.start(.push(.checkout))","","await request.waitUntilStarted()","await runtime.clock.waitUntilScheduled()","runtime.clock.advance(by: .seconds(30))","let outcome = await request.result"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The start and timer-registration barriers are production lifecycle signals,","type":"text"},{"type":"text","text":" "},{"type":"text","text":"not scheduler guesses. "},{"type":"codeVoice","code":"RouterTestRequest.cancel()"},{"type":"text","text":" targets one request, while"},{"type":"text","text":" "},{"type":"codeVoice","code":"waitForEvent(where:)"},{"type":"text","text":" waits for an exact later lifecycle condition. Strict"},{"text":" ","type":"text"},{"type":"codeVoice","code":"finish()"},{"text":" reports outstanding requests, policy deferrals, and virtual timers,","type":"text"},{"type":"text","text":" "},{"text":"then cancels only work created by this test harness. Existing test-store","type":"text"},{"type":"text","text":" "},{"text":"initializers retain live time unless a runtime is explicitly supplied.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterActionSequence<Route>"},{"type":"text","text":" stores Codable production actions and each step’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTransitionContext"},{"type":"text","text":" as a versioned, deterministically encoded fixture."},{"type":"text","text":" "},{"type":"text","text":"Construct "},{"type":"codeVoice","code":"RouterActionStep"},{"text":" values when provenance, animation, request keys,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"coalescing, or resumed-deferral metadata differ between steps. The convenience"},{"type":"text","text":" "},{"type":"codeVoice","code":"init(actions:context:)"},{"type":"text","text":" applies one context to every action. "},{"type":"codeVoice","code":"replay(on:)"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"each step through "},{"type":"codeVoice","code":"RouterTestStore"},{"type":"text","text":", including production policy rejection."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Supply the original initial state, policies, and runtime dependencies when"},{"type":"text","text":" "},{"type":"text","text":"constructing the test store. Replay is sequential and does not reproduce"},{"type":"text","text":" "},{"type":"text","text":"concurrent request timing. Fixtures contain route payloads and request keys;"},{"type":"text","text":" "},{"type":"text","text":"review them before sharing. Use Inspector bundles for redacted support exports."}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterScenarioRecorder"},{"type":"text","text":" is the explicit bridge from a reproduced bug to a"},{"type":"text","text":" "},{"type":"text","text":"regression fixture. It observes request, start, cancellation, and terminal"},{"type":"text","text":" "},{"type":"text","text":"boundaries synchronously, bounds retained route payloads, and reports"},{"type":"text","text":" "},{"type":"text","text":"unfinished, dropped, or control-incomplete requests. Format v5 records"},{"type":"text","text":" "},{"type":"text","text":"route-schema, environment, dependency\/effect capabilities, the initial"},{"type":"text","text":" "},{"type":"text","text":"revision, every request’s relative "},{"type":"codeVoice","code":"expectedRevision"},{"type":"text","text":", its"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioCancellationOrigin","type":"reference","isActive":true},{"type":"text","text":", serializable"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRequestSemantics","type":"reference","isActive":true},{"type":"text","text":", and logical submit, wait, cancel,"},{"type":"text","text":" "},{"type":"text","text":"virtual-time, deferral-resolution, and terminal controls. This preserves"},{"type":"text","text":" "},{"type":"text","text":"history navigation-only rebasing and stale-state checks through queued and"},{"type":"text","text":" "},{"type":"text","text":"repeatedly deferred requests. Format v7 records the complete feature mapping"},{"type":"text","text":" "},{"type":"text","text":"path for ordinary feature actions, presentation mutations, completions, and"},{"type":"text","text":" "},{"type":"text","text":"feature plans. Scene-local requests bind ownership to the logical Scene"},{"type":"text","text":" "},{"type":"text","text":"lifetime created by the replay sequence rather than serializing process-local"},{"type":"text","text":" "},{"type":"text","text":"UUID tokens. Replay requires a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureResolver","isActive":true},{"type":"text","text":" built from the same macro-generated mapping;"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureProjection","isActive":true},{"type":"text","text":" to compose nested mappings. Missing,"},{"type":"text","text":" "},{"type":"text","text":"duplicate, or tampered resolver paths fail before the first production request."},{"type":"text","text":" "},{"type":"text","text":"Format v6 and earlier, plus unknown future versions, are rejected"},{"type":"text","text":" "},{"type":"text","text":"instead of guessing execution conditions. Use the recorder’s "},{"type":"codeVoice","code":"resolveDeferred"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"advanceTime"},{"type":"text","text":" operations when"},{"type":"text","text":" "},{"type":"text","text":"capturing those decisions so replay never invents unavailable scheduling data."},{"type":"text","text":" "},{"type":"text","text":"Preflight validates the exact action provenance stored by each deferral while"},{"type":"text","text":" "},{"type":"text","text":"allowing a history target to differ from the merged state that preserves"},{"type":"text","text":" "},{"type":"text","text":"already-open scenes, badges, and non-conflicting presentations. A resumed"},{"type":"text","text":" "},{"type":"text","text":"history request with an explicit request-cancellation control is portable. A"},{"type":"text","text":" "},{"type":"text","text":"request cancelled by an unrecorded history stop or reset is rejected as"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioReplayError\/unsupportedHistoryLifetime(step:)","isActive":true},{"type":"text","text":" (and by the"},{"type":"text","text":" "},{"type":"text","text":"matching source-generation error) before replay mutates a store; reproduce and"},{"type":"text","text":" "},{"type":"text","text":"record that lifecycle explicitly before generating a portable fixture."},{"type":"text","text":" "},{"type":"text","text":"A raw recording is intentionally incomplete:"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterScenarioFixture.settingExpectations(_:)"},{"type":"text","text":" must provide a developer-owned"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterScenarioExpectation"},{"type":"text","text":" for every observation before"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterScenarioSourceGenerator"},{"type":"text","text":" emits Swift Testing source. Generated tests use"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRunner","isActive":true},{"type":"text","text":" to preserve overlaps, cancellation, timeout, and"},{"type":"text","text":" "},{"type":"text","text":"approval controls, map fresh deferral identities, and compare each request’s"},{"type":"text","text":" "},{"type":"text","text":"own terminal snapshot and revision delta on the production test store. Replay"},{"type":"text","text":" "},{"type":"text","text":"preflights a caller-declared "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioReplayEnvironment","isActive":true},{"type":"text","text":" before the"},{"type":"text","text":" "},{"type":"text","text":"first request and requires the test store’s complete state to equal the"},{"type":"text","text":" "},{"type":"text","text":"fixture’s initial state. If replay fails or its task is cancelled, it cancels"},{"type":"text","text":" "},{"type":"text","text":"and drains its own request and deferral handles before returning while leaving"},{"type":"text","text":" "},{"type":"text","text":"unrelated store work untouched."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioSourceGenerator\/generateFiles(_:routeTypeName:fixtureFileName:testName:storeFactory:environmentFactory:featureResolversFactory:)","isActive":true},{"type":"text","text":" "},{"type":"text","text":"returns separate Swift Testing and JSON fixture artifacts. Use"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterScenarioFixture.decode(from:maximumByteCount:maximumStepCount:)"},{"type":"text","text":" at an"},{"type":"text","text":" "},{"type":"text","text":"import boundary."}]}],"kind":"content"}],"sections":[],"metadata":{"modules":[{"name":"InnoRouterTesting"}],"title":"InnoRouterTesting","roleHeading":"API Collection","role":"collectionGroup"},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting"]]},"references":{"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterScenarioRunner":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouterScenarioRunner","kind":"identifier"}],"title":"RouterScenarioRunner","type":"topic","role":"symbol","navigatorTitle":[{"text":"RouterScenarioRunner","kind":"identifier"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRunner","abstract":[{"type":"text","text":"Replays explicit scheduling controls through production routing while"},{"type":"text","text":" "},{"type":"text","text":"comparing developer-authored expectations relative to the store’s revision"},{"type":"text","text":" "},{"type":"text","text":"at replay start."}],"url":"\/documentation\/innoroutertesting\/routerscenariorunner","kind":"symbol"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/TestExhaustivity":{"fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"TestExhaustivity","kind":"identifier"}],"title":"TestExhaustivity","type":"topic","role":"symbol","navigatorTitle":[{"text":"TestExhaustivity","kind":"identifier"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/TestExhaustivity","abstract":[{"type":"text","text":"Controls how strictly a test store checks pending events when observation"},{"type":"text","text":" "},{"type":"text","text":"finishes."}],"url":"\/documentation\/innoroutertesting\/testexhaustivi