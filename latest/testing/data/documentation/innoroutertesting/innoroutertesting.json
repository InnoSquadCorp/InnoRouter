{"kind":"article","topicSections":[{"abstract":[{"type":"text","text":"Format v9 adds inert alert and confirmation-dialog descriptors. Export with"},{"type":"text","text":" "},{"code":"try fixture.encode(resourceBudget: .provisional)","type":"codeVoice"},{"type":"text","text":" and import with"},{"type":"text","text":" "},{"code":"RouterScenarioFixture.decode(from:)","type":"codeVoice"},{"type":"text","text":" or "},{"code":"decode(from:resourceBudget:)","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The dedicated encoder admits complete original states and actions before"},{"type":"text","text":" "},{"type":"text","text":"application route encoding, then checks scenario byte\/depth\/token\/step and"},{"type":"text","text":" "},{"type":"text","text":"logical-work limits. Import screens syntax, descriptor kinds, action IDs and"},{"type":"text","text":" "},{"type":"text","text":"state identities before application route decoding. Bare "},{"code":"JSONEncoder","type":"codeVoice"},{"type":"text","text":" remains"},{"type":"text","text":" "},{"type":"text","text":"navigation-only; scenario descriptor bytes are never valid restoration input."},{"type":"text","text":" "},{"type":"text","text":"Navigation-only v8 fixtures remain readable and are upgraded to v9 on export."},{"type":"text","text":" "},{"type":"text","text":"A v8 document carrying new transient descriptors is rejected. Other fixture"},{"type":"text","text":" "},{"type":"text","text":"versions require recapture rather than an inferred migration."}],"anchor":"Harness","identifiers":["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestStore","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/TestExhaustivity","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterActionSequence","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterActionStep","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestRuntime","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestClock","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestRequest","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestPendingWork","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRecorder","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFixture","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioControl","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRequestSemantics","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioSceneLifetime","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioCancellationOrigin","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioExpectation","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioMetadata","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioReplayEnvironment","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureProjection","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureResolver","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioGeneratedFiles","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioSourceGenerator","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRunner"],"title":"Harness"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"codeVoice","code":"RouterTestStore<Route>"},{"type":"text","text":" wraps the production "},{"type":"codeVoice","code":"RouterStore"},{"type":"text","text":", reducer, and"},{"type":"text","text":" "},{"type":"text","text":"policies. It buffers events synchronously, allowing a test to assert the exact"},{"type":"text","text":" "},{"type":"codeVoice","code":"started → policyPrepared → committed\/rejected"},{"type":"text","text":" lifecycle without sleeps."}],"type":"paragraph"},{"code":["import InnoRouter","import InnoRouterTesting","import Testing","","@Test @MainActor","func opensDetail() async {","    let store = RouterTestStore<AppRoute>()","","    await store.send(.push(.detail(id: \"42\")))","    store.receiveStarted()","    store.receiveCommitted { state, revision in","        state == .rootStack(path: [.detail(id: \"42\")]) && revision == 1","    }","    store.finish()","}"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"TestExhaustivity.strict"},{"type":"text","text":" mode records a Swift Testing issue when"},{"type":"text","text":" "},{"type":"text","text":"events remain at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deinitialization. Use "},{"type":"codeVoice","code":".off"},{"type":"text","text":" only while"},{"type":"text","text":" "},{"type":"text","text":"incrementally migrating a large suite. Production "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" callbacks are"},{"type":"text","text":" "},{"type":"text","text":"preserved and run before an event enters the assertion queue."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use predicates when a transition identifier is generated at runtime, or compare"},{"type":"text","text":" "},{"type":"text","text":"an exact "},{"type":"codeVoice","code":"RouterEvent"},{"type":"text","text":" when the fixture owns every value."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"send(_:context:)"},{"type":"text","text":" accepts production transition provenance and animation;"},{"type":"text","text":" "},{"type":"text","text":"passing a "},{"type":"codeVoice","code":"RouterPlan"},{"type":"text","text":" applies one exact target. Codable routes can use"},{"type":"text","text":" "},{"type":"codeVoice","code":"snapshot(using:)"},{"type":"text","text":" and "},{"type":"codeVoice","code":"restore(from:using:recovery:)"},{"type":"text","text":" to verify the same codec,"},{"type":"text","text":" "},{"type":"text","text":"migration, policy, and provenance path used by an application. "},{"type":"codeVoice","code":"assertState"},{"type":"text","text":" "},{"type":"text","text":"and "},{"type":"codeVoice","code":"receiveUnchanged"},{"type":"text","text":" complete the value-level assertion surface."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"For timeout, expiry, cancellation, and overlapping-request tests, install a"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTestRuntime"},{"type":"text","text":" and start requests without awaiting them:"}],"type":"paragraph"},{"code":["let runtime = RouterTestRuntime(transitionIDSeed: 1)","let store = RouterTestStore<AppRoute>(","    configuration: .init(policyTimeout: .seconds(30)),","    runtime: runtime",")","let request = store.start(.push(.checkout))","","await request.waitUntilStarted()","await runtime.clock.waitUntilScheduled()","runtime.clock.advance(by: .seconds(30))","let outcome = await request.result"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"The start and timer-registration barriers are production lifecycle signals,"},{"type":"text","text":" "},{"type":"text","text":"not scheduler guesses. "},{"type":"codeVoice","code":"RouterTestRequest.cancel()"},{"type":"text","text":" targets one request, while"},{"type":"text","text":" "},{"type":"codeVoice","code":"waitForEvent(where:)"},{"type":"text","text":" waits for an exact later lifecycle condition. Strict"},{"type":"text","text":" "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" reports outstanding requests, policy deferrals, and virtual timers,"},{"type":"text","text":" "},{"type":"text","text":"then cancels only work created by this test harness. Existing test-store"},{"type":"text","text":" "},{"type":"text","text":"initializers retain live time unless a runtime is explicitly supplied."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"RouterActionSequence<Route>"},{"type":"text","text":" stores Codable production actions and each step’s"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterTransitionContext"},{"type":"text","text":" as a versioned, deterministically encoded fixture."},{"type":"text","text":" "},{"type":"text","text":"Construct "},{"type":"codeVoice","code":"RouterActionStep"},{"type":"text","text":" values when provenance, animation, request keys,"},{"type":"text","text":" "},{"type":"text","text":"coalescing, or resumed-deferral metadata differ between steps. The convenience"},{"type":"text","text":" "},{"type":"codeVoice","code":"init(actions:context:)"},{"type":"text","text":" applies one context to every action. "},{"type":"codeVoice","code":"replay(on:)"},{"type":"text","text":" sends"},{"type":"text","text":" "},{"type":"text","text":"each step through "},{"type":"codeVoice","code":"RouterTestStore"},{"type":"text","text":", including production policy rejection."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Supply the original initial state, policies, and runtime dependencies when"},{"type":"text","text":" "},{"type":"text","text":"constructing the test store. Replay is sequential and does not reproduce"},{"type":"text","text":" "},{"type":"text","text":"concurrent request timing. Fixtures contain route payloads and request keys;"},{"type":"text","text":" "},{"type":"text","text":"review them before sharing. Use Inspector bundles for redacted support exports."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"RouterScenarioRecorder"},{"type":"text","text":" is the explicit bridge from a reproduced bug to a"},{"type":"text","text":" "},{"type":"text","text":"regression fixture. It observes request, start, cancellation, and terminal"},{"type":"text","text":" "},{"type":"text","text":"boundaries synchronously, bounds retained route payloads, and reports"},{"type":"text","text":" "},{"type":"text","text":"unfinished, dropped, or control-incomplete requests. Format v5 records"},{"type":"text","text":" "},{"type":"text","text":"route-schema, environment, dependency\/effect capabilities, the initial"},{"type":"text","text":" "},{"type":"text","text":"revision, every request’s relative "},{"type":"codeVoice","code":"expectedRevision"},{"text":", its","type":"text"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioCancellationOrigin","type":"reference"},{"type":"text","text":", serializable"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRequestSemantics","type":"reference"},{"type":"text","text":", and logical submit, wait, cancel,"},{"type":"text","text":" "},{"type":"text","text":"virtual-time, deferral-resolution, and terminal controls. This preserves"},{"type":"text","text":" "},{"type":"text","text":"history navigation-only rebasing and stale-state checks through queued and"},{"type":"text","text":" "},{"type":"text","text":"repeatedly deferred requests. Format v8 records the complete feature mapping"},{"type":"text","text":" "},{"type":"text","text":"path for ordinary feature actions, presentation mutations, completions, and"},{"type":"text","text":" "},{"type":"text","text":"feature plans. Scene-local requests bind ownership to the logical Scene"},{"type":"text","text":" "},{"type":"text","text":"lifetime created by the replay sequence rather than serializing process-local"},{"type":"text","text":" "},{"type":"text","text":"UUID tokens. Replay requires a"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureResolver","isActive":true},{"type":"text","text":" built from the same macro-generated mapping;"},{"type":"text","text":" "},{"type":"text","text":"use "},{"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureProjection","isActive":true},{"type":"text","text":" to compose nested mappings. Missing,"},{"type":"text","text":" "},{"type":"text","text":"duplicate, or tampered resolver paths fail before the first production request."},{"type":"text","text":" "},{"type":"text","text":"Format v7 and earlier, plus unknown future versions, are rejected"},{"type":"text","text":" "},{"type":"text","text":"instead of guessing execution conditions. Use the recorder’s "},{"type":"codeVoice","code":"resolveDeferred"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"advanceTime"},{"type":"text","text":" operations when"},{"type":"text","text":" "},{"type":"text","text":"capturing those decisions so replay never invents unavailable scheduling data."},{"type":"text","text":" "},{"type":"text","text":"Preflight validates the exact action provenance stored by each deferral while"},{"type":"text","text":" "},{"type":"text","text":"allowing a history target to differ from the merged state that preserves"},{"type":"text","text":" "},{"type":"text","text":"already-open scenes, badges, and non-conflicting presentations. A resumed"},{"type":"text","text":" "},{"type":"text","text":"history request with an explicit request-cancellation control is portable. A"},{"type":"text","text":" "},{"type":"text","text":"request cancelled by an unrecorded history stop or reset is rejected as"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioReplayError\/unsupportedHistoryLifetime(step:)","isActive":true,"type":"reference"},{"type":"text","text":" (and by the"},{"type":"text","text":" "},{"type":"text","text":"matching source-generation error) before replay mutates a store; reproduce and"},{"type":"text","text":" "},{"type":"text","text":"record that lifecycle explicitly before generating a portable fixture."},{"type":"text","text":" "},{"type":"text","text":"A raw recording is intentionally incomplete:"},{"type":"text","text":" "},{"code":"RouterScenarioFixture.settingExpectations(_:)","type":"codeVoice"},{"type":"text","text":" must provide a developer-owned"},{"type":"text","text":" "},{"code":"RouterScenarioExpectation","type":"codeVoice"},{"type":"text","text":" for every observation before"},{"type":"text","text":" "},{"code":"RouterScenarioSourceGenerator","type":"codeVoice"},{"type":"text","text":" emits Swift Testing source. Generated tests use"},{"type":"text","text":" "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRunner","isActive":true,"type":"reference"},{"type":"text","text":" to preserve overlaps, cancellation, timeout, and"},{"type":"text","text":" "},{"type":"text","text":"approval controls, map fresh deferral identities, and compare each request’s"},{"type":"text","text":" "},{"type":"text","text":"own terminal snapshot and revision delta on the production test store. Replay"},{"type":"text","text":" "},{"type":"text","text":"preflights a caller-declared "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioReplayEnvironment","isActive":true,"type":"reference"},{"type":"text","text":" before the"},{"type":"text","text":" "},{"type":"text","text":"first request and requires the test store’s complete state to equal the"},{"type":"text","text":" "},{"type":"text","text":"fixture’s initial state. If replay fails or its task is cancelled, it cancels"},{"type":"text","text":" "},{"type":"text","text":"and drains its own request and deferral handles before returning while leaving"},{"type":"text","text":" "},{"type":"text","text":"unrelated store work untouched."},{"type":"text","text":" "},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioSourceGenerator\/generateFiles(_:routeTypeName:fixtureFileName:testName:storeFactory:environmentFactory:featureResolversFactory:)","isActive":true,"type":"reference"},{"type":"text","text":" "},{"type":"text","text":"returns separate Swift Testing and JSON fixture artifacts. Use"},{"type":"text","text":" "},{"code":"RouterScenarioFixture.decode(from:maximumByteCount:maximumStepCount:)","type":"codeVoice"},{"type":"text","text":" at an"},{"type":"text","text":" "},{"type":"text","text":"import boundary."}],"type":"paragraph"}]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/InnoRouterTesting","interfaceLanguage":"swift"},"sections":[],"variants":[{"paths":["\/documentation\/innoroutertesting\/innoroutertesting"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting"]]},"metadata":{"roleHeading":"API Collection","modules":[{"name":"InnoRouterTesting"}],"role":"collectionGroup","title":"InnoRouterTesting"},"abstract":[{"type":"text","text":"A host-less assertion harness for the canonical InnoRouter 6 transition"},{"type":"text","text":" "},{"type":"text","text":"pipeline."}],"references":{"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterScenarioFeatureResolver":{"role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"RouterScenarioFeatureResolver","kind":"identifier"}],"navigatorTitle":[{"text":"RouterScenarioFeatureResolver","kind":"identifier"}],"abstract":[{"type":"text","text":"Type-erased ownership validation for one serialized feature-plan path."}],"url":"\/documentation\/innoroutertesting\/routerscenariofeatureresolver","title":"RouterScenarioFeatureResolver","kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureResolver","type":"topic"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterTestRequest":{"abstract":[{"type":"text","text":"One concurrently running request started by "},{"code":"RouterTestStore.start","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RouterTestRequest"}],"navigatorTitle":[{"kind":"identifier","text":"RouterTestRequest"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestRequest","kind":"symbol","url":"\/documentation\/innoroutertesting\/routertestrequest","role":"symbol","type":"topic","title":"RouterTestRequest"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterScenarioRecorder":{"abstract":[{"type":"text","text":"Explicit, bounded capture session for production router requests."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RouterScenarioRecorder"}],"navigatorTitle":[{"kind":"identifier","text":"RouterScenarioRecorder"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRecorder","kind":"symbol","url":"\/documentation\/innoroutertesting\/routerscenariorecorder","role":"symbol","type":"topic","title":"RouterScenarioRecorder"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterScenarioSceneLifetime":{"abstract":[{"type":"text","text":"Serializable meaning needed to reproduce a request through the same"},{"type":"text","text":" "},{"type":"text","text":"production preparation path that originally submitted it."}],"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RouterScenarioSceneLifetime"}],"navigatorTitle":[{"kind":"identifier","text":"RouterScenarioSceneLifetime"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioSceneLifetime","kind":"symbol","url":"\/documentation\/innoroutertesting\/routerscenarioscenelifetime","role":"symbol","type":"topic","title":"RouterScenarioSceneLifetime"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterScenarioSourceGenerator/generateFiles(_:routeTypeName:fixtureFileName:testName:storeFactory:environmentFactory:featureResolversFactory:)":{"kind":"symbol","url":"\/documentation\/innoroutertesting\/routerscenariosourcegenerator\/generatefiles(_:routetypename:fixturefilename:testname:storefactory:environmentfactory:featureresolversfactory:)","title":"generateFiles(_:routeTypeName:fixtureFileName:testName:storeFactory:environmentFactory:featureResolversFactory:)","role":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioSourceGenerator\/generateFiles(_:routeTypeName:fixtureFileName:testName:storeFactory:environmentFactory:featureResolversFactory:)","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"generateFiles"},{"kind":"text","text":"<"},{"kind":"genericParameter","text":"R"},{"kind":"text","text":">("},{"kind":"typeIdentifier","preciseIdentifier":"s:17InnoRouterTesting0B15ScenarioFixtureV","text":"RouterScenarioFixture"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"R"},{"kind":"text","text":">, "},{"kind":"externalParam","text":"routeTypeName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"fixtureFileName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"testName"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"storeFactory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"environmentFactory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":", "},{"kind":"externalParam","text":"featureResolversFactory"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:SS","text":"String"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:17InnoRouterTesting0B22ScenarioGeneratedFilesV","text":"RouterScenarioGeneratedFiles"}],"abstract":[{"type":"text","text":"Emits an executable Swift Testing source plus a separate, reviewable"},{"type":"text","text":" "},{"type":"text","text":"JSON fixture. Place both files in the same test-source directory."}],"type":"topic"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterScenarioFixture":{"abstract":[],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RouterScenarioFixture"}],"navigatorTitle":[{"kind":"identifier","text":"RouterScenarioFixture"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFixture","kind":"symbol","url":"\/documentation\/innoroutertesting\/routerscenariofixture","role":"symbol","type":"topic","title":"RouterScenarioFixture"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterTestPendingWork":{"abstract":[{"type":"text","text":"Snapshot of work that must be resolved before a strict test-store finish."}],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RouterTestPendingWork"}],"navigatorTitle":[{"kind":"identifier","text":"RouterTestPendingWork"}],"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterTestPendingWork","kind":"symbol","url":"\/documentation\/innoroutertesting\/routertestpendingwork","role":"symbol","type":"topic","title":"RouterTestPendingWork"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterScenarioGeneratedFiles":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioGeneratedFiles","title":"RouterScenarioGeneratedFiles","url":"\/documentation\/innoroutertesting\/routerscenariogeneratedfiles","role":"symbol","abstract":[],"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RouterScenarioGeneratedFiles"}],"kind":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"RouterScenarioGeneratedFiles"}]},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterTestRuntime":{"abstract":[{"type":"text","text":"Deterministic time and transition identity supplied to a "},{"code":"RouterTestStore","type":"codeVoice"},{"type":"text","text":"."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"RouterTestRuntime"}],"navigatorTitle":[{"kind":"identif