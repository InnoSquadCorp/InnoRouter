{"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Article","title":"Testing Flows End-to-End with `FlowTestStore`","role":"article","modules":[{"name":"InnoRouterMacros"}]},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterMacros"],["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterMacros","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/InnoRouterTesting"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Setup","type":"heading","anchor":"Setup"},{"inlineContent":[{"text":"Add ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":" to the test target only:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":[".testTarget(","    name: \"AppTests\",","    dependencies: [","        .product(name: \"InnoRouter\",        package: \"InnoRouter\"),","        .product(name: \"InnoRouterTesting\", package: \"InnoRouter\"),","    ]",")"]},{"inlineContent":[{"text":"Then import both modules alongside Swift Testing:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["import Testing","import InnoRouter","import InnoRouterTesting"]},{"level":2,"text":"The happy path","type":"heading","anchor":"The-happy-path"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["private enum AppRoute: Route {","    case welcome, preAuth, signup","}","","@Test","@MainActor","func pushingPreAuthEmitsNavigationAndPathChange() {","    let store = FlowTestStore<AppRoute>()","","    store.send(.push(.preAuth))","","    store.receiveNavigation { event in","        if case .changed(_, let to) = event { return to.path == [.preAuth] }","        return false","    }","    store.receivePathChanged { old, new in","        old.isEmpty && new == [.push(.preAuth)]","    }","    store.finish()","}"]},{"inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"text":" owns a real ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" and subscribes to every","type":"text"},{"text":" ","type":"text"},{"text":"observation surface it exposes (flow, inner navigation, inner","type":"text"},{"text":" ","type":"text"},{"text":"modal). Events land in one FIFO queue; ","type":"text"},{"code":"receive*","type":"codeVoice"},{"text":" helpers dequeue","type":"text"},{"text":" ","type":"text"},{"text":"them in the order the production stores emit.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Modal + cancellation","type":"heading","anchor":"Modal-+-cancellation"},{"inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"text":" surfaces cancellations as first-class events, so","type":"text"},{"text":" ","type":"text"},{"text":"tests can assert them precisely:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@MainActor","private func blockSheetMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(willExecute: { command, _, _ in","        if case .present(let p) = command, p.style == .sheet {","            return .cancel(.middleware(debugName: nil, command: command))","        }","        return .proceed(command)","    })","}","","@Test","@MainActor","func sheetBlockingMiddlewareCancelsTheIntent() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            modal: .init(","                middlewares: [.init(middleware: blockSheetMiddleware(), debugName: \"BlockSheet\")]","            )","        )","    )","","    store.send(.presentSheet(.signup))","","    \/\/ The preview path never commits — only .intentRejected fires.","    store.receiveIntentRejected(","        intent: .presentSheet(.signup),","        reason: .middlewareRejected(debugName: \"BlockSheet\")","    )","    #expect(store.path.isEmpty)","    store.finish()","}"]},{"level":2,"text":"Skipping and draining","type":"heading","anchor":"Skipping-and-draining"},{"inlineContent":[{"code":"skipReceivedEvents()","type":"codeVoice"},{"text":" discards everything currently queued","type":"text"},{"text":" ","type":"text"},{"text":"without asserting, which is useful when a test only cares about","type":"text"},{"text":" ","type":"text"},{"text":"events ","type":"text"},{"inlineContent":[{"text":"after","type":"text"}],"type":"emphasis"},{"text":" a setup mutation:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["store.send(.presentSheet(.signup)) \/\/ enqueues .modal + .pathChanged","store.skipReceivedEvents()         \/\/ we don't care about setup","","store.send(.push(.preAuth))","store.receiveIntentRejected(intent: .push(.preAuth), reason: .pushBlockedByModalTail)"]},{"level":2,"text":"Exhaustivity","type":"heading","anchor":"Exhaustivity"},{"inlineContent":[{"text":"Default is ","type":"text"},{"code":"TestExhaustivity.strict","type":"codeVoice"},{"text":" — any unasserted event at","type":"text"},{"text":" ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" (or at deinit of the test store) triggers a Swift","type":"text"},{"text":" ","type":"text"},{"text":"Testing ","type":"text"},{"code":"Issue.record","type":"codeVoice"},{"text":". This catches the common mistake of","type":"text"},{"text":" ","type":"text"},{"text":"“missed that the modal also fired a ","type":"text"},{"code":".presented","type":"codeVoice"},{"text":" after the","type":"text"},{"text":" ","type":"text"},{"text":"intended intent.”","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Opt out selectively:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let store = FlowTestStore<AppRoute>(exhaustivity: .off)"]},{"inlineContent":[{"code":".off","type":"codeVoice"},{"text":" preserves per-call assertions; only the end-of-life drain","type":"text"},{"text":" ","type":"text"},{"text":"check is silenced. Useful when migrating a legacy test in stages.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Use ","type":"text"},{"code":"assertNoPendingEvents()","type":"codeVoice"},{"text":" between test phases when you need a","type":"text"},{"text":" ","type":"text"},{"text":"non-terminal checkpoint. It reports and consumes the current pending","type":"text"},{"text":" ","type":"text"},{"text":"snapshot, but later operations continue to enqueue. After awaiting all","type":"text"},{"text":" ","type":"text"},{"text":"work, call ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" once: it closes observation, and the first event","type":"text"},{"text":" ","type":"text"},{"text":"emitted past that boundary is an issue in either exhaustivity mode.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Direct state inspection","type":"heading","anchor":"Direct-state-inspection"},{"inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"text":" exposes the projected ","type":"text"},{"code":"path","type":"codeVoice"},{"text":" for occasional direct","type":"text"},{"text":" ","type":"text"},{"text":"assertions:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["#expect(store.path == [.push(.preAuth)])"]},{"inlineContent":[{"text":"Prefer ","type":"text"},{"code":"receive*","type":"codeVoice"},{"text":" for production assertions — they cover both","type":"text"},{"text":" ","type":"text"},{"text":"state and the emission order — but escape hatches are useful for","type":"text"},{"text":" ","type":"text"},{"text":"sanity checks. The inner ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" \/ ","type":"text"},{"code":"ModalStore","type":"codeVoice"},{"text":" behind a","type":"text"},{"text":" ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" are SPI in 4.0; use public flow events and ","type":"text"},{"code":"path","type":"codeVoice"},{"text":" unless","type":"text"},{"text":" ","type":"text"},{"text":"you are writing focused package-internal invariant tests.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Testing middleware behaviour directly","type":"heading","anchor":"Testing-middleware-behaviour-directly"},{"inlineContent":[{"text":"The modal-blocking example above tests middleware ","type":"text"},{"inlineContent":[{"text":"through","type":"text"}],"type":"emphasis"},{"text":" a flow","type":"text"},{"text":" ","type":"text"},{"text":"store. Sometimes you want to test the middleware itself — does it","type":"text"},{"text":" ","type":"text"},{"text":"correctly pass through, cancel, or rewrite commands for every input","type":"text"},{"text":" ","type":"text"},{"text":"shape? ","type":"text"},{"code":"NavigationTestStore","type":"codeVoice"},{"text":" + ","type":"text"},{"code":"ModalTestStore","type":"codeVoice"},{"text":" let you do that","type":"text"},{"text":" ","type":"text"},{"text":"without a FlowStore in the middle.","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@MainActor","private final class RecordingMiddleware: NavigationMiddleware {","    typealias RouteType = AppRoute","","    private(set) var seenCommands: [NavigationCommand<AppRoute>] = []","","    func willExecute(","        _ command: NavigationCommand<AppRoute>,","        state: RouteStack<AppRoute>","    ) -> NavigationInterception<AppRoute> {","        seenCommands.append(command)","        if case .push(let route) = command, route == .signup {","            return .cancel(.middleware(debugName: \"BlockSignup\", command: command))","        }","        return .proceed(command)","    }","","    func didExecute(","        _ command: NavigationCommand<AppRoute>,","        result: NavigationResult<AppRoute>,","        state: RouteStack<AppRoute>","    ) -> NavigationResult<AppRoute> {","        result","    }","}","","@Test","@MainActor","func middlewareCancelsSignupButNotWelcome() {","    let middleware = RecordingMiddleware()","    let store = NavigationTestStore<AppRoute>(","        configuration: .init(","            middlewares: [.init(middleware: middleware, debugName: \"Recorder\")]","        )","    )","","    store.send(.push(.welcome))","    store.receiveChange { _, to in to.path == [.welcome] }","","    store.send(.push(.signup))","    store.receiveIntercepted(reason: .middleware(debugName: \"BlockSignup\", command: .push(.signup)))","","    #expect(middleware.seenCommands.count == 2)","    store.finish()","}"]},{"inlineContent":[{"text":"Recording middlewares work naturally with ","type":"text"},{"code":"@MainActor final class","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and mutable state. Pair them with ","type":"text"},{"code":"receiveIntercepted","type":"codeVoice"},{"text":" to assert","type":"text"},{"text":" ","type":"text"},{"text":"which interceptions fired and in what order, and with direct","type":"text"},{"text":" ","type":"text"},{"text":"reads on the middleware instance to assert which commands it saw.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Property-based test recipes","type":"heading","anchor":"Property-based-test-recipes"},{"inlineContent":[{"text":"InnoRouter’s own property-based suites use","type":"text"},{"text":" ","type":"text"},{"code":"Tests\/InnoRouterTests\/PropertyTestSupport.swift","type":"codeVoice"},{"text":". That helper lives","type":"text"},{"text":" ","type":"text"},{"text":"in this repository’s test target, not in the shipped","type":"text"},{"text":" ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":" product, so downstream apps should copy or adapt","type":"text"},{"text":" ","type":"text"},{"text":"the pattern rather than expect ","type":"text"},{"code":"@testable import InnoRouterTesting","type":"codeVoice"},{"text":" ","type":"text"},{"text":"to expose ","type":"text"},{"code":"SeededGenerator","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Arbitrary","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"FlowModelState","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"The idiom is ","type":"text"},{"inlineContent":[{"type":"text","text":"Swift Testing "},{"type":"codeVoice","code":"@Test(arguments:)"},{"type":"text","text":" iterated over many"},{"type":"text","text":" "},{"type":"text","text":"seeds"}],"type":"strong"},{"type":"text","text":", each seed driving a deterministic random intent stream:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@Test(arguments: 0..<100)","@MainActor","func randomFlowIntentsPreserveInvariants(seed: UInt64) async {","    var rng = SeededGenerator(seed: seed)","    let store = FlowTestStore<AppRoute>(exhaustivity: .off)","","    for _ in 0..<30 {","        let intent = Arbitrary.flowIntent(","            rng: &rng,","            routes: [.welcome, .preAuth, .signup]","        )","        store.send(intent)","    }","","    \/\/ Invariant: modal-tail is always the final step, never in the middle.","    let modalIndices = store.path.indices.filter { store.path[$0].isModal }","    #expect(modalIndices.allSatisfy { $0 == store.path.count - 1 })","}"]},{"inlineContent":[{"type":"text","text":"Swift Testing runs the 100 parameterised cases in parallel by"},{"type":"text","text":" "},{"type":"text","text":"default, so total wall-clock time stays close to a single iteration."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A pairs-with pattern: ","type":"text"},{"inlineContent":[{"type":"text","text":"run the random stream through both the"},{"text":" ","type":"text"},{"text":"real store and a reference model","type":"text"}],"type":"strong"},{"text":", then assert they agree step by","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"step. That’s how "},{"type":"codeVoice","code":"FlowStorePropertyBasedTests"},{"type":"text","text":" catches subtle"},{"text":" ","type":"text"},{"text":"divergences between the journal-driven implementation and the","type":"text"},{"text":" ","type":"text"},{"text":"intended semantics. See this repository’s PropertyTestSupport source","type":"text"},{"text":" ","type":"text"},{"text":"for the model-driven ","type":"text"},{"code":"FlowModelState","type":"codeVoice"},{"text":" pattern.","type":"text"}]},{"anchor":"Next-steps","level":2,"text":"Next steps","type":"heading"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Read the "},{"type":"codeVoice","code":"Tutorial-LoginOnboarding"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":" documentation catalog for the end-to-end flow"},{"type":"text","text":" "},{"type":"text","text":"being tested here."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Read the ","type":"text"},{"code":"Tutorial-MiddlewareComposition","type":"codeVoice"},{"text":" guide in the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":" documentation catalog for the middleware"},{"text":" ","type":"text"},{"text":"surfaces the harness asserts against.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Cross-reference "},{"type":"codeVoice","code":"<doc:Rejection-Reasons>"},{"type":"text","text":" (in InnoRouterCore) for"},{"type":"text","text":" "},{"type":"text","text":"the full rejection taxonomy your "},{"type":"codeVoice","code":"receiveIntentRejected"},{"type":"text","text":" \/"},{"type":"text","text":" "},{"type":"codeVoice","code":"receiveIntercepted"},{"type":"text","text":" calls can pattern-match on."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/Tutorial-TestingFlows"},"abstract":[{"text":"Assert the complete chain triggered by a single ","type":"text"},{"code":"FlowIntent","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"navigation, modal, middleware cancellation, path reconciliation —","type":"text"},{"text":" ","type":"text"},{"text":"through a single FIFO receive queue, without mounting any SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"host.","type":"text"}],"variants":[{"paths":["\/documentation\/innoroutertesting\/tutorial-testingflows"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/InnoRouterTesting":{"title":"InnoRouterTesting","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/InnoRouterTesting","url":"\/documentation\/innoroutertesting\/innoroutertesting","abstract":[{"text":"Host-less, Swift-Testing native assertion harness for InnoRouter’s navigation, modal, and flow authorities.","type":"text"}],"type":"topic","kind":"article","role":"collectionGroup"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterMacros":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterMacros","type":"topic","role":"collection","title":"InnoRouterMacros","abstract":[],"url":"\/documentation\/innoroutermacros","kind":"symbol"}}}