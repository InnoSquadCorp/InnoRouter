{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/Tutorial-TestingFlows"},"schemaVersion":{"patch":0,"minor":3,"major":0},"kind":"article","abstract":[{"text":"Assert the complete chain triggered by a single ","type":"text"},{"code":"FlowIntent","type":"codeVoice"},{"text":" —","type":"text"},{"text":" ","type":"text"},{"text":"navigation, modal, middleware cancellation, path reconciliation —","type":"text"},{"text":" ","type":"text"},{"text":"through a single FIFO receive queue, without mounting any SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"host.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterMacros"],["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterMacros","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/InnoRouterTesting"]]},"primaryContentSections":[{"kind":"content","content":[{"text":"Setup","level":2,"type":"heading","anchor":"Setup"},{"inlineContent":[{"text":"Add ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":" to the test target only:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":[".testTarget(","    name: \"AppTests\",","    dependencies: [","        .product(name: \"InnoRouter\",        package: \"InnoRouter\"),","        .product(name: \"InnoRouterTesting\", package: \"InnoRouter\"),","    ]",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"Then import both modules alongside Swift Testing:","type":"text"}]},{"type":"codeListing","code":["import Testing","import InnoRouter","import InnoRouterTesting"],"syntax":"swift skip doc-fragment"},{"type":"heading","level":2,"anchor":"The-happy-path","text":"The happy path"},{"type":"codeListing","code":["private enum AppRoute: Route {","    case welcome, preAuth, signup","}","","@Test","@MainActor","func pushingPreAuthEmitsNavigationAndPathChange() {","    let store = FlowTestStore<AppRoute>()","","    store.send(.push(.preAuth))","","    store.receiveNavigation { event in","        if case .changed(_, let to) = event { return to.path == [.preAuth] }","        return false","    }","    store.receivePathChanged { old, new in","        old.isEmpty && new == [.push(.preAuth)]","    }","    store.finish()","}"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"text":" owns a real ","type":"text"},{"code":"FlowStore","type":"codeVoice"},{"text":" and subscribes to every","type":"text"},{"type":"text","text":" "},{"type":"text","text":"observation surface it exposes (flow, inner navigation, inner"},{"type":"text","text":" "},{"type":"text","text":"modal). Events land in one FIFO queue; "},{"type":"codeVoice","code":"receive*"},{"type":"text","text":" helpers dequeue"},{"type":"text","text":" "},{"type":"text","text":"them in the order the production stores emit."}]},{"level":2,"type":"heading","anchor":"Modal-+-cancellation","text":"Modal + cancellation"},{"inlineContent":[{"code":"FlowTestStore","type":"codeVoice"},{"text":" surfaces cancellations as first-class events, so","type":"text"},{"text":" ","type":"text"},{"text":"tests can assert them precisely:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@MainActor","private func blockSheetMiddleware() -> AnyModalMiddleware<AppRoute> {","    AnyModalMiddleware(willExecute: { command, _, _ in","        if case .present(let p) = command, p.style == .sheet {","            return .cancel(.middleware(debugName: nil, command: command))","        }","        return .proceed(command)","    })","}","","@Test","@MainActor","func sheetBlockingMiddlewareCancelsTheIntent() {","    let store = FlowTestStore<AppRoute>(","        configuration: .init(","            modal: .init(","                middlewares: [.init(middleware: blockSheetMiddleware(), debugName: \"BlockSheet\")]","            )","        )","    )","","    store.send(.presentSheet(.signup))","","    \/\/ The preview path never commits — only .intentRejected fires.","    store.receiveIntentRejected(","        intent: .presentSheet(.signup),","        reason: .middlewareRejected(debugName: \"BlockSheet\")","    )","    #expect(store.path.isEmpty)","    store.finish()","}"]},{"level":2,"type":"heading","anchor":"Skipping-and-draining","text":"Skipping and draining"},{"inlineContent":[{"type":"codeVoice","code":"skipReceivedEvents()"},{"type":"text","text":" discards everything currently queued"},{"type":"text","text":" "},{"type":"text","text":"without asserting, which is useful when a test only cares about"},{"type":"text","text":" "},{"type":"text","text":"events "},{"type":"emphasis","inlineContent":[{"type":"text","text":"after"}]},{"type":"text","text":" a setup mutation:"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["store.send(.presentSheet(.signup)) \/\/ enqueues .modal + .pathChanged","store.skipReceivedEvents()         \/\/ we don't care about setup","","store.send(.push(.preAuth))","store.receiveIntentRejected(intent: .push(.preAuth), reason: .pushBlockedByModalTail)"]},{"level":2,"type":"heading","anchor":"Exhaustivity","text":"Exhaustivity"},{"inlineContent":[{"type":"text","text":"Default is "},{"type":"codeVoice","code":"TestExhaustivity.strict"},{"type":"text","text":" — any unasserted event at"},{"type":"text","text":" "},{"type":"codeVoice","code":"finish()"},{"text":" (or at deinit of the test store) triggers a Swift","type":"text"},{"text":" ","type":"text"},{"text":"Testing ","type":"text"},{"code":"Issue.record","type":"codeVoice"},{"text":". This catches the common mistake of","type":"text"},{"text":" ","type":"text"},{"text":"“missed that the modal also fired a ","type":"text"},{"code":".presented","type":"codeVoice"},{"text":" after the","type":"text"},{"text":" ","type":"text"},{"text":"intended intent.”","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Opt out selectively:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift skip doc-fragment","code":["let store = FlowTestStore<AppRoute>(exhaustivity: .off)"]},{"inlineContent":[{"code":".off","type":"codeVoice"},{"text":" preserves per-call assertions; only the end-of-life drain","type":"text"},{"text":" ","type":"text"},{"text":"check is silenced. Useful when migrating a legacy test in stages.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Use "},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"type":"text","text":" between test phases when you need a"},{"type":"text","text":" "},{"type":"text","text":"non-terminal checkpoint. It reports and consumes the current pending"},{"type":"text","text":" "},{"type":"text","text":"snapshot, but later operations continue to enqueue. After awaiting all"},{"type":"text","text":" "},{"type":"text","text":"work, call "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" once: it closes observation, and the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted past that boundary is an issue in either exhaustivity mode."}],"type":"paragraph"},{"text":"Direct state inspection","anchor":"Direct-state-inspection","type":"heading","level":2},{"inlineContent":[{"type":"codeVoice","code":"FlowTestStore"},{"text":" exposes the projected ","type":"text"},{"type":"codeVoice","code":"path"},{"text":" for occasional direct","type":"text"},{"text":" ","type":"text"},{"text":"assertions:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["#expect(store.path == [.push(.preAuth)])"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Prefer "},{"code":"receive*","type":"codeVoice"},{"type":"text","text":" for production assertions — they cover both"},{"type":"text","text":" "},{"type":"text","text":"state and the emission order — but escape hatches are useful for"},{"type":"text","text":" "},{"type":"text","text":"sanity checks. The inner "},{"code":"NavigationStore","type":"codeVoice"},{"type":"text","text":" \/ "},{"code":"ModalStore","type":"codeVoice"},{"type":"text","text":" behind a"},{"type":"text","text":" "},{"code":"FlowStore","type":"codeVoice"},{"type":"text","text":" are SPI in 4.0; use public flow events and "},{"code":"path","type":"codeVoice"},{"type":"text","text":" unless"},{"type":"text","text":" "},{"type":"text","text":"you are writing focused package-internal invariant tests."}]},{"anchor":"Testing-middleware-behaviour-directly","text":"Testing middleware behaviour directly","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The modal-blocking example above tests middleware ","type":"text"},{"inlineContent":[{"type":"text","text":"through"}],"type":"emphasis"},{"text":" a flow","type":"text"},{"text":" ","type":"text"},{"text":"store. Sometimes you want to test the middleware itself — does it","type":"text"},{"text":" ","type":"text"},{"text":"correctly pass through, cancel, or rewrite commands for every input","type":"text"},{"text":" ","type":"text"},{"text":"shape? ","type":"text"},{"type":"codeVoice","code":"NavigationTestStore"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"ModalTestStore"},{"text":" let you do that","type":"text"},{"text":" ","type":"text"},{"text":"without a FlowStore in the middle.","type":"text"}]},{"code":["@MainActor","private final class RecordingMiddleware: NavigationMiddleware {","    typealias RouteType = AppRoute","","    private(set) var seenCommands: [NavigationCommand<AppRoute>] = []","","    func willExecute(","        _ command: NavigationCommand<AppRoute>,","        state: RouteStack<AppRoute>","    ) -> NavigationInterception<AppRoute> {","        seenCommands.append(command)","        if case .push(let route) = command, route == .signup {","            return .cancel(.middleware(debugName: \"BlockSignup\", command: command))","        }","        return .proceed(command)","    }","","    func didExecute(","        _ command: NavigationCommand<AppRoute>,","        result: NavigationResult<AppRoute>,","        state: RouteStack<AppRoute>","    ) -> NavigationResult<AppRoute> {","        result","    }","}","","@Test","@MainActor","func middlewareCancelsSignupButNotWelcome() {","    let middleware = RecordingMiddleware()","    let store = NavigationTestStore<AppRoute>(","        configuration: .init(","            middlewares: [.init(middleware: middleware, debugName: \"Recorder\")]","        )","    )","","    store.send(.push(.welcome))","    store.receiveChange { _, to in to.path == [.welcome] }","","    store.send(.push(.signup))","    store.receiveIntercepted(reason: .middleware(debugName: \"BlockSignup\", command: .push(.signup)))","","    #expect(middleware.seenCommands.count == 2)","    store.finish()","}"],"syntax":"swift skip doc-fragment","type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"Recording middlewares work naturally with ","type":"text"},{"code":"@MainActor final class","type":"codeVoice"},{"text":" ","type":"text"},{"text":"and mutable state. Pair them with ","type":"text"},{"code":"receiveIntercepted","type":"codeVoice"},{"text":" to assert","type":"text"},{"text":" ","type":"text"},{"text":"which interceptions fired and in what order, and with direct","type":"text"},{"text":" ","type":"text"},{"text":"reads on the middleware instance to assert which commands it saw.","type":"text"}]},{"level":2,"anchor":"Property-based-test-recipes","type":"heading","text":"Property-based test recipes"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter’s own property-based suites use"},{"type":"text","text":" "},{"code":"Tests\/InnoRouterTests\/PropertyTestSupport.swift","type":"codeVoice"},{"type":"text","text":". That helper lives"},{"type":"text","text":" "},{"type":"text","text":"in this repository’s test target, not in the shipped"},{"type":"text","text":" "},{"code":"InnoRouterTesting","type":"codeVoice"},{"type":"text","text":" product, so downstream apps should copy or adapt"},{"type":"text","text":" "},{"type":"text","text":"the pattern rather than expect "},{"code":"@testable import InnoRouterTesting","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"to expose "},{"code":"SeededGenerator","type":"codeVoice"},{"type":"text","text":", "},{"code":"Arbitrary","type":"codeVoice"},{"type":"text","text":", or "},{"type":"codeVoice","code":"FlowModelState"},{"type":"text","text":"."}]},{"type":"paragraph","inlineContent":[{"text":"The idiom is ","type":"text"},{"inlineContent":[{"type":"text","text":"Swift Testing "},{"type":"codeVoice","code":"@Test(arguments:)"},{"type":"text","text":" iterated over many"},{"type":"text","text":" "},{"type":"text","text":"seeds"}],"type":"strong"},{"text":", each seed driving a deterministic random intent stream:","type":"text"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["@Test(arguments: 0..<100)","@MainActor","func randomFlowIntentsPreserveInvariants(seed: UInt64) async {","    var rng = SeededGenerator(seed: seed)","    let store = FlowTestStore<AppRoute>(exhaustivity: .off)","","    for _ in 0..<30 {","        let intent = Arbitrary.flowIntent(","            rng: &rng,","            routes: [.welcome, .preAuth, .signup]","        )","        store.send(intent)","    }","","    \/\/ Invariant: modal-tail is always the final step, never in the middle.","    let modalIndices = store.path.indices.filter { store.path[$0].isModal }","    #expect(modalIndices.allSatisfy { $0 == store.path.count - 1 })","}"]},{"type":"paragraph","inlineContent":[{"text":"Swift Testing runs the 100 parameterised cases in parallel by","type":"text"},{"text":" ","type":"text"},{"text":"default, so total wall-clock time stays close to a single iteration.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A pairs-with pattern: "},{"type":"strong","inlineContent":[{"type":"text","text":"run the random stream through both the"},{"type":"text","text":" "},{"type":"text","text":"real store and a reference model"}]},{"type":"text","text":", then assert they agree step by"},{"type":"text","text":" "},{"type":"text","text":"step. That’s how "},{"code":"FlowStorePropertyBasedTests","type":"codeVoice"},{"type":"text","text":" catches subtle"},{"type":"text","text":" "},{"type":"text","text":"divergences between the journal-driven implementation and the"},{"type":"text","text":" "},{"type":"text","text":"intended semantics. See this repository’s PropertyTestSupport source"},{"type":"text","text":" "},{"type":"text","text":"for the model-driven "},{"code":"FlowModelState","type":"codeVoice"},{"type":"text","text":" pattern."}]},{"text":"Next steps","anchor":"Next-steps","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read the "},{"type":"codeVoice","code":"Tutorial-LoginOnboarding"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":" documentation catalog for the end-to-end flow"},{"type":"text","text":" "},{"type":"text","text":"being tested here."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Read the "},{"type":"codeVoice","code":"Tutorial-MiddlewareComposition"},{"type":"text","text":" guide in the"},{"type":"text","text":" "},{"type":"codeVoice","code":"InnoRouterSwiftUI"},{"type":"text","text":" documentation catalog for the middleware"},{"type":"text","text":" "},{"type":"text","text":"surfaces the harness asserts against."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Cross-reference ","type":"text"},{"code":"<doc:Rejection-Reasons>","type":"codeVoice"},{"text":" (in InnoRouterCore) for","type":"text"},{"text":" ","type":"text"},{"text":"the full rejection taxonomy your ","type":"text"},{"code":"receiveIntentRejected","type":"codeVoice"},{"text":" \/","type":"text"},{"text":" ","type":"text"},{"code":"receiveIntercepted","type":"codeVoice"},{"text":" calls can pattern-match on.","type":"text"}]}]}]}]}],"sections":[],"metadata":{"modules":[{"name":"InnoRouterMacros"}],"role":"article","title":"Testing Flows End-to-End with `FlowTestStore`","roleHeading":"Article"},"variants":[{"paths":["\/documentation\/innoroutertesting\/tutorial-testingflows"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterMacros":{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterMacros","type":"topic","kind":"symbol","role":"collection","abstract":[],"url":"\/documentation\/innoroutermacros","title":"InnoRouterMacros"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/InnoRouterTesting":{"kind":"article","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/InnoRouterTesting","url":"\/documentation\/innoroutertesting\/innoroutertesting","type":"topic","role":"collectionGroup","abstract":[{"text":"Host-less, Swift-Testing native assertion harness for InnoRouter’s navigation, modal, and flow authorities.","type":"text"}],"title":"InnoRouterTesting"}}}