{"sections":[],"abstract":[{"type":"text","text":"A bounded, payload-safe navigation timeline for development and diagnostics."}],"variants":[{"paths":["\/documentation\/innorouterinspector\/innorouterinspector"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector"]]},"metadata":{"role":"collectionGroup","title":"InnoRouterInspector","roleHeading":"API Collection","modules":[{"name":"InnoRouterInspector"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/InnoRouterInspector"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"code":"InnoRouterInspector","type":"codeVoice"},{"type":"text","text":" is an opt-in product that observes the canonical"},{"type":"text","text":" "},{"code":"RouterStore","type":"codeVoice"},{"type":"text","text":" event stream. Timeline capture and pure-reducer previews do not"},{"type":"text","text":" "},{"type":"text","text":"intercept or mutate routing operations. The optional deep-link workbench has"},{"type":"text","text":" "},{"type":"text","text":"a separate, explicit execution action that submits through the live store."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Create a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorRecorder"},{"type":"text","text":", attach the store that"},{"type":"text","text":" "},{"type":"text","text":"should be observed, and retain each"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorSubscription"},{"type":"text","text":" for the desired capture"},{"type":"text","text":" "},{"type":"text","text":"lifetime. Default formatters retain operation names, outcomes, styles, and"},{"type":"text","text":" "},{"type":"text","text":"counts while excluding route payload descriptions. A custom"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorFormatter"},{"type":"text","text":" is the explicit opt-in point"},{"type":"text","text":" "},{"type":"text","text":"for app-specific details."}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorView","type":"reference"},{"text":" presents the bounded timeline with","type":"text"},{"text":" ","type":"text"},{"text":"domain filters, pause\/resume, rejection breakpoints, bookmarks, arbitrary A\/B","type":"text"},{"text":" ","type":"text"},{"text":"comparison, native JSON snapshot\/bundle import, bundle export, step controls,","type":"text"},{"text":" ","type":"text"},{"text":"clear, and entry detail.","type":"text"},{"text":" ","type":"text"},{"text":"When the app also imports ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":", pass a","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorScenarioController","type":"reference"},{"text":" created by its","type":"text"},{"text":" ","type":"text"},{"text":"standard ","type":"text"},{"code":"routerScenario(store:)","type":"codeVoice"},{"text":" adapter. This adds explicit start, progress,","type":"text"},{"text":" ","type":"text"},{"text":"stop, completeness, and raw fixture import\/export. Raw fixture controls are","type":"text"},{"text":" ","type":"text"},{"text":"visibly separate because route payloads may be present.","type":"text"},{"text":" ","type":"text"},{"text":"Start, stop, and import failures use","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorScenarioFailure","type":"reference"},{"text":" and localized generic","type":"text"},{"text":" ","type":"text"},{"text":"summaries. Arbitrary decoder or application error descriptions are not shown,","type":"text"},{"text":" ","type":"text"},{"text":"and a failed import clears any stale raw fixture that could otherwise be shared.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorSnapshot","type":"reference"},{"text":" is a value-only, Codable export","type":"text"},{"text":" ","type":"text"},{"text":"suitable for attaching to a bug report after the app has applied its own","type":"text"},{"text":" ","type":"text"},{"text":"retention and disclosure policy.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorDiagnosticBundle","type":"reference"},{"text":" wraps that redacted","type":"text"},{"text":" ","type":"text"},{"text":"snapshot with its InnoRouter release and Apple platform identity. The recorder","type":"text"},{"text":" ","type":"text"},{"text":"encodes bundles with stable JSON key and bookmark ordering. Default formatters","type":"text"},{"text":" ","type":"text"},{"text":"remain payload-safe; applications that install custom formatters must review","type":"text"},{"text":" ","type":"text"},{"text":"the app-owned metadata before sharing a bundle. ","type":"text"},{"code":"importDiagnosticBundle(from:)","type":"codeVoice"},{"text":" ","type":"text"},{"text":"reopens the session and returns its original environment metadata. Unsupported","type":"text"},{"text":" ","type":"text"},{"text":"format versions fail before decoding entries, and failed imports preserve the","type":"text"},{"text":" ","type":"text"},{"text":"current timeline and bookmarks.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Both recorder encoding methods apply"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorExportLimits"},{"type":"text","text":" to the complete JSON output,"},{"type":"text","text":" "},{"type":"text","text":"including a diagnostic bundle’s environment metadata. The provisional,"},{"type":"text","text":" "},{"type":"text","text":"uncalibrated default is 8 MiB; configure "},{"type":"codeVoice","code":"exportLimits:"},{"type":"text","text":" on the recorder to"},{"type":"text","text":" "},{"type":"text","text":"choose another finite byte ceiling. This ceiling is independent of"},{"type":"text","text":" "},{"type":"codeVoice","code":"importLimits:"},{"type":"text","text":" and the recorder’s entry "},{"type":"codeVoice","code":"capacity"},{"type":"text","text":". A session that satisfies"},{"type":"text","text":" "},{"type":"text","text":"one limit need not satisfy the others."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"An output exactly at the byte ceiling succeeds. A larger output throws"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorExportFailure"},{"type":"text","text":" with the extensible"},{"type":"text","text":" "},{"type":"codeVoice","code":"encodedDataTooLarge"},{"type":"text","text":" code and actual\/maximum byte counts, without retaining"},{"type":"text","text":" "},{"type":"text","text":"entry content. Failure preserves entries, bookmarks, pause settings, and"},{"type":"text","text":" "},{"type":"text","text":"transition timing. Snapshot encoding still honors the caller’s "},{"type":"codeVoice","code":"JSONEncoder"},{"type":"text","text":" "},{"type":"text","text":"and propagates its errors unchanged. The Inspector view’s existing diagnostic"},{"type":"text","text":" "},{"type":"text","text":"export path calls the same bounded recorder method."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The byte check runs after "},{"type":"codeVoice","code":"JSONEncoder"},{"type":"text","text":" produces its "},{"type":"codeVoice","code":"Data"},{"type":"text","text":": it bounds the bytes"},{"type":"text","text":" "},{"type":"text","text":"returned for persistence or sharing, not peak transient allocations or the"},{"type":"text","text":" "},{"type":"text","text":"memory retained by formatted timeline entries. The value-only "},{"type":"codeVoice","code":"snapshot()"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"codeVoice","code":"diagnosticBundle()"},{"type":"text","text":" methods do not encode or apply the export byte limit, and"},{"type":"text","text":" "},{"type":"text","text":"directly encoding those values bypasses the recorder’s export policy."}],"type":"paragraph"},{"inlineContent":[{"text":"The recorder can import that export with an explicit replace or append policy.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorPlayback"},{"text":" steps through an imported","type":"text"},{"text":" ","type":"text"},{"text":"session without a live store, while","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorComparison"},{"text":" compares final states across","type":"text"},{"text":" ","type":"text"},{"text":"sessions or any two captured states in one session. Entries include correlated","type":"text"},{"text":" ","type":"text"},{"text":"elapsed and transition-duration metadata. All comparisons operate on","type":"text"},{"text":" ","type":"text"},{"text":"payload-redacted trees, and older snapshots without bookmarks remain decodable.","type":"text"},{"text":" ","type":"text"},{"text":"Byte and entry limits apply to both snapshot and bundle imports before entry","type":"text"},{"text":" ","type":"text"},{"text":"decoding. Duplicate envelope keys are rejected, escaped keys are recognized,","type":"text"},{"text":" ","type":"text"},{"text":"and orphan bookmarks are discarded. Replacing a timeline clears live timing","type":"text"},{"text":" ","type":"text"},{"text":"correlation so imported sessions cannot inherit durations from earlier work.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"For a macro router declared with ","type":"text"},{"code":"inspectorCatalog: true","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorDeepLinkView"},{"text":" is an opt-in URL workbench.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorDeepLinkAnalyzer"},{"text":" projects the generated","type":"text"},{"text":" ","type":"text"},{"text":"catalog, ordered attempts, and terminal failure without route payload values or","type":"text"},{"text":" ","type":"text"},{"text":"navigation side effects. Its preview API uses the pure reducer for a redacted","type":"text"},{"text":" ","type":"text"},{"text":"target diff. The ","type":"text"},{"code":"store:","type":"codeVoice"},{"text":" view initializer exposes execution separately; only","type":"text"},{"text":" ","type":"text"},{"text":"that explicit action resolves the URL and submits through normal policies.","type":"text"},{"text":" ","type":"text"},{"text":"The default share action uses only the structural decision and declared route","type":"text"},{"text":" ","type":"text"},{"text":"patterns, never the entered URL. Execution status is structured and localized,","type":"text"},{"text":" ","type":"text"},{"text":"and leaving the workbench cancels only its owned execution task.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Localization","anchor":"Localization"},{"inlineContent":[{"text":"Inspector-owned controls, accessibility labels, recording\/execution statuses,","type":"text"},{"text":" ","type":"text"},{"text":"and generic failure messages support English, Korean, Japanese, Simplified and","type":"text"},{"text":" ","type":"text"},{"text":"Traditional Chinese, Spanish, French, German, Italian, Brazilian Portuguese,","type":"text"},{"text":" ","type":"text"},{"text":"Russian, Arabic, Hindi, Indonesian, Vietnamese, and Thai.","type":"text"},{"text":" ","type":"text"},{"text":"Views resolve strings from the package resource bundle using the SwiftUI","type":"text"},{"text":" ","type":"text"},{"code":"locale","type":"codeVoice"},{"text":" environment, including changes while the same view remains mounted.","type":"text"},{"text":" ","type":"text"},{"text":"Unsupported languages fall back to English. Timeline timestamps use that","type":"text"},{"text":" ","type":"text"},{"text":"locale’s time formatting.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"To select a language for one Inspector subtree, apply"},{"type":"text","text":" "},{"type":"codeVoice","code":".environment(\\.locale, Locale(identifier: \"ko\"))"},{"type":"text","text":" to its view. Locale and layout"},{"type":"text","text":" "},{"type":"text","text":"direction are independent SwiftUI environment values: when forcing an Arabic"},{"type":"text","text":" "},{"type":"text","text":"preview in a left-to-right app, also apply"},{"type":"text","text":" "},{"type":"codeVoice","code":".environment(\\.layoutDirection, .rightToLeft)"},{"type":"text","text":". Normal host-app language and"},{"type":"text","text":" "},{"type":"text","text":"layout configuration remains the application’s responsibility."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Locale-only changes preserve the native containers. A layout-direction change"},{"type":"text","text":" "},{"type":"text","text":"recreates the workbench’s native Form and the timeline’s native split\/list"},{"type":"text","text":" "},{"type":"text","text":"boundary on split-view platforms to clear stale mirrored geometry. Stable"},{"type":"text","text":" "},{"type":"text","text":"outer containers retain tab identity, recorder, scenario, filter, selection,"},{"type":"text","text":" "},{"type":"text","text":"comparison, URL input, and execution ownership. Native focus or scroll position"},{"type":"text","text":" "},{"type":"text","text":"may reset, but a direction change does not cancel an in-flight execution."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Event names, domain\/outcome identifiers, metadata keys, route patterns,"},{"type":"text","text":" "},{"type":"text","text":"structural dumps, and exported JSON remain stable diagnostic values. Custom"},{"type":"text","text":" "},{"type":"text","text":"formatter content and successful scenario summaries belong to the app and"},{"type":"text","text":" "},{"type":"text","text":"are shown verbatim. Native file\/share panels use the host application’s and"},{"type":"text","text":" "},{"type":"text","text":"system’s localization, not the package’s catalog."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Scenario recording means capturing navigation events, not screen or audio"},{"type":"text","text":" "},{"type":"text","text":"recording. Stopping retains the captured fixture; cancelling discards it"},{"type":"text","text":" "},{"type":"text","text":"without undoing navigation. An incomplete capture is distinct from a capture"},{"type":"text","text":" "},{"type":"text","text":"operation that failed. Raw fixture warnings refer to potentially sensitive"},{"type":"text","text":" "},{"type":"text","text":"route data and must not be removed when translating."}],"type":"paragraph"}]}],"kind":"article","schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"anchor":"Capture","title":"Capture","identifiers":["doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorRecorder","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorSubscription","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorFormatter"]},{"anchor":"Timeline-values","title":"Timeline values","identifiers":["doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorEntry","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorEventDescription","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorDomain","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorOutcome","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorSnapshot","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorDiagnosticBundle","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorPlayback","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorComparison","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorImportPolicy","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorExportLimits","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorExportFailure","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorExportFailureCode","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorExportFailureDetails","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorStateTree","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorStateDiff"]},{"anchor":"User-interface","title":"User interface","identifiers":["doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorView","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorDeepLinkView","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorDeepLinkAnalyzer","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorScenarioController","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorScenarioStatus","doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspectorScenarioFailure"]}],"references":{"doc://com.innosquad.innorouter.docs.inspector/documentation/InnoRouterInspector/RouterInspectorScenarioController":{"type":"topic","abstract":[{"type":"text","text":"Payload-free Inspector state with opt-in commands supplied at the app’s"},{"type":"text","text":" "},{"type":"text","text":"assembly boundary. "},{"type":"codeVoice","code":"InnoRouterTesting"},{"type":"text","text":" provides the standard recorder"},{"type":"text","text":" "},{"type":"text","text":"adapter; apps that do not import it pay no runtime dependency cost."}],"title":"RouterInspectorScenarioController","identifier":"doc:\/\/com.innosquad.innorouter.docs.inspector\/documentation\/InnoRouterInspector\/RouterInspe