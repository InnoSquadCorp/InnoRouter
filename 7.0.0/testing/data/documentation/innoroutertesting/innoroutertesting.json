ext","text":" "},{"type":"text","text":"Navigation-only v8 fixtures remain readable and are upgraded to v9 on export."},{"type":"text","text":" "},{"type":"text","text":"A v8 document carrying new transient descriptors is rejected. Other fixture"},{"type":"text","text":" "},{"type":"text","text":"versions require recapture rather than an inferred migration."}],"anchor":"Harness","title":"Harness"}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"code":"RouterTestStore<Route>","type":"codeVoice"},{"type":"text","text":" wraps the production "},{"code":"RouterStore","type":"codeVoice"},{"type":"text","text":", reducer, and"},{"type":"text","text":" "},{"type":"text","text":"policies. It buffers events synchronously, allowing a test to assert the exact"},{"type":"text","text":" "},{"code":"started → policyPrepared → committed\/rejected","type":"codeVoice"},{"type":"text","text":" lifecycle without sleeps."}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["import InnoRouter","import InnoRouterTesting","import Testing","","@Test @MainActor","func opensDetail() async {","    let store = RouterTestStore<AppRoute>()","","    await store.send(.push(.detail(id: \"42\")))","    store.receiveStarted()","    store.receiveCommitted { state, revision in","        state == .rootStack(path: [.detail(id: \"42\")]) && revision == 1","    }","    store.finish()","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The default "},{"type":"codeVoice","code":"TestExhaustivity.strict"},{"type":"text","text":" mode records a Swift Testing issue when"},{"type":"text","text":" "},{"type":"text","text":"events remain at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or deinitialization. Use "},{"type":"codeVoice","code":".off"},{"type":"text","text":" only while"},{"type":"text","text":" "},{"type":"text","text":"incrementally migrating a large suite. Production "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" callbacks are"},{"type":"text","text":" "},{"type":"text","text":"preserved and run before an event enters the assertion queue."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Use predicates when a transition identifier is generated at runtime, or compare"},{"type":"text","text":" "},{"type":"text","text":"an exact "},{"type":"codeVoice","code":"RouterEvent"},{"type":"text","text":" when the fixture owns every value."}]},{"inlineContent":[{"code":"send(_:context:)","type":"codeVoice"},{"type":"text","text":" accepts production transition provenance and animation;"},{"type":"text","text":" "},{"type":"text","text":"passing a "},{"code":"RouterPlan","type":"codeVoice"},{"type":"text","text":" applies one exact target. Codable routes can use"},{"type":"text","text":" "},{"code":"snapshot(using:)","type":"codeVoice"},{"type":"text","text":" and "},{"code":"restore(from:using:recovery:)","type":"codeVoice"},{"type":"text","text":" to verify the same codec,"},{"type":"text","text":" "},{"type":"text","text":"migration, policy, and provenance path used by an application. "},{"code":"assertState","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"and "},{"code":"receiveUnchanged","type":"codeVoice"},{"type":"text","text":" complete the value-level assertion surface."}],"type":"paragraph"},{"inlineContent":[{"text":"For timeout, expiry, cancellation, and overlapping-request tests, install a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouterTestRuntime"},{"text":" and start requests without awaiting them:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","code":["let runtime = RouterTestRuntime(transitionIDSeed: 1)","let store = RouterTestStore<AppRoute>(","    configuration: .init(policyTimeout: .seconds(30)),","    runtime: runtime",")","let request = store.start(.push(.checkout))","","await request.waitUntilStarted()","await runtime.clock.waitUntilScheduled()","runtime.clock.advance(by: .seconds(30))","let outcome = await request.result"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"text":"The start and timer-registration barriers are production lifecycle signals,","type":"text"},{"text":" ","type":"text"},{"text":"not scheduler guesses. ","type":"text"},{"type":"codeVoice","code":"RouterTestRequest.cancel()"},{"text":" targets one request, while","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"waitForEvent(where:)"},{"text":" waits for an exact later lifecycle condition. Strict","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"finish()"},{"text":" reports outstanding requests, policy deferrals, and virtual timers,","type":"text"},{"text":" ","type":"text"},{"text":"then cancels only work created by this test harness. Existing test-store","type":"text"},{"text":" ","type":"text"},{"text":"initializers retain live time unless a runtime is explicitly supplied.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterActionSequence<Route>"},{"text":" stores Codable production actions and each step’s","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouterTransitionContext"},{"text":" as a versioned, deterministically encoded fixture.","type":"text"},{"text":" ","type":"text"},{"text":"Construct ","type":"text"},{"type":"codeVoice","code":"RouterActionStep"},{"text":" values when provenance, animation, request keys,","type":"text"},{"text":" ","type":"text"},{"text":"coalescing, or resumed-deferral metadata differ between steps. The convenience","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"init(actions:context:)"},{"text":" applies one context to every action. ","type":"text"},{"type":"codeVoice","code":"replay(on:)"},{"text":" sends","type":"text"},{"text":" ","type":"text"},{"text":"each step through ","type":"text"},{"type":"codeVoice","code":"RouterTestStore"},{"text":", including production policy rejection.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Supply the original initial state, policies, and runtime dependencies when","type":"text"},{"text":" ","type":"text"},{"text":"constructing the test store. Replay is sequential and does not reproduce","type":"text"},{"text":" ","type":"text"},{"text":"concurrent request timing. Fixtures contain route payloads and request keys;","type":"text"},{"text":" ","type":"text"},{"text":"review them before sharing. Use Inspector bundles for redacted support exports.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterScenarioRecorder"},{"text":" is the explicit bridge from a reproduced bug to a","type":"text"},{"text":" ","type":"text"},{"text":"regression fixture. It observes request, start, cancellation, and terminal","type":"text"},{"text":" ","type":"text"},{"text":"boundaries synchronously, bounds retained route payloads, and reports","type":"text"},{"text":" ","type":"text"},{"text":"unfinished, dropped, or control-incomplete requests. Format v5 records","type":"text"},{"text":" ","type":"text"},{"text":"route-schema, environment, dependency\/effect capabilities, the initial","type":"text"},{"text":" ","type":"text"},{"text":"revision, every request’s relative ","type":"text"},{"type":"codeVoice","code":"expectedRevision"},{"text":", its","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioCancellationOrigin","type":"reference","isActive":true},{"text":", serializable","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRequestSemantics","type":"reference","isActive":true},{"text":", and logical submit, wait, cancel,","type":"text"},{"text":" ","type":"text"},{"text":"virtual-time, deferral-resolution, and terminal controls. This preserves","type":"text"},{"text":" ","type":"text"},{"text":"history navigation-only rebasing and stale-state checks through queued and","type":"text"},{"text":" ","type":"text"},{"text":"repeatedly deferred requests. Format v8 records the complete feature mapping","type":"text"},{"text":" ","type":"text"},{"text":"path for ordinary feature actions, presentation mutations, completions, and","type":"text"},{"text":" ","type":"text"},{"text":"feature plans. Scene-local requests bind ownership to the logical Scene","type":"text"},{"text":" ","type":"text"},{"text":"lifetime created by the replay sequence rather than serializing process-local","type":"text"},{"text":" ","type":"text"},{"text":"UUID tokens. Replay requires a","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureResolver","type":"reference","isActive":true},{"text":" built from the same macro-generated mapping;","type":"text"},{"text":" ","type":"text"},{"text":"use ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioFeatureProjection","type":"reference","isActive":true},{"text":" to compose nested mappings. Missing,","type":"text"},{"text":" ","type":"text"},{"text":"duplicate, or tampered resolver paths fail before the first production request.","type":"text"},{"text":" ","type":"text"},{"text":"Format v7 and earlier, plus unknown future versions, are rejected","type":"text"},{"text":" ","type":"text"},{"text":"instead of guessing execution conditions. Use the recorder’s ","type":"text"},{"type":"codeVoice","code":"resolveDeferred"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"advanceTime"},{"text":" operations when","type":"text"},{"text":" ","type":"text"},{"text":"capturing those decisions so replay never invents unavailable scheduling data.","type":"text"},{"text":" ","type":"text"},{"text":"Preflight validates the exact action provenance stored by each deferral while","type":"text"},{"text":" ","type":"text"},{"text":"allowing a history target to differ from the merged state that preserves","type":"text"},{"text":" ","type":"text"},{"text":"already-open scenes, badges, and non-conflicting presentations. A resumed","type":"text"},{"text":" ","type":"text"},{"text":"history request with an explicit request-cancellation control is portable. A","type":"text"},{"text":" ","type":"text"},{"text":"request cancelled by an unrecorded history stop or reset is rejected as","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioReplayError\/unsupportedHistoryLifetime(step:)","type":"reference","isActive":true},{"text":" (and by the","type":"text"},{"text":" ","type":"text"},{"text":"matching source-generation error) before replay mutates a store; reproduce and","type":"text"},{"text":" ","type":"text"},{"text":"record that lifecycle explicitly before generating a portable fixture.","type":"text"},{"text":" ","type":"text"},{"text":"A raw recording is intentionally incomplete:","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouterScenarioFixture.settingExpectations(_:)"},{"text":" must provide a developer-owned","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouterScenarioExpectation"},{"text":" for every observation before","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"RouterScenarioSourceGenerator"},{"text":" emits Swift Testing source. Generated tests use","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterScenarioRunner","type":"reference","isActive":true},{"text":" to preserve overlaps, cancellation, timeout, and","type":"text"},{"text":" ","type":"t