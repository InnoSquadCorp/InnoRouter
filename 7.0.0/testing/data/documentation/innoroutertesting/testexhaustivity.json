t":" ","type":"text"},{"text":"events collected from the underlying authority’s unified ","type":"text"},{"code":"onEvent","type":"codeVoice"},{"text":" ","type":"text"},{"text":"callback accumulate in an internal queue. Each","type":"text"},{"text":" ","type":"text"},{"code":"receive(...)","type":"codeVoice"},{"text":" call dequeues the next event and asserts a predicate. In","type":"text"},{"text":" ","type":"text"},{"text":"In ","type":"text"},{"code":".strict","type":"codeVoice"},{"text":" mode, the store reports events left pending at ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" or","type":"text"},{"text":" ","type":"text"},{"text":"deallocation.","type":"text"},{"text":" ","type":"text"},{"code":"assertNoPendingEvents()","type":"codeVoice"},{"text":" is a non-terminal checkpoint: it reports and","type":"text"},{"text":" ","type":"text"},{"text":"consumes the current pending snapshot, then continues observing. ","type":"text"},{"code":"finish()","type":"codeVoice"},{"text":" ","type":"text"},{"text":"closes the queue, consumes its final snapshot, and reports the first event","type":"text"},{"text":" ","type":"text"},{"text":"emitted after that boundary in both exhaustivity modes.","type":"text"}]},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"code":"deinit","type":"codeVoice"},{"type":"text","text":" to an "},{"type":"emphasis","inlineContent":[{"type":"text","text":"unknown test"}]},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"code":"finish()","type":"codeVoice"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}],"type":"paragraph"}]}],"kind":"content"}],"kind":"symbol","hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting"]]},"identifier":{"url":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/TestExhaustivity","interfaceLanguage":"swift"},"references":{"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterActionSequence":{"fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"RouterActionSequence"}],"abstract":[{"type":"text","text":"A versioned, deterministically encoded list of contextual router actions."}],"title":"RouterActionSequence","url":"\/documentation\/innoroutertesting\/routeractionsequence","navigatorTitle":[{"kind":"identifier","text":"RouterActionSequence"}],"type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/RouterActionSequence","role":"symbol","kind":"symbol"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/TestExhaustivity/Equatable-Implementations":{"abstract":[],"title":"Equatable Implementations","url":"\/documentation\/innoroutertesting\/testexhaustivity\/equatable-implementations","type":"topic","identifier":"doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations","role":"collectionGroup","kind":"article"},"doc://com.innosquad.innorouter.docs.testing/documentation/InnoRouterTesting/RouterScenarioRequestSemantics":{"fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"RouterScenarioRequestSemantics"}],"abstract":[],"title":"RouterScenarioRequestSemantics","url":"\/documentation\/innorouterte