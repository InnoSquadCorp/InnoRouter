{"primaryContentSections":[{"content":[{"type":"heading","text":"Dependency","anchor":"Dependency","level":2},{"inlineContent":[{"text":"Replace granular runtime products with the umbrella product:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip package-manifest-fragment","type":"codeListing","code":[".product(name: \"InnoRouter\", package: \"InnoRouter\")"]},{"inlineContent":[{"text":"Add ","type":"text"},{"code":"InnoRouterTesting","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"InnoRouterInspector","type":"codeVoice"},{"text":" only to targets that use them.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Route declaration and host","anchor":"Route-declaration-and-host","level":2},{"inlineContent":[{"text":"Before, an application could manually compose separate stack and modal stores.","type":"text"},{"text":" ","type":"text"},{"text":"In 6.0, declare destinations once and choose a native host:","type":"text"}],"type":"paragraph"},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["import InnoRouter","import SwiftUI","","@Router","enum AppRoute {","    case home","    case detail(id: String)","","    var destination: some View { \/* exhaustive switch *\/ }","}","","RouterHost(AppRoute.self) {","    AppRoute.destination(for: .home)","}"]},{"inlineContent":[{"text":"Use ","type":"text"},{"type":"codeVoice","code":"AppRoute.makeRouterStore()"},{"text":" and ","type":"text"},{"type":"codeVoice","code":"RouterHost(store:)"},{"text":" only when an app","type":"text"},{"text":" ","type":"text"},{"text":"boundary must retain the authority.","type":"text"}],"type":"paragraph"},{"type":"heading","text":"Feature metadata namespace","anchor":"Feature-metadata-namespace","level":2},{"inlineContent":[{"text":"Feature mappings stay under ","type":"text"},{"type":"codeVoice","code":"AppRoute.Feature"},{"type":"text","text":", such as"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRoute.Feature.account"},{"type":"text","text":". The generated structural metadata array is now"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRoute.routerFeatureCatalog"},{"type":"text","text":". Replace any pre-release 6.0 source that read"},{"type":"text","text":" "},{"type":"codeVoice","code":"AppRoute.Feature.catalog"},{"type":"text","text":"; no compatibility alias is provided because it would"},{"type":"text","text":" "},{"type":"text","text":"again collide with a valid "},{"type":"codeVoice","code":"@FeatureRoute case catalog(ChildRoute)"},{"type":"text","text":" mapping."}],"type":"paragraph"},{"level":2,"anchor":"Request-vocabulary","text":"Request vocabulary","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"5.x","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"6.0","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"independent stack\/modal\/flow stores","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterStore<Route>"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"navigation, modal, and flow intents"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterAction<Route>"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"navigation and flow plans"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"RouterPlan<Route>"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"direct inner-store mutation"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"await store.perform(action)"}]}]],[[{"inlineContent":[{"text":"separate store event types","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"RouterEvent<Route>","type":"codeVoice"},{"type":"text","text":" with one transition ID"}],"type":"paragraph"}]]],"type":"table","header":"row"},{"inlineContent":[{"type":"text","text":"Named environment helpers such as "},{"type":"codeVoice","code":"go"},{"type":"text","text":", "},{"type":"codeVoice","code":"back"},{"type":"text","text":", "},{"type":"codeVoice","code":"sheet"},{"type":"text","text":", and "},{"type":"codeVoice","code":"cover"},{"type":"text","text":" remain"},{"type":"text","text":" "},{"type":"text","text":"convenient projections of "},{"type":"codeVoice","code":"RouterAction"},{"type":"text","text":"; they do not form another public"},{"type":"text","text":" "},{"type":"text","text":"request language."}],"type":"paragraph"},{"inlineContent":[{"text":"The repository’s ","type":"text"},{"code":"MigrationSmoke","type":"codeVoice"},{"text":" fixture compiles the exact published 5.2.1","type":"text"},{"text":" ","type":"text"},{"code":"NavigationStore","type":"codeVoice"},{"text":" scenario and this 6.0 replacement as separate downstream","type":"text"},{"text":" ","type":"text"},{"text":"packages, then compares their encoded final path. It intentionally proves a","type":"text"},{"text":" ","type":"text"},{"text":"migration rather than preserving the removed type names.","type":"text"}],"type":"paragraph"},{"text":"Tabs and split layouts","anchor":"Tabs-and-split-layouts","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace per-tab stores with branches in one "},{"code":"RouterState","type":"codeVoice"},{"text":" tree. Apply","type":"text"},{"text":" ","type":"text"},{"code":"@TabItem","type":"codeVoice"},{"text":" only to parameterless tab roots; ordinary detail routes can remain","type":"text"},{"text":" ","type":"text"},{"text":"unmarked in the same ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":" enum. ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"text":" creates and scopes the","type":"text"},{"text":" ","type":"text"},{"text":"branches. The macro-generated scope ID is based on the case name and is safe to","type":"text"},{"text":" ","type":"text"},{"text":"persist across localization and reordering.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"For an app-retained split tree, construct "},{"type":"codeVoice","code":"RouterContainerState(style: .split, ...)"},{"type":"text","text":", create one "},{"type":"codeVoice","code":"RouterStore"},{"type":"text","text":", and pass it to "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterThreeColumnSplitHost"},{"type":"text","text":". "},{"type":"codeVoice","code":"RouterSplitState"},{"type":"text","text":" persists native visibility and"},{"type":"text","text":" "},{"type":"text","text":"preferred compact column alongside the two- or three-column scope topology."}]},{"text":"Async policy","anchor":"Async-policy","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace middleware executors with ordered "},{"type":"codeVoice","code":"RouterPolicy"},{"type":"text","text":" values:"}]},{"syntax":"swift skip doc-fragment","type":"codeListing","code":["let policy = RouterPolicy<AppRoute>(name: \"session\") { transition in","    session.isAuthenticated ? .allow : .reject(\"authentication-required\")","}","","let store = try AppRoute.makeRouterStore(","    configuration: .init(policies: [policy])",")"]},{"inlineContent":[{"text":"Policies inspect an immutable candidate. Do not mutate navigation or business","type":"text"},{"text":" ","type":"text"},{"text":"state from a policy closure.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When approval must arrive later, return "},{"type":"codeVoice","code":".deferRequest(id)"},{"type":"text","text":". The store releases"},{"type":"text","text":" "},{"type":"text","text":"its execution lane and exposes payload-safe metadata in "},{"type":"codeVoice","code":"deferredTransitions"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"Resolve the request explicitly; unchanged-state resume is the default, and"},{"type":"text","text":" "},{"type":"text","text":"rebasing on current state must be selected deliberately."}],"type":"paragraph"},{"level":2,"text":"Deep links","type":"heading","anchor":"Deep-links"},{"inlineContent":[{"text":"Replace push-only or flow-only pipelines with ","type":"text"},{"code":"RouterLinkPipeline","type":"codeVoice"},{"text":". A route","type":"text"},{"text":" ","type":"text"},{"text":"matcher is promoted to an exact root-stack plan by default; pass a plan matcher","type":"text"},{"text":" ","type":"text"},{"text":"or planner closure for tabs, presentations, windows, or immersive state.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Authentication evaluates every route in the target tree. A pending decision"},{"type":"text","text":" "},{"type":"text","text":"retains the complete plan, so replay does not reconstruct intent chains. Put"},{"type":"text","text":" "},{"type":"text","text":"that value in "},{"code":"RouterPendingLinkSlot","type":"codeVoice"},{"type":"text","text":", then call "},{"code":"resume(on:)","type":"codeVoice"},{"type":"text","text":" after login;"},{"type":"text","text":" "},{"text":"replacement, cancellation, and rejection retention are explicit.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Authentication state may be isolated to any actor. Its closure and the final"},{"type":"text","text":" "},{"type":"text","text":"decision are therefore asynchronous:"}],"type":"paragraph"},{"code":["let pipeline = RouterLinkPipeline<AppRoute>(","    originPolicy: originPolicy,","    matcher: matcher,","    authenticationPolicy: .required(","        shouldRequireAuthentication: { $0.requiresSession },","        isAuthenticated: { await session.isAuthenticated }","    )",")","","let decision = await pipeline.decide(for: url)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"anchor":"Persistence","type":"heading","level":2,"text":"Persistence"},{"inlineContent":[{"text":"Replace raw stack\/flow encoding with ","type":"text"},{"type":"codeVoice","code":"RouterSnapshotCodec<Route>"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["let codec = try RouterSnapshotCodec<AppRoute>(currentVersion: 2, migrations: [v1ToV2])","let data = try await store.snapshot(using: codec)","let result = try await store.restore(from: data, using: codec, recovery: .fail)"],"type":"codeListing","syntax":"swift skip doc-fragment"},{"inlineContent":[{"type":"text","text":"Migrations must be adjacent and deterministic. Choose "},{"type":"codeVoice","code":".fail"},{"type":"text","text":" or an explicit"},{"type":"text","text":" "},{"type":"text","text":"app fallback; 6.0 never silently restores an empty router."}],"type":"paragraph"},{"inlineContent":[{"text":"Prefer ","type":"text"},{"code":"RouterSnapshotMigration.codable(from:to:decoding:transform:)","type":"codeVoice"},{"text":" when the","type":"text"},{"text":" ","type":"text"},{"text":"legacy payload has a known shape. It decodes an app-owned legacy DTO and","type":"text"},{"text":" ","type":"text"},{"text":"encodes the next payload with stable key ordering, avoiding fragile raw JSON","type":"text"},{"text":" ","type":"text"},{"text":"string rewrites.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Snapshot encoding and decoding execute away from the main actor. Restoration"},{"type":"text","text":" "},{"type":"text","text":"also captures the current revision before loading and rejects the decoded plan"},{"type":"text","text":" "},{"type":"text","text":"as stale if the live router commits while storage is being read."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"When the app wants lifecycle-driven persistence, retain a"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterRestorationDriver"},{"type":"text","text":" with an app-selected "},{"type":"codeVoice","code":"RouterSnapshotStorage"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"text","text":"attach "},{"type":"codeVoice","code":"routerStateRestoration(_:)"},{"type":"text","text":" at the root. The driver still restores"},{"type":"text","text":" "},{"type":"text","text":"through the canonical policy pipeline and does not select a cloud service or"},{"type":"text","text":" "},{"type":"text","text":"storage location."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Persist an authentication continuation separately with"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterPendingLinkPersistenceDriver"},{"type":"text","text":" and app-selected"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterPendingLinkStorage"},{"type":"text","text":". It stores the exact pending plan, not the source URL"},{"type":"text","text":" "},{"type":"text","text":"alone, and refuses to overwrite a newer in-memory submission after a slow load."}]},{"type":"heading","text":"Macro-first state reads","anchor":"Macro-first-state-reads","level":2},{"type":"paragraph","inlineContent":[{"text":"Keep ordinary destinations on ","type":"text"},{"code":"@EnvironmentRouter","type":"codeVoice"},{"text":" for actions. Replace direct","type":"text"},{"text":" ","type":"text"},{"text":"store injection used only for UI state with ","type":"text"},{"code":"@EnvironmentRouterState","type":"codeVoice"},{"text":"; its","type":"text"},{"text":" ","type":"text"},{"code":"RouterStateReader","type":"codeVoice"},{"type":"text","text":" exposes read-only stack, presentation, tab, badge, window,"},{"type":"text","text":" "},{"text":"and immersive projections from the same nearest scope.","type":"text"}]},{"level":2,"type":"heading","text":"Result-bearing presentation","anchor":"Result-bearing-presentation"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Replace child-coordinator callbacks with one exact presentation lifetime:"}]},{"type":"codeListing","code":["let outcome: RouterPresentationOutcome<Profile> = await router.present(","    .profileEditor,","    expecting: Profile.self",")"],"syntax":"swift skip doc-fragment"},{"type":"paragraph","inlineContent":[{"text":"The destination calls ","type":"text"},{"code":"finishPresentation(returning:)","type":"codeVoice"},{"text":". Treat ","type":"text"},{"code":".dismissed","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"code":".cancelled","type":"codeVoice"},{"text":", and ","type":"text"},{"code":".rejected","type":"codeVoice"},{"text":" as separate terminal states.","type":"text"}]},{"level":2,"type":"heading","text":"Tests and inspection","anchor":"Tests-and-inspection"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Replace per-store test harnesses with ","type":"text"},{"code":"RouterTestStore","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Attach "},{"type":"codeVoice","code":"RouterInspectorRecorder"},{"type":"text","text":" to the canonical "},{"type":"codeVoice","code":"RouterStore"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Expect "},{"type":"codeVoice","code":"started"},{"type":"text","text":", one event per prepared policy, and one terminal event with"},{"type":"text","text":" "},{"text":"the same transition identifier.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Read source, animation, and metadata from the "},{"type":"codeVoice","code":"context"},{"type":"text","text":" carried by every"},{"type":"text","text":" "},{"type":"text","text":"terminal event; terminal diagnostics no longer infer "},{"type":"codeVoice","code":".programmatic"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Default inspector metadata is structural and redacted. Supply a formatter"},{"type":"text","text":" "},{"type":"text","text":"only when the app explicitly accepts payload exposure."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Import exported sessions into the recorder or use ","type":"text"},{"type":"codeVoice","code":"RouterInspectorPlayback"},{"text":" ","type":"text"},{"text":"and ","type":"text"},{"type":"codeVoice","code":"RouterInspectorComparison"},{"text":" for offline step-through diagnosis.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use bookmarks, correlated elapsed\/duration metadata, arbitrary state"},{"type":"text","text":" "},{"type":"text","text":"comparison, and pause-on-rejection to isolate a failing transition. JSON file"},{"type":"text","text":" "},{"type":"text","text":"import remains a developer-only, non-mutating workflow."}]}]}]},{"type":"heading","level":2,"text":"Removed without an automatic adapter","anchor":"Removed-without-an-automatic-adapter"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The 5.x coordinator callback lifecycle, modal queues, effect handlers, and"},{"type":"text","text":" "},{"type":"text","text":"automatic scene ownership cannot be translated safely into aliases: they have"},{"type":"text","text":" "},{"type":"text","text":"different lifetime and atomicity semantics. Move business effects outside the"},{"type":"text","text":" "},{"type":"text","text":"router, model the visible target as "},{"type":"codeVoice","code":"RouterState"},{"type":"text","text":", and invoke native window or"},{"type":"text","text":" "},{"type":"text","text":"immersive APIs through a macro-generated "},{"type":"codeVoice","code":"RouterSceneRoute"},{"type":"text","text":" catalog when"},{"type":"text","text":" "},{"type":"text","text":"committed state changes. Scene actions on unconstrained route types are no"},{"type":"text","text":" "},{"type":"text","text":"longer part of the public surface. Native open failures are repaired through"},{"type":"text","text":" "},{"type":"text","text":"the normal reducer and event path, but that corrective removal cannot be"},{"type":"text","text":" "},{"type":"text","text":"rejected by an application policy because the failed scene does not exist to"},{"type":"text","text":" "},{"type":"text","text":"preserve."}]},{"inlineContent":[{"text":"Each native scene now owns a recursive ","type":"text"},{"code":"RouterNode","type":"codeVoice"},{"text":" within that same state.","type":"text"},{"text":" ","type":"text"},{"text":"Use the macro-generated typed ","type":"text"},{"code":"Route.Scene","type":"codeVoice"},{"text":" request and render the matching","type":"text"},{"text":" ","type":"text"},{"code":"RouterWindowHost","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"RouterImmersiveSpaceHost","type":"codeVoice"},{"text":"; do not host a second store in","type":"text"},{"text":" ","type":"text"},{"text":"the scene.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouter\/Migrating-To-InnoRouter-6"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouter\/migrating-to-innorouter-6"]}],"kind":"article","metadata":{"modules":[{"name":"InnoRouterTesting"}],"roleHeading":"Article","role":"article","title":"Migrating to InnoRouter 6"},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting"]]},"abstract":[{"text":"InnoRouter 6 deliberately replaces the parallel 5.x routing authorities with","type":"text"},{"text":" ","type":"text"},{"text":"one macro-first state\/store model. This is a breaking migration, not a set of","type":"text"},{"text":" ","type":"text"},{"text":"deprecated aliases.","type":"text"}],"references":{"doc://com.innosquad.innorouter.docs.runtime/documentation/InnoRouterTesting":{"role":"collection","abstract":[],"kind":"symbol","identifier":"doc:\/\/com.innosquad.innorouter.docs.runtime\/documentation\/InnoRouterTesting","title":"InnoRouterTesting","url":"\/documentation\/innoroutertesting","type":"topic"}}}