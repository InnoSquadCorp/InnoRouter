{"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"Declare one route enum with ","type":"text"},{"code":"@Router","type":"codeVoice"},{"text":". The generated conformance unlocks one","type":"text"},{"text":" ","type":"text"},{"code":"RouterStore<Route>","type":"codeVoice"},{"text":", one recursive ","type":"text"},{"code":"RouterState<Route>","type":"codeVoice"},{"text":", and one","type":"text"},{"text":" ","type":"text"},{"code":"RouterAction<Route>","type":"codeVoice"},{"text":" request vocabulary.","type":"text"}]},{"type":"paragraph","inlineContent":[{"code":"RouterHost","type":"codeVoice"},{"text":", ","type":"text"},{"code":"RouterTabHost","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"RouterSplitHost","type":"codeVoice"},{"text":" render native SwiftUI","type":"text"},{"text":" ","type":"text"},{"text":"containers over that authority. ","type":"text"},{"code":"RouterPlan<Route>","type":"codeVoice"},{"text":" represents an exact target","type":"text"},{"text":" ","type":"text"},{"text":"shared by deep links, restoration, and transactions.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter supports typed presentations and scenes, native tab"},{"type":"text","text":" "},{"text":"and split hosts, deep-link admission, snapshot restoration, bounded scheduling,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and optional testing and Inspector tools. Applications choose their storage,"},{"type":"text","text":" "},{"type":"text","text":"recovery, and policy behavior explicitly while the store remains the single"},{"type":"text","text":" "},{"type":"text","text":"navigation authority."}]},{"text":"Added in 6.1.0","anchor":"Added-in-610","type":"heading","level":3},{"inlineContent":[{"text":"Version 6.1.0 adds explicit tab-topology restoration for apps whose tab","type":"text"},{"tex