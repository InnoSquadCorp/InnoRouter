{"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/innorouter\/innorouter"]}],"sections":[],"abstract":[{"type":"text","text":"Macro-first typed navigation for SwiftUI."}],"primaryContentSections":[{"content":[{"level":2,"type":"heading","anchor":"Overview","text":"Overview"},{"inlineContent":[{"type":"text","text":"Declare one route enum with "},{"type":"codeVoice","code":"@Router"},{"type":"text","text":". The generated conformance unlocks one"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterStore<Route>"},{"type":"text","text":", one recursive "},{"type":"codeVoice","code":"RouterState<Route>"},{"type":"text","text":", and one"},{"type":"text","text":" "},{"type":"codeVoice","code":"RouterAction<Route>"},{"type":"text","text":" request vocabulary."}],"type":"paragraph"},{"inlineContent":[{"type":"codeVoice","code":"RouterHost"},{"type":"text","text":", "},{"type":"codeVoice","code":"RouterTabHost"},{"type":"text","text":", and "},{"type":"codeVoice","code":"RouterSplitHost"},{"type":"text","text":" render native SwiftUI"},{"type":"text","text":" "},{"type":"text","text":"containers over that authority. "},{"type":"codeVoice","code":"RouterPlan<Route>"},{"type":"text","text":" represents an exact target"},{"type":"text","text":" "},{"type":"text","text":"shared by deep links, restoration, and transactions."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"InnoRouter supports typed presentations and scenes, native tab"},{"type":"text","text":" "},{"type":"text","text":"and split hosts, deep-link admission, snapshot restoration, bounded scheduling,"},{"type":"text","text":" "},{"type":"text","text":"and optional testing and Inspector tools. Applications choose their storage,"},{"type":"text","text":" "},{"type":"text","text":"recovery, and policy behavior explicitly while the store remains the single"},{"type":"text","text":" "},{"type":"text","text":"navigation authority."}],"type":"paragra