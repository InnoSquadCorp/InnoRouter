ype":"text","text":"finishes."}],"primaryContentSections":[{"declarations":[{"languages":["swift"],"platforms":["macOS"],"tokens":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}]}],"kind":"declarations"},{"content":[{"anchor":"overview","level":2,"type":"heading","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"InnoRouter’s test stores follow TCA’s "},{"type":"codeVoice","code":"TestStore"},{"type":"text","text":" exhaustivity model:"},{"type":"text","text":" "},{"type":"text","text":"events collected from the underlying authority’s unified "},{"type":"codeVoice","code":"onEvent"},{"type":"text","text":" "},{"type":"text","text":"callback accumulate in an internal queue. Each"},{"type":"text","text":" "},{"type":"codeVoice","code":"receive(...)"},{"type":"text","text":" call dequeues the next event and asserts a predicate. In"},{"type":"text","text":" "},{"type":"text","text":"In "},{"type":"codeVoice","code":".strict"},{"type":"text","text":" mode, the store reports events left pending at "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" or"},{"type":"text","text":" "},{"type":"text","text":"deallocation."},{"type":"text","text":" "},{"type":"codeVoice","code":"assertNoPendingEvents()"},{"type":"text","text":" is a non-terminal checkpoint: it reports and"},{"type":"text","text":" "},{"type":"text","text":"consumes the current pending snapshot, then continues observing. "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":" "},{"type":"text","text":"closes the queue, consumes its final snapshot, and reports the first event"},{"type":"text","text":" "},{"type":"text","text":"emitted after that boundary in both exhaustivity modes."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Swift Testing currently attributes issues recorded inside an"},{"type":"text","text":" "},{"type":"text","text":"isolated "},{"type":"codeVoice","code":"deinit"},{"type":"text","text":" to an "},{"type":"emphasis","inlineContent":[{"text":"unknown test","type":"text"}]},{"type":"text","text":" rather than to the test that"},{"type":"text","text":" "},{"type":"text","text":"owned the store, which makes a deinit-time leftover-event failure"},{"type":"text","text":" "},{"type":"text","text":"hard to locate. Until that is resolved upstream, await all work and end"},{"type":"text","text":" "},{"type":"text","text":"each test with an explicit "},{"type":"codeVoice","code":"finish()"},{"type":"text","text":". It runs the strict check with the"},{"type":"text","text":" "},{"type":"text","text":"caller’s source location and disarms the deinit-time fallback."}]}],"style":"note","type":"aside","name":"Note"}],"kind":"content"}],"topicSections":[{"identifiers":["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/TestExhaustivity\/off","doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/TestExhaustivity\/strict"],"generated":true,"title":"Enumeration Cases","anchor":"Enumeration-Cases"},{"identifiers":["doc:\/\/com.innosquad.innorouter.docs.testing\/documentation\/InnoRouterTesting\/TestExhaustivity\/Equatable-Implementations"],"generated":true,"title":"Default Implementations","anchor":"Default-Implementations"}],"metadata":{"symbolKind":"enum","modules":[{"name":"InnoRouterTesting"}],"role":"symbol","externalID":"s:17InnoRouterTesting16TestExhaustivityO","roleHeading":"Enumeration","title":"TestExhaustivity","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"TestExhaustivity"}],"remoteSource":{"fileName":"TestExhaustivity.swift","url":"https:\/\/github.com\/InnoSquadCorp\/InnoRouter\/blob\/6.1.0\/Sources\/InnoRouterTesting\/TestExhaustivity.swift#L25"},"navigatorTitle":[{"kind":"identifier","text":"TestExhaustivity"}]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.innosquad.innorouter.docs.testing\/